{
  "_meta": {
    "note": "資料契約：每一筆種子資料（技能、課程、學生、教師、管理者、競賽）都必須符合對應的 JSON Schema。由 src/dq 在啟動前與 npm run dq 時檢查；缺少必填欄位計入「完整性」，格式與值域錯誤計入「有效性」。",
    "version": "2026-11-12"
  },
  "skill": {
    "type": "object",
    "required": ["id", "zh", "en", "category", "aliases"],
    "properties": {
      "id": {"type": "string", "pattern": "^SK-[A-Z]{2,3}-\\d{3}$"},
      "zh": {"type": "string", "minLength": 1, "maxLength": 40},
      "en": {"type": "string", "minLength": 1, "maxLength": 80},
      "category": {"type": "string", "minLength": 1, "maxLength": 20},
      "parent": {"type": "string", "pattern": "^SK-[A-Z]{2,3}-\\d{3}$"},
      "scale": {"enum": ["score", "cefr"]},
      "aliases": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 40}},
      "sfia": {"type": "string", "pattern": "^[A-Z]{4}$"},
      "ucan": {"enum": ["溝通表達", "持續學習", "人際互動", "團隊合作", "問題解決", "創新", "工作責任及紀律", "資訊科技應用"]},
      "onetUnspsc": {"type": "string", "pattern": "^\\d{8}$"},
      "esco": {
        "type": "object",
        "required": ["id", "label", "match"],
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 120},
          "match": {"enum": ["exact", "broader", "narrower", "related"]}
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "course": {
    "type": "object",
    "required": ["code", "name", "dept", "credits", "teacherId", "objectives", "weeks", "assessments"],
    "properties": {
      "code": {"type": "string", "pattern": "^[A-Z]{2}\\d{3}$"},
      "name": {"type": "string", "minLength": 2, "maxLength": 40},
      "dept": {"type": "string", "minLength": 1, "maxLength": 20},
      "credits": {"type": "integer", "minimum": 0, "maximum": 6},
      "teacherId": {"type": "string", "pattern": "^T\\d{2}$"},
      "objectives": {"type": "string", "minLength": 1, "maxLength": 400},
      "weeks": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
      "assessments": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "required": ["name", "weight", "practice"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 40},
            "weight": {"type": "integer", "minimum": 1, "maximum": 100},
            "practice": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "student": {
    "type": "object",
    "required": ["id", "name", "dept", "year", "openToMatch", "looking", "hoursPerWeek", "experience", "profileConfirmed", "enrollments", "evidence"],
    "properties": {
      "id": {"type": "string", "pattern": "^S\\d{2}$"},
      "name": {"type": "string", "minLength": 2, "maxLength": 20},
      "dept": {"type": "string", "minLength": 1, "maxLength": 20},
      "year": {"enum": ["大一", "大二", "大三", "大四", "碩一", "碩二"]},
      "openToMatch": {"type": "boolean"},
      "looking": {"type": "boolean"},
      "hoursPerWeek": {"type": "integer", "minimum": 0, "maximum": 40},
      "experience": {"type": "integer", "minimum": 0, "maximum": 30},
      "profileConfirmed": {"type": "boolean"},
      "bio": {"type": "string", "maxLength": 120},
      "enrollments": {
        "type": "array",
        "maxItems": 80,
        "items": {
          "type": "object",
          "required": ["code", "semester", "grade"],
          "properties": {
            "code": {"type": ["string", "null"], "pattern": "^[A-Z]{2}\\d{3}$"},
            "name": {"type": "string", "minLength": 2, "maxLength": 40},
            "semester": {"type": "string", "pattern": "^\\d{3}-[12]$"},
            "grade": {"type": "integer", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false
        }
      },
      "evidence": {
        "type": "array",
        "maxItems": 40,
        "items": {
          "type": "object",
          "required": ["type", "title", "skills", "verified"],
          "properties": {
            "type": {"enum": ["certificate", "portfolio", "competition"]},
            "title": {"type": "string", "minLength": 2, "maxLength": 80},
            "skills": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "pattern": "^SK-[A-Z]{2,3}-\\d{3}$"}},
            "verified": {"type": "boolean"},
            "exam": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": {"enum": ["toeic", "gept"]},
                "score": {"type": "integer", "minimum": 10, "maximum": 990},
                "level": {"enum": ["初級", "中級", "中高級", "高級", "優級"]}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "teacher": {
    "type": "object",
    "required": ["id", "name", "dept", "fieldCode", "openToAdvise", "quota", "used", "expertise", "research", "advised"],
    "properties": {
      "id": {"type": "string", "pattern": "^T\\d{2}$"},
      "name": {"type": "string", "minLength": 2, "maxLength": 20},
      "dept": {"type": "string", "minLength": 1, "maxLength": 20},
      "fieldCode": {"type": "string", "pattern": "^\\d{4}$"},
      "openToAdvise": {"type": "boolean"},
      "quota": {"type": "integer", "minimum": 0, "maximum": 20},
      "used": {"type": "integer", "minimum": 0, "maximum": 20},
      "expertise": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^SK-[A-Z]{2,3}-\\d{3}$"}},
      "research": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 40}},
      "advised": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "object",
          "required": ["type", "teams"],
          "properties": {"type": {"type": "string", "minLength": 1}, "teams": {"type": "integer", "minimum": 0, "maximum": 100}},
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "admin": {
    "type": "object",
    "required": ["id", "name"],
    "properties": {
      "id": {"type": "string", "pattern": "^A\\d{2}$"},
      "name": {"type": "string", "minLength": 2, "maxLength": 20},
      "dept": {"type": "string", "maxLength": 20}
    },
    "additionalProperties": false
  },
  "competition": {
    "type": "object",
    "required": ["id", "name", "type", "keywords", "description", "eligibility", "deadline", "history", "needs", "extend"],
    "properties": {
      "id": {"type": "string", "pattern": "^C\\d{2}$"},
      "name": {"type": "string", "minLength": 2, "maxLength": 60},
      "type": {"type": "string", "minLength": 1, "maxLength": 20},
      "keywords": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1}},
      "description": {"type": "string", "minLength": 1, "maxLength": 300},
      "eligibility": {
        "type": "object",
        "required": ["depts", "teamMin", "teamMax", "advisorRequired"],
        "properties": {
          "depts": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1}},
          "teamMin": {"type": "integer", "minimum": 1, "maximum": 10},
          "teamMax": {"type": "integer", "minimum": 1, "maximum": 10},
          "advisorRequired": {"type": "boolean"}
        },
        "additionalProperties": false
      },
      "deadline": {"type": "string", "format": "date"},
      "history": {
        "type": "object",
        "required": ["teams", "awardRate"],
        "properties": {
          "teams": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "integer", "minimum": 0}},
          "awardRate": {"type": "number", "minimum": 0, "maximum": 1},
          "note": {"type": "string", "maxLength": 120}
        },
        "additionalProperties": false
      },
      "needs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 10,
        "items": {
          "type": "object",
          "required": ["skill", "min", "weight"],
          "properties": {
            "skill": {"type": "string", "pattern": "^SK-[A-Z]{2,3}-\\d{3}$"},
            "min": {"type": ["integer", "string"], "minimum": 60, "maximum": 100, "pattern": "^(A1|A2|B1|B2|C1|C2)$"},
            "weight": {"type": "integer", "minimum": 1, "maximum": 3}
          },
          "additionalProperties": false
        }
      },
      "extend": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1}}
    },
    "additionalProperties": false
  }
}
