  "description": {
    "sub_id3": null,
    "sub_name": "光波導元件模擬與分析",
    "sub_ename": "SIMULATION AND ANALYSIS OF OPTICAL WAVEGUIDE COMPONENTS",
    "describe_ch": "本課程目的為介紹光波導的理論基礎與數值計算方法，並進行元件數值模擬與分析。課程內容包括電磁波在平面及三維波導中的傳播與模態分析，有限差分光束傳播法的介紹，並搭配套裝軟體進行數值模擬計算。",
    "describe_eh": "This course is to introduce the basic theory and numerical simulation method of optical waveguides. The contents include the propagation of lightware in planar and three-dimensional waveguides as well as the modal analysis of these systems. The simulation will be performed via a commercial software based on the finite-difference beam propagation method.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能使用軟體模擬光波導元件的功能。",
      "describe_en": "Be able to use software to simulate the function of waveguide devices."
    },
    {
      "seq": 2,
      "describe_ch": "能使用軟體分析及改良光波導元件的特性。",
      "describe_en": "Be able to use software to analyze and improve the properties of waveguide devices."
    },
    {
      "seq": 3,
      "describe_ch": "能與同儕組成小組共同執行課程相關專題。",
      "describe_en": "Be able to team up with classmates and execute course-related projects."
    }
  ],
