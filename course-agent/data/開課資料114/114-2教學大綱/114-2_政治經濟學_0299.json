    {
      "seq": 2,
      "describe_ch": "能瞭解政治經濟理論之應用",
      "describe_en": "Understand the implications of political economy theory"
    },
    {
      "seq": 3,
      "describe_ch": "能暸解國家機關與經濟發展的互動",
      "describe_en": "Understand the mutual interaction between the state and the market."
    },
    {
      "seq": 4,
      "describe_ch": "能瞭解與說明台灣的發展經驗",
      "describe_en": "Understand and explain the economic development of Taiwan."
    }
