  "description": {
    "sub_id3": null,
    "sub_name": "政治經濟學",
    "sub_ename": "POLITICAL ECONOMICS",
    "describe_ch": "本課程介紹當前政治經濟學的重要理論與研究議題。強調政治與經濟之相互關係，著重理論之應用與批判。培養學生思考與報告能力。",
    "describe_eh": "This course introduces the important theory and research issue of the present political economy.  It emphasizes the mutual interaction between the politics and economics, which focus on the application and criticism of the theory, also, train independent thinking and presentation ability of the students.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
