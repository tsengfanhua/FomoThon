  "description": {
    "sub_id3": null,
    "sub_name": "數位影像處理",
    "sub_ename": "DIGITAL IMAGE PROCESSING",
    "describe_ch": "本課程首先將介紹離散信號與數位影像的基本概念。之後我們將介紹空間域與頻譜域的影像分析，色彩分析，影像強化與影像復原等影像處理技術。",
    "describe_eh": "The course begins from the basic concepts of discrete signal and digital image. Subsequently, the following techniques will be introduced: the analysis of image in the spatial domain and in the spectrum domain; the color analysis and processing; the enhancement and restoration of digital image.",
    "pre_subname": "ENGS2011工程數學(一)",
    "pre_sub_id3": "ENGS2011",
    "pre_sub_ename": "ENGS2011 ENGINEERING MATHEMATICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解數位影像之特性與限制。",
      "describe_en": "Comprehension of the properties and restriction of digital image."
    },
    {
      "seq": 2,
      "describe_ch": "能理解影像處理技術。",
      "describe_en": "Comprehension of image processing techniques."
    },
    {
      "seq": 3,
      "describe_ch": "能以小組合作方式應用影像處理。",
      "describe_en": "Application for image processing in teamwork."
    }
  ],
