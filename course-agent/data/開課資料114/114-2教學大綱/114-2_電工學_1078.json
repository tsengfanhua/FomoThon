  "description": {
    "sub_id3": null,
    "sub_name": "電工學",
    "sub_ename": "ELECTRICAL ENGINEERING",
    "describe_ch": "教授學生基本直流與交流電路原理，讓學生了解基本電子元件：電阻、電容、電感之工作原理，並學會各種電路分析技巧，使得學生在學習本課程之後，將對基本電學原理有所認識並可作電路初步分析。",
    "describe_eh": "To teach the fundamentals of basic devices and their applications. It covers fundamentals of dc and ac circuits, methods of analysis, capacitance, inductance, magnetic circuits, basic transients, Fourier analysis, and other topics. When students successfully complete a course, they will have a good working knowledge of basic circuit principles and a demonstrated ability to solve a variety of circuit-related problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解電阻、電容、電感的工作原理",
      "describe_en": "Be able to comprehend the principle of resistances, capacitors, and inductors."
    },
    {
      "seq": 2,
      "describe_ch": "能分析電路的電壓以及電流大小",
      "describe_en": "Be able to analyze voltages and currents of circuit."
    },
    {
      "seq": 3,
      "describe_ch": "能知道交流電路的工作原理",
      "describe_en": "Be able to know the principle of AC circuit."
    },
    {
      "seq": 4,
      "describe_ch": "能理解基本電學原理",
      "describe_en": "Be able to comprehend  the principle of electrical engineering."
    }
  ],
