  "description": {
    "sub_id3": null,
    "sub_name": "社會創新與資訊科技應用",
    "sub_ename": "SOCIAL INNOVATION AND INFORMATION TECHNOLOGY APPLICATION",
    "describe_ch": "1.將介紹幾種常應用在合作社與社會企業經營管理中的資訊科技分析工具。\r\n2.本課程以系統性的方式解釋這些資訊科技分析工具，使學生能夠在實踐中使用這些量化方法。\r\n3.培養學生有能力用邏輯思維解決社會問題。\r\n",
    "describe_eh": "1. Several widely used information technology analysis tools in management of cooperatives and social enterprises will be introduced.\r\n2. Systematic explanation for these information technology analysis tools in the class, which enable students to use these quantitative methods in practice.\r\n3. Training students to have the capability of solving social problems with logical thinking.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解資訊科技分析工具的基本技巧",
      "describe_en": "To understand the basic skills of\r\ninformation technology analysis tools \r\n"
    },
    {
      "seq": 2,
      "describe_ch": "理解合作社與社會企業對社會創新的必要性",
      "describe_en": "Comprehension the necessity of cooperatives and social enterprises for social innovation"
    },
    {
      "seq": 3,
      "describe_ch": "將資訊科技分析工具應用於合作社與社會企業經營之能力",
      "describe_en": "The functions of integrating information technology analysis tools into cooperatives and social enterprises"
    }
  ],
