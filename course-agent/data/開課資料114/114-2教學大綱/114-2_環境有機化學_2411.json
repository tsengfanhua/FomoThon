  "description": {
    "sub_id3": null,
    "sub_name": "環境有機化學",
    "sub_ename": "ENVIRONMENTAL ORGANIC CHEMISTRY",
    "describe_ch": "本課程探討影響有機化合物在環境中的宿命和傳輸機制的物理、化學、和生物反應過程。課程主題包括：有機化合物的物理化學性質、有機化合物在環境中的行為、有機化合物的分析方法、以及利用定量結構活性關係預測有機污染物在環境中的宿命。\r\n",
    "describe_eh": "This course explores the physical, chemical, and biological processes affecting the fate and transport of organic compounds in the environment. Topics discussed include: the structure and physiochemical properties of organic compounds, behaviors of organic compounds in the environment, analytical methods of organic compounds, and quantitative structure-activity relationships to predict the fate of organic contaminants in the environment.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解有機化合物的分類與基本性質\t",
      "describe_en": "Understand the classification and basics of organic compounds"
    },
    {
      "seq": 2,
      "describe_ch": "理解有機化合物在環境中的吸附、分配、降解、和轉化行為\t",
      "describe_en": "Understand the sorption, partition, degradation, and transformation of organic contaminants in the environment"
    },
    {
      "seq": 3,
      "describe_ch": "學習環境有機污染物的分析技術\t",
      "describe_en": "Learn the analytical methods of environmental organic contaminants"
    },
    {
      "seq": 4,
      "describe_ch": "預測有機污染物在環境中的宿命與傳輸\t",
      "describe_en": "Predict the fate and transport of organic contaminants in the environment"
    },
    {
      "seq": 5,
      "describe_ch": "解決環境有機污染問題\t",
      "describe_en": "Solve organic pollution problems of environmental importance"
    }
  ],
