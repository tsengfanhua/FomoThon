  "description": {
    "sub_id3": null,
    "sub_name": "微積分",
    "sub_ename": "CALCULUS",
    "describe_ch": "內容包含函數極限，函數極限精確定義，利用極限定理求極限，連續性，導數，導函數，微分公式，三角函數之導數，連鎖法則，隱微分，高階導數，線性近似與微分量，極大和極小值，均值定理、導數與函數圖形之關係，無窮極限，水平漸近線，反導數，定積分，微積分基本定理，不定積分，代換法，曲線所圍之區域面積，函數平均值(積分均值定理)，自然對數函數，自然指數函數，一般對數與指數函數，反三角函數，不定型與L'Hospital'sRule。",
    "describe_eh": "Topics include the Limit of a Function, the Precise Definition of a Limit, the Limit Laws, Continuity, Derivatives, the Derivative as a Function, Differentiation Formula, Derivatives of Trigonometric Functions, the Chain Rule, Implicit Differentiation, Higher Derivatives, Linear Approximation Maximun and Minimum Values, the Mean Value Theorem, the Shape of a Graph, Limits at Infinity, Antiderivatives, the Definite Integral, the Fundamental Theorem of Calculus, Indefinite Integrals, the Substitution Rule, Area between Curves, Average Values of a Function, the Natural Logarithmic Function, the Natural Exponential Function, General Logarithmic and Exponential Functions, Inverse Trigonometric Function, L'Hospital's Rule.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解單變數實數值函數之極限、連續、導數及積分定義，並建立相關定理，從中訓練學生邏輯分析能力。",
      "describe_en": "Students will understand the definitions of limit, continuity, derivative and product of single-variable real-valued functions and establish related theorems to train students' logical analysis skills."
    },
    {
      "seq": 2,
      "describe_ch": "理解基本函數極限、連續、導數及積分之運算規則，並使學生熟練運算技巧。",
      "describe_en": "To understand the rules of basic function limits, continuity, derivatives and integration, and to familiarize students with computational skills."
    },
    {
      "seq": 3,
      "describe_ch": "應用微積分理論及運算技巧處理相關幾何問題及極大極小值問題等，並為經濟學與物理學等跨領域學習作準備。",
      "describe_en": "This course applies differential theory and computational skills to geometric problems and very large and very small value problems, and prepares students for interdisciplinary studies in economics and physics."
    }
  ],
