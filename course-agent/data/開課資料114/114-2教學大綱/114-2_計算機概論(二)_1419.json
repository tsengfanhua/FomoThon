  "description": {
    "sub_id3": null,
    "sub_name": "計算機概論(二)",
    "sub_ename": "INTRODUCTION TO COMPUTER(2)",
    "describe_ch": "本課程的目標在於讓學生廣泛地認識電腦科學相關的主題，概述計算機中軟體與硬體相關的基本知識。課程主要為電腦原理的介紹，及使用計算機來解決方法論與演算法的問題。　",
    "describe_eh": "The purpose of this course is to make the students know the related topics of Computer Science, and to state the knowledge of software/hardware in Computer Science. The course mainly focuses on the introduction of the computer theories, and the use of computer to solve the problems of methodology and algorithm.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解計算機涵蓋領域之觀念。",
      "describe_en": "To know that the computer contains all the idea of the realm."
    },
    {
      "seq": 2,
      "describe_ch": "程式語言及資料處理方式提升電腦處理效率之觀念。",
      "describe_en": "The program language and data processing methods promote the idea of the computer processing efficiency."
    }
  ],
