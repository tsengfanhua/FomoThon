  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "PC92100",
    "sub_id": "11789",
    "scr_dup": "001",
    "sub_title": "文物保存概論",
    "sub_title_en": null,
    "sub_describe": "本課程奠基於文物保存、預防及緊急處理等理論，並規劃校外實務教學：走訪文資園區《修護的零度》等特展，聚焦傳統建築彩繪劣損與修復倫理；另參訪美術館《庫房裡的光》典藏展，實地探討庫房環境控制、溫濕防震及作品維護。期以理論與實務印證，培育專業保存人才，落實台灣文物保護。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "文物保存概論",
    "sub_ename": "INTRODUCTION TO CULTURAL RELICS PRESERVATION",
    "describe_ch": "本課程為讓學生，能夠充分了解何謂文物的保存，從文物的基本保存觀念、預防性保存要領、文物持拿及緊急處理等理論課程，結合實務性的操演，將相關之專業實務技能納入教學之中，以強化學生文物保存的認識和提升經驗，並藉此培養更多文化資產保存的相關人力，以落實保護台灣的珍貴文物。",
    "describe_eh": "This course aims to enable students to fully understand what is conservation of cultural relics through the research. The class begins by understanding basic concepts of cultural relics, learning preventive conservation essentials, holding skill and emergency treatment of cultural relics. In order to strengthen students' understanding and experience of cultural relics conservation, this course combined with relevant professional skills practice into teaching, so as to cultivate more conservation personnel, to implement the conservation work of Taiwan's precious cultural heritage.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "習得文物保存基本觀念、修護歷史、環境控制及修護倫理之基礎學理。",
      "describe_en": "Master fundamental theories of cultural heritage conservation, history of restoration, environmental control, and conservation ethics."
    },
    {
      "seq": 2,
      "describe_ch": "習得文物預防性維護相關和文物的保存知識",
      "describe_en": "Acquire knowledge regarding preventive conservation and the preservation of cultural artifacts."
    },
    {
      "seq": 3,
      "describe_ch": "通過現地教學了解文物的分類、分析、修護、劣化狀況判斷與庫房管理之不同面向",
      "describe_en": "Understand various facets of artifact classification, analysis, restoration, deterioration assessment, and collection storage management through on-site instruction."
    }
  ],
