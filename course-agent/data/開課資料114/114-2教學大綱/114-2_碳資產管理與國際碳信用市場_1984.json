  "description": {
    "sub_id3": null,
    "sub_name": "碳資產管理與國際碳信用市場",
    "sub_ename": "CARBON ASSET MANAGEMENT AND INTERNATIONAL CARBON CREDIT MARKETS",
    "describe_ch": "對於企業面臨排放權控制、國際碳權、碳交易，建立企業碳資產的加值管理與碳交易能力，及碳資產經營專業化之量能，培養企業運營的碳資產綜合管理與業務能量。對於國際CER、VCS、GS、CCER等，建構完整操作體系。",
    "describe_eh": "For enterprises facing emission rights control, international carbon rights and carbon trading, establish the value-added management and carbon trading capabilities of enterprise carbon assets, and the quantitative energy of carbon asset management, and cultivate the comprehensive management and business energy of carbon assets operated by enterprises. For international CER, VCS, GS, CCER, etc., build a complete operation system.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "依聯合國永續發展目標、氣候變化框架、京都議定書及巴黎協定、台灣2050淨零排放政策路徑藍圖，建立之協助中小企業碳資產管理的能力。",
      "describe_en": "Establish the capacity to assist SMEs in carbon asset management in accordance with the United Nations Sustainable Development Goals, the climate change framework, the Kyoto Protocol and the Paris Agreement, and the blueprint of Taiwan's 2050 net-zero emission policy pathway."
    },
    {
      "seq": 2,
      "describe_ch": "CER、VCS、GS、CCER等交易能力。",
      "describe_en": "CER, VCS, GS, CCER and other trading capabilities."
    }
  ],
