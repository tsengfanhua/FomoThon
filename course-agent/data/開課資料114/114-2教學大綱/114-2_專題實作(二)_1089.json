  "description": {
    "sub_id3": null,
    "sub_name": "專題實作(二)",
    "sub_ename": "PRACTICE OF SPECIAL TOPICS (2)",
    "describe_ch": "本課程為終端課程系列的第二門課，由全系所有教師共同開設。學生依據IEET認證規範及專題實作(一)擬定的規劃書逐步實施，針對複雜且整合性問題需較深的知識才可以解決的問題：(1)是一個實際的問題，沒有顯而易見的解決方法。(2)問題本身可能對社會及環境有深遠的影響。(3)需創新的應用專業基本原則及實務上最新的研究成果才可解決的問題。(4)問題本身是多面向的或者是在技術、專業或其他層面上有可能發生相互牽制的情況。(5)解決該問題時，需考量現實中多方資源的限制，例如人力、成本、設備、材料、資訊及技術等。同時呈現專案管理相關之成果，培育學生團隊合作、溝通、計畫控管與整合過去3年所學之能力。",
    "describe_eh": "This course is the second course in a series of capstone courses, which will be taught cooperatively by all the faculty in the department. Students will follow the proposal plan defined by IEET certification and Topic Implementation (I) step by step, with respect to complex and integral issues that require deeper knowledge in order to be resolved: (1) a real issue that lacks an obvious resolution method, (2) an issue that could have a profound impact on society and environment, (3) an issue that requires innovative application of basic professional principles and up-to-date research results from practice in order to be resolved, (4) an issue that is multifaceted or has the potential to result in mutual restriction on a technical, professional, or other level, (5) an issue whose resolution requires consideration of multiple resource constraints that exist in reality, such as manpower, cost, equipment, materials, information, and technology, etc. The course will also present accomplishments related to project management, and will foster students' abilities for teamwork, communication, project control, and integration of all knowledge acquired over the last 3 years.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "訓練學生定義、瞭解問題及尋找資料之能力。",
      "describe_en": "To develop the ability of defining and understanding and finding and collecting reference documents to study a mechanical problem."
    },
    {
      "seq": 2,
      "describe_ch": "訓練學生整合不同課程作一綜合應用之能力。",
      "describe_en": "To develop the ability of integrating different courses to solve a mechanical problem."
    },
    {
      "seq": 3,
      "describe_ch": "訓練學生分工合作、互相討論、整合結果之能力。",
      "describe_en": "To develop the ability of peel cooperation, discussion and integration."
    },
    {
      "seq": 4,
      "describe_ch": "訓練學生撰寫研究報告及口頭發表之能力，並瞭解所研發之技術與綠色產品關連性。",
      "describe_en": "To develop the ability of paper writing and oral expression about a research."
    },
    {
      "seq": 5,
      "describe_ch": "從小組進行專題過程中，實踐彼此尊重、合作之專業倫理關係。",
      "describe_en": "To build the spirit of professional ethics through group discussion."
    }
  ],
