  "description": {
    "sub_id3": null,
    "sub_name": "中英會展口譯",
    "sub_ename": "CHINESE-ENGLISH MICE INTERPRETING",
    "describe_ch": "介紹會展口譯的背景以及其工作形式，讓學生了解與會展口譯相關的技能與資訊處理過程。學生將會學習到基本的技巧，如聽解、預測或是視譯與逐步口譯以幫助他們進行會展口譯。除技巧訓練之外，提供學生許多實際演練與熟悉口譯技巧的活動。在課程尾聲，學生將會對會展口譯有一定的認識。\r\n \r\n\r\n",
    "describe_eh": "This course teaches MICE (Meetings, Incentives, Conferences, Exhibitions) interpreting at the introductory level. Students will be introduced to the practice and forms of conference interpreting. Sight translation and consecutive interpreting will be learnt both as a skill and a transitional activity to MICE interpreting. Students will be required to engage in a number of task-oriented activities including dual-audio processing, chunking, the linear approach to text analysis and anticipation. They will learn the methods of glossary preparation and research for interpreting assignments.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解中英口筆譯技巧及相關修辭。",
      "describe_en": "To understand English-Chinese translation and interpretation techniques and the rhetoric involved\r\n"
    },
    {
      "seq": 2,
      "describe_ch": "綜合演練中英口筆譯，以精進聽說讀寫的能力",
      "describe_en": "To integrate students’ listening, speaking, reading and writing abilities through repeated English-Chinese translating and interpreting exercises"
    }
  ],
