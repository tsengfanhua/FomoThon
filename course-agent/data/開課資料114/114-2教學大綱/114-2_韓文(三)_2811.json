  "description": {
    "sub_id3": null,
    "sub_name": "韓文(三)",
    "sub_ename": "KOREAN(3)",
    "describe_ch": "韓文初級課程(韓文(一)到韓文(四))，採互動式的教學，訓練學生正確的發音，並介紹基本、實用的單字、常用句型，透過反覆地練習使學習韓文?容?，讓學生能使用標準韓文進行表達溝通。\r\n修韓文(三)者必須修過韓文(二)或修滿至少60小時的韓文課程。",
    "describe_eh": "The Korean elementary level consists of four courses which are Korean (1), Korean (2), Korean (3) and Korean (4) and will train students to pronounce Korean precisely, introduce fundamental vocabulary and practical sentences so that they can study or work in a Korean language environment.\r\nKorean (3) is for students who have taken Korean (2) in FCU or have taken 60 hour Korean class. \r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
