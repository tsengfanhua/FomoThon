  "description": {
    "sub_id3": null,
    "sub_name": "智慧製造導論",
    "sub_ename": "INTRODUCTION TO SMART MANUFACTURING",
    "describe_ch": "本課程將以概觀方式來介紹智慧製造的定義、基本觀念與組成元素，並將配合案例、影片、與實務講座來輔助教學，目的在於讓學生瞭解智慧製造的範圍與內涵。",
    "describe_eh": "This course will introduce the definition, basic concepts and components of intelligent manufacturing, and will use cases, videos, and lectures to assist teaching. The purpose is to let students understand the scope and connotation of intelligent manufacturing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解智慧製造系統概觀",
      "describe_en": "Understand the overview of intelligent manufacturing systems"
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明智慧製造支援資訊系統",
      "describe_en": "Understand and explain Information system in intelligent manufacturing"
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解人工智慧、物聯網、大數據的工廠運用",
      "describe_en": " Understand the application of AI, IoT and  Big Data in factories"
    },
    {
      "seq": 4,
      "describe_ch": "藉由實務案例瞭解智慧製造於產業界應用",
      "describe_en": "Understand the application of intelligent manufacturing in the industry through practical cases"
    },
    {
      "seq": 5,
      "describe_ch": "具備運用智慧製造作業流程分析之能力",
      "describe_en": "Be able to apply operation process in intelligent manufacturing"
    }
  ],
