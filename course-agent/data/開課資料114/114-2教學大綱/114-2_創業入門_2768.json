  "description": {
    "sub_id3": null,
    "sub_name": "創業入門",
    "sub_ename": "INTRODUCTION TO ENTREPRENEURSHIP",
    "describe_ch": "本課程介紹創業所需有的基礎功：創業商業分析、創業商業模式、創業團隊運作、創業稅務規劃等四個構面，並提供實際案例探討及實務經驗分享，採「團隊齊心合作」之教學方式，讓學員透過『吸收新知』、『討論收斂』到『實施體驗』的方式，奠基創業的基礎功。",
    "describe_eh": "The course introduces the basic skills required for starting a business: entrepreneurial business analysis, entrepreneurial business model, entrepreneurial team leadership, and entrepreneurial tax planning. It focuses on \"Teamwork” and provides practical experiences to enhance students’ entrepreneurial skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "協助學生了解與培養「創業家精神」\r\n",
      "describe_en": "To help students understand and develop \"Entrepreneurship\"."
    },
    {
      "seq": 2,
      "describe_ch": "介紹工程科學創新如何轉變成商業化的基礎知識",
      "describe_en": "Introduces the fundamentals of how engineering science innovations translate into commercialization."
    },
    {
      "seq": 3,
      "describe_ch": "介紹日常接觸的創新應用，培養對創新的敏銳度",
      "describe_en": "Introduce innovative applications encountered in daily life to cultivate sensitivity towards innovation"
    },
    {
      "seq": 4,
      "describe_ch": "透過分組讓學生發想產業創新的機會，學習團隊合作與專案管理之能力",
      "describe_en": "Through grouping, provide students with opportunities to brainstorm industrial innovations and learn teamwork and project management skills."
    }
  ],
