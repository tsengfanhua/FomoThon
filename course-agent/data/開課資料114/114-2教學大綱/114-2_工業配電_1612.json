  "description": {
    "sub_id3": null,
    "sub_name": "工業配電",
    "sub_ename": "INDUSTRIAL POWER DISTRIBUTION",
    "describe_ch": "一學期課程, 主要教學項目有台灣輸配電系統簡介、家用電力系統、壓降計算、電力三角形、功率因數、電力設備、法規、實物與型錄解說、低壓/ 高壓與特高壓電力系統規劃與設計、保護電驛實驗 、接地實驗與其它主題。",
    "describe_eh": "One-semester course. Lectures include introduction of power distribution and transmission in Taiwan, household power system, voltage drop calculation, power triangle, power factor, power equipments, electric codes, illustrations of facilities and catalogues, planning and designs of low-, high- and extra-high-voltage power systems, experiments of protective relays, grounding experiment as well as other topics concerned.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解相關之工業配電原理及系統應用。",
      "describe_en": "Understand the principles of industry power system and its applications"
    },
    {
      "seq": 2,
      "describe_ch": "能藉由習題的實作，了解及設計工業配電系統。",
      "describe_en": "Can understand industry power system and design it by solving exercises or doing homework."
    }
  ],
