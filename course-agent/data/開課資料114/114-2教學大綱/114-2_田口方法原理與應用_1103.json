  "description": {
    "sub_id3": null,
    "sub_name": "田口方法原理與應用",
    "sub_ename": "TAGUCHI METHOD: FUNDAMENTALS AND APPLICATIONS",
    "describe_ch": "本課程介紹田口方法的基礎原理，探討以最低的成本、最有效率的方法及穩健性的實驗設計，找到製程及產品的競爭力。學生將藉由個案，進行提升品質及減少變異的實驗設計，將可減少實驗成本，並達到產品或製程的品質改善。",
    "describe_eh": "This course introduces the fundamental principles of Taguchi method, explore the lowest cost, most efficient method and robust experimental design to find the competitiveness of the manufacturing process and products. Students will use individual cases to improve the quality and reduce the variation of experimental design, which will reduce the cost of the experiment and achieve the quality improvement of the product or process.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解田口方法的理論基礎。",
      "describe_en": "Understand the theoretical basis of Taguchi method."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉各種直交表實驗設計的原理及其應用的能力。",
      "describe_en": "Familiar with the principles of experimental design of various orthogonal tables and the ability to apply them."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生運用田口方法分析工程問題的能力。",
      "describe_en": "Cultivate students' ability to use Taguchi method to analyze engineering problems."
    }
  ],
