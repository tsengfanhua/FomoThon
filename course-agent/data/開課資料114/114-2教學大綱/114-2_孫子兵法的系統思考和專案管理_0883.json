  "description": {
    "sub_id3": null,
    "sub_name": "孫子兵法的系統思考和專案管理",
    "sub_ename": "The Art of War with Systems Thinking and Project Management",
    "describe_ch": "孫子兵法為決策分析領域的智慧寶典，本課程旨在讓同學學習如何運用系統思考與專案管理的方法來解讀學習孫子兵法並進行有效的組織發展策略擬定與應用。",
    "describe_eh": "Systems thinking and project management are adopted as methodologies in this course to analyze the structure of The Art of War and also applied in the field of decision making.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獨立策劃研究及解決問題之能力",
      "describe_en": "An ability to identify, formulate, and solve problems"
    },
    {
      "seq": 2,
      "describe_ch": "溝通協調及領導團隊合作能力",
      "describe_en": "An ability to communicate effectively and function on a team work."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解孫子兵法的社會發展意義",
      "describe_en": "To realize the meaning of The Art of War with social development"
    },
    {
      "seq": 4,
      "describe_ch": "認識孫子兵法跨領域整合應用觀念",
      "describe_en": "To know the concept of The Art of War"
    }
  ],
