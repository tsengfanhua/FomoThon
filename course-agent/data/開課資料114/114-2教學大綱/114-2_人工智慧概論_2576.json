  "description": {
    "sub_id3": null,
    "sub_name": "人工智慧概論",
    "sub_ename": "ARTIFICIAL INTELLIGENCE",
    "describe_ch": "本課程是人工智慧技術基礎課程，提供人工智慧之基本概念及實作訓練。本課程將引入資料分析，機器學習及實際案例之實作體驗，並介紹及探討人工智慧與光電產業的鏈結。",
    "describe_eh": "As an introductory course in artificial intelligence technology, the course provides basic concept and practical training in artificial intelligence. The course will include the experience of data analysis, machine learning, and practical case implementation. The connections between artificial intelligence and photonics industry will also be introduced and discussed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解人工智慧基礎理論及運作方法。",
      "describe_en": "To know the fundamentals and operation methods of artificial intelligence."
    },
    {
      "seq": 2,
      "describe_ch": "了解人工智慧實務工作應用。",
      "describe_en": "To comprehend the practical applications of artificial intelligence across various industries."
    },
    {
      "seq": 3,
      "describe_ch": "分析人工智慧與光電產業鏈結的最新發展情形。",
      "describe_en": "To analyze the latest developments in the link between artificial intelligence and the optoelectronics industry."
    }
  ],
