  "description": {
    "sub_id3": null,
    "sub_name": "體育－適應體育班",
    "sub_ename": "ADAPTED  PHYSICAL  EDUCATION",
    "describe_ch": "體育處認為經醫師診斷，因身、心障礙而不適宜游泳、較劇烈運動或團體活動之學生，仍需適度參與體育活動，特於民國58年開體育自強班，學習運動技能、鍛鍊健康體能、改善障礙狀況、培養享受人生、增添生活樂趣、落實全民運動之發展。",
    "describe_eh": "The Physical Education Department has designed a special course. A student examined by doctor, because of the body of the student, heart's function and unwell proper strenuous exercises or group activity, still needing the moderation sports activity. The department especially open the Adaptable Sports in Year 58 of the Republic of China, learning exercises technical ability, improve the healthy physique through the course, improve the obstacle condition and develop to enjoy the life and increase to live the fun and practice the civil sports.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 2,
      "describe_ch": "一、建立自我健康適能的正確觀念及知識。\n二、建構自我健康規劃表之能力。\n三、培養長期運動的習慣。",
      "describe_en": "1.Correct idea and knowledge that can set up self- and healthy and right.\n2.Build and construct the self- ability to plan the form healthily.\n3.Form the habit of moving all the life"
    }
