  "description": {
    "sub_id3": null,
    "sub_name": "線性代數(二)",
    "sub_ename": "LINEAR ALGEBRA(2)",
    "describe_ch": "探討向量空間與內積空間的性質與理論。課程內容包括向量運算、向量空間、生成集、獨立集、基底、正交投影、正交對角化、矩陣分解與內積空間。講授式授課輔以作業練習與評量測驗。",
    "describe_eh": "Explore the properties and theories in vector space and inner product space. The course includes vector operations, vector space, spanning set, independent set, basis, orthogonal projection, orthogonal diagonalization, matrix decomposition, and inner product space. The course is mainly lectures, supplemented by exercises and tests.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
