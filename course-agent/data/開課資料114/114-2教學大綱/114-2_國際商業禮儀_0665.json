  "description": {
    "sub_id3": null,
    "sub_name": "國際商業禮儀",
    "sub_ename": "INTERNATIONAL BUSINESS ETIQUETTE",
    "describe_ch": "本課程旨在學習商業英語基礎對話，並了解國際文化差異，且涵蓋進階商用技巧於英文文法 (讀、寫、聽、說)、實用英文以及有效的商業溝通。",
    "describe_eh": "This course is designed to help students develop a basic, practical aural-oral English language comprehension and understanding of Western business etiquette and culture to facilitate communication with foreign business people.  It also includes integrated skills (reading, writing, listening and speaking) for business, grammar and functional English necessary for effective business communication through English.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "發展基本且實用之聽、說商業溝通能力。",
      "describe_en": "To develop basic, practical business aural-oral business communication skills"
    },
    {
      "seq": 2,
      "describe_ch": "增加商業英語能力；尤其是聽、說能力。改正經常發生之錯誤英語文法，並使學生積極參與討論並完成每日課業。",
      "describe_en": "To improve business English language (primarily aural and oral) skills (targeting errors commonly made by speakers of native Chinese languages) by taking responsibility for learning as an active learner and participant in classroom lessons and homework"
    },
    {
      "seq": 3,
      "describe_ch": "使學生在職場和社交中能有效地使用商業英文。",
      "describe_en": "To enable students effectively use Business English in the workplace environment as well as socially."
    }
  ],
