  "description": {
    "sub_id3": null,
    "sub_name": "民法物權",
    "sub_ename": "CIVIL CODE-PROPERTY",
    "describe_ch": "本課程著重在基本財產權觀念、限制、分枝及其形式，內容包括：所有權、地上權、永佃權、地役權、抵押權、質權、留置權與佔有。　",
    "describe_eh": "This course focus on basic study of property rights, its limitations and special forms in which it could appear, including: Ownership, Superficies, Yong-Dian, Servitudes, Mortgage, Lien, Dian and Right Of Retention.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培育具有土地管理專業知識與實務整合之專業人才。",
      "describe_en": "Cultivate professional talents with professional knowledge and practical integration of land management."
    },
    {
      "seq": 2,
      "describe_ch": "養成具有創新思維、實務運用與團隊合作之人才。",
      "describe_en": "Cultivate talents with innovative thinking, practical application and teamwork."
    },
    {
      "seq": 3,
      "describe_ch": "培養兼具社會責任與國際觀之專業人才。",
      "describe_en": "Cultivate professional talents with both social responsibility and international perspective."
    }
  ],
