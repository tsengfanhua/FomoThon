  "description": {
    "sub_id3": null,
    "sub_name": "道路交通環境工程",
    "sub_ename": "INTRODUCTION TO ENGINEERING & THE ENVIRONMENT",
    "describe_ch": "培養學生對於道路交通環境之發展現況有所政策方向之認識、技術發展之瞭解，進而透過台灣現有智慧運輸的理解，結合自身運輸需求之特性，提出創新運輸服務之創意。",
    "describe_eh": "To cultivate students’ understanding of the policy directions and technological developments related to the current state of road transportation environments, and through an understanding of Taiwan’s existing Intelligent Transportation Systems(ITS),enable them to integrate the characteristics of their own transportation needs and propose innovative transportation service concepts.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "2.教授各運輸或物流系統之規劃、設計理論與實務概念",
      "describe_en": "2. Provide students with knowledge of the theories and practices of planning and design in transportation and logistics systems."
    },
    {
      "seq": 2,
      "describe_ch": "6.培養學生規劃、設計與執行運輸或物流議題之流程與實作能力",
      "describe_en": "6. Develop students' ability to plan, design, and implement solutions to transportation and logistics issues."
    },
    {
      "seq": 4,
      "describe_ch": "9.培養學生探討運輸與物流於環境永續與觀光發展關聯性之能力",
      "describe_en": "9. Develop students' ability to analyze the relationships between transportation and logistics, environmental sustainability, and tourism development."
    }
  ],
