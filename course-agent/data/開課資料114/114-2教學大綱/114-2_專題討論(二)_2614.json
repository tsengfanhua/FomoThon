  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(二)",
    "sub_ename": "SEMINAR(2)",
    "describe_ch": "本課程中會安排校外來賓進行的專題演講，以增廣學生在光電領域方面的視野。此外在本課程中，教師會教導學生書面報告的技巧，並會要求學生以小組討論英文期刊論文，並提出報告。\r\n",
    "describe_eh": "Several professional talks will be arranged to broaden students' perspectives in the field of optics and photonics. Additionally, the skills of scientific paper writing are introduced in this course. Student need to discuss English journal papers in teams, and write reports on the papers.\r\n　",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識當前光電技術。",
      "describe_en": "To know the state-of-the-art techniques of optics and photonics."
    },
    {
      "seq": 2,
      "describe_ch": "以小組討論論文中的技術。",
      "describe_en": "To discuss the technique presented in papers."
    },
    {
      "seq": 3,
      "describe_ch": "撰寫科技論文之閱讀報告。",
      "describe_en": "To write a reading report on an English paper."
    },
    {
      "seq": 4,
      "describe_ch": "理解專業倫理。",
      "describe_en": "To comprehend professional ethics."
    },
    {
      "seq": 5,
      "describe_ch": "藉由網路資源收集資料與自我學習。",
      "describe_en": "To collect information and self-learn through the online resources."
    }
  ],
