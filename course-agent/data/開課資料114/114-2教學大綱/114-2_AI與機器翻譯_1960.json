  "description": {
    "sub_id3": null,
    "sub_name": "AI與機器翻譯",
    "sub_ename": "AI AND MACHINE TRANSLATION",
    "describe_ch": "本課程將介紹以人工智慧為本之現有翻譯科技，協助學生運用軟體進行實作，並確保翻譯之品質；進一步啟發其興趣，進一步探索人工智慧與翻譯之間的各種相關議題。課程內容包括人工智慧及翻譯科技之演進與發展、機器翻譯素養、翻譯軟體應用、人機譯本比較以及機器翻譯結果編修等相關主題。",
    "describe_eh": "This course introduces translation technology based on artificial intelligence (AI) and integrates it into the translation curriculum. The aim is to equip students with the skills to utilize AI and various translation technologies to perform practical translation tasks while ensuring high translation quality. Students are encouraged to stay informed about the latest trends in AI and translation, and to further explore related issues in the future. The course covers the following topics: the development of AI, the evolution of translation technology, literacy in machine translation, the application of translation software, comparison between human and machine translations, and post-editing of AI-assisted translations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解中英口筆譯技巧及相關修辭",
      "describe_en": "To understand English-Chinese translation and interpretation techniques and the rhetoric involved"
    },
    {
      "seq": 2,
      "describe_ch": "具備口筆譯實務的應用能力",
      "describe_en": "To apply the knowledge of translation and interpretation in the workplace"
    },
    {
      "seq": 3,
      "describe_ch": "綜合探討跨領域主題，提升專業知識",
      "describe_en": "To integrate interdisciplinary knowledge"
    }
  ],
