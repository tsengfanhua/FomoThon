    "tpa_score_new": "<div>\n<div>評分標準</div>\n\n<ol>\n\t<li>Exams: 30%+35%= 65%</li>\n\t<li>Report: 20%</li>\n\t<li>Attendance and others: 15%</li>\n</ol>\n</div>\n",
