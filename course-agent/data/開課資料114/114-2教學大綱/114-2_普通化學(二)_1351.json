  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備化學的基礎知識。",
      "describe_en": "Have the foundamental chemistry knowledge"
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解化學在工業應用層面的重要性及影響",
      "describe_en": "Understand the importance and effects of chemistry to industrial application."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解化學原理、物質化學特性、分析方法。建立解題之思考邏輯。",
      "describe_en": "Understand the chemical theory, chemical properties of matters, analyzing methods. Think logically to solve the problem.　"
    }
