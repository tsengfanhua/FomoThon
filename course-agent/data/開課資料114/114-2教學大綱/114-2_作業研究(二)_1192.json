  "description": {
    "sub_id3": null,
    "sub_name": "作業研究(二)",
    "sub_ename": "OPERATIONS RESEARCH(2)",
    "describe_ch": "使學生學習作業研究的應用實務技術與相關原理，以便能有足夠的學理基礎與知識去\r\n學習其他相關課程，同時亦可以具備實務應用能力，以備解決實際應用問題。課程內容包括網\r\n路最佳化模式、動態規劃、賽局理論、馬可夫隨機過程、及等候原理。",
    "describe_eh": "The aim of this course is to make students understand the advanced theory andapplications of operations research and to let students obtain capability to study more advanced related courses and solve practical problems. This course covers the\r\ntechnique.",
    "pre_subname": "INEN3045作業研究(一)",
    "pre_sub_id3": "INEN3045",
    "pre_sub_ename": "INEN3045 OPERATIONS RESEARCH(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解網路最佳化問題模式建立、解法及應用。",
      "describe_en": "Understand model formulation and solution methods for network optimization problem."
    },
    {
      "seq": 2,
      "describe_ch": "能夠使用動態規畫求解作業研究相關的問題。",
      "describe_en": "Be able to understand the theory and procedures of dynamic programming and be able to use it to solve\r\noperations research related problems."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解馬可夫隨機過程模式之建立及求解實際應用問題。",
      "describe_en": "Be able to understand the theory and procedures of markov chains and be able to use it to solve practical problems."
    }
