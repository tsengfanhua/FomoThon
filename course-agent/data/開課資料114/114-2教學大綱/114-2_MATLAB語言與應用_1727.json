  "description": {
    "sub_id3": null,
    "sub_name": "MATLAB語言與應用",
    "sub_ename": "MATLAB PROGRAMMING AND APPLICATION",
    "describe_ch": "這門課程的主要目標是鼓勵學生使用MATLAB作為分析解決工程問題的工具；MATLAB具有簡便的互動式使用者環境，而其所提供之廣泛數值計算和圖形視覺功能，也使其被廣泛使用在諸如信號處理，控制系統和統計等等不同的技術領域學門上；在此一課程，學生將學習如何使用MATLAB 進行數值上的分析以有效解決所遭遇之工程問題。",
    "describe_eh": "The primary objective of this course is to encourage students to use MATLAB as a tool to analyze and solve the engineering problems. MATLAB provides an easy-to-use interactive environment which includes extensive numerical computation and visualization capabilities. As a result, now, it has been broadly used in different technical areas, such as signal processing, control system, and statistics etc. In this course, students will learn how to use  MATLAB to implement numerical analyses and subsequently solve the engineering problems more profoundly.",
    "pre_subname": "ENGS2011工程數學(一)",
    "pre_sub_id3": "ENGS2011",
    "pre_sub_ename": "ENGS2011 ENGINEERING MATHEMATICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能具有MATLAB 程式語言撰寫開發技能\r\n\r\n",
      "describe_en": "To develop programming skills in the MATLAB computing language"
    },
    {
      "seq": 2,
      "describe_ch": "能針對工程問題建立系統化的概念，進而有效使用電腦分析方法解決問題。\r\n\t\r\n",
      "describe_en": "To develop a systematic method for setting up engineering problems that are solved using computer analysis methods."
    },
    {
      "seq": 3,
      "describe_ch": "能運用MATLAB程式語言於所學之專長領域  \r\n\r\n",
      "describe_en": "To enhance students' professional area by utilizing MATLAB"
    },
    {
      "seq": 4,
      "describe_ch": "能以系統化的概念與方式解決各式的規劃問題",
      "describe_en": "Be able to develop systematic approach to solve various type of planning problem"
    }
  ],
