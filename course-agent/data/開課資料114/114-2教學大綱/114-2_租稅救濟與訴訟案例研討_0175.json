    {
      "seq": 1,
      "describe_ch": "理解稅法及立法意旨與租稅法律主義及實質課稅原則",
      "describe_en": "Comprehend tax law and tax law legislative intent, principle of taxation under the law, substantive taxation principles"
    },
    {
      "seq": 2,
      "describe_ch": "理解徵納雙方課稅爭議問題所在及我國租稅行政救濟制度，保護納稅者權利",
      "describe_en": "Comprehend tax collector & taxpayer controversial issues. Applice administrative remedy of taxation to protection taxpayer right."
    },
    {
      "seq": 3,
      "describe_ch": "結合會計、租稅、法律及國際租稅領域培養邏輯思考及分析解決問題能力",
      "describe_en": "Combine Accounting、tax、Law and International taxation cultivate the ability to logical thinking and analytical problem solving skills."
    }
