    {
      "seq": 4,
      "describe_ch": "能獲得環境調查分析的基本知識與技能",
      "describe_en": "Knowledge and abilities of environmental survey and analysis.\r\n"
    },
    {
      "seq": 5,
      "describe_ch": "能理解團隊合作的精神與內涵",
      "describe_en": "Comprehension for the spirit and content of team working."
    },
    {
      "seq": 6,
      "describe_ch": "能理解專業倫理的涵意",
      "describe_en": "Comprehension for the meaning of professional ethics.\r\n"
    }
