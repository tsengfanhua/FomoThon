  "description": {
    "sub_id3": null,
    "sub_name": "化合物半導體",
    "sub_ename": "COMPOUND SEMICONDUCTOR",
    "describe_ch": "介紹砷化鎵系列化合物半導體的物理、化學特性，如晶格構造能帶圖。以及利用化合物半導體製造的元件之電性，並與矽元件加以比較。",
    "describe_eh": "Introduce the physical properties of compound semiconductors and devices. Compare their characteristics with those of Si devices.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道各類化合物半導體與矽半導體的異同點。",
      "describe_en": "Knowledge for the same and difference between compound and Si semiconductors."
    },
    {
      "seq": 2,
      "describe_ch": "理解化合物半導體各項特性。",
      "describe_en": "To comprehend all kinds of characteristics of compound semiconductor materials."
    },
    {
      "seq": 3,
      "describe_ch": "應用化合物半導體的特性設計特定元件。",
      "describe_en": "To apply compound semiconductor to design a specificed semiconductor deivce."
    }
  ],
