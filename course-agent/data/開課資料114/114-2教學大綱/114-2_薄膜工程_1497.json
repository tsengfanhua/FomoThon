  "description": {
    "sub_id3": null,
    "sub_name": "薄膜工程",
    "sub_ename": "THIN FILM TECHNOLOGY",
    "describe_ch": "近20年來，薄膜技術迅速發展，帶動高科技產業如半導體、光電、通訊生技等，例如：各種感測器、生物晶片、太陽電池、面板、手機等，都離不開薄膜技術，可以說薄膜技術已成為構築高科技產業的基本要素。課程內容：第1章 真空科學與技術；第2章 物?氣相沉積；第3章 化學氣相沉積。",
    "describe_eh": "Over the last 20 years, film technology develops rapidly and drives the development of high-tech industries, such as semiconductor, photonics and communication technology, such as sensors, biochips, solar batteries, panels and mobile phones, which all require film technology. Film technology becomes the basic element to construct the high-tech industry. Course content: Chapter 1 Vacuum Science and Technology; Chapter 2 Physical Vapor Deposition (PVD); Chapter 3 Chemical Vapor Deposition (CVD).",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解真空科學之知識。",
      "describe_en": "Understand the knowledge about vacuum science."
    },
    {
      "seq": 2,
      "describe_ch": "具備PCD、CVD法成長薄膜的製程應用能力。",
      "describe_en": "Be able to utilize the manufacture process of film growth through PCD and CVD methods."
    }
  ],
