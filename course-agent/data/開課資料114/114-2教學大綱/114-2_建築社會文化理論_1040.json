  "description": {
    "sub_id3": null,
    "sub_name": "建築社會文化理論",
    "sub_ename": "ARCHITECTURAL SOCIOCULTURAL",
    "describe_ch": "本課程的重點主要在探討二十世紀至今的建築社會文化理論與哲學相關思潮發展，焦點集中在建築符號學、知覺現象學、空間權力學及其他相關理論，還有他們背後知名的哲學家、哲學論述以及對於建築設計思潮的影響。授課方式除講授基本學理與文獻閱讀討論並行之外，並輔以課堂實例分析討論。",
    "describe_eh": "The main issue of this course is to explore the development of architectural sociocultural theories and philosophies related thoughts on architecture from the 20th century to the present. This focus is on architectural semiotics, perceptual phenomenology, spatial power and other related theories, as well as the well-known philosophers and philosophies behind them and their influence on architectural design thinking trends. The teaching method is to teach basic theories and literature reading and discussion. In parallel, example analysis and discussion will also be supplemented in class.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "對於建築社會文化理論與哲學思潮之學理以及對建築設計思潮的影響能夠有基礎性的認識與理解。",
      "describe_en": "Fundamental comprehension for the architectural sociocultural theories and philosophies, and their influence on architectural design thinking trends."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解建築社會文化理論與哲學思潮之重要性，同時透過課程的訓練能將所學應用在建築設計議題的論述發展上。",
      "describe_en": "Understanding of the importance of the architectural sociocultural theories and philosophies, and application of what they have learned through courses into architectural design issue discussion and development."
    }
  ],
