  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB02129",
    "sub_id": "61269",
    "scr_dup": "001",
    "sub_title": "商用微積分",
    "sub_title_en": null,
    "sub_describe": "管理決策強調需具備嚴謹的精確的分析方法來提高決策的品質，而商用微積分，此學科可提供商學院學生數量的精準分析及增進學生邏輯思考和推理能力之外，更有助於學生在大學未來學習各種商學課程，如經濟學、統計學、財務金融、行銷研究等學科的數量分析的基礎。課程內容為: 1函數的極限、連續性、導數的定義、微分法、連鎖律。2. 導數的應用：含均值定理、函數的遞增遞減、函數的凹凸性。 3. 積分：介紹不定積分、定積分的定義，面積問題，微積分基本定理，代換積分法。 4. 指數函數和對數函數：指數函數和對數函數的介紹及其導函數。 5. 積分法：含變數變換，分部積分法。 6. 偏導數：介紹多變數函數偏導數，連鎖律，多變數函數的極值問題，重積分及無窮級數等。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "商用微積分",
    "sub_ename": "CALCULUS",
    "describe_ch": "管理決策強調需具備嚴謹的精確的分析方法來提高決策的品質，而商用微積分，此學科可提供商學院學生數量的精準分析及增進學生邏輯思考和推理能力之外，更有助於學生在大學未來學習各種商學課程，如經濟學、統計學、財務金融、行銷研究等學科的數量分析的基礎。",
    "describe_eh": "Management decision-making underscores the importance of rigorous and precise analytical methods to enhance decision quality. Calculus equips business school students with accurate quantitative analysis skills and strengthens their logical thinking and reasoning abilities. Additionally, it lays a solid foundation for quantitative analysis in various future business courses, including economics, statistics, finance, and marketing research.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用微積分解決商業問題/問題解決能力",
      "describe_en": "Apply calculus to solve business problems / Problem-Solving Skills"
    },
    {
      "seq": 2,
      "describe_ch": "掌握微積分的基本概念/數學能力",
      "describe_en": "Master the basic concepts of calculus / Mathematical Skills"
    }
