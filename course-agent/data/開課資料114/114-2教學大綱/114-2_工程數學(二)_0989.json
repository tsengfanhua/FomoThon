  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(二)",
    "sub_ename": "ENGINEERING MATHEMATICS(2)",
    "describe_ch": "本課程在於描述向量微積分學的重要觀念和知識。介紹多種多重積分的定義、計算公式以及一般的應用。課程內容包含純量函數的梯度、向量函數的旋度和散度、線積分、雙重積分、面積分和體積分，以及各種積分之間的轉換定理。",
    "describe_eh": "This course introduces to students the important concepts and knowledge of vector calculus. Multiple integrals are introduced including the definitions, formulas for evaluating and general applications. It contains the following primary topics: gradient of scalar functions, divergence and curl of vector functions, line integrals, double integrals, surface integrals and volume integrals, Green's theorem, Stoke's theorem and Divergence theorem.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "\t理解向量微積分的基本觀念",
      "describe_en": "1.\t\tComprehension of basic concepts of the vector calculus"
    },
    {
      "seq": 2,
      "describe_ch": "理解梯度、旋度、散度的物理意義及熟悉向量微分的計算方法\t",
      "describe_en": "2.\tTo comprehend physical meaning of gradient, curl and divergence, and to know the calculation of vector differential calculus"
    },
    {
      "seq": 3,
      "describe_ch": "熟悉向量積分的計算及重要轉換定理\t",
      "describe_en": "3.\tTo know the calculation of vector integrals and important vector integral theorems"
    },
    {
      "seq": 4,
      "describe_ch": "\t應用向量微積分處理工程相關問題\t",
      "describe_en": "4.\tTo apply the vector calculus to deal with engineering problems"
    }
  ],
