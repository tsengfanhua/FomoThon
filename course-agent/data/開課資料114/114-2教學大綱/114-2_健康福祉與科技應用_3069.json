  "description": {
    "sub_id3": null,
    "sub_name": "健康福祉與科技應用",
    "sub_ename": "HEALTH, WELL-BEING, AND TECHNOLOGY APPLICATIONS",
    "describe_ch": "本課程主要是以全球永續發展目標三(SDGS3)，良好健康與社會福利為基礎，內容涵蓋SDG3所談之食物安全、提升孕婦健康、降低疾病發生…以及全面檢視如何透過優質健保制度層面，獲得安全、有效、有品質和負擔得起的健康福利。另外，因應科技發展，醫療保健領域如何有效應用，例如：醫學人工智慧用於診斷、藥物開發乃至從全球遠距醫療發展，看台灣如何擁抱健康照護模式創新。培養學生面對人口老化與健康議題的解決能力。",
    "describe_eh": "This course is based on Sustainable Development Goals 3 (SDGS3), good health, and well-being, and covers food safety, maternal health promotion, and disease reduction in SDG3. It provides a comprehensive review on how to obtain safe, effective, quality, and affordable health benefits through a quality health care system. In addition, it also covers how to effectively apply technology in the healthcare field in response to technological development, including medical artificial intelligence for diagnosis and drug development, and see how Taiwan can embrace innovation in health care mode from the development of global telemedicine. This course aims to develop students' problem-solving skills in the face of population aging and health issues.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "引導學生了解全球永續發展議題現況與發展。",
      "describe_en": "To introduce students to understand the current status and development of global sustainable development issues."
    },
    {
      "seq": 2,
      "describe_ch": "透過跨領域合作設計與構思健康福祉所待解決之問題。",
      "describe_en": "To design and conceptualize health and well-being issues to be addressed through cross-disciplinary collaboration."
    }
  ],
