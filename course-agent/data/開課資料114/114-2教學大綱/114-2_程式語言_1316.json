  "description": {
    "sub_id3": null,
    "sub_name": "程式語言",
    "sub_ename": "PROGRAMMING LANGUAGE",
    "describe_ch": "本課程在探討各種近代程式語言的概念，包括文法結構和語意、設計及實作問題。課程將涵蓋 Imperative languages、Functional languages、Logical languages 和 Object-Oriented languages",
    "describe_eh": "This course introduces to students the concept of modern programming languages, including syntax structure and semantics, design and implementation issues. We will cover the relative topics on Imperative languages、Functional languages、Logical languages, and Object-Oriented languages.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解程式各種語言設計理論與實作方法",
      "describe_en": "To understand the design theory and implementation approaches of the various programming languages"
    },
    {
      "seq": 2,
      "describe_ch": "分析程式語言的語法與語意",
      "describe_en": "To analyze syntax and semantics of programming languages"
    },
    {
      "seq": 3,
      "describe_ch": "評鑑各種程式語言的優劣點\n",
      "describe_en": "To evaluate advantage and disadvantage of  various programming language"
    }
