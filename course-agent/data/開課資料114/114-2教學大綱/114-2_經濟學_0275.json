  "description": {
    "sub_id3": null,
    "sub_name": "經濟學",
    "sub_ename": "ECONOMICS",
    "describe_ch": "本課程提供個體與總體經濟的基礎介紹，主題包括：供給、需求與價格機能運作；市場經濟下的家戶、廠商與政府決策；整體產出、金融體系、失業、物價膨脹、匯率與利率；財政與貨幣政策。\r\n",
    "describe_eh": "This course provides an introduction to microeconomic and aggregate economic analysis. Topics include supply, demand, and the coordinating role of prices in a market economy; decision making by households, firms, and government in a market-oriented economy; national output, banking systems, unemployment, inflation, exchange rates, and interest rates； fiscal policy and monetary policy.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解供需原理與價格機能運作",
      "describe_en": "Comprehending principles of supply\r\nand\tdemand, and operations of the\tA2 price mechanism\r\n"
    },
    {
      "seq": 2,
      "describe_ch": "理解市場經濟下的家戶、廠商與政府決策",
      "describe_en": "Comprehending decision\tmaking by\r\nhouseholds, firms, and government\tin\tA2 a market-oriented economy\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "理解整體產出、金融體系、失業、物價膨脹、匯率與利率",
      "describe_en": "Comprehending an economy’s output,banking systems,\tunemployment,inflation, exchange rates, and interest rates"
    },
    {
      "seq": 4,
      "describe_ch": "理解貨幣政策與財政政策",
      "describe_en": "Comprehending fiscal policy and monetary policy"
    }
  ],
