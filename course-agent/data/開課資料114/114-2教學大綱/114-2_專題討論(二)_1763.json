  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(二)",
    "sub_ename": "SEMINAR(2)",
    "describe_ch": "專題討論為博士班學生必修科目，透過每位同學由1?2篇國外期刊的重點描述與評估，學習文章的寫作佈局、練習口頭簡報的彙整與表達，並吸收國際新知，另由台上、台下的提問互動，練習應對及反應。學其間亦會邀請產、官、學者有名聲的專家、前輩分享專題，此亦為同學見賢思齊與仿效的機會。",
    "describe_eh": "Seminar is a required course for Ph.D students, in which literature surveying, paper reading, information analysis, compiling, and report writing are necessary. Via oral presentation with power point software, students discuss research problems with instructors and classmates in public. This is a fundamental training for thesis and academic presentation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "訓練同學獨立研究及分析能力",
      "describe_en": "Enhance the ability of independent study and analysis"
    },
    {
      "seq": 2,
      "describe_ch": "強化專業議題之認知",
      "describe_en": "Facilitate the cognition of professional issues"
    },
    {
      "seq": 3,
      "describe_ch": "提昇簡報技巧，促進溝通協調能力",
      "describe_en": "Enhance the technique of oral presentation"
    },
    {
      "seq": 4,
      "describe_ch": "增進研究歷程之專業倫理及資訊倫理認知",
      "describe_en": "Enhance the understanding of professional ethics and information ethics in the research process."
    }
  ],
