  "description": {
    "sub_id3": null,
    "sub_name": "停車場規劃設計與經營",
    "sub_ename": "PARKING FACILITY-PLANNING DESIGN & MANAGEMENT",
    "describe_ch": "停車場建設為都市環境與都市經濟之重要環節。本課程之目的在強調：（一）停車需求分析預測與停車場服務之特性；（二）停車場規劃、設計基本原則與建築相關法令；（三）停車場經營、行銷與財務平衡之原則；（四）案例討論，培養同學在規劃、設計與經營之基本能力。",
    "describe_eh": "Parking facility construction is the basic foundation for urban environmental protection & urban economic development. This course is to emphasize the basic concepts : (1) parking demand analysis & forecast, (2) building code, (3) parking facility management & marketing, (4) case study.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.教授各運輸或物流系統之特性與相關基本概念",
      "describe_en": "1. Provide students with knowledge of the characteristics and fundamental concepts of various transportation and logistics systems."
    },
    {
      "seq": 2,
      "describe_ch": "2.教授各運輸或物流系統之規劃、設計理論與實務概念",
      "describe_en": "2. Provide students with knowledge of the theories and practices of planning and design in transportation and logistics systems."
    },
    {
      "seq": 3,
      "describe_ch": "9.培養學生探討運輸與物流於環境永續與觀光發展關聯性之能力",
      "describe_en": "9. Develop students' ability to analyze the relationships between transportation and logistics, environmental sustainability, and tourism development."
    },
    {
      "seq": 4,
      "describe_ch": "12.培養學生簡報製作、報告撰寫、口頭報告以及提問研討之能力",
      "describe_en": "12. Develop students' skills in presentation, report writing, oral delivery, and academic discussion."
    }
  ],
