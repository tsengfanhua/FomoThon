  "description": {
    "sub_id3": null,
    "sub_name": "運輸資料分析專論",
    "sub_ename": "SPECIAL TOPICS OF TRANSPORTATION DATA ANALYSIS",
    "describe_ch": "\"本課程以實務觀點介紹各種領域之資料處理與案例介紹，包含公共運輸，運輸安全，交通控制，觀光旅運與運輸物流。過程中邀請實務界專家討論專案研究與經驗分享，同時深入淺出介紹大數據分析及人工智慧之概念。\n備註: 不需寫程式，也不需學習特定軟體!\"\r\n",
    "describe_eh": "\"This course is an introductory course for data analysis and case studies.  The data from the fields of public transportation, traffic safety, traffic control, smart tourism, and logistics will be introduced and explained.  The relevant methodologies will be used to analyze those data.  Meanwhile, the concepts of big data analysis and artificial intelligence will be discussed as well.\nPS: No programming skill and knowledge of specific software is required for this course!\"\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "資訊化思維至交通運輸資訊交換與呈現",
      "describe_en": "Apply information meditation to traffic information exchange and presentation."
    },
    {
      "seq": 2,
      "describe_ch": "藉由電腦技術與應用軟體分析交通運輸問題",
      "describe_en": "Be able to apply computer systems and software packages to analyze transportation related problems."
    },
    {
      "seq": 3,
      "describe_ch": "撰寫研究論文、相互研討、製作簡報及口頭報告",
      "describe_en": "Possess the abilities of essay writing, mutual discussion, presentation documents preparation, and oral presentations."
    }
  ],
