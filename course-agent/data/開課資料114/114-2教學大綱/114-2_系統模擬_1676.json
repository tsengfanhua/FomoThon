  "description": {
    "sub_id3": null,
    "sub_name": "系統模擬",
    "sub_ename": "SYSTEM SIMULATION",
    "describe_ch": "如何使用電腦進行動態模擬。內容包括機械系統與電路系統動態方程式的推導，如何以MATLAB/SIMULINK軟體建立動態模擬平台，以及如何撰寫報告呈現模擬結果。",
    "describe_eh": "The purpose of this course is to provide the knowledge about how to implement dynamical simulations of mechanical systems, electrical systems, and electromechanical systems on desktop computers, and the skill of writing technical reports for professional presentation of simulation results.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
