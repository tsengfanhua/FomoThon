  "description": {
    "sub_id3": null,
    "sub_name": "大數據分析與應用",
    "sub_ename": "BIG DATA ANALYTICS AND APPLICATIONS",
    "describe_ch": "本課程將藉由資料分析工具的介紹，來帶領學生熟悉資料選擇、處理、倉儲建立，以及相關的分析工具應用，與統計分析方法的技巧，讓學生得以因應多樣性數據資料的分析應用。",
    "describe_eh": "Through the introduction of data analysis tools, this course will guide students to familiarize themselves with data selection, preparation, warehousing, as well as the application of related analysis tools, and the skills of statistical analysis methods, so that students can respond to the analysis and application of diverse data.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "強化學生熟捻分析工具以及實作之專業能力。",
      "describe_en": "Reinforce the ability of statistical analysis tools and application"
    },
    {
      "seq": 2,
      "describe_ch": "培養學生之專業分析能力，使其滿足學界與業界對於大數據人才的需求。",
      "describe_en": "Train the ability of statistical analysis"
    },
    {
      "seq": 3,
      "describe_ch": "介紹常用的資料分析技術，並搭配教授統計軟體操作，以期日後能運用各種技術於各種類型資料之分析。",
      "describe_en": "Introduce the statistical analysis tools and statistical software in order to apply in different type of data"
    }
  ],
