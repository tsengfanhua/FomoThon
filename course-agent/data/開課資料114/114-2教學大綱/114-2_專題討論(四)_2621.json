  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(四)",
    "sub_ename": "SEMINAR(4)",
    "describe_ch": "本課程中會安排校外來賓進行的專題演講，以增廣學生在光電領域方面的視野。此外在本課程中，教師會教導學生口頭報告的技巧，並要學生以英文簡報檔進行報告。\r\n",
    "describe_eh": "Several professional talks will be arranged to broaden students' perspectives in the field of optics and photonics. Additionally, the skills of oral presentation are introduced. Students need to present with English slides in this course.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識當前光電技術。",
      "describe_en": "To know the state-of-the-art techniques of optics and photonics."
    },
    {
      "seq": 2,
      "describe_ch": "具備撰寫英文簡報檔之能力。",
      "describe_en": "Be able to prepare English slides in English."
    },
    {
      "seq": 3,
      "describe_ch": "能參訪光電展、參加研討會或與業界交流。",
      "describe_en": "To visit exposition of optics and photonics, or to attend a conference, or to communicate with industry."
    }
  ],
