  "description": {
    "sub_id3": null,
    "sub_name": "西洋文學概論(二)",
    "sub_ename": "INTRODUCTION TO WESTERN LITERATURE(2)",
    "describe_ch": "本課程將引導學生進入西洋古典文學的領域，並希望能藉此帶領學生體驗此領域文學之奧妙，發掘文學閱讀的樂趣，進而培養文學欣賞的能力。本課程的學習將有助於培養學生在未來閱讀英、美、及歐洲文學作品時的理解力及較深刻的剖析能力。",
    "describe_eh": "This course is to introduce to students of English the field of classical western literature, covering the years from 1400 to modern times. By reading the literary works of this long period, students will know the powerful imagination and creativity of the authors during and after the Renaissance as well as the development of western civilization. Moreover, they will find some pleasure from their reading to further their appreciation and analysis of key literary works in the wide body of British, American, and European literature.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
