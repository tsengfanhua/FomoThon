  "description": {
    "sub_id3": null,
    "sub_name": "水質分析實驗",
    "sub_ename": "EXPERIMENT OF WATER QUALITY ANALYSIS",
    "describe_ch": "本課程為提供學生水質分析的實際操作與相關環境應用。內容包括固體物、濁度與色度、臭味、酸度與鹼度、硬度、餘氯、氯離子、溶氧及生化需氧量、紫外光UV254及化學需氧量、氨氮及有機氮、亞硝酸鹽蛋及硝酸鹽氮、正磷酸鹽及總磷、介面活性劑等水質分析相關實驗。",
    "describe_eh": "This course provides students on gaining a practical operation of water quality analysis, including solids, turbidity and color, odor, acidity and alkalinity, hardness, chlorine residual, chloride ions, dissolved oxygen and biochemical oxygen demand, UV-254 and chemical oxygen demand, ammonia and organic nitrogen, nitrite and nitrate, phosphate and total phosphor, and surfactant, etc.",
    "pre_subname": "EES2011分析化學實驗、ENGS1016普通化學實驗(一)、ENGS1017普通化學實驗(二)",
    "pre_sub_id3": "EES2011",
    "pre_sub_ename": "EES2011 ANALYTICAL CHEMISTRY LAB.、ENGS1016 GENERAL CHEMISTRY LAB.(1)、ENGS1017 GENERAL CHEMISTRY LAB.(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解達到水質實驗品質保證與品質管制之技巧與方法。",
      "describe_en": "Be able to comprehend the approaches and skills of assuring quality assurance and quality control in water and wastewater analysis."
    },
    {
      "seq": 2,
      "describe_ch": "應用實際操作各項水質分析工作以掌握分析之準確性與再現性。",
      "describe_en": "Be able to train students experience water and wastewater analysis and have the abilities on accuracy and repeatability of analysis work.　"
    },
    {
      "seq": 3,
      "describe_ch": "學習水質實驗分析報告之撰寫格式與技巧。",
      "describe_en": "Learn how to conduct a well-format report for analysis work.　"
    },
    {
      "seq": 4,
      "describe_ch": "能夠正確執行實驗器材和儀器的操作維護。 \t",
      "describe_en": "know how to perform and maintain the experimental equipment and instruments"
    },
    {
      "seq": 5,
      "describe_ch": "學習群組工作之分工與協調能力。  \t",
      "describe_en": "Learn the sharing and negotiating skills for team work."
    },
    {
      "seq": 6,
      "describe_ch": "應用水質分析實驗所學之實驗技巧解決環境問題。 \t",
      "describe_en": "Solve environmental problems by applying the experimental skills learned in water and wasterwater quality analysis."
    },
    {
      "seq": 7,
      "describe_ch": "學習現行的水質檢測方法以及其查詢方法和適用範圍。 \t",
      "describe_en": "Learn the current water and wastewater analytical methods, how to search the methods, and the scope of applications"
    },
    {
      "seq": 8,
      "describe_ch": "理解學術倫理以及不當研究行為的嚴重性。 \t",
      "describe_en": "Understand academic ethics and the seriousness of research misconduct"
    }
  ],
