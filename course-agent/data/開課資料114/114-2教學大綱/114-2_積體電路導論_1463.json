  "description": {
    "sub_id3": null,
    "sub_name": "積體電路導論",
    "sub_ename": "INTRODUCTION TO INTEGRATED CIRCUIT",
    "describe_ch": "本課程主要是講授積體電路的基本觀念，先從簡易電子學概念入門，再介紹半導體的基本概念。積體電路的設計、製造以及產業的現況都會在本課程描述。",
    "describe_eh": "This course provides some basic concepts of integrated circuit. In the beginning, some points of view will be introduced from electronics.  Semiconductor concepts will be followed. Integrated circuit design, manufacturing and industry status will than be described in the back part of the class.",
    "pre_subname": "CEM1006微積分、PHYS1003普通物理(一)",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS、PHYS1003 GENERAL PHYSICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道用自己的詞彙定義何謂積體電路，能夠描述積體電路的觀念。",
      "describe_en": "To know how to define words: Be able to describe IC concept."
    },
    {
      "seq": 2,
      "describe_ch": "能理解並說明積體電路製程設計流程",
      "describe_en": "To comprehend and be able to explain the IC manufacturing and design flow charts."
    },
    {
      "seq": 3,
      "describe_ch": "應用積體電路知識於現今電子工業。\t\t",
      "describe_en": "To apply the IC knowledge for the electron ic industry today."
    }
  ],
