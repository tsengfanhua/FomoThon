  "description": {
    "sub_id3": null,
    "sub_name": "壽險精算數學(二)",
    "sub_ename": "LONG-TERM ACTUARIAL MATHEMATICS (2)",
    "describe_ch": "主要的目的是加強學生的精算科學基本觀念與能力。主題包括存活相關模型、多重生命函數、多重退脫模型、及相關保險與保險費用之實務介紹。",
    "describe_eh": "The main purpose of this course is to enhance the students' abilities and the concepts of actuarial science. The topics include the survival related functions, the multiple life functions, the multiple decrement models, and related insurance products with expenses, business and regulatory considerations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "介紹存活相關函數、多重生命函數及多重退脫模型，並學習如何利用這些模型解決保險相關問題。",
      "describe_en": "To introduce the survival related functions, multiple life function and multiple decrement models, and learn how to apply them to solve insurance related problems."
    },
    {
      "seq": 2,
      "describe_ch": "知道具有費用、商業及法規之保險模型",
      "describe_en": "To know insurance models with expenses, business and regulatory considerations."
    }
  ],
