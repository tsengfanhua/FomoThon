  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE04139",
    "sub_id": "65427",
    "scr_dup": "001",
    "sub_title": "精密光學元件製造技術",
    "sub_title_en": null,
    "sub_describe": "本課程旨在介紹精密光學元件的製造技術及相關知識，內容涵蓋產業概論、光機設計、模具與成形技術。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "精密光學元件製造技術導論",
    "sub_ename": "INTRODUCTION TO THE MANUFACTURING TECHNOLOGY OF PRECISION OPTICAL COMPONENTS",
    "describe_ch": "本課程將從光學系統談起，說明光學鏡頭的完整製造流程，包含內部各元件的製造技術及所需的背景知識，並加入數據分析與模擬分析的評估技術，增加學生的製程分析及檢討能力。",
    "describe_eh": "This course will start with optical systems and explain the complete manufacturing process of optical lenses, including the manufacturing technology of internal components and its background knowledge. The course also covers data and simulation analysis in the evaluation technology to enhance students’ ability to analyze and review the manufacturing process.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培育光學產業的技術人才",
      "describe_en": "Cultivate technical talents in the optical industry"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解光學系統及產業背景知識",
      "describe_en": "Understand optical systems and the background knowledge of the industry"
    },
    {
      "seq": 3,
      "describe_ch": "學習光學鏡頭製造所需的相關知識與技術",
      "describe_en": "Learn the relevant knowledge and technology required for manufacturing optical lenses"
    },
    {
      "seq": 4,
      "describe_ch": "學習製程分析、檢討、評估的能力",
      "describe_en": "Learn the ability to analyze, review and evaluate the manufacturing process"
    }
  ],
