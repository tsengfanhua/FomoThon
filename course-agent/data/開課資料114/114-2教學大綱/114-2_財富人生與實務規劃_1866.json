    },
    {
      "seq": 2,
      "describe_ch": "能應用財富規劃技術與工具進行個案分析與建議",
      "describe_en": null
    },
    {
      "seq": 3,
      "describe_ch": "能透過小組討論與競賽提升溝通與協作能力",
      "describe_en": null
    }
