  "description": {
    "sub_id3": null,
    "sub_name": "半導體製造技術概論",
    "sub_ename": "INTRODUCTION TO SEMICONDUCTOR MANUFACTURING TECHNOLOGY",
    "describe_ch": "本課程介紹半導體製程與設備，及技術發展、職場應對等知識，並利用實習與參訪活動，為學生提供生產作業親身體驗機會，強化學生對先進半導體公司職務內容之了解，提高學生的實做認知，為社會高科技產業培育無落差就業之實務人才。",
    "describe_eh": "The content includes details of semiconductor technology, process integration, equipment and components, research and development, workplace coping, etc. With the activities of internships and site visit to the factory, the students will have opportunities to experience semiconductor production directly. This initiative will promote students' understanding of the work content of advanced semiconductor companies, improve students' practical cognition, and cultivate our students as a talent for high-tech industries with no gap in practices.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解各種半導體製程設備組件之基本功能與知識",
      "describe_en": "Understand the fundamental knowledge of various semiconductor process equipment and components."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解半導體晶片製作流程",
      "describe_en": "Understand the manufacturing process of semiconductor wafers and chips."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解半導體產業職場屬性與倫理",
      "describe_en": "Have good notions on the workplace and the ethics in the semiconductor industry"
    }
  ],
