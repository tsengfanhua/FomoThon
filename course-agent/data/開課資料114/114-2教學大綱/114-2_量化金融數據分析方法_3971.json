  "description": {
    "sub_id3": null,
    "sub_name": "量化金融數據分析方法",
    "sub_ename": "DATA ANALYTICS IN QUANTITATIVE FINANCE",
    "describe_ch": "本課程介紹量化金融中常用的數據分析方法，涵蓋統計建模、訊號拆解與降噪、特徵工程及時間序列預測。課程內容將結合文獻研讀與案例探討，並透過統計與人工智慧工具進行資料處理、模型建構與結果詮釋。主題包括經驗模態分解(EMD)系列方法、微分方程與動態系統以及長短期記憶模型等深度學習模型，培養學生以數學、統計及AI技術解決財金數據問題的能力。",
    "describe_eh": "This course introduces commonly used data analytics methods in quantitative finance, covering statistical modeling, signal decomposition and denoising, feature engineering, and time series forecasting. The course integrates literature review and case studies, and employs statistical and artificial intelligence tools for data processing, model construction, and result interpretation. Topics include empirical mode decomposition (EMD) related methods, differential equations and dynamic systems, and deep learning models including long short-term memory (LSTM) networks. The course aims to equip students with the ability to solve financial data problems using mathematics, statistics, and AI techniques.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解量化金融中常用數據分析方法的適用條件與限制",
      "describe_en": "Comprehension for the applicability conditions and limitations of commonly used data analysis methods in quantitative finance"
    },
    {
      "seq": 2,
      "describe_ch": "能應用量化金融中常用數據分析方法及其分析解讀",
      "describe_en": "Application for the applicable conditions and results in data analysis methods in quantitative finance"
    },
    {
      "seq": 3,
      "describe_ch": "能分析量化金融中常用數據分析方法的使用準則及其解讀",
      "describe_en": "Analysis of the principles governing the use of data analysis methods in quantitative finance and their interpretation"
    }
  ],
