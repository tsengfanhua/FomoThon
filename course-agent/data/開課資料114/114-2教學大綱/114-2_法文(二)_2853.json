  "description": {
    "sub_id3": null,
    "sub_name": "法文(二)",
    "sub_ename": "FRENCH(2)",
    "describe_ch": "針對稍具法文基礎的學生所開設的課程。完成法文(二)課程，學生應學會有關家庭、天氣、季節、表達健康狀況、確認/取消會議、訂餐等基本對話能力。同時可以閱讀基本的法文。",
    "describe_eh": "This course is for students who have mastered the bare basics of the French language.  At the end of French 2, the student should be able to converse in French regarding one's family, the weather and seasons, express one's health needs, confirm/cancel appointments, and deal with food-related situations such as ordering in a restaurant. Basic written messages should be understood.",
    "pre_subname": "FREN1001法文(一)",
    "pre_sub_id3": "FREN1001",
    "pre_sub_ename": "FREN1001 FRENCH(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.學會如何正確的發音\t",
      "describe_en": "1. Able to pronounce correctly when reading or speaking French."
    },
    {
      "seq": 2,
      "describe_ch": "2.運用基本法文能力練習對話\t",
      "describe_en": "2. Able to express oneself in basic French in monitored dialogues."
    },
    {
      "seq": 3,
      "describe_ch": "3.正確的使用文法\t",
      "describe_en": "3. Have insight in grammatical differences and able to use grammar correctly and creatively."
    },
    {
      "seq": 4,
      "describe_ch": "4.瞭解法國與台灣的基本文化差異\t",
      "describe_en": "4. Be informed about basic cultural differences between France & Taiwan."
    }
  ],
