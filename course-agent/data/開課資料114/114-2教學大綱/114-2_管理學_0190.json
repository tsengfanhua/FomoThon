  "description": {
    "sub_id3": null,
    "sub_name": "管理學",
    "sub_ename": "MANAGEMENT",
    "describe_ch": "管理學是一門兼具科學與藝術的統整性學科。其目的在培養學生成為具備國際觀、前瞻性和競爭力的經理人。課程重視管理知識的傳授和管理能力的培養。課程實施側重於實務導向。從核心概念的建立，逐步導入國內外企業管理實務，強調整合性思考和實務應用。",
    "describe_eh": "Management is both a science and an art. The purpose of this course is to prepare students to be future managers with global vision and the ability to compete in this fast-paced world. The course focuses on foundational management theory education and managerial competence creation. the class emphasis is on business practice orientation. Beginning with core concepts, then learning through practice cases.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠理解何謂管理學、企業的外在環境因素、管理程序。",
      "describe_en": "The comprehension of defining Management、business external environment factors、management process with their own words"
    },
    {
      "seq": 2,
      "describe_ch": "能夠知道外在環境因素對企業的影響和衝擊;瞭解管理功能的內涵和彼此之相關性。",
      "describe_en": "The knowledge of how the external environment affects business and understand the management function and their relationship."
    }
  ],
