  "description": {
    "sub_id3": null,
    "sub_name": "國際企業併購",
    "sub_ename": "MERGERS AND ACQUISITIONS FOR INTERNATIONAL ENTERPRISES",
    "describe_ch": "本課程之目的在提供大學部學生有關國際企業併購之基本知識，包括企業併購型態、併購原因、併購策略，以及反併購措施。本課程亦介紹員工股票所有權計畫、企業融資收購，以及企業併購的租稅問題等議題。",
    "describe_eh": "The purpose of this course is to provide undergraduate students with basic concepts including the types of M&A, the reasons for a takeover, strategies of M&A and anti-takeover measures. It also introduces some of interesting topics such as ESOP, LBO and the tax issue associated with M&A.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解並說明企業併購在社會及經濟層面的重要性及影響",
      "describe_en": "Understand and be able to explain the importance and effects of corporate M&A on society and economy."
    },
    {
      "seq": 2,
      "describe_ch": "能辨識出如何採用企業併購的策略，並能清楚表達",
      "describe_en": "Distinguish and make clear statement about how to manipulate strategies of M&A."
    },
    {
      "seq": 3,
      "describe_ch": "能利用企業併購的原理，評估一組織或機關學校，並提出可行驗證方法",
      "describe_en": "Use principles of corporate M&A to evaluate an organization or institution and propose a feasible method for validation."
    }
  ],
