  "description": {
    "sub_id3": null,
    "sub_name": "社會創新與企業社會責任",
    "sub_ename": "SOCIAL INNOVATION AND CORPORATE SOCIAL RESPONSIBILITY",
    "describe_ch": "以個案方式，教授大學部學生有關社會創新與企業社會責任的觀念、理論應用，與實例分析，並結合國際企業管理之所學，反省全球化趨勢下產生的巨大城鄉與貧富差距之下，如何能透過社會創新來尋求新的社會平衡與企業社會責任。",
    "describe_eh": "This course will introduce the concept, theoretical applications, and case analysis by the case-teaching approach at the undergraduate level. Under the globalization trend, this course will provide the serious reflections on the increasingly huge asymmetries between metropolitan-rural and rice-poor societies through potential social innovations for feasible balancing opportunities, and so on.",
    "pre_subname": "MGT1001管理學、ITRA2067國際企業管理",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT、ITRA2067 INTERNATIONAL BUSINESS MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解企業社會責任與社會創新事業的結合與可行性",
      "describe_en": "Comprehension for the feasibility of the integration between corporate social responsibility and social innovation in entrepreneurship"
    },
    {
      "seq": 2,
      "describe_ch": "能應用個案分析於社會創新事業的機會與潛在的應用場域",
      "describe_en": "Application for the case analysis on opportunities of social innovation in entrepreneurship and potential fields"
    }
  ],
