    "tpa_score_new": "<table>\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t\t<td>&nbsp;</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<table cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td><strong>劉世慶老師 (共佔30%)</strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>課程教材: 教師準備個案 ; 自編講義</strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>課堂要求: 1.小組研討, 2.小組學習小結, 3.出席率</strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>授課班級：貿三合&nbsp;&nbsp;&nbsp; 評量 : 出席與上課參與30% ;&nbsp; 小組學習小結 : 30%; 小組報告 : 40%</strong></td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div>&nbsp;</div>\n\n<div><strong>商瓈丹老師 (共佔30%)</strong></div>\n\n<div><strong>課程教材: 教師準備個案 ; 自編講義</strong></div>\n\n<div><strong>課堂要求: 1.小組研討, 2.小組學習小結, 3.出席率</strong></div>\n\n<div><strong>授課班級：貿三合&nbsp;&nbsp;&nbsp; 評量 : 出席與上課參與30% ;&nbsp; 小組學習小結 : 30%; 小組報告 : 40%</strong></div>\n\n<div>&nbsp;</div>\n\n<table cellspacing=\"0\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td><strong>邱世寬老師部分 (共佔30%)</strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>課程教材: 哈佛管理評論 ; 自編講義</strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>課堂要求: 1.小組研討, 2.小組學習小結, 3.出席率</strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td><strong>授課班級：貿三合&nbsp;&nbsp;&nbsp; 評量 : 期中小組報告30% ;&nbsp; 小組學習小結 : 30%; 期末小組報告 : 40%</strong></td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div>&nbsp;</div>\n\n<div>16+2週次作業10%</div>\n",
