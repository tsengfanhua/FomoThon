  "description": {
    "sub_id3": null,
    "sub_name": "品質與可靠度工程",
    "sub_ename": "QUALITY ENGINEERING AND ASSURANCE",
    "describe_ch": "本課程為基礎品質管制課程之延伸，著重於工程設計、製程改善與品質保證。課程將以論文研討與個案介紹方式瞭解各項主題，再以小組專題實作呈現，以訓練培養學生熟悉品質觀念並增加實作能力。",
    "describe_eh": "This course is an extension of the basic quality control course, focusing on engineering design, process improvement, and quality assurance. Moreover, research paper presentation, case studies and term project are also applied to enhance students’ critical thinking and practical problem-solving ability.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解品質工程與可靠度分析的概念。",
      "describe_en": "Understand the concepts of quality engineering and reliability analysis."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解田口方法、工程問題解決流程。",
      "describe_en": "Understand the Taguchi method and the process of solving engineering problems."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生運用田口方法分析工程問題的能力。",
      "describe_en": "To cultivate students' ability to analyze engineering problems using the Taguchi method."
    }
  ],
