  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CH00101",
    "sub_id": "44234",
    "scr_dup": "003",
    "sub_title": "AI輔助的軟體應用互動設計：以人本思維探索創新應用",
    "sub_title_en": null,
    "sub_describe": "以人本設計思維出發，結合 Vibe Coding 對話式編程方法，運用 ChatGPT、Google AI Studio、Google Colab + Gemini 等生成式 AI 工具，從議題分析、概念設計到原型實作，開發兼具創意與人文價值的數位互動作品。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "軟體設計與AI工具應用",
    "sub_ename": "SOFTWARE DESIGN AND AI TOOLS APPLICATIONS",
    "describe_ch": "軟體設計結合了邏輯思維與程式設計，是人工智慧核心的重要數位技能，對跨學科應用、理解複雜概念、創新以及尋找新解決方案與創意十分有益。本課程採用議題導向的教學方法，從介紹ChatGPT在程式設計中的輔助作用、Python的基礎語法，到實作五個關於人文議題的小型專題，教導如何應用軟體設計和AI工具進行數位人文創新。",
    "describe_eh": " Software design combines logical thinking and programming, essential for AI and beneficial for interdisciplinary applications and innovation. This course uses a topic-oriented approach, covering ChatGPT's programming assistance, Python basics, and small projects on humanities issues. It teaches using software design and AI tools for digital humanities innovation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養人文與科技之跨域融合的STEAM能力",
      "describe_en": "Cultivating the STEAM capabilities of interdisciplinary integration between humanities and technology."
    },
    {
      "seq": 2,
      "describe_ch": "能產生具有人文價值之AI創新應用方案",
      "describe_en": "Generating AI innovation applications with value in the humanities."
    }
  ],
