  "description": {
    "sub_id3": null,
    "sub_name": "資料庫設計",
    "sub_ename": "DATA BASE MANAGEMENT SYSTEM AND DESIGN",
    "describe_ch": "本課程在使學生瞭解資料庫系統的基本原理和架構、認識關聯式資料模式的概念、熟悉資料庫管理系統的操作、學習結構化查詢語言的設計技巧，使具有資料庫應用系統的分析、設計及實作的能力。",
    "describe_eh": "The goal of this course is to equip students to understand the database system architecture and the concept of the entity-relationship data model, manipulate the different database systems, and learn the programming skill for the structural query language in the database system. Finally, let students really implement and manage a practical database application through the system analysis and design.",
    "pre_subname": "ENGS1010計算機概論",
    "pre_sub_id3": "ENGS1010",
    "pre_sub_ename": "ENGS1010 INTRODUCTION TO  COMPUTER AND COMPUTING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解資料庫的特性和資料庫管理系統的特色及認知資料庫應用開發和資料庫管理相關的工作機會。",
      "describe_en": "Understand the characteristics of business database and features of database management systems. Perceive career pportunities related to database application development and database administration."
    },
    {
      "seq": 2,
      "describe_ch": "使能操作及維護現在普遍被使用的資料庫管理系統。",
      "describe_en": "Be able to manipulate and maintain the different database management systems in the modern information application systems"
    },
    {
      "seq": 3,
      "describe_ch": "使具有開發資料庫應用系統的能力，熟悉資料庫系統的分析、設計與實作的相關技術(ERD的開發、資料表的設計、正規化的處理、SQL程式設計、概略表與表單設計、交易管理與系統維護等)。",
      "describe_en": "Possess the ability to develop a relationaldatabase application system. Learn the practiced skills for analysis, design and implementation of a database system (such as: developing an ERD; the relational tables design and normalization; coding\r\nSQL pro"
    }
  ],
