  "description": {
    "sub_id3": null,
    "sub_name": "從人類學看世界",
    "sub_ename": "INTRODUCTION TO ANTHROPOLOGY AND METHODS",
    "describe_ch": "人類學（Anthropology）是一門透過田野工作（fieldwork）來近身了解人類社會的文化與生活的學科，也是取得第一手資訊的重要方法。近來，人類學的研究方法開始應用在廣泛的領域，包括應用在企業中的使用者經驗研究（User Experience, UX），以及探知社區需求的田野調查等，都是人類學的應用範圍。本課程將帶領學生熟悉人類學的基本田野工作/資料分析的方式，培養學生找尋議題的眼光，以及以人類學的視角來分析社會/文化現象的能力。",
    "describe_eh": "Anthropology provide a special perspective for people to understand social and cultural phenomenon based on its unique method: fieldwork. It’s also the way to collect first-hand information. This method has been applied to many fields, such as the User Experience (UX) which is used in industries, or to investigate the needs of communities before bring in any practical projects. This course will lead students to comprehensive the concepts of anthropology and practice the methods of fieldwork to investigate social issues in order to make students familiar with anthropological perspectives to analyze social and cultural phenomenon.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解人類學探索社會文化議題的視野",
      "describe_en": "To engage in social and cultural issue with anthropological perspective."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉田野調查的方法與應用",
      "describe_en": "To be familiar with the skills of fieldwork and apply it with specific issue."
    }
  ],
