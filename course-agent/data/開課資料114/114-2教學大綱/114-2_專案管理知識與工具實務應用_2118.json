  "description": {
    "sub_id3": null,
    "sub_name": "專案管理知識與工具實務應用",
    "sub_ename": "PROJECT MANAGEMENT KNOWLEDGE AND TOOL",
    "describe_ch": "專案管理乃是將管理知識、技術、工具、方法綜合運用到任何一個專案行為上，使其能符合或超越專案利害關係者需求與期許的一種專門科學。專案管理所關切的是如何使讓專案在如期、如質、如預算的情況下達成目標。藉由系統化知識傳授與互動討論的方式讓學生熟悉專案管理理論，並實做專案管理相關工具來強化實務應用能力，讓學生在管理實際專案上能夠如期、如質、如預算地有效完成。",
    "describe_eh": " Project Management is the application of knowledge, skills, tools, and techniques to project activities to meet the project requirements. Many businesses achieve their goals by completing projects that contribute to their objectives. From above, at first, to teach the knowledge of Project Management. And then, to teach tools of Project Management and also apply in practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解專案管理基本知識",
      "describe_en": "To know the basic knowledge of Project Management."
    },
    {
      "seq": 2,
      "describe_ch": "學習運用專案管理解決專案問題",
      "describe_en": "Learning how to solve project problems by Project Management"
    },
    {
      "seq": 3,
      "describe_ch": "增進應用專案管理工具的能力",
      "describe_en": "To enhance an ability for applying Project Management tool."
    }
  ],
