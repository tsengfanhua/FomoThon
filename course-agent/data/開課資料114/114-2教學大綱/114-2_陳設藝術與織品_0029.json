  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "AS03120",
    "sub_id": "83115",
    "scr_dup": "001",
    "sub_title": "陳設藝術與織品設計在實務空間佈置應用",
    "sub_title_en": null,
    "sub_describe": "陳設藝術與織品設計的基本概念、技術和應用。課程將結合理論講解、實際操作和設計項目，通過實踐性教學和案例分析，培養學生的設計能力、創意思維和專業素養。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "陳設藝術與織品",
    "sub_ename": "DECORATIVE ARTS AND TEXTILES",
    "describe_ch": "本課程旨在介紹陳設藝術與織品設計的基本概念、技術和應用。通過對陳設藝術的歷史演變、風格特徵和設計原則的探討，以及對織品設計的材料、工藝和創意表達的分析，學生將獲得對陳設藝術和織品設計的全面理解和掌握。課程將結合理論講解、實際操作和設計項目，通過實踐性教學和案例分析，培養學生的設計能力、創意思維和專業素養。",
    "describe_eh": "Introduces the basic concepts, techniques and applications of furnishing art and fabric design. Through the discussion of the historical evolution, stylistic characteristics and design principles of furnishing art, as well as the analysis of materials, craftsmanship and creative expression of fabric design, students will gain a comprehensive understanding and mastery of furnishing art and fabric design. The course will combine theoretical explanations, practical operations and design projects, and cultivate students' design abilities, creative thinking and professional qualities through practical teaching and case analysis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解陳設藝術的發展歷程、風格特徵和設計原則，掌握陳設藝術的基本知識和理論基礎。",
      "describe_en": "Understand the development history, style characteristics and design principles of display art, and master the basic knowledge and theoretical foundation of display art."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉織品設計的材料、工藝和技術，了解不同類型織品的特性和應用場景。",
      "describe_en": "Be familiar with the materials, processes and techniques of fabric design, and understand the characteristics and application scenarios of different types of fabrics."
    },
    {
      "seq": 3,
      "describe_ch": "學習陳設藝術和織品設計的創作方法和表現手法，培養創意思維和設計能力。",
      "describe_en": "Learn the creative methods and expression techniques of furnishing art and fabric design, and cultivate creative thinking and design abilities"
    },
    {
      "seq": 4,
      "describe_ch": "探討陳設藝術與織品設計在不同文化背景下的影響和發展，理解其在當代設計領域的重要性和價值。",
      "describe_en": "Explore the influence and development of furnishing art and textile design in different cultural backgrounds, and understand their importance and value in the field of contemporary design."
    },
    {
      "seq": 5,
      "describe_ch": "通過實際操作和設計項目，提高學生的實踐能力和解決問題的能力。",
      "describe_en": "Improve students' practical ability and problem-solving ability through practical operations and design projects."
    },
    {
      "seq": 6,
      "describe_ch": "培養學生對陳設藝術和織品設計的興趣和熱情，激發其對創意設計的探索和追求。",
      "describe_en": "Cultivate students' interest and enthusiasm in display art and textile design, and stimulate their exploration and pursuit of creative design."
    }
  ],
