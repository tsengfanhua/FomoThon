  "description": {
    "sub_id3": null,
    "sub_name": "ERP配銷模組",
    "sub_ename": "ERP-SALES & DISTRIBUTION MODULE",
    "describe_ch": "本課程探討主要內容包括：(1)資訊管理系統概論 (2)資訊系統應用:企業資源規劃(ERP)、顧客關係管理(CRM)及電子商務等應用 (3)資訊系統開發、建置 (4)資訊系統管理與經營。",
    "describe_eh": "The purpose of this course is to understand (1) the foundations of information systems. (2) the application of information system: ERP, CRM, and E-Commerce. (3) the development and building of information system. (4) the management of information system.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解管理資訊系統之基本觀念及方法。",
      "describe_en": "Understand and be familiar with the basic elements and concepts of information system"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解資訊系統的應用，例如：ERP、CRM、EC應用等。",
      "describe_en": "Understand the application of information system: ERP, CRM, and E-Commerce"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解資訊系統建立之策略與步驟",
      "describe_en": "Understand the strategy of  development and building of information system"
    },
    {
      "seq": 4,
      "describe_ch": "瞭解資訊系統管理與經營",
      "describe_en": "Understand the management of information system"
    }
  ],
