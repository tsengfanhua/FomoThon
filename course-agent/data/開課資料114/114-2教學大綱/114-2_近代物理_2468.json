  "description": {
    "sub_id3": null,
    "sub_name": "近代物理",
    "sub_ename": "MODERN PHYSICS",
    "describe_ch": "做為進階量子物理的準備課程，本課程設計包括一些量子物理的主題，內容包含：狹義相對論、波粒二重性(黑體輻射、光電效應、Compton散射、電子繞射…)、原子的波爾模型、波函數與機率、薛丁格方程式、一維位能場。",
    "describe_eh": "As the basic course of advanced quantum physics. This course is designed to cover topics in the subject of quantum physics.  including: special relativity, wave-particle duality (black-body radiation, photoelectric effect, the Compton effect, electron scattering…), Bohr's Model of the atom, wave functions and probability, Schroedinger Equation, one-dimension potential well.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、PHYS1003普通物理(一)、PHYS1004普通物理(二)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 3,
      "describe_ch": "學習近代物理的基礎假說與理論",
      "describe_en": " To learn the basics of quantum mechanics and its postulates."
    },
    {
      "seq": 4,
      "describe_ch": "理解薛丁格方程式與三大運動模型之理論和推導\t",
      "describe_en": "To understand and derive Schrödinger equation, particle in the box, harmonic oscillator, and rigid rotor."
    },
    {
      "seq": 5,
      "describe_ch": "學習氫原子模型之假設與應用",
      "describe_en": "To study the assumption and application of the hydrogen atom model."
    }
  ],
