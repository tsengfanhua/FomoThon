  "description": {
    "sub_id3": null,
    "sub_name": "財務會計解析",
    "sub_ename": "FINANCIAL ACCOUNTING ANALYSIS",
    "describe_ch": "本課程旨在協助同學理解公司個體間的各種交易，並熟悉企業相關會計處理。課程內容包括企業合併原則、各種合併種類及流程，並介紹如何編製及比較企業個體與合併報表的差異。",
    "describe_eh": "This course aims to help students understand various transactions between companies and become familiar with corporate accounting practices. The curriculum covers the principles of corporate mergers, different types of mergers, and their processes. It also introduces how to prepare and compare the differences between individual and consolidated financial statements.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能分析個體企業間之交易程序",
      "describe_en": "To analyze transaction procedures between individual enterprises"
    },
    {
      "seq": 2,
      "describe_ch": "能理解企業個體及合併財務報表之編制流程",
      "describe_en": "To understand the preparation process of individual and consolidated financial statements for enterprises"
    },
    {
      "seq": 3,
      "describe_ch": "能理解企業長期股權之投資之處理模式",
      "describe_en": "To understand the treatment methods for long-term equity investments of enterprises"
    },
    {
      "seq": 4,
      "describe_ch": "能應用企業長期股權之投資及分析判讀",
      "describe_en": "To apply, analyze, and interpret long-term equity investments of enterprises"
    }
  ],
