  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE09149",
    "sub_id": "53022",
    "scr_dup": "001",
    "sub_title": "VCO線路的設計與佈局",
    "sub_title_en": null,
    "sub_describe": "使用N16 ADFP FinFET製程，做VCO線路的設計與佈局。除學習VCO線路的設計技巧之外，也學習類比線路的佈局設計方法。\n同時，透過LPE的模擬與分析，充分了解佈局設計對類比IC Performance的影響。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "電子電路設計實務",
    "sub_ename": " LABORATORY OF ELECTRONIC CIRCUIT DESIGN",
    "describe_ch": "提供學生一系列電子電路設計之模擬實驗，幫助學生發展SPICE和MATLAB相互關係之一套電子電路設計的實務知識。",
    "describe_eh": "Provide the students a set of simulation laboratory to the electronic circuit design and help the students to develop a working knowledge of the correlation of SPICE and MATLAB to the electronic circuit design.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的專業詞彙定義電子電路設計實務；能夠描述電子電路設計實務的基本觀念。",
      "describe_en": "Can define laboratory of electronic circuit  design with one's own specialized vocabulary；Be able to describe the basic."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明SPICE於電子電路設計實務之應用。",
      "describe_en": "Can understand and be able to explain SPICE on the application of laboratory of electronic circuit design"
    }
  ],
