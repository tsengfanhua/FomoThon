  "description": {
    "sub_id3": null,
    "sub_name": "鋼結構設計",
    "sub_ename": "STEEL STRUCTURE DESIGN",
    "describe_ch": "本課程為鋼結構設計的基礎課程，其目的在提供學生鋼構建築系統、鋼構件接合型式以及鋼構件設計之基本認知。",
    "describe_eh": " This is an elementary course of steel structural design. The objectives are to provide fundamental concepts about steel building system, types of connections, and basic design of steel members.",
    "pre_subname": "CEM2008材料力學",
    "pre_sub_id3": "CEM2008",
    "pre_sub_ename": "CEM2008 MECHANICS OF MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能說明鋼結構的特性及其優缺點。",
      "describe_en": "To state the feature and advantages/drawbacks of steel structures."
    },
    {
      "seq": 2,
      "describe_ch": "理解鋼結構構件之基本破壞型式及其基礎力學理論。",
      "describe_en": "To comprehend the basic failure types and the fundamental theory of steel structural members."
    },
    {
      "seq": 3,
      "describe_ch": "能應用鋼結構設計規範的基本概念，設計簡單構件及接合。",
      "describe_en": "To apply the basic concepts about the design specifications of steel structures, and to make simple design of members and connections."
    }
  ],
