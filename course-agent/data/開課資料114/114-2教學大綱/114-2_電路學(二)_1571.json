  "description": {
    "sub_id3": null,
    "sub_name": "電路學(二)",
    "sub_ename": "CIRCUIT THEORY(2)",
    "describe_ch": "這課程的目的是呈現電路分析的方法與應用，特別地以個人電腦的幫助，在大學部的層次中，給予學生足夠深度的基本理論。這些理論被設計成用於發展學生思考程序，促使學生達成完整的理解一個大範圍的主題係有關於電路學，提高對於電機領域的學習動機與興趣。除此之外，基本物理觀念的建立，將是鞏固工程教育的最有價值與永久的部分。本課程亦特別強調各種物理觀念的講述，並輔以數學技巧的說明。期使學生經由簡單理論基礎之理解，進而可以擴展延伸至到新的且複雜的網路分析。",
    "describe_eh": "The objective of this course is to present methods of circuit analysis and their applications. The approach is designed to develop students' thinking process, motivating their interest in the electrical circuit analysis and design. Both theory and modeling are developed from simple beginnings so that they can be readily extended to new and complex network analysis.",
    "pre_subname": "EEEN2008電路學(一)、IEE1010普通物理-電、磁、光",
    "pre_sub_id3": "EEEN2008",
    "pre_sub_ename": "EEEN2008 CIRCUIT THEORY(1)、IEE1010 GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "藉由習題的實作來深入理解其方法論，並成功設計應用於基礎電機系統。",
      "describe_en": "The methodology can be profoundly comprehended by practicing the tutorial, so that a fundamental electrical system can be successfully designed and applied to."
    },
    {
      "seq": 2,
      "describe_ch": "能有效的利用所學習的理論來分析及處理基礎電機系統相關的議題。",
      "describe_en": "Can effectively apply the studied theories into analyzing and handling the related topics of a fundamental electrical system."
    }
  ],
