  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "XC05111",
    "sub_id": "GM321",
    "scr_dup": "001",
    "sub_title": "ESG與永續發展、AI導入教學與學習、主動學習",
    "sub_title_en": null,
    "sub_describe": "希望培養學生具備面對未來的競爭力，具備卓越領導力",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "卓越領導力",
    "sub_ename": "OUTSTANDING LEADERSHIP",
    "describe_ch": "本課程在於引導學生面對多元快速的市場競爭環境，有效激發內在潛質朝向策略領導發展，除了鍛鍊內在涵養，鼓勵學生超脫自我、獨立思考，養成熱情有目標的人格思維；也從外在影響力的培訓，包括信任管理、團隊合作與建構願景等，瞭解領導力的正面積極價值，同時也透過參與論壇演講、民間企業、社網連結與領袖營等相關活動，擴大自我的正向社會能量。",
    "describe_eh": "This course is to guide students to face the market competition environment characteristic of diversification and rapid speed and effectively stimulate the internal potentials to develop towards the direction of strategic leadership. In addition to forming and training the inner cultivation, it also encourage students to go beyond themselves, conduct independent thinking and develop passionate and targeted personality and thinking system; understand the positive value of leadership from the training of external influence, including trust management, teamwork and vision construction; and expand their positive social energies at the same time through participating in the forums, speeches, private enterprises, social network connection, leadership camp and other related activities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 3,
      "describe_ch": "協助學生認識領導力定義與執行內涵。",
      "describe_en": "Help students understand the definition and implementation connotation of leadership."
    },
    {
      "seq": 4,
      "describe_ch": "協助學生具備獨立思考、團隊合作、建構願景與實踐之領導能力。",
      "describe_en": "Help students develop the leadership abilities in independent thinking, teamwork, vision construction and practice."
    }
  ],
