  "description": {
    "sub_id3": null,
    "sub_name": "產業實務專題",
    "sub_ename": "INDUSTRIAL PRACTICE",
    "describe_ch": "本課程係產業實務個案研究的課程，目的在提供修習淨零智慧永續相關課程之後，進行實務面產業個案研究，練習將理論、方法進行實際練習應用；另外，亦可選本校教師實驗室進行研究專題學習，由教師帶領學生實際構思、發展與實踐研究主題，皆可進一步為未來職涯與發展進行準備。修課學生修習本課程後將可完成產業永續書面報告或特色研究報告，希望藉此課程讓學生能深入了解特定產業與研究特色，培養產業分析實作能力。",
    "describe_eh": "This course is an industrial practical case study course. The purpose is to conduct practical industrial case studies after taking courses related to net-zero smart sustainability and practice the practical application of theories and methods. In addition, you can also choose from our school's teacher laboratory. Conducting research topic studies, teachers lead students to actually conceive, develop and practice research topics, which can further prepare for future career and development. After taking this course, students will be able to complete a written report on industry sustainability or a special research report. It is hoped that this course will allow students to gain an in-depth understanding of specific industries and research characteristics, and cultivate their industrial analysis and implementation capabilities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用產業分析方法於產業專題研究與結果分析。",
      "describe_en": "Apply industry analysis methods to industry topic research and result analysis."
    },
    {
      "seq": 2,
      "describe_ch": "透過資料蒐集、整理與分析，建立學生相關產業領域之知識。",
      "describe_en": "Through data collection, organization and analysis, students' knowledge of relevant industry fields is established."
    },
    {
      "seq": 3,
      "describe_ch": "藉由討論和報告，提升同學對相關產業或研究的分析與研究能力。",
      "describe_en": "Through discussions and reports, students will improve their analysis and research capabilities in related industries."
    },
    {
      "seq": 4,
      "describe_ch": "學生將選定特定產業或研究個案進行分析，並於期末彙總進行口頭及書面報告。",
      "describe_en": "Students will select specific industry cases for analysis and compile oral and written reports at the end of the semester."
    }
  ],
