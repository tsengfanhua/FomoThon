  "description": {
    "sub_id3": null,
    "sub_name": "統計學(二)",
    "sub_ename": "STATISTICS(2)",
    "describe_ch": "本課程介紹機率與統計的概念，內容包含各種機率分配、抽樣分配理論、區間估計、假設假定及迴歸分析等。藉由數學與圖形的呈現，以及範例的解說，幫助同學了解機率與統計在交通運輸的應用。課程中將教導使用EXCEL及SPSS統計分析功能，增加學生資料分析能力。",
    "describe_eh": "This course introduces the concept of probability and statistics, including probability distributions, sampling distribution theory, interval estimation, hypothesis testing, and regression analysis. Through mathematics, graphic presentations, and numerous examples, this course facilitates students to understand the applications of probability and statistics in transportation. EXCEL and SPSS software will be taught in the class in order to enhance students' capacity in data analysis.",
    "pre_subname": "MATH1003微積分(一)",
    "pre_sub_id3": "MATH1003",
    "pre_sub_ename": "MATH1003 CALCULUS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "8.\t培養學生運用資料調查、數據分析或數學模型分析運輸或物流問題之能力",
      "describe_en": "8. Develop students' ability to analyze transportation and logistics problems using data collection, data analysis, or mathematical models."
    },
    {
      "seq": 2,
      "describe_ch": "7.\t培養學生運用資訊科技或分析軟體處理實務問題之能力",
      "describe_en": "7. Develop students' ability to apply information technology and analytical software to solve practical problems."
    },
    {
      "seq": 3,
      "describe_ch": "11.培養學生獨立或透過團隊合作解決專業問題之能力",
      "describe_en": "11. Develop students' ability to solve professional problems independently or through teamwork."
    }
