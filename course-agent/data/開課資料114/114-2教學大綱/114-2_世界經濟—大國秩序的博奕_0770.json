  "description": {
    "sub_id3": null,
    "sub_name": "世界經濟—大國秩序的博奕",
    "sub_ename": "WORLD-ECONOMY: THE CONTEST FOR GREAT POWER ORDER",
    "describe_ch": "本課程聚焦世界秩序重組與大國博弈對全球經濟與產業發展的深遠影響，透過關鍵案例與區域比較，培養學生掌握國際局勢與台灣戰略定位的能力。",
    "describe_eh": "This course focuses on the restructuring of the world order and the influence of great power politics on global economic and industrial developments. Through key case studies and regional comparisons, students will analyze how geopolitical rivalries shape global trends and assess Taiwan’s strategic positioning within an evolving international landscape.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解世界秩序與大國政治的經濟影響",
      "describe_en": "Understand the economic impacts of world order and great power politics"
    },
    {
      "seq": 2,
      "describe_ch": "分析產業在國際局勢變動中的風險與機會",
      "describe_en": "Analyze risks and opportunities for industries under global shifts"
    },
    {
      "seq": 3,
      "describe_ch": "強化台灣在國際經濟體系中的角色理解",
      "describe_en": "Strengthen understanding of Taiwan’s role in the global economic system"
    }
  ],
