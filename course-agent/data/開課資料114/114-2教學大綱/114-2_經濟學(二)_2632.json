  "description": {
    "sub_id3": null,
    "sub_name": "經濟學(二)",
    "sub_ename": "ECONOMICS(2)",
    "describe_ch": "本課程接續經濟學（一），將經濟學的基本觀念與方法應用至總體經濟單位，分析一個國家的長期成長，短期景氣波動，以及就業通貨膨脹等問題。",
    "describe_eh": "Economics II (introductory course in macroeconomics): teaches the basic concepts and tools in economics and applies them to the operation of economic agents, government, and individual firms in a modern economy. The focus is on long term economic growth, short term fluctuations, inflation, and employment.",
    "pre_subname": "ECON1001經濟學(一)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 30,
      "describe_ch": "理解經濟體系中家庭、廠商、政府及外國部門的行為與運作，並衡量一個經濟體系的產出、失業、生產成本及其經濟成長。",
      "describe_en": "Comprehending the behaviors and operations of households, firms, government, and foreign sectors in an economy. Describing an economy's output, unemployment, production costs and growth."
    },
    {
      "seq": 31,
      "describe_ch": "應用經濟體系的總合供給及總合需求，分析短期經濟波動。",
      "describe_en": "Applying the aggregate supply and aggregate demand of an economy to analyze the short-run economic fluctuations."
    },
    {
      "seq": 32,
      "describe_ch": "理解開放經濟體系（包括匯率之決定、跨國間資本、勞務財貨之流動。）",
      "describe_en": "Comprehending the concept of open economy and the determination of exchange rates (including the flow of goods, services, labor, and capital across countries.)\r\n"
    },
    {
      "seq": 36,
      "describe_ch": "理解政府財政政策、貨幣政策之內容，及分析對穩定經濟的效果。",
      "describe_en": "Comprehending government fiscal policy and monetary policy, and analyzing its stabilizing effects on economy."
    }
  ],
