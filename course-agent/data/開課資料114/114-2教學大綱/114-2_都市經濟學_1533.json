    "sub_name": "都市經濟學",
    "sub_ename": "URBAN ECONOMICS",
    "describe_ch": "介紹同學從經濟觀點明瞭影響都市形成、發展和成長過程之因素和分析方法，課程條件為必須已修習經濟學和都市計畫基礎課程。\r\n",
    "describe_eh": "The objective of this course is to provide student with basic knowledge and analytical techniques concerning the formation and the growth of city.  This pre-requirement of this course are at least two credits in economics and two credits in planning techn\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
