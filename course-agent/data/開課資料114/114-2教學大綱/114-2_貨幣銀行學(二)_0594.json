  "description": {
    "sub_id3": null,
    "sub_name": "貨幣銀行學(二)",
    "sub_ename": "MONEY AND BANKING(2)",
    "describe_ch": "繼續探討貨幣理論的發展和貨幣政策在經濟體系中所扮演的角色，分析中央銀行與貨幣政策，包括存款貨幣的創造與貨幣供給的決定，貨幣政策工具與國際金融體系。討論貨幣理論包括貨幣需求理論，IS-LM模型中的貨幣財政政策，總合需求供給分析，貨幣與通貨膨脹。",
    "describe_eh": "Continue the study of development in monetary policy and the role of monetary policy in the economy, detailed analysis of central banking and monetary policy, including the multiple deposit creation, and the money supply process, tools of monetary policy and the international financial system.  A full discussion of monetary theory, including the demand for money, monetary and fiscal policy in IS-LM money and inflation.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解貨幣供給過程。",
      "describe_en": "Understand the money supply process."
    },
    {
      "seq": 2,
      "describe_ch": "理解各種金融機構與金融市場的運作。",
      "describe_en": "Understand the financial institutions and financial markets."
    },
    {
      "seq": 3,
      "describe_ch": "理解金融監管與金融安定。",
      "describe_en": "Understand financial regulation and financial stability."
    },
    {
      "seq": 4,
      "describe_ch": "知道如何蒐尋各種金融統計",
      "describe_en": "Know how to search various financial statistics."
    }
  ],
