  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB05139",
    "sub_id": "04700",
    "scr_dup": "001",
    "sub_title": "我國不動產持有、交易之租稅法規、制度與實務",
    "sub_title_en": null,
    "sub_describe": "探究內容涉及持有、交易相關法規:土地稅法、平均地權條例、房屋稅條例、契稅條例、印花稅條例、遺產及贈與稅法、稅捐稽徵法、所得稅法、租稅協定，以實務案例、計算解說以下內容:1.不動持有相關稅制:地價稅、房屋稅  2.不動移轉相關稅制:土地增值稅、契稅、贈與稅、遺產稅、印花稅 3.不動產持有、交易相關所得稅:房地合一稅2.0、舊制不動產交易所得稅、不動產所得稅  4.稅捐稽徵法 5.與不動產有關之信託稅制 6.跨國不動產交易、持有所得之租稅協定相關規範及運用。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "土地稅",
    "sub_ename": "LAND TAXATION",
    "describe_ch": "主要介紹我國土地稅制度、土地稅法規及實務，使學生瞭解我國現行土地稅制法規及實務之運用。含基本觀念、稅捐稽徵法、地價稅、土地增值稅、遺產稅、贈與稅、房屋稅、契稅等。",
    "describe_eh": "This course is designed to introduce tax system and tax law of land in Taiwan. It makes students realize how to use the tax system and tax law of land in Taiwan. This course includes the basic idea, a general description of land tax, land value tax. Land value increment tax, Estate and gift tax, House tax and deed tax. Land tax has always been one of the major source of our government's fiscal revenue",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得土地稅基本知識\t",
      "describe_en": "obtain the basic knowledge of land tax\t"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解土地稅制度\t",
      "describe_en": "can clear the norm of land tax in Taiwan\t"
    },
    {
      "seq": 3,
      "describe_ch": "將理論運用於實務\t",
      "describe_en": "can use theory to practice"
    }
  ],
