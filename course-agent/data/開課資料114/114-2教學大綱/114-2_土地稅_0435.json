  "textBooks": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB05139",
    "sub_id": "04700",
    "scr_dup": "001",
    "tpb_seq": 1,
    "tpb_book": "<div>自編講義，依照我國稅法、租稅協定、財政部新聞稿(賦稅)及國稅局、地方稅務局授課教材及企業、個人案例等整理編輯，以實務案例解說演練不動產租稅(地價稅、土地增值稅、房屋稅、契稅、印花稅、遺產稅、贈與稅、稅捐稽徵法、跨國不動產相關租稅協定條款、所得稅及房地合2.0)之稅務處理。</div>\n",
    "tpb_book_en": null
  },
  "readings": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB05139",
