  "description": {
    "sub_id3": null,
    "sub_name": "邏輯設計",
    "sub_ename": "LOGIC DESIGN",
    "describe_ch": "課程為數位系統相關課程之基礎，介紹交換電路基礎邏輯理論、分析與如何將之應用於組合/序向網路之設計，內容含：基本交換函數理論(布林代數邏輯化簡)，基本組合網路設計與序向邏輯網路(計數器起、序向檢測器) 等設計，引領學生對邏輯電路的思考與探討。",
    "describe_eh": "After studying , students should be able to apply switching theory to the solution of logic design problems. This means that they will learn both the basic theory of switching networks and how to apply it to the design topics of combinational and sequential networks , such as the counters , adders , sequence detectors and similar networks.",
    "pre_subname": "IEE1000計算機概論(一)、IEE1002計算機概論實習(一)",
    "pre_sub_id3": "IEE1000",
    "pre_sub_ename": "IEE1000 INTRODUCTION TO COMPUTER(1)、IEE1002 THE  PROGRAMMING LABORATORY(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解數字系統、碼、布林代數和邏輯閘。",
      "describe_en": "Comprehend number systems,codes,Boolean Algebra and logic gates.\r\n"
    },
    {
      "seq": 2,
      "describe_ch": "理解邏輯電路。",
      "describe_en": "Comprehend logic circuits."
    }
