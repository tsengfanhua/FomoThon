  "description": {
    "sub_id3": null,
    "sub_name": "感測與定位整合平台",
    "sub_ename": "SENSING AND POSITIONING INTEGRATION PLATFORM",
    "describe_ch": "本課程介紹物聯網情境中常使用的感測技術，包含了室內/室外定位技術、溫度感測、濕度感測、加速度感測與雷達感測技術，以及利用人工智慧與影像辨識等技術。課程講解包含原理與實務，除了介紹各感測技術之感測原理、電路分析、感測矯正與感測情境應用，也引導學生動手進行分組專題實務製作，課程最後進行感測器專題實作競賽，提升學生學習興趣。",
    "describe_eh": "This course introduces sensing technologies commonly used in IoT scenarios, including indoor/outdoor positioning technologies, temperature sensing, humidity sensing, acceleration sensing, radar sensing technologies, and the use of artificial intelligence and image recognition technologies. The course explanation includes sensing principle and practice and the sensing principle, circuit analysis, sensing correction, and sensing context application of each sensing technology. In the course, students are also guided to do practical production of grouping topics. To enhance students' interest in learning, the final products of each group of students will be contested.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解定位原理、計算與應用。",
      "describe_en": "Understand positioning principles, calculations and applications."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉Python編寫環境與編寫方法。",
      "describe_en": "Familiar with Python writing environment and writing methods."
    },
    {
      "seq": 3,
      "describe_ch": "了解感測器元件原理與應用方法。",
      "describe_en": "Understand the principle and application of sensor components."
    },
    {
      "seq": 4,
      "describe_ch": "了解利用雷達感測原理與應用方法。",
      "describe_en": "Understand the principle and application of radar sensing."
    }
  ],
