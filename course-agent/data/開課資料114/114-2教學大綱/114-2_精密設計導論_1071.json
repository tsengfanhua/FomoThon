    "cls_id": "CE04119",
    "sub_id": "81011",
    "scr_dup": "001",
    "sub_title": "工具機精密設計導論 以智慧工具機系統設計程序的介紹",
    "sub_title_en": null,
    "sub_describe": "工具機精密設計導論課程大剛， 以三周為一單元， 從智慧工具機系統、工具機機構與金屬材質、機構與傳動元件及控制系統、工具機設計程序系統、工具機結構與刀具運動結構CAD/CAE介紹",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "精密設計導論",
    "sub_ename": "INTRODUCTION TO PRECISION DESIGN",
    "describe_ch": "本課程旨在訓練學生學習選擇適當精密機械元件的尺寸、形狀、材質，俾能設計出安全無虞的機械。要達到此目的，學生需俱有計算及預估各精密機械元件破壞的模式及條件，所以負載、應力、變形量計算等基本力學觀念亦會涵蓋在課程中。",
    "describe_eh": " In this course, students will learn to size and shape the parts and choose appropriate materials so that the resulting precision machine can be expected to perform its intended function without failure.\nThis requires that students be able to calculate and predict the mode and conditions of failure for each element and then design it to prevent that failure. This requires that a stress and deflection analysis can be done for each part. Since stresses are a function of the applied loads, and of the part's geometry, an analysis of the forces, moments, torques, and the dynamics of the system must be done before the stress and deflections can be completed calculated.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解精密設計基本觀念、設計步驟、資料分析及判斷，並應用此知識於常見的機械設備元件。",
      "describe_en": "Provide the concepts, procedures, data and decision analysis techniques necessary to design elements commonly found in precision mechanical devices and systems."
    },
    {
      "seq": 2,
      "describe_ch": "能俱有應力、變形量、挫曲等力學基礎，同時亦有統計方法做為可靠度及品管分析。",
      "describe_en": "Establish basic techniques of mechanics including stress analysis, deflection, buckling. Also the statistical tools are needed for reliability and quality-control analysis"
    },
    {
      "seq": 3,
      "describe_ch": "能理解破壞理論並與基礎力學整合，俾可設計安全、有品質、可靠的精密機械元件。",
      "describe_en": "Understand the theory of failure, and integrate the fundamentals of mechanics toward the goal of analyzing and designing precision mechanical elements to achieve satisfactory levels of safety, quality, reliability, and life."
    },
    {
      "seq": 4,
      "describe_ch": "能設計及分析常見機械元件包括螺絲、彈簧、焊接、齒輪、軸承等。",
      "describe_en": "Be able to deal with the design and analysis of specific mechanical elements such as screws, springs, welded joints, gears, bearings, and the like."
    }
  ],
