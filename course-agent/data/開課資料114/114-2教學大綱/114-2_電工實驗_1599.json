  "description": {
    "sub_id3": null,
    "sub_name": "電工實驗",
    "sub_ename": "ELECTRICAL ENGINEERING LAB.",
    "describe_ch": "配合電力電子學與電機機械課程,以電腦輔助模擬與麵包板實務驗證並重。讓學生獲得電力電子/控制之電路分析與設計等方面的基礎能力，和有解決電力電子/控制之電路問題所需要的獨立思考與創新能力。訓練學生具有組織能力與溝通技術，讓學生能夠發揮團隊力量來解決問題。教導學生如何執行與驗證各項電力電子/控制之電路實驗，其中包括資料的蒐集、維護、管理與理論的測試。",
    "describe_eh": "Companion with electronic power and to conduct related electronic power/controls of circuit simulations and experiments. How to conduct and verify various electronic power/controls of circuit experiments, including data collection, maintained, and management as well as verification of theories. How to analyze and design electronic power/controls of circuits as well as to obtain the capability of solving electronic power/controls of circuit problems. How to communicate and organize a team work.",
    "pre_subname": "EEEN2008電路學(一)、EEEN2009電路學(二)、IEE1010普通物理-電、磁、光",
    "pre_sub_id3": "EEEN2008",
    "pre_sub_ename": "EEEN2008 CIRCUIT THEORY(1)、EEEN2009 CIRCUIT THEORY(2)、IEE1010 GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠描述及推演電力相關實驗的基本相關原理。",
      "describe_en": "Describe and derive the basic related theories of electrical power related experiments."
    },
    {
      "seq": 2,
      "describe_ch": "能理解相關電力相關實驗元件之原理及系統應用。",
      "describe_en": "Understanding the principles of electrical power related experiment's device and its applications in a system."
    },
    {
      "seq": 3,
      "describe_ch": "能運用電力相關實驗之原理，並解析應用於電的系統。",
      "describe_en": "Apply electrical power related experiment's theory to real electrical systems and can analyze them."
    },
    {
      "seq": 4,
      "describe_ch": "能藉由實地操作，了解原理及完成電力相關實驗。",
      "describe_en": "Can carry out electrical power related experiment by doing the experiment actually and understanding the principles."
    }
  ],
