  "description": {
    "sub_id3": null,
    "sub_name": "展演空間設計",
    "sub_ename": "DESIGN OF EXHIBITION SPACE",
    "describe_ch": "藉由展演空間案例分析與實地參訪，了解展覽發展的歷史以及展覽及其空間規劃理論，並藉此助學生發展未來從事展示相關之企劃與實務的能力。",
    "describe_eh": "By means of case study and exhibition visits, the course aims to introduce the history of exhibitions, the theory of exhibition planning to the students in order to prepare them for further possibility of planning and designing for exhibition spaces.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生了解展覽發展史及其關切之議題與發展趨勢",
      "describe_en": "Make students have the general knowledge of the history of exhibition and its major concerns"
    },
    {
      "seq": 2,
      "describe_ch": "使學生具備展示規劃與設計之基本知識",
      "describe_en": "Help the students to be equipped with the basic know-how of exhibition planning"
    },
    {
      "seq": 3,
      "describe_ch": "促使學生將所學應用於空間設計",
      "describe_en": "Encourage students to apply the knowledge of art history to their design"
    }
  ],
