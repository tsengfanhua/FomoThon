  "description": {
    "sub_id3": null,
    "sub_name": "專題討論",
    "sub_ename": "SEMINAR",
    "describe_ch": "本課程以學術研究相關之文獻蒐集、研究方法、論文寫作與發表等主題為主要內容；除出席課堂外，修課同學需就其可能研究方向進行文獻閱讀、製作書面報告以及口頭報告，藉以提昇學生學習及觀摩相關領域之研究方法並磨練論文發表與溝通技巧。",
    "describe_eh": "This course focuses on the processes of academic research, including the literature review, research method, thesis writing, and oral presentation and defense. Besides attending the course, student has to proceed the literature review on their potential research direction, finish documentation, and present the review result. Through this course, students can learn the research method of his/her field and practice the skills of oral presentation and communication.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "收集並閱讀相關領域的研究成果",
      "describe_en": "The students can perform the comprehensive of literature review in their research fields."
    },
    {
      "seq": 2,
      "describe_ch": "增進報告撰寫、口頭簡報及問答技巧",
      "describe_en": "The students can improve the written and oral communication skills."
    }
  ],
