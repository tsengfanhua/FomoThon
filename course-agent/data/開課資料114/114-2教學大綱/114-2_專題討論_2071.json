  "description": {
    "sub_id3": null,
    "sub_name": "專題討論",
    "sub_ename": "SEMINAR",
    "describe_ch": "邀請校內外之學者專家及修課研究生就通訊工程領域進行演講，通過討論使學生了解目前及未來通訊工程領域的發展方向?另外亦探討如何定義及解決一個研究問題。",
    "describe_eh": "Speakers including invited professors and graduate students give presentations on topics related to communications engineering. Through discussion, students will understand the current and future trends of research in communications field. Meanwhile, examples of learning to define and to solve a research problem are given.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠收集國內外通訊技術或現代科學相關資訊",
      "describe_en": "Be able to survey information about worldwide communication techniques or modern sciences."
    },
    {
      "seq": 2,
      "describe_ch": "具備口頭報告之能力，能有條理地進行口頭陳述與表達。",
      "describe_en": "Be able to coherently proceed an oral presentation."
    }
  ],
