  "description": {
    "sub_id3": null,
    "sub_name": "光學實驗(二)",
    "sub_ename": "OPTICS LAB. (2)",
    "describe_ch": "光學實驗為奠定學生的基礎光電實驗技能，熟悉光學之研究方法，並體會科學研究之精神。同時也與「光學」課程配合，親身體驗所學之光學原理。光學實驗(二)共安排11項實驗，內容除了物理光學相關實驗外，還有基礎光學實驗工具的使用。",
    "describe_eh": "Optics Lab. aims to equip students with the experimental techniques of photonics, be familiar with basic optical methods, and comprehend the culture of scientific research. Meanwhile, the designs of this course allow students to experience the phenomena discussed in Optics course. The course of Optics Lab. (2) includes 11 experiments, including the topics of physical optics and basic tools for optical laboratory.",
    "pre_subname": "OPT2002光學(二)、OPT2003光學實驗(一)、PHYS2001電磁學(一)、PHYS2002電磁學(二)、PHYS1004普通物理(二)、PHYS1002普通物理實驗(二)",
    "pre_sub_id3": "OPT2002",
    "pre_sub_ename": "OPT2002 OPTICS (2)、OPT2003 OPTICS LAB. (1)、PHYS2001 ELECTROMAGNETICS(1)、PHYS2002 ELECTROMAGNETICS(2)、PHYS1004 GENERAL PHYSICS(2)、PHYS1002 GENERAL PHYSICS LAB.(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能正確使用基礎光學實驗技術與工具。",
      "describe_en": "Be able to apply basic optical techniques and instruments correctly."
    },
    {
      "seq": 2,
      "describe_ch": "能夠處理及分析實驗結果。",
      "describe_en": "Be able to organize and to analyze the experimental results."
    },
    {
      "seq": 3,
      "describe_ch": "能透過小組展現團隊合作能力。",
      "describe_en": "Demonstrate team spirit through teamwork."
    },
    {
      "seq": 4,
      "describe_ch": "能運用書面或口頭報告將所獲結果與同儕及教師溝通。",
      "describe_en": "Application of paper or oral reports for presenting to classmates, and the instructor."
    },
    {
      "seq": 5,
      "describe_ch": "能透過光學實驗理解光電產品中的光學系統、元件或製程設計原由。",
      "describe_en": "Be able to comprehend the design concepts of optical system, component or process in optoelectronic products."
    }
  ],
