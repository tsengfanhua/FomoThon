  "description": {
    "sub_id3": null,
    "sub_name": "田野調查與實作",
    "sub_ename": "MANAGEMENT FIELD STUDY AND PRACTICE",
    "describe_ch": "本課程提供學生透過全球參與觀察的模式，培養學生教育學習觀察心得，並且應用到觀察全球社會經濟活動與脈絡，依照此方式，有效地結合宏觀經濟趨勢與微觀企業經營，藉此有效提昇學生的競爭力與創新力。",
    "describe_eh": "The purpose of this course is to provide a participant observation study, which can give the students a chance to integrate their learning and working experiences into business practice. By doing so, the students can learn how to operate effectively and efficiency in the business modes and analyze globalized economy trend.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "綜合瞭解在全球下的環境與文化衝擊下如何有效率的營運",
      "describe_en": "By participating in the field study, student can integrate their knowledge and practice in business mode."
    },
    {
      "seq": 2,
      "describe_ch": "能夠透過全球經營的分析，在知識、實務經驗的綜合中，提升學員認知，並培養具備全球布局的領導者",
      "describe_en": "To enhance the ability of students to cope with the competitive challenges in global market."
    }
  ],
