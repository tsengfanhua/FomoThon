  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB04310",
    "sub_id": "38037",
    "scr_dup": "001",
    "sub_title": "各種主要財產保險單(汽車險火險及責任險)條款結構與個案研究",
    "sub_title_en": null,
    "sub_describe": "隨著科技的進步，各種新的產業活動，如綠能保險及新能源車的逐漸普及，改變了產險市場險種的更新與替代，本課程將專注於產險市場上主要特定險種的保單最新條款的分析與個案討論。授課過程在於訓練學員對於各類產險的認知與對於專題的組織與表達能力。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "財產保險專題研究",
    "sub_ename": "TOPICS ON PROPERTY AND LIABILITY INSURANCE",
    "describe_ch": "近年來保險事業發展迅速，保險學術水準亦日益提昇。因此本課程講授內容以理論與實務並重。並分別就財產保險全面作總合與個論之研究。除廣泛取材於國內外有關保險學術之著作外，更引用我國現行民法與保險法等有關法令加以驗證。期使學生能獲得實用之知識。",
    "describe_eh": "As the insurance business of recent years is rapidly developed, the level of academic research on insurance is also upgraded. In our teaching program, this course emphasizes simultaneously both theory and practices. Besides, the picture of this field includes an overall concepts and individual subject analysis. Except having adopted of domestic insurance academic works, we introduce current civil law and related insurance law to exam our studies, and it is our expectation to let students can get practical knowledge from this paper.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使同學瞭解個別財產保險的風險態樣與損失暴露",
      "describe_en": "Make students to understand property and liability risks and loss exposures"
    },
    {
      "seq": 2,
      "describe_ch": "使同學能應用財產保險的知識來經營財產保險市場",
      "describe_en": "Make students to use knowledge learned from this paper to operate non-life insurance market."
    }
  ],
