  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB05310",
    "sub_id": "37040",
    "scr_dup": "001",
    "sub_title": "1、現代租稅制度功能。\n2、租稅設計原理。\n3、進階公共經濟學與財政學議題。\n4、主要稅目（所得稅、消費稅／營業稅、財產稅）的基本結構。\n5、閱讀租稅理論與政策相關文獻。",
    "sub_title_en": null,
    "sub_describe": "1、建立現代租稅制度之基本觀念，理解租稅在財政收入、資源配置與所得重分配上的功能。\n2、掌握租稅設計的核心原理，包括效率、誘因效果、公平與租稅歸宿分析。\n3、能以個體經濟模型與簡單一般均衡直覺分析租稅對勞動供給、儲蓄、投資與風險承擔行為的影響。\n4、熟悉主要稅目（所得稅、消費稅／營業稅、財產稅）的基本結構，理解其政策取捨與國內外改革趨勢。\n5、具備閱讀租稅理論與政策相關文獻的基本能力，能就我國實際稅制提出初步研究問題與政策評析。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "租稅理論",
    "sub_ename": "TAXATION THEORY",
    "describe_ch": "本課程探討租稅的一般理論與政策效果。講述的內容包括租稅的超額及租稅歸宿、租稅的效率與公平，租稅對勞動供給、儲蓄、風險承擔、逃漏稅等行為的影響，租稅政策的經濟穩定效果，最適租稅，電子商務課稅及綠色租稅等主題。",
    "describe_eh": "This course focuses on the general theory and policy of taxation. The major topics include: excess burden of taxation, tax incidence, efficiency effects of taxes and subsidies, equity aspects of taxes and subsidies, incentives effects of taxation such as the effects of taxation on saving, investment, and labor supply, optimal taxation, E-commerce taxation, and environmental taxation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解租稅的一般理論與政策效果",
      "describe_en": "Understand the general tax theory and tax policies."
    },
    {
      "seq": 2,
      "describe_ch": "能使用相關資料，進行租稅政策分析，並由實證中歸納出適當結論",
      "describe_en": "Use related data to conduct tax policy analysis and make appropriate conclusions."
    },
    {
      "seq": 3,
      "describe_ch": "能評估租稅在社會及經濟層面的重要性及影響",
      "describe_en": "Evaluate the importance and effects of taxes to society and the economy."
    }
  ],
