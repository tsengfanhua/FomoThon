  "description": {
    "sub_id3": null,
    "sub_name": "智慧製造",
    "sub_ename": "SMART  MANUFACTURING",
    "describe_ch": "本課程著重在闡述工業 4.0 對製造優化之內容與知識，例如可靠 度、精密度、健康診斷、能耗優化及減震等等改善， 俾對工業 4.0 各種改善技 術之運用，能有可依循之模式。第二個部分則在闡述工業 4.0 對製造優化之內容與知識，例如可靠度、精密度、健康診斷、能耗優化及減震等等改善， 俾對工業 4.0 各種改善技 術之運用，能有可依循之模式。",
    "describe_eh": "This course emphasizes the content and knowledge of industry 4.0 for manufacturing optimization, such as reliability, precision, health diagnosis, energy consumption optimization and shock absorption, etc., so that the application of various improvement technologies of industry 4.0 can be possible.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能使用感測器整合於設備的應用技術。",
      "describe_en": "An application technology that can be integrated into a device using a sensor."
    },
    {
      "seq": 2,
      "describe_ch": "能使用智慧物聮網的應用技術，並能清楚表達。",
      "describe_en": "Can use the application technology of smart sensor and can express it clearly."
    },
    {
      "seq": 3,
      "describe_ch": "知道資訊交換及人機介面應用技術。",
      "describe_en": "Knowledge of information exchange and human-machine interface application technology."
    },
    {
      "seq": 4,
      "describe_ch": "製造整合案例演練及實務技能養成。",
      "describe_en": "Manufacturing integration case drills and practical skills development."
    }
  ],
