  "description": {
    "sub_id3": null,
    "sub_name": "投資學",
    "sub_ename": "INVESTMENTS",
    "describe_ch": "本課程闡述投資學領域各重要議題，內容主要包括投資商品介紹、投資組合理論、資本資產與套利定價理論及效率市場假說。",
    "describe_eh": "To give students the knowledge of the financial instruments available to investors and the ways in which markets for these instruments operate. The course briefly covers the introductions of financial securities, portfolio theory, capital asset pricing model, arbitrage pricing theory and the efficient market hypothesis.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)、STAT1001統計學(一)、STAT1002統計學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)、STAT1001 STATISTICS(1)、STAT1002 STATISTICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解各種金融商品的種類與交易市場。",
      "describe_en": " Understand the classes and the markets of financial assets."
    },
    {
      "seq": 2,
      "describe_ch": "了解報酬與風險的基本觀念。",
      "describe_en": "Understand the basic concepts of return and risk for the investment on financial assets."
    },
    {
      "seq": 3,
      "describe_ch": "學習股票評價與分析的基本技巧。",
      "describe_en": "Learn some basic asset pricing models and stock analysis techniques."
    }
  ],
