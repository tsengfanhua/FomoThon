  "description": {
    "sub_id3": null,
    "sub_name": "有機光電材料與元件",
    "sub_ename": "ORGANIC OPTOELECTRONIC MATERIALS AND DEVICES",
    "describe_ch": "有機光電元件具有大面積化、可撓曲、低溫製程以及價廉等優點，提供了有別於矽基為主於光電元件上之利基。本課程主要係從材料之觀點切入，介紹有機光電材料的種類、材料結構與光電特性之關係、元件製作的方式、以及相關材料之應用方向。課程之內容將以有機電激發光材料以及有機太陽能電池做為主軸。藉由課程的介紹，使學生具備有機光電材料應有的知識與元件製作的技能，達到人才培育之目的。",
    "describe_eh": "\tThe organic optoelectronic devices provide several advantages over traditional silicon-based devices. This course is intended for students who are interested in learning about the fundamentals of organic-based materials and devices. It is designed for students who want to acquire the basic concepts in chemistry necessary to understand the operation principles of organic thin film transistors, organic light emitting diodes, organic solar cells, organic lasers as well as organic based sensors. Students undertaking, or those who are considering undertaking research and development in this area should take this course.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉並瞭解材料結構-性能關係，並進而與元件特性做關聯。\t",
      "describe_en": "Be familiar with important structure- property relationships in the materials, and how these relate to their uses in different electronic devices."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉各種光電元件參數與效能評估。\t",
      "describe_en": "Be familiar with important parameters used to assess the performance of various organic electronic devices."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解此技術於未來產業界之應用。\t",
      "describe_en": "Be aware of current and possible future industrial applications of this new technology."
    },
    {
      "seq": 4,
      "describe_ch": "有能力閱讀並瞭解該領域相關文獻與研究報告。\t",
      "describe_en": "Be able to read and understand review papers from the literature in these areas."
    }
  ],
