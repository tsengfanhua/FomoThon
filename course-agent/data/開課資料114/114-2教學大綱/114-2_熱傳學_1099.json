  "description": {
    "sub_id3": null,
    "sub_name": "熱傳學",
    "sub_ename": "HEAT TRANSFER",
    "describe_ch": "熱傳學係一門探討熱能如何傳遞及預估熱傳率大小之基礎科學，由於熱傳學於現今工程設計上扮演一個決定性之角色，因此瞭解及應用熱傳之機構日益重要。本課程之目的係使學生瞭解傳導、對流及輻射之傳熱方式，並將其應用於工程上之熱傳系統之設計與分析。",
    "describe_eh": "Heat transfer is a basic science that deals with to explain how heat energy may be transferred and to predict the rate at which the exchange will take place.  Understanding and application of the heat transfer mechanisms is becoming increasingly important since heat transfer plays a crucial role in engineering design.  The objectives of this course are: (1) To provide the basic heat transfer theories of conduction, convection, and radiation; and (2) To develop the skill of design and analysis of heat transfer systems.",
    "pre_subname": "MCAE2001熱力學(一)、MCAE2002熱力學(二)",
    "pre_sub_id3": "MCAE2001",
    "pre_sub_ename": "MCAE2001 THERMODYNAMICS(1)、MCAE2002 THERMODYNAMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解熱傳學之基本機構，包含傳導、對流、及輻射。",
      "describe_en": "Understand the basic mechanisms of heat transfer, including conduction, convection, and radiation."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解熱傳學理論於日常生活及實際工程之應用。",
      "describe_en": "Understand the applications of heat transfer theories on real life and engineering practices."
    },
    {
      "seq": 3,
      "describe_ch": "建立熱傳系統分析模型之能力",
      "describe_en": "Develop the ability of creating analysis models of heat transfer systems."
    },
    {
      "seq": 4,
      "describe_ch": "培養利用數值分析方法或套裝軟體進行熱傳系統設計及分析之能力",
      "describe_en": "Develop the ability of heat transfer system design and analysis by using numerical method and/or commercial software."
    }
  ],
