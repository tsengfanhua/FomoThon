    {
      "seq": 1,
      "describe_ch": "能應用地理資料庫之相關技術",
      "describe_en": "Be able to apply geographic database related technologies"
    },
    {
      "seq": 2,
      "describe_ch": "能理解地理資訊系統之功能與應用",
      "describe_en": "Be able to understand the functions and applications of geographic information systems"
    }
