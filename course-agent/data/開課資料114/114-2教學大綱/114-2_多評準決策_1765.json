  "description": {
    "sub_id3": null,
    "sub_name": "多評準決策",
    "sub_ename": "MULTIPLE CRITERIA DECISION MAKING",
    "describe_ch": "本課程講解有關多評準決策之基本原則、數學背景及分析步驟等觀念外，並介紹樹種常用之多評準決策方法。為增進同學之應用能力，每位同學將被要求繳交一份以實際問題為藍本之期末報告。",
    "describe_eh": " In this course, the basic principles, mathematical background, and analytic procedures of multiple criteria decision making are introduced along with various common used methods, including AHP/ANP, ELECTRE, PROMETHEE. To verify student's comprehensive on this subject, a course project  of  real-world  problem will be required and presented for each student in the final weeks .",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠運用所授概念或軟體於分組討論或指定作業中求解非劣解、估算目標權重及進行方案排序",
      "describe_en": "Learners can apply the mathematical concepts and software to define non-dominate solutions, to assess weights of objectives, and to prioritize alternatives"
    },
    {
      "seq": 2,
      "describe_ch": "針對選定之專業問題，能夠評析相關研究成果特色並與課程教材進行比較",
      "describe_en": "Learners can analyze the results of current research and compare it with course materials on a specific field"
    },
    {
      "seq": 3,
      "describe_ch": "針對選定之專業問題，能夠以多評準決策方法提出方案評估結果",
      "describe_en": "Learners can perform the solving procedures and its answer for a practical multi-criteria problem"
    }
  ],
