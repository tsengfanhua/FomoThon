  "description": {
    "sub_id3": null,
    "sub_name": "應用電子學",
    "sub_ename": "APPLIED ELECTRONICS",
    "describe_ch": "本課程介紹電子領域中常用之電子元件，其中主要包含被動元件[二極體]及主動元件[雙極性電晶體及場效電晶體]。課程中也將認識元件之電氣特性及如何建構電子電路，並了解整體電路之直流及交流特性，進而分析電路之特性作為應用設計之參考。此外，課程亦涉及運算放大器之介紹及應用進行探討。本課程除了透過課堂講授外，也將透過輔助相關教材來加速學生學習。",
    "describe_eh": "This course introduces electronic components commonly used in the electronics field, mainly including passive components [diodes] and active components [bipolar transistors and field-effect transistors]. The course will also understand the electrical characteristics of components and how to construct electronic circuits, understand the DC and AC characteristics of the overall circuit, and then analyze the characteristics of the circuit as a reference for application design. In addition, the course also involves the introduction and application of operational amplifiers. In addition to teaching in class, this course will also speed up student learning through supplementary related teaching materials.",
    "pre_subname": "MCAE2000電工學",
    "pre_sub_id3": "MCAE2000",
    "pre_sub_ename": "MCAE2000 ELECTRICAL ENGINEERING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解電子元件與半導體材料之關係及影響.",
      "describe_en": "Understand the relation and the influence between the electronic components and the semi-conductor material"
    },
    {
      "seq": 2,
      "describe_ch": "電子元件電氣差異性及電路呈現,提昇電路評估能力.",
      "describe_en": "From the differences in electronic component electricity and electric circuits presented, promoting ability in the electronic circuit evaluation."
    },
    {
      "seq": 3,
      "describe_ch": "電子電路分析與模擬方法,啟發研究設計能力.",
      "describe_en": "Inspiring the ability in studing how to design from the electronic analysis and simulation."
    },
    {
      "seq": 4,
      "describe_ch": "模擬的輔助, 解決電路問題之能力.",
      "describe_en": "With assistance of simulation , resolve the electronic problems."
    }
  ],
