  "description": {
    "sub_id3": null,
    "sub_name": "視覺設計原理與技巧",
    "sub_ename": "VISUAL DESIGN PRINCIPLES AND SKILLS",
    "describe_ch": "平面設計課程以美學的角度出發，\n學習設計概念與應用方法結合Photoshop 影像處理技巧功能，\n將插畫作品進行影像創作，設計出更精緻的視覺影像。\n",
    "describe_eh": "The graphic design course starts from an aesthetic point of view. Students are expected to learn design concepts and application methods combined with photo-shop image processing skills, and use illustration works for image creation to design more refined visual images.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過創意思考的課程，練習應用平面設計美編技巧。",
      "describe_en": "Through the course of creative thinking, apply graphic design and beauty editing skills."
    },
    {
      "seq": 2,
      "describe_ch": "學習視覺傳達的知識與技術，應用專業繪圖軟體進行操作與探索。",
      "describe_en": "Learn the knowledge and technology of visual communication, and apply professional drawing software for operation and exploration."
    }
  ],
