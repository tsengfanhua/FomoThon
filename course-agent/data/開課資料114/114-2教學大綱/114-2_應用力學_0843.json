  "description": {
    "sub_id3": null,
    "sub_name": "應用力學",
    "sub_ename": "APPLIED MECHANICS",
    "describe_ch": "本課程為材料力學、結構分析與結構設計的先修課程，以基本的物理與數學為基礎。內容主要包括質點與剛體之力平衡觀念以及桁架、梁、構架及纜繩之分析方法。",
    "describe_eh": "This course is a prerequisite for Mechanics of Materials, Structural Analysis and Design. Based on fundamental Physics and Mathematics, this course contains the concepts of equilibrium of particles and rigid bodies, and the analysis methods for trusses, beams, simple frames and cables.",
    "pre_subname": "CEM1004工程力學導論",
    "pre_sub_id3": "CEM1004",
    "pre_sub_ename": "CEM1004 INTRODUCTION TO ENGINEERING MECHANICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能解釋力與力矩之特性。",
      "describe_en": "To explain the characteristics of force and moment."
    },
    {
      "seq": 2,
      "describe_ch": "描述使物體維持靜力平衡狀態的條件。",
      "describe_en": "To describe how to keep a body in static equilibrium."
    },
    {
      "seq": 3,
      "describe_ch": "應用平衡觀念分析桁架、梁、構架及纜繩。",
      "describe_en": "To apply concepts of equilibrium to analyze trusses, beams, frames and cables."
    }
  ],
