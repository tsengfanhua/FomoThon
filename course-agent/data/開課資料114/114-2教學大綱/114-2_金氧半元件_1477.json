  "description": {
    "sub_id3": null,
    "sub_name": "金氧半元件",
    "sub_ename": "MOS DEVICES",
    "describe_ch": "金氧半場效電晶體對於超大型積體電路，如微處理機、半導體記憶體來說是很重要的元件。而C-V，I-V的量測技術、基本金氧半場效電晶體的特性、元件的趨勢、短通道效應、以及金氧半元件於產品上的應用都會做一完整的介紹。\n\n",
    "describe_eh": "The metal-oxide-semiconductor field-effect transistor (MOSFET) is the most important device for very-large-scale integrated circuits such as microprocessors and semiconductor memories.  Both techniqes of C-V and I-V measurement will be introduced. Basic characteristic of MOSFET device will be introduced. The trend of device and short channel effect also be described. Finally, the application of MOS device will be described using some products.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用相關軟體對金氧半元件進行模擬，進而重新設計或改良元件。",
      "describe_en": "To apply the related software to simulate the MOS device for improving or redesigning the device."
    },
    {
      "seq": 2,
      "describe_ch": "能獨自分析並解決課堂所提供的練習題，並提出新問題。",
      "describe_en": "To analyze and solve the exercises provided in the class by oneself and discover the new problems"
    },
    {
      "seq": 3,
      "describe_ch": "能綜合金氧半元件在未來積體電路製程中所可能遇到的問題及解決方式。",
      "describe_en": "To synthesize the possible problems and ways of solution for which might encountered by the MOS devices in the future integrated circuit process."
    },
    {
      "seq": 4,
      "describe_ch": "能獨自分析並解決課堂所提供的練習題，並提出新問題",
      "describe_en": "To analyze and solve the exercises provided in the class by oneself and discover the new problems."
    }
  ],
