  "description": {
    "sub_id3": null,
    "sub_name": "自然語言處理",
    "sub_ename": "NATURAL LANGUAGE PROCESSING",
    "describe_ch": "學習如何將深度學習的演算法應用到自然語言處理，從而實現具有語言處理功能的人工智慧應用系統。課程設計將從自然語言的資料表示方法開始介紹，並透過此方法與深度學習的CNN、RNN、LSTM等神經網路模型整合成自然語言處理的演算架構，以及學習最終如何使用TensorFlow平台實現此一可應用於現代人工智慧系統的自然語言處理方法。",
    "describe_eh": "To apply artificial intelligence for natural language processing. The course design will start with the introduction of natural language data representation methods, and use this method to integrate deep learning CNN, RNN, LSTM and other neural network models into a natural language processing algorithm, and learn how to finally use the TensorFlow platform to achieve this. Natural language processing method applicable to modern artificial intelligence system",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "明瞭自然語言之基本理論及應用",
      "describe_en": "Understand the basic theories and applications of natural language"
