  "description": {
    "sub_id3": null,
    "sub_name": "組織行為",
    "sub_ename": "ORGANIZATIONAL BEHAVIOR",
    "describe_ch": "如何妥善處理人際間之互動關係，為管理者應面對正視之一重要任務，而欲能有效管理與『人』相關之各種事務，則首應瞭解『人』（包括個人及團體）的行為及行為背後之原因，此即是本課程目的與內涵之所在。",
    "describe_eh": "In this course, students learn the roles, contents and context of organizational behavior. After they enhance their skills by studying organizational behavior, they can apply their fundamental knowledge to management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解一般商業行為與環境之能力",
      "describe_en": "Ability to comprehend the behavior and environment ob business."
    },
    {
      "seq": 2,
      "describe_ch": "處理與提供企業財務資訊之能力",
      "describe_en": "Dealing and Processing financial and accounting information in business."
    },
    {
      "seq": 3,
      "describe_ch": "有效溝通及團隊合作的能力",
      "describe_en": "Ability to communicate, Coordinate and cooperate as a team."
    },
    {
      "seq": 4,
      "describe_ch": "辨識、分析及解決企業財務問題的能力",
      "describe_en": "Ability to recognize, analyses and solve financial and budgeting problem."
    },
    {
      "seq": 5,
      "describe_ch": "當代議題，瞭解會計資訊內容對經濟環境、社會及全球的影響，並能持續學習的能力",
      "describe_en": "Figure out economic social and global issues for accounting."
    }
  ],
