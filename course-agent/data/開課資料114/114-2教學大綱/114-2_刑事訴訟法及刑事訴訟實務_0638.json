  "description": {
    "sub_id3": null,
    "sub_name": "刑事訴訟法及刑事訴訟實務",
    "sub_ename": "THEORY AND PRACTICE OF CRIMINAL",
    "describe_ch": "刑事訴訟為動態流程，本課程將以實際案件進行方式，區分刑事訴訟各階段，介紹偵查、起訴、審判、救濟程序等，國家如何對於犯罪者，實踐刑罰權之訴訟程序。此外，本課程也透過實務判決及訴訟書狀的介紹，結合學理、實務及案例等方式，培養同學對於刑事訴訟爭議問題進行抽象演繹與分析推理的能力。",
    "describe_eh": "This course (Criminal procedure) focuses on fundamental concepts of criminal procedure and will be taught by combing judicial opinions with cases. Students are not only expected to review the concept of the criminal procedure but also to cultivate their inferential capability on the cases.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解刑事訴訟法體系之運行和法制改革的動向",
      "describe_en": "Understand the practice of the criminal procedure law system and the trend of legal reform"
    },
    {
      "seq": 2,
      "describe_ch": "分析與討論刑事訴訟法爭點",
      "describe_en": "Analysis and discussion of criminal procedure law issues"
    },
    {
      "seq": 3,
      "describe_ch": "針對刑事訴訟法律議題為個案研究",
      "describe_en": "A case study on criminal procedure law"
    }
  ],
