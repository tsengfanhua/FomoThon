      "describe_ch": "理解雲端計算到邊緣計算角色分工與應用原則",
      "describe_en": "Understand the division of labor and application principles from cloud computing to edge computing"
    },
    {
      "seq": 3,
      "describe_ch": "實作與應用雲端計算",
      "describe_en": "Implement and apply cloud computing"
    }
