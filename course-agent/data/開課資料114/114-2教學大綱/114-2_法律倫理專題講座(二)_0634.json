    "sub_id3": null,
    "sub_name": "法律倫理專題講座(二)",
    "sub_ename": "LEGAL ETHICS SEMINAR(2)",
    "describe_ch": "在先進國家的法學教育中，法律倫理佔有極重要地位。本課程特別著重於法律專業人員法學倫理思維研習。並邀請知名學者演講作深入淺出的介紹使同學對法律倫理相關課題有更深入認識。",
    "describe_eh": "This course is the first in a two-part series aimed at giving LL.M. students basic knowledge of legal ethics. The course invites famous scholars of law to give seminars in order to help students understand the current framework of legal ethics in Taiwan and the global village.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
