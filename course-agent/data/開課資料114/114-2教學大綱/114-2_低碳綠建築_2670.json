  "description": {
    "sub_id3": null,
    "sub_name": "低碳綠建築",
    "sub_ename": "LOW CARBON GREEN BUILDING",
    "describe_ch": "本課程目的在於培養學生對於低碳綠建築之正確觀念：1.介紹國內外低碳綠建築的潮流與實際案例；2.啟發學生對於未來居住環境及生態保育之積極態度；3.理解全球低碳綠建築未來趨勢及永續環境議題。",
    "describe_eh": "This course is to help students develop the concept of low carbon green building. 1. Students will realize the current trend of low carbon green building in the world through the provision of the applicative technologies in practice. 2. Students will be motivated to establish correct attitudes toward protecting and preserving our living environment and natural ecology. 3. Students will comprehend the global low carbon green building trend and the sustainable environmental issues related to it.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解低碳綠建築之正確觀念\t",
      "describe_en": "Comprehend the correct concept of low carbon green building."
    },
    {
      "seq": 2,
      "describe_ch": "能應用低碳綠建築理論設計能力並具備建築減碳設計能力\t",
      "describe_en": "Obtain the ability of applying the theory of low carbon green building in building carbon reduction design."
    }
  ],
