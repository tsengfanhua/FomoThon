  "description": {
    "sub_id3": null,
    "sub_name": "電腦在化工上之應用",
    "sub_ename": "THE APPLICATION OF COMPUTER IN CHEMICAL ENGINEERING",
    "describe_ch": "本課程介紹化工領域常用之計算套裝軟體與資料分析工具，內容涵蓋 Python 程式基礎、Numpy、Scipy、Pandas 等科學運算套件與 scikit-learn 等基礎機器學習工具。課程包含傳統數值方法(代數方程式、常微分方程式、線性代數)、線性回歸與入門 AI 模型之應用，示範其於化工資料處理與問題求解上的實際用途。學生將透過 Google Colab 實作，培養以軟體進行分析、規劃求解方法與解讀模型結果的能力。",
    "describe_eh": " This course introduces commonly used computational and data-analysis tools in chemical engineering. It covers fundamental Python programming, scientific computing libraries such as Numpy, Scipy, and Pandas, as well as scikit-learn for basic machine-learning applications. Topics include traditional numerical methods (e. g. algebraic equations, ordinary differential equations and linear algebra), linear regression, and introductory AI models, with demonstrations of their applications in chemical engineering data processing and problem solving. Through hands-on practice in Google Colab, students will develop skills in computational analysis, solution planning, and interpretation of model results.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠將各種化學現象的實驗數據加以分類分析、歸納、求解。",
      "describe_en": "To classify, analyze, summarize, and solve experimental data derived from various chemical phenomena."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明計算結果在化學工業經濟層面的意義。",
      "describe_en": "To understand and explain the significance of computational results in the context of chemical industry economics."
    },
    {
      "seq": 3,
      "describe_ch": "能使用相關之數學軟體，完成化學工程類的相關數據之計算。",
      "describe_en": "o utilize relevant mathematical and computational software to perform calculations related to chemical engineering data."
    },
    {
      "seq": 4,
      "describe_ch": "能辨識可使用計算工具與 AI 方法之場合，並能清楚表達適當的求解策略與軟體選擇理由。",
      "describe_en": "To identify situations where computational tools and AI methods are applicable, and clearly articulate appropriate solution strategies and software selections."
    }
  ],
