  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CS03149",
    "sub_id": "69438",
    "scr_dup": "001",
    "sub_title": "Introduction of surface treatment techniques for functional materials",
    "sub_title_en": null,
    "sub_describe": "Understand the principles of surface treatment techniques of functional materials for industrial/semiconductor applications, eg, plasma etching, Lithography, etc.",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "機能性表面處理",
    "sub_ename": "SURFACE PREPARATION OF FUNCTIONAL FILMS AND COATINGS",
    "describe_ch": "本課程為表面處理學程核心科目之ㄧ，講授內容則為學理與實務應用並重。課程內容注重在介紹功能性鍍膜的種類與原理、製備方法、相關檢測與後續可能之各種應用。本課程除了透過課堂講授外，也將透過輔助相關教材來加速學生學習。",
    "describe_eh": "This course is one of the core subjects of the surface treatment course, and the teaching content is both academic theory and practical application. The course content introduces the types and principles of functional coatings, preparation methods, related tests, and various possible subsequent applications. In addition to teaching in class, this course will also speed up student learning through supplementary related teaching materials.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "列舉功能性鍍膜種類，並且描述功能性鍍膜應用原理。",
      "describe_en": "Classification of functional films and coatings and describe its application principle."
    },
    {
      "seq": 2,
      "describe_ch": "定義並說明功能性鍍膜的製備方法並選擇合適的試驗方法進行檢測與分析。",
      "describe_en": "Define and describe preparation and characterization of functional films and coatings."
    }
  ],
