  "description": {
    "sub_id3": null,
    "sub_name": "可程式控制(含實驗)",
    "sub_ename": "PROGRAMMABLE  LOGIC  CONTROL (WITH EXPERIMENT)",
    "describe_ch": "概述PLC的軟硬體的基本知識，充分介紹階梯圖、步進階梯命令與常用應用指令，讓學生了解自動化的設備使用的程式控制器，功能如何操作。",
    "describe_eh": "This course sketches the basic knowledge, relating to the software and hardware of PLC, and lets students understand how to use the programme-controller of automatic equipment and know how to manipulate its function.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用微處理機基礎以瞭解可程式控制系統基本知識",
      "describe_en": "Apply microprocessor foundation to understand the basic knowledge about programmable control systems."
    },
    {
      "seq": 2,
      "describe_ch": "理解可程式控制系統各項性能的定義與定理",
      "describe_en": "Comprehension for the definitions or theories of programmable control  system performance."
    },
    {
      "seq": 3,
      "describe_ch": "應用分析設計軟體對可程式控制系統完成分析與設計",
      "describe_en": "Application for the simulation software to programmable analysis and design."
    }
  ],
