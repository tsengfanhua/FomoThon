  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(二)",
    "sub_ename": "ENGINEERING MATHEMATICS(2)",
    "describe_ch": "介紹機率之基本概念及其運算、常用之離散型及連續隨機變數、動差，並探討多個變數之聯合機率分配、變數變換後之機率分配、大數法則及中央極限定理等性質。做為日後學習應用數理統計學之準備。",
    "describe_eh": "This course introduces Probability Space, Random Variable and Probability, some special discrete random variable, some special continuous random variable expectation, moment generating function, multiple random variable, multivariate probability distribution, functions of random variable, conditional probability distribution, bivariate normal distribution, conditional expectation, covariance, order statistics and their distribution, Laws of Large Number and Limit Theorems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解機率論中相關名詞之基本定義與計算。",
      "describe_en": "Comprehension for definitions/calculations of probability."
    },
    {
      "seq": 2,
      "describe_ch": "將機率論之理論應用於日常生活。",
      "describe_en": "Applications of probability theories in daily life."
    }
  ],
