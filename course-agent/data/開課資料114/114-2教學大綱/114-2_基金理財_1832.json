  "description": {
    "sub_id3": null,
    "sub_name": "基金理財",
    "sub_ename": "FUND MANAGEMENT",
    "describe_ch": "本課程透過產學合授介紹基金管理的理論基礎與實務結合，使同學了解基金的類型、風險與報酬、募集與交易、基金投資組合的管理策略與績效評估等，學習資產管理實務，瞭解基金產業發展趨勢。",
    "describe_eh": "This course is to introduce the basic theory with the practical applications of fund management by jointing with academic and practical teachers. Our contents include the understanding the types of funds, risk and return, raising and trading of funds, the policy of management and evaluation for fund portfolios. Learning the practical applications of asset management, and understanding the trends of fund industry are included.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能建立正確基金的管理的觀念與投資技巧",
      "describe_en": "Ability to establish correct investment concepts and skills for fund management"
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解國內、外基金類型、與退休基金",
      "describe_en": "Comprehension for the types of domestic and foreign funds and retirement fund"
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解如何判斷基金風險與報酬",
      "describe_en": "Comprehension for the risk and return of funds and practical applications for asset management"
    },
    {
      "seq": 4,
      "describe_ch": "能分析基金績效",
      "describe_en": "To analyze the performance of funds"
    }
  ],
