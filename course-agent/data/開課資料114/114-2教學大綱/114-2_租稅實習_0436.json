  "description": {
    "sub_id3": null,
    "sub_name": "租稅實習",
    "sub_ename": "TAXATION INTERNSHIP",
    "describe_ch": "本課程提供租稅實務訓練，安排學生至稅務機關參與租稅稽徵業務的實際作業，以瞭解租稅申報實務、稽徵程序、租稅罰則等，將理論與實務相結合，落實學習成效。",
    "describe_eh": "This course offers practical training for taxation. Arrange for students to the tax authorities to participate in actual tax administrative services in order to gain hands-on experience pertaining to tax declaration practices, tax levy procedures, tax penalty regulations and so on. Combine the tax theory and tax practices and promote the learning outcome.",
    "pre_subname": "PF2040租稅法(一)、PF2041租稅法(二)",
    "pre_sub_id3": "PF2040",
    "pre_sub_ename": "PF2040 TAX LAW(1)、PF2041 TAX LAW(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": " 能使用相關資料，進行網路及一般租稅申報",
      "describe_en": "Use related data to file tax via network or tax forms."
    },
    {
      "seq": 2,
      "describe_ch": "能以書面或口頭方式將所獲結果與納稅人、稅務人員、同儕及教師溝通　",
      "describe_en": " Communicate results in written or oral form to taxpayers, tax officials, schoolmates, and the instructor."
    },
    {
      "seq": 3,
      "describe_ch": "能運用資訊科技處理稅務資料的能力　",
      "describe_en": "Use computer information technology to process and analyze tax data."
    }
  ],
