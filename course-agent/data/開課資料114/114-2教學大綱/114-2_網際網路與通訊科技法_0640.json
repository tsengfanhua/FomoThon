  "description": {
    "sub_id3": null,
    "sub_name": "網際網路與通訊科技法",
    "sub_ename": "INTERNET AND COMMUNICATION LAW",
    "describe_ch": "涵蓋資訊法律概論、網路智慧財產權、電子交易契約和電子簽章法、個人隱私權保障、電子商務與消費者保護法、網路不實廣告與公平法、無線及有線廣播電視法、頻譜管理及電信法等相關法律問題討論與分析。",
    "describe_eh": "Following the revolution of information technology, the legal topics on Internet and Communication has become one of the most important issues. The course focuses on legal topics regarding Internet and e-commerce, information technology and intellectual property, personal data protection and privacy, consumer protection and unfair competition, wireless and cable broadcast TV law, spectrum management and telecommunications as well as related legal issues on information technology laws.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能說明國際電信傳播法的意義及重要性。",
      "describe_en": "Understanding Legal Meaning of International Telecommunications Law and Related Legal Issues"
    },
    {
      "seq": 2,
      "describe_ch": "熟悉並了解國際電信傳播法議題及相關爭端個案與研究結果。",
      "describe_en": "Acknowledging the Importance of International Telecommunications Law and Related Legal Disputes"
    },
    {
      "seq": 3,
      "describe_ch": "培養學生分析、解決實務法律問題及獨立思考之能力。",
      "describe_en": "Improve students' problem solving and analysis skill, and their independent thinking."
    },
    {
      "seq": 4,
      "describe_ch": "本課程希望透過課堂教學，增進同學對資訊應用、網路交易、電子商務發展所牽涉相關法律規範、衍生法律問題有完整及正確之觀念與瞭解。",
      "describe_en": "The course focuses on legal topics regarding Internet, telecommunication, e-commerce and related high-tech issues."
    }
  ],
