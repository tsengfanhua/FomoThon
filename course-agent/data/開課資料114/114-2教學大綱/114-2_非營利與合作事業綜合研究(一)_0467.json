  "description": {
    "sub_id3": null,
    "sub_name": "非營利與合作事業綜合研究(一)",
    "sub_ename": "COMPREHENSIVE RESEARCH IN NONPROFIT AND COOPERATIVE BUSINESS (I)",
    "describe_ch": "本課程係以瞭解第三部門的經營特點及合作部門的經濟分析為主。課程設計包括非營利制度經濟學、非營利組織經營、合作組織演變、合作組織動態理論等項目。",
    "describe_eh": "1.To understand characteristics of the third sector. 2.To introduce economic impact analysis on the co-operative sector.",
    "pre_subname": "STAT1001統計學(一)、STAT1002統計學(二)、COOP2002合作組織與管理、COOP2003非營利組織與管理",
    "pre_sub_id3": "STAT1001",
    "pre_sub_ename": "STAT1001 STATISTICS(1)、STAT1002 STATISTICS(2)、COOP2002 COOPERATIVE ORGANIZATION AND MANAGEMENT、COOP2003 NON-PROFIT ORGANIZATION AND MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠瞭解與分析應用基本企業研究方法到非營利與合作事業綜合研究專題上。",
      "describe_en": "To understand, analyze and apply basic business research methods in nonprofit and cooperative business study."
    },
    {
      "seq": 2,
      "describe_ch": "能應用統計分析方法及其觀念與結果解釋至非營利與合作事業綜合研究專題上。",
      "describe_en": "Application for statistical methods and interpret results to nonprofit and cooperative business management study."
    },
    {
      "seq": 3,
      "describe_ch": "透過團隊合作以書面或口頭方式完成撰寫與呈現非營利與合作事業相關主題之研究報告。",
      "describe_en": "Be able through team work to perform and present for nonprofit and cooperative business management study report."
    }
  ],
