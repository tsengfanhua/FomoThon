  "description": {
    "sub_id3": null,
    "sub_name": "水文水理分析與模式應用",
    "sub_ename": "HYDROLOGICAL ANALYSIS AND MODEL APPLICATION",
    "describe_ch": " 將氣候變遷之大氣改變現象應用於水文分析模式(HEC-HMS)演算水文量體，將上述所得水文量體利用水利工程規劃常用軟體(HEC-RAS)進行工程規劃設計。最後利用氣候變遷資料進行二維淹水模擬(SOBEK)，分析淹水風險等減災規劃",
    "describe_eh": "This course calculate the hydrological volume by HEC-HMS with the atmospheric change phenomenon of climate change. And hydraulic engineering planning software (HEC-RAS) for engineering planning and design. Finally, Two-dimensional flooding simulation analysis(SOBEK) of flood risk and other disaster mitigation planning using climate change data",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用水文、明渠、流體力學建構模式基本輸入資料\t",
      "describe_en": "This course applies basic input data of hydrology, open channel and fluid mechanics to construct model"
    },
    {
      "seq": 2,
      "describe_ch": "應用HEC-HMS、HEC-RAS及SOBEK模式進行水文、明渠及漫地流分析\t",
      "describe_en": "Hydrological, open channel and overland flow analysis by HEC-HMS, HEC-RAS and SOBEK models"
    },
    {
      "seq": 3,
      "describe_ch": "應用模式規劃、分析與設計實際工程",
      "describe_en": "\tApplied Pattern Planning, Analysis and Design for Practical Engineering"
    },
    {
      "seq": 4,
      "describe_ch": "獨力完成水利工程規劃、分析之專題報告\t",
      "describe_en": "Students independently complete a special report on the planning and analysis of water conservancy projects"
    }
  ],
