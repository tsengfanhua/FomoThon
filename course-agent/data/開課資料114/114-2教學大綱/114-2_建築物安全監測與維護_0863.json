  "description": {
    "sub_id3": null,
    "sub_name": "建築物安全監測與維護",
    "sub_ename": "BUILDING SAFETY MONITORING AND MAINTENANCE",
    "describe_ch": "台灣位處於地震與天然災害好發地區，針對不同建築物的形式，如何建立一套完整的安全監測系統，作為主要的課程目標。培養學生具備資料處理、資料分析和整合最新的監測技術與收集相關空間資訊，並落實後續建築物維護觀念。本課程結合學術與實務，提供學生適當的操作訓練。",
    "describe_eh": "It is kind to take place to the area that the Taiwan location is in earthquake and natural calamity, direct against the forms of different buildings, how to set up a set of intact security monitoring systems, as the main course goal. Train students to possess materials dealing with, analysis and combining the latest monitoring technology and collecting relevant spatial information, and implement the subsequent building and safeguard the idea. This course combines academy and practice, offer student appropriate operation to train.",
    "pre_subname": "CEM2025結構學",
    "pre_sub_id3": "CEM2025",
    "pre_sub_ename": "CEM2025 STRUCTURAL THEORY",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解並說明結構安全監控SHM的重要性及影響。",
      "describe_en": "Understand and be able to explain the importance and effects of monitoring technology."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解相關儀器設備，完成一量測的相關實驗，並由實驗中歸納出適當結論。",
      "describe_en": "Be able to use related equipment to finish an experiment about measuring, and draw appropriate conclusions from experiment results."
    },
    {
      "seq": 3,
      "describe_ch": "能透過建築資訊模型(BIM)的概念，瞭解國內外應用案例，並實際操作相關軟體。",
      "describe_en": "Design a reasonable monitoring system for a specific case or scenario."
    },
    {
      "seq": 4,
      "describe_ch": "能透過小組討論展現團隊合作能力。",
      "describe_en": "Communicate results in written or oral form to classmates and the instructor."
    }
  ],
