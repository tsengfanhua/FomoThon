  "description": {
    "sub_id3": null,
    "sub_name": "碩士論文",
    "sub_ename": "MASTER THESIS",
    "describe_ch": "為碩士班必修課程，需就其研究議題邀請從事該議題相關研究之教師擔任指導教授，經學位考試後取得學位。",
    "describe_eh": "Master classes and required courses, to be invited to engage in research issues of the issues teachers served as advisor by subject examinations and degree examinations to obtain a degree.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用專業定理應用於碩士論文研究中，執行與驗證各項專業定理，其中包括資料的蒐集、維護、管理與理論的測試。",
      "describe_en": "When can apply to study in master's thesis the theorem, carry out and verify every theorem, including the collection, maintenance, test of management and theory of the materials.　"
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明各項碩士論文研究之方法與進行程序。",
      "describe_en": "Method that can understand and prove that the master studies thesis and carrying on the procedure.　"
    },
    {
      "seq": 3,
      "describe_ch": "能以書面及口頭方式將所研究結果發表。",
      "describe_en": "Communicate results in written or oral form to classmates, teaching assistants, and the instructor.　"
    }
  ],
