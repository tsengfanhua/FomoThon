  "description": {
    "sub_id3": null,
    "sub_name": "個人資料保護法",
    "sub_ename": "PERSONAL INFORMATION PROTECTION ACT",
    "describe_ch": "個人資料保護法攸關個人隱私權與資料合理使用之平衡，本課程訓練學生思考、區別價值選擇與法律解釋之關係，並且著重於實務操作之辯證。",
    "describe_eh": "The Personal Information Protection Act strikes the balance between privacy protection and reasonable use of information. This course provides the opportunities that the participants learn to think and argue for both sides.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識個人資料保護與資料合理使用之互動。",
      "describe_en": "Understanding the interaction between personal privacy protection and reasonable use of information."
    },
    {
      "seq": 2,
      "describe_ch": "運用法律專業知識解決個資爭議。",
      "describe_en": "Dealing with personal information controversy by legal professional training."
    }
