  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "XA01101",
    "sub_id": "97591",
    "scr_dup": "001",
    "sub_title": "本課程除加強泰語發音與泰文書寫規則之講授，並持續以主題式教學，使學生能學習泰語的語法及語音，同時了解泰國的歷史及文化。",
    "sub_title_en": null,
    "sub_describe": "1.能在短期內能學會聽、說、讀、寫泰語，用來自我介紹、打招呼、問路、訂房、購物、殺價及交友等。\n2.在文化方面，認識泰國人的文化、風俗習慣、泰國節日、泰國人的基本禮貌、泰國人的民族性等。\n3.在文法方面，認識泰語的基礎語法；在語音方面，能習得泰語的語音學。\n4.在文字方面，能熟練泰文的字母、韻母、調號等書寫規則。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "泰語(二)",
    "sub_ename": "THAI(2)",
    "describe_ch": "泰語(二)包括15堂正課和1堂複習。本課程藉由練習與作業，提升學生之聽、說、讀、寫之能力，並透過反覆練習與生活主題相關之基本字彙與句型，加速學習者在基本的日常生活情境下使用泰語。",
    "describe_eh": "Thai (2) consists of 15 regular lessons and 1 review lesson. Exercises and homework are designed to develop and enhance listening, speaking, reading, and writing skills. Through constant practice of using basic vocabulary and sentence structures to talk about common topics, learners will quickly be able to apply their Thai language skills in rudimentary everyday life contexts.",
    "pre_subname": "THAI1001泰語(一)",
    "pre_sub_id3": "THAI1001",
    "pre_sub_ename": "THAI1001 THAI(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠了解原文素材、表達自己，並有相當的外語熟稔度以合適方式進行溝通和談判。",
      "describe_en": "Able to understand authentic materials, express themselves, communicate and negotiate in a satisfactory manner in the target language."
    },
    {
      "seq": 2,
      "describe_ch": "能有效地運用基本泰語能力介紹自己、練習與做作業。",
      "describe_en": "Able to introduce oneself effectively in basic Thai."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解各國之間的文化差異性，藉由語言知識的養成，俾與他國保持良好的互動，並養成世界觀。",
      "describe_en": "Aware of the cultural differences between countries, be able to use this knowledge to interact appropriately with the world outside of Taiwan and have a global vision."
    }
  ],
