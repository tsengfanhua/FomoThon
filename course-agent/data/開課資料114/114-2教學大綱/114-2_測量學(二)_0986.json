  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE02122",
    "sub_id": "44154",
    "scr_dup": "001",
    "sub_title": "涵蓋平面測量、大地測量及衛星定位測量的核心知識，由淺入深，系統性地介紹測量學的核心理論與實務技術，涵蓋從傳統平面測量到現代衛星與光達測量的完整知識體系，以供深入學習及研究之用。",
    "sub_title_en": null,
    "sub_describe": "課程的內容，涵蓋平面測量、大地測量及衛星定位測量的核心知識，由淺入深，系統性地介紹測量學的核心理論與實務技術，涵蓋從傳統平面測量到現代衛星與光達測量的完整知識體系，以供深入學習及研究之用。其中測量學專業知識及核心能力至少包含下列六項: \n一、 了解平面測量學基礎知識。 \n二、了解距離、高程、方向及角度等測量方法；並具備測量儀器操作及檢校能力。 \n三、了解控制測量、細部測量、地形測量、定位與放樣測量等作業及其他應用測量。 \n四、了解大地測量之基本觀念、作業方法、測量基準、參考系統與作業規劃。 \n五、了解衛星定位原理、架構、測量資料處理及應用。 \n六、具備理論與實務知識，達體用兼備之目標。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "測量學(二)",
    "sub_ename": "SURVEYING(2)",
    "describe_ch": "課程為進入測量領域之基礎課程，主要使學生瞭解測量學之基本原理、儀器操作及實際在工程上之應用，本課程教學採理論與實務並重。",
    "describe_eh": "To teach the Student familiar with the theory and practice of Surveying",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
