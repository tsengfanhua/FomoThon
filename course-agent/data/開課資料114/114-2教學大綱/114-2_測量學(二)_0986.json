    {
      "seq": 1,
      "describe_ch": "瞭解測量原理、作業技術及誤差傳播定律\t",
      "describe_en": "To know the principles, operation techniques, and law of error propagation of the surveying."
    },
    {
      "seq": 2,
      "describe_ch": "熟練各種測量儀器之操作及檢校\t",
      "describe_en": "To understand how to operate and adjust the surveying instruments."
    },
    {
      "seq": 3,
      "describe_ch": "團隊能利用測量數據計算成果並進行工程初步規劃\t\t",
      "describe_en": "To utilize the data of surveying to calculate the results by field works and make preliminary planning for engineering with team cooperation."
    }
