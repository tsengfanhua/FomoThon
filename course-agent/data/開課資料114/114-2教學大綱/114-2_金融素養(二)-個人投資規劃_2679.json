  "description": {
    "sub_id3": null,
    "sub_name": "金融素養(二)-個人投資規劃",
    "sub_ename": "FINANCIAL LITERACY 2–YOUR INVESTMENT PLAN",
    "describe_ch": "個人理財與長期投資能否成功，其關鍵在於具有健全的金融知識與投資素養。本課程讓大學部學生學習並認識投資實務關鍵原則，進行個人基礎投資。本課程無法取代財務與投資專業課程；而是偏向實務導向方式，讓大學部學生提早建立金融與投資素養，學習並應用於個人長期投資理財。本課程採用多元評量方式: 每週作業、期中口頭報告、與期末個案報告。",
    "describe_eh": "To succeed in managing your money and investing for the long-term, you need to have strong financial and investment literacy. This course provides the materials for students to learn and practice key investment principles, and start form the basics of investing. This course is not a replacement for core foundational courses in finance and investments. Rather this course is focused on the narrow, practical objective of building fundamental financial and investment literacy, so as to begin the life-long practice of learning and investing as a college student. There are multiple performance evaluation for this class: weekly assignments, mid-term oral-presentation, and final project report.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建立金融與投資素養-具有能力認識並使用中級理財與投資技巧",
      "describe_en": "Build financial and investment literacy – the ability to understanding and use intermediate financial and investment skills"
    },
    {
      "seq": 2,
      "describe_ch": "具有基本金融與投資技巧，可分析金融與投資相關商品",
      "describe_en": "Ability to apply fundamental financial and investment skills in analyzing financial and investment options"
    },
    {
      "seq": 3,
      "describe_ch": "具有能力在不同情境下，進行理財規劃與投資方式",
      "describe_en": "Ability to form a financial plan and investing approaches for different scenarios"
    },
    {
      "seq": 4,
      "describe_ch": "具有能力評估、預測、並選擇適當的投資",
      "describe_en": "Ability to evaluate, forecast and select appropriate investments"
    }
  ],
