  "description": {
    "sub_id3": null,
    "sub_name": "生成式AI應用：AI agent 開發與實作",
    "sub_ename": "APPLICATION OF GENERATIVE AI：DEVELOPMENT AND PRACTICE OF AI AGENT",
    "describe_ch": "引導學生認識與實際體驗AI agent 的規劃與實作，內容涵蓋大型語言模型 (LLM) 基礎架構、雲端應用服務以及AI agent 於真實議題落地服務的系統架構。課程中亦融入設計思考的元素，幫助學生以使用者為中心的視角，針對真實議題進行深入探討與需求分析，培養創新解決問題的能力，並將這些洞察融入AI agent的設計流程。課程將引入No Code工具，幫助學生設計簡單且實用的介面來整合LLM，並進行系統性功能模仿與優化。學生將透過實作課程來鞏固學習內容，並有機會設計與部署AI agent的應用專案。",
    "describe_eh": "The course guides students to understand and experience the planning and implementation of AI agents, covering topics such as the foundational architecture of Large Language Models (LLMs), cloud application services, and the system architecture of AI agents applied to real-world scenarios. The curriculum also incorporates elements of design thinking, enabling students to adopt a user-centered perspective for in-depth exploration and needs analysis of real-world issues. This fosters innovative problem-solving skills and integrates these insights into the AI agent design process. The course introduces No Code tools to help students create simple yet practical interfaces for integrating LLMs, enabling systematic functional imitation and optimization. Through hands-on projects, students will consolidate their learning and have the opportunity to design and deploy AI agent applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生具備人工智慧於真實議題應用與管理的能力",
      "describe_en": "Equip students with the ability to apply and manage artificial intelligence in real-world scenarios."
    },
    {
      "seq": 2,
      "describe_ch": "了解大型語言模型 (LLM) 的架構與運作",
      "describe_en": "Understand the architecture and operation of Large Language Models (LLMs)."
    },
    {
      "seq": 3,
      "describe_ch": "能根據需求進行系統化的改進，提升AI agent的效能與應用價值",
      "describe_en": "Systematically improve AI agents based on specific needs to enhance their performance and application value."
    }
