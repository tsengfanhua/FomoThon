  "description": {
    "sub_id3": null,
    "sub_name": "資訊保密與安全",
    "sub_ename": "CRYPTOGRAPHY AND DATA SECURITY",
    "describe_ch": "課程之目的在於講授資訊保密之基本觀念及技術和目前最新的資訊安全論文的研究成果。",
    "describe_eh": "The objective of this course is to introduce the basic concept of information security . With mutual interaction, students can learn the basic knowledge systematically.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "教導資訊保密的相關知識和方法。",
      "describe_en": "Understand the principles and the theories about information security"
    },
    {
      "seq": 2,
      "describe_ch": "使學生理解，資訊安全在日常生活中之重要性。",
      "describe_en": "Enable students to understand the importance of the information security technology in our daily life."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生專業知識之自我學習能力。訓練學生具有解決專業問題之能力。",
      "describe_en": "Train students the capability of self-learning professional knowledge. Train students the ability of problem solving."
    },
    {
      "seq": 4,
      "describe_ch": "使學生接觸與閱讀有關資訊保密技術的最新國際期刊論文，並能根據論文成效提出獨特之見解。訓練與培養學生口語報告之表達能力，並能清晰表達個人的思考與分析結果。",
      "describe_en": "Enable students to learn the latest information security techniques. Develop the presentation ability"
    }
  ],
