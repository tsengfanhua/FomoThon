  "description": {
    "sub_id3": null,
    "sub_name": "智慧防災與監測",
    "sub_ename": "ENVIRONMENTAL HAZARDS AND MONITORING",
    "describe_ch": "本課程首先介紹水資源系統、規畫分析及維護管理等基本概念，接著介紹水資源管理最新的學術與實務發展現況，包括氣候變遷模擬、颱風暴雨預報、土石災害潛勢分析、災害調查及觀測建系統等面向。此外，本課程同時介紹公部門之智慧水管理推動現況，以使學生具備水資源管理相關議題的基本認知，進而在智慧城市建置時得以掌握其實現歷程。",
    "describe_eh": "This course first introduces the basic concepts of water resources system, its planning analysis, and maintenance and management. The current developments of academy research and application practices will then been presented, including global warming simulation, stormwater forecast, soil hazards potential analysis, disaster investigation, and observation/monitoring system installation. Besides, this course also invites officers to explain the smart water resources management of public sector in Taiwan. This course aims to provide students with the recognition and understanding of water resources management such that they have the capabilities of controlling the development process during the construction of Smart Cities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用智慧先進科技相關知識，發掘、分析與解決防災及監測問題",
      "describe_en": "Have the ability to find and solve problems with advanced technology based on disaster prevention and monitoring."
    },
    {
      "seq": 2,
      "describe_ch": "整合先進科技之實務技術及使用計算機輔助工具應用在防災及監測領域",
      "describe_en": "Have the ability to incorporate advanced technology into practice and have the ability to use computer aided tools against disaster prevention and monitoring field."
    }
  ],
