  "description": {
    "sub_id3": null,
    "sub_name": "塗料化學",
    "sub_ename": "PAINT CHEMISTRY",
    "describe_ch": "本課程以化學為基礎，系統地介紹塗料科學的基礎理論，塗料樹脂製備與應用原理，並將理論與實際相結合。內容包括高分子合成反應機構，與塗料有關的溶劑、顏料和工業塗料之介紹。",
    "describe_eh": "This course based on chemistry, combine theory and practical application. included synthesis of resins and curing mechanism. Also, application of paint materials in industrial coatings.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解塗料組成與功能,及區分原材料的性能與規範",
      "describe_en": "What are the main ingredients of paints  and their contribution to the final properties . What should be the criteria for raw material selection"
    },
    {
      "seq": 2,
      "describe_ch": "塗料成膜機構與塗膜物性影響的因素",
      "describe_en": "What are the various curing mechanisms and its effect on end quality & properties"
    },
    {
      "seq": 3,
      "describe_ch": "工業塗料種類及如何達到塗膜保護機能",
      "describe_en": "State how to chose proper paints that are effective protection in various industrial coatings"
    },
    {
      "seq": 4,
      "describe_ch": "專業理論基礎如何導入實務應用",
      "describe_en": "To gain knowledge and expertise in the field of paint science and its applications"
    }
  ],
