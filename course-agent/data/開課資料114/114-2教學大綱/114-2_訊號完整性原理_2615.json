  "description": {
    "sub_id3": null,
    "sub_name": "訊號完整性原理",
    "sub_ename": "PRINCIPLE OF SIGNAL INTEGRITY",
    "describe_ch": "本課程將從理論與實際兩方面介紹同學各項觀念，含基本時域傳輸線理論、反射串音、有損導線雜訊分析、I/O模型、(電/光)眼圖分析、插入損失及反射損失等。",
    "describe_eh": "This course will introduce various concepts from both theoretical and practical perspectives, including fundamental time-domain transmission line theory, reflection and crosstalk, lossy transmission line noise analysis, I/O modeling, (electrical/optical) eye diagram analysis, insertion loss, and return loss.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解訊號完整性基本原理。",
      "describe_en": "To comprehend the principles of signal integrity."
    },
    {
      "seq": 2,
      "describe_ch": "能分析訊號損耗原因。",
      "describe_en": "To analyze loss issues of signal transmission."
    },
    {
      "seq": 3,
      "describe_ch": "能理解高速訊號相關之國際期刊論文並加以應用。",
      "describe_en": "To comprehend the techniques mentioned in journal papers related to high-speed signal transmission, and to apply the techniques."
    }
  ],
