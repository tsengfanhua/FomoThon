  "description": {
    "sub_id3": null,
    "sub_name": "碩士論文",
    "sub_ename": "MASTER THESIS",
    "describe_ch": "學生學習發現研究議題，並整合管理知識並擬訂研究計畫；學習資料蒐集與分析，據以提出有效的實務見解，以完成論文並通過口試。",
    "describe_eh": "  Students are able to find out research issues and apply business and management knowledge to make research plan. They integrate information technology to analyze data, then offer effective solutions in practice. Moreover, they complete their thesis and pass their master thesis examination.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
