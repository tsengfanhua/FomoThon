  "targets": [
    {
      "seq": 1,
      "describe_ch": "能運用管理相關知識於確定研究議題。",
      "describe_en": "Be able to use business and management knowledge to construct research issue."
    },
    {
      "seq": 2,
      "describe_ch": "能以書面及口頭方式將研究結果進行碩士論文口試並通過。",
      "describe_en": " Be able to use business and management knowledge to finish writing master thesis and pass their master thesis examination."
    },
    {
      "seq": 3,
      "describe_ch": "能理解研究議題具備的企業責任意涵。",
      "describe_en": "Be able to understand the implications of research on business ethics and social responsibility"
    },
    {
      "seq": 4,
      "describe_ch": "能使用資訊科技幫忙收集、分析資料，完成碩士論文。",
      "describe_en": "Using apply information technology to collect and analyze data, then write a master thesis."
    }
