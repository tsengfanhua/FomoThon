  "description": {
    "sub_id3": null,
    "sub_name": "英語教學教法",
    "sub_ename": "METHODOLOGY IN EFL TEACHING",
    "describe_ch": "發展英語教學的興趣。修習本課程的學生能夠了解使用各種英語教學方法的原則。課程的主題將包含現今英語教學領域裡討論的重點，如：英語教學的方法與技巧、學習策略、授課計劃、教學評量、教室管理、指派學習任務等主題。學生必須廣泛研讀指定教科書的範圍並參與討論。此外，學生也必須完成隨堂中之各項指定任務。",
    "describe_eh": "This course aims at helping students to develop their interest in teaching English as a foreign language. Students will understand the principles that underlie the contemporary practice of English Language Teaching (ELT), and begin to learn the application of the principles. The course topics include current issues in ELT including methodologies of teaching English, lesson planning, assessment, classroom management, the use of tasks and so on. Students are required to read the coursebook extensively before the class, and discuss in class. In addition, to complete various assigned tasks relating to the topics is needed. 　\r\n\r\n\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習語言學與英語教學相關領域的理論基礎與專業知識",
      "describe_en": "To learn knowledge and theories in the fields of linguistics, Teaching English as a Foreign Language (TEFL) and the related areas"
    },
    {
      "seq": 2,
      "describe_ch": "應用語言學與英語教學相關知識於教學實務與教材設計",
      "describe_en": "To apply the knowledge of linguistics and Teaching English as a Foreign Language (TEFL) to English Language Teaching (ELT) and course design"
    }
  ],
