  "description": {
    "sub_id3": null,
    "sub_name": "近代物理",
    "sub_ename": "MODERN PHYSICS",
    "describe_ch": "介紹愛因斯坦狹義相對論的內容；其次簡介古典物理到近代物理的發展歷程；最後解說量子論的學說與實驗發展，包括普朗克能量量子說、愛因斯坦的光電效應及康普頓效應等，然後導入量子力學的觀念與結果。",
    "describe_eh": "The classical physics and quantum concepts are considered to provide a framework for understanding the modern physics. Finally some experiments and theory of the quantum physics are then described, and followed by a discussion of the properties of wave-particle duality, which includes a look at quantum mechanics.",
    "pre_subname": "IEE1010普通物理-電、磁、光",
    "pre_sub_id3": "IEE1010",
    "pre_sub_ename": "IEE1010 GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "有近代物理的發展歷程的知識",
      "describe_en": "Knowledge for the developing history in modern physics."
    },
    {
      "seq": 2,
      "describe_ch": "能夠理解近代物理的重要原理。",
      "describe_en": "Comprehension for the importance of principle in modern physics."
    },
    {
      "seq": 3,
      "describe_ch": "能應用近代物理相關的原理於實際系統或實驗。",
      "describe_en": "To apply the related principle of the modern physics to the practical system or experiment."
    }
  ],
