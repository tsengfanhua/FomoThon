  "description": {
    "sub_id3": null,
    "sub_name": "數位通訊系統",
    "sub_ename": "  DIGITAL COMMUNICATIONS",
    "describe_ch": "本課程提供數位通訊系統的基本原理，內容主要為系統架構的介紹、基本的訊息編碼/解碼和調變/解調的形式與方法。藉由本課程得以進而學習展頻通訊系統、行動通訊系統、光電通訊、軟體無線電、射頻電路設計等相關的理論和技術。",
    "describe_eh": "The course provides fundamental principles of digital communication systems that mainly contains basic source encoding/decoding, formats and methods of digital modulation/demodulation。Following the course, theories and techniques of spread spectrum communication systems, mobile communication systems, optical communication, software-defined radio, RF circuits design can be further studied.",
    "pre_subname": "COME3001通訊系統、COME3007數位信號處理",
    "pre_sub_id3": "COME3001",
    "pre_sub_ename": "COME3001 COMMUNICATION SYSTEMS、COME3007 DIGITAL SIGNAL PROCESSING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解並使用自己的辭彙說明數位通訊的系統架構與其達成方法。",
      "describe_en": "Define digital communication systems engineering with their own words: Be able to describe important digital communication capabilities and limitations; be able to describe important environmental factors impacting digital communication performance."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明數位通訊系統工程在社會及經濟層面的重要性及影響。",
      "describe_en": "Understand and be able to explain the importance and effects of digital communication system engineering to society and economy."
    }
  ],
