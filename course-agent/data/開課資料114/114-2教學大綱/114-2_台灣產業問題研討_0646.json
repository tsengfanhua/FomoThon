  "description": {
    "sub_id3": null,
    "sub_name": "台灣產業問題研討",
    "sub_ename": "TAIWAN INDUSTRY ISSUES SEMINAR",
    "describe_ch": "本課程旨在針對台灣產業當前重要管理問題進行分析與對話，包括知識管理與複製、供應鏈整合、資源資訊系統導入、品牌經營、創新與創業精神，及企業持續發展，並引導學生將上述問題轉換為可以驗證的研究議題。",
    "describe_eh": "This course is intended to address key management issues currently Taiwan's industry analysis and dialogue, including knowledge management and replication, supply chain integration, resource information system to import, brand management, innovation and entrepreneurship, and firm sustainable development, and guide the students to convert the above topics into research questions that can be verified.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
