  "description": {
    "sub_id3": null,
    "sub_name": "財務金融數量方法",
    "sub_ename": "QUANTITATIVE METHODS IN FINANCE",
    "describe_ch": "本課程的主要目標，在於介紹常用於財務領域的數學工具，包括矩陣、線性規劃、特種分配、布朗運動、平賭過程、隨機微分方程式、選擇權評價公式等等。",
    "describe_eh": "This course plans to introduce the mathematical tools often applied in finance study. We will cover several topics, such as matrix computation, linear programming, special distributions, Brownian motion, martingale process, stochastic differential equation, option pricing formulae, and so on.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
