  "description": {
    "sub_id3": null,
    "sub_name": "灌排工程與智慧管理",
    "sub_ename": "IRRINAGE ENGINEERING AND SMART MANAGEMENT",
    "describe_ch": "灌溉與排水工程學是農業水利工程專業的一門專業課，是發展農業生產服務的學科，其主要目的是使學生掌握灌溉與排水的基本理論和灌排技術、灌溉排水系統規劃設計方法以及智慧化營運管理等。",
    "describe_eh": "To provide an understanding of irrigation and drainage engineering principles which are necessary for the successful implementation of farmland operative systems, including plan, design, evaluation and smart management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "明瞭灌排的基本理論和灌排技術\t",
      "describe_en": ".To understand the theorems and techniques of irrigation- drainage system."
    },
    {
      "seq": 2,
      "describe_ch": "執行灌溉和排水系統的評估或規劃\t",
      "describe_en": "Apply irrinage performance criteria to evalu/plan the  farmland operative system."
    },
    {
      "seq": 3,
      "describe_ch": "掌握智慧管理的方法",
      "describe_en": "\tApply GIS techniques and IOT monitoring data to operate and manage the irrinage systems."
    }
  ],
