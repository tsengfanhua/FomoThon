  "description": {
    "sub_id3": null,
    "sub_name": "能源轉換",
    "sub_ename": "ENERGY SOURCE CONVERSION",
    "describe_ch": "本課程主要說明各種能源目前使用的概況，以及各種不同形式的能源轉換成電能之技術。對於再生能源的發展及相關技術有特別的補充，培養學生具有環境保護及人文關懷的世界觀。最後，能源轉換所需主要的電機設備之工作原理作概要性的介紹。",
    "describe_eh": "This course is mainly to describe the usage of power source and the technology of energy source conversion nowadays. The development and technology of green power have particularly been enhanced to establish the ideas of environment protection and literature kind of students. Finally, the principle of the primary electrical equipments that is necessary for energy conversion is introduced conceptually.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "對各種能源之間轉換的工作原理及技術有清楚之認知。",
      "describe_en": "Know the principle and technology of energy conversion."
    },
    {
      "seq": 2,
      "describe_ch": "對各種再生能源的工作原理及技術有充分之瞭解。使用科技解決能源危機，保護自然環境。",
      "describe_en": "Understand the principle and technology of renewal resource. Solve energy danger using science and technology to protect natural environment."
    },
    {
      "seq": 3,
      "describe_ch": "對各種主要的能源轉換設備之工作原理有完整的概念。",
      "describe_en": "Have the entirely profile of energy conversion equipments."
    }
  ],
