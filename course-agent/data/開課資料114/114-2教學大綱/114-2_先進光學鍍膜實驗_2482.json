  "description": {
    "sub_id3": null,
    "sub_name": "先進光學鍍膜實驗",
    "sub_ename": "EXPERIMENTS OF ADVANCED OPTICAL COATING",
    "describe_ch": "本實驗課程目的在介紹先進光學鍍膜的製程與特性應用，課程之內容將以先進光學鍍膜做為主軸。藉由課程的介紹，使學生具備光學鍍膜應有的知識與技能，進而達到人才培育之目的。",
    "describe_eh": "This course aims to introduce the preparation process, characterizations, and applications of advanced optical coating. The content of this experimental course will focus on the optical coating with the preparation and characterizations of the related properties and then achieve the purpose of personnel training.\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解不同材料與結構之光學薄膜可能對於光學特性之影響。\t",
      "describe_en": "Understand the influences of different materials and structures on the optical properties of optical films."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉各種光學鍍膜參數對於薄膜光學特性之影響。\t",
      "describe_en": "Be familiar with the effects of various optical coating parameters on the optical properties of films."
    },
    {
      "seq": 3,
      "describe_ch": "理解光學鍍膜之製備過程與量測技術。\t",
      "describe_en": "Comprehend the preparation process and measurement technology of optical coating."
    },
    {
      "seq": 4,
      "describe_ch": "有能力分析並解釋光學特性之變化。",
      "describe_en": "\tBe able to analyze and explain changes in optical properties."
    }
  ],
