  "description": {
    "sub_id3": null,
    "sub_name": "量化資產配置",
    "sub_ename": "QUANTITATIVE ASSET ALLOCATION",
    "describe_ch": "本課程著重在應用量化方法進行資產配置與風險管理，以期有系統地進行投資組合建構、動態調整、監控與損益分析。修課同學需利用歷史資料對各種策略進行模擬測試，並在開課期間就當時市場進行監控與分析。",
    "describe_eh": "This course addresses asset allocation and risk management with Quantitative methods, especially on systematic approach to the construction, dynamic adjustment, monitor and analysis of a portfolio. And students should try to build strategies through simulations with historical data and continuously monitor its performance.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解投資組合設計原理",
      "describe_en": "Understand principles of portfolio construction"
    },
    {
      "seq": 2,
      "describe_ch": "可以設計全球性之投資組合",
      "describe_en": "Be able to design a globally diversified portfolio"
    },
    {
      "seq": 3,
      "describe_ch": "可以設計基本之定量交易策略",
      "describe_en": "Be able to construct quantitative trading strategies"
    },
    {
      "seq": 4,
      "describe_ch": "可以衡量交易策略之風險與報酬",
      "describe_en": "Be able to balance the profitability and risk of strategies"
    }
  ],
