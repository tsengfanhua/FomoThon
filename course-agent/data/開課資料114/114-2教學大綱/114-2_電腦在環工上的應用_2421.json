  "description": {
    "sub_id3": null,
    "sub_name": "電腦在環工上的應用",
    "sub_ename": "COMPUTER APPLICATIONS TO ENVIRONMENTAL ENGINEERING",
    "describe_ch": "本課程旨在教導學生認識與學習如何以電腦分析河川汙染造成之水質變化，能夠理解基本河川水理與水質反應與應用河川水質模式（qual2k）分析河川之水質分布與變化，qual2k為美國環保署認證的河川水質模式，已普遍應用於環境影響評估中河川汙染涵容能力的分析，課程包括上機實習與實際河川水質汙染的題問分析，並可以學習以excel 表格建構模型、 設定與計算。",
    "describe_eh": "This course aims at teaching students to understand and learn basic river hydraulics, water quality kinetics and changes in river/stream pollution problems and how to apply a water quality model-qual2k to assess water quality distribution and changes along river reaches. Qual2k has been certificated by USEPA for more than 20 years and popularly applied to analyze capacity of river network under pollution loading. Course materials include the basic theories and methodologies of qual2k and computer practice on river pollution problems. Excel spreadsheet is utilized for constructing river model, parameter specification and computing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習基本之河川水理與水質反應知識\t",
      "describe_en": "Understand the basic knowledge of river hydraulics and water quality kinetics"
    },
    {
      "seq": 2,
      "describe_ch": "認識電腦如何進行河川水理與水質模式的運算\t",
      "describe_en": "Understand the basic computing knowledge on river hydraulic and water quality model"
    },
    {
      "seq": 3,
      "describe_ch": "學習建立河川水理與水質模型與操作水質模式\t",
      "describe_en": "Comprehension on river hydraulic and water quality modeling"
    },
    {
      "seq": 4,
      "describe_ch": "應用於實際河川汙染問題分析\t",
      "describe_en": "Application of qual2k to actual river pollution problems and analysis these problems"
    }
  ],
