  "description": {
    "sub_id3": null,
    "sub_name": "纖維整理製程",
    "sub_ename": "TEXTILE FINISHING PROCESS",
    "describe_ch": "織物整理主要在以化學或物理之處理，改善織物之光澤、外觀、觸感、使其具較佳之穿著性，或進而具有較特殊的功能性如防火、防水、防污、抗靜電加工等，各加工之原理及方法之介紹，使學生對整理加工有基本之了解。",
    "describe_eh": "The purpose of fabric finish is to improve comfort or give additional functions of fabrics such as fireproof, waterproof, dirty preventing, and anti-static by promoting the luster, appearance, handle, and feeling of fabrics. The course introduces each finish method and provides its essential concept.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解及學習對織物整理加工之作用、目的、流程、機械",
      "describe_en": "Let the student have the basic understanding to the fabric finishing technology."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解及學習一般織物之整理加工流程、原理及方法",
      "describe_en": "Let the student have the basic understanding to the generally fabric finishing purpose、theorem、method."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解及學習特殊之織物整理加工原理流理及方法",
      "describe_en": "Let the student have the basic understanding to the exceptional fabric finishing purpose、theorem、method."
    },
    {
      "seq": 4,
      "describe_ch": "透過熟知織物整理製程原理，了解如何統整、設計各種不同功能性織物。",
      "describe_en": "Let the student realize the fabric finishing process, and how to design various functional fabric."
    }
  ],
