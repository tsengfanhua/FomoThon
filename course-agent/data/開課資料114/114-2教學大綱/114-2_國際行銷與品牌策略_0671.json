  "description": {
    "sub_id3": null,
    "sub_name": "國際行銷與品牌策略",
    "sub_ename": "INTERNATIONAL MARKETING AND BRAND STRATEGY",
    "describe_ch": "本課程介紹 國際行銷與品牌策略， 促進學生熟悉品牌建立、操作以及維護品牌權益，進而研擬出具有獲利性的品牌策略、深植厚實的品牌權益 探討國際企業面臨全球化發展下的行銷挑戰與回應。",
    "describe_eh": "This course introduces international marketing and brand strategy, promotes students to be familiar with brand establishment, operation and maintenance of brand rights, and then develops profitable brand strategies, deeply planted brand rights, and discusses the marketing of international companies facing global development challenges and responses.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
