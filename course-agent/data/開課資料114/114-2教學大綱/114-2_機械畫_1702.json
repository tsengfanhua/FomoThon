  "description": {
    "sub_id3": null,
    "sub_name": "機械畫",
    "sub_ename": "ENGINEERING DRAWING",
    "describe_ch": "本課程為「工程圖學」之延伸，旨在培養學生對於工程圖之讀圖、視圖及繪圖能力。課程內容包含基本機械工程圖繪圖知識、正投影、立體圖、尺寸標註及公差配合。",
    "describe_eh": "This course is an advanced course of \"engineering graphics\". Emphasizes the ability to develop, read, and interpret engineering drawings, sketches, and graphs. This is a course in basic drawing techniques, orthographic projection, three-dimensional pictorials, dimensioning, tolerancing and fits.",
    "pre_subname": "ENGS1003工程圖學(一)",
    "pre_sub_id3": "ENGS1003",
    "pre_sub_ename": "ENGS1003 ENGINEERING GRAPHICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得工程圖繪製之基本技能。",
      "describe_en": "To learn the basic knowledge of engineering drawing skills."
    },
    {
      "seq": 2,
      "describe_ch": "運用製圖基本學理進行電腦輔助製圖。",
      "describe_en": "To apply basic principles to drawings using a CAD program."
    },
    {
      "seq": 3,
      "describe_ch": "開發使用電腦軟體從事繪圖工作所需之技術與能力。\r\n\r\n\r\n",
      "describe_en": "To develop the skills and abilities to work with the drafting software."
    }
  ],
