  "description": {
    "sub_id3": null,
    "sub_name": "計算機概論(二)",
    "sub_ename": "INTRODUCTION TO COMPUTER(2)",
    "describe_ch": "本課程的目標在於讓學生廣泛地認識電腦科學相關的主題，概述計算機中軟體與硬體相關的基本知識。課程主要為電腦原理的介紹，及使用計算機來解決方法論與演算法的問題。　",
    "describe_eh": "The purpose of this course is to make the students know the related topics of Computer Science, and to state the knowledge of software/hardware in Computer Science. The course mainly focuses on the introduction of the computer theories, and the use of computer to solve the problems of methodology and algorithm.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生瞭解計算機運作原理以及各項影響計算機效能的關鍵技術。",
      "describe_en": "Comprehension for the computer hardware processing model and know the factors that will influence the performance of computer."
    },
    {
      "seq": 2,
      "describe_ch": "以C及C++語言的介紹為主軸，介紹現代高階語言的語法與程式設計的基本理念。",
      "describe_en": "Application for the features of modern high-level language by introducing the C and C++ language."
    }
  ],
