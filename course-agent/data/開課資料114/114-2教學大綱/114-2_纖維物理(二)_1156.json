  "description": {
    "sub_id3": null,
    "sub_name": "纖維物理(二)",
    "sub_ename": "FIBER PHYSICS(2)",
    "describe_ch": " 使學生瞭解纖維物理及高分子領域中相關化學與物理的基本概念，數學模型的建立、公式推導與計算以及在工業上之應用。其內容主要包括吸濕理論、熱力學、光學、聲學、電學、磁學及纖維與高分子的表面性質等。",
    "describe_eh": "Enable students to understand the basic concepts of the relevant chemical and physical properties, mathematic modeling and formula derivation and calculation as well as industrial applications in the field of Fiber Physics and polymer, including the theories of moisture sorption, thermodynamics, optics, acoustics, electrical, magnetic and the surface properties of fibers and polymer.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": " 理解纖維物理及高分子領域中相關物理與化學的基本概念。",
      "describe_en": " Comprehension for the basic concept of physics and chemistry properties in the field of fiber physics and polymer."
    },
    {
      "seq": 2,
      "describe_ch": " 理解數學模型的建立、公式推導與計算。",
      "describe_en": "Comprehension for mathematic modeling and formula derivation and calculation."
    },
    {
      "seq": 3,
      "describe_ch": " 理解纖維物理領域在工業上之應用。",
      "describe_en": " Comprehension for fiber physics in  industrial applications.\t"
    },
    {
      "seq": 4,
      "describe_ch": "使學生瞭解纖維物理相關領域國內外的研究現況",
      "describe_en": "Let students realize the recent national and international researches in the field of Fiber Physics."
    }
  ],
