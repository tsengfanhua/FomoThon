  "description": {
    "sub_id3": null,
    "sub_name": "人工智慧",
    "sub_ename": "INTRODUCTION TO ARTIFICIAL INTELLIGENCE",
    "describe_ch": "本課程旨在介紹人工智慧的基礎理論、核心演算法及當前熱門的AI應用技術。課程內容包含機器學習、深度學習、生成式AI等，並以Python程式語言進行實作教學，讓學生了解生活中常見AI應用背後的技術原理，奠定未來進階學習與實務應用的基礎。",
    "describe_eh": "This course is designed to introduce the fundamental theories, core algorithms, and current popular application technologies of artificial intelligence. The content covers machine learning, deep learning, and generative AI, with practical implementation using the Python programming language. Through hands-on learning, students will gain an understanding of the technical principles behind common AI applications in daily life, building a solid foundation for advanced study and practical applications in the future.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解人工智慧之發展歷程與理論基礎，掌握當前主流AI技術之核心概念。",
      "describe_en": "Understand the historical development and theoretical foundations of artificial intelligence, and grasp the core concepts of mainstream AI technologies."
    },
    {
      "seq": 2,
      "describe_ch": "能運用Python語言實作各類人工智慧演算法，提升實務應用能力。",
      "describe_en": "Apply the Python programming language to implement various AI algorithms and enhance practical application skills."
    },
    {
      "seq": 3,
      "describe_ch": "能解析生活中常見AI應用產品之技術原理，理解其背後所使用的AI模型與方法。",
      "describe_en": "Analyze the technical principles behind common AI-based products and understand the underlying models and methods."
    },
    {
      "seq": 4,
      "describe_ch": "能將AI技術應用於機械工程相關領域之問題解決，如製程優化、預測維護與自動控制。",
      "describe_en": "Apply AI technologies to solve problems in mechanical engineering fields, such as process optimization, predictive maintenance, and automatic control."
    },
    {
      "seq": 5,
      "describe_ch": "能培養跨領域思維結合AI與機械專業知識開發創新應用。",
      "describe_en": "Cultivate interdisciplinary thinking skills to integrate AI with mechanical expertise for innovative applications."
    }
  ],
