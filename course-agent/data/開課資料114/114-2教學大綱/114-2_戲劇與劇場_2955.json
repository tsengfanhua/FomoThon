  "description": {
    "sub_id3": null,
    "sub_name": "戲劇與劇場",
    "sub_ename": "DRAMA AND THEATER",
    "describe_ch": "這門課將是一門從問題出發的課程，沒有標準答案，但是卻有脈絡可循。\n1.戲劇的起源從何而來?儀式、歡愉、勞動、傳播嗎? 將從以上溯源著手，逐漸發展為成熟的商業演出市場。\n2.戲劇如何發展為一門綜合藝術?\n3.劇場如何由戶外空間走進劇場?又如何從劇場走回公共空間?\n4.戲劇與劇場之間到底存在什麼關係？\n5. 20世紀戲劇與表演的情況到底是怎樣的？\n6. 21世紀戲劇與表演又會有什麼新的發展可能？",
    "describe_eh": "This course will be a question-based course. There are no standard answers, but there are contexts to follow.\n1. Where does the origin of drama come from, ceremony, joy, labor, or dissemination? The course starts from the above sources and will gradually develop into a mature commercial performance industry.\n2. How did drama develop into a collaboration and collective art?\n3. How does the theater enter the theater from the outdoor space? How does it go back to the public space from the theater?\n4. What is the relationship between drama and theatre?\n5. What was the state of drama and performance in the 20th century?\n6. What new development possibilities will there be for drama and performance in the 21st century?",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "由劇場的觀演與接收的方法建立溝通與表達能力。",
      "describe_en": "The ability to communicate and express is established by the method of viewing and receiving in the theatre"
    },
    {
      "seq": 2,
      "describe_ch": "藉由戲劇行動來建立個人自信心和團體合作力與達成做中學的目標。",
      "describe_en": "Through dramatic action to build individual self-confidence and teamwork and achieve the goal of learning by doing."
    },
    {
      "seq": 3,
      "describe_ch": "透過應用戲劇的策略開拓聆聽力、公共對談和預演未來的可能性。",
      "describe_en": "Explore the possibilities of listening, public dialogue, and previewing the future through the use of dramatic strategies."
    }
  ],
