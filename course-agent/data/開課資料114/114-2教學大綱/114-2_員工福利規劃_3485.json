  "description": {
    "sub_id3": null,
    "sub_name": "員工福利規劃",
    "sub_ename": "EMPLOYEE BENEFIT PLANNING",
    "describe_ch": "本課程主要在了解員工福利的內容公司如何訂定員工福利的目標來針對不同職位員工給予最佳的員工福利, 以促使企業招攬人才並留住人才,所以內容主要探討團體保險與退休金各項福利制度, 並最後探討稅惠的制度。",
    "describe_eh": "Objectives: Definition of employee benefits, and what are the employer's objectives; who should receive benefit? What type of benefits should be provided in the plan? Determining needs? Finally, Considering tax advantages and legislation.",
    "pre_subname": "INSU1001保險學",
    "pre_sub_id3": "INSU1001",
    "pre_sub_ename": "INSU1001 INSURANCE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解企業風險管理的重要性",
      "describe_en": "To understand the important of enterprise risk management"
    },
    {
      "seq": 2,
      "describe_ch": "能應用於規劃企業員工福利",
      "describe_en": "Applying to plan the employee benefit of enterprise"
    },
    {
      "seq": 3,
      "describe_ch": "學生能理解職業倫理道德",
      "describe_en": "Understanding the business ethics"
    }
  ],
