  "description": {
    "sub_id3": null,
    "sub_name": "成像系統實務",
    "sub_ename": "PRACTICAL IMAGING SYSTEM",
    "describe_ch": "本課程利用光學軟體介紹光學設計的基礎知識和像差理論，並緊密結合當前各應用領域的最新的一些光學系統。課程內容基本上可以分為4個部分。第1部分是光學系統的像質評價，第2部分是光學自動設計的原理與程序與經典光學例子介紹。第3部分是介紹鏡片製程與設計上的材料選用。第4部分是光學系統的公差分析與計算。",
    "describe_eh": "The course introduces optical design and the theory of aberration by using optics softwares, which is closely related to the modern optical system. The content includes (1) The assessment of image quality of optical systems, (2)The optimization process and methods in optical design by using the classic examples of an optical system, (3) Lens manufacturing process and the selection of suitable lens material for an optical system, (4) The tolerance analysis of an optical systems.",
    "pre_subname": "OPT2001光學(一)、OPT2002光學(二)",
    "pre_sub_id3": "OPT2001",
    "pre_sub_ename": "OPT2001 OPTICS (1)、OPT2002 OPTICS (2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "光學系統的像質評價。",
      "describe_en": "Assessment of image quality of optical systems."
    },
    {
      "seq": 2,
      "describe_ch": "光學自動設計的原理。",
      "describe_en": "Optimization methods in optical design."
    },
    {
      "seq": 3,
      "describe_ch": "鏡片製程與設計上的材料選用。",
      "describe_en": "Lens manufacturing process and how to start by choosing suitable lens material for the optical system."
    },
    {
      "seq": 4,
      "describe_ch": "光學系統的公差分析。",
      "describe_en": "The tolerance analysis of the optical systems."
    }
  ],
