  "description": {
    "sub_id3": null,
    "sub_name": "商業數據分析",
    "sub_ename": "BUSINESS DATA ANALYTICS",
    "describe_ch": "本課將介紹基本資料整理、描述與檢定方法，並配合相關Excel、SAS或SPSS等套裝軟體之運用；內容含調查資料常用之商業統計資料探查方法並著重於軟體之應用及報表的解讀。",
    "describe_eh": "This course introduces some basic methodologies in data collection/organization, descriptive statistics and hypothesis testing as well as empirical applications using statistical software packages such as Excel, SAS, and SPSS. This course emphasizes on the use of statistical software packages to analyze and interpret business data. Technique and data used for the business analytics will be introduced for practical applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用統計套裝軟體製作統計圖表並能由圖表具體說明商業數據特性",
      "describe_en": "Use statistical software packages to produce proper statistical tables and graphs for the purpose of interpreting the business data."
    },
    {
      "seq": 2,
      "describe_ch": "理解各統計分析方法的適用時機",
      "describe_en": "Identify the adequate situation to properly use various statistical methods."
    },
    {
      "seq": 3,
      "describe_ch": "應用統計套裝軟體進行商業數據分析，並寫出一份完整報告",
      "describe_en": "Make use of statistical software package to analyze business data and write a comprehensive statistical analysis report."
    }
  ],
