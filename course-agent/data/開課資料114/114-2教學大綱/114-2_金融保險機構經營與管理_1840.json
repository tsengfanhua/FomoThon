  "description": {
    "sub_id3": null,
    "sub_name": "金融保險機構經營與管理",
    "sub_ename": "FINANCIAL INSTITUTIONS MANAGEMENT",
    "describe_ch": "課程著重於金融保險機構之風險管理，主要內容包括：金融市場與金融機構、利率風險之衡量與管理、市場風險之衡量與管理、流動性風險的衡量與管理、外匯風險的衡量與管理、銀行監理與存款保險。",
    "describe_eh": "This course focuses on the risk analysis and risk management of financial institutions and insurance companies. Topics include the introduction of financial institution operations, measurement and management interest risk, market risk, liquidity risk, and foreign risk. It also includes bank regulations and deposit insurance.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
