  "description": {
    "sub_id3": null,
    "sub_name": "精密光學量測",
    "sub_ename": "PRECISION OPTICAL TESTING",
    "describe_ch": "本課程介紹幾種精密光干涉儀的架構與工作原理，並說明如何使用它們量測平面、曲面、尺寸、位移、表面上或表面下的微結構。",
    "describe_eh": "This course introduces the architecture and principle of several high-precision optical interferometers. We will also discuss how these interferometers are applied to measure optical flat, spherical and aspherical surface, as well as microstructure on or beneath the surface.",
    "pre_subname": "OPT6004物理光學、OPT6003幾何光學",
    "pre_sub_id3": "OPT6004",
    "pre_sub_ename": "OPT6004 PHYSICAL OPTICS、OPT6003 GEOMETRICAL OPTIC",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠知道干涉儀的應用和限制。",
      "describe_en": "Be able to know the applications and the limitations of the interferometers."
    },
    {
      "seq": 2,
      "describe_ch": "能夠分析干涉條紋。",
      "describe_en": "Be able to analyze the interference fringes."
    },
    {
      "seq": 3,
      "describe_ch": "能夠設計干涉儀。",
      "describe_en": "Be able to design the interferometers."
    },
    {
      "seq": 4,
      "describe_ch": "能以小組方式進行光學量測相關專案。",
      "describe_en": "Be able to work as a team to solve optical measurement problems."
    }
  ],
