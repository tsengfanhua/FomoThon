  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "PC88100",
    "sub_id": "62018",
    "scr_dup": "001",
    "sub_title": "「如果音樂可以被視為流動的建築，那建築便是凝凍的音樂」..............是這兩個分別掌管空間與時間兩大領域最具代表性的藝術常被交互比喻的說法。一個是透過視覺喚醒我們的身體經驗，一個則是藉由聽覺撩動我們內心的情緒風景，這兩種截然不同的藝術之間，究竟有何值得我們認識與探索的知識祕境？\n期待同時也竭誠歡迎有興趣且具備冒險精神的你，有機會共同參與本課程，一起步上從這兩個藝術形式的本質初探，代表人物及作品的聆賞與導析，異質觀點的對話及跨域創作賞析交互激盪的方式，開拓超越單一領域視野的人文素養，引領學習者穿梭在時空交織的人文思辨之間，展開廣域且創新的文化認知與探索的另類學習歷程。",
    "sub_title_en": null,
    "sub_describe": "課程說明摘要版:https://drive.google.com/file/d/1SktdYsVt8BLMkJZooUW5kiq1DRHxCzid/view?usp=sharing",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "當音樂遇上建築",
    "sub_ename": "INSPIRATION OF MUSIC AND ARCHITECTURE\r",
    "describe_ch": "「如果音樂可以被視為流動的建築，那建築便是凝凍的音樂」...是這兩個分別掌管空間與時間兩大領域最具代表性的藝術常被交互比喻的說法。一個是透過視覺感官帶來喚醒我們的身體經驗，一個則是藉由聽覺撩動我們內心的情緒風景，這兩種截然不同的藝術之間究竟有何值得我們認識與探索的知識祕境？\r\n本課程擬藉由從這兩個藝術形式的本質初探，代表人物及作品的聆賞與導析，異質觀點的對話及跨域創作賞析交互激盪的方式，開拓超越單一領域視野的人文素養，引領學習者穿梭在時空交織的人文思辨之間，展開廣域且創新的文化認知與探索的另類學習歷程。\r\n",
    "describe_eh": " “Architecture Is Music In Space, As It Were A Frozen Music” is often used metaphor for describing these two arts, which are respectively in charge of space and time. One is to awaken our physical experience through visual senses, and the other is to arouse our inner emotional scenery through listening. What is the unrevealed territory of knowledge between these two completely different arts that we could and should unfold?\r\nThis course intends to explore the essence of these two art forms, introduce several key figures and works, induce dialogues among heterogeneous viewpoints by conducting a series of interdisciplinary appreciation and interaction, so as to develop humanistic literacy beyond a single field of vision, and lead Learners shuttle between the intertwined interpretation and understanding of time and space and carry out an alternative learning process with boundary-breaking and creative cultural cognition and exploration.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識建築與音樂兩大藝術的本質",
      "describe_en": "Understand the essence of the arts of architecture and music"
    },
    {
      "seq": 2,
      "describe_ch": "建立建立跨領域視野的人文素養",
      "describe_en": "Establish humanistic literacy with a cross-disciplinary perspective"
    },
    {
      "seq": 3,
      "describe_ch": "培育具備創新觀點的文化人格",
      "describe_en": "Cultivate cultural citizens with innovative cultural awareness"
    }
  ],
