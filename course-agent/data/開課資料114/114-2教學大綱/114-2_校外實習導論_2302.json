    {
      "seq": 1,
      "describe_ch": "強化職場專業技能，具備協調溝通與團隊合作之能力",
      "describe_en": "To strengthen the professional skills and improve competencies of communication and teamwork."
    },
    {
      "seq": 2,
      "describe_ch": "具備終身學習與土地倫理基本素養\t",
      "describe_en": "To possess the acquirement of life-long learning and land ethics."
    }
