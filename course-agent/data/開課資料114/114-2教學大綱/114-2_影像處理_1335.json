  "description": {
    "sub_id3": null,
    "sub_name": "影像處理",
    "sub_ename": "IMAGE PROCESSING",
    "describe_ch": "按學生個別化教授，隨時雙向溝通，以達讓學生能夠以結構化及物件化方式學習。課程之目的在於講授電子影像之實務處理技術及目前最新穎影像論文的研究與探討。",
    "describe_eh": "The objective of this course is to introduce the concept of digital image processing . With mutual interaction, students can learn the basic knowledge systematically.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解影像處理的相關知識原理、方法和影像術語等專有知識。",
      "describe_en": "Understand the principle and the theory referred to image processing"
    },
    {
      "seq": 2,
      "describe_ch": "提供學生專業能力的思考空間與解決能力",
      "describe_en": "Train students the ability of problem solving"
    },
    {
      "seq": 3,
      "describe_ch": "使學生接觸與閱讀國際期刊論文，了解科技論文的寫作方式。並能根據論文成效提出獨特的見解。",
      "describe_en": "Enable students to learn the skill of technical writing by reading and presenting international journal papers"
    },
    {
      "seq": 4,
      "describe_ch": "訓練與培養學生報告之表達能力，並能清晰表達個人的思考與分析結果。",
      "describe_en": "Develop the presentation and analysis ability"
    }
  ],
