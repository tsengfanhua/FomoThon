  "description": {
    "sub_id3": null,
    "sub_name": "演算法在生產排程之應用",
    "sub_ename": "APPLICATION OF ALGORITHMS IN PRODUCTION SCHEDULING",
    "describe_ch": "派工法則和演算法被廣泛應用於解決排程問題，有效的排程方法可以提升工廠的生產效率，減少機台閒置時間，增加產量，從而實現減少延遲出貨時間並增加利潤的目標。本課程的主要目標是教導學生如何應用派工法則和演算法來解決不同環境下的排程問題。",
    "describe_eh": "Dispatching rules and algorithms are widely used to solve scheduling problems. Effective scheduling methods can enhance production efficiency, reduce machine idle time, increase output, reduce tardy jobs and increase profits. The main purpose of this course is to teach students how to apply dispatching rules and algorithms to solve scheduling problems in various environments.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠講解排程領域有關之理論、技術與實務應用",
      "describe_en": "Be able to explain theories and practical applications related to the field of scheduling."
    },
    {
      "seq": 2,
      "describe_ch": "能夠瞭解並說明生產排程在企業流程及策略面的重要性及影響",
      "describe_en": "Be able to understand and explain the importance of scheduling on business processes and strategies."
    },
    {
      "seq": 3,
      "describe_ch": "能運用各式派工法則及運算法解決多種排程問題",
      "describe_en": "Be able to use dispatching rules and algorithms to solve a variety of scheduling problems"
    },
    {
      "seq": 4,
      "describe_ch": "能以書面或口頭方式將想法與同儕及教師討論溝通",
      "describe_en": "Be able to discuss and communicate ideas with classmates and teacher."
    }
  ],
