  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CS06129",
    "sub_id": "48815",
    "scr_dup": "001",
    "sub_title": "量子力學導論之核心概念建構與基礎應用探究",
    "sub_title_en": null,
    "sub_describe": "本研究主題以「量子力學導論」課程為核心，聚焦於學生對量子力學基本概念、數學形式與物理意義之理解與建構，並透過基礎模型與簡易應用，協助學生由經典物理思維順利銜接至量子力學的抽象描述。\n\n研究內容涵蓋量子力學中的關鍵主題，包括：\n波函數與機率詮釋、算符與本徵值問題、測量與不確定性原理、量子態疊加與時間演化，以及簡單量子系統（如一維位能井、量子簡諧振子等）的物理分析。課程設計強調物理意義的理解與數學工具的連結，避免學生僅停留於公式操作，而忽略其背後的物理圖像。\n\n此外，本研究亦適度引入量子力學在現代科技中的基礎角色，例如量子電腦科技與量子資訊的初步概念，使學生能理解量子力學不僅為理論學科，更是支撐現代科技發展的重要基礎。透過循序漸進的課程安排與例題解析，本研究期望提升學生對量子力學的學習動機、概念掌握度與後續進階課程之學習準備度。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "量子力學導論",
    "sub_ename": "INTRODUCTION TO QUANTUM MECHANICS",
    "describe_ch": "本課程是為銜接近代物理和更進階的量子力學相關課程而設置。我們將簡要回顧量子物理的發展，隨後課程內容包含：薛丁格波動力學架構、量子力學算符方法、角動量算符、三維庫侖位能場、矩陣算符與電子自旋、微擾理論與量子力學應用。",
    "describe_eh": "This course is intended to be a bridge between Modern Physics and the more advanced classes related to Quantum Mechanics\r\nThe lecture will start with a brief review on the early development of Quantum Physcis, followed by topics such as Wave Mechanics of Schr?dinger, operator methods in quantum mechanics, angular momentum operator, 3D coulomb potential. Matrix representation and electron spin, perturbation theory and its application.\r\n",
    "pre_subname": "PHYS2005近代物理、PHYS1004普通物理(二)",
    "pre_sub_id3": "PHYS2005",
    "pre_sub_ename": "PHYS2005 MODERN PHYSICS、PHYS1004 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解量子物理的基本物理概念、數學方法、及其和進階領域(如雷射、光譜、固態、光化學、奈米科技…等)課程的關聯性。",
      "describe_en": "Understanding fundamental physics concepts and mathematical methods and their relationships withmore advanced courses in the areas of laser, spectroscopy, solid states, photochemistry, nano technology, etc."
    },
    {
      "seq": 2,
      "describe_ch": "培養搜尋、閱讀國外媒體最新科學報導的能力。",
      "describe_en": "Being able to search and read the latest science reports from the global media."
    },
    {
      "seq": 3,
      "describe_ch": "透過分組作業培養團隊合作精神及有效溝通能力。",
      "describe_en": "To develop team spirit and the ability of efficient communication through teamwork."
    }
  ],
