  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "精密光學製造技術",
    "sub_ename": "PRECISION OPTICAL MANUFACTURING TECHNOLOGY",
    "describe_ch": "本課程促進學生對於精密光學製造技術之了解，培養實務經驗並印證相關光學理論，課程重點為介紹光電領域中必備的專業知識及相關技術應用，課程內容包含光學材料特性、光學元件加工、研磨與拋光、光學鍍膜、光學檢測等。",
    "describe_eh": "This course is for students to understand the precision optical manufacturing technology, training operation and practical experience to verify optical theory. The goal of the course will provide and introduce the manufacture technique of high-precision optics components, such as optical materials, device fabrication, grinding and polishing, thin film coatings, optical shop testing etc.",
    "pre_subname": "EEEN6003物理光學",
    "pre_sub_id3": "EEEN6003",
    "pre_sub_ename": "EEEN6003 PHYSICAL OPTICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 7,
      "describe_ch": "能夠理解精密光學製造技術的基本觀念。",
      "describe_en": "Comprehension for the basic concepts in precision optical manufacturing technology."
    },
    {
      "seq": 8,
      "describe_ch": "能應用精密光學製造技術於實際系統。",
      "describe_en": "To apply the precision optical manufacturing technology in a practical system."
    },
    {
      "seq": 9,
      "describe_ch": "能分析精密光學製造技術相關議題的資訊以完成一份個案研究報告。",
      "describe_en": "Analysis for the information of the related issues about precision optical manufacturing technology to finish a case study report."
    }
  ],
