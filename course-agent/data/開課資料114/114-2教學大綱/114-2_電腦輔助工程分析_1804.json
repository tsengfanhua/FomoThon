  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE26120",
    "sub_id": "54061",
    "scr_dup": "001",
    "sub_title": "結構分析的基礎邏輯：連結基礎力學與 FEM 模擬",
    "sub_title_en": null,
    "sub_describe": "A.模型初始化 - 材料力學\n探討如何運用「材料力學」的原理，對複雜的真實結構進行合理的「簡化」。\nB.邊界條件設定 - 靜力學\n運用「靜力學」的知識，判斷與設定模型的「初始條件」與「邊界條件」。\nC.結果驗證 - FEM \n使用 FEM（SolidWorks Simulation）進行分析。其目的除了求得答案，另外要「驗證」基於靜力學與材料力學所做的「初始假設」與「簡化模型」是否成立。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "電腦輔助工程分析",
    "sub_ename": "COMPUTER-AIDED ENGINEERING",
    "describe_ch": "本課程旨在探討電腦輔助工程技術在結構分析上的應用，課程內容包括有限元素法基礎觀念：勁度、柔度矩陣，一維及二維元素理論架構推導、殘餘權重法、插值函數概念、並輔以電腦實作，以相互此對驗證。",
    "describe_eh": "This course discusses the applications of computer-aided techniques in structural analysis. The topics include the basic theory of the finite element method : Direct Stiffness Method and Flexibility Method. Introducing of basic finite element shapes in one and two dimensions, Weighted Residual Method. And using computer to verify the theoretical results.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂電腦輔助工程分析。",
      "describe_en": "Define\"computer-aided engineering\" using their own words."
    },
    {
      "seq": 2,
      "describe_ch": "能辨識出可應用電腦輔助工程分析的場合，並能清楚表達。",
      "describe_en": "Distinguish and make clear statement where principles of computer-aided engineering can be applied."
    },
    {
      "seq": 3,
      "describe_ch": "學習應用有限元素法於結構的模擬分析。",
      "describe_en": "Learn to utilize finite element method in the analysis of structural systems."
    },
    {
      "seq": 4,
      "describe_ch": "能以書面或口頭方式將所獲結果與同儕、助教及教師溝通。",
      "describe_en": "Present results in written or oral form to classmates, teaching assistants, and the instructor."
    }
  ],
