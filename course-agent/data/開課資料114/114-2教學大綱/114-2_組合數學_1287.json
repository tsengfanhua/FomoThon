  "description": {
    "sub_id3": null,
    "sub_name": "組合數學",
    "sub_ename": "COMBINATIONAL MATHEMATICS",
    "describe_ch": "教導學生在離散方法及組合推理上的觀念及技巧；涉及圖論基本概念、基本的技術方法、生成函數模型、遞迴關係模型、容斥原理等理論與應用",
    "describe_eh": "To introduce the students to the topics and techniques of discrete methods and combinatorial reasoning. We will discuss the concept and application about graph theory, counting methods, generating functions, and recurrence relations in this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
