  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "XA01101",
    "sub_id": "97590",
    "scr_dup": "001",
    "sub_title": "本課程在介紹泰語發音與泰文書寫規則，並以主題式教學，使學生能學習泰語的基礎語法及語音，也能了解泰國的歷史及文化。",
    "sub_title_en": null,
    "sub_describe": "本課程從零基礎開始，文字和會話並重。文字方面從介紹泰文數字出發，搭配語音學知識介紹泰語聲母與韻母。會話方面搭配《大家來學泰語》主題式對話，介紹相互問候等生活用語，補充語境讓學習者充分練習。內容方面有：\n(一)簡介泰語與華語的異同；                 (二)介紹泰文聲母及韻母及拼音的規則；\n(三)介紹相互問候、自我介紹的對話；   (四)介紹泰國的文化與禁忌。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "泰語(一)",
    "sub_ename": "THAI(1)",
    "describe_ch": "泰語(一)擬針對從未修習泰語的初學者，提供泰語字母發音、基礎詞彙和語法結構的訓練，並著重於口語能力和聽力技巧。本課程包括發音課程和會話課程，所有課程主題皆會提供必備單字，幫助學習者能夠使用泰語跟泰國人交談。每堂課將會藉由視覺影音教具以模擬生活會話內容。本課程修畢後，學生將能使用泰語進行自我介紹、談論自身興趣和相關生活活動。",
    "describe_eh": "Thai (1) is for learners who have never learned the Thai. This level offers training in basic Thai pronunciation with elementary vocabulary and grammatical structures, and is strongly focused on speaking and listening skills. Thai (1) includes lessons in pronunciation and conversation. Necessary vocabulary is provided for all topics to help learners converse in Thai with Thai speakers. Classroom conversations are simulated with visual media aids. After finishing Thai (1), the students should be able to use Thai to introduce themselves and talk about general interests and activities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
