  "description": {
    "sub_id3": null,
    "sub_name": "商業智慧",
    "sub_ename": "BUSINESS INTELLIGENCE",
    "describe_ch": "近年來，商業智慧被視為協助企業管理者在決策支援並維持企業永續價值的重要技術。本課程介紹商業智慧趨勢的基礎概念及技術，從管理需求及尖端企業智慧科技的瞭解與應用來進一步了解資料轉換成知識與其價值的過程，以及商業智慧的價值及未來發展趨勢。",
    "describe_eh": "Business intelligence has been recognized as a successful enabling technology to support business managers’ better business decision-making and get valuable insights. BI analyzes and applies historical and current data of organizations and transforms them to information, knowledge, decisions and finally actions. This course will provide an understanding of the theory and applications of the use of leading-edge BI technologies and processes used in transforming data to knowledge and value.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解商業智慧的基本觀念及在企業活動中的各種決策支援活動。",
      "describe_en": "Understand the fundamental principles and concepts involved in various activities in business intelligence and decision support."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解各種應用於商業智慧的的決策支援系統、工具及技術。",
      "describe_en": "Understand the techniques and tools for developing business intelligence and decision support systems."
    },
    {
      "seq": 3,
      "describe_ch": "探討商業智慧創新的典範，以瞭解其在企業相關決策支援與活動上的實務應用。",
      "describe_en": "Survey the best practices of Business Intelligence to Gain practical experience about deployment of business intelligence for decision support in industry and business."
    }
  ],
