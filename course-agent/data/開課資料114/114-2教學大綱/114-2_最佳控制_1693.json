  "description": {
    "sub_id3": null,
    "sub_name": "最佳控制",
    "sub_ename": "OPTIMAL CONTROL",
    "describe_ch": "介紹基於連續與離散系統之最佳控制設計方法，其內容包括基本數學理論分析、變分法、數值搜尋法、線性二次調節器、動態規畫、模型預估控制及Pontryagin最大值定理等，並包含許多範例與理論應用。我們強調數理分析與設計能力，讓學生能透過基礎的最佳控制理論進而擴展至複雜的最佳控制問題設計，並進一步能導入未來相關研究或實務應用設計。",
    "describe_eh": "This course studies basic optimization and the principles of optimal control methods for both discrete and continuous systems. The course includes: mathematical preliminary, variational calculus, numerical search algorithms, linear quadratic regulator, dynamic programming, model predictive control, and approaches based on Pontryagin's maximum principle, and it includes many examples and applications of the theory. We highlight mathematical analysis and design capacity, and then extended to the complex optimal control problem. Furthermore, the students can be readily extended to future research and practical design and application.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解何謂最佳化問題、數值搜尋法",
      "describe_en": " Introduction of the optimization problems and numerical search methods"
    },
    {
      "seq": 2,
      "describe_ch": "學習變分法及最大最小原理介紹、離散與連續動態系統之最佳控制設計、線性二次調節器",
      "describe_en": "Learn variational calculus, min-max principle, optimal control of discrete-time and continuous-time systems, linear quadratic regulator."
    },
    {
      "seq": 3,
      "describe_ch": "最佳控制系統之穩定性分析、動態規畫與模型預估控制。",
      "describe_en": "Learn stability analysis for the optimal control problem, dynamic programming and model predictive control."
    },
    {
      "seq": 4,
      "describe_ch": "透過書面及口頭方式進行期末報告",
      "describe_en": "Final report in written and oral form."
    }
  ],
