  "description": {
    "sub_id3": null,
    "sub_name": "地下水與模式應用",
    "sub_ename": "GROUNDWATER HYDROLOGY AND MODEL APPLICATION",
    "describe_ch": "瞭解地下水的產生與流動原理，地下水資源的開發、利用、管理與保育的各種技術與基礎知識。主要內容包括：（a）地下含水層之物理特性（b）地下水流動原理與計算（c）基本水井公式與參數檢定（d）區域流網繪製（e）地下水與其他水文系統之關係（f）未飽和含水層（g）溶質傳輸原理。",
    "describe_eh": "To understand the occurrence and flow principle of subsurface flow, knowledge and technology in groundwater resources development, management, and conservation. Major contents including (a) aquifer properties, (b) flow principle, (c) well formula and parameter calibration, (d) regional groundwater flow,(e) relation with surface hydrology, (f) unsaturated zone, (g) solute transport in subsurface flow.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": " 體會地下水流的特性以及與地表水的差異 \t",
      "describe_en": "1. Understand the difference between groundwater and suface water"
    },
    {
      "seq": 2,
      "describe_ch": ".\t能用現代工具估算地下水的流場\n",
      "describe_en": "2.\tCan use model technology to estimate groundwater flow field"
    },
    {
      "seq": 3,
      "describe_ch": ".\t能利用水井公式來推估含水層特性\n",
      "describe_en": "3\tCan use well function to estimate aquifer characteristics"
    }
  ],
