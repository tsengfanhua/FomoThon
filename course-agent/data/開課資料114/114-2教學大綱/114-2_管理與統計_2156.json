  "description": {
    "sub_id3": null,
    "sub_name": "管理與統計",
    "sub_ename": "APPLIED STATISTIC INMANAGEMENT PRACTICE",
    "describe_ch": "本課程著重統計觀念應用而非強調數學與理論的發展。學生修習本課程，將學習統計知識如何應用到企業管理實務，讓學生對統計事件有正確判斷能力。此外，本課程會引用案例來說明企業管理者如何運用統計分析進行決策。",
    "describe_eh": "The course gives an introduction of statistical application, not mathematics or theoretical development. Having completed this course, students will learn the fundament concepts of statistical analysis to practical business problem, and they will be trained to understand correctly statistical events from a statistical perspective. Moreover, selection of case studies will be included as well to assist managers’ decision in this class.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解統計方法基本概念與企業活動的關係。",
      "describe_en": "Understand the fundamental principles involved in various business activities in enterprise management."
    },
    {
      "seq": 2,
      "describe_ch": "將統計分析方法應用在企業管理實務上。",
      "describe_en": "To apply the statistical analysis method into practical business management."
    }
