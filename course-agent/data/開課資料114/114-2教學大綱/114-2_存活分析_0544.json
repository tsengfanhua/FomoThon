  "description": {
    "sub_id3": null,
    "sub_name": "存活分析",
    "sub_ename": "SURVIVAL ANALYSIS",
    "describe_ch": "本課程主要是介紹一些基本知識和觀念給學生。主題包含存活函數與危險函數、存活資料之常用參數的模型、左右缺或區間缺、存活的估計與累積危險函數、存活函數的信賴區問",
    "describe_eh": "The main purpose of this course is to introduce some basic knowledge and concepts to the students. Topics covered in this course include Survival Function and Hazard Function, Common Parametric Modelfor survival Data, Right, Left or Interval Censoring, Truncation, Estimation of the Survival and Cumulative Hazard Function, Confidence Interval for the Survival Function.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養學生理解並應用存活分析之基本概念與方法，提升醫學與生物統計研究之能力。",
      "describe_en": "To cultivate students’ understanding and application of the fundamental concepts and methods of survival analysis, enhancing their abilities in medical and biostatistical research."
