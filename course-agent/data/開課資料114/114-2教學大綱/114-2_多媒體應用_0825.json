  "description": {
    "sub_id3": null,
    "sub_name": "多媒體應用",
    "sub_ename": "MULTIMEDIA  APPLICATION",
    "describe_ch": "藉助現有技術以作為各領域應用之基礎，已成為資訊時代下，個人必要的背景知識與技能。本課程以建築應用為前提，利用專業之影音處理媒材，輔導學生應用電腦媒體呈現作品，並進一步提升個人對建築空間的敏感度及都市環境觀念。",
    "describe_eh": "The applications of digital medias have become a very important skill in design process of architecture. There are three main issues will be explored in this course. A. Urban ObservationB. Scenario DevelopmentC. Network Publication",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": " 能夠定義「多媒體應用」的意涵，瞭解國際間有關的「數位傳達」議題及其重要性。",
      "describe_en": ". Define the meaning of \"multi-media\" and know international issues about \"communications of digital media.\""
    },
    {
      "seq": 2,
      "describe_ch": "能表達目前國內數位建築體系的內容與評估要項",
      "describe_en": "Express the policy and contents of the \"Digital Architecture\" and the \" Digital Media Evaluation System\" in Taiwan."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解多媒體應用就「觀念」、「設計」、「製作」與「表現」四個面向可應用於室內景觀設計的實質內容。",
      "describe_en": "Comprehend computer  techniques which include four aspects: concept, design, production and application. Know the contents of these techniques"
    },
    {
      "seq": 4,
      "describe_ch": "能應用習得之電腦技術於室內景觀設計之中，培養數位設計之積極態度",
      "describe_en": "Know how to apply digital techniques in indoor environment and landscape. Develop active attitude toward digital design."
    },
    {
      "seq": 5,
      "describe_ch": "能應用多媒體，評估室內環境景觀的品質良窳，並提出改善對策",
      "describe_en": "Apply learned digital concepts and skills to evaluate indoor environment, and try to promote appropriate strategy."
    },
    {
      "seq": 6,
      "describe_ch": "能以3D圖像或動畫影片方式將所獲結果與同儕、助教及教師溝通",
      "describe_en": "Communicate results in 3D drawings or animations to classmates and the instructor."
    }
  ],
