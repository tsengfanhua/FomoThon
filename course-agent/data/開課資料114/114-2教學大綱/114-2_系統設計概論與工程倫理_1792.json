  "description": {
    "sub_id3": null,
    "sub_name": "系統設計概論與工程倫理",
    "sub_ename": "INTRODUCTION TO SYSTEM DESIGN AND ENGINEERING ETHICS",
    "describe_ch": "對新產品開發流程、工程倫理進行教育，使學生瞭解技術者的責任和倫理規範及如何使用系統設計的技法有效將使用者需求轉換成技術開發的流程，以滿足功能及性能的產品。以知識傳授及案例說明之方式，引導學生學習。",
    "describe_eh": "The course is an education in new product development system design & engineering ethics in lecture。Students learn the responsibility & ethics norm of engineer and know how to transfer the user requirement into the technology development for user needs using effective system design skill.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解技術者的倫理觀、系統設計的基本原理及方法，並能應用於新產品的開發。",
      "describe_en": "To understand the engineer ethics and system design principle & procedure in new product development."
    },
    {
      "seq": 2,
      "describe_ch": "具有新產品開發之系統設計，分析，整合的技能。",
      "describe_en": "The skill for new product development in system design、analysis、and integration."
    },
    {
      "seq": 3,
      "describe_ch": " 能夠選用適當系統方法，進行設計符合新產品功能及性能的設計。",
      "describe_en": "It will enable to apply the optimum system method to meets the function & performance product design."
    }
  ],
