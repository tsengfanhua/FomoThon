  "description": {
    "sub_id3": null,
    "sub_name": "中國古典小說中的社會階級",
    "sub_ename": "SOCIAL CLASS IN CLASSICAL CHINESE FICTION",
    "describe_ch": "本課程聚焦於中國古典小說中各種階級現象與社會想像，透過分析階級翻身、貧富對照、越階戀情與命運掙脫等主題，引導學生理解古代中國的權力結構與倫理體系，並思考小說如何再現社會矛盾。課程搭配文本細讀與討論，培養學生從文學角度觀察社會、批判制度的能力，並延伸至對當代階級現象的反思。",
    "describe_eh": "This course focuses on the representation of social class and societal imagination in the classical Chinese fiction. Through themes such as social mobility, contrasts between wealth and poverty, cross-class romance, and the struggle against fate, students will explore the power structures and ethical systems of the traditional Chinese society. Close reading and discussion-based analysis will cultivate students’ ability to observe social dynamics and critique institutions through literary lens, while encouraging reflection on contemporary issues of class and inequality.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識中國古典小說中階級制度的表現手法與歷史背景。",
      "describe_en": "To understand how social hierarchy is represented in the classical Chinese fiction, including its literary techniques and historical context."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生批判性閱讀能力，能將文學內容與社會現象相互對話。",
      "describe_en": "To develop critical reading skills that enable students to engage in dialogues between literary texts and broader social phenomena."
    }
  ],
