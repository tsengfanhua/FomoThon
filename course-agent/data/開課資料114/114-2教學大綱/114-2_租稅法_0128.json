  "description": {
    "sub_id3": null,
    "sub_name": "租稅法",
    "sub_ename": "TAX LAW",
    "describe_ch": "本課程主要介紹所得稅及其他租稅相關法令，課程包括：綜合所得稅、營利事業所得稅、遺產及贈與稅、土地稅、房屋稅及契稅、關稅、貨物稅及菸酒稅及營業稅等。",
    "describe_eh": " This course is focused on the introduction of tax laws and related regulations, including Personal Income Tax, Business Income Tax, Death and Donor's Tax, Land Tax, Customs Duties, Commodity Tax, Tobacco and Wine Tax and Sales Tax.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用租稅法與相關法令。",
      "describe_en": "Application for the tax laws and related regulations."
