  "description": {
    "sub_id3": null,
    "sub_name": "智慧製造自動化基礎",
    "sub_ename": "INTELLIGENT MANUFACTURING AUTOMATION FOUNDATION",
    "describe_ch": "本課程主要介紹製造自動化系統中一些基本元件與設備之原理與應用。內容包含(1)自動控制 元件：驅動器、感測器及控制器等；(2)自動化設備：數控工具機、工業用機器人、物料搬運 及辨識系統等；(3)自動化製造單元及系統之構成及自動化之何時？如何？等非技術性問題。",
    "describe_eh": "This course introduces the principles and applications of components and devices in automatic manufacturing systems. The course contents include (1) Automatic control components: actuators, sensors, and controllers; (2) Automation devices: NC machine tools, industrial robots, material transportation and identification systems; (3) Construction of automatic manufacturing cells and systems, and some non-technical problems related to when and how of automation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解自動化元件與設備在智能製造系統設計與分析的重要性。",
      "describe_en": "Understand the importance of the automatic components and devices on the design and analysis of smart manufacturing system."
    },
    {
      "seq": 2,
      "describe_ch": "能針對一特定製造系統，引用適切的自動化元件與設備，分析與評估其效益，並歸 納出結論。",
      "describe_en": "For a specific manufacturing system, be able to introduce appropriate automatic components and devices, analyze and evaluate the efficiency, and draw conclusions."
    }
  ],
