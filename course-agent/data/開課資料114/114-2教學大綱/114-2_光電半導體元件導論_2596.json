  "description": {
    "sub_id3": null,
    "sub_name": "光電半導體元件導論",
    "sub_ename": "INTRODUCTION TO OPTOELECTRONIC SEMICONDUCTOR DEVICES",
    "describe_ch": "本課為半導體的導論，並可作為進階半導體課程之先修課程。本課程將由半導體之基本概念與模型出發，介紹基本的半導體元件原理與物理特性，最後將討論光電半導體的光電特性與應用範圍。",
    "describe_eh": "As a fundamental course of semiconductor, it is suitable for students to take the course before taking other advanced courses of semiconductors. The course begins from the basic concepts and models of semiconductors. The principles and physical characteristics of basic semiconductor elements are discussed. Finally, the optoelectronic characteristics and applications of several kinds of optical semiconductors will be introduced,",
    "pre_subname": "PHYS2005近代物理、PHYS3001量子力學導論",
    "pre_sub_id3": "PHYS2005",
    "pre_sub_ename": "PHYS2005 MODERN PHYSICS、PHYS3001 INTRODUCTION TO QUANTUM MECHANICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生能熟悉半導體之基本概念，瞭解半導體的物理模型。",
      "describe_en": "Student can be familiar with the basic concepts of semiconductor, and understand the physical model of semiconductor."
    },
    {
      "seq": 2,
      "describe_ch": "學生能分析、設計基本光電半導體元件。",
      "describe_en": "Student can analysis and design a basic semiconductor elements."
    },
    {
      "seq": 3,
      "describe_ch": "學生能認識半導體元件的結果及其對環境、社會的影響以報告形式呈現。",
      "describe_en": "Be able to submit a study report in which the study process, results and influence on the environment or society would be included."
    }
  ],
