  "description": {
    "sub_id3": null,
    "sub_name": "多媒體系統",
    "sub_ename": "MULTI-MEDIA SYSTEMS",
    "describe_ch": "本課程在於概述多媒體系統技術之基本觀念及知識。科目內容包含有：多媒體系統簡介、為何需要多媒體、多媒體之初步引入、2-D繪圖、2-D繪圖工具，3-D模型及動畫、網頁之3-D動畫、視訊、非線性視訊剪輯、聲音與音樂、數位聲音編輯、多媒體整合與編輯、多媒體編輯實務、及多媒體在網頁之應用",
    "describe_eh": "This course introduces to students the basic concepts and knowledge of the technologies of multimedia system, including: A Brief Introduction to Multimedia, Why Multimedia?, Getting Started in Multimedia, Multimedia Building Blocks: 2-D Graphics, Graphic Design Tools, Using the Tools, Hands-on 3-D Modeling and Animation, Using 3-D Animation in a Multimedia Application Website, Multimedia Building Blocks: Video, Hands-on Non-Linear Video Editing, Multimedia Building Blocks: Sound and Music, Hands-on Digital Sound Editing, Multimedia Integration and Authoring, Hands-on Multimedia Authoring, and Creating Awesome Multimedia Applications on the Web.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
