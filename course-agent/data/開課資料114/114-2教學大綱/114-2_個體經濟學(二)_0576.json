  "description": {
    "sub_id3": null,
    "sub_name": "個體經濟學(二)",
    "sub_ename": "MICROECONOMICS(2)",
    "describe_ch": "個體經濟學運用限制下的最適化、均衡分析以及比較靜態三個分析工具來研究消費者行為、生產者行為、市場結構以及要素市場。本課程的主要目標在訓練學生將這些分析工具運用於日常經濟事務的操作能力，以形成其自身對經濟世界的個人觀點。",
    "describe_eh": "Microeconomics uses three analytical tools: constrained optimization, equilibrium analysis and comparative statics to study consumer behavior, producer behavior, market structure and input markets. The goal of this course concerns mainly the students'ability to handle these analytical tools applied to the ordinary related economic events, and shaping their own points of view toward the economic world.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解生產者如何在技術等限制條件下，進行最適選擇。",
      "describe_en": "To understand how producers make optimal choices under constraints."
    },
    {
      "seq": 2,
      "describe_ch": "能理解如何由個別的決策推導出市場供給，以及在不同市場結構下的資源配置。",
      "describe_en": "To understand how market supply is derived from individual decision-making, and how the resources allocation is determined under different market structures."
    }
  ],
