  "description": {
    "sub_id3": null,
    "sub_name": "太空動力學",
    "sub_ename": "ASTRODYNAMICS",
    "describe_ch": "本課程旨在培養航太系學生在太空領域具有全方位的認知與理解。內容涵蓋兩部份：一是關於太空科技之發展歷程及未來展望；二是有關太空飛行器之運動原理及應用。具體章節為西方天文學與天體力學之發展，太空科技發展歷程、太空力學、人造衛星分類與應用，火星之旅，我國太空科技發展現況與展望。",
    "describe_eh": "The main objective of the course is to give the students to have the extensive understanding about the field of space flight. The contexts of this course are: development of the celestial mechanics, history of the space technology development, space mechanics, satellites classification and application , mars mission , development of space technology in Taiwan.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備太空科技發展概念",
      "describe_en": "To have the knowledge of trend and development in space technology."
    },
    {
      "seq": 2,
      "describe_ch": "理解太空飛行之基本原理與應用",
      "describe_en": "To understand the fundamental principles and applications of the space flight."
    },
    {
      "seq": 3,
      "describe_ch": "理解未來太空發展方向與策略",
      "describe_en": "To know the direction and stragegy of space development in the future."
    }
  ],
