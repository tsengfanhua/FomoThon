  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(二)",
    "sub_ename": "SEMINAR(2)",
    "describe_ch": "本課程旨在使學生在聽眾面前練習演說，並詳細探討主題。每個學生本學期將進行一次30分鐘的演講。演講內容為在網路上或圖書館中找出一篇學術論文，重作實現論文中的模擬結果或數據分析結果。修課同學必須出席每一堂課。安排「數據科學演講」，邀請從事數據科學的業界、學界人士，前來發表專題演講，分享他們欲解決的問題、經驗與成果，以增廣學生在數據科學領域的眼界。",
    "describe_eh": "This course is meant to give students practice speaking in front of an audience. Each student will find a research paper, repeat the simulation or data analysis conducted in the paper, and then give a 30-minute presentation. Attendance at each seminar is mandatory for all students enrolled. Regularly invite industry and academic professionals in Data Science to deliver special lectures so as to broaden students' horizons in the field of Data Science.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "利用如何蒐集資料的概述、一些數據科學方面的演講、專題演講以及相關主題的報告來幫助學生綜合在數據科學方面所應具之聽、說、讀、寫的能力",
      "describe_en": "By using an overview of the ways to collect resource, invitation Data Science talks to help students improve their synthetic abilities for listening, speaking , reading and writing."
    }
  ],
