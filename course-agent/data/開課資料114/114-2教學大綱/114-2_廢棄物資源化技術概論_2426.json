  "description": {
    "sub_id3": null,
    "sub_name": "廢棄物資源化技術概論",
    "sub_ename": "RECYCLING AND RECOVERY OF WASTE",
    "describe_ch": "廢棄物資源化為國內外各領域之重要熱門議題，本課程主要介紹國內廢棄物資源回收之技術與發展現況、相關法規制度與管理規範，並介紹不同類別廢棄物之資源回收技術，討論國內外資源回收之技術、管理與策略。",
    "describe_eh": "Waste Resourcilization is important topics in various fields. This course mainly introduces the technology and development of domestic waste recycling, related  regulations and management practices, and also introduces different types of waste recycling technologies, and discusses the domestic and foreign resource recovery technology, management and strategy.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "說明資源化物質回收處理之技術原理與物質回收廠設施規劃。\t",
      "describe_en": "To explain the principle of recovery technology of recyclable materials and planning of materials recovery facilities (MRFs).　"
    },
    {
      "seq": 2,
      "describe_ch": "利用不同之案例介紹現有可行之資源化技術。　\t",
      "describe_en": "Using case studies available in the market to introduce the development of waste recycling and recovery.　"
    }
  ],
