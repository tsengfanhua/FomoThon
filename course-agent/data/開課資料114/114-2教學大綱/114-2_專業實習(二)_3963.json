  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE03320",
    "sub_id": "43037",
    "scr_dup": "001",
    "sub_title": "於建築相關實習單位進行專業工作學習",
    "sub_title_en": null,
    "sub_describe": "本課程以「建築專業實務學習與職場能力養成」為核心探究主題，透過學生進入建築相關實習單位進行專業工作學習，使學生能將校內所學之建築設計、圖面表達、空間分析、構造概念、法規認識、數位工具應用與專案協作能力，實際連結至建築產業之工作流程與專業情境。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "專業實習(二)",
    "sub_ename": "INTERNSHIP (2)",
    "describe_ch": "透過實習計畫書的申請確認學校與企業的協作方向，並由實習單位業師的實習週誌與指導教授雙周或月報的督導，在期末繳交專業技術報告並進行業師及指導教授的口試評分。學生每週依實習單位與學程研商結果在實習單位實習至少3天。",
    "describe_eh": "Based on the internship proposal submitted by applicant, the corporation directions are confirmed by both university and organization.  Supervised by the tutor of internship organization with weekly logs and bi-week or monthly reports from advisor, the student has to present his/her final technical report and attend the oral defense which is assessed by the internship tutor and advisor at the end of semester. Three days per week at least at the internship organization will be determined by university and organization.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 6.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解、分析、解決實習單位實務問題",
      "describe_en": "To understand, analyze, and resolve the practical problems at the internship organization."
    },
    {
      "seq": 2,
      "describe_ch": "撰寫並發表專業技術報告",
      "describe_en": "To document, present, and defense the technical report"
    }
  ],
