  "description": {
    "sub_id3": null,
    "sub_name": "雲端架構設計",
    "sub_ename": "CLOUD ARCHITECTING",
    "describe_ch": "本課程主要以企業實務應用角度切入介紹雲端架構設計，並透過AWS Academy學習平台與教學資源，介紹雲端核心服務與基於雲端的解決方案架構設計。課程內容涵蓋Amazon Web Services與其IT基礎設施等知識。",
    "describe_eh": "The course aims to teach solutions architects how to optimize the use of the AWS Cloud by understanding AWS services and how these services fit into cloud-based solutions. This course covers the fundamentals of building IT infrastructure on Amazon Web Services.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解雲端運算核心服務",
      "describe_en": "Understanding the core services of cloud computing"
    },
    {
      "seq": 2,
      "describe_ch": "學習雲端運算與服務的操作能力",
      "describe_en": "Learning the essentials and skills of cloud services on AWS"
    },
    {
      "seq": 3,
      "describe_ch": "實現以雲端服務為基礎的實務應用",
      "describe_en": "Applying cloud service to the cloud architecting projects"
    }
  ],
