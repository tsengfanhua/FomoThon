  "description": {
    "sub_id3": null,
    "sub_name": "機械製造(二)",
    "sub_ename": "MANUFACTURING PROCESS(2)",
    "describe_ch": "以工程師的觀點探討各種機械製造程序有關之材料選擇，力學分析及製程決定等問題，內容包括塑膠成型、工具機加工、非傳統切削、積體電路製造、微奈米製造等技術。",
    "describe_eh": "To investigate the selection of material , mechanics analysis , selection of manufacturing process from the view point of an engineer. Course content includes plastic molding, machine tools, non-traditional cutting, integrated circuit manufacturing, micro-nano manufacturing and other technologies.",
    "pre_subname": "ENGS2001材料力學(一)、ENGS2002材料力學(二)",
    "pre_sub_id3": "ENGS2001",
    "pre_sub_ename": "ENGS2001 MECHANICS OF MATERIALS(1)、ENGS2002 MECHANICS OF MATERIALS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解機械製造在工業的重要性及影響。",
      "describe_en": "Be able to comprehend the importance and effects of manufacturing process to industry."
    },
    {
      "seq": 2,
      "describe_ch": "能理解機械製造的場合，並能清楚表達。",
      "describe_en": "Be able to comprehend manufacturing process principles and make clear statement."
    },
    {
      "seq": 3,
      "describe_ch": "能應用機械製造的原理，分析一零件或產品，並提出可行驗證方法。",
      "describe_en": "Apply principles of manufacturing process to analyze a part or product and propose a feasible method for validation."
    }
  ],
