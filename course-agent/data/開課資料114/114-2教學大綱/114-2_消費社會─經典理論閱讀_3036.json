  "description": {
    "sub_id3": null,
    "sub_name": "消費社會 ─ 經典理論閱讀",
    "sub_ename": "CONSUMER SOCIETY ─ CLASSIC THEORY STUDYING",
    "describe_ch": "本課程將透過法國學者布希亞(Jean Baudrillard)的理論，對流行、廣告、行銷等等進行分析，讓同學能理解我們每天日常的各種消費活動，包括觀看各種媒體、追星、蒐集某些東西……等等，對社會所帶來的效應，以及這樣的消費文化又如何回過頭來影響我們每人的品味、愛好、理想與慾望。",
    "describe_eh": "The course will analyze fashion, advertising and marketing, based on the theory of French scholar Jean Baudrillard. This course will enable students to understand our daily consumption activities, which includes watching media, chasing celebrities, collecting certain things...etc., how to effect society and how consumer culture affects our tastes, hobbies, dreams and desires.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "協助學生分析自身的消費行為。",
      "describe_en": "Help students analyze their own consumption behavior."
    },
    {
      "seq": 2,
      "describe_ch": "協助學生了解消費社會的運作機制。",
      "describe_en": "Help students understand the operation mechanism of consumer society."
    }
  ],
