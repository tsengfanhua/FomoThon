  "description": {
    "sub_id3": null,
    "sub_name": "不動產經營管理",
    "sub_ename": "REAL ESTATE MANAGEMENT",
    "describe_ch": "本課程乃綜理本系學生三年半以來所學不動產相關課程，進行課程間橫向整合，配合個案開發實例介紹，瞭解不動產經營管理體系及相關行業之職掌，並講授經營管理之相關學理及實務。",
    "describe_eh": "This course integrates all the real estate related courses with various courses in the past three and half years and apply the knowledge on real cases to help understand the management in real estate and other related fields. This course will also discuss management theory and real cases.",
    "pre_subname": "LAND2009營建法規、LAND1001建築概論、LAND3004不動產市場分析",
    "pre_sub_id3": "LAND2009",
    "pre_sub_ename": "LAND2009 CONSTRUCTION REGULATIONS、LAND1001 INTRODUCTION TO ARCHITECTURE、LAND3004 REAL ESTATE MARKET ANALYSIS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解不動產開發流程及相關行業之關係，並認識經營管理體系及職掌。",
      "describe_en": "Understand real estate development and its relations with other industries and"
    },
    {
      "seq": 2,
      "describe_ch": "能闡述都市的未來發展，進而分析產品的市場性。",
      "describe_en": "Be able to describe the future development of a city and to analyze the marketability of products to its market."
    },
    {
      "seq": 3,
      "describe_ch": "能運用不動產經營管理技巧，編寫不動產開發執行計劃。",
      "describe_en": "Be able to apply real estate management technique to compose a real estate development plan."
    }
  ],
