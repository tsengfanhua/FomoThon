  "description": {
    "sub_id3": null,
    "sub_name": "物業管理",
    "sub_ename": "PROPERTY MANAGEMENT",
    "describe_ch": "本課程擬藉由資產生命週期的管理概念，導引學生學習物業法令與制度、企劃顧問、智慧化生活空間、物業生活服務整合、安全資訊系統、社區經營管理、長期修繕、資產活化與都市更新等議題。",
    "describe_eh": "The course introduces the concept of property Life-Cycle management. To guide students how to plan and manage property project/issues such as legislation, planning consultant, intelligent building, life services, security system, community management, long-term maintenance, property renewal and urban renew.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂物業管理，並能夠描述主要的產業結構及其未來發展趨勢。",
      "describe_en": "To define Property Management with their own words and describe main industrial structure and its' future trend."
    },
    {
      "seq": 2,
      "describe_ch": "具備資產管理的知識與技術。",
      "describe_en": "To acquire knowledge and skill of \"Property Management\"."
    },
    {
      "seq": 3,
      "describe_ch": "提升同學的物業規劃與管理能力，並能以書面或簡報方式與同學或師長溝通。",
      "describe_en": "To strengthen the capability of planning and managing in this field, and communicate learning results in written or presentation to classmates or the instructor."
    }
  ],
