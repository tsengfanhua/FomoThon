  "description": {
    "sub_id3": null,
    "sub_name": "統計學(一)實習",
    "sub_ename": "STATISTICS(1) RECITATION",
    "describe_ch": "統計學(一)為統計入門課程，從機率概念由淺入深導引學生進入基本統計觀念，瞭解抽樣分配與估計的演算與運用。主題包括資料整理、機率概念、常用之機率分配、抽樣分配、點估計與區間估計。",
    "describe_eh": "Statistics (1) is the first introductory course in which this course  starts from the concepts of probability to elementary statistics in order to understand the computation of sampling distribution and estimation methods. Topics include data management, probability concept, some common probability distributions, sampling distribution, and point and interval estimations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 11,
      "describe_ch": "知道何謂統計學之應用與敘述統計學",
      "describe_en": "To Know statistical applications  and descriptive  statistics."
    },
    {
      "seq": 12,
      "describe_ch": "知道機率分配函數及其用法",
      "describe_en": "To know  some probability distribution functions  and its applications."
    },
    {
      "seq": 13,
      "describe_ch": "知道抽樣、抽樣分配及與點估計",
      "describe_en": "To know  the sampling process、 sampling distribultions and point estimation."
    }
