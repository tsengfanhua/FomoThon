  "description": {
    "sub_id3": null,
    "sub_name": "音訊電子系統設計",
    "sub_ename": "AUDIO ELECTRONIC SYSTEM DESIGN",
    "describe_ch": "音訊電子系統設計課程包含基礎電子學概念、電晶體、JFET/FET/等放大器與開關電路設計，以及基本的音訊程式與音訊崁入式系統的概念。本課程規劃實作音訊放大器系統電路設計、並結音訊崁入式系統設計等實作題目，讓學生了解從基礎到進階的電子系統知識應用，更讓學生動手做出現代音訊系統，了解電聲系統設計的樂趣。",
    "describe_eh": "The Audio Electronic System Design course covers foundational electronics concepts, transistors, amplifiers including JFET/FET, and switch circuit design. It also includes basic audio programming and the concepts of embedded audio systems. The course incorporates practical projects such as designing audio amplifier system circuits and developing audio embedded systems. These hands-on assignments provide students with an understanding of applying electronic system knowledge from basic to advanced levels and allow them to create modern audio systems, thereby experiencing the joy of sound system design.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解音訊電子的基本概念和原理，知道常見的電子學概念、放大器和開關電路設計。",
      "describe_en": "Understand the basic concepts and principles of audio electronics, including common electronic principles, amplifier design, and switch circuit design."
    },
    {
      "seq": 2,
      "describe_ch": "能夠選擇和應用適當的電路設計處理音訊，理解如何設計和調整電子電路設計以達到最佳性能。",
      "describe_en": "Select and apply appropriate circuit designs for audio processing, understand how to design and fine-tune electronic circuits to achieve optimal performance."
    },
    {
      "seq": 3,
      "describe_ch": "能夠評估音訊電子系統的品質，並提供音頻分析洞見和音訊系統解釋。",
      "describe_en": "Evaluate the quality of audio electronic systems and provide audio analysis insights and explanations of audio systems"
    }
  ],
