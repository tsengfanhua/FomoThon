  "description": {
    "sub_id3": null,
    "sub_name": "企業倫理與社會責任",
    "sub_ename": "BUSINESS ETHICS AND  CORPORATE SOCIAL RESPONSIBILITY",
    "describe_ch": "透過課程講授、實務專題演講與小組合作學習，讓學習者建立具備企業倫理與社會責任的基本概念，了解企業經營管理的倫理議題、倫理決策理論、組織文化對倫理決定之影響、組織倫理之控制與企業的社會責任。",
    "describe_eh": " This course would be taught by lectures and small group cooperative learning. Students would learn the essential knowledge about business ethics and corporate social responsibility. Such topics as common ethical problems, ethical problems of managers and organizations, justice and rights, management of ethical conducts, ethics as organizational culture, and corporate social responsibility would be learned afterward.",
    "pre_subname": "MGT1001管理學",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解企業責任與全球永續發展的意義",
      "describe_en": "To introduce the implication of business ethics."
    },
    {
      "seq": 2,
      "describe_ch": "理解企業挑戰永續發展的策略行動",
      "describe_en": "To explain the mean of social responsibility."
    },
    {
      "seq": 3,
      "describe_ch": "描述策略性企業責任行動的個案故事",
      "describe_en": "To understand how to contribute social responsibility in for-profit management."
    }
  ],
