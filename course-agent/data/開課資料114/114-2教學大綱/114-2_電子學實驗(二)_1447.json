  "description": {
    "sub_id3": null,
    "sub_name": "電子學實驗(二)",
    "sub_ename": "ELECTRONICS LAB.(2)",
    "describe_ch": "電子學實驗課教育之目的在於培養學生對於儀器使用量測與電子元件的使用。在課程上以實作為主，軟體模擬分析為輔，兩者互相對照並與理論分析之結果比較。電子學實驗(二)的課程包括(1) BJT小訊號放大器(2)MOS理論、小訊號放大器與基本開關應用電路(3)電流鏡與差動放大器(4)頻率響應(5)負回授放大器與功率放大器。",
    "describe_eh": "The intent of the electronic experiment is to educate the students to operate the equipment and electronic devices. In class, it is focus on practice, and simulator is aided. Collating them and comparing with the result of theory analysis. The content of the class includes (1) BJT small signal amplifier (2)the theorem, small signal amplifier and basic applied switching circuit of MOSFETs (3)current mirror and differential amplifier (4)frequency response (5) negative feedback amplifier and power amplifier.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備實驗管理、團隊解決問題與有效溝通的能力。",
      "describe_en": "Be able to manage experimental project and cooperate with team members."
    },
    {
      "seq": 2,
      "describe_ch": "能使用模擬軟體模擬並且應用於實驗結果的對照。",
      "describe_en": "Be able to apply the circuit simulator to verify their measured results."
    },
    {
      "seq": 3,
      "describe_ch": "具有電子電路基本實務量測的知識與能力。",
      "describe_en": "Have the basic knowledge of practical measurement skills of the experiment electronic circuits."
    },
    {
      "seq": 4,
      "describe_ch": "能具體整理資料撰寫實驗報告。",
      "describe_en": "Have the knowledge of writing a complete experimental report."
    }
  ],
