  "description": {
    "sub_id3": null,
    "sub_name": "期貨與選擇權",
    "sub_ename": "FUTURES AND OPTIONS",
    "describe_ch": "本課程主要了解期貨與選擇權和其它衍生性金融商品的基本概念與定價，並進一步探討其投機、避險與套利策略。",
    "describe_eh": "The main purpose of this course is to understand the basic concepts and the pricing of futures, options and other derivatives.  Moreover, this course will explore the strategies of speculation, hedging and arbitrage concerning the derivatives.",
    "pre_subname": "ECON1001經濟學(一)、STAT1001統計學(一)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、STAT1001 STATISTICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解期貨與選擇權之評價",
      "describe_en": "Understand the valuation of futures and options"
    },
