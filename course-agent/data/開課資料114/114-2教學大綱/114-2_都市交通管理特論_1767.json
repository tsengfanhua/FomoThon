  "description": {
    "sub_id3": null,
    "sub_name": "都市交通管理特論",
    "sub_ename": "SPECIAL ISSUES ON URBAN TRANSPORTATION MANAGEMENT",
    "describe_ch": "都市交通管理面臨許多需解決之課題，因此宜用系統化之觀念予以分析，例如永續發展、都市交通政策、運輸規劃、交通工程、停車管理、大眾運輸及觀光發展等，均需透過理論與實務之結合，方能有效提出解決策略。本課程即是以個案研討之方式導入基本理論與觀念，使學生可獲得解決都市交通問題之基本技能。",
    "describe_eh": "Urban transportation management faces many critical issues which should be solved by systematic approach. It's necessary to propose useful strategy by combing theories and practices for urban transportation development. The issues are sustainable development, urban transportation policy, urban transportation planning, traffic engineering measures, parking management, transit development, and relationships of tourism development and transportation. Students could learn the expertise from iterative interactions of case study and discussions.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的專業知識解決都市交通問題",
      "describe_en": "Solve urban transportation problems by individual expertise."
    },
    {
      "seq": 2,
      "describe_ch": "能夠了解理論與實務間之差距及需克服之課題",
      "describe_en": "Understand and overcome the gap between theory and practice."
    },
    {
      "seq": 3,
      "describe_ch": "能以書面或口頭方式將所獲結果有效與同學及老師溝通",
      "describe_en": "Communicate results in written or oral form to classmates, and the instructor"
    },
    {
      "seq": 4,
      "describe_ch": "能透過分組研討展現團隊合作能力",
      "describe_en": "Demonstrate esprit de corps (team spirit) through group discussions."
    }
  ],
