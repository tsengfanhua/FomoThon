  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CA00100",
    "sub_id": "51089",
    "scr_dup": "001",
    "sub_title": "工科院各系發展科技-以無人機系統為例說明",
    "sub_title_en": null,
    "sub_describe": "本課程融合光電、機械、纖維複合材料、航太、化工、材料科學與人工智慧等多元領域，以無人機設計與實作為核心，引導學生探索跨學科創新應用。內容涵蓋光電感測與通訊技術、飛行器結構設計、高分子與複合材料選用、自動控制與AI輔助操控等主題，並強調實作與理論並重。課程安排企業參訪，深入了解航太與智慧製造產業發展趨勢，強化實務連結。期末舉辦無人機障礙賽，鼓勵學生整合所學，提升創意實踐與問題解決能力，適合對科技創新、智慧載具與跨域工程有興趣之初學者。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "從無人機競賽談工程科技",
    "sub_ename": "ENGINEERING TECHNOLOGY THROUGH DRONE COMPETITIONS",
    "describe_ch": "本課程融合光電、機械、纖維複合材料、航太、化工、材料科學與人工智慧等多元領域，以無人機設計與實作為核心，引導學生探索跨學科創新應用。內容涵蓋光電感測與通訊技術、飛行器結構設計、高分子與複合材料選用、自動控制與AI輔助操控等主題，並強調實作與理論並重。課程安排企業參訪，深入了解航太與智慧製造產業發展趨勢，強化實務連結。期末舉辦無人機障礙賽，鼓勵學生整合所學，提升創意實踐與問題解決能力，適合對科技創新、智慧載具與跨域工程有興趣之初學者。\r\n",
    "describe_eh": "This course integrates diverse disciplines including optoelectronics, mechanical engineering, fiber-reinforced composites, aerospace, chemical engineering, materials science, and artificial intelligence, with a focus on drone design and hands-on implementation. Students will explore interdisciplinary innovation through topics such as optical sensing and communication, aircraft structural design, selection of polymers and composite materials, autonomous control, and AI-assisted navigation. Emphasizing both theory and practice, the course includes industry visits to deepen understanding of aerospace and smart manufacturing trends. A final drone obstacle competition encourages students to apply their knowledge creatively and develop problem-solving skills. Ideal for beginners interested in technological innovation, intelligent aerial vehicles, and cross-domain engineering.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
