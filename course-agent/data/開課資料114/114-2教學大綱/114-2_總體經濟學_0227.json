  "description": {
    "sub_id3": null,
    "sub_name": "總體經濟學",
    "sub_ename": "MACROECONOMICS",
    "describe_ch": "本課程介紹總體經濟模型，包括總體所得、就業、利率及通貨膨脹率的決定，課程涵蓋國民所得帳、IS-LM分析模型、菲利浦曲線、古典貨幣理論、公共債務問題及貨幣與財政政策等等。在課程中除了介紹基本的總體經濟理論與模型，並且將輔以台灣、美國及世界各國的實例說明。本課程目標在於期使學生認知當代總體經濟理論，並能分析種種總體經濟事件。",
    "describe_eh": "This course provides an overview of macroeconomic issues: the determinations of output, employment, unemployment, interest rates, and inflation. The topics cover the measurement of national income, IS-LM model, Phillips curve, monetary and fiscal policies. The course introduces basic models of macroeconomics and illustrates principles with the experience of the United States and Taiwan economies. Its purpose is to give the students a sound understanding and analysis on macroeconomic events.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 2,
      "describe_ch": "理解及分析各種經濟政策的效果及其限制。",
      "describe_en": "Captur and analyze the role of various macroeconomic policies and its restrictions in depth."
    }
  ],
