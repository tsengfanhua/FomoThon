  "description": {
    "sub_id3": null,
    "sub_name": "群眾募資與社會創業",
    "sub_ename": "CROWDFUNDING AND SOCIAL ENTREPRENEURSHIP",
    "describe_ch": "本課程介紹社會創業為何與如何成為解決社會問題的創新機制，並透過實作群眾募資提案，學習網路時代的社會資源動員方式。",
    "describe_eh": "This course introduces why and how social entrepreneurship becomes an innovative mechanism to solve social problems, and through the implementation of crowdfunding proposals, learns the ways of social resource mobilization in the Internet Age.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
