  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "XC04111",
    "sub_id": "GM706",
    "scr_dup": "001",
    "sub_title": "人的形成",
    "sub_title_en": null,
    "sub_describe": "研究過去所有發生，是如何讓我成為我現在的樣子？\n透過各種書寫與活動操作，進行個人發展歷程的質性研究。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "我是誰？內在探索與世代對話",
    "sub_ename": "SELF EXPLORATION AND DIALOGUES BETWEEN GENERATIONS",
    "describe_ch": "以薩提爾模式為核心，透過各式體驗的互動操作以及內在探索，辨識自己受到父母與文化的影響，同時在人際間細微的互動過程中，看見人性深處的同與不同，建立適當的界線，學習成為更一致的自己，創造更自在的人我關係，以及寬廣的世界觀。",
    "describe_eh": "This course takes Satir model as the core, through the interactive operation and inner exploration of various experiences, to lead students to identify themselves via the influences from parents and culture. Students are expected to create better relationships with others and cultivate a broader worldview.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "辨識個人受家庭與社會文化的影響並建立良好人際關係",
      "describe_en": "To identify the influences from family and culture so as to build a great interpersonal relationship."
    },
    {
      "seq": 2,
      "describe_ch": "盤點與整合個人資源並理解多元價值與開放精神",
      "describe_en": "To integrate various resources and understand multiple values and spirits."
    }
  ],
