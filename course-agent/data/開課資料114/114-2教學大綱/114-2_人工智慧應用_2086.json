    {
      "seq": 1,
      "describe_ch": "培養學生學習電機與通訊工程研究相關專業知識之能力",
      "describe_en": "To develop students' ability to learn and acquire professional knowledge related to electrical and communications engineering research."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解人工智慧工具以及可應用之領域",
      "describe_en": "Understand the functions of artificial intelligence tools for possible applications."
    }
