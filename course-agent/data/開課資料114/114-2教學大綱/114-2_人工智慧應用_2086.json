  "description": {
    "sub_id3": null,
    "sub_name": "人工智慧應用",
    "sub_ename": "ARTIFICIAL INTELLIGENCE APPLICATIONS",
    "describe_ch": "本課程將介紹使用人工智慧技術從事工程研究之個案介紹。例如使用人工智慧進行醫療輔助裝置之開發、利用人工智慧科技解決農業問題。經由案例介紹，學生可以獲得相關經驗，並應用於自己的研究當中。",
    "describe_eh": "This course will survey some cases studied by applying artificial intelligence technologies. The topics will cover studies in medical devices and agricultures.Students will learn the related experiences for their own researches.\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
