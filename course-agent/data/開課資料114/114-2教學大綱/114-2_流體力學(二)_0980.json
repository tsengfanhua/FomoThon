  "description": {
    "sub_id3": null,
    "sub_name": "流體力學(二)",
    "sub_ename": "FLUID MECHANICS(2)",
    "describe_ch": "本課程係一入門課程，旨在介紹流體靜止與運動時之行為。流體力學（二）之內容包括流動微分分析、因次分析與模型試驗、管流、及通過浸沒物體之流動等。",
    "describe_eh": " This is an introduction course in which the behavior of fluids at rest and in motion is to be presented and explored. The contents of Fluid Mechanics (2) include differential analysis of fluid flow, dimensional analysis and modeling, pipe flow, and flow over immersed bodies.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用Navier-Stokes方程式.\t",
      "describe_en": "1 Can apply Navier-Stokes equations."
    },
    {
      "seq": 2,
      "describe_ch": "能應用因次分析,以設計原型及模型實驗.\t",
      "describe_en": "\t2 Can apply dimensional analysis to design prototype and model experiments."
    },
    {
      "seq": 3,
      "describe_ch": "能應用及設計管流.",
      "describe_en": "\t3 \tCan apply and design pipe flow."
    },
    {
      "seq": 4,
      "describe_ch": "\t能應用及計算阻力與昇力.\t",
      "describe_en": "4Can apply and calculate drag and lift forces."
    }
  ],
