    "sub_name": "不動產經濟學",
    "sub_ename": "REAL ESTATE ECONOMICS",
    "describe_ch": "不動產經濟學為估價師考試必考科目，本門課主要提供對於考取估價師有興趣的同學，針對估價師考試之考試範圍進行講授，協助同學日後考取估價師。",
    "describe_eh": "Real Estate Economics is a compulsory subject for the appraiser examination. This course primarily caters to students interested in becoming appraiser, covering the scope for the appraiser certification. It aims to assist students in successfully passing the appraiser examination.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解與適用土地管理專業與實務之能力。",
      "describe_en": "The ability of proper understanding and applying land management expertise into practice"
    },
    {
      "seq": 2,
      "describe_ch": "應用軟硬體蒐集、處理與分析之能力",
      "describe_en": "Ability to collect, process and analyze data using software and hardware"
    },
    {
      "seq": 3,
      "describe_ch": "培養積極創新、邏輯思考、團隊合作之能力並具備社會責任。",
      "describe_en": "The ability of managing innovation, logical thinking, teamwork and insisting social responsibility"
    }
