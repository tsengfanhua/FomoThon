  "description": {
    "sub_id3": null,
    "sub_name": "文學概論(二)",
    "sub_ename": "INTRODUCTION TO LITERATURE(2)",
    "describe_ch": "探討文學的各種原理，藉以提供認識文學作品的正確途徑。課程內容分為七個部分：\r\n一、文學的定義；二、文學的形式；三、文學的內容；四、文學的想像；五、文學的目的；六、文學的風格與類型；七、文學的派別。",
    "describe_eh": "The objective of this course is to study different principles of literature and thereby offer proper approaches in understanding literature. The course covers seven parts:\r\n1.The definition of literature.\r\n2.The form of literature.\r\n3.The contents of literature.\r\n4.The imagination of literature.\r\n5.The purpose of literature.\r\n6.The style and genre of literature.\r\n7.The sect of literature.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "掌握文學的基礎知識和基本原理。",
      "describe_en": "To grasp the basic theory and understanding on literature"
    },
    {
      "seq": 2,
      "describe_ch": "欣賞和評論文學作品的能力。",
      "describe_en": "The ability to appreciate and criticise literature"
    }
  ],
