  "description": {
    "sub_id3": null,
    "sub_name": "基礎工程(二)",
    "sub_ename": "FOUNDATION ENGINEERING(2)",
    "describe_ch": "本課程繼學生研習土壤力學與基礎工程之後，延伸學習領域至筏式基礎設計分析、承載側向力樁基礎設計分析、加勁擋土構造物設計分析、及支撐開挖有關的設計分析，包括：擋土壁、內支撐及地錨等。",
    "describe_eh": "Following the study of soil mechanics and foundation engineering, this course gives\nstudents an opportunity to get familiar with the analysis and design of mat\nfoundation,lateral loaded pile foundation, mechanically reinforced earth wall, and\nbraced-cut\nrelated items including retaining wall, system to hold the wall from inside of\nexcavated areas, and the tieback anchorages, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能強化土壤力學與基礎工程之知識應用的能力",
      "describe_en": "Be able to intensify the capability of use of soil mechanics and foundation engineering."
    },
    {
      "seq": 2,
      "describe_ch": "能設計分析數種大地工程構造物",
      "describe_en": "Be able to analyze several kinds of geotechnical engineering structures."
    }
  ],
