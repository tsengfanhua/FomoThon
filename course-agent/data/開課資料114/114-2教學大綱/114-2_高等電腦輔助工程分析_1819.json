  "description": {
    "sub_id3": null,
    "sub_name": "高等電腦輔助工程分析",
    "sub_ename": "ADVANCED COMPUTER-AIDED ENGINEERING ANALYSIS",
    "describe_ch": "俱備數值分析及應用電腦輔助軟體的能力，如：Fluent及 ANSYS等，針對工業界的工程問題作分析計算，以期提昇產品的設計能力，本課程將整合工程模擬，加強學生的專業知識，訓練學生處理複雜問題的技巧和能力。",
    "describe_eh": "This course introduces the theory of numerical analysis for heat transfer and fluid dynamics as well as the applications of engineering software, such as Fluent and ANSYS.\r\nThis course also will help students to understand more about the fundamentals of engineering and train students to have the abilities of using software to solve complex problems.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "讓學生瞭解數值分析的基本原理，並應用於求解工程問題。",
      "describe_en": "Understand the fundamentals of numerical analysis and its applications on engineering problems."
    },
    {
      "seq": 2,
      "describe_ch": "應用商用軟體如Fluent, ANSYS分析計算熱流問題，提昇產品設計的能力。",
      "describe_en": "Apply software like Fluent, ANSYS to analyze the cases of engineering in order to increase the ability of product designs."
    },
    {
      "seq": 3,
      "describe_ch": "整合數值模擬、力學理論和應用軟體，培養學生解決工程問題的能力。\r\n",
      "describe_en": "Integrate numerical simulation, mechanical theory and the applied software to raise the ability of solving engineering problems for students."
    },
    {
      "seq": 4,
      "describe_ch": "培育學生因應複雜工程問題之能力",
      "describe_en": "Students have the ability to cope with complex engineering problems"
    }
  ],
