    {
      "seq": 1,
      "describe_ch": "了解電子封裝之原理\t",
      "describe_en": "To understand the principles of electronic packaging"
    },
    {
      "seq": 2,
      "describe_ch": "了解先進封裝各部位之相關製程\t",
      "describe_en": "To understand the process related to various parts of advanced electronic packaging"
    },
    {
      "seq": 3,
      "describe_ch": "學習先進封裝之材料選用及原理\t",
      "describe_en": "To learn the material selection and principle of advanced electronic packaging"
    },
    {
      "seq": 4,
      "describe_ch": "材料科學與工程應用之連結\t",
      "describe_en": "To link between materials science and engineering applications"
    }
  ],
