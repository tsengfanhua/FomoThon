  "description": {
    "sub_id3": null,
    "sub_name": "電子學(二)",
    "sub_ename": "ELECTRONICS(2)",
    "describe_ch": "延續電子學（一）的電子元件和電路分析基礎，介紹電晶體放大器、積體電路放大器和差動與多級放大器，課程包含電晶體小信號操作與模型、偏壓、使用離散式元件的放大器、積體電路設計及金氧半電晶體與?極接面電晶體之差動對、共模拒斥等，讓學生修完電子學（二）後，具有分析單/多級放大電路之能力。",
    "describe_eh": "The students will engage in the study of transistor amplifiers, integrated-circuit amplifiers, differential and multistage amplifiers. The contents of this course includes: small-signal operation and models of transistors, biasing, discrete-circuit amplifiers, IC design philosophy, differential pairs of transistors (MOSFET and BJT), and common-mode rejection. A student who successfully fulfills the course requirements will have an ability to analyze single and multistage amplifiers.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠熟悉金氧半場效電晶體及双極接面電晶體小信號模型與操作。",
      "describe_en": "To know the operation of small-signal models of metal-oxide semiconductor field-effect transistors and bipolar junction transistors."
    },
    {
      "seq": 2,
      "describe_ch": "能敘述組成積體電路之方塊之不同功能。",
      "describe_en": "Be able to tell the functions of the building blocks of integrated-circuit amplifiers."
    },
    {
      "seq": 3,
      "describe_ch": "能分析差動與多級放大器電路。",
      "describe_en": "Be able to analyze differential and multistage amplifier circuits."
    }
  ],
