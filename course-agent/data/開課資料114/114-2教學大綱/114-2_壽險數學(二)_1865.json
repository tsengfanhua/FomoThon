  "description": {
    "sub_id3": null,
    "sub_name": "壽險數學(二)",
    "sub_ename": "MATHEMATICS FOR LIFE INSURANCE(2)",
    "describe_ch": "本學期課程將介紹如何在一定計算因素精確算出確定年金、生存年金、人壽保險之純保費、總保費、準備金等，儘管壽險市場日新月異產品推陳佈新，數理計算仍要求合理化、公平化、精確化，本課程希望能讓同學了解如何計算不同壽險商品的保費與準備金。",
    "describe_eh": "The course introduces the actuarial methodology to calculate net premium, gross premium and valuation needs to provide reasonableness, equality, and accuracy. Although the new products are introduced into the market, actuarial mathematics still require rationalization, fairness, and precision. This course hopes to enable students to understand how to calculate premiums and reserves for different life insurance products.\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解死亡率與年金概論",
      "describe_en": "Comprehension for the mortality rate and annuity"
    },
    {
      "seq": 2,
      "describe_ch": "理解壽險產品數理計算基礎",
      "describe_en": "Comprehension for the calculation fundamentals using for various life insurance products"
    },
    {
      "seq": 3,
      "describe_ch": "理解準備金提存之意義與計算",
      "describe_en": "Comprehension for the propose of reserve and learning how to calculate it"
    }
  ],
