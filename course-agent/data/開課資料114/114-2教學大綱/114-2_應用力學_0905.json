  "description": {
    "sub_id3": null,
    "sub_name": "應用力學",
    "sub_ename": "APPLIED MECHANICS",
    "describe_ch": "本課程為材料力學、結構分析與設計的先修課程，以基本的物理與數學為基礎。內容主要包括力與力矩、質點與剛體之力平衡、簡單結構分析、形心與質心、面積之慣性矩等。",
    "describe_eh": "This course is a prerequisite for Mechanics of Materials, Analysis and Design of Structures. Based on fundamental concepts of Physics and Mathematics, it contents the understanding of force and moment, solving of equilibrium problems of particles and rigid bodies, analysis of simple structures, learning of the centroid and moment of inertia of areas.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、PHYS1005普通物理(一)、PHYS1006普通物理(二)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、PHYS1005 GENERAL PHYSICS(1)、PHYS1006 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識與瞭解力與力矩。",
      "describe_en": "To understand the characteristics of force and moment."
    },
    {
      "seq": 2,
      "describe_ch": "應用力之特性分析質點與剛體之平衡問題。\n",
      "describe_en": "To solve the equilibrium problems of particles and rigid bodies. \n"
    },
    {
      "seq": 3,
      "describe_ch": "應用剛體平衡觀念分析簡單結構（桁架）。",
      "describe_en": "To analyze simple structures including truss and frames based on the concept of equilibrium."
    },
    {
      "seq": 4,
      "describe_ch": "建構形心及慣性矩之意義及計算。",
      "describe_en": "To construct and calculate the centroid and moment of inertia of areas."
    }
  ],
