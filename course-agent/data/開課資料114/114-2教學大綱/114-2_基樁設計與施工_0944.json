  "description": {
    "sub_id3": null,
    "sub_name": "基樁設計與施工",
    "sub_ename": "PILE DESIGN AND CONSTRUCTION",
    "describe_ch": "結構物之深基礎最常採用為基樁，本課程目標為讓學生瞭解基樁設計與施工之程序，從基樁之種類、樁長之決定、載重分析、應力分析、細部設計及載重試驗等之內容介紹，並輔以實務習作，最後使學生有能力設計與施工。",
    "describe_eh": "The pile design and Construction is useful for the design of structural foundations. This course is to let the student to know that the process of pile design and construction by following \"Types of Piles, To decide the length of piles, Loading analysis due to the upper structure, Stress analysis of piles, Details of pile design and construction, Pile loading test\". The student will have clear concept and ability to design and Construct when finished this course.",
    "pre_subname": "CE3077基礎工程、CE3073鋼筋混凝土(一)、CE3074鋼筋混凝土(二)",
    "pre_sub_id3": "CE3077",
    "pre_sub_ename": "CE3077 FOUNDATION ENGINEERING、CE3073 REINFORCED CONCRETE(1)、CE3074 REINFORCED CONCRETE(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解基礎與基樁之種類及其功能",
      "describe_en": "Comprehension for the type and function of foundations and piles"
    },
    {
      "seq": 2,
      "describe_ch": "能分析基樁承載垂直與水平載重能力及群樁折減效應",
      "describe_en": "To analyze the vertical and lateral bearing capacity of single pile, and the reduced coefficient of group piles"
    },
    {
      "seq": 3,
      "describe_ch": "能應用設計基樁所需鋼筋量及計算工程數量",
      "describe_en": "Application To design the required reinforcement of pile and to calculate the quantity of concrete and reinforcement of pile"
    },
    {
      "seq": 4,
      "describe_ch": "能評鑑基樁載重試驗結果",
      "describe_en": "Evaluation the result of pile loading test"
    }
  ],
