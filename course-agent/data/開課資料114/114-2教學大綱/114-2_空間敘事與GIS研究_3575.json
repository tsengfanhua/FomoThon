  "description": {
    "sub_id3": null,
    "sub_name": "空間敘事與GIS研究",
    "sub_ename": "SPATIAL NARRATIVES AND GIS STUDIES",
    "describe_ch": "「空間」是文學創作的重要元素之一，不論是歷時的更迭、地景的變化，或者在行旅移動過程中所產生的物質生活及情懷心境等，多會直接反映於文學作品以及日記、歌詞及影視作品。本課程透過行旅、移動、古道與地景等主題的研究分析，結合歷史空間與社會空間的人文互動，加入地景踏查進行研究考察，並使用GIS工具進行空間敘事之研究考察，訓練實務研究之基礎能力。",
    "describe_eh": "“Space” is a crucial element in literary creation. Whether expressed through temporal change, shifting landscapes, or the material experiences and emotional states that arise during travel, spatiality is often directly reflected in literary works, as well as in diaries, song lyrics, and visual media. This course explores themes such as travel, mobility, and landscape through analytical frameworks that integrate the humanistic interactions of historical and social spaces. Field investigations of local landscapes are incorporated to deepen spatial understanding, and GIS tools are applied to conduct research on spatial narratives. Through these methods, students will develop foundational skills for practical, research-oriented inquiry.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能具體分析文學作品中的各類空間議題並提出研究面向",
      "describe_en": "Able to analyze various spatial issues in literary works and propose research directions"
    },
    {
      "seq": 2,
      "describe_ch": "能使用數位工具將研究內容呈現於空間地圖或平台",
      "describe_en": "Digital tools can be used to present research content on spatial maps or platforms"
    }
  ],
