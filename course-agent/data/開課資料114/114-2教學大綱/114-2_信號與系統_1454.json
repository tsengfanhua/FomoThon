  "description": {
    "sub_id3": null,
    "sub_name": "信號與系統",
    "sub_ename": "SIGNALS AND SYSTEMS",
    "describe_ch": "使學生了解訊號與系統的觀念，在學了微積分及工程數學後，將其應用於訊號(Signal)與系統(System)的分析。此課程是一般專業課程的基礎，唯有對訊號與系統的基本觀念有深入的了解，方能更進一步從事設計。",
    "describe_eh": "To understand the basic concepts of signals and systems. To learn how to apply Calculus and Advanced Engineering Mathematics theories to analyze signals and systems. This is a basic course for some specialized courses, for instance, system analysis and system design.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解連續訊號與系統的基本觀念，對連續系統的基本觀念之深入探討，諸如:系統的線性與非線性，時變系統與非時變系統，穩定與不穩定等等。",
      "describe_en": "Basic concept of the continuous-time signal and system can be defined. Consider the detail concept of the continuous system, for instance linear and nonlinear, time-varying and time-invariant, stable and unstable."
    },
    {
      "seq": 2,
      "describe_ch": "能了解斷續訊號與系統的基本觀念，進而了解連續系統與斷續系統之間的轉換與應用。",
      "describe_en": "Basic concept of the discrete-time signal and system can be defined. The relation between continuous-time and discrete-time systems can be analyzed."
    }
  ],
