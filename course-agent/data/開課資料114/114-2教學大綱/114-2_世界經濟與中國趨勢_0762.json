  "description": {
    "sub_id3": null,
    "sub_name": "世界經濟與中國趨勢",
    "sub_ename": "WORLD ECONOMY AND THE MAJOR TRENDS OF CONTEMPORARY CHINA",
    "describe_ch": "什麼是〝有中國特色的社會主義市場經濟〞？中國大陸的發展與全球化的演變正快速改變二十一世紀的世界，本課程將從中國社會的特質、社會主義的轉型、世界經濟市場的變化三方面剖析世界經濟與大中華地區的發展趨勢與經營策略。",
    "describe_eh": "This course will analyze what is so-called〝A Socialist Market Economy with Chinese Characteristics〞from a global perspective.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
