  "description": {
    "sub_id3": null,
    "sub_name": "電力系統設計",
    "sub_ename": "POWER SYSTEM DESIGN",
    "describe_ch": "本課程講述涵蓋目前電力公司具有之發電、輸電與配電系統架構，包括:偶發性事故、短路故障及暫態穩定度，提供實際範例。同時，針對風力發電機組之數學模型，以利分析風機在電力系統之電力潮流及暫態穩定度。",
    "describe_eh": "This course covers the current generation, transmission and distribution system structure of power companies, including: episodic incidents, short circuit failures and transient stability, providing practical examples. A mathematical model for wind turbines is also presented to analyze the power flow and transient stability of wind turbines in the power system.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠理解與描述電力系統偶發性事故與成因",
      "describe_en": "Understand and describe the causes of episodic incidents in power systems."
    },
    {
      "seq": 2,
      "describe_ch": "能夠運用電力系統理論建構偶發性事故的數學模型",
      "describe_en": "Using power system theory to construct mathematical models for episodic incidents."
    },
    {
      "seq": 3,
      "describe_ch": "能夠計算電力系統短路故障電流，設計保護協調系統",
      "describe_en": "Ability to calculate short-circuit currents in power systems and design protection coordination systems."
    },
    {
      "seq": 4,
      "describe_ch": "能夠對電力系統暫態穩定度進行分析",
      "describe_en": "Ability to analyze transient stability of power systems."
    }
  ],
