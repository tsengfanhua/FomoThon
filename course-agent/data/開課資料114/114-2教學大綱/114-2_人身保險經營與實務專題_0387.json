  "description": {
    "sub_id3": null,
    "sub_name": "人身保險經營與實務專題",
    "sub_ename": "TOPICS ON LIFE INSURANCE OPERATION AND PRACTICE",
    "describe_ch": "本課程討論人壽保險公司經營與管理的各項議題，這些議題包括人壽公司的組織架構、行銷與通路、核保、理賠與保全，了解績效評量指標，以及財務管理、風險管理與資本管理等相關議題。",
    "describe_eh": "This course discusses a variety of functions related life insurers companies. These functions include distribution systems, underwriting, claim adjustment. In addition, this course will also cover performance measures of life insurers and investigates issues related to financial management and risk management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
