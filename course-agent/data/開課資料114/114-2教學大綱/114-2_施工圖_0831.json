  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CD01530",
    "sub_id": "26050",
    "scr_dup": "001",
    "sub_title": "施工圖的作用",
    "sub_title_en": null,
    "sub_describe": "施工圖是表達設計者的想法 用明確比例尺寸及材質說明達成(想法)跟(成品)的一些橋樑工具",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "施工圖",
    "sub_ename": "WORKING DRAWING",
    "describe_ch": "施工圖是一系列總圖與文字說明，表示建築物與室內空間如何由各種尺寸材料組構而成。所以正確的施工圖有安全及品質的建築物與空間的前提。",
    "describe_eh": "A working drawing is a drawing system which is made up by a series Architectural drawing and instruction. This system indicate the building is constructed through assemblage of different Size and types of materials. The correctness and completeness of working drawing can promise the qualities of a building or interior space.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "施工圖完整架構原則",
      "describe_en": "To introduce the basic principles of the working Drawing."
    },
    {
      "seq": 2,
      "describe_ch": "施工圖繪製觀念與技巧",
      "describe_en": " To teach the concepts and skills of the working drawing."
    },
    {
      "seq": 3,
      "describe_ch": "細部設計美學能里與施工技術的熟悉。",
      "describe_en": "To develop the detailed design knowledge and construction techniques."
    },
    {
      "seq": 4,
      "describe_ch": "指定適當尺度室內設計完成一套完整施工圖。",
      "describe_en": "To cultivate the ability to finish a set of working drawing according to an assignment."
    },
    {
      "seq": 5,
      "describe_ch": "查詢繪製施工圖說相關資訊，且能合宜運用之訓練。",
      "describe_en": "To train students to acquire the skills which can translate searched information into the working drawing appropriately."
    }
  ],
