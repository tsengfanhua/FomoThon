  "description": {
    "sub_id3": null,
    "sub_name": "5G應用與人文社會發展",
    "sub_ename": "5G APPLICATIONS IN HUMANITIES AND SOCIAL DEVELOPMENT",
    "describe_ch": "本課程旨在探索5G應用與現代社會的相互關聯，強調5G應用如何影響日常生活中的人際互動、社會發展、心理健康等議題，並以全人教育為核心，培養學生在科技進步中的人文素養和社會責任感。學生將學習如何將5G應用與社會發展相結合，並反思科技應用背後的人情溫度與人文關懷。",
    "describe_eh": "This course aims to explore the interconnection between 5G applications and modern society, emphasizing how 5G applications affect human interaction, social development, mental health and other issues in daily life, and takes whole-person education as the core to cultivate students' humanities literacy and social responsibility in the advancement of science and technology. Students will learn how to integrate 5G applications in the social development, and reflect on the human warmth and humanistic care behind technological applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培育學生掌握5G科技的基礎知識與應用場景",
      "describe_en": "To cultivate students to master the basic knowledge and application scenarios of 5G technology."
    },
    {
      "seq": 2,
      "describe_ch": "啟發學生理解並反思5G應用科技創新對人文社會發展的影響",
      "describe_en": "To inspire students to understand and reflect on the impact of 5G application technological innovation on the development of humanities and society."
    }
  ],
