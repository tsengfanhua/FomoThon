  "description": {
    "sub_id3": null,
    "sub_name": "都市計畫法令與實務案例運用",
    "sub_ename": "URBAN PLANNING LAWS AND PRACTICAL CASES APPLICATION",
    "describe_ch": "本課程依據計畫體系，講解都市土地與非都市土地使用相關之規劃、開發、建設與管制的法令，並補以實例說明，讓學生能夠了解各項法規的立法精神與應用。透過都市計畫實際案例的介紹和討論，分別就土地使用、交通運輸和公共設施等實質規劃之案例成果內容和規劃過程的考慮等層面，以及分期分區和財務計畫等非實質部分的規劃設計進行分析和研究。",
    "describe_eh": "This course is designed for students to understand the legal aspects and practical cases of Taiwan's urban and regional planning. Special attention is given to the role of urban and regional planning institutions for urban and regional development and the issues to be faced by cases in the practical domain.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解都市與區域計畫法令與制度之內涵。瞭解涉及都市及非都市土地規劃、開發與管制的相關議題及法規。",
      "describe_en": "Comprehend on the acts and regulations concerning to urban and non-urban land uses in planning, land development and control issues."
    },
    {
      "seq": 2,
      "describe_ch": "能培養學生都市與區域計畫法規應用能力，增強都市及區域計畫相關法規在規劃實務與規劃行政上的運用能力。",
      "describe_en": "Apply urban and regional planning regulations. Improve law application ability in planning practice and planning administration."
    },
    {
      "seq": 3,
      "describe_ch": "能分析案例課題獲得撰寫之綜合能力，能理解計畫本質和構成要素，具備計畫溝通之能力。",
      "describe_en": "Analysis of related issues on the practical cases. Comprehend on planning nature and acquire for the ability of planning communication."
    }
  ],
