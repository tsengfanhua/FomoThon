  "description": {
    "sub_id3": null,
    "sub_name": "機率論",
    "sub_ename": "PROBABILITY",
    "describe_ch": "本課程的主旨在於提供大學部學生了解機率原理的基本觀念及方法，因應更進一步有關機率、數學統計、及相關課程的進修。此課程的內容包括隨機變數、單與多重隨機變數的運算原理與方法、隨機程序、及隨機輸入的線性系統概論。",
    "describe_eh": "This course is designed to provide undergraduate students an understanding of the basic concepts and methods in probability theory needed for more advanced courses in probability, mathematical statistics and related subjects. The topics include the random variable, operations on single random variable and multiple random variables, random processes, and linear systems with random inputs.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、IEE1005線性代數",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、IEE1005 LINEAR ALGEBRA",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備機率學的基礎理論推導以及問題解決之知識能力。",
      "describe_en": "Possess the knowledge of theory derivation and problem solving in fundamentals of probability."
    },
    {
      "seq": 2,
      "describe_ch": "理解基本定理以及熟悉其應用。",
      "describe_en": "Comprehend fundamental principles and be familiar with their applications."
    }
  ],
