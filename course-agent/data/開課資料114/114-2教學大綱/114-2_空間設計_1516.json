  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE10119",
    "sub_id": "20995",
    "scr_dup": "001",
    "sub_title": "1. 空間構成元素 2. 空間分析框架 3. 空間感知與表現方法",
    "sub_title_en": null,
    "sub_describe": "本課程為低年級空間設計之入門課程，透過三個教學單元系統性層層剖析空間設計的形式與類型， 並透過實作學生能學習感知與紀錄空間。課程從單元一開始講解凱文林區(Kevin Lynch)空間形式的概念框架，讓學生能系統性認識空間元素與形構之多元性，而單元二著重於從自我的角度觀察空間，透過一系列工作坊讓學生能學習感知與觀察空間的技能。單元三是空間涵構與理論化的辯證，藉此整合前兩單元的學習成果。希望透過此三單元能培養學生對於空間的基本認知、表現與感知技法與批判思考能力。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "空間設計",
    "sub_ename": "SPATIAL DESIGN",
    "describe_ch": "本課程有系統的介紹空間設計相關的基本知識以及其在專業實務的應用方向，並提供學生了解學系就業市場方向。學生以創意實作的學習模式，建構後續環境規劃與設計的堅實基礎。",
    "describe_eh": "This course systematically introduces the basic knowledge of spatial design and thus the application in professional practice. The course is also intended to provide students further understanding of employment markets in urban planning.  Students are tra\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
