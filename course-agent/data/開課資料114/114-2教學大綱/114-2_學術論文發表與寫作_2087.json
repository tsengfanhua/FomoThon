  "description": {
    "sub_id3": null,
    "sub_name": "學術論文發表與寫作",
    "sub_ename": "BRIEFING AND WRITING FOR RESEARCH PAPERS",
    "describe_ch": "本課程著重提升研究所學生研讀英文的能力，透過指定科技報告，要求學生深讀、分析以及瞭解科技詞彙，本課程希望透過持續的練習，學生將具有口頭發表報告之能力。同時本課程也將介紹如何將研究成果轉為有組織的工程報告。相關教材主要集中在工程或科學領域的實驗性報告或畢業論文，也適合用於研究提案之寫作。",
    "describe_eh": "This course is designed to first promote graduate students' ability to peruse, read scientific articles written in English. In addition to analyzing the grammar, various styles and formats of scientific documents as well as the related terminology will be introduced to the students. It is hoped that through intensive practice of presentations, the students will be rendered the capability of presenting scientific studies. This course also provides instruction and practice in translating the research results into clear, well-organized reports. This course will focus primarily on writing of experimental research reports, theses, and dissertations in sciences and engineering. The material is also relevant for writing research proposals.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
