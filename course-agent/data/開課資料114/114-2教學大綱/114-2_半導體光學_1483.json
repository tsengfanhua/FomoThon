  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE09149",
    "sub_id": "11311",
    "scr_dup": "001",
    "sub_title": "半導體光學領域主要結合了「光學」與「半導體材料特性」，主要分為發光（如 LED、雷射）與受光（如影像感測器、太陽能電池）兩大類。",
    "sub_title_en": null,
    "sub_describe": "半導體光學課程規劃預定區分為：(一)光學、(二)半導體材料特性等二部分。授課內容包含：基礎光學原理、幾何光學、波動光學、電磁光學、量子光學等光學基礎，以及發光半導體(LED、雷射)、受光元件(影像顯示器)、半導體光學應用單元(微影製程以及矽光子技術、半導體製程將光學元件整合至矽晶圓)等半導體光學應用單元。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "半導體光學",
    "sub_ename": "OPTICS  IN SEMICONDUCTORS",
    "describe_ch": "許多半導體科技, 使用光學技術來做工業運用。 本課程介紹基本光學物理、光纖、光電系統與光電半導體元件, 及其在科技上之應用。",
    "describe_eh": "Introduction to optical physics, optoelectronic semiconductor devices, optoelectronic systems, and organic semiconductor devices.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具有基本光學物理知識。",
      "describe_en": "Knowledge of optical physics."
    },
    {
      "seq": 2,
      "describe_ch": "理解光電半導體元件之操作原理以及其中的光學物理現象。",
      "describe_en": "Comprehension of the fundamental knowledge of optoelectronic semiconductor devices and optical phenomenon in the devices."
    }
  ],
