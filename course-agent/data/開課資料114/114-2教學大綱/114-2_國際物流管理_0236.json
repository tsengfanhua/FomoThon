  "description": {
    "sub_id3": null,
    "sub_name": "國際物流管理",
    "sub_ename": "INTERNATIONAL LOGISTICS MANAGEMENT",
    "describe_ch": "企業需要有效的物流，以確保擁有能在市場上成功競爭的資源，國際物流管理是一套如何整合供應商、製造商、零售商、倉儲業者，提供在正確時間供給正確數量給顧客，期望能以最低成本，達成顧客的服務水準。",
    "describe_eh": "The application of logistic is very important to manage the supply chain, and the enterprise need an efficient logistic to ensure to possess the resource which has competency in the market. International logistics is a set of approaches utilized to efficiently integrate suppliers, manufacturers, warehouses, and stores, so that merchandise is produced and distributed at the right quantities, to the right locations, and at the right time, in order to minimize system-wide costs while satisfying service level requirements.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂國際物流管理。",
      "describe_en": "Define international logistics management with their own words."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明整合供應鏈管理對價值鏈上企業的影響與效益。",
      "describe_en": "Understand and be able to explain the efficiency and effects to the enterprises in the integrated supply chain."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解快速回應顧客需求的重要性及能說明在組織管理資訊流動及創造資訊看得見的需求。",
      "describe_en": "Understand the importance of quickly response customer requirements and be able to explain the needs of managing information flows and creating information visibility within the organization."
    },
    {
      "seq": 4,
      "describe_ch": "籍由實際管理個案，瞭解企業物流實務。",
      "describe_en": "Understand logistics practice by real cases."
    },
    {
      "seq": 5,
      "describe_ch": "瞭解物流系統的組成，以及各系統間的關聯和交互影響。",
      "describe_en": "Understand the components of logistics systems and interrelationships and interactions among the components."
    }
  ],
