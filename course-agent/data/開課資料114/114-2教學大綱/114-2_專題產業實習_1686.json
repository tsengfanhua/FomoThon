  "description": {
    "sub_id3": null,
    "sub_name": "專題產業實習",
    "sub_ename": "PROJECT-COOPERATIVE INDUSTRY INTERNSHIP",
    "describe_ch": "本課程開設於四年級下學期，提供學生至自控相關產業進行實習的機會，經由遴選讓學生到合作的機構服務，透過實務的練習加強專業技能，其目的在加強理論與實務的整合，提供實際的工作經驗來培訓學生將來成為自控專業人才，以提升未來就業和職涯競爭力。",
    "describe_eh": "The course was opened in the 4th grade 2nd semester to offer students a practical training opportunity in the automation related industry. Recommended students will gain practical experience to improve professional skills as part of their services in the participating organizations. It aims to enhance the integration of theory and practice, train students to acquire work experience in real work environments.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 9.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "強化學生的專業技能在實務上的應用",
      "describe_en": "To strengthen students' professional skills in real-world applications."
    },
    {
      "seq": 2,
      "describe_ch": "讓學生學習職場的溝通協調與團隊合作之能力",
      "describe_en": "To encourage students to learn effective workplace communication and teamwork strategies."
    },
    {
      "seq": 3,
      "describe_ch": "培育學生具備終身學習、專業倫理及社會責任的基本素養",
      "describe_en": "To cultivate students’ possession of life-long learning capabilities, professional ethics and social responsibilities."
    },
    {
      "seq": 4,
      "describe_ch": "培養學生解決整合性工程問題。",
      "describe_en": "To develop students’ capabilities of solving integrated engineering problem."
    }
  ],
