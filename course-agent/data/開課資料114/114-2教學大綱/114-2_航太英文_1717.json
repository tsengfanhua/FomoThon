    {
      "seq": 1,
      "describe_ch": "了解航太基本知識，如飛行原理、飛機系統等",
      "describe_en": "To have a basic knowledge of the aerospace engineering"
    },
    {
      "seq": 2,
      "describe_ch": "認識基本英文文法及寫作格式",
      "describe_en": "To understand the basic English grammar and writing format"
    },
    {
      "seq": 3,
      "describe_ch": "熟悉航太專業英文字彙、片語及用語",
      "describe_en": "To get familiar with the professional vocabulary, phrases and terminology"
    },
    {
      "seq": 4,
      "describe_ch": "具備基本航太專業英文閱讀與聽的能力",
      "describe_en": "To be able to carry out reading of professional English articles in aerospace engineering"
    }
  ],
