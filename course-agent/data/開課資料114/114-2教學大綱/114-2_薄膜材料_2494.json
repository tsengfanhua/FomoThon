  "description": {
    "sub_id3": null,
    "sub_name": "薄膜材料",
    "sub_ename": "THIN FILM MATERIALS",
    "describe_ch": "以薄膜技術與材料分析為基礎，深化探討薄膜材料之應用。課程針對鍍膜技術與薄膜材料概述，其中包含電漿技術對於薄膜材料特性的影響、薄膜材料分析與應用發展。",
    "describe_eh": "Thin-film technology and materials analysis is based on Deepening of the application of thin film materials. The course focuses on an overview of coating technology and thin film materials, including the influence of plasma technology on the characteristics of thin film materials, the analysis and application development of thin film materials.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識薄膜成長機制，瞭解薄膜生長起始條件、成長理論及生長過程。\t",
      "describe_en": "To understand the film growth steps of surface adsorption, diffusion, nucleation and structure development."
    },
    {
      "seq": 2,
      "describe_ch": "描述、理解並分辨物理氣相沈積及化學氣相沈積等薄膜製作技術。\t",
      "describe_en": "To understand all kinds of thin film deposition principles and technology, PVD and CVD especially.ㄒ"
    },
    {
      "seq": 3,
      "describe_ch": "熟知各項薄膜的基本性質，如薄膜之力學性質、光學性質、電學性質、磁學性質等，並能對薄膜之各項特性進行檢測與評估。\t",
      "describe_en": "To measure and estimate thin film mechanical, electrical, optical, and magnetic properties."
    },
    {
      "seq": 4,
      "describe_ch": "使能夠呈現研究結果並清楚地說明專業的解釋。\t",
      "describe_en": "Be able to present the study results and elucidate the professional solution clearly."
    }
  ],
