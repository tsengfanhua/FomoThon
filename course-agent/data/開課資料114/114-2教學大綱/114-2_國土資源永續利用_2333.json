  "description": {
    "sub_id3": null,
    "sub_name": "國土資源永續利用",
    "sub_ename": "SUSTAINABLE USE OF LAND RESOURCES",
    "describe_ch": "以聯合國十七項永續發展目標(SDGs)為基礎，探討社會發展架構，實現糧食安全，改善營養狀況和促進永續農業，為所有人提供水資源衛生及進行永續管理。確保人人負擔得起、可靠和永續的現代能源。妥善利用現代先進科技，建設具防災能力的基礎設施，促進具包容性的永續工業化及推動創新。\r\n\r\n",
    "describe_eh": " Based on the UN's 17 Sustainable Development Goals (SDGs), it explores the framework for social development to achieve food security, improve nutrition and promote sustainable agriculture, water sanitation and sustainable management for all. Ensuring affordable, reliable and sustainable modern energy for all. Based on the modern advanced technology to build resilient infrastructure, promote inclusive and sustainable industrialization and drive innovation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "永續發展目標(SDGs)的知識性，理解各目標的意涵，並針對遙感探測技術應用於地球資源監控技術與資訊剖析的技術。\t",
      "describe_en": "Knowledge of the Sustainable Development Goals (SDGs), understanding of the meaning of each goal, and the application of remote sensing detection technology to earth resources monitoring technology and information analysis technology."
    },
    {
      "seq": 2,
      "describe_ch": "整合異質資訊並綜合應用於永續發展目標。\t",
      "describe_en": "Integrate heterogeneous information and apply it comprehensively to sustainable development goals."
    }
  ],
