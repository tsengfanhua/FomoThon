  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解人文精神，培養批判與反思能力。",
      "describe_en": "To understand the core meaning of general education and humanistic values, and cultivate critical and reflective thinking."
    },
    {
      "seq": 2,
      "describe_ch": "設計教學實作，回應社會需求，促進跨校共學。",
      "describe_en": "To apply learning to teaching practice and design, addressing social needs and promoting interdisciplinary and inter-school collaboration."
    }
  ],
