  "description": {
    "sub_id3": null,
    "sub_name": "功能性紡織品製程評估",
    "sub_ename": "THE PROCEDURE OF FUNCTIONAL TEXTILES",
    "describe_ch": "培育學生充分學習並瞭解功能性紡織品的製程設計及其加工方法，進而訓練因應滿足紡織品功能性需求選取相關材料的專業知識，使學生具備各式功能性紡織品開發設計及其製程最佳化評估和製備的能力",
    "describe_eh": "To learn and understand the process design and methods, physical and chemical properties of functional textiles, and to possess the abilities about development and design of functional textiles and evaluation of optimal processes.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
