  "description": {
    "sub_id3": null,
    "sub_name": "功能性高分子材料特論",
    "sub_ename": "SPECIAL TOPICS IN FUNCTIONAL POLYMER MATERIALS",
    "describe_ch": "本課程目的在於介紹功能性高分子材料。知識部分包含功能性高分子材料導論、生物可分解性高分子、顯示器用高分子特性與機理、功能性高分子分析法與能源用高分子等。輔以課堂報告與文獻回顧，以增進學習成效。",
    "describe_eh": "The purpose of this course is to introduce functional polymer materials. The knowledge part includes introduction to functional polymer materials, biodegradable polymers, properties and mechanisms of polymers for displays, functional polymer analysis methods, and polymers for energy end-uses. This course is supplemented by class reports and literature review to enhance learning effectiveness.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習並熟悉高分子材料功能性之原理",
      "describe_en": "Being familiar with the principles of Polymer functionality."
    },
    {
      "seq": 2,
      "describe_ch": "理解功能性高分子材料在工程及學理上之重要性。",
      "describe_en": "Comprehension for the importance of functional polymer material to academia and engineering."
    },
    {
      "seq": 3,
      "describe_ch": "訓練學生對高分子功能性之相關文獻及資料具有基本之解讀及研判能力。",
      "describe_en": "Training the skills of literature review and survey for polymer functionality related reports and information."
    },
    {
      "seq": 4,
      "describe_ch": "學習以書面或者口頭報告之溝通方式，對於所獲之技術論文及研發結果進行清楚陳述溝通。",
      "describe_en": "Learning the communication skills to convey the information of technical papers and research results to others."
    }
  ],
