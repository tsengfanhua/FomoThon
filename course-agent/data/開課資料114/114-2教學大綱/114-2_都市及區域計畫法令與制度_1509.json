  "description": {
    "sub_id3": null,
    "sub_name": "都市及區域計畫法令與制度",
    "sub_ename": "URBAN AND REGIONAL PLANNING LAWS AND SYSTEM",
    "describe_ch": "都市及區域計畫法為從事都市與區域規劃的準繩。本課程將從法的基本觀念與原則著手，再依據計畫體系，講解都市土地與非都市土地使用相關之規劃、開發、建設與管制的法令，並補以實例說明，讓學生能夠了解各項法規的立法精神與應用。",
    "describe_eh": "As the guideline of planning practice program, urban and regional planning law is most important to students of urban planning. It is expected to develop students' understanding the basic concepts and principles of planning laws and regulation. To built students' comprehension on the acts and regulations concerning to urban and non-urban land use in planning, and land development control system. To further develop students' understanding of the legislative intent of planning acts and regulations via case studies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識都市及區域計畫相關法規系統的架構與層級。",
      "describe_en": "Recognize the framework and hierarchy of law system relative to urban and regional planning."
    },
    {
      "seq": 2,
      "describe_ch": "辦認各相關計畫法規的立法精神與目的。",
      "describe_en": "Identify the legislative spirit and purpose of each planning act and regulation."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解涉及都市及非都市土地規劃、開發與管制的相關法規。",
      "describe_en": "Comprehend on the acts and regulations concerning to urban and non-urban land use in planning, land development and control."
    }
  ],
