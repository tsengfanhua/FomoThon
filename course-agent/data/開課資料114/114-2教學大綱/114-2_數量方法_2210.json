  "description": {
    "sub_id3": null,
    "sub_name": "數量方法",
    "sub_ename": "QUANTITATIVE METHODS",
    "describe_ch": "本數量方法之內容，主要在探討多變量分析，而多變量分析是在討論自變數與應變數間關係的統計方法，而關係的型態主要可分為相依與互依兩大類，本課程在介紹如何使用多變量分析來研究商業與管理相關的問題。",
    "describe_eh": "Quantitative Analysis, Mainly here refers to Multivariate Analysis, is a statistical methodology that examines possible relationship among multiple dependent and interdependent variables. Students will learn how to use this methodology in business-related research.",
    "pre_subname": "STAT1001統計學(一)、STAT1002統計學(二)",
    "pre_sub_id3": "STAT1001",
    "pre_sub_ename": "STAT1001 STATISTICS(1)、STAT1002 STATISTICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能暸解並說明多變量分析在商業活動的重要性與影響",
      "describe_en": "Understand and be able to explain the importance and effects of multivariate analysis to business activities."
    },
    {
      "seq": 2,
      "describe_ch": "能使用統計軟體完成統計資料分析，並由結果歸納出適當結論",
      "describe_en": "Be able to use statistical packages to accomplish a real data analysis, and draw appropriate conclusions from the reporting of data analysis."
    }
  ],
