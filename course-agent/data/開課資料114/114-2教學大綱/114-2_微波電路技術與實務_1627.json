  "description": {
    "sub_id3": null,
    "sub_name": "微波電路技術與實務",
    "sub_ename": "MICROWAVE CIRCUITS TECHNOLOGIES AND EXPERIMENTS",
    "describe_ch": "本課程將介紹微波電路應用與分析所需要的基礎技術與實務，包括阻抗匹配器、功率分配器、方向耦合器與濾波器等，期增進微波電路實驗模擬分析與實作應用能力。",
    "describe_eh": "The fundamental techniques and experiments in the microwave circuit applications and analyses are introduced in this course, including impedance matching networks, power dividers, directional coupler and filters etc. This course also aims to enhance the ability to apply simulation, analysis, and implementation of microwave circuit.",
    "pre_subname": "EEEN6075微波工程、EEEN6005高等電磁理論(一)、EEEN3014高頻電路概論",
    "pre_sub_id3": "EEEN6075",
    "pre_sub_ename": "EEEN6075 MICROWAVE ENGINEERING、EEEN6005 ADVANCED ELECTROMAGNETIC THEORY(1)、EEEN3014 INTRODUCTION TO RADIO FREQUENCY CIRCUIT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠瞭解微波電路應用中所需被動元件電路的功能及操作原理",
      "describe_en": "Understand the functions and the operational principles of the required passive elements and circuits in microwave circuit applications."
    },
    {
      "seq": 2,
      "describe_ch": "能夠運用相關的設計技術於微波電路應用中",
      "describe_en": "Be able to apply the relative design techniques in microwave circuit applications."
    },
    {
      "seq": 3,
      "describe_ch": "能夠培養學生於電波實驗室以獨立動手模擬分析與實作方式學習，以增進模擬分析與實作經驗，並印證及應用相關微波電路理論",
      "describe_en": "To cultivate the students to perform simulation and hands-on practical work independently in the electromagnetic wave laboratory, so that the microwave circuit theories can be proven and applied by further studying both the simulation"
    }
  ],
