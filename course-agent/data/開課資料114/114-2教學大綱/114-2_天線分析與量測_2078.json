  "description": {
    "sub_id3": null,
    "sub_name": "天線分析與量測",
    "sub_ename": "ANTENNA ANALYSIS AND MEASUREMENT",
    "describe_ch": "透過修習本課程，將使同學們深入了解天線的工作原理與特性參數、陣列天線之基本理論與分析設計、天線量測方法、以及數種常見天線之工作原理及其特性異同。",
    "describe_eh": "Through taking this course will enable students to understand working principle and characteristics of the antenna parameters, the basic theory, analysis, and design on antenna and array, antenna measurement methods, as well as several kinds of common principles and characteristics of the antenna of the similarities and differences.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能具備天線的專業知識與量測能力，理解天線的設計參數。",
      "describe_en": "Be able to obtain knowledge and measurement capabilities of the antenna, understand the antenna design parameters."
    },
    {
      "seq": 2,
      "describe_ch": "能運用模擬軟體進行天線之設計與分析，並搭配量測方法進行評估。",
      "describe_en": "The simulation tool can be used to design and analyze the antenna, and the measurement method is used for evaluation."
    },
    {
      "seq": 3,
      "describe_ch": "能綜合天線之知識，完成應用於無線通訊的天線專案設計。",
      "describe_en": "Be able to apply antenna knowledge to finish a project of antenna design."
    }
  ],
