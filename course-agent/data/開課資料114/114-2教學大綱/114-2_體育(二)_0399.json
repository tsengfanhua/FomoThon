  "description": {
    "sub_id3": null,
    "sub_name": "體育(二)",
    "sub_ename": "PHYSICAL EDUCATION(2)",
    "describe_ch": "建立興趣選項課程，探索與培養學生的運動興趣，幫助學生瞭解各項運動相關歷史文化、規則，運動與營養補給的重要性，運動傷害的預防及復健，運動訓練處方的建構，期能經由團體運動模式，使學生學習互助合作，強化學生群育發展。",
    "describe_eh": "By offering students a variety of optional courses, we can motivate students to explore themselves and make exercise a habit. In addition, students get to know the histories, cultures, and rules of different sports; to know the importance of exercise and nutrition supplements, prevention and rehabilitation of sports injuries, and structures of sports training. Hopefully, via team sports, we can help students learn to cooperate with one another and strengthen their development of group education.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "拓展運動學習領域，養成終身運動的習慣，進而提高整體生活品質。",
      "describe_en": "To expand the field of sports learning, make lifelong exercising a habit, and enhance students’ overall life quality."
    }
  ],
