  "description": {
    "sub_id3": null,
    "sub_name": "結構智慧監測",
    "sub_ename": "SMART STRUCTURAL MONITORING",
    "describe_ch": "本課程涵蓋結構工程領域核心概念的課程，旨在探討結合先進科技和智慧監測技術，以提高結構物健康狀態監測和管理的方法，並與國外大學合作，共同教學，提升學生對智慧監測的能力。本課程必須參加國外教學課程(需出國)，若不參與者，勿選此課。",
    "describe_eh": "This course covers core concepts in structural engineering and explores the integration of advanced technology and smart monitoring techniques to enhance structural health monitoring and management methods. Through collaborative teaching with international universities, the course aims to improve students' capabilities in smart monitoring. International course participation (overseas learning required) is mandatory for this course; students who cannot participate in the international component don’t add this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解結構健康監測之基本原理與系統架構。",
      "describe_en": null
    },
    {
      "seq": 2,
      "describe_ch": "認識感測技術與資料分析於結構安全評估中的應用。",
      "describe_en": null
    },
    {
      "seq": 3,
      "describe_ch": "透過國際移地教學拓展視野，並培養跨文化學習與應用能力。",
      "describe_en": null
    }
  ],
