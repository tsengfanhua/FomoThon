  "description": {
    "sub_id3": null,
    "sub_name": "建築環境模擬評估",
    "sub_ename": "MODELLING ENVIRONMENTAL PERFORMANCE",
    "describe_ch": "本課程以數位評估為主軸，運用數位軟體分析模擬建築環境，解釋所依據的設計工具的參數原理，探討建築物理環境對空間舒適度的影響，讓學生了解建築設計策略如何影響耗能。冀希培養學生在設計的過程中，能夠運用數值分析及三維數位模型來評估設計成果的適切性，並進一步提出優化方案的設計策略。",
    "describe_eh": "This module introduces analysis tools that may be used to explore the environmental behavior of buildings and develops students’ ability to apply these to understanding the relationship between building design and building performance. The underlying principles upon which the design tools are based are explained and approaches for identifying appropriate design strategies and performance targets reviewed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠理解建築物理環境與建築耗能之間的關係。",
      "describe_en": "Understand the relationship between built environment and energy consumption."
    },
    {
      "seq": 2,
      "describe_ch": "能應用數位評估方法來提出改善方案。",
      "describe_en": "Apply analysis tools to propose improved solutions."
    },
    {
      "seq": 3,
      "describe_ch": "能以書面或口頭方式將所獲得結果與同儕及教師溝通。",
      "describe_en": "Communicate results in written and oral form to classmates and the instructor."
    }
  ],
