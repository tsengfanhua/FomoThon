  "description": {
    "sub_id3": null,
    "sub_name": "纖維染色整理實習",
    "sub_ename": "FIBER DYEING AND FINISHING PRACTICE",
    "describe_ch": "為培養學生纖維染整技術之能力，特將重點置於基本原理的說明與應用，並選擇具有代表性的實驗項目，詳述實驗步驟，並進行實驗結果的討論，期使學生對纖維染整技術的操作，得以獲得全面性且深入的了解，不僅知其然，亦知其所以然。",
    "describe_eh": " In order to cultivate students' ability in fiber dyeing and finishing technology, the emphasis is placed on the explanation and application of basic principles. The representative experimental projects are selected in this course. The experimental procedures are detailed and the results of the experiment are discussed. Operation, to obtain a comprehensive and in-depth understanding, not only knowing what is happening, but also knowing why.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用纖維染整的能力培養實作之基本能力。",
      "describe_en": "Cultivate the basic ability of fiber dyeing and finishing."
    },
    {
      "seq": 2,
      "describe_ch": "強調各種染料在纖維紡織著色技巧之應用，以更進一步了解各類型染料特性及染色行為之相關特性。",
      "describe_en": "Emphasize the application of various dyes in fiber textile coloring techniques, and understand the characteristics of various types of dyes and related characteristics of dyeing behavior."
    },
    {
      "seq": 3,
      "describe_ch": "強調各種染整助劑在纖維紡織賦予機能性技巧，並了解各類型染整助劑特性及賦予機能性紡織品技巧之應用。",
      "describe_en": "Emphasize various dyeing and finishing auxiliaries imparting functional skills in fiber textiles, and understand the characteristics of dyeing and finishing auxiliaries and the application of functional textile skills."
    }
  ],
