  "description": {
    "sub_id3": null,
    "sub_name": "水質分析實驗",
    "sub_ename": "EXPERIMENT OF WATER QUALITY ANALYSIS",
    "describe_ch": "針對常見水質項目:溶氧、生化需氧量、化學需氧量、氨氮、固體物、鐵、錳、 氟化物、硫酸鹽、磷酸鹽。學生分組進行實驗操作、數據分析及撰寫實驗報告。",
    "describe_eh": "For water quality projects: dissolved oxygen, biochemical oxygen demand, chemical oxygen demand, ammonia nitrogen, solids, iron, manganese, fluoride, sulfates, phosphates. Students work in groups for experiments, data analysis, and write lab reports.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.了解水資源水質分析原理與實驗方法　\r\n",
      "describe_en": "1. Fundamental knowledge of water quality analysis methods."
    },
    {
      "seq": 2,
      "describe_ch": "2學習水質分析技術及數據分析能力。　\t",
      "describe_en": "2. Experimental skills in water quality analysis for water pollution control and wastewater treatment.　"
    }
