  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB07310",
    "sub_id": "65060",
    "scr_dup": "001",
    "sub_title": "教學目標：是希望在借款、貸款時，計算每月攤還的利息、本息，以及複利計息效應的分析。",
    "sub_title_en": null,
    "sub_describe": "學習本門課後會有年金的概念，以及可以回應下列幾個主題：\n1. 每月繳交8000元，25年後，假設利率為4%時，每月可領回多少?\n2. 考慮五年後買房，預計自備款80萬，假設在利率為4%時，每月應該存多少?\n3. 若希望65歲退休後，每月能定期領6萬元至85歲，假設從25歲開始工作，每月應該存多少?假設退休前的利率是4%, 退休後的利率為1.5%",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "複利數學",
    "sub_ename": "THEORY OF INTEREST",
    "describe_ch": "應用基本微積分、複利函數到離散年金以及有關財務之量化評價並介紹EXCEL在財務上之應用，研討如何利用運用基礎數學與微積分的演算，解決資金之時間價值、投資報酬率、年金及債券等與利率相關之財務問題。",
    "describe_eh": "Have a practical knowledge of the theory of interest in both finite and continuous time and apply the concepts of present and accumulated value for various streams of cash flows as a basis for reserving, valuation, pricing, duration, asset/liability management, investment income, capital budgeting, and contingencies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解利率學的基本定義和其他相關金融市場的名詞介紹。",
      "describe_en": "To understand the definitions of interest, and introduction some terms of banking market."
    },
    {
      "seq": 2,
      "describe_ch": "介紹基本年金的重要性和其相關的定義、演算過程，與介紹一般年金。",
      "describe_en": "To understand the importance of annuities, and its definition and formula, extend to introduction the general annuity."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解投資收益，分期償還，債券基金與及其他債券之相關的觀念",
      "describe_en": "To understand the yield of the investment, and other topics about the securities."
    }
  ],
