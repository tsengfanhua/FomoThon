  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE03140",
    "sub_id": "46870",
    "scr_dup": "001",
    "sub_title": "都市計畫與國土計畫",
    "sub_title_en": null,
    "sub_describe": "都市計畫係指在一定地區內有關都市生活之經濟、交通、衛生、保安、國防、文教、康樂等重要設施，作有計畫之發展，並對土地使用作合理之規劃而言。都市計畫的目的在於改善居民生活環境，並促進市、鎮、鄉街有計畫之均衡發展。國土計畫則是因應氣候變遷，確保國土安全，保育自然環境與人文資產，促進資源與產業合理配置，強化國土整合管理機制，並復育環境敏感與國土破壞地區，追求國家永續發展。\n都市規劃(泛指都市計畫、區域計畫、國土計畫等等)是一門綜合應用性的學科，藉由調和各種土地使用的發展，合理安排人與經濟活動的空間分布，適當引導與管理都市、區域與國土的成長，提升土地資源使用效能，並促成環境永續發展。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "都市計畫學",
    "sub_ename": "URBAN PLANNING",
    "describe_ch": "都市的主體是「人」，都市計畫即是以人為本的綜合性環境改善計畫。學習都市計畫，首先應分辨「計畫」與「規劃」之不同，並能區別「主要計畫」與「細部計畫」的差異。都市計畫學是一門有趣的實用科學，可幫助學生認識並珍愛我們的生活空間。",
    "describe_eh": "The heart of the city is the living people. Urban Planning is a comprehensive improvement plan that we should know. We will understand the meaning of Urban Planning from this now on. The first issue of this topic is to tell \"plan\" from \"planning\". It is certainly important to distinguish between \"master plan\" and \"site plan\". Studying Urban Planning is very interesting, and very useful. We will make it a better place through Urban Planning.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "都市計畫的定義：能夠描述重要的土地使用種類及其限制,瞭解並說明都市計畫在建築管理及國土計畫層面的重要性及影響",
      "describe_en": "Define Urban Planning: Be able to describe land use form and limitations. Understand and be able to explain the importance and effects of Urban Planning to architecture and land use administration."
    }
  ],
