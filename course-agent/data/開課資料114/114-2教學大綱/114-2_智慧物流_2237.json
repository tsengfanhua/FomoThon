  "description": {
    "sub_id3": null,
    "sub_name": "智慧物流",
    "sub_ename": "INTELLIGENT LOGISTICS",
    "describe_ch": "介紹物流系統之基本理論與應用，期望能加強學生應用大數據、雲端、物聯網等先進技術，予以設計及應用於實務之物流體系",
    "describe_eh": "This course introduces the basic theories and applications of logistic systems. The objectives of this course would like to enhance students’ abilities for the applications of advanced technologies of Big Data, Cloud, and Internet of Things in the practical fields of logistics.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 4.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "3.教授相關先進科技與技術於運輸或物流領域之應用潛力與案例",
      "describe_en": "3. Provide students with knowledge of the potential applications and case studies of advanced technologies and techniques in the transportation and logistics field."
    },
    {
      "seq": 2,
      "describe_ch": "7.培養學生運用資訊科技或分析軟體處理實務問題之能力",
      "describe_en": "7. Develop students' ability to apply information technology and analytical software to solve practical problems."
    },
    {
      "seq": 3,
      "describe_ch": "8.培養學生運用資料調查、數據分析或數學模型分析運輸或物流問題之能力",
      "describe_en": "8. Develop students' ability to analyze transportation and logistics problems using data collection, data analysis, or mathematical models."
    }
  ],
