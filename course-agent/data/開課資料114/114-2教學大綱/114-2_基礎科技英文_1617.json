  "description": {
    "sub_id3": null,
    "sub_name": "基礎科技英文",
    "sub_ename": "BASIC ENGLISH FOR TECHNOLOGY",
    "describe_ch": "本課程採用漸進式之英文寫作方法，著重於教導學生如何使用英文暨專業用語，撰寫其相關專業領域的學術性論文，奠定科技英文的重要基礎。",
    "describe_eh": "This course is lectured by way of successive writing methodology for research paper. Senior students examine a variety of research methods and relevant applications to their own expertise research. The class will have a practical component that involves student's performing appraisal and analysis of technological articles ever published in their chosen field. It will eventually facilitate senior students the gateway to paper published in their research field in the graduate school future.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能正確用英文來闡述、表達研究問題。",
      "describe_en": "Be able to formulate a research question in correct, regular phrasing in English language."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解如何應用英文描述搜集資料的方法。",
      "describe_en": "Show an understanding of how to outline methods for data collection that follow correct guidelines in research."
    },
    {
      "seq": 3,
      "describe_ch": "整合上述的綱要並依據所需的格式，完成科技學術論文撰寫並進行發表。",
      "describe_en": "Be able to integrate the elements outlined above into a coherent form that helps for writing technology research papers to be published."
    }
  ],
