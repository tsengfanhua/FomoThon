  "description": {
    "sub_id3": null,
    "sub_name": "感測元件",
    "sub_ename": "SENSOR DEVICES",
    "describe_ch": "本課程主要內容為介紹CMOS影像感測器(CMOS Image Sensor, CIS)之架構、原理、像素元件電路、參數特性、訊號處理及相關之半導體製程。\r\n本課程可作為日後從事影像感測器相關研究或開發之基礎知識。\r\n",
    "describe_eh": "Major course content will focus on the sensor structure, operation principles, pixel device design and characteristics, pixel signal processing, as well as fabrication process of CMOS Image Sensor(CIS) device.\r\nLearning of the  course content can be served as basic knowledge for development and research of CIS related activities in the future.\r\n",
    "pre_subname": "IECS2002電子學、ELEN2002電子學(一)、ELEN2008電路學(一)",
    "pre_sub_id3": "IECS2002",
    "pre_sub_ename": "IECS2002 ELECTRONICS、ELEN2002 ELECTRONICS(1)、ELEN2008 CIRCUIT THEORY(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解CMOS影像感測器的運作原理、像素元件及像素電路設計",
      "describe_en": "Understand CMOS image sensor operation principle, pixel device and circuit design"
    },
    {
      "seq": 2,
      "describe_ch": "運用CMOS影像感測器元件特性，應用於滑鼠、測距、追蹤領域之產品開發",
      "describe_en": "Base on CMOS image sensor property,  study development of product application such as Mouse、distance measurement 、object tracking, etc."
    }
  ],
