  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂工程數學：能夠描述重要的工程數學原理；能辨識出可使用工程數學原理的場合，並能清楚表達",
      "describe_en": "Define Engineering Mathematics with students own words: Be able to describe important principles of Engineering Mathematics . Distinguish and make clear statement where Engineering Mathematics can be used."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明工程數學在其他學科的重要性及影響",
      "describe_en": "Understand and be able to explain the importance and effects of Engineering Mathematics"
    },
    {
      "seq": 3,
      "describe_ch": "規劃系統整合之能力",
      "describe_en": "Be able to plan integrated Systems."
    },
    {
      "seq": 4,
      "describe_ch": "設計、執行實驗與數據分析，及製商整合的能力。",
      "describe_en": "Be able to analyze experimental data and integrated systems."
    }
  ],
