  "description": {
    "sub_id3": null,
    "sub_name": "鋼筋混凝土房屋設計",
    "sub_ename": "DESIGN OF REINFORCED CONCRETE BUILDING",
    "describe_ch": "使學生能將鋼筋混凝土學中所學得梁、柱、基礎與版之單元件加以組合設計，成為整體之房屋結構設計，同時配合套裝軟體之程式設計教學，使得鋼筋混凝土房屋結構設計邁向自動化。",
    "describe_eh": "The aim of the course is to teach students how to combine the elements of beams, columns, foundation, and slabs in the design of reinforced concrete buildings.  The course is further supplemented with the aid of package software to automate the design of RC buildings.",
    "pre_subname": "CE2070結構學(一)、CE3071結構學(二)、CE3073鋼筋混凝土(一)、CE3074鋼筋混凝土(二)",
    "pre_sub_id3": "CE2070",
    "pre_sub_ename": "CE2070 STRUCTURAL THEORY(1)、CE3071 STRUCTURAL THEORY (2)、CE3073 REINFORCED CONCRETE(1)、CE3074 REINFORCED CONCRETE(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
