  "description": {
    "sub_id3": null,
    "sub_name": "會計學(一)",
    "sub_ename": "ACCOUNTING(1)",
    "describe_ch": "本課程介紹基本會計學原則及觀念，主要包括：會計恆等式、交易分析、會計分錄、調整分錄、結帳分錄、會計循環、財務報表、買賣業會計、存貨、現金與內部控制。 \r\n\r\n",
    "describe_eh": "This course introduces basic accounting principle and concepts. The main topics include accounting equation, transaction analysis, journal entry, adjustment entry, closing entry, accounting cycle, financial statements, merchandising accounting, Inventory, cash and internal control 。",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂會計學(1)：能描述會計學(1)涵蓋的主要內容，描述現代企業的財務報表及其限制，企業財務狀況的分析。",
      "describe_en": "Students can definition of Accounting I.  They also are able to describe the content of Accounting I.  They can portray modern business financial statements and their limitations.  They have enough capability to analysis company's financial situation."
    },
    {
      "seq": 2,
      "describe_ch": "能了解並說明會計在社會及經濟層面的重要性及影響。",
      "describe_en": "Students are able to realize and portray the importance and influence of accounting in society and economic aspects."
    },
    {
      "seq": 3,
      "describe_ch": "能辯識出可應用會計學原理的場合，並能清楚表達。",
      "describe_en": "They can identify and clearly express the application accounting principle situation."
    }
  ],
