      "seq": 3,
      "describe_ch": "了解感測技術之相關原理\t",
      "describe_en": "Understanding the Principles of Sensing Technologies"
    },
    {
      "seq": 4,
      "describe_ch": "發展新型態分析感測技術\t",
      "describe_en": "Developing Novel Analytical Sensing Technologies"
    }
