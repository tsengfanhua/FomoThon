  "description": {
    "sub_id3": null,
    "sub_name": "電路學(二)",
    "sub_ename": "CIRCUIT THEORY(2)",
    "describe_ch": "電路學是一門基礎學問，它是用來描述實際電機系統運作的數學工具。本課程介紹交流電路的功率計算、三相電路及頻率響應特性，並於最後介紹電磁與電機機械的理論以電路學的等效概念應用分析。",
    "describe_eh": "The Electric Circuits is a basic knowledge, it be used for describing the mathematics tool of systematic operation of the real electrical machinery. This course introduces the power calculate, three-phase circuit, and frequency response at AC circuit field. Finally use electric circuit equivalent concept to explain electric magnetism and electric machinery field.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1. 能針對系統的完全響應使用拉普拉氏分析、微分方程等數學分析。清楚瞭解雙埠網路的應用與分析，並增進等效系統的概念。",
      "describe_en": "1. Use differential equation and Laplace method to analyze whole systemic response. Clearly understand the application and analysis of two ports network, and enhance equivalent concept."
    },
    {
      "seq": 2,
      "describe_ch": "2. 對於交流電路的功率計算、三相電路及頻率響應特性能有清楚的觀念與分析能力。",
      "describe_en": "2. Clearly Understand the power calculate, three-phase circuit, and the frequency response analysis at AC circuit field."
    },
    {
      "seq": 3,
      "describe_ch": "3. 瞭解如何拓展電路學知識至電磁學與電機機械工程領域之原理與應用分析。",
      "describe_en": "3. Understand how to expand electric circuit knowledge to electric magnetism and electric machinery field analysis."
    },
    {
      "seq": 4,
      "describe_ch": "4. 能以書面或口頭方式將期末報告所獲得的結果與同儕、助教及教師溝通。",
      "describe_en": "4. Communicate results of the final assignment in written or oral form to classmates, teaching assistants, and the instructor."
    }
  ],
