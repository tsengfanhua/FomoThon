  "description": {
    "sub_id3": null,
    "sub_name": "室內設計施工圖",
    "sub_ename": "INTERIOR WORKING DRAWING",
    "describe_ch": "正確詳實的施工圖為保障安全及品質的建築物與空間之前提。施工圖是一系列工程設計施作圖面與文字說明，表示建築物與室內空間如何由各種尺寸材料組構而成。課堂上對施工圖基本概念系統及實際的操作方式提供完整介紹，熟練施工圖之繪製將有助作為跨入業界之職能準備，另可藉由並適時可以透過工地參觀，期許同學們能了解設計、施工圖及營造三者間之緊密關連。",
    "describe_eh": "Correct and detailed construction drawings for the premise of ensuring safety and quality of buildings and space, Construction drawing is a series of engineering design drawing surface and text description, indicating how the building and interior space by a variety of size material configuration. In the classroom, the basic concept system of construction drawing and the actual operation mode are provided with a complete introduction, The drawing of skilled construction drawings will help to prepare for the function of entering the industry, and can also be visited through the site in due course, hoping that students can understand the close connection between the design, the construction drawing and the creation of the three.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "施工圖完整架構建立",
      "describe_en": "\tEstablishment of complete structure of construction drawing"
    },
    {
      "seq": 2,
      "describe_ch": "施工圖繪製正確觀念與處理技巧",
      "describe_en": "Correct concept and treatment technique of construction drawing"
    },
    {
      "seq": 3,
      "describe_ch": "細部設計能力培養與施工技術的瞭解",
      "describe_en": "The cultivation of detail design ability and the understanding of construction technology"
    },
    {
      "seq": 4,
      "describe_ch": "查詢繪製施工圖說相關資訊，且能合宜運用相關資訊之訓練",
      "describe_en": "Inquire about drawing the relevant information of the construction diagram, and can make appropriate use of the relevant information training."
    }
  ],
