  "description": {
    "sub_id3": null,
    "sub_name": "不織布工程",
    "sub_ename": "NON-WOVEN  TECHNOLOGY",
    "describe_ch": "使學生充分了解非織物的定義、分類和特性以及其各種非織物製造技術，含成網和固結等各種方式，亦可學習如何測試非織物製品的各種性質，並介紹不織布之成型原理及不織布工程中各運動之動作原理。使學習者擁有不織布之理論基礎，並啟發學習者研究與開發的實作能力。",
    "describe_eh": "This course is to acquaint students with the definition, classification, properties, and various manufactures of nonwoven, including web formation and bonding. Students learn how to test different properties of the nonwoven, and to introduce principles of nonwoven formation and the motion of the process. To help the student to build up the foundation of theory and practical training, and to enlighten the study on the topic.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解及學習各種非織物製造技術，含成網和固結等各種方式的能力",
      "describe_en": "Students are educated with different manufacture techniques of nonwoven, including web formation and bonding."
    },
    {
      "seq": 2,
      "describe_ch": "學習及瞭解非織物的定義、分類和特性的能力",
      "describe_en": "Students are educated with the definition, classification, properties, and various manufactures of nonwoven"
    },
    {
      "seq": 3,
      "describe_ch": "培養瞭解及學習測試非織物各種性質,並了解其應用範圍的能力",
      "describe_en": "Students are cultivated with the abilities to test different properties and understand the application field of nonwoven."
    }
  ],
