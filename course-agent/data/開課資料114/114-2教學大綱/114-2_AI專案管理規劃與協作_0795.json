  "description": {
    "sub_id3": null,
    "sub_name": "AI專案管理規劃與協作",
    "sub_ename": "AI PROJECT MANAGEMENT PLANNING AND COLLABORATION",
    "describe_ch": "本課程將引導學生體驗與實作跨部門/跨領域合作的實施，除進一步體驗企業流程與運作準則之外，將融入專案診斷與管理的專業知識，解析問題並撰寫專業診斷報告書，已提出關鍵分析與合理調整方案。",
    "describe_eh": "This course will guide students to experience and implement the implementation of cross-departmental/cross-field cooperation. In addition to further experiencing the enterprise process and operating principles, it will incorporate professional knowledge of project diagnosis and management, analyze problems and write professional diagnosis reports. It has been proposed Key analysis and reasonable adjustment plan.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識專案管理的核心知識",
      "describe_en": "To understand the core knowledge of project management"
    },
    {
      "seq": 2,
      "describe_ch": "應用專案管理知識進行專案分析與診斷",
      "describe_en": "Apply project management knowledge for project analysis and diagnosis"
    },
    {
      "seq": 3,
      "describe_ch": "理解專案經理之企業倫理、責任與尊重",
      "describe_en": "Understand the corporate ethics, responsibility and respect of project managers"
    },
    {
      "seq": 4,
      "describe_ch": "專案管理綜合實作能力",
      "describe_en": "Comprehensive practical ability of project management"
    },
    {
      "seq": 5,
      "describe_ch": "建立持續思考與動態修正精神的專案管理設計與規劃",
      "describe_en": "To establish project management design and planning with the spirit of continuous thinking and dynamic revision"
    }
  ],
