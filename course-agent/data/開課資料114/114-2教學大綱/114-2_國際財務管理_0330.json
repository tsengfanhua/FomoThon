  "description": {
    "sub_id3": null,
    "sub_name": "國際財務管理",
    "sub_ename": "INTERNATIONAL FINANCIAL MANAGEMENT",
    "describe_ch": "本課程目標在於使學生對全球化的財務管理問題有著深入的理解。本課程旨在協助學生發展一套整合關鍵的國際因素到基礎財務決策的分析工具。在案例中將提供建置對創造和攫取跨越國界價值所需技能的機會。",
    "describe_eh": "The goal of the course is to provide students with a deep understanding of financial management issues in a global setting. The course aims to help students develop analytical tools that incorporate key international considerations into fundamental financial decisions. The cases provide opportunities to build the skills needed to create and capture value across borders.",
    "pre_subname": "FINA6073公司財務",
    "pre_sub_id3": "FINA6073",
    "pre_sub_ename": "FINA6073 CORPORATE FINANCE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解國際財務金融理論",
      "describe_en": "Comprehension for the international financial theories"
