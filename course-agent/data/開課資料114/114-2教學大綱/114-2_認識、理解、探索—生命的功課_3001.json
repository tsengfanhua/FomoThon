  "description": {
    "sub_id3": null,
    "sub_name": "認識、理解、探索—生命的功課",
    "sub_ename": "KNOWING, UNDERSTANDING, EXPLORING – LESSONS IN LIFE",
    "describe_ch": "本課程以認識自己、理解他人、探索世界三個生命中的重要功課為主軸，從自我、他人到世界，依序打開諸多和認識、理解與探索有關的生命課題。每個課題都首先從現象學的哲學視野出發，進而解析相關電影，以此作為課堂討論的話題，最後再透過社會學實踐取向的觀點，讓各個課題落實在日常生活之中。希望藉此課程啟發同學反思自己如何更好地與家人相處、與所愛的人交往、與朋友和陌生人溝通，以及理解自身所處的生活世界之意義與價值。",
    "describe_eh": "This course focuses on three essential life lessons: knowing yourself, understanding others, and exploring the world. It sequentially addresses life issues related to self-awareness, interpersonal understanding, and world exploration. Each topic begins with a philosophical perspective grounded in phenomenology, followed by an analysis of relevant films to serve as discussion prompts in class. Finally, the course incorporates a sociological, practice-oriented approach to connect these themes to everyday life. Through this structure, the course aims to inspire students to reflect on how they can better interact with family members, build relationships with loved ones, communicate with friends and strangers, and comprehend the meaning and value of the life-world they live in.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "幫助學生整合課堂中的知識，使與自己的生活經驗產生連結。",
      "describe_en": "Help students integrate the knowledge from the class and connect it with their own life experiences."
    },
    {
      "seq": 2,
      "describe_ch": "引導學生探索自我，體認生而為人所具有的意義與價值。",
      "describe_en": "Guide students to explore themselves and realize the meaning and value inherent in human beings."
    }
  ],
