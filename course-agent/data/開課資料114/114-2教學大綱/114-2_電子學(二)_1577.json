  "description": {
    "sub_id3": null,
    "sub_name": "電子學(二)",
    "sub_ename": "ELECTRONICS(2)",
    "describe_ch": "電子學(二)是電機電子領域中最基本的一門課程，此課程為電子學(一)之延續。因此，此課程其內容主要在探討Single-Stage IC、Multistage-IC、回授以及IC之應用電路，以進一步提供學生電子學基本原理之認識與了解，以奠定其於電機電子應用領域更深層之研究。",
    "describe_eh": "The Electronics(2) is the most basic course in the area of electrical and electronic engineering. The Single-stage, Multistage IC, Feedback, and Data Converters will be presented in this course. The object of this course is to give the fundamentals of microelectronic circuits. Moreover, based on the completion of this course, the more deeply study can be applied to the different applications in the electrical and electronic areas.",
    "pre_subname": "EEEN2002電子學(一)",
    "pre_sub_id3": "EEEN2002",
    "pre_sub_ename": "EEEN2002 ELECTRONICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的專業詞彙定義電子學中，何謂Differential and Multistage Amplifiers以及運算放大器能夠描述Differential and Multistage Amplifiers以及運算放大器其特性。",
      "describe_en": "Knowledge for understanding and describing the characteristics of Differential and Multistage Amplifiers as well as OP amplifiers in Microelectronic Circuits."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明Differential and Multistage Amplifiers以及運算放大器其特性與應用。",
      "describe_en": "Applications for the characteristics and   design of Differential and Multistage Amplifiers as well as OP amplifier."
    }
  ],
