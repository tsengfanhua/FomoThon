  "description": {
    "sub_id3": null,
    "sub_name": "流體力學(一)",
    "sub_ename": "FLUID MECHANICS(1)",
    "describe_ch": "本課程提供航太與系統工程科系學生流體力學之基礎導論。課程中將介紹流體運動之基本觀念、流體靜力學以及流體運動質、動量、能量守恆之控制體積分析。此一課程可作為進階課程如流體力學(二)、噴射推進以及空氣動力學之奠基課程。",
    "describe_eh": "This course provides an introduction to the fundamentals of fluid mechanics for aerospace and mechanical engineering students. It contains an introduction to the basic concepts, fluid statics, and control volume analysis of mass, momentum and energy conservation in fluid motion. The course serves as a basis for learning the second and the advanced courses in fluid mechanics, jet propulsion and aerodynamics.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、ENGS1008應用力學(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、ENGS1008 APPLIED MECHANICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生瞭解流體力學基本概念與解決流體力學基本問題之方法。",
      "describe_en": "To acquire an understanding of the basic concepts of fluid mechanics and the methodology for problem solving."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生具分析流體靜力學問題之能力。",
      "describe_en": "To gain the ability to analyze fluid statics problems."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生控制體積分析能力及其於求解流體運動中質量、動量、能量守恆問題之應用。",
      "describe_en": "To develop the ability of control volume analysis and the application to the solution of mass, momentum and energy conservation in fluid motion."
    }
  ],
