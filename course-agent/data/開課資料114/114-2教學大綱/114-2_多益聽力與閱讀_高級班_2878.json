  "description": {
    "sub_id3": null,
    "sub_name": "多益聽力與閱讀:高級班",
    "sub_ename": "TOEIC LISTENING AND READING: ADVANCED",
    "describe_ch": "本課程目標有二：(一)藉由增加學生英文字彙及複習英文文法，提升學生的英語語文能力，(二)透過教導學生看懂問題重點、瞭解答案選項中的陷阱與熟悉考試題型，以提高學生的答題技巧。",
    "describe_eh": " This course aims at helping students (1) improve their English proficiency by building their vocabulary and reviewing English grammar and (2) enhance their test-taking skills by understanding what a question asks, knowing what tricks are hidden in the answer choices, and familiarizing them with the test format.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.使學生建構對多益聽讀測驗考試重點的理解",
      "describe_en": "1.Help students construct their understanding toward the construct of the TOEIC listening and reading sections."
    },
    {
      "seq": 2,
      "describe_ch": "2.幫助學生在指定的測驗模式裡應用所學並有效率地完成多益聽讀測驗",
      "describe_en": "2.Help students apply the knowledge learned in class in a testing context and complete the TOEIC listening and reading sections effectively."
    }
  ],
