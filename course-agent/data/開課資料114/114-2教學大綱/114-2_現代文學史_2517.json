  "description": {
    "sub_id3": null,
    "sub_name": "現代文學史",
    "sub_ename": "HISTRORY OF MODERN LITERATURE",
    "describe_ch": "本課程講授五四新文學運動以降至二十世紀結束的台灣現代文學史。內容包括台灣每代文學之政經社會文化文學背景、文學演變、主要流派與社團、重要文學家及作品。",
    "describe_eh": "This course teaches the history of modern Taiwanese literature that ended with the May Fourth New Literary Movement. The content includes the political, economic, social, cultural and literary background, literary evolution, major genres and societies, important literary artists and works of each generation of Taiwanese literature.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備掌握台灣現代文學基礎概念的能力。",
      "describe_en": "Have the ability to grasp the basic concepts of modern Taiwanese literature."
    },
    {
      "seq": 2,
      "describe_ch": "具備賞讀台灣現代文學史重要作品的能力。",
      "describe_en": "Have the ability to appreciate important works in the history of modern Taiwanese literature."
    }
  ],
