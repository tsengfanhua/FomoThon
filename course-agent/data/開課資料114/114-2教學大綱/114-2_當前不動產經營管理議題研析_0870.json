  "description": {
    "sub_id3": null,
    "sub_name": "當前不動產經營管理議題研析",
    "sub_ename": "CURRENT MANAGEMENT ISSUES OF REAL ESTATE DEVELOPMENT",
    "describe_ch": "本課程在探研不動產經營管理相關之學理及方法，探索管理相關科技及資訊應用，評析不動產經營管理相關政府的政策及社會的思潮，探研不動產經營管理相關的課題及解決對策。",
    "describe_eh": "This course explores the management and related information technology and information application, analyzes the policies and social trends, and explores the related issues and solutions of real estate development and management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解不動產經營管理相關之學理及方法，並能運用於課題之分析。",
      "describe_en": "Understand the real estate develoment and management related to the theory and methods, and can be used to analyze the subject."
    },
    {
      "seq": 2,
      "describe_ch": "評析政府不動產相關政策的效益及適宜性。",
      "describe_en": "Analyze the benefits of government policies related to real estate development."
    },
    {
      "seq": 3,
      "describe_ch": "分析社會的思潮及不動產市場。",
      "describe_en": "Analysis of social trends and real estate market."
    }
  ],
