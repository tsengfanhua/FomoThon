  "description": {
    "sub_id3": null,
    "sub_name": "時間序列與財務應用",
    "sub_ename": "TIME SERIES ANALYSIS IN FINANCE",
    "describe_ch": "探討時間序列資料的計量分析工具。課程內容包含ARMA、門檻迴歸、多變量 GARCH、向量自我迴歸、單根與共整合檢定、最大概似估計。輔以電腦實作，學習時間序列方法在財務領域的應用。",
    "describe_eh": "This course explores the quantitative analysis tools for time series data. The content of the course includes ARMA, threshold regression model, multivariate GARCH, vector autoregression, unit root and cointegration test, and maximum likelihood estimation. Supplemented by programming implementation to learn the applications of time series methods in finance.",
    "pre_subname": "MATH2012統計學",
    "pre_sub_id3": "MATH2012",
    "pre_sub_ename": "MATH2012 STATISTICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解時間序列分析方法的基本理論",
      "describe_en": "To comprehend the basic theories of time-serious analysis methods."
    },
    {
      "seq": 2,
      "describe_ch": "能應用時間序列資料與模型進行估計、檢定、預測與模擬",
      "describe_en": "To apply the time series data and model for estimation, testing, prediction, and simulation."
    }
  ],
