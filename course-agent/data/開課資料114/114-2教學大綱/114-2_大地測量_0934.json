  "description": {
    "sub_id3": null,
    "sub_name": "大地測量",
    "sub_ename": "GEODESY",
    "describe_ch": "大地測量為土木工程之基礎科學。本課程旨在使學生瞭解如何測定地球的形狀及其外部重力場；並根據在地球表面及外部空間觀測之參數來確定平均地球橢球。",
    "describe_eh": "Geodesy is one of fundamental subjects in civil engineering field. The objective of this course is to present the principles and operations for mapping the Earth’s geometry and gravity, as well as identifying the average ellipsoid of describing the Earth based on the parameters of surfaces and external geo-observations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解地球重力場及大地測量參考系統。",
      "describe_en": "Realize the Earth’s gravity and geo-reference system"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解各種大地測量的觀測方法。",
      "describe_en": "Realize observation methods of geodesy"
