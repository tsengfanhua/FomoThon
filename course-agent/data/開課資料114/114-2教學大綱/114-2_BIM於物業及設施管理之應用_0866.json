  "description": {
    "sub_id3": null,
    "sub_name": "BIM於物業及設施管理之應用",
    "sub_ename": "APPLICATION OF PROPERTY AND FACILITY MANAGEMENT IN BUILDING INFORMATION MODELING",
    "describe_ch": "本課程之主要內容乃針對營建業之產業特性及實務應用，提供建築物設施維護管理與建築資訊模型相關資訊技術的應用，使學生具備建築資訊模型應用於建築物設施維護管理的基本概念與基礎。",
    "describe_eh": "The purpose of this course is based on the construction industry to supply information technology concepts, investment Property Management (PM) and Facility Management (FM) and Building Information Modeling (BIM). To help students to understand the basic and concept of applying BIM technology to PM and FM.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "提升學生資訊應用能力",
      "describe_en": "Increase the ability in information technology."
    },
    {
      "seq": 2,
      "describe_ch": "建築資訊模型技術的進階應用",
      "describe_en": "Application for Building Information Modeling technology."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解物業及設施管理的方法",
      "describe_en": "Be able to understand the property and facility management."
    },
    {
      "seq": 4,
      "describe_ch": "能以書面或口頭方式將所獲結果與同儕及教師溝通。",
      "describe_en": "Communicate results in written or oral form to classmates and the instructor."
    },
    {
      "seq": 5,
      "describe_ch": "能透過小組展現團隊合作能力",
      "describe_en": "Demonstrate esprit de corps (team spirit) through teamwork."
    }
  ],
