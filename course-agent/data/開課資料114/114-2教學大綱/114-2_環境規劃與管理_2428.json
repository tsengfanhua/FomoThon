  "description": {
    "sub_id3": null,
    "sub_name": "環境規劃與管理",
    "sub_ename": "ENVIRONMENTAL PLANNING AND MANAGEMENT",
    "describe_ch": "環境規劃與管理為一包含多種專業領域的綜合性學門，其目的主要在有效的利用環境資源，以達成需求的目標。環境規劃主要目的在評估與選擇一個最能符合需求的環境保護方案或策略；環境管理則著重於所選擇的方案或策略的執行。本課程由理論與實務探討環境問題，期能訓練學生具有環境規劃與管理之專業知識，有助於將來從事環境保護工作，並對準備各項考試有方向可循。",
    "describe_eh": "Environmental planning and management is a comprehensive knowledge including various expert fields that utilize environmental resources effectively for achieving expected targets. The aim of environmental planning is to evaluate and select an optimal option or strategy for meeting environment protection needs, but environmental management is focus in the implementation of selected option or strategy. The course plan is to provide students about professional knowledge of environmental planning and management by discussing all the concerned environmental issues in both of the theoretical and practical dimension. It will be useful for them to be engaged in this area in the future or to prepare various examinations.",
    "pre_subname": "EES1020環境工程與科學概論",
    "pre_sub_id3": "EES1020",
    "pre_sub_ename": "EES1020 INTRODUCTION TO ENVIRONMENTAL ENGINEERING AND SCIENCE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解由經濟、人類行為等層面看環境問題，並尋求問題解決方案",
      "describe_en": "To comprehension environmental problems and find out optimal solutions from the dimensions of economics and human behavior."
    },
    {
      "seq": 2,
      "describe_ch": "認知方案之研擬、分析與決策之過程、方法及考量因素　",
      "describe_en": "To obtain the process, measures and criteria for formulating, analyzing and decision making of an optimal solution."
    },
    {
      "seq": 3,
      "describe_ch": "具備執行環境保護之專業能力　",
      "describe_en": "The professional ability training of environmental protection.　"
    }
  ],
