  "description": {
    "sub_id3": null,
    "sub_name": "多變量分析",
    "sub_ename": "MULTIVARIATE ANALYSIS",
    "describe_ch": "多變量分析課程主要在介紹多個變數資料分析的統計方法。內容包括主成分分析、因素分析、典型相關分析、區別分析、集群分析、多元尺度法、線性結構關係模式。",
    "describe_eh": "This course introduces techniques to present multivariate data and methods. The contents include principal component analysis, factor analysis, canonical correlation analysis, discriminant analysis, cluster analysis, multidimensional scaling, and LISREL.",
    "pre_subname": "STAT1002統計學(二)",
    "pre_sub_id3": "STAT1002",
    "pre_sub_ename": "STAT1002 STATISTICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用多變量分析的概念\r\n\r\n",
      "describe_en": "To apply  the concepts of the multivariate analysis"
    },
    {
      "seq": 2,
      "describe_ch": "應用多變量分析軟體分析真實數據\r\n\r\n",
      "describe_en": "To apply  the multivariate analysis software to the real data"
    },
    {
      "seq": 3,
      "describe_ch": "理解多變量分析軟體的報表\r\n\r\n",
      "describe_en": "Comprehend  the output of the multivariate analysis software \r\n"
    }
  ],
