    },
    {
      "seq": 3,
      "describe_ch": "探索人工智慧的關鍵因素與門檻",
      "describe_en": "To explore the key factors and thresholds"
    },
    {
      "seq": 4,
      "describe_ch": "能夠應用人工智慧技術於產業實務",
      "describe_en": " Be able to apply the AI technology for case study in variant industry."
    }
