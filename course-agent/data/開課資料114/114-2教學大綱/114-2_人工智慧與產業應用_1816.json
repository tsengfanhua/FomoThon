  "description": {
    "sub_id3": null,
    "sub_name": "人工智慧與產業應用",
    "sub_ename": "ARTIFICIAL INTELLIGENCE AND INDUSTRIAL APPLICATIONS",
    "describe_ch": "介紹人工智慧與工業 4.0 的鏈結以及發展沿革與發展現況。讓學生探討國內外產業導入人工智\r\n慧整合系統的關鍵因素與門檻，以及探討人工智慧時代對產業產生產技術、員工職能發展以及 人類文明與生活的衝擊與挑戰。",
    "describe_eh": "Introduce the evolution of artificial intelligence, the development status and the linkage of Industry 4.0. To explore the key factors and thresholds for the introduction of artificial intelligence integration systems, and explore the impact and challenges of the artificial intelligence era on industrial production technology, employee profession development, and human civilization and lifespan.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
