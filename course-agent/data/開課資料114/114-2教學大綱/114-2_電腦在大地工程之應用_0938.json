  "description": {
    "sub_id3": null,
    "sub_name": "電腦在大地工程之應用",
    "sub_ename": "COMPUTER APPLICATION IN GEOTECHNICAL ENGINEERING",
    "describe_ch": "指導學生使用FLAC套裝軟體進行基礎結構分析與設計，藉由圖形輸入與螢幕輸出結果以印證他們曾經學過的理論解。課程亦將以簡單例子介紹使用FLAC來分析基礎受力變形反應。",
    "describe_eh": "To use the software of FLAC to conduct structural analysis and design. By using the graphical input and on screen output results, the analytical results will be approved with theoretical results they ever learned. This curriculum includes analyzing the force-deformation response of foundation by means of FLAC with the simplest cases as well.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識FLAC的功能並熟悉FLAC之環境",
      "describe_en": "To know the functions of FLAC and to be familiar with FLAC environment."
    },
    {
      "seq": 2,
      "describe_ch": "認識FLAC分析流程與模擬方法",
      "describe_en": "To know the procedure of analysis and modeling method in FLAC."
    },
    {
      "seq": 3,
      "describe_ch": "能以FLAC定義基礎結構的材料行為、負載及邊界條件並建置基礎結構數值模型進行分析。",
      "describe_en": "To be able to define material properties, loading, boundary conditions and establish FLAC numerical model."
    }
  ],
