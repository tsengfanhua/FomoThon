  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CI02310",
    "sub_id": "46285",
    "scr_dup": "001",
    "sub_title": "「統計信號處理」為所有領域的工程量測實驗之基礎，本課程希望培養修課學生利用統計信號處理的技巧來處理通訊工程量測訊號的能力。通訊工程強調系統整合，因所有的工程量測實驗值都是隨機的，都無可避免地包含雜訊及來自環境的不確定性，因此有必要以統計學的方法，來做系統訊號處理，才能得到合乎物理特性的特徵訊號。",
    "sub_title_en": null,
    "sub_describe": "本課程將探討統計信號處理技術，探討的課題包含： \n(1) 偏理論的統計信號處理：機率、隨機變數 、多重隨機變數、隨機程序-時域和頻域特性。 \n(2) 偏應用的統計信號處理：自適應濾波器 、離散時間訊號處理與隨機訊號 、Wiener 濾波器、線性預測 、陡降梯度法 、最小平方法。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "統計信號處理",
    "sub_ename": "STATISTICAL AND ADAPTIVE SIGNAL PROCESSING",
    "describe_ch": "這門課提供在頻譜的估計，訊號模擬，適應性濾波器及陣列處理上的原理和實作方法的論述。主要的目地是幫助學生在操作時，親自體認這些操作的方法和實際的限制，進而能夠詳細的了解基本數學的規則。",
    "describe_eh": "This course provides a unified treatment of the theory, implementation, and applications of methods for spectral estimation, signal modeling, adaptive filtering, and array processing. The goal is to help students understand the fundamental mathematical principles underlying the operation of a method, appreciate its practical limitations, and grasp, with sufficient details, its practical implementation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解統計推論與隨機程序在通訊與信號處理領域中的重要性。",
      "describe_en": "R Be able to comprehend the importance of statistical inference and random processes for communications and signal processing."
    },
    {
      "seq": 2,
      "describe_ch": "學習並獲得偵測理論與估計理論。",
      "describe_en": "To learn and obtain detection and estimation theories."
    },
    {
      "seq": 3,
      "describe_ch": "能應用偵測理論與估計理論於通訊與信號處理領域中。",
      "describe_en": "Be able to apply detection and estimation theories in the fields of communications and signal processing."
    }
  ],
