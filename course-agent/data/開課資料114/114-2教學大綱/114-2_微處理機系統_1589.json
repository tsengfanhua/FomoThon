  "description": {
    "sub_id3": null,
    "sub_name": "微處理機系統",
    "sub_ename": "MICROPROCESSOR SYSTEMS",
    "describe_ch": "微處理機系統是電機電子領域中基本的一門課程，此課程內容主要在介紹CPU, I/O, TIMERS/COUNTERS, Serial Communication，以奠定學生於電機電子及微處理機系統之應用。",
    "describe_eh": "The microprocessor systems is the basic course in the area of electrical and electronic engineering. The CPU, I/O, TIMERS/COUNTERS, Serial Communication are introduced in this course. The object of this course is to give the fundamentals of microprocessor systems. Moreover, based on the completion of this course, the more deeply study can be applied to the different applications in the electrical and electronic areas..",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的專業詞彙定義微處理機系統中，何謂CPU, I/O, TIMERS/COUNTERS, 以及Serial Communication能夠描述特性。",
      "describe_en": "Knowledge for define and describing the characteristics of CPU, I/O, TIMERS/COUNTERS, and Serial Communication."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明CPU, I/O, TIMERS/COUNTERS,以及Serial Communication其特性與應用。",
      "describe_en": "Comprehension for being able to explain the characteristics and applications of CPU, I/O, TIMERS/COUNTERS, Serial Communication."
    },
    {
      "seq": 3,
      "describe_ch": "能辨識出可應用定理與模型的場合，並能清楚表達。",
      "describe_en": "Applications for distinguishing the applicable scope of microcontroller based system."
    }
  ],
