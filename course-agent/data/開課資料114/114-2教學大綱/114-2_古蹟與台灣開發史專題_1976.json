  "description": {
    "sub_id3": null,
    "sub_name": "古蹟與台灣開發史專題",
    "sub_ename": "SPECIAL TOPICS ON MONUMENTS AND TAIWAN'S DEVELOPMENT HISTORY",
    "describe_ch": "本課程以歷史學為主，參考建築學、人類學等相關學門論著，探討台灣不同類型古蹟與台灣歷史發展相互間的關聯。課程將結合影像、史蹟田野考察與課堂講述等不同方式進行，藉此呈現人與古蹟、鄉土與世界，彼此間的複雜關係，使學生能在孰悉古蹟之餘，也對台灣的過去歷史更能有深刻的體認。",
    "describe_eh": "This course explores the relationship between different types of monuments in Taiwan and the development of Taiwan's history with a focus on history and reference to architecture, anthropology and other related fields. The course is conducted through a combination of photography, historical field trips and lectures in order to present the complex relationship between people and monuments, the countryside and the world. It enables students to learn about monuments and gain a deeper understanding of Taiwan's past.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解並分析古蹟與台灣歷史相互交涉的歷史文化現象，進而培養學生具備研究的基礎能力。",
      "describe_en": "To understand and analyze the historical and cultural phenomenon of the intersection of monuments and Taiwan's history, thus be equipped with basic research skills"
    },
    {
      "seq": 2,
      "describe_ch": "能熟悉台灣特定古蹟場域的田野工作，進而培養學生對該場域作自我觀察、紀錄與分析的能力。",
      "describe_en": "To familiarize with the fields of specific monument sites in Taiwan and develop abilities to self-observe, document and analyze the sites"
    }
  ],
