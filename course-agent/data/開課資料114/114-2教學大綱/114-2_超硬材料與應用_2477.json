  "description": {
    "sub_id3": null,
    "sub_name": "超硬材料與應用",
    "sub_ename": "SUPER HARD MATERIALS AND APPLICATIONS",
    "describe_ch": "講述超硬材料料之知識、科技應用及市場，並針對鑽石、碳化矽、氮化硼等超硬材料之結構、特性及合成方式進行深入介紹。課程內容涵蓋超硬材料定義、合成技術及超硬材料工具之設計方法。課程除了學理講授外，並透過影片欣賞及分組報告，建立產業最新技術知識與發展。",
    "describe_eh": "This course concerns the knowledge, application, and market of superhard material science and technology; hence, the structure, characteristics and synthesis of diamond, silicon carbide, and boron nitride are also introduced in detail. Key aspects of class lectures include definition, synthesis, and characteristics of superhard materials, and the design concept of superhard tools. In addition to lecture in class, this course also uses video and group report to establish the latest industry technology and development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
