  "description": {
    "sub_id3": null,
    "sub_name": "電磁相容",
    "sub_ename": "ELECTROMAGNETIC COMPATIBILITY ( EMC)",
    "describe_ch": "修習此一課程, 可以了解電子產品電磁相容的規範及要求。課程中包含基本的傳輸線理論、天線及頻譜分布、非理想之零件特性、傳導及輻射干擾之成因, 同時了解如何計算及設計最小化傳輸線的相互干擾與隔離方法之設計。",
    "describe_eh": "With the help of this course, students can understand EMC requirements for electronic systems. This course includes transmission lines, antennas and signal spectra. components with non-ideal behavior, the causes of radiated emissions, and conducted emissions. Understand how to calculate crosstalk on cables, design for minimum crosstalk and how to design shielding.",
    "pre_subname": "EEEN6017電磁封裝",
    "pre_sub_id3": "EEEN6017",
    "pre_sub_ename": "EEEN6017 ELECTROMAGNETIC PACKAGING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠理解並分析各類電磁輻射的原理及電路模型。",
      "describe_en": "Understand and be able to analyze the various type of electromagnetic radiation."
    },
    {
      "seq": 2,
      "describe_ch": "能應用電磁相容的基本原理，評估一個真實的電子電路。",
      "describe_en": "Use principles of EMC to evaluate a true circuit and propose a feasible method."
    }
  ],
