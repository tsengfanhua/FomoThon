  "description": {
    "sub_id3": null,
    "sub_name": "企業運作實務",
    "sub_ename": "BUSINESS OPERATIONAL PRACTICE",
    "describe_ch": "介紹現行國內企業運籌與管理實務，及經營策略，包括全球化行銷與品牌、創意企劃與執行、物流管理、物業管理、資源開發與運用、商情分析與預測---等。",
    "describe_eh": "The goal of this course is to introduce a catch-all overview of business practices, management and operational strategy.  These cover global marketing strategy and corporate branding, creative innovations, executive management, logistics management, property management, resource utilization and market trend prediction.",
    "pre_subname": "MGT1001管理學、ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT、ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解企業的經營管理方式",
      "describe_en": "Understanding a practical overview of business logistics, management and operational strategy."
    },
    {
      "seq": 2,
      "describe_ch": "理解創意企劃與執行、全球化行銷與品牌、商業資源開發與運用",
      "describe_en": "Understanding business creativity formulation & execution, global marketing and brand name, how business makes good exploitation and use of resource"
    },
    {
      "seq": 3,
      "describe_ch": "理解物流管理、物業管理",
      "describe_en": "Understanding logistics management,property management"
    },
    {
      "seq": 4,
      "describe_ch": "理解並能分析企業經營與市場動向",
      "describe_en": "To Understand and analyze business logistics and market trend"
    }
  ],
