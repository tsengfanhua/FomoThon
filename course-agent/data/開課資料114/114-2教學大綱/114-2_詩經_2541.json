  "description": {
    "sub_id3": null,
    "sub_name": "詩經",
    "sub_ename": "THE SHIH-CHING",
    "describe_ch": "《詩經》是中國最早的詩歌總集，韻文之祖，也是古代北方文學之代表。\r\n本課程旨在引領同學進入《詩經》的世界，從風、雅、頌了解《詩經》的內容、風格以及寫作方法；探討周代人民的生活風俗、人生態度及價值取向等，深入掌握《詩經》的文本與內涵，進而瞭解《詩經》的價值與對後世的影響。\r\n",
    "describe_eh": "To understand the meaning of Shih-Ching from Chinese classics. Also, to understand the writing skill of Shih-Ching from the literature viewpoint and to treat the meaning of Shih-Ching in literature, politics and new era.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習如何解讀、詮釋以及鑒賞文學文獻的能力",
      "describe_en": "Learning how to interpret, analyze, and appreciate literary texts."
    },
    {
      "seq": 2,
      "describe_ch": "理解風雅傳統，掌握詩歌發展與嬗變的脈絡",
      "describe_en": "Understanding the tradition of Fengya (風雅), and mastering the evolution and transformation of poetry."
    }
  ],
