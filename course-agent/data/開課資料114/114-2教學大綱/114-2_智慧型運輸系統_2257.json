  "description": {
    "sub_id3": null,
    "sub_name": "智慧型運輸系統",
    "sub_ename": "INTELLIGENT TRANSPORTATION SYSTEM",
    "describe_ch": "首先介紹智慧型運輸系統之各個子系統，其次學習如何應用各個子系統，最後學習如何評估分析各個子系統所帶來的效益。",
    "describe_eh": "The purpose of this course consists of (1) introduce the component systems of Intelligent Transportation System(ITS) (2) to learn how to apply the ITS (3) to learn how to evaluate and analyze the benefit of ITS.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "3.教授相關先進科技與技術於運輸或物流領域之應用潛力與案例",
      "describe_en": "3. Provide students with knowledge of the potential applications and case studies of advanced technologies and techniques in the transportation and logistics field."
    },
    {
      "seq": 2,
      "describe_ch": "12.培養學生簡報製作、報告撰寫、口頭報告以及提問研討之能力",
      "describe_en": "12. Develop students' skills in presentation, report writing, oral delivery, and academic discussion.\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "1.各類交通運輸系統的特性以及運作概念",
      "describe_en": "1. Understand characteristics and operation concept of various transportation systems."
    },
    {
      "seq": 4,
      "describe_ch": "5.認識國內、外交通運輸之相關先進科技與技術",
      "describe_en": "5. Understand worldwide transportation related advanced technologies."
    }
