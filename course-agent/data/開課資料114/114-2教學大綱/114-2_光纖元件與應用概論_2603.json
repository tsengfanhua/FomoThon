  "description": {
    "sub_id3": null,
    "sub_name": "光纖元件與應用概論",
    "sub_ename": "INTRODUCTION TO FIBER-OPTIC DEVICES AND APPLICATIONS",
    "describe_ch": "介紹光纖及光纖元件，使學生瞭解它們的性質、原理、及在光纖系統中的應用。內容含光纖種類及基本性質、光纖連接器、光纖被動元件、光纖主動元件、光纖放大器、與光纖有關的量測、在光纖網路的應用、在光纖感測及照明的應用。",
    "describe_eh": "This course introduces optic fibers and fiber-optic devices. Let students understand their properties, basic principles, and applications. The contents include types and basic properties of optic fibers, optical fiber connectors and splices, fiber-optic passive devices, fiber-optic active devices, fiber amplifiers, fiber-optic measurements, applications in fiber networks, applications in fiber-optic sensors and illumination.",
    "pre_subname": "OPT2001光學(一)、OPT2002光學(二)",
    "pre_sub_id3": "OPT2001",
    "pre_sub_ename": "OPT2001 OPTICS (1)、OPT2002 OPTICS (2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能描述光纖主被動元件原理及用途。",
      "describe_en": "Can describe working principles and applications of active and passive fiber-optic devices."
    },
    {
      "seq": 2,
      "describe_ch": "能理解光纖元件在光纖網路的應用。",
      "describe_en": "Can understand the application of fiber-optic devices in fiber networks."
    },
    {
      "seq": 3,
      "describe_ch": "能閱讀相關進階文章並做報告。",
      "describe_en": "Able to read relevant advanced articles and make reports."
    }
  ],
