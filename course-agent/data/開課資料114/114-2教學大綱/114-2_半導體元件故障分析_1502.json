  "description": {
    "sub_id3": null,
    "sub_name": "半導體元件故障分析",
    "sub_ename": "FAILURE ANALYSIS OF SEMICONDUCTOR DEVICE",
    "describe_ch": "陳述半導體元件電性檢測之故障現象，包含元件製作之前段製程(front-end)、後段製程(back-end)與相關IC產品。說明相關檢測技術如電性分析、可靠度分析與材料分析方法，為預防故障發生、提高半導元件電性與可靠度之方法亦加以描述。",
    "describe_eh": "State the failure phenomenon of the electrical inspection of semiconductor devices, including the front-end, back-end, and related IC products. The related testing techniques such as electrical analysis, reliability analysis and material analysis methods are described, and the methods for preventing failures and improving the electrical performance and reliability of semiconductor device are also described.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知悉半導體元件故障現象與概念",
      "describe_en": "To know the failure phenomenon and concept of semiconductor device."
    },
    {
      "seq": 2,
      "describe_ch": "能理解半導體元件故障之檢測技術與改善方法",
      "describe_en": "To understand the inspection, testing technology, and improvement methods for semiconductor device failure."
    }
  ],
