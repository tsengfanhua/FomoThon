  "description": {
    "sub_id3": null,
    "sub_name": "電子電路學",
    "sub_ename": "ELECTRONIC CIRCUITS",
    "describe_ch": "針對機械與航太工程相關領域的學生提供電子與電路學的原理及應用，課程目標是給予學生基本的電子電路概念、讓學生瞭解如何應用電子電路的原理來解決特定問題以及提供學生完整電子電路學的學習過程。 課程內容包含電路分析、數位系統、電子學與機電學。",
    "describe_eh": "This course covers the principles and applications of electric circuits and electronics for mechanics and aerospace engineering students. Its goals are to present basic concepts in a general setting, to show students how the principles of electrical engineering apply to specific problems, and to provide the overall learning process. Circuit analysis, digital systems, electronics, and electromechanics are covered.",
    "pre_subname": "IEE1010普通物理-電、磁、光",
    "pre_sub_id3": "IEE1010",
    "pre_sub_ename": "IEE1010 GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解基本電學原理",
      "describe_en": "Be able to comprehend the principle of electrical engineering."
    },
    {
      "seq": 2,
      "describe_ch": "能理解電阻、電容、電感的工作原理",
      "describe_en": "Be able to comprehend the principle of resistances, capacitors, and inductors."
    },
    {
      "seq": 3,
      "describe_ch": "能分析電路的電壓以及電流大小",
      "describe_en": "Be able to analyze voltages and currents of circuit."
    },
    {
      "seq": 4,
      "describe_ch": "能知道交流電路的工作原理",
      "describe_en": "Be able to know the principle of AC circuit."
    },
    {
      "seq": 5,
      "describe_ch": "能理解二極體、電晶體之原理與應用",
      "describe_en": "Be able to know the principles and applications of diodes and transistors"
    }
  ],
