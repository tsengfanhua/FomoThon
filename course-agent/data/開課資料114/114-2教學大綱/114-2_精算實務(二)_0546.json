  "description": {
    "sub_id3": null,
    "sub_name": "精算實務(二)",
    "sub_ename": "PRACTICE OF ACTUARIAL SCIENCE (2)",
    "describe_ch": "針對產險公司保險成本實務及經營績效進行個案分析討論。包含：價格-盈餘比、公司融資和自由現金流量表、通貨膨脹和估計權益的價值及集中股票市場的行為。介紹人壽保險實務：包含相關壽險產品精算、財務評估決算等。壽險風險包含：風險基礎資本額之組成、資產違約風險及跌價對壽險業者之影響。",
    "describe_eh": "Students will learn the operation performance issues in Property and Casualty Insurance. Content includes:  price-earnings ratio, corporate finance, and the free cash flow approach, inflation, and equity valuation, and the aggregate stock market, life insurance related actuarial product valuation, and financial evaluation. Risk-based capital for life insurer including the following topic: the components of risk-based capital, asset default, and depreciation, and impact of RBC on life insurer.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識及瞭解經營產物保險之重要成本與各項產物保險經營指標之涵義",
      "describe_en": "To learn and understand the important cost of Property and Casualty Insurance operation and identify each kind of operation index and realize the real meaning"
    },
    {
      "seq": 2,
      "describe_ch": "理解壽險風險基礎資本額之組成與美國NAIC對壽險公司清償能力的監理架構",
      "describe_en": "Understanding the components of risk based capital for life insurer and NAIC's supervision structure on Life Company solvency."
    }
  ],
