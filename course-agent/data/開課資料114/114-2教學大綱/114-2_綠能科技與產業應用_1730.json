  "description": {
    "sub_id3": null,
    "sub_name": "綠能科技與產業應用",
    "sub_ename": "GREEN ENERGY TECHNOLOGY AND INDUSTRIAL APPLICATIONS",
    "describe_ch": "透過課程講授、實務專題演講與小組合作學習，讓學習者建立具備綠能科技與產業應用之基本概念，瞭解綠能科技如何解決溫室效應與全球暖化的問題，綜合綠能科技，應用於產業界，達到節能減碳的目的。",
    "describe_eh": "This course would be taught by lectures and small group cooperative learning. Students will learn the essential knowledge about green energy technology (GET) and industrial applications. Learn how to solve the problems of greenhouse effect and global warming by GET. Furthermore, applied the GET to industries, the goal of energy saving and carbon reduction can be achieved.",
    "pre_subname": "AERO2003熱力學(一)",
    "pre_sub_id3": "AERO2003",
    "pre_sub_ename": "AERO2003 THERMODYNAMICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解與描述 綠能科技與產業應用之定義與概念。",
      "describe_en": " Understand and will be able to describe the definition and concept of green energy technology and industrial applications."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解和說明產業如何應用綠能科技。",
      "describe_en": "Understand and will be able to explain the industrial applications of green energy technology."
    },
    {
      "seq": 3,
      "describe_ch": "能有效分析 綠能科技與產業應用個案並解決問題。",
      "describe_en": "Be able to effectively analyze the cases of green energy technology and industrial applications and to solve the related problems."
    },
    {
      "seq": 4,
      "describe_ch": "能以書面或口頭方式將個案研究結果向同儕和教師報告。",
      "describe_en": "Communicate his/her case study report in written and oral form to classmates and the instructor."
    }
  ],
