  "description": {
    "sub_id3": null,
    "sub_name": "國際付款條件個案討論",
    "sub_ename": "INERNATIONAL PAYMENT TERMS – CASE STUDY",
    "describe_ch": "介紹國際貿易各種付款條件之定義、種類及內容，並區分傳統產業及IT產業付款工具之運用及操作方式，並提供如何因應因付款方式所產生之糾紛及其解決策方案及預防未來再犯等進行個案討論。",
    "describe_eh": "The course introduces the definition, varieties and contents of various payment terms on international trade. And it detects the traditional industries from IT industries on the application and operation of the international payment terms. Besides that, it offers the solution advices when conflicts raise, so as to prevent the events happen again.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備國際貿易知識。",
      "describe_en": "With knowledge of international trading."
    },
    {
      "seq": 2,
      "describe_ch": "具備進出口押匯風險之分析能力。",
      "describe_en": "Analyze the risk of negotiation about import and export."
    },
    {
      "seq": 3,
      "describe_ch": "訓練國際貿易理論與國貿實務兼備之人才。",
      "describe_en": "Being a complete expert of international trading theory and practice."
    }
  ],
