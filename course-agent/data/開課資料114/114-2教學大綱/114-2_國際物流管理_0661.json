      "describe_ch": "以個案了解物流實務",
      "describe_en": "Understand logistics practice by real cases."
    },
    {
      "seq": 16,
      "describe_ch": "瞭解物流系統內的各項功能以及彼此間的關聯",
      "describe_en": "Understand the components of logistics systems and interrelationships and interactions among the components."
    }
