  "gradeRules": [
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB25120",
      "sub_id": "41922",
      "scr_dup": "001",
      "evalb_id": "L3",
      "score_rate": 20,
      "evalb_memo": null,
      "evalb_memo_en": "Class participation:\n1. Preparation: Review the case study thoroughly\nbefore class to understand the context, issues, and key points.\n2. Active Engagement: Participate actively in discussions, offering insights, analyses, and solutions. \n3. Critical Thinking: Apply critical thinking skills to analyze the case, identify problems, and propose solutions.\n4. Evidence-Based Arguments: Support your arguments with evidence from the case study, relevant theories, and external sources.\n5. Listening: Listen attentively to classmates' perspectives, asking clarifying questions and building on their contributions.\n6. Respectful Interaction: Respectfully challenge ideas and opinions, promoting constructive dialogue and learning.\n7. Contribution Quality: Focus on quality rather than quantity of contributions, offering thoughtful and well-reasoned insights.\n8. Collaboration: Collaborate with classmates in group discussions, brainstorming ideas and collaborating on solutions.\n9. Reflection: Reflect on your own contributions and learning from the case study, identifying areas for improvement.\n10. Participation Balance: Strive for balanced participation, ensuring that all students have the opportunity to contribute and share their viewpoints. \n11. Frequency: Participate regularly throughout the semester, not just occasionally.",
      "evalb_name": "課堂討論參與",
      "evalb_name_en": "Participation",
      "seq": 1
    },
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB25120",
      "sub_id": "41922",
      "scr_dup": "001",
      "evalb_id": "L1",
      "score_rate": 20,
      "evalb_memo": null,
      "evalb_memo_en": "In this course, silence is the only sunk cost. The 20% Class Participation Grade is not a measure of attendance, but a metric of intellectual contribution. We view the classroom as a \"Live Logistics Lab\" where the static pages of a case study are transformed into dynamic strategy through the friction of debate.",
      "evalb_name": "印象分數",
      "evalb_name_en": "General impression",
      "seq": 2
    },
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB25120",
      "sub_id": "41922",
      "scr_dup": "001",
      "evalb_id": "L2",
      "score_rate": 20,
      "evalb_memo": null,
      "evalb_memo_en": "20% of the grade is divided weekly, three hours each. Late arrivals result in proportional mark deductions",
      "evalb_name": "點名",
      "evalb_name_en": "Roll call",
      "seq": 3
    },
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB25120",
      "sub_id": "41922",
      "scr_dup": "001",
      "evalb_id": "D1",
      "score_rate": 15,
      "evalb_memo": null,
      "evalb_memo_en": "The Midterm: The \"Black Swan\" Simulation\nThe Stakes: 15%\nThe Experience: This is not an exam; it is a stress test. You will be plunged into a real-time, high-pressure scenario—perhaps a sudden blockade of the Malacca Strait or a global cyber-outage. Armed only with the frameworks from Modules I and II, you must defend a 15-minute \"Executive Recovery Plan.\"\n\nCan you maintain the flow when the world stops?",
      "evalb_name": "期中考",
      "evalb_name_en": "Midterm examination",
      "seq": 4
    },
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB25120",
      "sub_id": "41922",
      "scr_dup": "001",
      "evalb_id": "D2",
      "score_rate": 15,
      "evalb_memo": null,
      "evalb_memo_en": "Final",
      "evalb_name": "期末考",
      "evalb_name_en": "Final examination",
      "seq": 5
    },
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB25120",
      "sub_id": "41922",
      "scr_dup": "001",
      "evalb_id": "D3",
      "score_rate": 10,
      "evalb_memo": null,
      "evalb_memo_en": "Presentation:\n1. Structure your presentation like a story\n(Storytelling that moves people: Craft the beginning, Develop the middle, Make the Ending powerful)\n2. Avoid reading from cellphone, instead, revel in the art of storytelling\n3. Develop stage presence\n4. Engage your audience\n5. Strategize multimedia planning with impactful visualization – Adopt a designer's mindset\n6. Use minimum text\n7. Length your presentation\n8. Make it authentic – provide references\n9. Anticipate technological Glitches – arrive early and well prepared",
      "evalb_name": "隨堂測驗",
      "evalb_name_en": "In-class examination",
      "seq": 6
    }
  ],
