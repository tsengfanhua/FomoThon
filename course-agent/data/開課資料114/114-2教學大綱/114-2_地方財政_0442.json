  "description": {
    "sub_id3": null,
    "sub_name": "地方財政",
    "sub_ename": "LOCAL PUBLIC FINANCE",
    "describe_ch": "從財政理論出發，討論地方公共財之特性，進而以Tiebout均衡探討地方公共支出及公共收入對人口與資源配置的影響, 進而瞭解地方財政之運作和當前地方財政問題，探討地方政府在教育、文通、建康和福利、經濟發展等政策分析。",
    "describe_eh": "Based on the theory of public finance, the topics of this course include the characteristics of local public goods, Tiebout equilibrium, local government expenditures and revenues, the process of local government finance, and the current issues of local public finance, and local government policy analysis such as education, transportation, health and welfare, and economic development.",
    "pre_subname": "PF3001財政學(一)、PF3002財政學(二)",
    "pre_sub_id3": "PF3001",
    "pre_sub_ename": "PF3001 PUBLIC FINANCE(1)、PF3002 PUBLIC FINANCE(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解地方財政制度、特性及其重要性\t",
      "describe_en": "Understand the system, characteristics, and importance of local public finance."
    },
    {
      "seq": 2,
      "describe_ch": "能分析地方財政政策之影響",
      "describe_en": "Analyze the impact of local fiscal policy"
    }
  ],
