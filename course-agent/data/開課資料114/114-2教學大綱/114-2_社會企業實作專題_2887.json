  "description": {
    "sub_id3": null,
    "sub_name": "社會企業實作專題",
    "sub_ename": "THE PROJECT OF SOCIAL ENTERPRISE IMPLEMENTATION",
    "describe_ch": "本課程旨在指導學生社會企業個案的操作和應用。 通過實踐培養社會關懷能力，學生了解社會創新的重要性和社會企業發展的趨勢。 學生還可以透過真實專案來解決社會問題。",
    "describe_eh": "This course is designed to guide students in the operation and application of social enterprise cases. Through practice to cultivate social care ability, students understand the importance of social innovation and the development trend of social enterprises. Students can also solve social problems through real projects.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "協助學生認識社會企業的特性與內容，並學習如何實務應用與開發。",
      "describe_en": "To help students understand the nature and content of social enterprises, and learn practical applications and development."
    },
    {
      "seq": 2,
      "describe_ch": "創造一個跨領域整合學習的最佳模式。",
      "describe_en": "To create an optimal model for integrating learning across domains."
    }
  ],
