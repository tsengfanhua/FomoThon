  "description": {
    "sub_id3": null,
    "sub_name": "數據驅動品質管理策略",
    "sub_ename": "DATA-DRIVEN QUALITY MANAGEMENT STRATEGY",
    "describe_ch": "課程旨在培養學生對數據在品質管理中的理解和應用能力。課程將數據收集、清理、分析和數據視覺化技術等基礎知識，並將其應用於品質管理實務議題中。本課程將透過實際案例讓學生瞭解數據在不同製造業領域中的應用，並探討如何應用數據驅動策略解決品質問題，在智慧製造領域的專業發展奠定基礎。",
    "describe_eh": "The course aims to cultivate students' understanding and application abilities of data in quality management. It covers fundamental knowledge such as data collection, cleansing, analysis, and data visualization techniques, and applies them to practical quality management issues. Through case studies, students will gain insights into the application of data in various manufacturing sectors and explore how to apply data-driven strategies to solve quality problems, laying a foundation for professional development in the field of smart manufacturing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備數學、統計、資訊、工程與管理基本學理與應用能力。",
      "describe_en": "Be able to underhand the fundamental principles of mathematics, statistical, engineering and management information and application abilities."
    },
    {
      "seq": 2,
      "describe_ch": "具備智能系統分析、設計、整合、製造與管理專業能力。",
      "describe_en": "Be able to have intelligent system analysis, design, integration, manufacturing and management professional abilities."
    },
    {
      "seq": 3,
      "describe_ch": "具備資料蒐集、分析、驗證與推論研究能力。",
      "describe_en": "Be able to have data collection, analysis, verification, and implication abilities."
    },
    {
      "seq": 4,
      "describe_ch": "具備有效溝通、團隊合作、發掘問題，以及解決問題能力。",
      "describe_en": "Be able to have effective communication, teamwork, problems exploration, and problems solving abilities."
    }
  ],
