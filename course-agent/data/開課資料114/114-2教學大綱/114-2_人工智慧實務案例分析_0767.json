  "description": {
    "sub_id3": null,
    "sub_name": "人工智慧實務案例分析",
    "sub_ename": "CASES STUDY OF APPLICATIONS OF ARTIFICIAL INTELLIGENCE",
    "describe_ch": "本課程引導學生探討人工智慧技術於智慧城市、智慧製造與智慧倉儲等應用情形，認識與思考AI技術的發展應用。除課堂講座外，亦利用體驗作業，讓學生簡易操作，並援以案例介紹與分析，培養學生AI與資訊素養。",
    "describe_eh": "The course will guide students to understand and discuss artificial intelligence applications in smart city, smart industry, smart warehouse, etc., and understand and think developments and applications of AI technology. The course will include lecture, experience homework, and cases analysis in teaching philosophy to train literacy of AI and information.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識人工智慧各應用面向的技術發展",
      "describe_en": "To understand the technological development of artificial intelligence applications"
    },
    {
      "seq": 2,
      "describe_ch": "認識人工智慧技術於應用上須注意的道德倫理，與治理原則",
      "describe_en": "To understand the ethics and governance principles that must be paid attention to in the application of artificial intelligence technology"
    },
    {
      "seq": 3,
      "describe_ch": "認識各領域對於人工智慧的需求",
      "describe_en": "To understand the needs of artificial intelligence from other fields"
    },
    {
      "seq": 4,
      "describe_ch": "認識人工智慧於各領域之應用",
      "describe_en": "To understand applications of artificial intelligence in other fields"
    }
  ],
