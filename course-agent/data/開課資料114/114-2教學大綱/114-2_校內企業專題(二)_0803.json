  "targets": [
    {
      "seq": 1,
      "describe_ch": "綜合應用人關智慧技術與工具之能力\r\r\n",
      "describe_en": "Ability to comprehensively apply human-related smart technologies and tools"
    },
    {
      "seq": 2,
      "describe_ch": "創新發想解決企業真實議題\r\r\n",
      "describe_en": "Innovation and development want to solve real corporate issues"
    },
    {
      "seq": 3,
      "describe_ch": "依議題內容隨時強化相關知識\r\r\n",
      "describe_en": "Strengthen relevant knowledge at any time according to the content of the topic"
    },
    {
      "seq": 4,
      "describe_ch": "綜合企業議題的目標、特性、需求，與其含義\r\r\n",
      "describe_en": "Synthesize the goals, characteristics, needs, and meanings of corporate issues"
    }
