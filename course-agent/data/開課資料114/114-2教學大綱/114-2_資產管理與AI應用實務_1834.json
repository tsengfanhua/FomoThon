  "description": {
    "sub_id3": null,
    "sub_name": "資產管理與AI應用實務",
    "sub_ename": "ASSET MANAGEMENT AND PRACTICAL APPLICATIONS",
    "describe_ch": "本課程旨在透過產學共授模式，介紹人工智慧與量化分析技術在現代資產管理中的應用。課程將聚焦於AI主動式ETF的原理、投資策略與回測驗證，引導學生運用Python程式設計、機器學習等工具 建立量化投資模型。透過專案導向學習，學生須在業師指導下完成AI主動式ETF投資策略專題，培養將金融理論與數據應用於實務的能力。",
    "describe_eh": "This course aims to introduce the application of Artificial Intelligence (AI) and quantitative analysis techniques in modern asset management through an industry-academia collaboration model. The curriculum will focus on the principles, investment strategies, and backtesting verification of AI-driven active ETFs. Students will be guided to build quantitative investment models using tools such as Python programming and machine learning. Through Project-Based Learning (PBL), students must complete a specialized project on AI-driven active ETF investment strategies under the guidance of industry experts, cultivating the practical ability to apply financial theory and data to real-world scenarios.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解智慧量化投資與AI主動式ETF的原理。",
      "describe_en": "Comprehension of the core principles of intelligent quantitative investment and AI-driven active ETFs."
    },
    {
      "seq": 2,
      "describe_ch": "能應用量化技術與工具進行策略分析。",
      "describe_en": "Capability of applying quantitative techniques and tools for strategy analysis."
    },
    {
      "seq": 3,
      "describe_ch": "能透過小組討論與競賽提升溝通與協作能力。",
      "describe_en": "Capability of enhancing communication and teamwork through discussion and competition."
    }
  ],
