  "description": {
    "sub_id3": null,
    "sub_name": "品質管制",
    "sub_ename": "QUALITY CONTROL",
    "describe_ch": "旨在教導學生如何有效將品質管制的技術，應用在產品與服務的設計階段、生產階段、成品階段及售後服務階段，以管制產品與服務的品質，滿足顧客需求做到顧客滿意；企管系的學生必須充分暸解其系統架構及其運作模式，使能具備ISO9000的系統架構與工具應用。",
    "describe_eh": "The purpose of this course is to teach students how to use quality control technique in product and service design process, production process, finishing process, and after sales service process to control the quality of products and services and to satisfy the customers' needs. Students must fully understand it system structure and operating models in order that he/she may increase his/her competition power.",
    "pre_subname": "STAT1001統計學(一)、STAT1002統計學(二)",
    "pre_sub_id3": "STAT1001",
    "pre_sub_ename": "STAT1001 STATISTICS(1)、STAT1002 STATISTICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "描述基本的統計概念",
      "describe_en": "To describe basic statistical concepts"
    },
    {
      "seq": 2,
      "describe_ch": "表達成功運用統計製程管制(SPC)的管理哲學",
      "describe_en": "To present a management philosophy for successful application of statistical process control"
    },
    {
      "seq": 3,
      "describe_ch": "提供學生管制圖札實的基礎",
      "describe_en": "To give the student a solid foundation on control charts"
    },
    {
      "seq": 4,
      "describe_ch": "教導學生品質觀念跟統計製程管制問題的解決能力",
      "describe_en": "To teach the student the quality concepts and problem-solving techniques associated with statistical process control"
    },
    {
      "seq": 5,
      "describe_ch": "提供學生畢業後工作所需之高可讀性的SPC資源",
      "describe_en": "To provide a readable source of SPC topics that the student can refer to as the on-the-job need arises"
    }
  ],
