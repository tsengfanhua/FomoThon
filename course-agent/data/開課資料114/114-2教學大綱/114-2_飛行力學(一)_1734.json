  "description": {
    "sub_id3": null,
    "sub_name": "飛行力學(一)",
    "sub_ename": "FLIGHT MECHANICS(1)",
    "describe_ch": "傳統上飛行力學（flight mechanics）探討的內容有兩部分，第一部份是分析飛機的動穩定（dynamic stability）性質與其控制能力（control capability），並介紹有關的飛控設備（flight control devices）；第二部分則是分析飛機的飛行性能（performance），如飛機能飛得多快、多高、多遠、多久等等。本課程內容屬於第一部份，至於第二部分內容，則在飛行力學（二）再介紹。本課程重要內容有：靜穩定與控制，飛機之六自由度運動方程式，飛機縱向與橫向運動之穩定性分析，飛機飛行品質（flying quality）的設定，及Autopilot、SAS、ILS及ALS等飛控設備之構造與原理。\r\n\r\n",
    "describe_eh": " In tradition, the content of flight mechanics includes two parts, one is the analysis of the airplane's stability and control capabilities and introduces the flight control devices onboard, the other is the performance of the airplanes such as how fast, high, far, long can airplanes perform. The context of Flight Mechanics（1）is focusing on the first part mentioned above. For the second part is introduced in Flight Mechanics（2）.Topics of this course include: static stability and control, aircraft equations of motion, longitudinal motion, lateral motion, flying quality, autopilot, SAS, ILS, and ALS.",
    "pre_subname": "AERO3002空氣動力學(一)",
    "pre_sub_id3": "AERO3002",
    "pre_sub_ename": "AERO3002 AERODYNAMICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解飛機之靜穩定與控制性質\n\n",
      "describe_en": "To understand the static stability and control capability of the airplane.\n\n"
    },
    {
      "seq": 2,
      "describe_ch": "有能力建立飛機之六自由度運動方程式\n\n",
      "describe_en": "To be able to derive the airplane's equations of motion.\n\n"
    },
    {
      "seq": 3,
      "describe_ch": "熟悉飛機動穩定性質之分析方式與過程",
      "describe_en": "To get familiar with the analysis method and procedure for dynamic stability characteristics.\n\n"
    },
    {
      "seq": 4,
      "describe_ch": "了解飛機飛行品質與其穩定性質之關係\n\n",
      "describe_en": "To understand the relation between the flying quality and the stability characteristics.\n\n"
    },
    {
      "seq": 5,
      "describe_ch": " 了解現代飛機飛行控制設備之構造      與原理\n\n",
      "describe_en": "To understand the structure and principle of the modern flight control devices."
    }
  ],
