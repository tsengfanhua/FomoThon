  "description": {
    "sub_id3": null,
    "sub_name": "電子學(二)",
    "sub_ename": "ELECTRONICS(2)",
    "describe_ch": "本課程的目標是使學生瞭解放大器電路的相關基本設計技術：包含基礎單端放大器電路、雙端放大器電路以及電流鏡電路等。此課程將使學生對電子電路具備分析及設計的能力，也教導學生熟悉各類的放大器電路，對未來的類比電路設計奠定基礎。",
    "describe_eh": "This course will let students understand the basic design techniques of amplifier circuits including basic single-ended amplifier circuits, differential amplifier circuits, and current mirror circuits. This course will inspire students with the ability to analyze and design electronic circuits, and also teach them to be familiar with various amplifier circuits.",
    "pre_subname": "CEM1006微積分、PHYS1003普通物理(一)",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS、PHYS1003 GENERAL PHYSICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備各型MOS電晶體的結構、I-V特性與相關模型知識以及如何應用到相關電子電路分析的知識。",
      "describe_en": "Have the knowledge of how to describe the structure of MOSFETs and the I-V characteristics as well as their different models. and their usages on the circuit applications."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解由BJT與MOSFET電晶體所構建的單級以及多級放大器的結構、偏壓分析以及交流小信號分析技術。",
      "describe_en": "Comprehend the structures and techniques for the biasing and ac characteristics analysis of the amplifiers based on the BJT and MOSFET transistors."
    }
  ],
