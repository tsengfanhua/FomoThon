  "description": {
    "sub_id3": null,
    "sub_name": "企業碳排放管理與AI數位系統應用",
    "sub_ename": "CORPORATE CARBON EMISSION MANAGEMENT AND AI-BASED DIGITAL SYSTEMS",
    "describe_ch": "本課程聚焦企業碳排放管理，結合AI驅動的數位雲端系統，探討企業如何運用智慧化與數據化方法達成減碳目標。課程內容涵蓋碳盤查與碳管理的核心理論、國際減碳趨勢、數位化管理工具操作，以及AI在能源效率提升與減碳決策中的應用案例。透過理論學習、平台實作與案例分析，學生將培養企業永續轉型所需的碳管理與數據分析能力。",
    "describe_eh": "This course focuses on corporate carbon emission management by integrating AI-powered digital and cloud-based systems. It explores how businesses can achieve carbon reduction goals through intelligent and data-driven approaches. The course covers key theories of carbon inventory and management, global decarbonization trends, practical use of digital management tools, and case studies on AI applications in energy efficiency and emission reduction. Through theoretical learning, platform operation, and case analysis, students will develop essential competencies in carbon management and data analytics for sustainable corporate transformation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生將了解碳管理與對企業永續營運的影響",
      "describe_en": "Students will understand the impact of carbon management on the sustainable operation of enterprises."
    },
    {
      "seq": 2,
      "describe_ch": "學生將具備批判性評估企業碳足跡和能源管理效率的能力",
      "describe_en": "Students will have the ability to critically evaluate the carbon footprint of enterprises and the efficiency of energy management."
    }
  ],
