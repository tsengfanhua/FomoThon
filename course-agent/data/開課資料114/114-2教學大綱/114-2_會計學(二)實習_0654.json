  "description": {
    "sub_id3": null,
    "sub_name": "會計學(二)實習",
    "sub_ename": "RECITATION OF ACCOUNTING(2)",
    "describe_ch": "本課程介紹基本會計學原則及觀念，主要包括：應收帳款、存貨、長期性資產取得及折舊、公司會計、投資、負債及財務報表分析。\r\n",
    "describe_eh": "This course introduces basic accounting principle and concepts. The main topics include  receivable, inventory, plant assets acquisition and depreciation, corporate accounting, investment, liabilities and financial statements analysis。 \n",
    "pre_subname": "ACCT1011會計學(一)",
    "pre_sub_id3": "ACCT1011",
    "pre_sub_ename": "ACCT1011 ACCOUNTING(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 17,
      "describe_ch": "能知道會計學(二)涵蓋的主要內容及描述現代企業的財務報表及其限制。",
      "describe_en": "Knowledge for the content of Accounting II and modern business financial statements and their limitations."
    },
    {
      "seq": 18,
      "describe_ch": "能理解可應用會計學原理的情況。",
      "describe_en": "Comprehension for the application accounting principle situation."
    }
  ],
