  "description": {
    "sub_id3": null,
    "sub_name": "工程專業實習",
    "sub_ename": "ENGINEERING INTERNSHIP",
    "describe_ch": "本課程提供學生整學期在業界實習之經驗，強化學生實習實務知識，培養學生務實致用能力，以提升畢業生就業力。",
    "describe_eh": "This course offers students an experience to study off-campus during a whole semester. The course purposes are to let students integrate the theory and practice, strengthen professional skills, and improve professional competitiveness.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 9.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用專業知識及技術於工程實務之能力\t",
      "describe_en": "Ability to apply acquired knowledge and techniques to engineering practices\r\n\t"
    },
    {
      "seq": 2,
      "describe_ch": "具備整合及評估理論與實務的能力\t\r\n",
      "describe_en": "Ability to integrate and evaluate the theory and practice."
    },
    {
      "seq": 3,
      "describe_ch": "具備綜合評估實務案例及撰寫專業技術報告的能力\t",
      "describe_en": "Ability to evaluate practical engineering analysis and to write professional engineering report.\r\n"
    },
    {
      "seq": 4,
      "describe_ch": "具備終身學習、專業倫理及社會責任的基本素養\t",
      "describe_en": "Recognition of life-long learning, engineering ethics and social responsibilities.\r\n"
    }
  ],
