  "description": {
    "sub_id3": null,
    "sub_name": "任務和系統設計驗證確認",
    "sub_ename": "SPACE MISSION AND SYSTEM DESIGN VERIFICATION AND VALIDATION",
    "describe_ch": "該課程培養學生在太空任務和太空系統設計驗證確認方面的核心能力，涵蓋任務規劃、系統工程方法、設計驗證與確認、系統可靠性與安全性、資料分析與處理等內容，以應對太空系統工程領域的挑戰。",
    "describe_eh": "The course on Space Mission and System Design Verification and Validation aims to develop students' core competencies in planning and executing space missions, as well as ensuring the accuracy and reliability of space system designs. It covers topics such as mission planning, systems engineering methods, design verification and validation, system reliability and safety, and data analysis and processing. The course equips students to tackle the challenges of space systems engineering and prepares them to contribute effectively in the field.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生掌握太空系統工程基礎知識基本原理和方法。",
      "describe_en": "Enable students to master the basic principles and methods of the basic knowledge of space system engineering."
    },
    {
      "seq": 2,
      "describe_ch": "使學生瞭解任務設計與規劃的基礎知識基本原理和方法。",
      "describe_en": "Enable students to understand the basic principles and methods of mission design and planning."
    },
    {
      "seq": 3,
      "describe_ch": "使學生掌握系統工程方法。",
      "describe_en": "Make students to master systems engineering methods"
    },
    {
      "seq": 4,
      "describe_ch": "使學生學習系統設計驗證與確認的相關技巧。",
      "describe_en": "Make students to learn skills related to system design verification and validation."
    },
    {
      "seq": 5,
      "describe_ch": "使學生熟悉系統可靠性與安全性的基礎知識。",
      "describe_en": "Make students familiarize with the fundamentals of system reliability and security."
    },
    {
      "seq": 6,
      "describe_ch": "培養學生掌握任務和系統設計驗證確認的關鍵要素。",
      "describe_en": "Train students to master the key elements of mission and system design verification validation."
    }
  ],
