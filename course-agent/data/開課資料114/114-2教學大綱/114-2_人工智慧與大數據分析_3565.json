  "description": {
    "sub_id3": null,
    "sub_name": "人工智慧與大數據分析",
    "sub_ename": "ARTIFICIAL INTELLIGENCE AND BIG DATA ANALYTICS",
    "describe_ch": "本課程旨在培養學生理解人工智慧與大數據分析的基本理論與應用技巧。內容涵蓋資料清理、特徵工程、機器學習、深度學習與資料視覺化，並結合實作專題，讓學生能以Python應用AI模型於實際問題中，培養數據思考與決策能力。",
    "describe_eh": "This course aims to develop students’ understanding of the fundamental theories and practical applications of Artificial Intelligence and Big Data Analytics. Topics include data preprocessing, feature engineering, machine learning, deep learning, and data visualization. Through hands-on projects using Python, students will learn to apply AI models to real-world problems and enhance data-driven decision-making skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能解釋人工智慧、機器學習與大數據分析的核心術語與原理",
      "describe_en": "Explain the core terminologies and principles of AI, machine learning, and big data analytics."
    },
    {
      "seq": 2,
      "describe_ch": "能運用 Python 相關函式庫進行資料清洗、處理與可視化分析",
      "describe_en": "Utilize Python libraries for data cleaning, processing, and visualization."
    },
    {
      "seq": 3,
      "describe_ch": "能針對特定問題，選擇並實作合適的機器學習模型進行訓練與評估。",
      "describe_en": "Select and implement appropriate machine learning models for training and evaluation on specific problems."
    },
    {
      "seq": 4,
      "describe_ch": "能團隊合作完成AI應用專題並呈現結果",
      "describe_en": "Collaborate on AI-based projects and effectively present findings"
    }
  ],
