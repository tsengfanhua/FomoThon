  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB02310",
    "sub_id": "42331",
    "scr_dup": "001",
    "tpa_score_new": "<div>1.Group discussion &amp; presentation (%) 2.Individual participation and attendance (10%) 3.Homework (25%) 4.Mid-term exam (25%) 5.Final exam (25%)</div>\n",
    "tpa_score_new_en": "<div>1.Group discussion &amp; presentation (15%) 2.Individual participation and attendance (15%) 3.Homework (20%) 4.Mid-term exam (25%) 5.Final exam (25%)</div>\n",
    "course_pol": "Arrive at class on time, don’t eat meals, don’t look at mobile phones, use textbooks, copy notes in class, don’t chat with classmates, respect teachers and classmates. Be quiet, participate in discussions, and answer questions.\n準時到課、不吃餐點、不看手機、使用教科書、上課抄筆記、不與同學聊天，尊重老師也尊重同學。保持安靜、參與討論、有問必答。",
    "course_pol_en": "Arrive at class on time, do not eat meals, do not use mobile phones, use textbooks, take notes in class, do not chat with classmates, and respect both teachers and classmates. Keep quiet, participate in discussions, and answer all questions. The classroom is a place for learning; we hope you will concentrate on your studies to develop your professional skills.",
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<div>No cheating, no signature for others, no unexcused absence, earnestly complete homework, do a good job of previewing and reviewing homework. Don&#39;t be opportunistic, concentrate on listening to the class during class, and express opinions and participate in discussions in a timely manner.</div>\n\n<div>\n<div>不作弊、不代為簽名、不無故缺席、認真完成作業、作好預習及複習功課。不投機取巧，上課時專心聽課，並適時發表意見及參與討論。</div>\n</div>\n",
    "ais_meno_en": "<div>Do not cheat, do not sign for others, do not be absent without reason, complete assignments diligently, and do pre-class preparation and review. Do not take shortcuts, listen attentively in class, and express opinions and participate in discussions when appropriate.</div>\n\n<div>Do not chat with classmates, and respect both teachers and classmates. Keep quiet, participate in discussions, and answer all questions.</div>\n\n<div>&nbsp;</div>\n\n<div>&nbsp;</div>\n",
    "ilearn_mk": "N"
  },
