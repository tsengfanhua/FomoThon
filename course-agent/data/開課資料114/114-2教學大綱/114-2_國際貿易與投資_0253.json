  "description": {
    "sub_id3": null,
    "sub_name": "國際貿易與投資",
    "sub_ename": "INTERNATIONAL TRADE AND INVESTMENT",
    "describe_ch": "本課程旨在培養碩班研究生國際貿易理論與政策之分析能力，並結合當前國際貿易與投資議題之應用研究，以了解國際貿易與投資之發展。",
    "describe_eh": "This course is expected to equip students with ability of analyzing theory and policy of international trade, and its application to contemporary issues of international trade and investment, in order to explore the development of international trade and investment.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1. 應用國際貿易理論與政策。",
      "describe_en": "1. Application for the knowledge of international trade theory and policy."
    },
    {
      "seq": 2,
      "describe_ch": "2. 分析國際貿易與投資之動態及發展。",
      "describe_en": "2. Analysis of development of international trade and investment."
    }
