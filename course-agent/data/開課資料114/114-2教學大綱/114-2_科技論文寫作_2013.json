  "description": {
    "sub_id3": null,
    "sub_name": "科技論文寫作",
    "sub_ename": "ACADEMIC WRITING FOR GRADUATE STUDENTS",
    "describe_ch": "本課程旨在訓練學生科技論文寫作及閱讀之技巧，以提升研究生對於其專業研究成果的寫作與口語表達能力，以成就一篇符合投稿期刊要求的專業科技論文。",
    "describe_eh": "This course is aimed to provide students with writing and reading skills for academic essay and papers. It is also intended to improve student’s ability to present their innovated idea and academic research results with formal format literally and orally. Throughout the class, the students are expected to fulfill a professional technical paper that comply with the criteria of the journal submission.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解科技論文寫作的要素，學習報告與論文撰寫的步驟。",
      "describe_en": "To discover main elements of essay and academic writing; and to learn the structure of technical paper, and to recognize the procedures of essay writing."
    },
    {
      "seq": 2,
      "describe_ch": "能在科技論文寫作中使用正確的英文字彙與文法。",
      "describe_en": "To enhance student’s ability of employ accurate and proper English vocabulary, grammar, and punctuation in academic writing."
    },
    {
      "seq": 3,
      "describe_ch": "能正確使用中英文，撰寫一篇符合期刊格式規範並具備完整論文結構的專業科技論文。",
      "describe_en": "To develop student’s ability for composing and presenting his/her research idea and results literally and orally with professional academic writing criteria."
    }
  ],
