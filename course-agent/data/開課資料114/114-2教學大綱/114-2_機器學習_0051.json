  "description": {
    "sub_id3": null,
    "sub_name": "機器學習",
    "sub_ename": "MACHINE LEARNING",
    "describe_ch": "機器學習是對可通過經驗和數據來自動提高性能之學習演算法的研究。如今，機器學習已廣泛應用於我們的日常生活中。本課程是為對數據驅動問題感興趣並希望能應用在機器學習中學到的相關技術來實現合理解決方案的學生而設計。在本課程中，我們將提供機器學習的基本概念以及一些相關演算法。",
    "describe_eh": "Machine learning is the study of learning algorithms that automatically improve performance through experience and data. Nowadays, machine learning has been widely applied in our daily life. This course is designed for students who are interested in data-driven problems and implementing reasonable solutions through techniques learned in machine learning. In this course we will provide the basic concepts of machine learning as well as some related algorithms.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解機器學習的基本原理與理論",
      "describe_en": "Comprehension for the basic principles and theories of machine learning"
    },
    {
      "seq": 2,
      "describe_ch": "能運用相關工具實現機器學習演算法",
      "describe_en": "Ability to implement machine learning algorithms through the use of relevant tools"
    }
