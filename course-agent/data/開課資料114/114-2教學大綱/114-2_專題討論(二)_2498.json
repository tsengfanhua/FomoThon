  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(二)",
    "sub_ename": "SEMINAR(2)",
    "describe_ch": "針對碩士班論文寫作方法從選題、資料蒐集和寫作規範與方法，能有初步的瞭解。並且邀請知名專家學者，介紹材料科學的發展與應用，訓練研究生表達能力、研究分析能力、組織邏輯能力。",
    "describe_eh": "To have a preliminary understanding of the master's thesis writing methods from topic selection, data collection, and writing norms and methods. In addition, well-known experts and scholars are invited to introduce the development and application of materials science and train graduate students' expression ability, research and analysis ability, and organizational logic ability.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解材料科學在社會中的應用",
      "describe_en": "Understand the application of materials science to society and economy."
    },
    {
      "seq": 2,
      "describe_ch": "知道於何處可找到材料的相關資訊，並可評估所獲資訊的適用性",
      "describe_en": "Know where to locate and access related materials analysis information, research, as well as standards, and be able to evaluate the appropriateness of the obtained information."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解並說明科學論文的基本要求",
      "describe_en": "Understand and be able to explain the basic demand of the scientific thesis"
    },
    {
      "seq": 4,
      "describe_ch": "能以書面或口頭方式將所獲結果與同儕及教師展現",
      "describe_en": "Communicate results in written or oral form to classmates and the instructor."
    }
  ],
