  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB03123",
    "sub_id": "37840",
    "scr_dup": "001",
    "tpa_score_new": "<div>1. 期中考試占30%</div>\n\n<div>2.&nbsp;期末考試占35%</div>\n\n<div>3. 課堂討論和參與20%，包含隨堂練習10%，以及實習成績10%</div>\n\n<div>4. 期末分組報告占15%，包含書面報告與口頭報告</div>\n",
    "tpa_score_new_en": " ",
    "course_pol": "請尊重彼此，除課堂互動之外，上課期間請勿講話或發出聲音，以及進行可能影響他人學習之行為。\n請務必準時參加課程，並按照指定的時間準時提交作業。",
    "course_pol_en": null,
    "course_rem": "課程相關資料及重要資訊會於iLearn上公告，請同學隨時留意。",
    "course_rem_en": null,
    "ais_meno": "<div>修習課程應遵守學術誠信原則，並注意學術倫理，避免作弊或抄襲之行為。</div>\n\n<div>考試和專題報告如出現作弊或抄襲之行為，則以零分計。</div>\n\n<div>&nbsp;</div>\n\n<div>&nbsp;</div>\n",
    "ais_meno_en": "<div>Students are required to uphold the fundamental principles of academic integrity, place a strong emphasis on academic ethics, and take active measures to prevent instances of cheating or plagiarism.</div>\n\n<div>In the event that a student is found to have engaged in cheating or plagiarism, the consequences are serious. Examinations and final reports that involve such misconduct will be assigned a grade of zero.</div>\n\n<div>&nbsp;</div>\n",
    "ilearn_mk": "N"
  },
