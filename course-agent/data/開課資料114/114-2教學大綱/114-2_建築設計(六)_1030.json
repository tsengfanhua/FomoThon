  "description": {
    "sub_id3": null,
    "sub_name": "建築設計(六)",
    "sub_ename": "ARCHITECTURAL DESIGN(6)",
    "describe_ch": "本設計課程的目標是幫助同學，具備掌握單體建築系統與回應基地環境之設計能?。實際演練操作建築設計主題：(1)『住宿設施建築環境類型』及(2)『中高層複合辦公建築類型』;訓練同學能夠分析基地條件和使用者需求，配合從搖籃到搖籃、綠建築或追尋地方文化創意議題，進行設計概念與設計案之發展。能夠以簡報軟體、徒手繪製、電腦繪圖、模型製作來溝通表達其設計圖說與創意。",
    "describe_eh": "The purpose of this design studio is to help students to build up their design ability that they are able to handle a building system and response to its surrounding. By practicing and operating (1) residential facilities and architectural environment and (2) high-rise office complex, we train students to be able to analyze the conditions of a site and the needs of its users. Students should also develop their design concepts and proposals with the issue of from cradle to cradle, green architecture or searching the innovation of local culture. They will be able to communicate and present their design drawings and innovative concepts by the Power Point, hand drawing, CAD and models.",
    "pre_subname": "ARCH3001建築設計(五)",
    "pre_sub_id3": "ARCH3001",
    "pre_sub_ename": "ARCH3001 ARCHITECTURAL DESIGN(5)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠配合當代議題，如：從搖籃到搖籃、綠建築或追尋地方文化創意等，進行建築設計概念與設計案之發展。",
      "describe_en": " Students are able to analyze the conditions of a site and the needs of its users and build up their global view on architectural design through domestic and international case studies"
    },
    {
      "seq": 2,
      "describe_ch": "同學能夠分析基地條件和使用者需求。並且透過國內外相關案例分析，建立對於建築設計之國際觀。",
      "describe_en": "Students are able to analyze the conditions of a site and the needs of its users and build up their global view on architectural design through"
    },
    {
      "seq": 3,
      "describe_ch": "具備掌握建築系統與回應基地周邊環境之設計能力。能夠以簡報軟體、徒手繪製、電腦繪圖、模型製作來溝通表達其設計圖說與創意。",
      "describe_en": "Students are able to handle a building system and response to its surrounding. They will be able to communicate and present their design diagrams, drawings and innovative concepts by the Power Point, hand drawing, CAD and models."
    }
  ],
