  "description": {
    "sub_id3": null,
    "sub_name": "系統動力學與管理",
    "sub_ename": "SYSTEM DYNAMICS AND MANAGEMENT",
    "describe_ch": "本課程內容在使研究生獲得系統動態概念、發展適當的模擬模型以及使用模型進行決策和政策分析所需的知識和技能。本課程的核心是了解資訊回饋和循環因果關係在理解智能製造與工程管理系統的意義和應用性。",
    "describe_eh": "This course aims to guide students to acquire knowledge and skills required to build system dynamics concepts, develop appropriate simulation models, and use models for decision making and policy analysis. The core of this course is to understand the significance and usefulness of information feedback and circular causality in comprehending the intelligent manufacturing and engineering management systems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解系統動力學理論基礎與建模方法",
      "describe_en": "Understand the theoretical foundations and modeling methodologies of System Dynamics"
    },
    {
      "seq": 2,
      "describe_ch": "能應用系統思考方法分析問題與對策",
      "describe_en": "Apply systems thinking methodologies to analyze problems and develop solutions"
    },
    {
      "seq": 3,
      "describe_ch": "能應用系統模擬於智能製造與工程管理",
      "describe_en": "Apply system simulation to intelligent manufacturing and engineering management"
    }
  ],
