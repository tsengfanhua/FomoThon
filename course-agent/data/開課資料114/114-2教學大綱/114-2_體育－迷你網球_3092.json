  "description": {
    "sub_id3": null,
    "sub_name": "體育－迷你網球",
    "sub_ename": "MINI TENNIS",
    "describe_ch": "適合初學者的網球運動，透過較輕的球拍與球，可以讓初學者更快上手，通常做為硬式網球學習的前導課程，可從學習迷你網球課程中得到學習樂趣與足夠的身體活動量。迷你網球並沒有既定的比賽規則，以TBL (Team-Based Learning) 團隊合作學習模式，請學生進行規則構思與設計，期望藉由本課程培養學生創意思考、小組合作與專題報告實施等能力。",
    "describe_eh": "\"Mini Tennis\" is a tennis game for beginners. Through lighter racquets and balls, beginners can get started faster, usually as a lead course in tennis learning. Students can have enough physical activity and fun from the mini tennis lessons. In addition, mini tennis does not have established rules of the game. Therefore, this course will adopt the team-based learning model, and ask students to make rule decisions and designs. It is expected that students will be able to think creatively, teamwork and special report implementation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生能習得運動基礎知識與技能。",
      "describe_en": "Students are able to demonstrate sport knowledge and skills."
    },
    {
      "seq": 2,
      "describe_ch": "學生能透過課程培養創意思考能力與小組合作學習。",
      "describe_en": "Students are able to develop creative thinking skills and teamwork."
    }
  ],
