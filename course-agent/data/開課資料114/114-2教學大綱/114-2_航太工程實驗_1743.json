  "description": {
    "sub_id3": null,
    "sub_name": "航太工程實驗",
    "sub_ename": "AEROSPACE ENGINEERING LAB",
    "describe_ch": "本課程介紹針對航太飛行器所使用之結構材料，以其部分材料進行測試、檢測及修補。包括拉伸試驗、衝擊試驗、疲勞試驗、應變規量測、結構試驗、光彈試驗、非破壞檢測、以及複材修補。",
    "describe_eh": "This course provides an introduction to the experiments of structure materials measurement and repaired. The experiment tests include tensile test, impact test, fatigue test, strain-gage measurement, structure deflection test, photoelasticity test, non-destructive test, and composite repair experiment.",
    "pre_subname": "ENGS2001材料力學(一)、ENGS2002材料力學(二)、AERO1002航太工程概論",
    "pre_sub_id3": "ENGS2001",
    "pre_sub_ename": "ENGS2001 MECHANICS OF MATERIALS(1)、ENGS2002 MECHANICS OF MATERIALS(2)、AERO1002 INTRODUCTION  TO  AEROSPACE  ENGINEERING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生瞭解材料力學重要之基本概念與理論",
      "describe_en": "To acquire an understanding of the basic concepts and theory of material mechanics"
    },
    {
      "seq": 2,
      "describe_ch": "培養學生具備操作材料試驗機等檢測儀器，並且分析實驗結果之能力",
      "describe_en": "To gain the ability to operate mechanical test equipment and experimental methods as well as analyze mechanical problems"
    },
    {
      "seq": 3,
      "describe_ch": "訓練學生各種量測原理及量測儀器的使用能力，以及培養實驗規劃與設計基本能力與材料力學問題之應用",
      "describe_en": "To develop the ability of fundamental in mechanical measurement and the application of instruments for experimenting as well as the ability of experimental planning/designing and application to solution of mechanical problems"
    },
    {
      "seq": 4,
      "describe_ch": "培養團隊合作",
      "describe_en": "Team work"
    }
  ],
