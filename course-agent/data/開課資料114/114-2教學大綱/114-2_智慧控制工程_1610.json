  "description": {
    "sub_id3": null,
    "sub_name": "智慧控制工程",
    "sub_ename": "INTELLIGENT CONTROL ENGINEERING",
    "describe_ch": "本課程主要說明智慧控制之數學演算法與機器學習技術，建構學生智慧控制理論基礎。並藉由探討大數據分析、工業感測元件、控制方法與物聯網於工業4.0之應用，使學生具備完整智慧控制理論基礎與系統設計能力。",
    "describe_eh": "This course aims to introduce the mathematical algorithms and machine learning techniques to construct a theoretical foundation in intelligent control for students. Furthermore, we discuss the applications in industrial 4.0 including big data analysis, industrial sensors, control solutions, and the internet of things that equip students with a complete theoretical foundation and design capability in intelligent control engineering.",
    "pre_subname": "EEEN3008控制工程",
    "pre_sub_id3": "EEEN3008",
    "pre_sub_ename": "EEEN3008 CONTROL ENGINEERING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習智慧控制原理、方法與應用，數學演算法及機器學習，建構智慧控制工程知識基礎。",
      "describe_en": "Learning the theoretical foundation, mathematical algorithms and machine learning to construct a knowledge base of intelligent control for students."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解工業4.0所運用之大數據分析、工業感測與控制方法、與智慧物聯網技術",
      "describe_en": "To understand the applications of industrial 4.0 including big data analysis, industrial sensors, control solutions, and internet of things techniques."
    },
    {
      "seq": 3,
      "describe_ch": "使學生具備智慧控制設計能力。",
      "describe_en": "Enable students with the ability to design an intelligent control system."
    },
    {
      "seq": 4,
      "describe_ch": "透過書面及口頭方式進行期末報告。",
      "describe_en": "Final report in written and oral form."
    }
  ],
