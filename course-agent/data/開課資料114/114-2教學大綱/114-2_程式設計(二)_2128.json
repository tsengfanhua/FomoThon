  "description": {
    "sub_id3": null,
    "sub_name": "程式設計(二)",
    "sub_ename": "COMPUTER PROGRAMMING (2)",
    "describe_ch": "本課程主要內容介紹物件導向的基本觀念與程式技巧。學生將學習物件導向設計的概念、原則、方法與實作。修畢此課後，學生應具備使用物件導向特性，例如物件的封裝、繼承、多型等技巧來開發程式。",
    "describe_eh": "This course will introduce the basic of object oriented design. Students will learn the basic concept of object orientation, object oriented principles, object-oriented design methods and object oriented programming skills. After this course, students should have the ability to apply object oriented characteristics, such as object encapsulation, inheritance and polymorphism to develop software programs.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備物件導向程式設計的知識",
      "describe_en": "Correlation of Course Objectives and Basic/Core Lreaning Outcomes"
    },
    {
      "seq": 2,
      "describe_ch": "能理解物件導向設計的原則與技術",
      "describe_en": "Comprehension for the principles and techniques of object-oriented design"
    },
    {
      "seq": 3,
      "describe_ch": "能應用物件導向語言撰寫物件特性的程式",
      "describe_en": "To apply object-oriented language for implementing object-oriented programs."
    },
    {
      "seq": 4,
      "describe_ch": "能應用工具解決程式設計問題",
      "describe_en": "To apply tools to debug programs"
    }
  ],
