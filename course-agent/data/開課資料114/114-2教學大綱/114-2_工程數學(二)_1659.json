  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(二)",
    "sub_ename": "ENGINEERING MATHEMATICS(2)",
    "describe_ch": "學習在面對一個工程或物理的問題時，會對該問題做合理假設，建立適當的數學模型，並藉由數學工具求解，根據所得到的解對該問題加以驗證。此一數學工具為本課程的教學重點，包括向量微積分、正交函數與傅立葉級數、傅立葉分析與轉換、以及偏微分方程等內容。",
    "describe_eh": "This course will train students when they face an engineering or physics problem to make a proper hypothesis, to set an applicable mathematic model, to get the solution by using mathematic tools, and to verify the solution. This course focus on mathematic tools such as vector calculus, orthogonal function, fourier series, fourier analysis, fourier transform and partial differential equations, etc.",
    "pre_subname": "CEM1006微積分",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1. 能用自己的辭彙定義工程數學，描述重要的數學模型種類及其應用限制。",
      "describe_en": "1. Define engineering mathematics with their own words: be able to depict many important types of mathematic models and to understand its limitations of application."
    },
    {
      "seq": 2,
      "describe_ch": "2. 能使用相關軟體，完成一工程數學議題，並從中歸納出適當結論。",
      "describe_en": "2. Complete an engineering mathematics issue by using the related software and be able to generalize a conclusion from it."
    },
    {
      "seq": 3,
      "describe_ch": "3. 能針對一特定工程數學的議題或情境，定義問題、提出數學模型、求解，並適切歸納出容易了解的結論。",
      "describe_en": "3. Target a specific issue or a situation relating to engineering mathematics and then define the issue, submit the mathematic model, get the solution, and finally generalize a proper conclusion."
    },
    {
      "seq": 4,
      "describe_ch": "4. 能以書面或口頭方式將所獲結果與同儕、助教及教師溝通。",
      "describe_en": "4. Communicate results in written or oral form to classmates, teaching assistants, and the instructor."
    }
  ],
