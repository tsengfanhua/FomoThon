  "description": {
    "sub_id3": null,
    "sub_name": "物理化學(二)",
    "sub_ename": "PHYSICAL CHEMISTRY(2)",
    "describe_ch": "物理化學係應用物理方法於化問題處理的學問，它包括物質行為(特別是一種物質轉換到另一種物質之程序)通用原理的理論與實驗的定性、定量討論。它主要包括熱力學、化學動力學、量子化學及統計熱力學等主題。舉凡物質在平衡時的構造及化學變化之程序皆包括在其探討範圍。",
    "describe_eh": "Physical chemistry is the application of the methods of physics to chemical problems. It includes the qualitative and quantitative study, both experimental and theoretical, of the general principles determining the behavior of matter, particularly the transformation of one substance into another.Important topics include thermodynamics, chemical kinetics, quantum chemistry, and statistical mechanics. Physical chemistry encompasses the structure of matter at equilibrium as well as the process of chemical change.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解掌控化學程序發生與影響的基本架構",
      "describe_en": "Understand what principles dominate the transformation of substances　"
    },
    {
      "seq": 2,
      "describe_ch": "能整理相關學理,歸納出簡單結論",
      "describe_en": "Be able to organize the theories learned, and draw simple conclusion from what they learned　"
    },
    {
      "seq": 3,
      "describe_ch": "能以書面或口頭方式將所獲結果與同儕,教師溝通",
      "describe_en": "Communicate results in written or oral form to classmate and the instructor　"
    }
  ],
