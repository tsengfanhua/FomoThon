  "description": {
    "sub_id3": null,
    "sub_name": "台灣民間信仰",
    "sub_ename": "FOLK BELIEFS IN TAIWAN",
    "describe_ch": "本課程以歷史學為主，參考人類學、社會學等相關學門論著，使學生能熟悉台灣民間信仰的基本內涵。主要內容為： 台灣民間信仰的定義；台灣的開發與台灣民間信仰；台灣民間宗教與台灣社會的互動；台灣民間教派的發展;台灣民間信仰的神明與儀式;臺灣民間信仰的經典與教義等。",
    "describe_eh": "This program aims to guide students to understand the fundamental content in Taiwanese society. The main concern of this program are: 1) the definitions of the folk religion in Taiwanese society, 2) the development and folk religion in Taiwan, 3) the interaction between the society and the folk religion in Taiwan, 4) the history of folk religious sects in Taiwan, 5) the gods and religious ceremony of Taiwanese folk beliefs, 6) the scriptures and dogma of the folk religion in Taiwan.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過民間信仰觀念的瞭解，作為理解現今許多民間信仰現象的基礎。",
      "describe_en": " To realize the phenomenon of folk beliefs through the common concept of it."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解人和宗教間的關係，進而可以對人所處的社會及宗教行為進行正確的判斷及分析。",
      "describe_en": "To understand the relationship between human beings and religions to have the ability to analyze the behavior of cult and beliefs."
    }
  ],
