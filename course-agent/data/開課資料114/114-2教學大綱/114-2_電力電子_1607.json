  "description": {
    "sub_id3": null,
    "sub_name": "電力電子",
    "sub_ename": "POWER ELECTRONICS",
    "describe_ch": "此課程主要目標讓學生獲得電力電子/控制之電路分析與設計等方面的基礎能力，和有解決電力電子/控制之電路問題所需要的獨立思考與創新能力。訓練學生具有組織能力與溝通技術，讓學生能夠發揮團隊力量來解決問題。教導學生如何執行與驗證各項電力電子/控制之電路分析與設計。",
    "describe_eh": "The objective of this course is to give the fundamentals of power electronics. Incubating the students to achieve analysis and design ability of power electric control systems.",
    "pre_subname": "EEEN3019電機機械 (一)",
    "pre_sub_id3": "EEEN3019",
    "pre_sub_ename": "EEEN3019 ELECTRIC MACHINES (1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解相關電力電子學之原理及系統應用。",
      "describe_en": "Understand the principles of power electronics and its applications in a system."
    },
    {
      "seq": 2,
      "describe_ch": "能運用電力電子學之原理，並解析應用於實際系統。",
      "describe_en": "Apply power electronics theory to real power electronic systems and can analyze them."
    }
  ],
