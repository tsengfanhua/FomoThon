  "description": {
    "sub_id3": null,
    "sub_name": "國際企業專題",
    "sub_ename": "INTERNATIONAL BUSINESS MANAGEMENT CAPSTONE PROJECT",
    "describe_ch": "國際企業管理專題旨在統整同學國際企業管理專業知識，並在指導老師的協助下，以團隊方式完成一專題研究計畫案，以建立從問題確認、研究流程設計與規劃、資料蒐集與分析、到結論與建議之系統化觀念與架構，完成學用合一之目的。專題研究成果報告書內容涵蓋：研究背景、研究動機、研究目的、文獻探討、研究架構、研究流程、研究設計、資料蒐集、資料分析、結論與建議等。",
    "describe_eh": "The objective of this course is designed to introduce students how to integrate the knowledge of international business and write a research project by using business research method. This research paper is finished by teamwork. The main topic of the project covers: research background、motivation、objectives，literature review，research framework, research process, research design, data collection, data analysis, conclusions and recommendations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "蒐集商管專業問題的解決方法",
      "describe_en": "Gather possible solutions to the business and management problems"
    },
    {
      "seq": 2,
      "describe_ch": "提供合適的佐證資料(說明、舉例、插圖、統計圖表、比喻、引用相關資料)",
      "describe_en": "Provide proper supporting material\r\n(explanations, examples, illustrations, statistics, analogies, quotations from relevant authorities)\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "認知具備倫理的工作態度",
      "describe_en": "Be aware of working in an ethical manner"
    },
    {
      "seq": 4,
      "describe_ch": "組織與分析相關例證及資訊",
      "describe_en": "Organize and analyze evidence and raw data"
    },
    {
      "seq": 5,
      "describe_ch": "具備解讀國際事務議題之能力",
      "describe_en": "Have terminologies of business and management for global/international issues"
    }
  ],
