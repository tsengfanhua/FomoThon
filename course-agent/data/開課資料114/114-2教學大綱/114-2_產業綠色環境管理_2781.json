  "description": {
    "sub_id3": null,
    "sub_name": "產業綠色環境管理",
    "sub_ename": "GREEN ENVIRONMENT MANAGEMENT FOR INDUSTRY",
    "describe_ch": "產業綠色環境管理就是將環境保護的觀念融於企業的經營管理中，體現綠色生產目標，以樹立企業綠色形象。產業綠色環境管理可概括為“5R”原則，包括研究(Research)、減量(Reduce)、重複使用 (Reuse)、回收(Recycle)、與保護(Rescue)。",
    "describe_eh": " Green environment management for industry is to integrate the concept of environmental protection into the management in an enterprise and to realize the purpose of clean production to establish a green image of the company. Green environment management for industry could be generally summarized as the \"5R (Research, Reduce, Reuse, Recycle and Rescue)\" principle:.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解產業中的環境保護相關程序",
      "describe_en": "To understand the environmental protection process"
    },
    {
      "seq": 2,
      "describe_ch": "能分析產業中的環境管理與能源使用狀況，並提出潔淨生產方案",
      "describe_en": "To analyze the status of environment management and energy consumption in the industry and provide the clean production proposal"
    }
  ],
