  "description": {
    "sub_id3": null,
    "sub_name": "應用力學(二)",
    "sub_ename": "APPLIED MECHANICS(2)",
    "describe_ch": "應用力學是描述及預測力作用於剛體的現象或結果，分為靜力學與動力學。應用力學(二)為動力學，是分析剛體受外力作用時所受到的拘束條件及運動。本課程為機構分析與合成的預備課程，並為設計機器等工程應用之基礎。",
    "describe_eh": "Applied Mechanics is a physical science which describes and predicts the results of rigid bodies under action of forces. It is divided into statics and dynamics. Applied Mechanics (2) deals with dynamics which analyzes the constraints and motion of rigid bodies under action of forces. This course is a pre-work of mechanism analysis and synthesis, and provides as a foundation in machine design.",
    "pre_subname": "MATH1001微積分(一)、PHYS1003普通物理(一)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、PHYS1003 GENERAL PHYSICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解並說明力學的基本觀念，包括空間、時間、質量、力。",
      "describe_en": "Understand and be able to explain the basic concepts used in mechanics, including space, time, mass, and force."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明質點與剛體在應用力學上的定義與它們在工程應用上的差異。",
      "describe_en": "Understand and be able to explain the definition of particles and rigid bodies. Also, be able to explain the difference between particle and rigid body in engineering application."
    },
    {
      "seq": 3,
      "describe_ch": "逐步建立將應用力學(包括靜力學與動力學)基本觀念應用於工程分析的基礎能力。",
      "describe_en": "Develop the ability of employing the basic concepts of mechanics, including statics and dynamics, in engineering analysis."
    },
    {
      "seq": 4,
      "describe_ch": "逐步建立將工程分析，利用數學工具，如座標系、向量、代數、微積分，轉變為可解析的數學模型的能力。",
      "describe_en": "Develop the ability of adopting mathematics (e.g. coordinates, vectors, algebra, calculus, etc.) to transfer engineering problem into solvable mathematical model."
    }
  ],
