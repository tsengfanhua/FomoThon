  "description": {
    "sub_id3": null,
    "sub_name": "語音與發音",
    "sub_ename": "PHONETICS AND PRONUNCIATION",
    "describe_ch": "本課程將介紹基本的語音學概念，並帶領學生使用語音分析軟體進行實作，透過知識與實務並重的方式，幫助學生理解語音發音的基本原理，並透過實際量測來驗證所學。期望學生能將所學應用於未來的語言自學或教學實踐，進一步提升學習效果。",
    "describe_eh": "This course introduces fundamental concepts in phonetics and provide hands-on practice with phonetic analysis software. By integrating theoretical knowledge with practical application, students will develop a deeper understanding of the basic principles of speech sounds and validate their learning through actual measurements. The course aims to equip students with skills to apply what they have learned to language self-study or teaching practices in the future, thereby enhancing their learning outcomes.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習語言學與英語教學相關領域的理論基礎與專業知識",
      "describe_en": "To learn knowledge and theories in the fields of linguistics, Teaching English as a Foreign Language (TEFL) and the related areas"
    },
    {
      "seq": 2,
      "describe_ch": "應用語言學與英語教學相關知識於教學實務與教材設計",
      "describe_en": "To apply the knowledge of linguistics and Teaching English as a Foreign Language (TEFL) to English language teaching and course design"
    }
  ],
