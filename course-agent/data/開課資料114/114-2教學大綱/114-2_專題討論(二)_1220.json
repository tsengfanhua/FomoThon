    "sub_name": "專題討論(二)",
    "sub_ename": "SEMINAR(2)",
    "describe_ch": "藉由文獻專題討論講授研究方法，培養學生發掘問題及蒐集資料之能力，進而熟悉各領域所探討的訴求及重點，以加強對IE的應用能力。",
    "describe_eh": "This course is designed to study and discuss concept and applications of IE by literature review.  Students then should know how to collect and analyze information and how to apply IE theory and skills solve problems.",
    "pre_subname": "ENGS6931專題討論(一)",
    "pre_sub_id3": "ENGS6931",
    "pre_sub_ename": "ENGS6931 SEMINAR(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解文獻研析之方法，及如何確立研究議題及範圍。",
      "describe_en": "Understanding how to literature review, and how to define and confirm research topic and the scope.    B1"
    },
    {
      "seq": 2,
      "describe_ch": "透過小組討論培養團隊合作及互動與溝通能力。",
      "describe_en": "Training the abilities of cooperative team work, interaction, and communication through group discussion."
    },
    {
      "seq": 3,
      "describe_ch": "能自行評估各種組合，並提出創新且可行方法。",
      "describe_en": "Be able to   self-assess various combinations and propose innovative and feasible approaches."
    },
    {
      "seq": 5,
      "describe_ch": "透過討論的文獻過程，可以使同學瞭解 專業倫理及社會責任與國際視野。",
      "describe_en": "Be able to through the literature discussion process, students can understand professional ethics, social responsibility and international perspective."
    }
  ],
