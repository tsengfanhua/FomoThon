  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "NM04110",
    "sub_id": "31258",
    "scr_dup": "001",
    "tpa_score_new": "10% Attendance\n20% Homework Assignments\n20% Lab Assignments\n25% Midterm Written Exam\n25% Final Practical Exam",
    "tpa_score_new_en": "<div>10% Attendance 20% Homework Assignments 20% Lab Assignments 25% Midterm Written Exam 25% Final Exam&nbsp;</div>\n",
    "course_pol": null,
    "course_pol_en": "Always maintain high academic and behavioral standards in all interactions.\n\nTimeliness and Participation: Ensure punctual attendance. Avoid distractions such as non-course-related activities and engage actively in group discussions, valuing every member's contribution.\n\nDevice Management: Use laptops/tablets solely for note-taking and ensure mobile devices are silenced. Refrain from wearing earphones.\n \nStudent Responsibilities: Regularly update and check official university communication channels, and actively provide feedback for course improvements. Uphold academic integrity both inside and outside the classroom.",
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": null,
    "ais_meno_en": "<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div><strong>1</strong>: Produce original work; cheating or plagiarism results in zero.&nbsp;</div>\n\n<div><strong>2</strong>: Cooperate for projects, but writings must be unique. Improper citation leads to zero marks and potential disciplinary actions.</div>\n\n<div><strong>3</strong>: Misrepresentation or resubmission of same work faces grade cuts and school disciplinary actions.</div>\n\n<div><strong>4</strong>: Works should be original, with less than 30% similarity on Turnitin. Always cite sources.</div>\n\n<div><strong>5</strong>: Plagiarism is theft; uncredited work receives a &quot;0&quot; or &quot;fail&quot; score.&nbsp;</div>\n</div>\n</div>\n</div>\n\n<div>\n<div>\n<div>&nbsp;</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n",
