  "description": {
    "sub_id3": null,
    "sub_name": "土壤力學試驗",
    "sub_ename": "SOIL MECHANICS LABORATORY",
    "describe_ch": "介紹土壤力學的基本試驗，包括含水量、土粒比重、顆粒大小分佈 (機械篩法)、顆粒大小分佈 (比重計法)、阿太堡限度、土壤分類、土壤夯實。儀器觀摩示範者包括現地密度、滲透、直接剪力、壓密、三軸試驗等。",
    "describe_eh": "This course introduces various elementary laboratory tests for soil mechanics including water content, specific gravity of soil solid, grain-size distribution by mechanical sieving, grain-size distribution by hydrometer, Atterberg limit, soil classification, soil compaction.  Some demo tests include field density, permeability, direct shear, consolidation, and triaxial tests.",
    "pre_subname": "CE2071土壤力學、CE1001應用力學、CE2078材料力學",
    "pre_sub_id3": "CE2071",
    "pre_sub_ename": "CE2071 SOIL MECHANICS、CE1001 APPLIED MECHANICS、CE2078 MECHANICS OF MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習各種土壤力學試驗之基本原理與操作步驟\n\n",
      "describe_en": "Understand the basic principle and testing procedure of various soil laboratory tests"
    },
    {
      "seq": 2,
      "describe_ch": "能理解各種試驗數據之計算方法",
      "describe_en": "Comprehension of the data computation for various soil laboratory tests"
    },
    {
      "seq": 3,
      "describe_ch": "具有撰寫專業報告之初等能力",
      "describe_en": "Be able to write an elementary professional report"
    }
  ],
