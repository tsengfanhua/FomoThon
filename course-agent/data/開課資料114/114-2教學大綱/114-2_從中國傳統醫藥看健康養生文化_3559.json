  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "XC06111",
    "sub_id": "GM906",
    "scr_dup": "001",
    "sub_title": "探究中國傳統醫藥中的生命觀、身體觀與健康養生文化。",
    "sub_title_en": null,
    "sub_describe": "本課程關注中國傳統醫藥如何回應人一生中面對的健康問題，從出生、成長、老化到疾病與死亡，探討中國人如何透過醫藥與養生知識理解身體、維持健康。課程將介紹中國傳統醫學的基本觀念，並結合日常生活中的養生實踐，幫助學生理解健康並非單純的醫療行為，而是一種與文化、生活方式密切相關的整體思考。透過這樣的探究，學生不僅能認識中國傳統醫藥的知識背景，也能反思自身的生活習慣與健康觀念，進一步培養對身心健康的重視。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "從中國傳統醫藥看健康養生文化",
    "sub_ename": "EXPLORING HEALTH AND WELLNESS CULTURE THROUGH TRADITIONAL CHINESE MEDICINE",
    "describe_ch": "生、老、病、死為每一個人生命旅途的必經之路，在這段旅途中難免會遭遇各種疾患病症，此時人們就需要仰賴醫學的幫助。而中國在歷史中發展出諸多不同的醫學傳統、文化體系，乃至於各種詮釋身體運行的思考模式，以及治療技術與本草藥方，從日常生活中預防或治療疾病，以達延年長壽之目的。本課程將帶領學生從人的生命歷程出發，探討中國傳統醫藥在這過程中所發揮的作用與意義，以及這些文化在現在華人社會所發揮的作用。",
    "describe_eh": "Birth, aging, illness, and death are inevitable stages in every person's life journey. Along the way, individuals inevitably encounter various ailments and health challenges, at which point medical assistance becomes essential. Throughout its history, China has developed a variety of medical traditions and cultural systems, as well as diverse conceptual frameworks for understanding the human body, therapeutic techniques, and herbal remedies. These approaches aim to prevent or treat illness in daily life, ultimately pursuing longevity and well-being. This course will guide students to explore the human life cycle as a starting point for examining the role and significance of traditional Chinese medicine throughout this process. It will also investigate how these medical traditions continue to influence and shape health practices in contemporary Chinese-speaking societies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "帶領學生認識中國古代醫學與養生知識。",
      "describe_en": "To lead students to explore the knowledge of traditional Chinese medicine and health cultivation in ancient China."
    },
    {
      "seq": 2,
      "describe_ch": "促進同學對健康議題的關注，重視自己的身心健康。",
      "describe_en": "To encourage students to care about health issues and take better care of their own body and mind."
    }
  ],
