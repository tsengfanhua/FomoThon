  "description": {
    "sub_id3": null,
    "sub_name": "水處理工程設計",
    "sub_ename": "DESIGN OF WATER TREATMENT",
    "describe_ch": "本課程包含「水處理單元」各單元之原理解說 (初篩、化學沉降、混凝與膠凝、沉砂與沉澱、浮除、快砂濾與慢砂濾、好氧與厭氧生物處理、氧化還原及高級氧化、消毒、薄膜過濾與分離、吸附與離子交換等單元) 及設計基礎實務外?並透過水處理目標(如: 放流水標準、再生水標準、飲用水質標準)或實例進行水處理程序、反應器設計與管線規劃。",
    "describe_eh": "This course aimed to facilitate students applying previous fundamental knowledge in water treatment unit operations (e.g. screening, chemical precipitation, coagulation and flocculation, grit chamber and sedimentation, slow and rapid sand filtration, aerobic and anaerobic biological treatment, oxidation, reduction and advanced oxidation process, disinfection, membrane filtration and separation, adsorption and ion exchange) as well as reactor design and piping.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備應用水處理各項單元功能的能力。",
      "describe_en": "To apply functions of each or combined water treatment units"
    },
    {
      "seq": 2,
      "describe_ch": "具備解析水處理工程基本原理參數計算的能力。\t",
      "describe_en": "To understand how to calculate and analyze operational parameters in water treatment units"
    },
    {
      "seq": 3,
      "describe_ch": "具備理解水處理相關工程系統或單元規劃設計的能力。\t",
      "describe_en": "To design a water and a wastewater treatment process"
    }
  ],
