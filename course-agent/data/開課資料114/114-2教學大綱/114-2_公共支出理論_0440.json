  "description": {
    "sub_id3": null,
    "sub_name": "公共支出理論",
    "sub_ename": "PUBLIC EXPENDITURE THEORY",
    "describe_ch": "本課程乃探討公共支出理論，內容涵蓋市場失靈、外部性公共財、公共選擇、成本效益分析、購買性政府支出(國防、教育及交通支出)、移轉性政府支出(醫療照顧、年金及失業保險)等主題，同時也介紹地方公共支出理論，探討最適地方性公共財的提供。",
    "describe_eh": "This course introduces public expenditure theory, including public goods in theory and practices, externalities, public choices, cost-benefit analysis, and government expenditure programs, etc",
    "pre_subname": "ECON2001個體經濟學(一)、ECON2002個體經濟學(二)",
    "pre_sub_id3": "ECON2001",
    "pre_sub_ename": "ECON2001 MICROECONOMICS(1)、ECON2002 MICROECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解公共經濟學與福利經濟學",
      "describe_en": "To understand the foundation of Public Economics and Welfare Economics.　"
    },
    {
      "seq": 2,
      "describe_ch": "能分析公共財最適數量的決定、外部性的影響與地方財政相關議題",
      "describe_en": "To analysis the optimal public goods provision, the effects of externalities and the issues of local public expenditure. 　"
    },
    {
      "seq": 3,
      "describe_ch": "能以成本效益分析評鑑公共支出政策",
      "describe_en": "To evaluate the public expenditure by cost-benefit analysis making."
    }
  ],
