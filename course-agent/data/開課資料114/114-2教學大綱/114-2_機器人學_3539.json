  "description": {
    "sub_id3": null,
    "sub_name": "機器人學",
    "sub_ename": "ROBOTICS",
    "describe_ch": "本課程介紹機器人學基本原理與應用，內容著重於工業機械臂的運動學、逆運動學、動力學、控制及軌跡規劃等議題的方程式建立與應用方法，並將涵蓋機器人函式庫進行電腦程式模擬以及FANUC 工業機械臂操作。課程中將以分組方式進行課程討論以及團隊合作方式進行課程小專題。",
    "describe_eh": "This course introduces the fundamental principles and applications of robotics, focusing on establishing equations and application methods for topics such as the forward kinematics, inverse kinematics, dynamics, control, and trajectory planning of industrial robotic arms. Additionally, the workshop will address the utilization of computer simulation through the employment of robot libraries, along with the operation of FANUC industrial robotic arms. Course discussions will be conducted in groups, and small-scale projects will be completed through teamwork.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解機器人基礎運動學、動力學、控制及軌跡規劃議題。",
      "describe_en": "Understand fundamental robotics topics including kinematics, dynamics, control, and trajectory planning."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解機器人應用在工程製造與設計的重要性。",
      "describe_en": "Understand the importance of robotics applications in engineering manufacturing and design."
    },
    {
      "seq": 3,
      "describe_ch": "能針對機器人應用系統，設計一合理實驗加以驗證，並適切歸納出結論。",
      "describe_en": "Design a reasonable experiment to validate the robotic application system and draw appropriate conclusions."
    }
  ],
