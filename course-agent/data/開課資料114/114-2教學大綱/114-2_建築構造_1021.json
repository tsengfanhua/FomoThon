  "description": {
    "sub_id3": null,
    "sub_name": "建築構造",
    "sub_ename": "BUILDING CONSTRUCTION",
    "describe_ch": "對建築構造各項工程施工原理、施工方法及建築材料的應用作初步了解。本課程講授內容包括基礎工程施工原理及安全技術。鋼筋混凝土購架施工原理及鋼骨工程架構施工原理、木構造種類及架構的施工方法、預錄(precast)混凝土構造的施工方法極帷幕牆(curtain wall)構造的施工方法等。台灣地區常遭受到颱風侵襲及2000年的921地震後，建築遭受嚴重破壞及經常發生火災事件，故建築防災計畫成為授課重要的一環。\n",
    "describe_eh": "The course is to train the students to understand the theory of construction, the way of construction, and the application of constructing material. The course includes the theory of construction and technology of safety. The theory of concrete construction, wool construction, precast construction, and the curtain wall would be lectured.After the destroy of typhoon and earthquake (9/21, 2000), the accidental prevention would be one crucial point in this course.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠瞭解建築構造與建築設計執行的關係。並能清楚說明其對設計與工程執行的重要性。",
      "describe_en": "Be able to understand the relationship between the construction and architecture design; and explain the importance of the relationship on design and the execution of building."
    },
    {
      "seq": 2,
      "describe_ch": "了解各種建築材料的構成關係，並說明其構造的特性。",
      "describe_en": "Understand the composition of materials of building; and explain the characteristic of construction."
    },
    {
      "seq": 3,
      "describe_ch": "能夠了解各種構造類型的房屋構成，並清楚的說明其施工步驟與特性。",
      "describe_en": "Understand the composition of building types, and describe the procedure and characteristic of construction."
    },
    {
      "seq": 4,
      "describe_ch": "可實際執行簡易的構造設計，並分析其主要的構成概念。",
      "describe_en": "Be able to design the simple construction, and analysis the key concept."
    },
    {
      "seq": 5,
      "describe_ch": "可在作業現場指認辨識其作業項目及作業重點。",
      "describe_en": "Distinguish the item and key point when view on the scene."
    },
    {
      "seq": 6,
      "describe_ch": "由構造設計的特性了解工程的價值。",
      "describe_en": "Understand the value of buildings by the characteristic of construction design."
    }
  ],
