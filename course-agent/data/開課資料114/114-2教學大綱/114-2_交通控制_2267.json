  "description": {
    "sub_id3": null,
    "sub_name": "交通控制",
    "sub_ename": "TRAFFIC CONTROL",
    "describe_ch": "介紹都市交通與高速公路之交通控誌理論，並將此理論應用於實際之交通管制方案外，更透過相關模擬軟體探討應用於路口並探討其績效，以掌握交通控制策略與目的。",
    "describe_eh": "This course introduces the concepts and theory for traffic control system. The students could enhance their abilities for traffic signal timing optimization in urban streets and setup effective traffic relief strategies in highway systems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.培養學生運用運輸與物流專業理論解決實務問題之能力。",
      "describe_en": "1. Develop students' ability to use professional transportation and logistics theories to solve practical problems"
    },
    {
      "seq": 2,
      "describe_ch": "3.培養學生妥適運用資訊科技或分析軟體處理實務問題之能力。",
      "describe_en": "3. Develop students' ability to properly analyze transportation or logistics problems using data investigation, data analysis, or mathematical models."
    },
    {
      "seq": 3,
      "describe_ch": "8.培養學生具備交通工程師應盡之專業倫理道德與社會責任。",
      "describe_en": "8. Develop students' professional ethics and social responsibilities as traffic engineers."
    },
    {
      "seq": 4,
      "describe_ch": "9.培養學生獨立研究、發現及解決運輸或物流專業問題之能力。",
      "describe_en": "9. Develop students' ability to independently research, discover, and solve professional problems in transportation or logistics."
    }
  ],
