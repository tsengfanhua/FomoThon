  "description": {
    "sub_id3": null,
    "sub_name": "量子計算原理",
    "sub_ename": "PRINCIPLES OF QUANTUM COMPUTING",
    "describe_ch": "本課程將介紹量子的基本知識與量子計算的數學原理，內容包括量子位元、疊加態和糾纏態、量子邏輯閘、Shor演算法等主題。",
    "describe_eh": "This course will introduce basic concepts of quantum and mathematical principles of quantum computing. The materials include quantum bits, superposition, entanglement, quantum logic gates and Shor's algorithm.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
