  "description": {
    "sub_id3": null,
    "sub_name": "萃思系統化方法導論",
    "sub_ename": "INTRODUCTION OF TRIZ SYSTEMATIC METHOD",
    "describe_ch": "本課程之介紹萃智(TRIZ)的起源，觀念、方法及整體架構。介紹如何使用 TRIZ 工具以及方 法以易進行系統化解決問題。本課程將培養創意設計的鑑賞和分析能力以提升產品設計或 問題解決的創造力。",
    "describe_eh": "This course introduces the origin, concept, method and overall structure of TRIZ. Introduce how to use TRIZ tools and method to easily solve problems systematically. This course will enhance appreciation and analysis capabilities and the creativity of product design or problem solving.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解 TRIZ 的理論基礎及各種 TRIZ 工 具與方法。",
      "describe_en": "Understand the theoretical basis of TRIZ and various TRIZ tools and methods."
    },
    {
      "seq": 2,
      "describe_ch": "認知 TRIZ 原理及方法能系統化分析問題 及解決問題。",
      "describe_en": "Recognize TRIZ principles and methods be able to analyze and systematically solve problems. \r\nB1"
    }
  ],
