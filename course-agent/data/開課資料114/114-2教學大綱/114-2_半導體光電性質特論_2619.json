  "description": {
    "sub_id3": null,
    "sub_name": "半導體光電性質特論",
    "sub_ename": "OPTICAL AND ELECTRICAL PROPERTIES OF SEMICONDUCTORS",
    "describe_ch": "本課程為半導體光電性質的特論，為進階半導體材料之光電性質專業課程。本課程由影響半導體光學與電學特性之基本物理(如載子、激子、聲子、接面、狀態密度等)切入，進一步介紹現行量測技術，最後將進一步討論這些光電特性在不同維度下的物理變化。",
    "describe_eh": "This course will introduce the fundamental knowledge of the properties and applications of photonics materials, as well as the basic principle and analysis method of different measurement instruments. Students will be able to correctly select appropriate photonics material measurement tools and to analyze the data and results. The course emphasizes both theoretical learning and practical case studies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解半導體光學與電學原理與特性，以及量測技術。",
      "describe_en": "Understand the principles, characteristics, and measurement technique of semiconductor materials in optical and electrical characterization."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉半導體相關專業術語，並能處理和分析半導體材料光學與電學相關的問題。",
      "describe_en": "Be familiar with the related terms in the field of semiconductor materials. Be able to solve the problems of optical and electrical characterization."
    },
    {
      "seq": 3,
      "describe_ch": "能以書面或口頭方式將所獲結果與同儕、助教及教師溝通。",
      "describe_en": "Be able to present results in written or oral form to classmates, teaching assistants, and the instructor."
    },
    {
      "seq": 4,
      "describe_ch": "能將所獲半導體材料光學與電學結果，以英文書面表現。",
      "describe_en": "Be able to present results of semiconductor materials related to optics and electrics\r\nin English written form.\r\n"
    },
    {
      "seq": 5,
      "describe_ch": "能將團隊所獲半導體材料光學與電學結果，以英文口頭報告表現。",
      "describe_en": "Be able to present teams’ results of semiconductor materials related to optics and electrics in English oral form."
    }
  ],
