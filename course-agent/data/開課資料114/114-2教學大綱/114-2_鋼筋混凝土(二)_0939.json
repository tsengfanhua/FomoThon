  "description": {
    "sub_id3": null,
    "sub_name": "鋼筋混凝土(二)",
    "sub_ename": "REINFORCED CONCRETE(2)",
    "describe_ch": "本課程教導學生如何去設計鋼筋混凝土構材。課程內容包含 (1) 短柱設計，(2) 細長柱設計，(3) 基礎設計，(4) 懸臂式擋土牆設計。 \r\n",
    "describe_eh": "This course introduces students how to design reinforced concrete members.The contents of the course are：(1) short column design；(2) slender column design；(3) footing design (4) design of cantilever retaining wall。\r\n",
    "pre_subname": "CE2078材料力學",
    "pre_sub_id3": "CE2078",
    "pre_sub_ename": "CE2078 MECHANICS OF MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉單向版的設計。\n",
      "describe_en": "To be familiar with the design of one-way slab"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解短柱的分析與設計。",
      "describe_en": "To understand the design of short columns"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解長柱的分析與設計。",
      "describe_en": "To understand the design of slender columns"
    },
    {
      "seq": 4,
      "describe_ch": "熟悉基礎與擋土牆之分析與設計。",
      "describe_en": "To be familiar with the design of footingsand retaining wall\r\n"
    }
  ],
