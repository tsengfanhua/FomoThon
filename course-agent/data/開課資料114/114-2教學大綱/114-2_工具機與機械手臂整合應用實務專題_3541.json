  "description": {
    "sub_id3": null,
    "sub_name": "工具機與機械手臂整合應用實務專題",
    "sub_ename": "PRACTICAL PROJECTS IN CNC AND ROBOTIC ARM INTEGRATION",
    "describe_ch": "修習本PBL課程的學生將培養智慧製造與機器人應用的核心技能，包括機器視覺辨識、機械手臂控制、路徑規劃與虛實整合等。學生將學習使用深度學習模型進行工件辨識與姿態估測，操作六軸機械手臂並實作控制器設計，結合ROS平台完成模擬與真實系統整合。課程也涵蓋人機介面設計與產線設備通訊，使學生能進行系統部署與整合實作。",
    "describe_eh": "Students enrolled in this PBL course will develop core skills in intelligent manufacturing and robotic applications, including machine vision recognition, robotic arm control, path planning, and cyber-physical integration. They will learn to use deep learning models for workpiece recognition and pose estimation, operate six-axis robotic arms, and implement controller design while integrating simulations and real systems through the ROS platform. The course also covers human–machine interface design and communication between production line devices, enabling students to perform system deployment and integration tasks.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建立學生對智慧製造系統與機械手臂整合架構之理解，熟悉工具機與機器人協作控制的基礎原理。",
      "describe_en": "Develop students’ understanding of intelligent manufacturing systems and the integration architecture between machine tools and robotic arms, emphasizing collaborative control principles."
    },
    {
      "seq": 2,
      "describe_ch": "建立學生使用機器視覺與深度學習進行工件辨識與姿態估測之能力，能應用於自動化製程。",
      "describe_en": "Equip students with the ability to apply machine vision and deep learning for workpiece recognition and pose estimation in automated processes."
    },
    {
      "seq": 3,
      "describe_ch": "建立學生對ROS平台與控制器設計之實作能力，能完成虛實整合與系統測試。",
      "describe_en": "Cultivate hands-on skills in controller design and ROS-based implementation to achieve cyber-physical system integration and testing."
    },
    {
      "seq": 4,
      "describe_ch": "建立學生跨領域專題實作與團隊協作能力，能結合AI、控制與機械技術進行創新應用與系統整合。",
      "describe_en": "Foster interdisciplinary project execution and teamwork capabilities, enabling students to integrate AI, control, and mechanical technologies for innovative applications and system integration."
    }
  ],
