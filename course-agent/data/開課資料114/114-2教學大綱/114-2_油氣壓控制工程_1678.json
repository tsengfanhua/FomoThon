  "description": {
    "sub_id3": null,
    "sub_name": "油氣壓控制工程",
    "sub_ename": "HYDRAULIC & PNEUMATIC ENGINEERING",
    "describe_ch": "氣壓控制系統包括純氣壓和電氣-氣壓控制，課程內容包含氣壓控制元件、氣壓操作原\n 理、元件安裝和管路裝配、純氣壓控制系統的優點，何時選用氣壓控制和迴路設計技術\n 等……。",
    "describe_eh": "Pneumatic control system included total pneumatic control and electropneumatic. This course introduces pneumatic components, pneumatic operating principles, mounting and piping, advantage of total pneumatic control system, when to choose pneumatic control and circuit design skills etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.瞭解各種油氣壓系統之基本功能控制方塊圖",
      "describe_en": "1.Understanding the basic function and  control block diagram for various pneumatic/ hydraulic systems."
    },
    {
      "seq": 2,
      "describe_ch": "2.理解各種油氣壓元件與油氣壓迴路的工程原理與設計方法",
      "describe_en": "2.Comprehension for the engineering principle and design method of various pneumatic/ hydraulic devices and circuits."
    },
    {
      "seq": 3,
      "describe_ch": "3.應用階梯圖之觀念與方法完成油氣壓迴路之電氣設計與測試",
      "describe_en": "3.Application for the ladder diagram concept and method to design pneumatic/ hydraulic electrical circuits."
    }
  ],
