  },
  "readings": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB35511",
    "sub_id": "31502",
    "scr_dup": "001",
    "tpc_seq": 1,
    "tpc_book": "<div>1.TED TALKS 說話的力量：你可以用言語來改變自己，也改變世界 TED唯一官方版演講指南</div>\n\n<div><a href=\"https://search.books.com.tw/search/query/cat/all/key/TED%20Talks%20%20The%20Official%20TED%20Guide%20to%20Public%20Speaking\">TED Talks The Official TED Guide to Public Speaking</a><br />\n作者：&nbsp;<a href=\"https://search.books.com.tw/search/query/key/%E5%85%8B%E9%87%8C%E6%96%AF%EF%BC%8E%E5%AE%89%E5%BE%B7%E6%A3%AE/adv_author/1/\">克里斯．安德森</a>&nbsp;出版社：<a href=\"https://www.books.com.tw/web/sys_puballb/books/?pubid=locus\">大塊文化</a><br />\n2.忘形流簡報思考術：找到說服邏輯，讓你的價值被看見！</div>\n\n<div>作者：&nbsp;<a href=\"https://search.books.com.tw/search/query/key/%E5%BC%B5%E5%BF%98%E5%BD%A2/adv_author/1/\">張忘形</a>&nbsp;出版社：<a href=\"https://www.books.com.tw/web/sys_puballb/books/?pubid=ctpubco\">時報出版</a></div>\n",
    "tpc_book_en": null
  },
  "iSoftwares": [
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB35511",
      "sub_id": "31502",
      "scr_dup": "001",
      "seq_no": 1,
      "soft_kind": "2",
      "soft_name": "PowerPoint\nPrezi\nVisme\nCanva\nSparkol\nAudacity\nCamtasia\nOBS\nGoogle Slides\nVenngage\nSlideShare",
      "soft_memo": "<ol>\n\t<li>PowerPoint:最常用的簡報軟體,可以添加註解、動畫等功能,輔助口語表達。</li>\n\t<li>Keynote:蘋果電腦上的簡報軟體,提供多样版型與互動元素。</li>\n\t<li>Prezi:基於網路的簡報軟體,支持非線性編排,增加表達趣味性。</li>\n\t<li>Visme:線上圖文設計軟體,提供豐富範本,適合製作互動式簡報。</li>\n\t<li>Canva:視覺設計軟體,能快速製作美觀的簡報。</li>\n\t<li>Sparkol:能製作動畫簡報,增加趣味性。</li>\n\t<li>Audacity:音訊編輯軟體,可以錄製展示音訊。</li>\n\t<li>Camtasia:錄製螢幕影片,錄製展示簡報的過程。</li>\n\t<li>OBS:開源直播和錄影軟體,錄製商業簡報影片。</li>\n\t<li>Google Slides:線上製作和分享簡報，支持多人協作。</li>\n\t<li>\n\t<div>Venngage:創建信息圖表和視覺化數據，提供豐富的模板和圖表類型，簡化數據視覺化過程。</div>\n\t</li>\n\t<li>\n\t<div>\n\t<div>SlideShare:分享和查看簡報， 全球最大的簡報分享社區，可以查找靈感和參考資料。</div>\n\t</div>\n\t</li>\n</ol>\n",
      "soft_name_en": null,
      "soft_memo_en": null
    }
  ],
