  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB02149",
    "sub_id": "41551",
    "scr_dup": "001",
    "sub_title": "課程宗旨：本課程旨在培養同學的邏輯思考與分析能力，特別適合希望挑戰主動學習、提升個人學習效果的高年級同學（大三以上）修課。課程採哈佛大學個案教學法，透過國際及華人企業的實務案例，運用邏輯推論分析與解決全球市場開發與管理問題，並整合跨領域知識。授課以互動式教學為主，鼓勵同學積極參與與團隊合作。希望同學們學會跨域整合大一至大三修習過的課程,解決國際市場開發與管理上所遭遇的問題。程教材將搭配國際知名企業以及華人企業的全球市場開發個案，探討海外市場機會分析、消費需求、與跨文化品牌建立等管理議題。",
    "sub_title_en": null,
    "sub_describe": null,
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "國際市場開發與管理",
    "sub_ename": "INTERNATIONAL MARKET DEVELOPING AND MANAGEMENT",
    "describe_ch": "講授廠商如何進行商情資訊之搜集、產品設計開發、大陸市場之開發與台商訂單、通關處理、參加國際商展實務及專業證照輔導，以培養國貿系學生能縱橫國際貿易舞台。",
    "describe_eh": "This course teaches the students how to develop the international markets, including collecting business information, designing the products, developing Mainland China and ASEAN market, tackling order procedures and import/export declaration, participating in international trade exhibitions, passing the career certified on Documentary Letter of Credit. The students with these backgrounds are easier to operate trading management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "本課程協助學生整合大一至大四所所習的之知識工具，運用於分析與解決國際市場開發面臨的實務挑戰，如海外市場選擇，產品調整與市場策略等。課程目的在於培育出具備全球視野和在地市場洞察力的貿易人才。",
      "describe_en": "This course assists students in integrating the knowledge and tools acquired from their freshman to senior years, applying them to analyze and address practical challenges in international market development, such as overseas market selection, product adjustments, and market strategies. The objective of the course is to cultivate trade professionals who possess a global perspective and local insights."
    }
  ],
