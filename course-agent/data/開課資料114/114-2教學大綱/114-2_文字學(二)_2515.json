  "description": {
    "sub_id3": null,
    "sub_name": "文字學(二)",
    "sub_ename": "CHINESE SCRIPT(2)",
    "describe_ch": "課程內容包括：一、漢字的演變，著重文字起源與演進的介紹；二、漢字與文化，著重文化與漢字構形的結合；三、漢字構形學，介紹許慎六書理論；四、古文字學概說，以引導學生認識甲骨文、金文、簡帛等出土文獻為目標。",
    "describe_eh": "The topic describes mainly about the beginning and the section relationship of Chinese words. The digging matters.Besides,the aim to introduce the theovy of xushens liushe basically with the word is zhuanshu.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉文字之起源與發展，以瞭解各代書體構形之特徵。",
      "describe_en": "Familiarize with the development of Chinese characters in order to recognize the structures of Chinese writing systems at different periods."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解傳統六書說明形構的理據。",
      "describe_en": "Understand Liu Shu, the six principles of creating Chinese characters, and develop the precise methods to analyze glyphs."
    },
    {
      "seq": 3,
      "describe_ch": "培養正確分析字形的方法。",
      "describe_en": " Examine the connection among the graph, sound and meaning of Chinese characters as the foundation of Phonology and Scholium."
    }
  ],
