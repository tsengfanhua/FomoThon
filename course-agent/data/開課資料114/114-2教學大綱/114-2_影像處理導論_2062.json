  "description": {
    "sub_id3": null,
    "sub_name": "影像處理導論",
    "sub_ename": "INTRODUCTION TO IMAGE PROCESSING",
    "describe_ch": "本課程介紹影像處理的基本觀念、理論及演算法,使學生具有進一步深入此領域的基礎。主要授課內容包括影像基本原理、影像加強、影像恢復、彩色影像處理、影像壓縮、型態學、影像分割、影像描述及物件識別等,學生將透過作業及電腦實習了解上述課題之觀念。",
    "describe_eh": "The course provides an introduction to basic concepts and methodologies for image processing and develops the foundation for further study in this diverse and rapidly evolving field. The topics include image fundamentals, image enhancement, restoration, color image processing, image compression, morphology, segmentation, image description, and object recognition. These topics are illustrated by numerous computer-processed images. Students will be assigned analytical and programming assignments to explore these concepts.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "明瞭影像處理之基本理論及演算法，能夠了解影像加強、恢復、影像分割、物件描述及辨識之原理。",
      "describe_en": "enhancement, image recovery, morphological image processing, image segmentation, and image object recognition."
    },
    {
      "seq": 2,
      "describe_ch": "應用各種轉換及影像濾波器於各種環境下之影像處理問題。",
      "describe_en": "Apply the image processing algorithm to handle different image processing problems."
    },
    {
      "seq": 3,
      "describe_ch": "能夠分析各種影像處理架構及其效能。",
      "describe_en": "Be able to construct the image processing procedure and analyze the performance of the image processing algorithm."
    }
  ],
