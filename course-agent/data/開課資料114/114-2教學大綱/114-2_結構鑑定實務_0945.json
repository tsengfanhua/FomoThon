  "description": {
    "sub_id3": null,
    "sub_name": "結構鑑定實務",
    "sub_ename": "PRACTICAL STRUCTURAL ASSESSMENT",
    "describe_ch": "本課程以實際案例說明之方式，介紹各種關於結構物安全之鑑定方法與流程。並介紹在鑑定過程中，可能有關的各種非破壞檢測技術。",
    "describe_eh": "This course provides an introduction to the methodologies and procedures for evaluating the safety of structures, illustrated through real-world case studies. Emphasis is placed on practical approaches to structural assessment, with a particular focus on methods applicable in engineering practice. In addition, the course presents a range of non-destructive testing techniques that may be employed during the assessment process to support reliable evaluation outcomes.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
