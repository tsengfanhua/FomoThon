  "description": {
    "sub_id3": null,
    "sub_name": "人工智慧視覺加速器設計",
    "sub_ename": "AI VISUAL ACCELERATOR DESIGN",
    "describe_ch": "現代人工智慧視覺運算量高，而GPU之功率消耗和成本居高不下，無法滿足大多數的運算需求，因此，亟需人工智慧加速器。本課程介紹人工智慧視覺加速器的設計方法，帶學生一窺最新科技奧秘。",
    "describe_eh": "Modern AI visual computation requires extremely high complexity. Meanwhile, the power consumption and area cost of graphic processing units (GPU) stay high so that most of the computation requests cannot be satisfied. Therefore, AI visual accelerators are urgently needed. This course introduces design methodology for AI visual accelerators, and brings the latest technical state-of-the-arts to students.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知曉如何建構人工智慧視覺加速器。",
      "describe_en": "Knowing how to establish AI visual accelerators."
    },
    {
      "seq": 2,
      "describe_ch": "知曉如何驗證所建構之人工智慧視覺加速器。",
      "describe_en": "Knowing how to verify established visual accelerators."
    }
  ],
