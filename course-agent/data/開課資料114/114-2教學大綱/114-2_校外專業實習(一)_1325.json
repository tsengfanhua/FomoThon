  "description": {
    "sub_id3": null,
    "sub_name": "校外專業實習(一)",
    "sub_ename": "OFF-CAMPUS INTERNSHIP(1)",
    "describe_ch": "本課程提供學生至資訊相關產業進行實習的機會，經由遴選讓學生到合作的機構服務，透過實務的練習加強專業技能。目的在加強理論與實務的整合，提供實際的工作經驗來培訓學生將來成為資訊專業人才，以提升未來就業和職涯競爭力",
    "describe_eh": "The course is designed to offer students a practical training opportunity in information related industry. Recommended students will gain practical experience to improve professional skills as part of their services in the participating organizations. It aims to enhance the integration of theory and practice, train students to acquire work experience in real work environments to become information professionals, and help them become more competitive in the job market and career development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "強化學生的專業技能在實務上的應用",
      "describe_en": "To strengthen students' professional skills in real-world applications."
    },
    {
      "seq": 2,
      "describe_ch": "讓學生學習職場的溝通協調與團隊合作之能力",
      "describe_en": "To encourage students to learn effective workplace communication and teamwork strategies."
    },
    {
      "seq": 3,
      "describe_ch": "培育學生具備終身學習、專業倫理及社會責任的基本素養",
      "describe_en": "To cultivate students’ possession of life-long learning capabilities, professional ethics and social responsibilities."
    }
  ],
