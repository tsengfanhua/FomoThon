  "description": {
    "sub_id3": null,
    "sub_name": "所得稅理論與制度",
    "sub_ename": "THEORY AND SYSTEM OF INCOME TAX",
    "describe_ch": "介紹所得稅基本概念與現行所得稅制度（含兩稅合一）及綜合所得稅申報業務，並比較各國所得稅制度。探討所得稅制度與政策等相關議題如資本增益稅及最低稅負制。",
    "describe_eh": "Introduce basic concepts of income tax and our current income tax system. Discuss Individual Income Tax, Business Income Tax, and imputation system.  Compare the differences between the income tax system in Taiwan and that in other countries. Discuss issues related to income tax systems and policies such as capital gains tax and Alternative Minimum tax… etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解不同的所得稅制度",
      "describe_en": "Able to understand different income tax systems"
    },
    {
      "seq": 2,
      "describe_ch": "能比較分析我國與其他國家所得稅制度與政策",
      "describe_en": "Able to compare and analyze the income tax systems and policies of our country and other nations"
    }
