  "description": {
    "sub_id3": null,
    "sub_name": "永續發展概論",
    "sub_ename": "INTRODUCTION TO SUSTAINABLE DEVELOPMENT",
    "describe_ch": "本課程旨在介紹學生永續發展的基本概念、原則和實踐，強調經濟、社會和環境之間的平衡。透過案例研究、跨學科的探討以及實際應用，學生將深入了解永續發展的理念，並培養在不同領域中實現永續目標的能力。 \r\n",
    "describe_eh": "The course aims to introduce students to the fundamental concepts, principles, and practices of sustainable development, emphasizing the balance between the economic, social, and environmental aspects. Through case studies, interdisciplinary discussions, and practical applications, students will gain a profound understanding of the principles of sustainable development and cultivate the ability to achieve sustainability goals in various fields. \r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生知悉永續發展之脈絡與經濟、社會和環境三面向之內涵。學生意識到個體與組織在實現永續目標之角色，提升個人的責任和參與。",
      "describe_en": "Students will gain an understanding of the context of sustainable development and the implications within the economic, social, and environmental dimensions.They will become aware of the roles that individuals and organizations play in achieving sustainable goals, thereby enhancing personal responsibility and engagement."
    }
  ],
