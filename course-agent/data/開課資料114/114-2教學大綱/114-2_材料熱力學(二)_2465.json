  "description": {
    "sub_id3": null,
    "sub_name": "材料熱力學(二)",
    "sub_ename": "THERMODYNAMICS OF MATERIALS(2)",
    "describe_ch": "材料的特性、相變化關係皆與其製程或使用的溫度息息相關。材料熱力學為一門判斷系統狀態是否穩定、預測反應進行的可行性及預測變化的趨勢之科學，本課程特以材料領域之熱力學應用範圍作為教學主體，包含化學反應平衡，溶液熱力學，二元系統中的相平衡與自由能之間的關係。以課堂授課與測驗等方式建立學生學理應用的基礎。",
    "describe_eh": "The relations between material characteristic and phase transformation correlate closely with process or temperature. Thermodynamic of materials is a subject used to determine a system is steady or not. It also can be used to expect the possibility of reaction and the tendency of variation. This course contains the material field of thermodynamics as a leading role of teaching, including correlations among the equilibrium of chemical reactions, solution thermodynamics, relations between free energies and phase equilibria in binary systems etc., for the purpose of establishing student’s basic knowledge of the subject by both teaching and examination.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解化學反應平衡、定義標準狀態、氣體反應、氣相固相反應、氧化反應和Ellingham圖",
      "describe_en": "Equilibrium of chemical reactions: definition of standard states; gas reactions; gas-solid reactions; oxidation reactions and the Ellingham diagram."
    },
    {
      "seq": 2,
      "describe_ch": "了解溶液熱力學中的活性和活性係數、溶液形成的自由能、二元系統成分的化學勢 Gibbs-Duhem 關係式\r\n",
      "describe_en": "Solution thermodynamics: activity and activity coefficient; free energy of formation of solutions; chemical potentials of specifies in a binary system; Gibbs-Duhem relation."
    },
    {
      "seq": 3,
      "describe_ch": "了解在二元系統裡自由能和相平衡的關係、二元相圖、Level rule 和 Gibbs 相律\r\n\n\n\n",
      "describe_en": "Relation between free energies and phase equilibria in binary systems; binary phase diagrams; Level rule and Gibbs phase rule."
    }
  ],
