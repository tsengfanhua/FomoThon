  "description": {
    "sub_id3": null,
    "sub_name": "質性研究方法",
    "sub_ename": " QUALITATIVE RESEARCH METHOD",
    "describe_ch": "本課程旨在從項目設計、數據收集、分析和撰寫方面對定性研究方法進行總體概述。本課程涵蓋的主題包括四種類型：(1) 民族志，(2) 現象學研究，(3) 社會傳播研究，以及 (4) 案例研究。",
    "describe_eh": "This course aims at providing a general overview of the qualitative research methods in terms of project design, data collection, analyses, and writing up. Topics to be covered in the course include four genres: (1) ethnography, (2) phenomenological study, (3) socio-communication study, and (4) case study.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解質性研究的概念、理論及方法。",
      "describe_en": "Be able to understand the concepts, theories and methods of qualitative research."
    },
    {
      "seq": 2,
      "describe_ch": "能具備質性研究設計、資料蒐集、分析及撰寫報告的能力。",
      "describe_en": "Be able to design qualitative researches, collect data, analyze and write papers."
    },
    {
      "seq": 3,
      "describe_ch": "綜合探討研究規劃與發展之影響因素",
      "describe_en": "Synthesis for the factors that affect research planning and development."
    }
  ],
