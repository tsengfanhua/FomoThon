  "description": {
    "sub_id3": null,
    "sub_name": "高等會計學(二)",
    "sub_ename": "ADVANCED ACCOUNTING(2)",
    "describe_ch": "本課程包含二個重要的目標 : (1)了解合併報表編製的相關問題；例如複雜型態的控股(間接與交叉)，母公司股權的變動，企業合併所衍生的所得稅分配問題，(2)了解外幣交易所產生的會計程序以及合併報表的編製。",
    "describe_eh": "Two objectives for this course:(1)to learn some specific issues related to consolidated financial statements; such as complex ( indirect and mutual) holdings, changes of the parent company's ownership, etc. , (2) to learn the accounting procedures and consolidated financial statements preparations for the foreign currencies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習「間接控股」與「交叉持股」形態下，一套(完整)合併報表的編製；包含(a)小股東權益分析，與(b)各個沖銷分錄的製作原理。",
      "describe_en": "To learn the theories and the preparations of a complete set of consolidated financial statements for indirect and mutual holdings; including (a) the analysis and determination of the noncontrolling interest, and (b) the reasons for each elimination entry"
    },
    {
      "seq": 2,
      "describe_ch": "分析各種不同情況下，母公司投資權益的變動金額，以及其會計處理程序(APB Opinion No.18與SFAS No.160)；包含優先與普通股東的權益分配。",
      "describe_en": "To analyze the change of a parent company's equity interest under different circumstances, and learn the necessary procedures for the preparations of journal entries and worksheet elimination entries in conformity with GAAP(APB Opinion No.18 and SFAS No.1"
    },
    {
      "seq": 3,
      "describe_ch": "學習「功能貨幣」的性質，以及(a)外幣交易(SFAS No.52)，與(b)避險會計(SFAS No.133與SFAS No.138)的帳務處理程序；包含外幣交易與期貨交易產生的匯兌損益分析與計算",
      "describe_en": "To learn the nature of a functional currency and the accounting procedures for (a) the foreign currency transactions(SFAS No.52), and (b) the hedging accounting(SFAS No.133 and SFAS No.138); including the analysis and determination of the exchange gain (o"
    },
    {
      "seq": 4,
      "describe_ch": "學習三種不同情況下：翻譯、重新衡量、翻譯＋重新衡量，「外幣報表」的合併程序(SFAS No.52)。",
      "describe_en": "To learn the consolidation procedures for a foreign subsidiary(SFAS No.52) under the three different cases: translation, remeasurement, and translation plus remeasurement."
    }
  ],
