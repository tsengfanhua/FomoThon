  "description": {
    "sub_id3": null,
    "sub_name": "保險監理",
    "sub_ename": "INSURANCE SUPERVISION",
    "describe_ch": "由於保險業受到政府密切的監督，因此監理政策對保險業的營運及獲利有很大的影響。本課程的主要目的就是在討論政府監理保險業的理由，及監理對保險公司承保業務與財務投資的影響。",
    "describe_eh": "Since insurance companies operate in regulated world, regulatory policies may affect the performance and profitability of the industry. This course introduces the rationale of insurance regulation and show how regulation may affect underwriting and financial operation of insurance companies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "教導學生對保險業在政府監理制度之下，承保及投資業務運作之深入瞭解，並培養學生提出創見的能力。",
      "describe_en": "Each student able to understand the need of insurance supervision, the relationship between underwriting and investment activities, and to train the ability to analyze the problems in the insurance industry."
    }
  ],
