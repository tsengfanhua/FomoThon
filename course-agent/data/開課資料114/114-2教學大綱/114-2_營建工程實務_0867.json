  "description": {
    "sub_id3": null,
    "sub_name": "營建工程實務",
    "sub_ename": "CONSTRUCTION ENGINEERING PRACTICE",
    "describe_ch": "本課程邀請多位業師介紹建築與土木工程相關的營建實務主題，旨在填補校園課程與實際工程需求間的差距，使新手工程師具備營建工程實務所需的各項基本知識與素養。",
    "describe_eh": "This course invites construction industry experts to introduce practical construction topics related to architecture and civil engineering. It aims to bridge the gap between campus curriculums and the practical requirements of novice engineers, equipping them with the essential knowledge and skills needed for construction engineering.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
