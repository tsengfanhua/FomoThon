  "description": {
    "sub_id3": null,
    "sub_name": "空間行為與感知研究",
    "sub_ename": "SPATIAL BEHAVIOR PERCEPTION RESEARCH",
    "describe_ch": "介紹空間行為與實質環境間的關係，包括五感與感知理論、各類概念與尺度空間之實證與應用。同學可將本課程相關應用知識於觀察、評估、分析現有環境中，進而規劃、設計新空間或優化舊環境，期望以此提升目的性之空間規劃。",
    "describe_eh": "Introduce the relationship between spatial behavior and physical environment, including the five senses and perception theory, the demonstration and application of various concepts and scale spaces. Students can use the relevant application knowledge of this course to observe, evaluate and analyze the existing environment, and then plan, design new space or optimize the old environment, and hope to enhance the purpose of spatial planning.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "空間對應友善空間與感知體驗",
      "describe_en": "Space corresponds to friendly space and experience perceived"
    },
    {
      "seq": 2,
      "describe_ch": "優化空間設計與整合創意之能力",
      "describe_en": "Optimize space and integrate the creativity ability"
    }
