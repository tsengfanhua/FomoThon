  "description": {
    "sub_id3": null,
    "sub_name": "組織行為",
    "sub_ename": "ORGANIZATIONAL BEHAVIOR",
    "describe_ch": "本課程旨在探討組織中有關「人的行為」、以及「行為背後的原因」。課程內容包括三大部份： 個體行為、群體行為、及組織系統特性。 瞭解組織中各種行為及背後原因，將甚有助於管理者做好管理工作。",
    "describe_eh": "This course aims at human behaviors and , especially, reasons behind various behaviors in organizations. The contents of this course includes three parts ： individual behavior, group behavior, and organization system. To understand human behaviors and their reasons will give much help to managers for making organizations effective.",
    "pre_subname": "MGT1001管理學、MGT1002企業概論",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT、MGT1002 INTRODUCTION TO BUSINESS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解組織行為之意義與內涵, 並能瞭解組織中有關個人行為、群體行為、組織系統特性等方面之重要知識、理論、原則、與實務。",
      "describe_en": "To understand the meaning and contents of Organizational Behavior (OB) and the knowledge, theories, principles and practice related to individual behavior, group behavior and organization system in an organization."
    },
    {
      "seq": 2,
      "describe_ch": "能了解溝通的原理,技巧及重要性, 並能運用組織行為之相關知識及本身人際能力，用溝通來促進組織中之合作、協調、領導與工作表現。",
      "describe_en": "To realize the principles, skills and importance of communication and be able to utilize the relevant knowledge and social skills to improve cooperation, coordination, leadership, and job performance through communication in an organization."
    },
    {
      "seq": 3,
      "describe_ch": "能運用組織行為之基本知識來思考如何從事有效之管理並解決問題。",
      "describe_en": "To apply the fundamental knowledge of Organizational Behavior to think how to manage effectively and to solve related"
    }
  ],
