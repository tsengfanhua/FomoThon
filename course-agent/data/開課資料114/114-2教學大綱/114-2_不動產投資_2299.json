  "description": {
    "sub_id3": null,
    "sub_name": "不動產投資",
    "sub_ename": "REAL ESTATE INVESTMENT",
    "describe_ch": "不動產投資學為欲投資不動產時所需具備之入門課程之一。本課程除對不動產相關內容作一簡單介紹，並介紹不動產投資評估所需具備之方法與相關議題。主題包括不動產簡介、投資分析數學、不動產評價、財務報表、投資評估方法、不動產證券化等。\n",
    "describe_eh": "This is the one of the major courses in entering real estate investment analysis. This course introduces the basic concepts of real estate, methods of real estate investment analysis and some other relative topics. The main topics include introduction of real estate, mathematics of real estate investment analysis, real estate valuations, financial statements, methods of real estate investment analysis, real estate securitization, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能分析投資的效益，並提出投資的財務計劃。",
      "describe_en": "Be able to analyze the return of investment and to propose a financial plan."
    },
    {
      "seq": 2,
      "describe_ch": "能運用不動產經營管理技巧，編寫不動產投資執行計劃。",
      "describe_en": "Be able to apply real estate management technique to compose a real estate development plan."
    },
    {
      "seq": 3,
      "describe_ch": "能提出投資個案的營建管理及使用管理計劃。",
      "describe_en": "Be able to propose a plan for construction management and usage management plan."
    }
  ],
