  "description": {
    "sub_id3": null,
    "sub_name": "商業英文簡報",
    "sub_ename": "BUSINESS ENGLISH PRESENTATION",
    "describe_ch": "熟悉商業英文詞彙及用語，並訓練學生商業簡報之處理技巧，同時能以英文呈現商業上之溝通與表達，以期使學生有效地理解在工作職場中商業英文簡報的重要性。",
    "describe_eh": "The course is designed to enable students to be familiar with words and terms in Business English, and to train presentation skills and communication in English. The purpose of the course is to let students understand the importance of business presentation in workplace.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解、分辨、定義及討論主要商業英文專有用字並能加以應用。",
      "describe_en": "To comprehend, identify, define and discuss key Business English concepts and terminology and know how to apply them."
    },
    {
      "seq": 2,
      "describe_ch": "理解語言與文化在商業上的重要性，特別是在產品、服務、溝通、談判、廣告、行銷通路上。",
      "describe_en": "Comprehension for the importance of language and culture in business, particularly regarding products, services, communication, contract negotiations, advertising, and channels of distribution."
    }
  ],
