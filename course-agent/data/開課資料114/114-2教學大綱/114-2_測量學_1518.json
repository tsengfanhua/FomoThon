  "description": {
    "sub_id3": null,
    "sub_name": "測量學",
    "sub_ename": "SURVEYING",
    "describe_ch": "測量學是確定空間點位間相關位置的專業學門。課程著重於平面測量學基本觀念及理論，內容含括基本知識、高程測量、角度測量、距離測量、控制測量、測量誤差與數據處理等。並透過戶外儀器操作實習，使理論與實務相結合。",
    "describe_eh": "Surveying is the professional disciplines that to determine the spatial location. The course focuses on the basic concepts and theories, which encompasses basic knowledge, leveling, angular measurement, distance measurement, control measurement, measurement errors and data processing. Through outdoor equipment operation training to combine theory and practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能認識測量學的基本觀念與理論。",
      "describe_en": "Can understand basic concepts and theories of surveying."
    },
    {
      "seq": 2,
      "describe_ch": "能理解測量誤差與數據處理方法。",
      "describe_en": "Can understand that measurement errors and data processing method.\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "能應用不同測量方法與技術。",
      "describe_en": "Able to apply different measurement methods and technologies."
    },
    {
      "seq": 4,
      "describe_ch": "能獲得永續環境認知能力。",
      "describe_en": "To obtain sustainable environmental cognition ability.\r\n"
    }
  ],
