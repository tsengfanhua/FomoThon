    {
      "seq": 1,
      "describe_ch": "將程式語言視為建築設計進一步的創作工具與媒介",
      "describe_en": "Using programming languages as further creative tools and mediums for architectural design"
    },
    {
      "seq": 2,
      "describe_ch": "培養對演算法與機器學習的基本理解和興趣",
      "describe_en": "Cultivate a fundamental understanding and interest in algorithms and machine learning."
    },
    {
      "seq": 3,
      "describe_ch": "具備設計、學習、優化和評估能夠反映數據中的規則和關係的模型之跨領域整合能力",
      "describe_en": "Practice interdisciplinary integration skills in designing, learning, optimizing, and evaluating models that can reflect rules and relationships in data."
    }
