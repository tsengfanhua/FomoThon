  "description": {
    "sub_id3": null,
    "sub_name": "線性控制系統(二)",
    "sub_ename": "LINEAR CONTROL SYSTEM(2)",
    "describe_ch": "介紹可應用於各種工程系統的回授控制器的設計。涵蓋根軌跡分析、頻域分析、狀態空間分析與控制器設計。包括 MATLAB 範例，用於練習使用電腦輔助工具解決控制系統問題。",
    "describe_eh": "This course introduces the design of feedback controller as applied to a variety of engineering systems. Topics covers root-locus analysis, frequency-domain analysis, state-space analysis, and controller design. It also includes MATLAB examples to practice the use of computer-aided tools for solving control system problems.",
    "pre_subname": "AUTO3001線性控制系統(一)",
    "pre_sub_id3": "AUTO3001",
    "pre_sub_ename": "AUTO3001 LINEAR CONTROL SYSTEM(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.運用數學基礎以瞭解控制系統基本知識",
      "describe_en": "1.Apply mathematic foundation to understand the basic knowledge about control systems."
    },
    {
      "seq": 2,
      "describe_ch": "2.理解控制系統各項性能的定義與定理 \t2.Comprehension for the definitions or theories of control system performance.\tB2",
      "describe_en": "2.Comprehension for the definitions or theories of control system performance."
    },
    {
      "seq": 3,
      "describe_ch": "3.應用模擬分析工具對控制系統完成分析與設計",
      "describe_en": "3.Application for the simulation tool box to control system analysis and design."
    },
    {
      "seq": 4,
      "describe_ch": "4.對控制系統具備描述問題、訂定規格、建構模型之各項分析能力",
      "describe_en": "4.With analysis capability on describe problems, define specifications and construct model for control systems."
    }
  ],
