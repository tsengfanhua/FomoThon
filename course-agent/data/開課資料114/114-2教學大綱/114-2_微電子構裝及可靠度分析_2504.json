  "description": {
    "sub_id3": null,
    "sub_name": "微電子構裝及可靠度分析",
    "sub_ename": "MICROELECTRONIC PACKAGING AND RELIABILITY",
    "describe_ch": "微電子IC元件、導線、系統構裝及可靠度分析技術是一門藉由構裝設計整合材料電氣、熱導、機械性質等特性，以達到電子產品輕薄短小、高功能及高可靠度等需求之整合性應用學科，適合材料科學相關科系高年級及研究所學生修習。課程目的在於（1）學習目前IC元件、導線、系統構裝材料、製程及可靠度分析技術以及最新發展趨勢；（2）藉由探討上述電子產品測試方法及可靠度需求，進一步建立評估分析構裝設計及材料在IC元件、導線、系統構裝等應用之理論基礎。\r\n",
    "describe_eh": "Microelectronic packaging(PKG) and reliability(RE) assessment is an integrated technology that intends to optimize electronic product's system cost and performance thru integrating materials' electrical, thermal, and mechanical attributes as well as PKG design.  Purposes of this course are, (1)To learn IC components, interconnections, system PKG and RE testing technologies as well as future development trend. (2)To  establish foundations for analyzing/evaluating related material and PKG design.\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解IC元件、導線、系統構裝基本架構及可靠度分析技術的基本原理",
      "describe_en": "To understand overview of IC components, interconnections, system packaging and fundamentals of reliability analyses \t"
    },
    {
      "seq": 2,
      "describe_ch": "認識材料在IC元件、導線、系統構裝上的應用及可靠度之影響與分析技術，同時具備評估材料及構裝設計之能力",
      "describe_en": "To understand materials and applications in IC, components, interconnections and systems packaging, its related reliability effects as well as evaluating related material and packaging design"
    },
    {
      "seq": 3,
      "describe_ch": "知悉IC元件、導線、系統構裝及可靠度分析技術未來發展趨勢，並培養終身學習之習慣與能力\t",
      "describe_en": "To understand the future trend of IC components, interconnections, systems packaging and reliability testing and to be able to establish self-learning capability."
    }
  ],
