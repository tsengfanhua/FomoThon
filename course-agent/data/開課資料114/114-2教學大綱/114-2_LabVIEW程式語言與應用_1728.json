  "description": {
    "sub_id3": null,
    "sub_name": "LabVIEW程式語言與應用",
    "sub_ename": "LabVIEW PROGRAMMING AND APPLICATION",
    "describe_ch": "本課程之主要目標為鼓勵學生使用LabVIEW作為分析解決工程問題的工具。LabVIEW具有簡便的互動式使用者環境，而其所提供之廣泛數值計算和圖形視覺功能，也使其被廣泛使用在諸如信號處理和控制系統等不同的技術領域學門上。在此一課程，學生將學習如何使用LabVIEW 進行虛擬儀控之建立並有效率的解決所遭遇之工程問題。",
    "describe_eh": "The primary objective of this course is to encourage students to use LabVIEW as a tool to analyze and solve the engineering problems. LabVIEW provides an easy-to-use interactive environment which includes extensive numerical computation and visualization capabilities. As a result, now, it has been broadly used in different technical areas, such as signal processing and control system. In this course, students will learn how to use LabVIEW to construct the virtual instrument and to solve the engineering problems efficiently.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具有LabVIEW 程式撰寫開發之技能。",
      "describe_en": "To develop programming skills in the LabVIEW programming language."
    },
    {
      "seq": 2,
      "describe_ch": "針對工程問題建立系統化的概念，進而有效使用電腦與分析方法解決問題。",
      "describe_en": "To develop a systematic method for setting up engineering problems that solved by using the computer and analysis methods."
    },
    {
      "seq": 3,
      "describe_ch": "運用LabVIEW程式於所學專長領域。",
      "describe_en": "To enhance students' professional area by utilizing LabVIEW."
    }
  ],
