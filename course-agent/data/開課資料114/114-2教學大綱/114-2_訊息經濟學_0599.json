  "description": {
    "sub_id3": null,
    "sub_name": "訊息經濟學",
    "sub_ename": "THE ECONOMICS OF INFORMATION",
    "describe_ch": "本課程旨在介紹訊息不對稱的現實與因應方式。授課內容包括：逆選擇、道德危險、信號傳遞、代理理論、契約理論、交易成本、產權......等，使學生能瞭解訊息經濟的基本內涵。",
    "describe_eh": "In this course, students will understand the basic concepts of information economics and learn the models of asymmetric information, such as adverse selection, moral hazard, signaling, principal-agent and contract, transaction cost and property rights.....。 Through the introduction of case study in real world students are expected to realize and be able to apply the logical thinking process during their daily life.\r\n\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能具備訊息經濟學的基本知識",
      "describe_en": "Be able to have the basic knowledge of information economics"
    },
    {
      "seq": 2,
      "describe_ch": "理解經濟行為與訊息之關係",
      "describe_en": "Understand the relationship between (asymmetric) information and economic behavior"
    },
    {
      "seq": 3,
      "describe_ch": "能應用訊息理論分析經濟現象",
      "describe_en": "Apply and analyze the information theory on economic events"
    }
  ],
