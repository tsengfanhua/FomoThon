  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE10310",
    "sub_id": "43038",
    "scr_dup": "001",
    "sub_title": "本課程的前身為都市計畫實務專題，為都資系大學部都市計畫與空間資訊實習課的延伸，之後因應建設學院全系碩士班課程調整，改名為專題實作。課程由專任教師與業師共同指導，讓學生進行專業領域的實作。",
    "sub_title_en": null,
    "sub_describe": "本學期以「翻轉西大墩：大手牽小手之記憶糧倉與通學安全重構計畫」為題，改造臺中市西屯國小與周邊環境，並配合國小教師與學生的跨域學習活動，落實大學社會責任（USR）的實務推展。",
    "sub_describe_en": null
  },
  "description": null,
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能依專題策劃並執行，並展現成果",
      "describe_en": "To be able to plan, carry out, and present one’s final product."
    },
    {
      "seq": 2,
      "describe_ch": "於動手做當中領悟其與社會之聯繫",
      "describe_en": "To realize the connection with the society when carrying out the practice."
    }
  ],
