  "description": {
    "sub_id3": null,
    "sub_name": "德文(一)",
    "sub_ename": "GERMAN(1)",
    "describe_ch": "該科目為一入門課程，以中文及德文教學，以基本之聽說讀寫為教學目標。 內容為導論(字母、發音)、文法(現在式動詞變化、定冠詞、不定冠詞、人稱代名詞、複數)主題(問候、自我介紹、親屬、德國生活)",
    "describe_eh": "German I is an introductory course for the beginners in German. It is taught in German and Mandarin Chinese. The main goal is to equip students with basic reading, writing, speaking , and writing skills. The course objects are: 1.Introduction: alphabet and pronunciation 2. Grammar :present tense, definite and indefinite articles, personal pronouns, plurals 3. Functions: greetings, introducing self: nationalities, languages, addresses, telephone numbers, 3. introducing family members: hobbies, jobs, leisure activities, time of day 4. introducing Germany: city life and country life.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.能用德文介紹自己",
      "describe_en": "1. Able to introduce themselves in German.\t"
    },
    {
      "seq": 2,
      "describe_ch": "2.能聽懂他人所敘述之基本資料",
      "describe_en": "2.able to understand other person's personal information."
    },
    {
      "seq": 3,
      "describe_ch": "3.能讀出並寫出數字",
      "describe_en": "3.able to read and write numbers."
    },
    {
      "seq": 4,
      "describe_ch": "4.能分辨肯、否定、直述、疑問及命令等句型",
      "describe_en": "4.able to tell the differences between different sentence patterns.\t"
    },
    {
      "seq": 5,
      "describe_ch": "5.能正確說出親屬稱謂\n",
      "describe_en": "5.able to use the correct terms of their family members.\t"
    }
  ],
