  "description": {
    "sub_id3": null,
    "sub_name": "工程統計與軟體應用",
    "sub_ename": "ENGINEERING STATISTICS AND SOFTWARE APPLICATION",
    "describe_ch": "本課程包括課程講授及SPSS軟體操作，課程授課內容包含機率概念、不確定現象之解析模式、不確定現象的統計分析法、分布模式適合度檢定以及相關迴歸分析。不確定現象的解析模式包括常態分布、對數常態分布、Bernoulli序列、Poisson過程以及卡方分布、t分布等。不確定現象的統計分析包含母參數的點推定及區間推定。分布模式適合度則利用卡方檢定。\r\n課程描述（英文）\r\n",
    "describe_eh": "This course contains：concept of probability, probability distributions for uncertain phenomenon；statistical analysis；goodness-of-fit test of distributive function and regressive analysis. Probability distributions including normal distribution；log-normal distribution；Bernoulli's sequence；Poisson process；chi-square distribution；t-distribution etc. Statistical analysis involving point and interval estimation. Goodness of fit test adopts chi-square test.And the application of SPSS package.",
    "pre_subname": "MATH1005微積分(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解機率與統計的基本觀念\t",
      "describe_en": "1.Comprehension of basic concepts of probability and statistics"
    },
    {
      "seq": 2,
      "describe_ch": "應用統計方法解決工程問題\t",
      "describe_en": "2.Application of statistical methods to deal with engineering problems"
    },
    {
      "seq": 3,
      "describe_ch": "執行水文頻率分析進行工程設計\t",
      "describe_en": "3.Hydrologic planning and design by using frequency analysis"
    }
  ],
