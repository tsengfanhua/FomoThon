  "description": {
    "sub_id3": null,
    "sub_name": "密碼學",
    "sub_ename": "CRYPTOGRAPHY",
    "describe_ch": "密碼學是在研究秘密通訊的方法。本課程將介紹加解密背後的數學原理。並且討論延伸的議題如 數位簽章, 秘密分享 等等。",
    "describe_eh": "Cryptography is the science of secret communication. This course will introduce the mathematical principles behind encryption and decryption. Extended topics such as digital signatures, secret sharing, etc. will also be discussed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解與密碼學相關的數學符號與原理\r\n",
      "describe_en": "Understand the mathematical symbols and principles related to cryptography."
    },
    {
      "seq": 2,
      "describe_ch": "了解不同密碼系統的特性與功能\r\n",
      "describe_en": "After students have these elementary ideas, we begin to present important cryptosystems and carefully describe how\r\nmathematics can be used in these algorithms."
    }
  ],
