  "description": {
    "sub_id3": null,
    "sub_name": "綠色經濟與永續發展",
    "sub_ename": "GREEN ECONOMY AND SUSTAINABLE DEVELOPMENT",
    "describe_ch": "本課程將帶領學生探究綠色經濟的發展對於企業組織發展朝低碳轉型發展的關係。使學生不僅認識綠色經濟是一種可為環境創造正面影響力的經濟活動類型，其以友善環境為目標的生產、投資與消費，將可促進環境、社會與企業的共生，使經濟發展與環境保護能夠取得平衡，促進總體社會的可持續發展。",
    "describe_eh": "This course will lead students to explore the green economy how to promote the business organizations to reach the goal of low-carbon emission. Let students to learn green economy is not only a system which included sustainable production and consumption, but also will be a model which is creating positive impact on the environment. Finally, to learn green economy is going to promote the collaboration of society, business and environment, and in the end, to form a sustainable development of society.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解綠色經濟如何有助環境與社會的永續。",
      "describe_en": "To learn how green economy can help environment and society get sustainability."
    },
    {
      "seq": 2,
      "describe_ch": "了解如何在經濟發展與環境保護之間取得平衡，以有助社會永續發展的達成。",
      "describe_en": "To get the balance between economic development and environmental protection, in order to achieve a sustainable development of society."
    }
  ],
