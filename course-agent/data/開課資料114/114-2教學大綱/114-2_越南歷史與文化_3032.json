  "description": {
    "sub_id3": null,
    "sub_name": "越南歷史與文化",
    "sub_ename": "HISTORY AND CULTURE OF VIETNAM",
    "describe_ch": "本學期課程，將藉由越南越南歷史文化的各項議題進行介紹與探索，並透過講義、影片、相關資料和議題的研討，引發學生的學習動機，多方面瞭解越南文化與歷史，進而促進台越文化交流與發展。",
    "describe_eh": "This course will stimulate students' interest in learning through the introduction and study of the history and culture of Vietnam, and, through the discussion of films, reference materials and cases, to understand the history and culture of Vietnam in many aspects, and then to promote cultural exchanges and developments between Taiwan and Vietnam.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "協助學生對越南歷史文化議題做出價值判斷與應用。",
      "describe_en": " Assist students in making value judgments and applications on the issues of Vietnamese history and culture."
    },
    {
      "seq": 2,
      "describe_ch": "協助學生了解越南歷史文化議題並運用批判思考。",
      "describe_en": "To help students understand the issues of Vietnamese history and culture and apply critical thinking."
    }
  ],
