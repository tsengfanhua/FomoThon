  "description": {
    "sub_id3": null,
    "sub_name": "室內設計風格",
    "sub_ename": "INTERIOR DESIGN STYLE",
    "describe_ch": "延續上學期設計史的內容，深入介紹影響近現代室內設計風格的思潮，以使學生得以了解室內風格發展的歷史脈絡，有助於同學們在從事建築及室內設計等相關業務時，更能有效掌握各時期的風格與樣式運用。",
    "describe_eh": "A",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "由同學自由選取風格史發展階段依循課程大綱，進行國內外之空間設計重要理論、代表性的空間論述、設計大師及其相關作品舉例分析。",
      "describe_en": "Learn from a student freely according to a development stage of the history of design and the correlative work gives an example with domestic and foreign interior and designers and analyzes it."
    }
  ],
