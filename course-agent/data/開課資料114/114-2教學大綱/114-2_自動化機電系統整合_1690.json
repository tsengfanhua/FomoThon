  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "自動化機電系統整合",
    "sub_ename": "AUTOMATIC AND INTEGRATED ELECTROMECHANICAL SYSTEM",
    "describe_ch": "因應未來科技整合之發展趨勢，結合光電工程、機械、電機、資訊等跨領域學科，重點在訓練具有光電科技與微機電科技等跨領域與跨學科之專業人才。課程強調光機電元件與系統、控制與感測、光電自動化檢測技術、工業機器人、系統整合、加工與製程自動檢測等相關主題。",
    "describe_eh": "In response to the future development trend of technology integration, combining optoelectronic engineering, machinery, electrical, information and other interdisciplinary disciplines, the focus is on training professionals with interdisciplinary and interdisciplinary expertise in optoelectronic technology and micro-electromechanical technology. The course emphasizes related topics such as opto-electromechanical components and systems, control and sensing, photoelectric automatic detection technology, industrial robots, system integration, processing and process automatic detection.",
    "pre_subname": "AUTO6001線性系統理論",
    "pre_sub_id3": "AUTO6001",
    "pre_sub_ename": "AUTO6001 LINEAR SYSTEM THEORY",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解並說明機電元件與系統在精密產業與製程的重要性及影響。",
      "describe_en": "Understand and be able to explain the importance and effects of integrated electromechanical system to precision machining and manufacturing."
    },
    {
      "seq": 2,
      "describe_ch": "能辨識與分析出可應用自動化機電系統整合的場合，並能清楚表達如何訂定規範、建構系統、分析設計以及驗證結果。",
      "describe_en": "Distinguish and make clear statement where automatic and integrated electromechanical system can be applied. Also express clearly how to propose the design requirement, construct system, analyze system, design and validate results."
    },
    {
      "seq": 3,
      "describe_ch": "能熟習自動化機電元件與系統之綜合相關分析、設計、軟體及整合，以解決自動化機電系統問題。",
      "describe_en": "Be able to familiarize with the related analysis, design, software tool and integration and solve the problem of the automatic electromechanical system."
    },
    {
      "seq": 4,
      "describe_ch": "能利用自動化機電系統整合之原理，提出一套評估與驗證系統之可行方法。並能藉由專題發表養成計畫執行之能力。",
      "describe_en": "Use principles of automatic and integrated electromechanical system to propose a feasible method for the evaluation and validation of a system. Also to set up project executing capability by using specific topic presentation."
    }
  ],
