  "description": {
    "sub_id3": null,
    "sub_name": "陶瓷製程技術",
    "sub_ename": "CERAMICS PROCESSING TECHNOLOGY",
    "describe_ch": "介紹各種基本與新進陶瓷製程技術種類、原理、製程參數與製造設備。課程內容將講述陶瓷材料產品類別、原料、粉體工程技術、粉體特性分析、粉體研磨與混合、陶瓷製程添加劑種類與用途、各種陶瓷成形技術、基本薄膜製程、三維列印技術、陶瓷乾燥/脫脂與燒成、陶瓷研磨與後加工技術。工程背景的同學志於將來投入電子陶瓷材料、結構功能陶瓷材料、光電、半導體產業的製造與研發工作，本課程提供你一個全方位的陶瓷製程技術的基礎知識與工程知能。",
    "describe_eh": "The ceramic processing technologies by describing its principles, equipment, and production for both advanced and traditional ceramics are given. The scope covers an introduction on various types of commonly used ceramic products, raw materials, powder manufacturing and characterization, powder milling and mixing, various additives for ceramics processing, forming techniques, film coating process, 3D printing, drying (or debindering) and firing of ceramic bodies, and post-sintering machining. Any engineering student who intends to join a career of manufacturing and R&D work in electrical and structural ceramics industry, photonics industry, and semiconductor industry will find this course interesting and beneficial for his or her training purposes.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解陶瓷製程技術實務與研發管理技巧，並能實際評價陶瓷製程技術之應用向面。\t",
      "describe_en": "To understand the practice and R&D of modern ceramic processing techniques and to evaluate values of their application aspects."
    },
    {
      "seq": 2,
      "describe_ch": "了解陶瓷製程技術基本原理及分析檢量方法，進而養成設計此課題的實驗規畫能力。\t",
      "describe_en": "To understand the basic principles of ceramic processing technology and the related analytic methods to be able to design and plan the experiments in this topical subject."
    },
    {
      "seq": 3,
      "describe_ch": "以書面及口頭報告方式，對於所收集之陶瓷製程技術論文研發結果，在課程中與同學及教師陳述溝通。\t",
      "describe_en": "To acquire the written and verbal skills to communicate with instructor and classmates regarding to literature on ceramic processing technology."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解國際上陶瓷製程技術之發展與影響\t",
      "describe_en": "To grasp the updated knowledge and technical information on ceramic processing technology"
    }
  ],
