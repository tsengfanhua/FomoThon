    "cls_id": "CB04139",
    "sub_id": "18010",
    "scr_dup": "001",
    "sub_title": "年金保險與理財規劃",
    "sub_title_en": null,
    "sub_describe": "*課程設計以理論為基礎，實務作業、實務經驗為課程內容。\n\n*由於劉憲儒老師今年工作安排上較緊, 故今年與洪麗淇老師合開課程\n課程主要仍以劉憲儒老師為主要授課老師。\n\n*課程將以搭配的方式, 由劉憲儒老師以實務經驗引導同學學習「年金保險」的理論與實務, 搭配洪麗淇老師協助同學所建構保險理論的架構，相輔相成領導各位探索本課程之相關主題。\n*考評與上課方式與2025年以前相同。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "年金保險",
    "sub_ename": "ANNUITY INSURANCE",
    "describe_ch": "年金就老年財務規劃已經變成一個很重要的工具，由於以上這點，本課程要討論年金的型態及年金的使用，進而如何將此工具做最好的運用。",
    "describe_eh": "The annuity has become an important instrument in financial planning for old age. Therefore, this course discusses the types and uses of annuities, and how to best use this instrument",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能培養同學具備年金保險知識",
      "describe_en": "To enhance annuity insurance knowledge"
    },
    {
      "seq": 2,
      "describe_ch": "能理解年金保險相關專業，並引導其具有正確觀念與涵養。",
      "describe_en": "Comprehension in annuity insurance profession, and guide it possess right idea and ability to control oneself"
    }
  ],
