  "description": {
    "sub_id3": null,
    "sub_name": "電磁干擾概論",
    "sub_ename": "INTRODUCTION TO ELECTRO MAGNETIC INTERFERENCE",
    "describe_ch": "由於電子與電機技術的迅速發展與廣泛的應用，且在EMI/EMC法規與產品本身EMC品質的要求下，產品與系統的電磁相容越來越受重視。本課程的內容包括 EMI/EMC的基本觀念與理論、法規的要求、量測的技術、設計與對策的技巧，皆為EMC工程師所必備的理論與實務知識。",
    "describe_eh": "Following the rapid development and widespread applications of electrical and electronic technologies, EMI/EMC related regulations and product's compliance requirements are now getting serious attention worldwide. This curriculum covers all EMI principles and practices, including Basic Theory of EMI, Regulation Requirements, EMI Measurement Techniques, EMC Design and Debugging Techniques etc.",
    "pre_subname": "ELEN3013電子電路學",
    "pre_sub_id3": "ELEN3013",
    "pre_sub_ename": "ELEN3013 ELECTRONIC CIRCUITS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 3,
      "describe_ch": "能理解並說明電磁干擾在目前的科技產業、社會生活及經濟層面的重要性及影響。\t",
      "describe_en": " Understand and be able to explain the importance and effects of EMI to industry, society and economy."
    },
    {
      "seq": 4,
      "describe_ch": "能應用電磁干擾的原理，評估一產品或系統之操作特性，並提出可行驗證與改善方法。\t",
      "describe_en": "Use principles of EMI to evaluate the operation characteristics of a product or system and propose a feasible method for validation and improvement."
    }
  ],
