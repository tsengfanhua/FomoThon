  "description": {
    "sub_id3": null,
    "sub_name": "網際網路與電子商務法律",
    "sub_ename": "LAW OF E-COMMERCE AND CYBERSPACE",
    "describe_ch": "網際網路、電信與電子商務相關法律問題討論與分析，課程內容預期將涵蓋資訊法律概論、網路智慧財產權、電子交易契約相關法律問題、電子簽章法之介紹與分析、個人資料與隱私權保障相關法律問題、電子商務與消費者保護法相關法律問題、網路不實廣告與公平法相關法律問題、線上付款相關法律問題與爭議、電信法等內容。",
    "describe_eh": "The course focuses on legal topics regarding Internet, telecommunication, e-commerce and related high-tech issues. The content will cover introduction of information technology, intellectual property, e-transaction, e-banking, personal data protection, privacy, consumer protection, unfair competition, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "本課程希望透過課堂教學，增進同學對資訊應用、網路交易、電子商務發展所牽涉相關法律規範、衍生法律問題有完整及正確之觀念與瞭解",
      "describe_en": "The course focuses on legal topics regarding Internet, telecommunication, e-commerce and related high-tech issues."
    },
    {
      "seq": 2,
      "describe_ch": "透過分組口頭報告方式，吸引同學選定特定資訊與網路運用衍生相關法律問題做更深入之討論與研習，增進同學對相關議題之興趣與教學互動",
      "describe_en": "Communicate results in oral from to classmates."
    }
  ],
