  "description": {
    "sub_id3": null,
    "sub_name": "專案管理",
    "sub_ename": "PROJECT MANAGEMENT",
    "describe_ch": "專案管理為在限定範疇、品質、時間與成本條件下，運用組織與管理資源的專業知識以達成專案的特定目標。本課程提供學生專案管理知識體系及相關應用。",
    "describe_eh": "Project management is the discipline of organizing and managing resources (e.g. people) in such a way that the project is completed within defined scope, quality, time and cost constraints. This course provides students the knowledge of project management and related application.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
