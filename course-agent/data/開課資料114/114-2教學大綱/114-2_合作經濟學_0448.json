  "description": {
    "sub_id3": null,
    "sub_name": "合作經濟學",
    "sub_ename": "COOPERATIVE ECONOMICS",
    "describe_ch": "利用經濟學基礎融入合作原則與制度，首先介紹合作運動源起、發展與演變，再介紹各類合作組織並與本國合作組織相比較。並說明合作社場在經濟制度中所扮演的功能與角色。",
    "describe_eh": "This course provides at both cooperative's theory and institution by using economy fundamental principle. An attempt to make students comprehension and apply to analyze in cooperatives research field.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "合作運動發展及合作思想先驅介紹。",
      "describe_en": "Cooperative movements are developed and the cooperative thought pioneer introduce Cooperative movements are developed and the cooperative thought pioneer introduce."
    },
    {
      "seq": 2,
      "describe_ch": "分析現今社會環境,瞭解消費者及競爭者對合作社場影響。",
      "describe_en": "Analyses the social environment now, understand that the consumer and competitor influence the field of cooperatives."
    },
    {
      "seq": 3,
      "describe_ch": "利用實際案例討論及學生繳交的期末報告，冀使學生具有分析與應用合作社功能。",
      "describe_en": "Utilizes the real case to discuss and final report which makes students analyze and use the function of cooperatives."
    },
    {
      "seq": 4,
      "describe_ch": null,
      "describe_en": null
    }
  ],
