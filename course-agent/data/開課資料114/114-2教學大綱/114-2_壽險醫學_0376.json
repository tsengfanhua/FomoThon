    "sub_name": "壽險醫學",
    "sub_ename": "MEDICAL LIFE INSURANCE",
    "describe_ch": "依壽險之原理、原則結合臨床醫學之應用，探討人身保險（壽險、健康險、傷害險）經營核心－商品設計、核保與理賠之運作，以期能奠定實務作業之基礎。",
    "describe_eh": "It is principle of life insurance, combine principle application of clinical medicine, studies life insurance operation-products design, underwriting and claim, expect to establish the foundation of the practices.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
