  "description": {
    "sub_id3": null,
    "sub_name": "製造技術專題",
    "sub_ename": "SPECIAL TOPICS ON MANUFACTURING TECHNOLOGY",
    "describe_ch": "本課程為必修課程製造程序之延續，課程範圍包含塑性成形製程、表面處理與接合方法等重要製程介紹。並涵蓋電腦數值控制工具機之理論介紹與實作。",
    "describe_eh": "The extension of the requirement, manufacturing process. Topics include metal forming, sheet metalworking, property enhancing and surface processing operations, and joining and assembly processes. Introduction and operations of CNC Machine tools.",
    "pre_subname": "INEN3003製造程序",
    "pre_sub_id3": "INEN3003",
    "pre_sub_ename": "INEN3003 MANUFACTURING PROCESSES",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解塑性成形製程及表面處理程序。",
      "describe_en": "Understand the metal forming and sheet metalworking and the property enhancing and suface processing operatioins."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解各種接合方法。",
      "describe_en": "Understand the joining and assembly processes."
    },
    {
      "seq": 4,
      "describe_ch": "能透團隊合作並瞭解與實務操作電腦數值控制工具機。",
      "describe_en": "Be able to through teamwork and understanding of the practical operation of the CNC machine tools."
    }
  ],
