  "description": {
    "sub_id3": null,
    "sub_name": "行銷意象工程",
    "sub_ename": "MARKETING IMAGERY  ENGINEERING",
    "describe_ch": "本課程為藝術與設計入門概論，內容包括(1)引介當代藝術與設計發展趨勢；(2)基本視覺元素介紹、創作應用與練習；(3)設計準則概述與作品分析；(4)創意發想與完成整合性作品。課程進行方式涵蓋講解與示範、同學課堂報告、課堂練習與製作期末作品。",
    "describe_eh": "This Foundational Art and Design course introduces a wide range of creative practices with various media. In the course students will explore (1) the trend of contemporary art and design work, including classic artwork and commercial graphic design, (2) the visual elements and principles of design in the creation of work of art, (3) various methods of idea generation, (4) the verbal skills for constructive critique participation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
