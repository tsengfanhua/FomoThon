  "description": {
    "sub_id3": null,
    "sub_name": "信號與系統",
    "sub_ename": "SIGNALS AND SYSTEMS",
    "describe_ch": "本課程主要講授連續時間領域的信號與系統之基本理論,以及其應用於通訊、控制和信號處理之分析範例。主要授課內容包括信號的表示、線性非時變系統、傅立葉級數、傅立葉轉換及其應用、及頻域分析等。",
    "describe_eh": "Fundamentals of signals and systems operating in continuous-time domain with applications to control, communications, and signal processing are presented. Primary topics include representation of signals, linear time-invariant systems, the Fourier series, the Fourier transform and its applications, and frequency-domain analysis.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解信號及系統之數學模型表示法及其傅立葉轉換之性質及原理。",
      "describe_en": "Comprehension for the various mathematical representations of signals and systems, as well as Fourier domain theory and properties.　"
    },
    {
      "seq": 2,
      "describe_ch": "應用數學方程式表示信號及系統。",
      "describe_en": "To apply mathematical equations to represent signals and systems."
    },
    {
      "seq": 3,
      "describe_ch": "應用數學模型及傅立葉轉換分析線性系統。",
      "describe_en": "To apply mathematical models and Fourier transform as the basic tools to analyze the linear systems."
    }
  ],
