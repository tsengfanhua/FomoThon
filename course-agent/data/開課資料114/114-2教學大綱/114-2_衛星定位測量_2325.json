  "description": {
    "sub_id3": null,
    "sub_name": "衛星定位測量",
    "sub_ename": "SATELLITE SURVEYING",
    "describe_ch": "藉由本課程的進行，使學生了解衛星定位測量之理論基礎與運作流程，透過作業的練習，可確實掌握衛星定位系統運作的訣竅。",
    "describe_eh": "The course content includes the basic concept and flowchart of satellite positioning survey and lots of practical exercises.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解衛星定位架構概念及基本原理。",
      "describe_en": "To understand the infra-structure of satellite positioning and basic theory"
    },
    {
      "seq": 2,
      "describe_ch": "熟悉儀器操作的能力及資料處理軟體的能力。",
      "describe_en": "To familiar with the operafion of insfrument and data processing software."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉衛星定位資料處理之基礎及分析能力。",
      "describe_en": "To familiar with basic GPS data processing algorithm and data analysis"
    }
  ],
