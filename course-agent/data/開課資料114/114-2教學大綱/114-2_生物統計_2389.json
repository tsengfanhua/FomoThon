  "description": {
    "sub_id3": null,
    "sub_name": "生物統計",
    "sub_ename": "BIOSTATISTICS",
    "describe_ch": "認識統計學原理與統計方法在環境科學與環境保護上的應用。如何蒐集有價值的資料？如何組織、解釋所蒐集的資料？如何分析並給適當的推論？以及推論的可信度有多高？這些便都是統計學研究的主要範疇。主要目標是由已知的樣本資料經由正確有效的分析來推測母體所具有的特性；另外則是適當地設計樣本取得的程序及取樣的範圍，以便使所觀察樣本顯現的特性能真實反映母體的現象，進而能以簡潔的分析，作有效的推論。",
    "describe_eh": "Introduction to the analysis of biomedical data. Descriptive and inferential statistical analysis for discrete, continuous, and random variables. Analytic methods based on elementary parametric and non-parametric models for one sample; two sample (independent and paired), stratified sample, and simple regression problems",
    "pre_subname": "IECS2002電子學、AUTO3072生醫信號處理",
    "pre_sub_id3": "IECS2002",
    "pre_sub_ename": "IECS2002 ELECTRONICS、AUTO3072 BIOMEDICAL SIGNAL PROCESSING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "說明統計學原理與統計方法在環境科學與環境保護上的應用。　",
      "describe_en": "Obtain the knowledge of the analysis of environmental data and its application　"
    },
    {
      "seq": 2,
      "describe_ch": "描述如何蒐集有價值的資料？如何組織、解釋所蒐集的資料？如何分析並給適當的推論？",
      "describe_en": "Describe statistical analysis for discrete, continuous, and random variables　"
    },
    {
      "seq": 3,
      "describe_ch": "分析樣本資料正確有效的推測母體所具有的特性　",
      "describe_en": "Identify the analytic methods based on elementary parametric and non-parametric models for one sample; two sample (independent and paired), stratified sample, and simple regression problems　"
    }
  ],
