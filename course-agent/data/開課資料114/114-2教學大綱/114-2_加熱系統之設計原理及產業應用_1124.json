  "description": {
    "sub_id3": null,
    "sub_name": "加熱系統之設計原理及產業應用",
    "sub_ename": "DESIGN AND ANALYSIS THE HEATING EQUIPMENT FOR INDUSTRIAL APPLICATION",
    "describe_ch": "與業師共同探討加熱設備對於製程之應用。由業師介紹加熱設備對於機械產業的製程、綠色能源之應用，以及系統開發流程。此外，由學校老師介紹加熱設備之內部流場與熱傳現象，以及CAE模擬方法。整合上述，可提供學生對於產業設備與研發模式之基本概念。\r\n",
    "describe_eh": "The aim of this course is discussing the application of heating equipment with industry experts. First, the class would be started by industry experts for introducing the application of heating equipment and the process of opening a research project. Second, the theory of heat transfer and fluid dynamic which could be used to analysis the equipment in CAE method would be introduced by teacher. Based upon to above description, the process of product development and application could be introduced to student completely.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解加熱設備之操作原理",
      "describe_en": "Understand the basic operating function of the heating equipment."
    },
    {
      "seq": 2,
      "describe_ch": "了解加熱設備對於製程之產業應用",
      "describe_en": "Understand the industrial application of the heating equipment."
    },
    {
      "seq": 3,
      "describe_ch": "了解加熱設備於綠能產業的應用趨勢",
      "describe_en": "Understand the industry trends of renewable energy for the heating equipment."
    },
    {
      "seq": 4,
      "describe_ch": "能針對加熱設備進行基礎原理分析",
      "describe_en": "Ability to conduct basic analyses of heating components."
    },
    {
      "seq": 5,
      "describe_ch": "能針對加熱設備進行能耗管理",
      "describe_en": "Ability to calculate the efficiency of heating equipment."
    },
    {
      "seq": 6,
      "describe_ch": "能初步針對加熱設備進行CAE分析",
      "describe_en": "Ability to simulate and analysis a heating equipment with CAE method."
    }
  ],
