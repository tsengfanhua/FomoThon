  "description": {
    "sub_id3": null,
    "sub_name": "中級會計學(二)",
    "sub_ename": "INTERMEDIATE ACCOUNTING(2)",
    "describe_ch": "本課程結合會計理論的發展，學習會計處理和報導過程，主要內容包括：會計觀念及程序、資產評價、負債、業主權益、損益衡量、退休金會計、租賃會計、所得稅會計、現金流量表、每股盈餘、財務報告及分析等。",
    "describe_eh": "This course is a study of the accounting process and the reporting process in conjunction with the development of accounting theory. Topics covered include the review of accounting concepts and procedures, valuation of assets, liabilities, owners' equity, income measurement, accounting for pension, leasing and income tax, statement of cash flow, EPS, financial report and analysis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
