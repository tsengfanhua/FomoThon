  "description": {
    "sub_id3": null,
    "sub_name": "風險評估",
    "sub_ename": "RISK ASSESSMENT",
    "describe_ch": "介紹風險評估之基本理論，與其在健康、環境、及安全危害方面之應用。本課程將針對危害辨識、暴露評估、及風險特性描述做定性及定量上的探討，使學生具備環境健康風險評估的基本認知與理論基礎。",
    "describe_eh": "This is an introductory course designed to acquaint students with the basic concepts of risk assessment as applied to human health, safety, and environment.  The course will explore hazard identification, risk analysis, and risk communication.  Qualitative and quantitative methods for measuring risk will be discussed, including exploration of approaches for dealing with uncertainty.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的辭彙定義何謂「風險」及「風險評估」\t",
      "describe_en": "Define \"risk\" and \"risk assessment\" with their own words"
    },
    {
      "seq": 2,
      "describe_ch": "能理解並解釋環境風險評估在社會及環境層面的重要性及影響　\t　",
      "describe_en": "Understand and be able to explain the importance and effects of environmental risk assessment to society and environment"
    },
    {
      "seq": 3,
      "describe_ch": "能辨識風險評估的相關議題，並能對議題進行評估與表達\t",
      "describe_en": "Distinguish where environmental risk assessment can be applied, and be able to assess and express the related risk issues"
    }
  ],
