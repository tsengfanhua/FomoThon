  "description": {
    "sub_id3": null,
    "sub_name": "網路管理",
    "sub_ename": "NETWORK MANAGEMENT",
    "describe_ch": "本課程講授網路管理之原則，技術，及應用。內容包含Simple Network Management Protocol (SNMP), Remote Monitor (RMON), Telecommunication Management Network (TMN), and Common Management Information Protocol (CMIP). 此外，產業界使用廣泛的寬頻網路及電纜網路之管理亦將包含。學生完成此課程後將有足夠的網管知識加入網路管理的工作市場或者是從事網管方面的研究。",
    "describe_eh": "This course covers management principles, practices, and technologies for applications and services in a network. Specifically, material includes Simple Network Management Protocol (SNMP), Remote Monitor (RMON), Telecommunication Management Network (TMN), and Common Management Information Protocol (CMIP). Also included are real world practices in network management like broadband network management and cable network management. Upon completing this course, a student could either enter industry with adequate network management knowledge or pursue further study and research in this area.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解網路管理之意義及各種標準，並應用 SNMP, RMON, TMN 等網管技術",
      "describe_en": "Understand meanings of network management and various standard and apply SNMP, RMON, TMN"
    },
    {
      "seq": 2,
      "describe_ch": "能研讀網管相關論文並口頭報告",
      "describe_en": "Be able to study network management related papers and present to class"
    },
    {
      "seq": 3,
      "describe_ch": "能以團隊解決指定之網管問題",
      "describe_en": "Be able to solve assigned problems under a team setting"
    },
    {
      "seq": 4,
      "describe_ch": "理解網管科技發展趨勢及其對網路通訊之影響",
      "describe_en": "Understand the trend of network management and its impacts on networking and communication"
    }
  ],
