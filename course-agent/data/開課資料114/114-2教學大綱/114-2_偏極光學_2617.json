  "description": {
    "sub_id3": null,
    "sub_name": "偏極光學",
    "sub_ename": "POLARIZED OPTICS",
    "describe_ch": "介紹偏極光在光學系統應用的原理；說明與分析偏極光的基本原理、基本晶體光學原理。以Stokes向量、Jones向量介紹偏極光。以Mueller矩陣、Jones矩陣介紹偏極元件。內容包含Poincare球、界面的反射與折射、介電質平板的反射與穿透、偏極干涉、單軸晶體與雙軸晶體的折射，折射率橢球分析、橢圓儀原理與偏極光的應用。\r\n",
    "describe_eh": "This course intends to introduce the principles of polarized light and its application in the optical system. The contents include (1) Introduction, (2) Stokes Vector and Mueller Matrix, (3) Jones Vector and Matrix, (4) An-isotropic Medium Propagation, (5)Dielectric Tensor, (6)Normal surface,(6)Index Ellipsiod, (7)Interference, (8) Ellipsometry, and (8)Applications.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠描述及推演偏極光學的基本原理",
      "describe_en": "Describe and derive the basic theory of Polarized Light."
    },
    {
      "seq": 2,
      "describe_ch": "理解晶體中光傳遞的原理，並解析應用於實際光學系統",
      "describe_en": "Apply principle of propagated light in crystal to real optical systems and can understand them."
    },
    {
      "seq": 3,
      "describe_ch": "能閱讀相關進階書籍及論文",
      "describe_en": "Be able to read and study the related advanced books and papers."
    }
  ],
