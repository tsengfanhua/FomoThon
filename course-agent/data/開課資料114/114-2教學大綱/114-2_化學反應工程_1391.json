  "description": {
    "sub_id3": null,
    "sub_name": "化學反應工程",
    "sub_ename": "CHEMICAL REACTION ENGINEERING",
    "describe_ch": "這課程著重於化學反應及反應器設計，在學期前段，我們將從理想、穩態及恆溫的系統拓展到非穩態及非恆溫系統， 同學不但要了解基本原理與推演之外，更要結合電腦技巧，解決工程設計上的相關問題。",
    "describe_eh": "This class will be focused on the chemical reaction kinetics and the principal of chemical reactor design from the ideal, steady state, and isothermal conditions to the real, un-steady state, and non-isothermal one.  The students will be equiped with basic knowledges of the usage of computer skill to solve the engineering design problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用自己的詞彙定義並描述何謂反應現象：使能夠了解、敘述系統中關鍵的現象",
      "describe_en": "Define the chemical reaction and describe them under students' words. Be able to understand and describe the key phenomena in the system.　"
    },
    {
      "seq": 2,
      "describe_ch": "使能瞭解並說明化學反應在不同模型下所代表的重點與意義　",
      "describe_en": "Understand and elucidate the importance of the chemical reaction under different reaction model process.　"
    },
    {
      "seq": 3,
      "describe_ch": "使能辨識並清楚的陳述反應並應運不同反應槽來表達　",
      "describe_en": "Distinguish and make clear statement on the chemical reaction of different design of the reactors can be applied　"
    },
    {
      "seq": 4,
      "describe_ch": "使能夠呈現研究結果並清楚地說明專業的解釋",
      "describe_en": "Be able to present the study results and elucidate the professional solution clearly."
    }
  ],
