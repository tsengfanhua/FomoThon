  "description": {
    "sub_id3": null,
    "sub_name": "高等數理統計學(二)",
    "sub_ename": "ADVANCED MATHEMATICAL STATISTICS(2)",
    "describe_ch": "提供機率與數理統計之相關理論, 其涵概統計推論之基礎理論: 點估計, 區間估計及假設檢定，本課程以統計推論為主，另含介紹其他應用的主題。",
    "describe_eh": "To provide a solid and well-balanced probability theory and mathematical statistics.  This class covers the foundations of statistical inference: parametric point estimate, confidence estimation and hypotheses testing. This course also introduces some application topics.",
    "pre_subname": "STAT6031高等數理統計(一)",
    "pre_sub_id3": "STAT6031",
    "pre_sub_ename": "STAT6031 ADVANCED MATHEMATICAL STATISTICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解統計估計、信賴區間之基本觀念及分辨理論所需假設下導出相關估計方法",
      "describe_en": "Comprehension  the fundamental concept of point estimation, confidence interval."
    },
    {
      "seq": 2,
      "describe_ch": "解釋假設檢定基本觀念及綜合理論所需假設下導出相關之假設檢定方法",
      "describe_en": "Synthesis for the assumptions to derive the related hypotheses testing method."
    },
    {
      "seq": 3,
      "describe_ch": "應用統計推論之方法在其他專業領域",
      "describe_en": "To apply the statistical inference methods in various fields."
    },
    {
      "seq": 4,
      "describe_ch": "綜合特定之統計推論主題，明確詳述其理論架構與方法。",
      "describe_en": "Synthesis for a specific topic about the statistical inference, and specify its  theoretical structure and method."
    }
  ],
