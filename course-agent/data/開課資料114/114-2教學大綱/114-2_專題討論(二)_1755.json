  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(二)",
    "sub_ename": "SEMINAR(2)",
    "describe_ch": "藉由文獻專題討論講授研究方法，培養學生發掘問題及蒐集資料之能力，進而熟悉各領域所探討的訴求及重點，以加強對IE的應用能力。",
    "describe_eh": "This course is designed to study and discuss concept and applications of IE by literature review.  Students then should know how to collect and analyze information and how to apply IE theory and skills solve problems.",
    "pre_subname": "ENGS6931專題討論(一)",
    "pre_sub_id3": "ENGS6931",
    "pre_sub_ename": "ENGS6931 SEMINAR(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "藉由與學界或業界知名人士分享專家研究經驗與成果得知當代議題與未來趨勢。",
      "describe_en": "To know the contemporary issue and future trends by learning the experiences and achievements of invited speakers."
    },
    {
      "seq": 2,
      "describe_ch": "藉由與學界或業界人士討論了解未來自身對工作及社會須具使命感。",
      "describe_en": "To realize the responsibility to career and society in discussion with the invited speakers\r\n\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "具口頭報告其研究工作之能力\r\n\r\n\r\n",
      "describe_en": "To be capable of making a fine presentation of research works\r\n"
    },
    {
      "seq": 4,
      "describe_ch": "培養團隊合作",
      "describe_en": "Team work"
    }
