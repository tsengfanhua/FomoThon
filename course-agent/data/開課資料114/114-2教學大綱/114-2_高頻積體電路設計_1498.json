  "description": {
    "sub_id3": null,
    "sub_name": "高頻積體電路設計",
    "sub_ename": "HIGH FREQUENCY INTEGRATED CIRCUITS DESIGN",
    "describe_ch": "本課程目標在於針對特殊應用之高頻積體電路設計，並熟練積體電路設計與量測技能，課程將讓學生了解，設計高頻積體電路應該具備的知識，及有哪一些電路屬於高頻電路，需要特別的設計。",
    "describe_eh": "The aim of this course is to conduct the High frequency integrated circuit (IC) design research for the specific applications and practice the IC design and measurement skills. The course will introduce the knowledge of design high frequency integrated circuit and what kind of circuit will belong to high frequency circuit field, needing to critical design methodology.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解高頻混和訊號電路設計",
      "describe_en": "To understand high frequency mixed signal circuit design"
    },
    {
      "seq": 2,
      "describe_ch": "能分析高頻混合訊號電路設計及佈局",
      "describe_en": "Analysis of high frequency mixed signal circuit design and layout"
    }
