  "description": {
    "sub_id3": null,
    "sub_name": "文學與生活",
    "sub_ename": "LITERATURE  AND LIFE",
    "describe_ch": "概述中國文學的範疇、特色、類別、趣味、鑑賞及其演變。將詩歌、散文、楚辭、賦與駢文、小說、詞、散曲及戲劇，併為詩賦、詞曲、小說、散文四類，論析其源流演變及體制風格，評介其代表作家與作品。",
    "describe_eh": "The aim of this course is to give students a general introduction to Chinese literature and the changes that took place in Chinese poetry, prose, verse, novels and drama. During the course there will be discussion upon the evolution of Chinese literature and an examination of representative authors and their masterpieces.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解授課內容、欣賞各類文體、具備人文素養",
      "describe_en": "To be able to understand learning materials, appreciate various types of literary works so as to cultivate humanistic qualities."
    },
    {
      "seq": 2,
      "describe_ch": "具備協同合作，蒐集資料、閱讀、思辨、討論、口語表達暨書寫各項能力",
      "describe_en": "To develop abilities to collaborate, to collect research data, to interpretively speculate the readings, to interpersonally discuss ideas, and to express."
    }
  ],
