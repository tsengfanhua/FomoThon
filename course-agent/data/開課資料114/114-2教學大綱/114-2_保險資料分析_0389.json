  "description": {
    "sub_id3": null,
    "sub_name": "保險資料分析",
    "sub_ename": "INSURANCE DATA ANALYSIS",
    "describe_ch": "教導學生熟悉各種保險資訊的數據處理、分析、解讀、與說明。\r\n讓學生學習如何利用統計軟體進行保險數據計分析、並撰寫碩士論文。\r\n",
    "describe_eh": "Teach students to be familiar with data processing, analysis, interpretation, and explanation of various insurance information. Let students learn to use statistical software to analyze insurance data and write a master's thesis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "從事商業研究的架構，包括：界定問題、研究計劃、研究設計、數據收集與準備、統計分析和研究報告撰寫。",
      "describe_en": "The structure of business research, including: problem definition, research plan, research design, data collection and preparation, statistical analysis and research report writing."
    },
    {
      "seq": 2,
      "describe_ch": "商業研究使用的研究工具：統計軟體SPSS、 R語言。\r\n",
      "describe_en": "Research tools used in business research, such as: statistical software SPSS, R Language."
    },
    {
      "seq": 3,
      "describe_ch": "相關的研究方法：數據探索與檢查、假設檢定、多變量分析。",
      "describe_en": "Related research methods: data exploration and inspection, hypothesis testing, multivariate analysis."
    }
  ],
