  "description": {
    "sub_id3": null,
    "sub_name": "整合學習",
    "sub_ename": "ENSEMBLE LEARNING",
    "describe_ch": "本課程將介紹整合學習(或集成學習)的基礎理論與實務。本課程將介紹整合學習的三種主要方法，即自助集成 (bagging)、推升 (boosting) 及堆? (stacking)。教學目標為建立學生在整合學習必要的根基，以便將所學之技術應用在他/她們自己的問題上。",
    "describe_eh": "In this course, the fundamental principles and applications of the ensemble learning are introduced. Course topics include three main techniques of ensemble learning, namely bagging, boosting, and stacking. The goal is to build the necessary background of the ensemble learning for the students in order to apply these techniques in their own problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解整合學習之基本概念。",
      "describe_en": "Understanding the fundamental concepts of the ensemble learning."
    },
    {
      "seq": 2,
      "describe_ch": "具備應用整合學習之技術於實務問題上。",
      "describe_en": "Having the ability to apply the techniques of the ensemble learning in practical problems."
    }
  ],
