  "description": {
    "sub_id3": null,
    "sub_name": "生態學",
    "sub_ename": "ECOLOGY",
    "describe_ch": "本課程提供學生對生態系統架構及功能之基本認識與了解，並藉由生物組成與環境條件之互動關係，探討物質與能量之循環與生態系統之平衡。",
    "describe_eh": "This course provides students with a basic understanding of the structure and function of the ecosystem. Through the interaction among biotic and abiotic parts of the system, explore the cycle of matter and energy and the balance of the ecosystem.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "辨識生態系統之組成結構與其功能。　",
      "describe_en": "To distinguish the fundamental structure and functions of the ecosystem.　"
    },
    {
      "seq": 2,
      "describe_ch": "理解食物鏈中能量傳遞之結果及對營養層級形成之影響。　\t",
      "describe_en": "To comprehension the results of energy transfer between food chains and the effect on the formation of trophic levels.　"
    },
    {
      "seq": 3,
      "describe_ch": "說明不同物質循環方式之不同及影響物質循環之環境因子。　\t",
      "describe_en": "To state the differences between circulation route in different materials and the state factors that control of nutrient cycle.　"
    },
    {
      "seq": 4,
      "describe_ch": "說明族群成長模式與環境涵容能力之意義。　\t",
      "describe_en": "To state the concept of carrying capacity in an ecosystem using sigmoid growth model.　"
    }
  ],
