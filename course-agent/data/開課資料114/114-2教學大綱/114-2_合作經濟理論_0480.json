  "description": {
    "sub_id3": null,
    "sub_name": "合作經濟理論",
    "sub_ename": "THE THEORY OF COOPERATIVES ECONOMIC",
    "describe_ch": "本課程在探討合作事業之產生、行為與影響的相關經濟理論，並結合個體經濟、公共經濟學、福利經濟學、管理經濟學與產業經濟學之相關議題作為合作事業之經濟理論基礎。",
    "describe_eh": "This course is proposed to introduce the fundamental issues of economic theories addressing the origins, behavior, and impact of cooperative business. The relevant topics include microeconomics, public economics, welfare economics, and economics of industrial and organizations management.",
    "pre_subname": "COOP1001合作經濟學",
    "pre_sub_id3": "COOP1001",
    "pre_sub_ename": "COOP1001 COOPERATIVE ECONOMICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解世界變遷下合作社存在的本質、價值與原則。",
      "describe_en": "To understand the Statement on the Co-operative Identity."
    },
    {
      "seq": 2,
      "describe_ch": "理解與應用合作的相關經濟理論。",
      "describe_en": "To understand and apply relevant economic theories of the cooperative business."
    },
    {
      "seq": 3,
      "describe_ch": "具有跨領域之知識研究整合能力。",
      "describe_en": "To integrate the multidiscipline knowledge of economic and social enterprises."
    },
    {
      "seq": 4,
      "describe_ch": "具有團隊合作學習與溝通能力。",
      "describe_en": "To have cooperative learning and communication ability."
    }
  ],
