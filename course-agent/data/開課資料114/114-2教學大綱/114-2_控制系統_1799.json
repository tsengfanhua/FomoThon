  "description": {
    "sub_id3": null,
    "sub_name": "控制系統",
    "sub_ename": "CONTROL SYSTEM",
    "describe_ch": "教導學生關於動態系統模型之建立,系統性能之分析,與控制法則介紹。這些包括：控制系統簡介，拉普拉氏轉換，狀態空間轉換，控制器之介紹，動態系統模型之建立，系統動態性能之分析，系統穩態性能之分析，穩定系統之判斷，根軌跡圖之繪製與應用，柏德圖之繪製與應用。",
    "describe_eh": "To teach about modeling the dynamic systems, the analysis of the system performance, and the introduction of the control laws. Those include: Introduction to control systems, Laplace transformation, state space transformation, controllers, dynamic system modeling, dynamic response analysis, steady state analysis, judgment of stability, root locus plotting and applications, and Bode diagram drawing and applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 4.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建立學生對控制理論之基礎及對控制性能評估之能力。",
      "describe_en": "Building the foundation in control theory, and have the capability of performance evaluation."
    },
    {
      "seq": 2,
      "describe_ch": "累積系統數學模型之能力。",
      "describe_en": "Accumulate the capability in building the mathematic models of the controlled systems."
    },
    {
      "seq": 3,
      "describe_ch": "具有動態分析之基本認識與能力，及使用Matlab 之能力。",
      "describe_en": "Get the capability in dynamic analysis. Be able to do dynamic analysis by Matlab."
    },
    {
      "seq": 4,
      "describe_ch": "對控制系統之瞭解。具有穩態分析及動態分析之基本能力。具有控制法則設計之基礎。",
      "describe_en": "Understand the means of control systems. Own the capability of steady state analysis, dynamic analysis, and control law design."
    }
  ],
