  "description": {
    "sub_id3": null,
    "sub_name": "保險法",
    "sub_ename": "INSURANCE LAW",
    "describe_ch": "為滿足學生廣泛性需要，本課程將彈性的達成下列目標：\r\n1.\t闡述保險契約原理，說明保險法的強制規定，連同保險企業之監管，將在前十週與予介紹。\r\n2.\t後八週，將討論有關保險法判決例的一些專題研究。\r\n",
    "describe_eh": "To satisfy the diverse needs of students, the course achieves flexibility as follows:\r\n1.\tInterpreting theory of Insurance contract and enforces Rules of the Insurance law, Governing the Administration of Insurance Enterprises are also introduced at the first 10 weeks.\r\nSpecial Topics of insurance Case Study will be discussed for the following 8 weeks.\r\n",
    "pre_subname": "INSU1001保險學",
    "pre_sub_id3": "INSU1001",
    "pre_sub_ename": "INSU1001 INSURANCE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解保險契約、保險監理法規的專業知識",
      "describe_en": "Enable to interpret insurance contract and regulations and law."
    },
    {
      "seq": 2,
      "describe_ch": "能理解溝通能力與團隊合作的重要",
      "describe_en": "Comprehension for the importance of communication and team work."
    },
    {
      "seq": 3,
      "describe_ch": "能理解職業倫理道德",
      "describe_en": "Understanding the business ethics"
    }
  ],
