  "description": {
    "sub_id3": null,
    "sub_name": "資料處理與大數據分析",
    "sub_ename": "DATA PROCESSING AND BIG DATA ANALYSIS",
    "describe_ch": "本課程將教授處理巨量數據的基礎觀念，透過目前主流大數據處理分析工具及程式語言培養學生運用機器學習、資料探勘以及統計等觀念，設計不同大數據分析模型的能力，並且介紹與了解分散式架構的主流框架，讓本課程學生能夠有擁有處理大數據最重要兩個面向之基本能力。",
    "describe_eh": "This course will teach the basic concepts of processing huge amounts of data, and train students to use concepts such as machine learning, data exploration, and statistics to design different big data analysis models through current mainstream big data processing and analysis tools and programming languages. Ability, and introduction and understanding of mainstream frameworks of distributed architectures, so that students in this course can have the basic ability to process the two most important aspects of big data.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生能靈活運用大數據分析相關軟體。",
      "describe_en": "Enable students to flexibly use big data analysis related software."
    },
    {
      "seq": 2,
      "describe_ch": "使學生更瞭解大數據分析與應用之相關知識，以培養學生之專業能力，使其滿足學界與業界對於大數據人才的需求。",
      "describe_en": "To enable students to better understand the relevant knowledge of big data analysis and application, so as to cultivate students' professional abilities and enable them to meet the needs of big data talents in academia and industry."
    },
    {
      "seq": 3,
      "describe_ch": "透過邀請企業家及專家學者來進行專題講座，透過專題講座可使學生更直接了解產業需求及大數據在學界及產業之應用，能提早為未來進入產業界做準備。",
      "describe_en": "By inviting entrepreneurs, experts and scholars to give special lectures, students can have a more direct understanding of industrial needs and the application of big data in academia and industry, and can prepare for entering the industry in the future."
    },
    {
      "seq": 4,
      "describe_ch": "強化學生建置系統以及實作之專業能力。",
      "describe_en": "Strengthen students' professional abilities in system construction and implementation."
    }
  ],
