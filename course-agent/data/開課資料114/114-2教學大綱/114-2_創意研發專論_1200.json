  "description": {
    "sub_id3": null,
    "sub_name": "創意研發專論",
    "sub_ename": "SPECIAL TOPICS ON INNOVATION AND CREATIVE RESEARCH",
    "describe_ch": "培養學生解決問題能力，引發創意思考，強化溝通、協調及簡報能力，俾助提升將來升學及就業競爭力。課程採主題式研討，強調跨領域整合方式，強化學生創意研發能力，增進團隊合作及溝通協調能力。從工廠的產品開發流程案例，以分組的方式，討論並研究如何設計研發符合消費者需求又兼顧環境保護的創意產品。",
    "describe_eh": "This course places emphases on developing students' ability of problem solving and creative\r\nthinking. Besides, the emphases also include effective communication, efficient coordination, and skillful presentation. To substantially enhance the competitive edge in their future professional careers, this course is arranged to have open discussions for thrashing out problems on various subject matters by integrating all related fields. The principal goals are to strengthen students' capability of creative research, group work, and communication. From the factory's product development process case, to discuss and study how to design and develop creative products due to consumer needs and environmental protection.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠運用課堂所學理論於實務及具有國際觀。",
      "describe_en": "Able to apply classroom theory in practice and an international view."
    },
    {
      "seq": 2,
      "describe_ch": "強化溝通、協調及提升將來升學或就業競爭力。",
      "describe_en": "To Strengthen communication, coordinate and enhance the competitiveness of future studies or employment."
    },
    {
      "seq": 3,
      "describe_ch": "強調跨領域整合方式，增進團隊合作能力。",
      "describe_en": "To emphasis on the integration of\r\ninterdisciplines and to strengthen students'\r\ncapability of creative research and team work\r\n"
    },
    {
      "seq": 4,
      "describe_ch": "具有應用研究成果之整合能力並理解專業倫理與國際觀",
      "describe_en": "Have the ability to integrate applied research results and understand professional ethics and international outlook"
    }
  ],
