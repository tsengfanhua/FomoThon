  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE10310",
    "sub_id": "73492",
    "scr_dup": "001",
    "sub_title": "環境規劃、都市設計、地方特色行銷與創生",
    "sub_title_en": null,
    "sub_describe": "環境規劃與設計關係到人類活動、自然環境、社會環境、與生活空間環境，其內涵包括城鄉規劃、都市設計、景觀規劃、社區營造、地方創生、生態規劃、自然保育、永續發展等面向。伴隨著快速的社會變遷，在過去幾十年經濟掛帥政策主導下，臺灣的都市生活環境品質始終令人詬病，如何從改善人的空間環境質量，順應生態保育與永續發展的時代潮流，進而改善人的生活質量，成為今日臺灣環境規劃與設計的主要目標。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "環境規劃與設計專論",
    "sub_ename": "ENVIRONMENTAL PLANNING AND DESIGN SEMINAR",
    "describe_ch": "環境規劃與設計目的建構良好的都市實質環境並提升環境品質。事實上，環境規劃與設計探討人的空間意義與活動經驗議題，強調整體「城鎮的生成」。本課程介紹環境規劃與設計的內涵、理論、案例與實務應用。",
    "describe_eh": "The purpose of this course is to construct excellent urban physical environment and improve environmental quality. In fact, environmental planning and design deals with the human experience that built environment evokes across private properties or in the public realm. In other words, environmental planning and design is integrative “town-making.” This course introduces the essential, theory, case study, and professional working process of environmental planning and design.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能獲得環境規劃與設計的理論與分析技術",
      "describe_en": "Synthesis of theories and analytical techniques of environmental planning and design."
    },
    {
      "seq": 2,
      "describe_ch": "能導出永續規劃於環境規劃與設計的創新實踐",
      "describe_en": "Synthesis of sustainable planning to innovative practice on environmental planning and design."
    }
  ],
