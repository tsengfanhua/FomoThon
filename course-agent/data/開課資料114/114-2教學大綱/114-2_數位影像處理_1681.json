  "description": {
    "sub_id3": null,
    "sub_name": "數位影像處理",
    "sub_ename": "DIGITAL IMAGE PROCESSING",
    "describe_ch": "介紹數位影像處理原理與應用，數位影像處理乃數位信號處理的延伸課程。課程除了簡介醫學影像外，主要著重數位影像處理，課程包含二維空間域和頻率域理論，以及影像對比強化、影像復原、影像切割和影像型態的原理。本課程著重理論介紹和實際電腦程式執行。",
    "describe_eh": "The course will focus on the introduction of image processing and application. Image understanding requires an extension from the concept of one dimensional signal processing. We will introduce the knowledge of 2D spatial domain and 2D frequency domain. Some important methods of image processing will be learned and practiced in this course, including image enhancement, restoration, segmentation and morphological image processing.",
    "pre_subname": "AUTO3037數位信號處理",
    "pre_sub_id3": "AUTO3037",
    "pre_sub_ename": "AUTO3037 DIGITAL SIGNAL PROCESSING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解數位影像處理的基本知識。",
      "describe_en": "To understand the basic knowledge about digital image processing."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解數位影像處理的演算法。",
      "describe_en": "To understand the algorithm about digital image processing."
    },
    {
      "seq": 3,
      "describe_ch": "利用上機實習執行數位影像處理演算，藉以瞭解其原理。",
      "describe_en": "To perform digital image processing principle by computer program"
    }
  ],
