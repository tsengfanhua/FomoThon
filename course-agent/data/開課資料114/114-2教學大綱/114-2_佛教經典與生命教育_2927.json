  "description": {
    "sub_id3": null,
    "sub_name": "佛教經典與生命教育",
    "sub_ename": "BUDDHISTIC CLASSICS AND LIFE EDUCATION",
    "describe_ch": "本課程之教學目標，除了向同學有系統地介紹與闡釋所選取的佛教經論，以期能令同學掌握其中所蘊含的佛教思想與特殊義涵；同時亦期能訓練參與本課程的同學，對於相關經論中的重要議題與生命教育所可能的關涉有所認識與體會。",
    "describe_eh": "The teaching objectives of this course, in addition to systematically introducing and explaining the selected Buddhist Cannons to the students, in order to let students catch the Buddhist ways of thinking and special meanings in Cannons , as well as to comprehend the important issues in Cannons and the significances related to life education.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "對於所選取的佛教經典有所了解。",
      "describe_en": "To understand & catch the Buddhist ways of thinking and special meanings in Cannons"
    },
    {
      "seq": 2,
      "describe_ch": "體會佛教經典的生命教育義涵，並在生活中善加應用。",
      "describe_en": "To comprehend the important issues in Cannons and the significances related to life education."
    }
  ],
