  "description": {
    "sub_id3": null,
    "sub_name": "統計套裝軟體(一)",
    "sub_ename": "STATISTICAL PACKAGE (1)",
    "describe_ch": "本課程主要在介紹統計套裝軟體SPSS及 SAS 的操作，期望學生能具有使用統計套裝軟體得到統計圖表及敘述統計量的能力，也能解讀軟體輸出的結果。大部分時間在電腦機房上課。",
    "describe_eh": "This course aims to provide the students with the capacity to perform elementary data analysis by using statistical packages such as SPSS and SAS. After taking this course, students are expected to examine data and be able to construct some descriptive graphs and measures.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用統計套裝軟體建立資料檔",
      "describe_en": "Create  the data file using statistical packages."
    },
    {
      "seq": 2,
      "describe_ch": "應用統計套裝軟體處理資料",
      "describe_en": "Perform basic data management using statistical packages."
    },
    {
      "seq": 3,
      "describe_ch": "應用用統計套裝軟體做適當的統計圖表",
      "describe_en": "Use statistical software package to make proper tables and graphs"
    },
    {
      "seq": 4,
      "describe_ch": "應用統計套裝軟體求基本統計量數",
      "describe_en": "Use statistical software package to obtain basic descriptive statistics."
    }
  ],
