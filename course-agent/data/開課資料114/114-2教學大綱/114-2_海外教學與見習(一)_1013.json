  "description": {
    "sub_id3": null,
    "sub_name": "海外教學與見習(一)",
    "sub_ename": "OVERSEAS LEARNING AND EXPLORATION (1)",
    "describe_ch": "為促進研究生的國際化視野與整體性思維，本課程帶領同學赴國外教學研究單位，以英語為溝通媒介，透過與外國專家的討論與實地踏勘，能夠跨領域地思維流域整體的保育、防災，以及水資源開發。",
    "describe_eh": "For enhancing graduate students’ capacity on the international perspective and holistic thinking, this course bring the whole class to other country’s research/teaching units. Using English as the communication media, discussing current issues with foreign experts, and on-site field trip, students can catch interdisciplinary learning on the conservation, disaster prevention, and water-resources development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
