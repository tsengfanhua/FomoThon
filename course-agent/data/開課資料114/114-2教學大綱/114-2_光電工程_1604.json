  "description": {
    "sub_id3": null,
    "sub_name": "光電工程",
    "sub_ename": "OPTO-ELECTRIC ENGINEERING",
    "describe_ch": "除一般基礎課程外，另依不同的發展方向，訂有基礎與進階的專業課程。其中包括雷射基本原理與雷射特性、光調制、光纖基本原理及特性、光偵測器等。目的在使同學熟悉光電工程的相關理論與應用技術，培養獨立解決問題的能力。",
    "describe_eh": "According to different optical fields except the general fundamental courses, the advanced specialized optical courses are arranged one by one in this course. It includes the principle and properties of lasers, modulation of light, fiber optical waveguides, and photodetectors. The destination is to let students to understand the related priciple and applications of optoelectronic engineerings and further to train students with the ability of solving problems by themselves.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 3,
      "describe_ch": "能用自己的專業詞彙定義光電工程中許多專有名詞。\t",
      "describe_en": "Describe and derive the basic related theories of opto-electric engineering."
    },
    {
      "seq": 4,
      "describe_ch": "能藉由習題的實作，了解原理及分析光學現象。",
      "describe_en": "Can understand optical principles and analyze elementary optical phenomena by solving exercises or doing homework."
    }
  ],
