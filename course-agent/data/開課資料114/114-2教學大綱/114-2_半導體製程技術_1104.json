  "description": {
    "sub_id3": null,
    "sub_name": "半導體製程技術",
    "sub_ename": "SEMICONDUCTOR MANUFACTURING TECHNOLOGY",
    "describe_ch": "本課程介紹半導體製程的各項製造技術，包括微影、蝕刻、薄膜沉積、氧化、摻雜、平坦化等，學生可以從本課程獲得半導體製造技術的基本觀念。",
    "describe_eh": "This course introduces the techniques of semiconductor fabrication processes. The photolithography, etching, deposition, oxidation, doping, and flatness techniques are included in this course. Students can learn the basic principle of semiconductor fabrication processes from this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠了解半導體製程",
      "describe_en": "Be able to understand semiconductor fabrication processes."
    },
    {
      "seq": 2,
      "describe_ch": "能夠理解半導體各單一製程的製造技術",
      "describe_en": "Be able to comprehend fabricating techniques of each semiconductor process."
    },
    {
      "seq": 3,
      "describe_ch": "能夠知道製程技術在相關行業的應用",
      "describe_en": "Be able to know the applications of the techniques in the related industry."
    },
    {
      "seq": 4,
      "describe_ch": "能夠知道製程技術的發展",
      "describe_en": "Be able to know the development of fabricating techniques.."
    }
  ],
