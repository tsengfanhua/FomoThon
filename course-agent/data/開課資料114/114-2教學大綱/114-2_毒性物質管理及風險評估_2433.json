  "description": {
    "sub_id3": null,
    "sub_name": "毒性物質管理及風險評估",
    "sub_ename": "MANAGEMENT OF TOXIC SUBSTANCES AND RISK ASSESSMENT",
    "describe_ch": "隨著都市發展及土地開發利用，有害事業廢棄物或工業廢料污染土壤、地面水、地下水、空氣而造成二次公害，因此毒性物質管理不但要強調來源管制及製程逸散的預防，更應重視廢棄物之可能危害。本課程介紹闡明毒性物質對人體危害、風險評估、風險管理，並討論毒性物質的管理系統與控制策略。",
    "describe_eh": "This class covers the fundamentals of solid and hazardous waste management.  Topics covered included the definition of solid and hazardous waste; the regulations governing the management of these wastes; the characterization, collection, transport, treatment, storage, and disposal of solid and hazardous wastes.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能說明並表達與毒性物質相關的環保法規。",
      "describe_en": "Describe and explain the legislation pertinent to hazardous waste management."
    },
    {
      "seq": 2,
      "describe_ch": "描述會影響環境毒性物質管理的重要因素。",
      "describe_en": "Describe factors which will affect the management of hazardous waste in the environment."
    },
    {
      "seq": 3,
      "describe_ch": "了解定量風險評估如何執行，及其結果分析的意義與限制。",
      "describe_en": "Comprehend how quantitative risk assessments are conducted, and the limitations of the results of these analyses"
    }
  ],
