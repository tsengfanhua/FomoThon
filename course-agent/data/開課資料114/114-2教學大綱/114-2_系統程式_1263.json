  "description": {
    "sub_id3": null,
    "sub_name": "系統程式",
    "sub_ename": "SYSTEM PROGRAMMING",
    "describe_ch": "本課程旨在介紹電腦系統內常見之系統軟體，諸如組譯程式，載入程式，連結程式，巨集處理器，編譯器，作業系統，資料庫管理系統，文件編輯器與除錯器等之運作原理與設計理念。並配合實作若干系統軟體來強化學生對電腦系統軟體運作流程的了解。",
    "describe_eh": "This course is mainly aimed to introduce the basic operation principles and design notions for some computer system softwares, such as Assemblers, Loaders, Linkers, Macro-Processors, Compilers, Operating Systems, Database Management Systems, Text Editors, and Debuggers. In addition, for thoroughly realizing the system software operation flow, some practical system software implementations will be conducted by students.",
    "pre_subname": "IECS2001資料結構",
    "pre_sub_id3": "IECS2001",
    "pre_sub_ename": "IECS2001 DATA STRUCTURE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解計算機結構與系統軟體的關係。",
      "describe_en": "Understand the relationships between computer architectures and system softwares."
    },
    {
      "seq": 2,
      "describe_ch": "理解各種系統軟體的運作原理。",
      "describe_en": "Understand the operation principles associated with various kinds of system softwares."
    },
    {
      "seq": 3,
      "describe_ch": "應用各種系統軟體設計和實作技巧。",
      "describe_en": "Apply the design and implementation techniques concering with various system softwares."
    }
  ],
