  "description": {
    "sub_id3": null,
    "sub_name": "電聲數位訊號處理",
    "sub_ename": "DIGITAL AUDIO SIGNAL PROCESSING OF ELECTRICAL ACOUSTICS",
    "describe_ch": "數位信號處理的技術日新月異，且已被大量的應用在日常生活之中。本課程的目的在於學習數位信號處理的基本概念及技術，其中包含有數位信號與系統的介紹、離散傅立葉轉換、取樣、z 轉換、數位濾波器、快速傅立葉轉換等。除了理論部分，教導學生如何寫程式應用在音訊處理工具軟體。",
    "describe_eh": "Techniques of Digital Signal Processing (DSP) have been boomingly developed in last decades, and have been widely applied in our daily life. The course intends to introduce fundamental concepts and techniques of DSP, which include discrete-time signals and systems, discrete-time Fourier Transform, sampling, z-transform, digital filters, Fast Fourier Transform, and so on. In addition, students will learn how to write programs used in audio processing software tools.",
    "pre_subname": "STAT4001機率論、COME2004信號與系統",
    "pre_sub_id3": "STAT4001",
    "pre_sub_ename": "STAT4001 PROBABILITY、COME2004 SIGNALS AND SYSTEMS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解數位訊號處理於聲音上的處理應用。",
      "describe_en": "Be able to understand the application of digital signal processing to Audio and Acoustics."
    },
    {
      "seq": 3,
      "describe_ch": "能應用離散傅立業轉換做時域與頻域間的轉換。",
      "describe_en": "To apply discrete Fourier transform between time and frequency domains."
    },
    {
      "seq": 4,
      "describe_ch": "能應用z轉換做離散系統的分析與數位濾波器的設計。",
      "describe_en": "To apply z-transform to proceed analysis of discrete-time systems and design of digital filters."
    }
  ],
