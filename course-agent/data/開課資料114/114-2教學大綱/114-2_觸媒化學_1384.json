  "description": {
    "sub_id3": null,
    "sub_name": "觸媒化學",
    "sub_ename": "CATALYTIC CHEMISTRY",
    "describe_ch": "本課程是對觸媒的種類，製備，反應性和檢測的概論和介紹。課程主要著重在非均相觸媒。有關觸媒的物理化學現象，諸如固體表面吸附和脫附，表面反應的動力學和化學平衡都涵蓋其中。重要的工業觸媒反應程序，像是利用天然氣為反應物的化工製程也是課程範例之一。此課程內容非常適合對觸媒有興趣及將來在化學工業工作的學生。",
    "describe_eh": "This course is an introduction to the type, preparation, reactivity, and characterization of catalyst. The course deals mainly with heterogeneous catalysis. The chemical and physical phenomena that are important within catalysis are covered, such as adsorption on and desorption from solids, the chemical kinetics of surface reactions, and chemical equilibrium. Important industrial processes for the exploitation of natural gas will be described and used as examples. The course is well suited for students with interests directly related to catalysis and those working in chemical industry.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備探討非均相催化反應的基礎知識，概念和實驗方法",
      "describe_en": "Have knowledge, fundamental concept and experimental techniques used to study heterogeneous catalysis"
    },
    {
      "seq": 2,
      "describe_ch": "解釋催化劑表面物理化學性質如何影響反應的活性和選擇性",
      "describe_en": "Account for how the catalytic activity and selectivity is influenced by the surface properties of the catalyst"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解表徵催化劑的分析方法所隱含的物理和化學現象及解讀其分析資訊",
      "describe_en": "Account for the physical and/or chemical phenomena behind techniques for catalyst characterization and the information offered by these techniques"
    }
  ],
