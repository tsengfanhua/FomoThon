  "description": {
    "sub_id3": null,
    "sub_name": "精密系統設計",
    "sub_ename": "PRECISION SYSTEM DESIGN",
    "describe_ch": "為激發本系大學部學生之創意思考及實作,動手動腦能力之發揮,鼓勵學生組合團隊以系統化思維,發揮創造力,完成富有精緻創意與高實用性之創意作品,同時訓練專題完成時文獻整理展示的能力",
    "describe_eh": "Stimulate students creative thinking and ability of practice, encourage students to team up with systematic thinking and creativity, complete works of exquisite creativity and practicality, and training literature collation, explain the ability.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解精密系統之發展沿革及最新動態，並能實際體驗實務之應用面向，並結合現代生活與工業活動。",
      "describe_en": "Understand the evolution and the latest developments of the precision system, and can actually experience the practical application, and combination of modern life and industrial activities."
    },
    {
      "seq": 2,
      "describe_ch": "讓學生以實作、組織、推廣、彙整報告方式，對於所獲之技術論文及研發結果與同學、教師及媒合廠商陳述溝通，培養設計基礎與解決複雜工程問題之能力。",
      "describe_en": "Enable students to implement, organize, promote, aggregate reporting, describe the completed essay and research results to students, teachers and manufacturers, develop design basis and solve complex engineering problems."
    },
    {
      "seq": 3,
      "describe_ch": "綜合工程之間的相關性或功能性，以整理勾勒出個人生涯之學習成長地圖佈局。",
      "describe_en": "The relevance or functionality of integrated engineering, and list systematically the personal Learning Portfolio."
    },
    {
      "seq": 4,
      "describe_ch": "培育開發之專案知識及興趣。",
      "describe_en": "Develop project knowledge and interests developed."
    }
  ],
