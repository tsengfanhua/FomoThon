  "description": {
    "sub_id3": null,
    "sub_name": "微積分(二)實習",
    "sub_ename": "RECITATION OF CALCULUS (2)",
    "describe_ch": "演練內容包含 L'Hospital's Rule，積分技巧，多變元函數的偏導數、雙變數函數的極大、極小，二重積分，疊積分，極座標的二重積分，多重積分的變數變換，無窮數列與級數，冪級數，泰勒級數，馬克勞林級數。",
    "describe_eh": "Study the exercises of L'Hospital's Rule, the Techniques of Integration, Partial Derivatives, Maximum and Minimum, Double Integrals, Iterated Integrals, Double Integral in Polar Coordinate, Change of Variables in Multiple Integrals, Infinite Sequences and Series, Power Series, Taylor's and Maclaurin Series",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 71,
      "describe_ch": "理解基本函數極限、連續、導數與積分之運算規則、進階積分技巧、多變數實數值函數之極限、連續、偏導數及重積分等定義，建立相關定理與運算規則，並使學生了解其意義及熟練運算技巧與數列與級數收斂發散的理論及函數的級數表示方式，並使學生能處理相關問題。",
      "describe_en": "To comprehend the laws of limit, continuity and derivatives, techniques of integrations, and the limit of multivariable functions. Meanwhile, being able to define continuity and establish relative laws and theorems. Students are expected to elevate and familiarize with relative calculative skills, and evaluate the theorems of convergence and divergence of sequences and series."
    },
    {
      "seq": 72,
      "describe_ch": "應用微積分理論及運算技巧處理相關幾何問題及極大極小值問題等，並為經濟學與物理學等跨領域學習作準備。",
      "describe_en": "Apply calculus to deal with the geometric problems and extreme value problems. It is helpful to study economics and physics."
    }
  ],
