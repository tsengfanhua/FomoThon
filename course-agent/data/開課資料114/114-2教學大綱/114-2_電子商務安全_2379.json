  "description": {
    "sub_id3": null,
    "sub_name": "電子商務安全",
    "sub_ename": "E-COMMERCE SECURITY",
    "describe_ch": "本課程將為學生介紹電子商務的發展與應用，包括傳統商務、資訊化商務、智慧型商務，並從中介紹資訊安全相關議題，包含架構安全、密碼安全、交易安全及法規命令等。同時藉由議題討論與分享讓學生更了解電子商務的發展議題。",
    "describe_eh": "This course will introduce the development and application of e-commerce, including traditional commerce, information-based commerce, and smart commerce. Through topic discussion to introduce the information security issues, including architecture security, cryptography security, transaction security, regulatory and orders. At the same time, students can well-know the development of e-commerce through topic discussion and sharing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解電子商務安全基本知識",
      "describe_en": "Basic knowledge of e-commerce security"
    },
    {
      "seq": 2,
      "describe_ch": "了解電子商務環境的安全管理措施",
      "describe_en": "Security management measures in e-commerce"
    },
    {
      "seq": 3,
      "describe_ch": "電子商務安全的趨勢",
      "describe_en": "The trend of Electronic Commerce Security"
    }
  ],
