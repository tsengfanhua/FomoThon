  "description": {
    "sub_id3": null,
    "sub_name": "心智模式與行銷策略",
    "sub_ename": "MENTAL MODELS AND MARKETING STRATEGY",
    "describe_ch": "本課程透過人類學、心理學、社會學、及行為經濟學等思維，進行深度的顧客洞察發掘與探索及心智模式的建構，並將此洞察與模式運用於數位時代的行銷策略。課程以授課、個案討論、及參訪的模式進行。\r\n",
    "describe_eh": "This course adopts the concepts from anthropology, psychology, sociology, and behavioral economics to discover and explore customer insights and herein construct mental models. This course also discusses how to apply the customer insights and mental models to marketing strategy in the digital age. This course is taught through lecturing, case discussion, and field trip. \r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能深度理解顧客洞察與心智模式",
      "describe_en": "Fully understanding the essence of customer insights and mental models"
    },
    {
      "seq": 2,
      "describe_ch": "能在實務上發展及運用行銷策略",
      "describe_en": "The ability to develop and apply marketing strategy"
    }
