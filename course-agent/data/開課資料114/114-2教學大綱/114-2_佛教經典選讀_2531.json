  "description": {
    "sub_id3": null,
    "sub_name": "佛教經典選讀",
    "sub_ename": "SELECTED READINGS IN BUDDHIST SCRIPTURES",
    "describe_ch": "\"本課程以「普世性」、「當代性」的角度切入佛教經典，選擇在歷史上及現代頗具影響力或知名度的經典段落，實際教授與討論其文獻。透過觀念的辨析與釐清，掘發經典內涵的「普世性」、「當代性」之思想。其次則設計相關的實作作業，讓學生能夠對於該思想有較為切身的理解，進一步有所運用。\n而在經典與實作的結合上，以於當代心理治療、各種教育訓練中極為盛行的「正念療法」（Mindfulness）為主要綰結點，該「正念療法」源於佛教，其指的是一種不帶批判而自然升起的深度覺知。此種覺知方式已被推廣至社會各領域，亦確實能運用於日常生活中。是以頗能夠將古典與現代、經典和生活等多面向相互整合。\"\r\n",
    "describe_eh": "This course explores Buddhist classics through the perspectives of universality and contemporaneity. It selects influential passages for reading and discussion, clarifying concepts and uncovering their enduring significance. Practical assignments help students internalize and apply these ideas. A key focus is mindfulness—originating in Buddhism and now central in therapy, education, and daily life—defined as a non-judgmental, natural awareness. As both practice and concept, mindfulness serves as the bridge between classics and modern life, integrating ancient wisdom with contemporary experience.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "讓學生瞭解佛學基本概念。",
      "describe_en": "To acquaint students with the fundamental concepts of Buddhist philosophy."
    },
    {
      "seq": 2,
      "describe_ch": "讓學生能夠閱讀、理解及分析部分通行佛經。",
      "describe_en": "To develop students’ ability to read, comprehend, and analyze widely influential Buddhist scriptures."
    },
    {
      "seq": 3,
      "describe_ch": "讓學生能夠活用部分佛學觀念，及其與當代生活的連結。",
      "describe_en": "To equip students with the ability to apply Buddhist concepts and relate them meaningfully to modern life."
    }
  ],
