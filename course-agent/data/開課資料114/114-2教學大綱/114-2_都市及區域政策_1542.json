  "description": {
    "sub_id3": null,
    "sub_name": "都市及區域政策",
    "sub_ename": "URBAN AND REGIONAL PLANNING POLICIES",
    "describe_ch": "都市及區域計畫長期有形無形的影響著人們的居住環境品質、交通便捷性、老舊市區街道狹窄、公共設施不足造成舊市區再發展的瓶頸?甚至於一個地區的產業經濟活力?產業區位選擇的差異性!?氣候變遷對於自然與人居環境的衝擊?又何謂都市（或區域）發展願景（visions）?因此都市及區域政策應如何制訂相關對策，為本課程探討之重點。",
    "describe_eh": "The class focuses on the issues of urban and regional planning development. Readings will be assigned and be prepared for class discussion during the seminar. Topics include urban spatial structure, national and resgional planning, environmental planning, land use issues, citizen participation, urban renewal, and GIS, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得及加強計畫研究之能力。",
      "describe_en": "Increase knowledge and ability of doing research in related planning research topics."
    },
    {
      "seq": 2,
      "describe_ch": "理解都市計畫時勢及趨勢及對國土及區域發展專題之了解及興趣。",
      "describe_en": "Increase ability and comprehension in understanding the trend and knowledge in planning research topics."
    }
  ],
