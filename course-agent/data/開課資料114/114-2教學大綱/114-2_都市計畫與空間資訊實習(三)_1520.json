  "description": {
    "sub_id3": null,
    "sub_name": "都市計畫與空間資訊實習(三)",
    "sub_ename": "PRACTICE OF URBAN PLANNING AND SPATIAL INFORMATION(3)",
    "describe_ch": "本課程旨在訓練學生進行都市等較大尺度的新訂都市計畫或都市計畫通盤檢討。學生分組團隊合作，內容包括工作計畫之擬定、資料的收集、整理與分析、未來發展之預測、替選方案之研擬與評估、報告之撰寫。課程訓練並強調生態永續、氣候變遷與都市防災的需求。",
    "describe_eh": "This course trains students to establish a new urban plan or review existing urban plan in a larger size of urban settlements. Students work together and finish a project.  The major topics include the work plan formulation, data collection, field survey, future development forecast, alternative solution submitting and evaluation, and report writing.  The course places great emphasis on ecological sustainability, climate changing, and urban disaster prevention.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 4,
      "describe_ch": "能應用都市計畫制訂的邏輯與都市計畫法令規章於規劃實務",
      "describe_en": "Application of urban plan logic and urban planning laws/regulations to planning practice.\r\n"
    },
    {
      "seq": 5,
      "describe_ch": "能應用生態永續、氣候變遷與都市防災的新技術",
      "describe_en": "Application of new techiques in ecological sustainability, climate changing, and urban disaster prevention."
    },
    {
      "seq": 6,
      "describe_ch": "能應用溝通協調與團隊合作的成效解決問題",
      "describe_en": "Application of effects in communication, negotiation and team working to problem-solving."
    }
  ],
