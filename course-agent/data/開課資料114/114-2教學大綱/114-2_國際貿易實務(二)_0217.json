  "description": {
    "sub_id3": null,
    "sub_name": "國際貿易實務(二)",
    "sub_ename": "PRACTICES OF INTERNATIONAL TRADE(2)",
    "describe_ch": "國際貿易實務（二）具備有關國際貿易相關的知識，包括代理經銷契約、信用狀基本概念、ISP98、UCP600、國際貿易匯票，各種單據、進出口貿易流程、進出口託收業務、國際應收帳款業務、貿易糾紛之處理、三角貿易操作，跨國企業運籌管理及全球營運體系。",
    "describe_eh": " Possess an advanced knowledge of a Sale Agent Agreement, Letter of Credit, Bill of exchange, Documentations, importing/exporting procedures, payment Terms, factoring and forfeiting, trade disputes, Documents processing, global logistics management and global operating system. Students will find it a valuable and instructional tool for the practice business of exporting and importing. Also, it complements the operation of the leading enterprise in the international business and trading company.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
