  "description": {
    "sub_id3": null,
    "sub_name": "電動車技術導論",
    "sub_ename": "THE INTRODUCTION OF ELECTRIC VEHICLES TECHNOLOGY",
    "describe_ch": "本課程的目的主要在介紹電動汽車的技術，範圍將包括電池、電機、轉換器、電機驅動器和脈衝寬度調變。經由對電動車基礎知識的認識和理解，學生可以獲得電動汽車技術體系的應用和系統集成能力。此外，他們還可以進一步將該技術應用於電動機驅動領域。\r\n",
    "describe_eh": "The aim of this course is to introduce the technology of electric vehicles. The scope will cover the batteries, motors, converters, motor drives and pwm. Through the acknowledgment and comprehension for the fundamentals of electric vehicle, students can obtain the ability of the applications and system integration for an electric vehicles technological system. Furthermore, they can employ the technology to the electric motor driving fields.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的專業詞彙定義何謂電動車科技系統，並描述其特性。",
      "describe_en": " Define and describe the characteristics of an electric vehicles technology system."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明電動車科技在電機領域的應用。",
      "describe_en": "Understand and be able to explain the applications of electric vehicles system in the field of electrical engineering."
    }
  ],
