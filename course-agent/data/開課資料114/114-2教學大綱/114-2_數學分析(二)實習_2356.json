  "description": {
    "sub_id3": null,
    "sub_name": "數學分析(二)實習",
    "sub_ename": "MATHEMATICAL ANALYSIS (2) PRACTICE  62174",
    "describe_ch": "引導學生計算習題,內容包含固定迭代法及牛頓求根法、Lagrange與Hermit內插多項式、數值微分法、數值積分、高斯求積法、初值問題、尤拉法、高階泰勒法、二階Runge-Kutta法。",
    "describe_eh": "Guide students to pratice excercises. Content include fixed-point iteration and Newton-Raphson method, Lagrange and Hermit interpolation polynomial, numerical derivatives, numerical integration, Gaussian quadrature, initial value problem, Euler’s method, Higher-order Taylor methods, Runge-Kutta methods.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解迭代問題的收斂性。",
      "describe_en": "Comprehension for the convergence of iterated method."
