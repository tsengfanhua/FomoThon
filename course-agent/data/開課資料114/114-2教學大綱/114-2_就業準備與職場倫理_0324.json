  "description": {
    "sub_id3": null,
    "sub_name": "就業準備與職場倫理",
    "sub_ename": "EMPLOYMENT READINESS AND WORK ETHIC",
    "describe_ch": "本課程解說職場倫理的內涵與重要性，以培養學生進入職場的核心就業力，做好就業準備。課程將以實案解析及小組研討的方式來呈現專業技能之外的職場核心技能，包含：工作態度、團隊合作、溝通表達、抗壓穩定、知識運用、發掘與解決問題，以及自我管理的能力",
    "describe_eh": "The course introduces work ethic to help students developing the core employability in workplace after graduation, and join with case study, and class presentation to deliver the concept of  the abilities of working attitude、teamwork、communication and expression、knowledge application、problem discovering and solving, and self-management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解何謂職場倫理及其重要性",
      "describe_en": "Comprehension for the concept and importance of work ethic"
    },
    {
      "seq": 2,
      "describe_ch": "能應用核心就業力於工作場域之中",
      "describe_en": "Application for core employability in workplace"
    },
    {
      "seq": 3,
      "describe_ch": "能應用溝通表達技巧於職場之中",
      "describe_en": "Application for the ability of communication and expression in workplace"
    }
  ],
