  "description": {
    "sub_id3": null,
    "sub_name": "離散數學",
    "sub_ename": "DISCRETE MATHEMATICS",
    "describe_ch": "介紹具有實際應用價值之離散型數學知識，包含：集合論、邏輯與布林代數、函數與關係、遞迴關係、計數原理與圖論。重點在透過例子來實際應用這些數學觀念於電腦演算法的設計與分析上。",
    "describe_eh": "Introduction to the practically useful discrete mathematics. Topics include the set theory,  relations and functions,  the principle of inclusion and exclusion, recurrence relations, the principle of counting, and  graph theory.  Real-life examples are used to show how these mathematics ideas can be applied to the design and analysis of computer algorithms to have efficient computer programs.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解排列、組合與生成函數。",
      "describe_en": "Comprehension of combination, permutation and generating functions."
    },
    {
      "seq": 2,
      "describe_ch": "理解遞迴關係與包含排除原理",
      "describe_en": "Comprehension of recurrence relation and the principle of inclusion and exclusion."
    },
    {
      "seq": 3,
      "describe_ch": "理解並應用計數原理與Polya定理",
      "describe_en": "Comprehension and application of the principle of counting and the Polya Theorem."
    }
  ],
