  "description": {
    "sub_id3": null,
    "sub_name": "校外實習導論",
    "sub_ename": "INTRODUCTION TO OFF-CAMPUS INTERNSHIP",
    "describe_ch": "拓展學生在校外實習場域之職場基本知識，引導學生提早認識職場環境、職場倫理、安全措施等，讓學生在投入職場之初步階段，可以順利融入工作環境，做好實習前的準備。",
    "describe_eh": "To enhance the students' knowledge regarding internship program outside campus, and in response to the objectives of the internship program practiced in this University, the course would give students some guide to the intended workplace, its environment, safe measures, work ethics, etc. The goal of this course is to help students engage with the intended work environment successfully and ready them for job markets in the early stage of their career.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識校外實習目的及修課規範。",
      "describe_en": "Students know the purpose of internship program and its course content."
    },
    {
      "seq": 2,
      "describe_ch": "認知企業之文化、職安衛法規、工作倫理及職場態度等。 \r\n",
      "describe_en": "Students learn the organizational culture,  occupational safety regulations, work ethics, workplace attitude, etc. on the practicing site."
    },
    {
      "seq": 3,
      "describe_ch": "具有自我終身學習的實踐能力。",
      "describe_en": "Students will have the ability to embrace and enjoy life-long learning."
    }
  ],
