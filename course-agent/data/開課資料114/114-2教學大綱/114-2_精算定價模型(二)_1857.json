  "description": {
    "sub_id3": null,
    "sub_name": "精算定價模型(二)",
    "sub_ename": "THE ACTUARIAL PRICING MODELS (Ⅱ)",
    "describe_ch": "介紹財務數學基本理論，為上下兩學期課程。課程內容含括: 債券相關理論與評價、附買回債券、現金流量與投資組合、利率期限結構、存續期間與凸性、免疫策略、利率決定、利率交換契約等。理論搭配教材範例練習，以加深對理論與相關議題的瞭解。",
    "describe_eh": "This course provides an introduction of financial mathematics. The topics include bond pricing theory, callable bonds, general cash flows and portfolios, term structure of interest rates, duration and convexity, immunization, determinants of interest rates, and interest rate swaps. More examples will be illustrated to help students understand the theories and issues of financial mathematics.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
