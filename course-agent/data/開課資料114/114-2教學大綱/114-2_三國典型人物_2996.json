  "description": {
    "sub_id3": null,
    "sub_name": "三國典型人物",
    "sub_ename": "FOUR TYPES OF FIGURES IN THE THREE KINGDOMS ERA",
    "describe_ch": "本課程將聚焦於「三國時代」中的典型人物，包括君主、統帥、謀士與文臣，深入剖析他們的性格特質、歷史背景與決策智慧。透過對這些關鍵人物的討論，學生將學習如何在各種角色中發揮領導力、運籌帷幄，並反思現代社會中的個人責任與合作策略。課程結合歷史、文學與人性分析，幫助學生從這些經典人物的成功與失敗中汲取經驗與教訓。",
    "describe_eh": "This course focus on typical figures such as monarchs, commanders, counselors, and civil servants from the Three Kingdoms Era and provides an in-depth analysis of their character traits, historical background, and decision-making wisdom. Through discussions of these key figures, students will learn how to lead and strategize in a variety of roles and reflect on personal responsibility and collaborative strategies in modern society. This course combines historical, literary, and humanistic analysis to help students learn from the successes and failures of these classic figures.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識「三國時代」中的典型人物及其角色特質與領導風格。",
      "describe_en": "To understand the typical figures of the Three Kingdoms Era and their personality traits and leadership styles."
    },
    {
      "seq": 2,
      "describe_ch": "了解歷史背景下人物的決策與行為，並反思其對現代領導力與合作的啟示。",
      "describe_en": " To understand the decisions and actions of figures in the historical context and reflect on their impact on modern leadership and collaboration."
    }
  ],
