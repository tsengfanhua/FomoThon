  "description": {
    "sub_id3": null,
    "sub_name": "全球運籌管理",
    "sub_ename": "GLOBA L  LOGISTICS MANAGEMENT",
    "describe_ch": "本課程旨在講授企業全球營運與物流運輸相關之議題與知識，提供學生學習有關全球運籌之策略、行銷、供應商管理、運輸配送、風險管理、資訊系統、績效衡量與組織。學生修習本課程可以瞭解企業在全球化之趨勢中應該採取之運籌策略與經營方針，特別是國內廠商面對國際化之衝擊應該採取之經營方向。",
    "describe_eh": "The aim of this course is to provide students topics of global strategy, marketing, supplier management, distribution, risk management. Information technology, performance measure, and organization for enterprises. Students can obtain and understand the knowledge regarding the global operations and logistics when they finish this coursework.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠描述及定義全球運籌管理的演進和概念。",
      "describe_en": "Be able to describe and define the evolution and design of global logistics management."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明全球運籌管理在企業流程及策略面的重要性及影響。",
      "describe_en": "Understand and be able to explain the importance and effects of global logistics management to business process and strategies."
    },
    {
      "seq": 6,
      "describe_ch": "知道於何處可以找到全球運籌管理的相關資訊和研究結果，並能夠運用相關的原理。",
      "describe_en": "Know where to locate and access related global logistics management information and research, and be able to make use of principles that can be applied."
    },
    {
      "seq": 7,
      "describe_ch": "能以書面或口頭方式將想法與同儕、助教及教師溝通。",
      "describe_en": "Communicate ideas in written or oral form to classmates, teaching assistants, and the instructor."
    }
  ],
