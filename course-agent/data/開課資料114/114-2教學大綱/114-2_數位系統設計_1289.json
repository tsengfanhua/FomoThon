  "description": {
    "sub_id3": null,
    "sub_name": "數位系統設計",
    "sub_ename": "DIGITAL SYSTEM DESIGN",
    "describe_ch": "本課程介紹了基本的數位系統設計概念, 包含邏輯閘最佳化、組合電路設計、同步和非同步設計序向電路、狀態圖、Mealy和Moore Machine, 基礎計算機架構。課程也同時介紹如何使用軟體工具設計、模擬, 和最佳化數位電路。",
    "describe_eh": "This course teaches the fundamental theory and design methods for digital systems. Topics include: logic functions minimization, combinational circuit design, synchronous and asynchronous sequential circuit design, state diagrams, Mealy and Moore circuits, state minimization and assignment, and basic computer organization. This course also teaches the use of software tools for design, simulation, and optimization of digital systems.",
    "pre_subname": "IEE1006邏輯設計",
    "pre_sub_id3": "IEE1006",
    "pre_sub_ename": "IEE1006 LOGIC DESIGN",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
