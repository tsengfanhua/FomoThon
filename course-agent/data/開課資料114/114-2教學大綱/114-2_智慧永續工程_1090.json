  "description": {
    "sub_id3": null,
    "sub_name": "智慧永續工程",
    "sub_ename": "SMART AND SUSTAINABLE ENGINEERING",
    "describe_ch": "本課程內容涵蓋機械工程專業領域在智慧及環境永續的關聯議題，並透過教室授課、產業觀摩與專家演講的方式，介紹淨零排碳在機械工業及其他產業之應用，提供學生(1)具備掌握國際機械發展趨勢及對於環境永續、社會共好與全球發展的影響，培養技術接軌之能力。(2)具備評估智慧製造、綠色產品、永續發展及研究成果，以解決複雜且整合性工程問題之能力。",
    "describe_eh": "This course covers topics related to smart and environmental sustainability in the field of mechanical engineering, and introduces the application of net-zero carbon emission in the mechanical industry and other industries through classroom lectures, industry visits and lectures by experts to provide students with (1) the ability to understand international mechanical development trends and their impact on environmental sustainability, social cohesion and global development, and to cultivate technological convergence; (2) the ability to evaluate smart manufacturing, green products, sustainable development and research results to solve complex and integrated engineering problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "掌握國際機械發展趨勢及技術接軌",
      "describe_en": "Grasping international mechanical development trends and cultivating technological convergence"
    },
    {
      "seq": 2,
      "describe_ch": "掌握淨零碳排、環境永續、社會共好與全球發展應用導入",
      "describe_en": "Grasping the application of imported practices for environmental sustainability, social cohesion and global development"
    },
    {
      "seq": 3,
      "describe_ch": "具備評估智慧製造、綠色產品、永續發展及研究成果之能力",
      "describe_en": "Ability to evaluate smart manufacturing, green products, sustainable development"
    },
    {
      "seq": 4,
      "describe_ch": "具備解決複雜且整合性工程問題之能力",
      "describe_en": "Ability to solve complex and integrated engineering problems"
    }
