  "description": {
    "sub_id3": null,
    "sub_name": "策略管理",
    "sub_ename": "STRATEGY MANAGEMENT",
    "describe_ch": "本課程目的在協助學生培養對於企業進行策略分析、規劃、執行與控管的基本認知。以幫助學生瞭解下列的主題：策略管理的基本概念、策略分析的模式與工具、策略執行與控制的模式與工具與企業策略規劃的制度與流程。\r\n",
    "describe_eh": "The purpose of this course is to help students develop a basic understanding of the strategic analysis, planning, execution and control of enterprises. To help students understand the following topics: the basic concepts of strategic management, the modes and tools of strategic analysis, the modes and tools of policy implementation and control, and the systems and processes of corporate strategic planning.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解策略之基本定義與內涵。\r\n瞭解發展策略規劃之步驟與程序。",
      "describe_en": "Understand the basic definition and connotation of strategy.\r\nUnderstand the steps and procedures of developing strategic planning."
    }
