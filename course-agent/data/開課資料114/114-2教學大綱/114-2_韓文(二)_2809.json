  "description": {
    "sub_id3": null,
    "sub_name": "韓文(二)",
    "sub_ename": "KOREAN(2)",
    "describe_ch": "本課程希望透過韓文，增進同學對韓國的社會變遷與生活環境有深刻的瞭解，拓寬身為知識份子的宏觀視野，掌握韓國與台灣的互動關係。",
    "describe_eh": "Through this course, students will understand more about the living environment and changing society in Korea. Also, students will broaden their views and know the interactions between Taiwan and Korea.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "本課程的教學目的，將著重於培養同學學習韓文的興趣，並提高同學對於語言的應變能力。",
      "describe_en": "The aim of the course is to increase students' interests in learning Korean and their response to this target language."
    }
