  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB06120",
    "sub_id": "13923",
    "scr_dup": "001",
    "sub_title": "如何以合作達成幸福的目標--合作社七大原則的落實",
    "sub_title_en": null,
    "sub_describe": "引導同學從真實世界認識合作，而非只停留在概念理解。觀察合作如何在現實中運作、思考人們為何選擇以合作社的方式行動。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "合作幸福學",
    "sub_ename": "HAPPINESS IN COOPERATIVES",
    "describe_ch": "透過授課及生活實例之討論，培養學生對合作思維的瞭解，增進同學對合作社理念及幸福感的認知，讓學生對過去與未來合作社發展趨勢有所理解。\r\n",
    "describe_eh": "Through lectures and real-life discussions, the program aims to cultivate students' understanding of cooperative thinking, enhance their knowledge of the cooperative philosophy and sense of well-being, and provide them with a better understanding of the past and future development trends of cooperatives.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養學生對合作社思維的認知。培養學生對合作社所產生的幸福感之理解能力。",
      "describe_en": "To promote students’ cognition in cooperatives.To foster students’ ability in understanding the theory of cooperatives happiness."
    }
  ],
