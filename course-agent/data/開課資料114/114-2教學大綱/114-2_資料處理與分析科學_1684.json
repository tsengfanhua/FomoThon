  "description": {
    "sub_id3": null,
    "sub_name": "資料處理與分析科學",
    "sub_ename": "THE SCIENCE OF DATA PROCESSING AND ANALYSIS",
    "describe_ch": "如何利用統計分析之方法以從事基本之資料處理與研究。其主要內容包括:各種感測數據資料之性質與前整理、資料群分佈趨勢、假設檢定、變異度分析與其他相關分析方法。本課程亦會教導使用相關之資料分析軟體(Matlab或R語言)來使學生有實戰的資料處理與分析能力。",
    "describe_eh": "This course is to train students how to use statistical analysis methods for basic data processing and research. The subjects include characteristics of sensing data and preprocessing method, the trend of data distribution, hypothesis testing, analysis of variance and other analysis methods. This course is also teach students how to use the related software (Matlab or R language) for data processing. Let students have actual data processing and analysis capabilities.",
    "pre_subname": "IEE1005線性代數、AUTO5002數位信號處理應用",
    "pre_sub_id3": "IEE1005",
    "pre_sub_ename": "IEE1005 LINEAR ALGEBRA、AUTO5002 APPLICATIONS OF DIGITAL SIGNAL PROCESSING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用數學基礎以瞭解資料科學基本知識",
      "describe_en": "Apply mathematic foundation to understand the basic knowledge about data science."
    },
    {
      "seq": 2,
      "describe_ch": "理解資料分析各項指標的定義與定理",
      "describe_en": "Comprehend for the definitions or theories of data analysis."
    },
    {
      "seq": 3,
      "describe_ch": "應用相關分析軟體對感測資料完成處理與分析",
      "describe_en": "Application for the related software (Matlab or R language) to sensing data processing and analysis."
    },
    {
      "seq": 4,
      "describe_ch": "對資料科學具備描述問題、訂定規格、建構模型之各項分析能力",
      "describe_en": "With analysis capability on describe problems, define specifications and construct model for data science."
    }
  ],
