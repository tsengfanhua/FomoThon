  "description": {
    "sub_id3": null,
    "sub_name": "高分子化學特論",
    "sub_ename": "SPECIAL TOPICS IN POLYMER CHEMISTRY",
    "describe_ch": "高分子化學特論係碩士班有關高分子化學之入門課程。本課程包括介紹分子鏈構造，聚合物合成與鑑定分析等基本原理。內容包括：簡介，聚合反應，聚合物鑑定分析，與分子構造對性質之影響效應等。",
    "describe_eh": "The goal is to let students understand the fundamental principles of chain structures, synthesis and characterization of polymers. Topics covered include introduction, polymerization, characterization, and some structure effects on properties.",
    "pre_subname": "CHE3001物理化學(一)",
    "pre_sub_id3": "CHE3001",
    "pre_sub_ename": "CHE3001 PHYSICAL CHEMISTRY(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
