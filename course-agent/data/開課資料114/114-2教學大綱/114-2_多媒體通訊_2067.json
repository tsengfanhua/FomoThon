      "seq": 2,
      "describe_ch": "熟悉多媒體資料處理與壓縮技術",
      "describe_en": "Become familiar with multimedia data processing and compression techniques."
    },
    {
      "seq": 3,
      "describe_ch": "了解多媒體傳輸技術",
      "describe_en": "Develop an understanding of multimedia transmission technologies."
    },
    {
      "seq": 4,
      "describe_ch": "培養多媒體應用設計能力",
      "describe_en": "Develop the ability to design multimedia applications."
    },
    {
      "seq": 5,
      "describe_ch": "培養問題分析與整合能力",
      "describe_en": "Develop the ability to analyze and integrate problems."
    }
