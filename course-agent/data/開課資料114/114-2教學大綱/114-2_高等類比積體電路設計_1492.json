  "description": {
    "sub_id3": null,
    "sub_name": "高等類比積體電路設計",
    "sub_ename": "ADVANCED ANALOG INTEGRATED CIRCUIT DESIGN",
    "describe_ch": "課程中以類比積體電路中基本模組為基礎，將以構建高性能且穩定的類比與混和信號積體電路，諸如開關電容、開關電流IC、鎖相迴路、吉比氏乘法器、壓控振盪器與脈波調變技術等子系統設計為主題。採用課本與論文閱讀方式，探討電路架構、穩定性、低功率與低雜訊等應用設計。",
    "describe_eh": "This course deals with more advanced design of analog / mixed-signal IC sub-system modules , such as switching-capacitor/ switching current ICs , Phase-Locked Loops, Gilbert-Cell multipliers, Voltage-Controlled oscillator(VCO) and pulse modulation techniques etc. by means of text-book and paper-reading. The subjects-discussed will concentrate on the structure of the modules, the stability problem , the low power and low noise design techniques.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能針對不同之模組電路，執行適當之分析與模擬。",
      "describe_en": "Can do analysis and simulation for the different  modules."
    },
    {
      "seq": 2,
      "describe_ch": "具整合計畫管理、有效溝通與跨領域團隊解決問題的能力。",
      "describe_en": "Synthesis of project management and team cooperation."
    },
    {
      "seq": 3,
      "describe_ch": "能蒐集與閱讀相關論文文獻。",
      "describe_en": "Can search and reading related reference papers."
    },
    {
      "seq": 4,
      "describe_ch": "有學術道德責任的認知能力。",
      "describe_en": "Possess an understanding of and competency in academic ethics and responsibilities."
    }
  ],
