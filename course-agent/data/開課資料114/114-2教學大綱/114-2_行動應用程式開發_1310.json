  "description": {
    "sub_id3": null,
    "sub_name": "行動應用程式開發",
    "sub_ename": "MOBILE APPLICATION PROGRAMMING",
    "describe_ch": "這門課將簡介行動裝置應用程式的實做議題，包含進階物件導向觀念的介紹，移動式應用程式開發環境、目前主流之行動應用程式開發、與動態網頁架構設計。在完成此一課程後，學生將能夠應用進階物件導向與行動應用程式開發工具來解決實際之系統問題。",
    "describe_eh": "This course introduces the mobile application programming issues, including advanced object-oriented design concepts, mobile programming tools, mobile application programming, and web-based programming concepts. Upon completion of this course, students can utilize the advanced object-oriented technology and mobile application development tools to develop useful applications.",
    "pre_subname": "IECS2052物件導向設計",
    "pre_sub_id3": "IECS2052",
    "pre_sub_ename": "IECS2052 OBJECT-ORIENTED DESIGN",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解進階物件導向設計與移動式應用程式設計知識",
      "describe_en": "Understand key advanced object-oriented techniques and mobile application programming knowledge"
    },
    {
      "seq": 2,
      "describe_ch": "應用移動式應用程式設計於學期專案中",
      "describe_en": "Realize how to apply advanced mobile application programming skills in the term project"
    },
    {
      "seq": 3,
      "describe_ch": "應用網際網路為基礎之程式設計技巧於學期作業中",
      "describe_en": "Realize how to apply web-based programming skills in the assignments"
    }
  ],
