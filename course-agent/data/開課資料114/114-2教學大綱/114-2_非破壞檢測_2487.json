  "description": {
    "sub_id3": null,
    "sub_name": "非破壞檢測",
    "sub_ename": "NONDESTRUCTIVE TESTING",
    "describe_ch": "使學生瞭解非破壞檢測的目的及原理，依據材料的差異選用適當的檢測方法，以實施實作檢測。並能根據檢測結果，給予正確的判讀與撰寫檢測報告。",
    "describe_eh": "To teach the students the principles and purpose of nondestructive testing. Select the proper nondestructive testing method for different materials.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能識別不同材料之材質、特性與物件的組成。.",
      "describe_en": "To tell the differences of material properties and the details of the components."
    },
    {
      "seq": 2,
      "describe_ch": "評估不同材料或物件可用的檢測方法",
      "describe_en": "To familiarize the nondestructive testing methods and relate to the properties of materials and components."
    },
    {
      "seq": 3,
      "describe_ch": "能發掘問題、收集資料、運用正確檢測方法、分析結果與有效溝通的能力。",
      "describe_en": "Be able to discover questions, collect information, use correct nondestructive testing methods, analyze results and communicate efficiently."
    }
  ],
