    "sub_name": "單元操作(三)",
    "sub_ename": "UNIT OPERATIONS(3)",
    "describe_ch": "單元操作（三）內容主要為質量傳遞（mass transfer）。利用數學模型去了解、描述及設計工程系統中牽涉到質量傳遞的部分。",
    "describe_eh": "Using mathematic models to understand, describe, and design engineering systems and processes that involve the phenomena of mass transfer.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解單元操作之原理與應用",
      "describe_en": "Understand the principles and applications of unit operation"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解可應用於單元操作之電腦輔助工具",
      "describe_en": "Understand which computer-assisted tools could be utilized for unit operation"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解化工程序中所需單元操作設備之功能",
      "describe_en": "Understand the function of equipment required in unit operation"
    },
    {
      "seq": 4,
      "describe_ch": "可進行單元操作設備之相關資料蒐集",
      "describe_en": "Be able to collect information related to equipment for unit operation"
    }
  ],
