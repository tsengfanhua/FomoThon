  "description": {
    "sub_id3": null,
    "sub_name": "地景生態經營與管理",
    "sub_ename": "ECOLOGICAL LANDSCAPE MANAGEMENT",
    "describe_ch": "本課程著重由地景生態觀點介紹環境規劃之空間資料處理知識與規劃方法，包括建置環境資料可參考之資料來源、外業調查方式、空間統計分析與地景指標應用等，以培養學生收集地理資料進行環境分析之能力。",
    "describe_eh": "This course focus on including the knowledge of spatial data survey and planning methods from the viewpoint of ecological landscape. Icluding reference sources of environmental data establishment, field survey techniques, spatial statistical analysis and the application of landscape indices. Students can build up the ability or skill to gather the geographic data for further environmental analysis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "訓練學生理解地景規劃作業程序與工作計畫",
      "describe_en": "training of basic landscape planning procedures and work plan."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生獲得地景資料收集調查、環境觀察、規劃分析與創意能力。",
      "describe_en": "training of landscape data collection, environmental observation, planning analysis and creativity."
    }
  ],
