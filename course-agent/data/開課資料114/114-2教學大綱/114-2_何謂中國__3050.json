  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "XC05111",
    "sub_id": "GM849",
    "scr_dup": "001",
    "sub_title": "文化構成與「中國」概念的形成",
    "sub_title_en": null,
    "sub_describe": "本課程從中國歷史文化的多元面向出發，探討「中國」作為一種文化概念的形成與演變。內容涵蓋家族與家庭制度、宗教信仰、飲食習慣、性別角色與社會倫理等議題，引導學生理解中國文化如何在長期歷史過程中塑造人們的生活方式與價值觀。透過比較與反思，學生將思考「何謂中國」不僅是一個地理或政治問題，更是關於文化認同與文明特質的深層探究。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "何謂中國?",
    "sub_ename": "WHAT IS CHINA?",
    "describe_ch": "文化蓋指一群人生活之方式，而中國之文化對於東亞世界有極大的影響，我們今天的生活無不受其影響。認識中國的最好方式莫過於從文化開始，這更是追溯我們今日文化的由來。本課程將從社會法律、宗教、飲食、性別、秘密社會等五個不同方面，以主題式講解，說明我們今日文化的由來與演變。希冀讓修習本課程之學生，能夠認識自身文化之內涵與運作方式，希望讓學生可以更能融入、享受其今日的社會。",
    "describe_eh": "Culture broadly refers to the way of life of a group of people, and Chinese culture has had a profound influence on the East Asia, shaping many aspects of our lives today. The best way to understand the topic What is China is to begin with its culture, as it allows us to trace the origins of our present-day practices. This course will adopt a thematic approach, examining five key aspects: social laws, religions, food, genders, and secret societies, to explain the origins and evolution of our contemporary culture. Through this course, students will gain an understanding of the content and functioning of their own culture, helping them to better integrate into and appreciate the society they live in today.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "帶領學生了解華人之文化與生活方式。",
      "describe_en": "To guide students to understand the culture and way of life of Chinese people."
    },
    {
      "seq": 2,
      "describe_ch": "強化學生對文化之分析能力，並將其應用至倫理關懷能力。",
      "describe_en": "To enhance students' ability to analyze culture and apply it to ethical considerations."
    }
  ],
