    },
    {
      "seq": 3,
      "describe_ch": "能掌握材料力學性質與軸力、扭力構件之設計概念",
      "describe_en": null
    },
    {
      "seq": 4,
      "describe_ch": "能分析梁之應力與變形行為，進行應力轉換",
      "describe_en": null
    },
    {
      "seq": 5,
      "describe_ch": "能理解柱之挫屈特性並進行基本判斷與計算",
      "describe_en": null
    }
