  "description": {
    "sub_id3": null,
    "sub_name": "材料力學(二)",
    "sub_ename": "MECHANICS OF MATERIALS(2)",
    "describe_ch": "材料力學(二)介紹結構物承受不同外力作用下之內力、形變及載重承載力等進階力學行為，課程目標為培養學生解決進階材料與結構力學問題的基本能力。主要內容包括進階應力、應變、材料力學性質、軸力桿件、扭力桿件、梁之應力分析、應力轉換及柱之挫屈等。",
    "describe_eh": "This course introduces the advanced mechanical behaviors such as internal forces, deformations, and loading capacity of structures subjected to various external forces. The objective of the course is to develop students’ basic ability to solve advanced mechanical problems of materials and structures. The main contents include advanced stress, strain, mechanical properties of materials, members under axial loading, torsion members, stress analysis of beams, transformations of stress, and buckling of columns.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能培養解決進階材料與結構力學問題之基本能力",
      "describe_en": null
    },
    {
      "seq": 2,
      "describe_ch": "能理解並應用進階應力與應變分析",
