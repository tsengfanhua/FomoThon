  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "動力學",
    "sub_ename": "DYNAMICS",
    "describe_ch": "提供學生在各種工程設計與實務中所必須具備的動力問題分析能力。課程內容包括－質點運動學、質點動力學、剛體運動學、剛體動力學。",
    "describe_eh": "The goal of this course is to introduce the students to the dynamic analysis of elementary systems encountered in engineering design practice, as well as to provide the students with a clear understanding of the basic principles. The main topics include kinematics of particles, kinetics of particles, kinematics of a rigid body and kinetics of a rigid body.",
    "pre_subname": "AUTO2028靜力學",
    "pre_sub_id3": "AUTO2028",
    "pre_sub_ename": "AUTO2028 STATICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用數學與物理知識暸解動力學原理。",
      "describe_en": "Apply mathematic and physic knowledge to understand the dynamic principal."
    },
    {
      "seq": 2,
      "describe_ch": "建立運動方程式理解質點或剛體之受力與運動",
      "describe_en": "Construct equation of motion to understand the forces and motion of particles or rigid bordies."
    },
    {
      "seq": 3,
      "describe_ch": "對動力學議題設計合理之計算程序並適切分析結果",
      "describe_en": "Design reasonable computation algorithms and analyze appropriate  conclusions to the dynamic issue"
    },
    {
      "seq": 4,
      "describe_ch": "應用動力學原理評估與分析一個真實系統",
      "describe_en": "Use principals of dynamics to evaluate and analyze a ture system."
    }
  ],
