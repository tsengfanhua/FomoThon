  "description": {
    "sub_id3": null,
    "sub_name": "高等化工熱力學",
    "sub_ename": "ADVANCED CHEMICAL ENGINEERING THERMODYNAMICS",
    "describe_ch": "在課程中將探討並實際了解複雜相與溶液相之間的基本理論和原理，並且將引導運用電腦計算來更深入地了解系統所代表的行為模式與意義",
    "describe_eh": "In this class, the basic theory and principles and the practical understanding of the multiple phases, solution, and the chemical reaction will be studied.  Besides the basic understand of the theory, Computer added calculation have to be conducted under this graduate level class to fully understand the behavior of the system.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用自己的詞彙定義並描述何謂系統：使能夠了解、敘述系統中關鍵的現象",
      "describe_en": "Use your own vocabulary to define and describe what a system is: enable understanding and explain key phenomena within the system."
    },
    {
      "seq": 2,
      "describe_ch": "使能夠了解計算結果所代表的物理意義並提出改善方法來提升對熱力學現象的了解",
      "describe_en": "Enable understanding of the physical meaning represented by calculation results and propose improvement methods to enhance comprehension of thermodynamic phenomena."
    },
    {
      "seq": 3,
      "describe_ch": "使能夠提出並應用化學反應理論計算結果來做為反應設計方向",
      "describe_en": " Enable the ability to propose and apply theoretical calculations of chemical reactions as a direction for reaction design　"
    },
    {
      "seq": 4,
      "describe_ch": "使能夠呈現研究結果並清楚地說明專業的解釋　",
      "describe_en": " Enable the ability to present research results and clearly explain professional interpretations"
    }
  ],
