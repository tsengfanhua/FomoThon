  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE09320",
    "sub_id": "11341",
    "scr_dup": "001",
    "sub_title": "半導體量測理論",
    "sub_title_en": null,
    "sub_describe": "本課程將全面介紹半導體材料與元件的電性與物性量測技術，內容涵蓋各類量測方法的原理、應用與實務操作。課程中將安排學生量測儀器理論，加深對半導體分析工具的理解。培養其在半導體量測上的系統性思考與表達能力。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "半導體量測",
    "sub_ename": "PROBE ON SEMICONDUCTORS",
    "describe_ch": "對半導體材料及元件的電性及物性量測方式做一介紹，並實際安排讓學生熟悉校內貴儀機台及量測儀器的經驗。課中將介紹各類半導體分析的儀器及原理，並讓學生有整理並報告一套量測方法的經歷。",
    "describe_eh": "Introducing the characterization of semiconductor materials and devices. Some lessons about to measure the devices on hand and familiar with some machines in school are also included. In this course, methods and equipments for analyzing the semiconductors as well as reporting some measurement ways by students will be introduced.",
    "pre_subname": "IEE2002電子學(一)、ELEN3008半導體元件、ELEN2017固態電子導論",
    "pre_sub_id3": "IEE2002",
    "pre_sub_ename": "IEE2002 ELECTRONICS(1)、ELEN3008 SEMICONDUCTOR DEVICES、ELEN2017 INTRODUCTION TO SOLID STATE ELECTRONICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道各類半導體特性量測方式。",
      "describe_en": "Knowledge for how to characterize the semiconductor materials and devices."
    },
    {
      "seq": 2,
      "describe_ch": "理解各種量測方式進行半導體特性粹取。",
      "describe_en": "To comprehend all kinds of measurement systems to extract characteristics of semiconductor materials."
    },
    {
      "seq": 3,
      "describe_ch": "應用電流電壓量測方式進行半導體元件特性粹取。",
      "describe_en": "To apply IV tester to extract characteristics of semiconductor deivce."
    }
  ],
