  "description": {
    "sub_id3": null,
    "sub_name": "儲能材料及元件",
    "sub_ename": "ENERGY STORAGE MATERIALS AND DEVICES",
    "describe_ch": "學習電化學材料和元件的各項知識。包括基本的電化學工作原理和各式儲能元件、材料介紹如:鉛酸電池、鎳氫電池、鋰電池、燃料電池、超級電容器等。料",
    "describe_eh": "The aim of this course is to introduce the knowledge of energy storage devices and materials to undergraduate students. It includes the basic principle, synthesis, characterization and applications for various energy storage device and materials such as lead acid battery, nickel metal hydride battery, lithium ion battery, fuel cell, and supercapacitor, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉儲能元件工作機制。\t",
      "describe_en": "Being familiar with the working mechanism of energy storage devices."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解儲能材料之選用和分析技術。\t",
      "describe_en": "Understanding the materials selection and analysis techniques of energy storage materials."
    },
    {
      "seq": 3,
      "describe_ch": "訓練學生對儲能材料及元件之相關技術文獻及資料具有基本之解讀及研判能力。",
      "describe_en": "Training the skills of literature review and survey for energy storage material and devices related reports and information"
    }
  ],
