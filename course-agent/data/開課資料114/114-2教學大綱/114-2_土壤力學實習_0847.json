  "description": {
    "sub_id3": null,
    "sub_name": "土壤力學實習",
    "sub_ename": "SOIL MECHANIC PRACTICE",
    "describe_ch": "本課程提供研習者認識多種土壤材料物理性質試驗方法及分析試驗數據的機會，研習內容包括土壤的機械篩分析、比重計分析、含水量、單位重、土粒比重、液性限度、塑性限度、夯實、及工地密度。",
    "describe_eh": "This course gives learners opportunity to know various soil laboratory test methods for the determination of soil physical properties, including soil mechanical sieve analysis, hydrometer analysis, water content, unit weight, specific gravity of soil solid, liquid limit, plastic limit, compaction, and In-situ soil density.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
