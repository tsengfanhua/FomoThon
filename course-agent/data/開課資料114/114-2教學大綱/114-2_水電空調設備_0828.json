  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CD01530",
    "sub_id": "10351",
    "scr_dup": "001",
    "sub_title": "(水電空調設備)於室內設計階段的運用",
    "sub_title_en": null,
    "sub_describe": "水電空調設備在建築物室內空間中是必然的存在,但初學者在設計之初往往忽略它的必要性,如何運用水電空調設備在空間中呼應設計的一個重要環節.",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "水電空調設備",
    "sub_ename": "EQUIPMENT OF WATER SUPPLY, ELECTRIC & AIR CONDITIONING SYSTEM",
    "describe_ch": "本課程主要目的為認識室內設計中之各項設備及其相關系統的佈局。尤其著重於實際設計時如何站在室內空間的立場去佈局設備及各種管線與管路。",
    "describe_eh": "To teach the Equipment of Water Supply, Electric & Air Conditioning System. Especially to let students to know how to layout these equipments and their lines, plumb and duct in a building interior. In order to make students helpful and clear while they design interior.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知識重點置於室內設計與使用之立場去理解與此相關之水電空調設備及管線系統；\r\n可描述這類設備及管線的種類及其用途；\r\n",
      "describe_en": "This knowledge focuses on how to use and understand Equipment of Water Supply, Electric & Air Conditioning System  and these plumbing system from interior designer and user's side.\r\nCan describe the kind & usage of these equipment & plumbing.\r\n"
    },
    {
      "seq": 2,
      "describe_ch": "能夠理解水電空調設備之用途及其在室內設計中的重要性；\r\n能夠以使用者立場去理解這類設備管線佈局對於使用者之重要性；\r\n",
      "describe_en": "Can understand the usage of Equipment of Water Supply, Electric & Air Conditioning System and the importance on the interior design.\r\nCan understand the importance of plumbing layout of these systems from the user-side.\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "能夠將水電空調設備系統知識應用到室內設計及室內工程之中；",
      "describe_en": "To know how to use the knowledge of Equipment of Water Supply, Electric & Air Conditioning System on the interior design and the interior works."
    }
  ],
