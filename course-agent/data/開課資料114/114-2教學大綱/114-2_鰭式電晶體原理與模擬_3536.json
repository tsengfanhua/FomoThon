  "description": {
    "sub_id3": null,
    "sub_name": "鰭式電晶體原理與模擬",
    "sub_ename": "FinFET PRINCIPLE AND SIMULATION",
    "describe_ch": "本課程區分兩部分，首先講解鰭式電晶體之基本結構、各部組成材料、工作原理及各式元件操作性能電性指標等等，並運用元件物理觀念置換各種不同之組成材料，使學生能初步瞭解元件設計之概念，然後教導學生Synopsys TCAD Sentaurus半導體元件電性及製程整合模擬軟體之操作，並經由實際上機模擬鰭式電晶體之元件結構與輸出各式電性曲線，以達到學用合一之目標，期能增進學生之學習成效。",
    "describe_eh": "This course is divided into two parts. First, it explains the basic structure of FinFETs, the materials used in their components, their working principles, and the electrical performance indicators of various components. It also uses the physical concepts of components to replace various different materials, enabling students to gain a preliminary understanding of component design concepts. Then, it teaches students how to operate the Synopsys TCAD Sentaurus semiconductor component electrical and process integration simulation software. Through hands-on simulation of the FinFET component structure and output of various electrical curves, the course aims to achieve the goal of integrating learning with application, thereby enhancing students' learning outcomes.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生能具備鰭式電晶體之各部結構、組成材料、工作原理等基本知識及瞭解電晶體元件操作性能之各式電性指標。",
      "describe_en": "This course aims to equip students with basic knowledge of the structure, materials, and working principles of FinFET, as well as an understanding of the various electrical properties of transistor components."
    },
    {
      "seq": 2,
      "describe_ch": "使學生會操作半導體元件電性及製程整合模擬軟體Sentaurus TCAD 之操作，並實際模擬出FinFET元件結構與各式電性曲線。",
      "describe_en": "To enable students to operate the semiconductor device electrical and process integration simulation software Sentaurus TCAD and to actually simulate the structure and various electrical curves of FinFET devices."
    }
  ],
