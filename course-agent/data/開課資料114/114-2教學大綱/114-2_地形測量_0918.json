  "description": {
    "sub_id3": null,
    "sub_name": "地形測量",
    "sub_ename": "TOPOGRAPHIC SURVEYING",
    "describe_ch": "地形測量為所有工程建設之基礎科學，舉凡土木工程、建築工程、交通工程…等，皆需藉由地形測量，得到工程設計所需之基本資料。本課程旨在使學生瞭解地形測量原理及作業技術與製圖方法，並熟練測量儀器之操作及維護，使理論與實際結合。",
    "describe_eh": "Topographic surveying is the basic science of all engineering constructions, such as\ncivil engineering, architectural engineering, and traffic engineering etc.. The\ndatabase for engineering design must be obtained by topographic surveying. The\nobjective of this course is to understand the principles, operation techniques, and\ndrafting methods of the topographic surveying. The students are skilled at operating\nand maintaining the surveying instruments to make for the union of the theory and\npractice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "地形測量為所有工程建設之基礎科學，舉凡土木工程、建築工程、交通工程…等，皆需藉由地形測量，得到工程設計所需之基本資料。本課程旨在使學生瞭解地形測量原理及作業技術與製圖方法，並熟練測量儀器之操作及維護，使理論與實際結合。",
      "describe_en": " "
    },
    {
      "seq": 2,
      "describe_ch": "熟練各種測量儀器之操作",
      "describe_en": "To understand how to operate the surveying instruments."
    },
    {
      "seq": 3,
      "describe_ch": "能利用測量數據計算成果",
      "describe_en": "To utilize the data of surveying to calculate the results by field works."
    }
  ],
