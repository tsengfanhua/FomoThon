  "description": {
    "sub_id3": null,
    "sub_name": "電子學實驗(二)",
    "sub_ename": "ELECTRONICS LAB.(2)",
    "describe_ch": "此課程之目的主要配合電子學(二)課程，輔之以電腦模擬與麵包板實驗驗證，以提高學生學習興趣，厚植其基本概念與理論基礎。",
    "describe_eh": "This course is companioned with the Electronics (2). In addition to breadboard experiments, the computer simulation and verification for electronic circuits will also be adopted in this lab. The objective of this course is to enhance the students' principles and technique kills of microelectronic circuits.",
    "pre_subname": "IEE2005電子學實驗(一)、EEEN2005電子學實驗(一)",
    "pre_sub_id3": "IEE2005",
    "pre_sub_ename": "IEE2005 ELECTRONICS LAB.(1)、EEEN2005 ELECTRONICS LAB.(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的專業詞彙定義電子學中，何謂Differential and Multistage Amplifiers以及運算放大器能夠描述Differential and Multistage Amplifiers以及運算放大器其特性。",
      "describe_en": "Define and describe the characteristics of Differential and Multistage Amplifiers and OP amplifier in Microelectronic Circuits based on the knowledge obtained in this course."
    },
    {
      "seq": 2,
      "describe_ch": "能辨識出可應用定理與模型的場合，並能清楚表達。",
      "describe_en": "Applications for distinguishing and making clear statement to which theory and modeling of electronic system can be applied."
    }
  ],
