  "description": {
    "sub_id3": null,
    "sub_name": "半導體元件",
    "sub_ename": "SEMICONDUCTOR DEVICES",
    "describe_ch": "這個課程主要是提供半導體元件的基本特性、功能和應用。為了能對此了解，必須要對半導體材料有一定的認識。",
    "describe_eh": "The purpose of this course is to provide a basis for understanding the characteristics, functionality, and applications of semiconductor devices. In order to gain this understanding, it is essential to have a thorough knowledge of the physics of the semiconductor material.",
    "pre_subname": "PHYS2005近代物理",
    "pre_sub_id3": "PHYS2005",
    "pre_sub_ename": "PHYS2005 MODERN PHYSICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能暸解並清楚描述各種基本半導體元件之結構、工作原理與應用。",
      "describe_en": "Can realize and clearly describe the structure, operation principle and applications of various fundamental semiconductor devices."
    },
    {
      "seq": 2,
      "describe_ch": "能適當應用半導體物理之知識，描述基礎元件之特性。",
      "describe_en": "Can adequately apply knowledge of semiconductor physics to describe the device fundamental characteristics."
    },
    {
      "seq": 3,
      "describe_ch": "具備半導體元件之基礎設計與分析能力。",
      "describe_en": "Apply wave Optics theory to real optical systems and can analyze them."
    },
    {
      "seq": 4,
      "describe_ch": "能藉由習題的實作，了解原理及分析半導體元件。",
      "describe_en": "Can understand principles and analyze elementary semiconductor devices by solving exercises or doing homework."
    }
  ],
