  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "XF01103",
    "sub_id": "08316",
    "scr_dup": "001",
    "sub_title": "英語聽說讀寫以及增進批判性思考",
    "sub_title_en": null,
    "sub_describe": "藉由任務型導向教學，增進學生英語基礎技能。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "大學基礎英文(二)中高級",
    "sub_ename": "GENERAL ENGLISH (2) HIGH INTERMEDIATE",
    "describe_ch": "本課程分四級授課，採用不同素材，納入多元教學活動， 協助學生理解、賞析文本，建構自己的觀點，並與同儕分享、交流，以培養英語閱讀、口說、與聽力的基礎技能。",
    "describe_eh": "The course is divided into four levels. Different materials and diverse teaching activities were incorporated into course design to help students comprehend and appreciate texts, construct their own viewpoints, and communicate with their peers in order to develop basic skills in reading, speaking, and listening in English.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "找到多元學習素材之主題，理解內容大意、分析重要細節及邏輯相關性。",
      "describe_en": "In regard to the multiple learning materials, students can identify topics and themes, comprehend gist, and analyze important details and their logical relevance."
    },
    {
      "seq": 2,
      "describe_ch": "針對素材所呈現之主題，有效地表達自我想法，與他人進行溝通討論。",
      "describe_en": "Students can effectively express their opinions on the themes of learning materials and communicate with others effectively."
    },
    {
      "seq": 3,
      "describe_ch": "藉由合作式學習，了解、尊重多元觀點的差異性，並培養團隊合作的能力。",
      "describe_en": "Through collaborative learning, students can understand and respect diverse perspectives and learn to cooperate with other people in teams."
    }
  ],
