  "description": {
    "sub_id3": null,
    "sub_name": "電路學",
    "sub_ename": "ELECTRIC CIRCUITS",
    "describe_ch": "本課程的內容首先在於電路上的基本線性元件的介紹，接著講授電路定理與直流分析技巧，最後擴展到交流電路的分析。",
    "describe_eh": "The purpose of this course is to introduce the basic linear elements of electric circuit, theories of electric circuit analysis, and the analysis methods of DC and AC electric circuit.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉電路上的基本線性元件並理解其物理原理與參數。",
      "describe_en": "To be familiar with the basic linear electric circuit elements and to comprehend their physics and parameters."
    },
    {
      "seq": 2,
      "describe_ch": "理解電路基本定理及其延伸的電路分析方法。",
      "describe_en": "To comprehend the basic theories of electric circuit and the electric circuit analysis methods."
    },
    {
      "seq": 3,
      "describe_ch": "應用電路分析方法於計算電路元件的參數。",
      "describe_en": "To apply the analysis methods to calculate the parameters of the electric circuit elements."
    }
  ],
