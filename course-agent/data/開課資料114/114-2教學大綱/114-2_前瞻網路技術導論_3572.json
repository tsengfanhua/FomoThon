  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CI02139",
    "sub_id": "77350",
    "scr_dup": "001",
    "sub_title": "本課程探究網路技術演進與前瞻開應用開發之視角，引導學生從當前技術、需求與限制中萃取方向的能力思考與發想「前瞻」網路架構與應用。學生將嘗試以既有或可行技術為基礎，提出合理的下一世代網路設計構想，並以五大核心原則作為分析與評估框架。",
    "sub_title_en": null,
    "sub_describe": "五大核心原則：以協定為核心的設計（Protocol-Centric Design）、網路與管理的自治性（Autonomy of Networks）、異質系統之間的可互通性（Interoperability across Heterogeneous Systems）、透過分層與抽象支撐技術演進（Layering and Abstraction for Evolvability）、以盡力而為與端對端精神換取可擴展性（Best-Effort & End-to-End for Scalability）",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "前瞻網路技術導論",
    "sub_ename": "INTRODUCTION TO ADVANCED NETWORK TECHNOLOGY",
    "describe_ch": "本課程將介紹在隨著無線與行動通訊系統持續發展下，配合5G/6G等重要議題，須了解超寬頻、超低延遲及超可靠、超智慧等通訊特性下的前瞻網路技術。學生在本課程中可先了解到前瞻的網路技術發展，作為未來進階學習的基礎。",
    "describe_eh": "This course will introduce the development of wireless and mobile communication systems in line with important topics such as 5G/6G, including the need to understand the development of Advanced network technologies under the communication characteristics of ultra-wideband, ultra-low latency, ultra-reliability, and ultra-intelligence. In this course, students can learn about the Advanced development of network technology and provide a reference direction for in-depth study in the future.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養學生認識計算機網路分層架構與網路技術",
      "describe_en": "Develop students’ understanding of the layered architecture of computer networks and networking technologies."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生對通訊網路相關論文閱讀、研討以及批判能力",
      "describe_en": "Develop students’ abilities in reading, discussing, and critically analyzing research papers in communication networks."
    }
  ],
