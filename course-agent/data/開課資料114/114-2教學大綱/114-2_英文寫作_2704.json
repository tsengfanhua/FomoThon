  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "NM06110",
    "sub_id": "97860",
    "scr_dup": "001",
    "tpa_score_new": null,
    "tpa_score_new_en": null,
    "course_pol": null,
    "course_pol_en": "1. Within three days after the exam date, students must apply for a make-up exam in accordance with university regulations and submit relevant supporting documents. The reason for requesting a make-up exam must comply with the valid grounds specified in the university regulations (based on Feng Chia University Academic Regulations, Article 26). Absentees or late applicants will receive a grade of zero. The date of the make-up exam will be arranged by the course instructor.\n\n2. All leave of absence requests must be submitted through iLearn. If graded in-class activities or coursework fall during the week of your absence, you will have two weeks (excluding the week of absence) to submit the work. Please note that an approved leave of absence only ensures that your attendance record will not be affected. However, if you fail to submit the coursework for that week, you will still receive a grade of zero for the assignment.",
    "course_rem": null,
    "course_rem_en": "3. Late works will not be accepted and will be marked zero as punishment unless a valid excuse is provided.",
    "ais_meno": null,
    "ais_meno_en": "<ol>\n\t<li>Students must exhibit honesty and ethical behavior in their academic activities, avoiding plagiarism and falsification of data.</li>\n\t<li>The use of AI to assist with coursework is regulated in this class. Please follow the teacher&rsquo;s instructions whenever required.</li>\n\t<li>Plagiarism: Proper citation of sources is required. Copying or using others&rsquo; work without appropriate attribution in considered plagiarism.</li>\n\t<li>Cheating: Following exam rules is mandatory. Unauthorized materials or collusion with others during exam is considered cheating.</li>\n</ol>\n",
    "ilearn_mk": "N"
  },
