  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE11149",
    "sub_id": "56250",
    "scr_dup": "001",
    "sub_title": "電機控制",
    "sub_title_en": null,
    "sub_describe": "本課程旨在培養學生對電機結構、數學模型與控制方法之完整理解，並使學生具備分析與應用現代電機控制策略（如磁場導向控制、直接轉矩控制、弱磁控制、最大轉矩／電流控制與無感測器控制）的能力。透過系統性理論講授與範例討論，學生可整合分析、模擬與工程表達能力，達成電機控制核心學習成效。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "電機控制",
    "sub_ename": "CONTROL OF ELECTRIC MACHINES",
    "describe_ch": "此課程主要目標讓學生獲得電力電子/控制之電路分析與設計等方面的基礎能力，和有解決電力電子/控制之電路問題所需要的獨立思考與創新能力。訓練學生具有組織能力與溝通技術，讓學生能夠發揮團隊力量來解決問題。教導學生如何執行與驗證各項電力電子/控制之電路分析與設計。",
    "describe_eh": "The objective of this course is to give the fundamentals of power electronics. Incubating the students to achieve analysis and design ability of power electric control systems.",
    "pre_subname": "EEEN3023電力電子、EEEN3019電機機械 (一)、EEEN2012微處理機系統",
    "pre_sub_id3": "EEEN3023",
    "pre_sub_ename": "EEEN3023 POWER ELECTRONICS、EEEN3019 ELECTRIC MACHINES (1)、EEEN2012 MICROPROCESSOR SYSTEMS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的專業詞彙定義電動機控制系統中，何謂DC motor, Induction motor, synchronous motor以及Brushless motor能夠描述四種不同馬達之電路與其特性。\t",
      "describe_en": "Knowledge for understanding and describing the characteristics of DC motor, Induction motor, synchronous motor, and Brushless motor."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明Inverters, DC motor, Induction motor, synchronous motor以及Brushless motor其特性與應用。\t",
      "describe_en": "Comprehension for being able to explain the characteristics and applications of DC motor, Induction motor, synchronous motor, and Brushless motor."
    },
    {
      "seq": 3,
      "describe_ch": "能辨識出可應用定理與模型的場合，並能清楚表達。\t",
      "describe_en": "Applications for distinguishing and making clear statements  to which theory and modeling of  electric motor drive control system can be applied."
    }
  ],
