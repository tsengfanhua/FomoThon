  "description": {
    "sub_id3": null,
    "sub_name": "企業評價與財報分析",
    "sub_ename": "BUSINESS VALUATION AND FINANCIAL STATEMENT ANALYSIS",
    "describe_ch": "本課程之目的在幫助學生瞭解創投與企業評價之內容、理論基礎及實務上之應用，並期使學生瞭解我國創投現況及相關法規、企業評價技術、企業策略分析、無形資產評價及企業展望分析。　",
    "describe_eh": "The purpose of the course is to assist students in comprehending the contents, the theoretical foundation and the application of venture capital and business valuation. The course is to assist students in understanding the venture capital environment and its law, business valuation techniques, business strategy analysis, intangible assets valuation and business prospective analysis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能分析企業評價系統架構之用途，並定義企業評價之基本要素及假設。\t",
      "describe_en": "Be able to analyze the usefulness of business valuation information framework and define the basic elements and assumptions of business valuation."
    },
    {
      "seq": 2,
      "describe_ch": "能利用會計資訊以進行企業分析。 　　\t",
      "describe_en": "Be able to analyze the accounting information for business valuation."
    },
    {
      "seq": 3,
      "describe_ch": "能綜合瞭解創投之基本要素，並說明我國創投環境及其相關法規。　\t",
      "describe_en": "Understand and be able to synthesis the basic elements of venture capital and explain the venture capital environment and its law."
    }
  ],
