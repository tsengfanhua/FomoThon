  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB00101",
    "sub_id": "50239",
    "scr_dup": "001",
    "sub_title": "創業與商業模式創新",
    "sub_title_en": null,
    "sub_describe": "協助非商學院大一學生思考如何利用逢甲夜市、國際會展中心與原系所專長，結合商學院專業知識後，重新思考未來可能的創業機會，或提出新的創業成功模式",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "創業起點：打造你的商模",
    "sub_ename": "STARTING A BUSINESS: BUILDING YOUR BUSINESS MODEL",
    "describe_ch": "本課程「 創業起點：打造你的商模」旨在協助非商學院大一學生思考新興的商業模式，課程設計以專題式學習（Project-Based Learning, PBL）為核心，引導非商學院學生運用自身專長與商學知識，探索創業機會、驗證商業模式，課程設計依照創業歷程分為初期、中期與後期三階段，將商學院各系所特色知識融入課程，以回應學生對於跨領域學習與實務應用的需求。",
    "describe_eh": "This course, ‘Starting a Business: Building Your Business Model,’ aims to help first-year students outside of the business school think about emerging business models. This curriculum centers on Project-Based Learning (PBL), guiding students from non-business majors to apply their own expertise and business knowledge to explore entrepreneurial opportunities and validate business models. The course design follows the entrepreneurial process in three stages: early, mid, and later, integrating the distinctive knowledge of various departments in the College of Business to meet students' needs for cross-disciplinary learning and practical application.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "暸解創業的基本概念與技術",
      "describe_en": "Understand the basic concepts and techniques of entrepreneurship"
    },
    {
      "seq": 2,
      "describe_ch": "應用商學知識到創業的過程",
      "describe_en": "Applying business knowledge to the process of entrepreneurship"
    },
    {
      "seq": 3,
      "describe_ch": "分析目前的創業機會和挑戰",
      "describe_en": "Analyze the current entrepreneurial opportunities and challenges"
    }
  ],
