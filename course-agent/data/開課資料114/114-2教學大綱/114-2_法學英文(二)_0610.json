  "description": {
    "sub_id3": null,
    "sub_name": "法學英文(二)",
    "sub_ename": "LEGAL ENGLISH (II)",
    "describe_ch": "針對法律系學生所規劃。學生必須能運用英文熟諳的表達其法律專業。本學期著重於擴大學生的國際視野及培養學生對處理複雜的國際事件時所必需的基本能力。",
    "describe_eh": "This course is special intended for law students. Students must be professional to express their legal ability in English. This semester is focus on foster, cultivate and broaden the international perspective and to develop students' ability to analyze as well as deal with the complexity of international events.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過專門領域法律文件和法規之閱讀，加強學生對法律英文之閱讀能力。",
      "describe_en": "Strengthening the reading ability of legal English by studying legal texts and legislation, etc."
    },
    {
      "seq": 2,
      "describe_ch": "藉由法律期刊及案件的研讀與討論，提升學生統整、分析之能力，並培養其國際觀。",
      "describe_en": "Promoting the ability of analysis and integration as well as fostering the international perspective by discussing and reading law reviews and studying cases."
    },
    {
      "seq": 3,
      "describe_ch": "擴展學生之國際視野及專業知識廣度。",
      "describe_en": "Broaden students’ international perspective."
    },
    {
      "seq": 4,
      "describe_ch": "訓練學生口頭報告及陳述法律事件之專業能力。",
      "describe_en": "Train students' ability for oral presentation and express legal events."
    }
  ],
