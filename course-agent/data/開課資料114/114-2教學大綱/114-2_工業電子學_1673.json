  "description": {
    "sub_id3": null,
    "sub_name": "工業電子學",
    "sub_ename": "INDUSTRIAL ELECTRONICS",
    "describe_ch": "經由有趣及易於了解的模式讓學生了解工業電子元件和系統，了解閘流體的工作原理與電路設計，線性元件(如: A/D,D/A,F/V,V/F,PLL...)的認識與電路設計，感測系統的原理與感測電路設計\n 。",
    "describe_eh": "1. Let students comprehend the industry electronic components and systems through an interesting and easy-to-understand way.\n 2. Let students know the work principle and circuit design of thyristor.\n 3. Let students know the linear components, such as A/D, D/A, F/V, V/F, PLL etc., and circuit design.\n 4. Let students know the principle and sensor circuit design of the sensor system.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解工業電子元件與系統之相關特性。",
      "describe_en": "Let students understand the fundamental characterizations of industry electronic components and systems\r\n"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解閘流體、線性元件的工作原理與電路設計。\r\n",
      "describe_en": "Let students know the work principle and circuit design of thyristor and linear components.\r\n\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "3.瞭解感測系統的原理與感測電路設計。",
      "describe_en": "Let students know the principle and sensor circuit design of the sensor system."
    },
    {
      "seq": 4,
      "describe_ch": "學習以書面及口頭方式，將學習結果與同儕、助教及教師共同討論。\r\n",
      "describe_en": "Discuss results in program and oral form to classmates, teaching assistants and the instructor."
    }
  ],
