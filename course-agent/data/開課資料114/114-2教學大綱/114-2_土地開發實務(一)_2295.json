  "description": {
    "sub_id3": null,
    "sub_name": "土地開發實務(一)",
    "sub_ename": "LAND DEVELOPMENT PRACTICE I",
    "describe_ch": "本課程為土地開發實務初階課程。課程主要結合土地管理專業領域知識，讓同學分組，透過操作實務課題，整合理論與實務，並以書面報告、口頭簡報呈現最終製作成果。",
    "describe_eh": "This course is an beginning practical lesson. The purpose of this course is to assist students to combine theory and practice by way of dealing with practical land development problems. The final results will be presented through grouping oral and written report.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解土地管理相關專業領域之知識。",
      "describe_en": "Be able to realize the relevant land management knowledges."
    },
    {
      "seq": 2,
      "describe_ch": "能應用相關專業領域軟體進行相關資料處理與分析。",
      "describe_en": "Be able to operate the relevant land management software."
    },
    {
      "seq": 3,
      "describe_ch": "能綜合土地管理領域之理論，並解決土地管理實務問題。",
      "describe_en": "Be able to comprehensively apply land management theory and solve land management practical problems."
    }
  ],
