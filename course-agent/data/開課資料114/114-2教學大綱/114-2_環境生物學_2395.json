  "description": {
    "sub_id3": null,
    "sub_name": "環境生物學",
    "sub_ename": "ENVIRONMENTAL BIOLOGY",
    "describe_ch": "生物學是一門探討生命現象的科學，涵蓋眾多主題與其它眾多學科皆有關連的基礎課程，也是大學生必須具備之基本知識；本課程接續大一上生物學課程，介紹環境中相關生物學的重要知識概念與最新發展。",
    "describe_eh": "Biology is a science explore the phenomenon of life, with many disciplines are related to a basic course, but also the students must have basic knowledge; This course introduces the important knowledge in environmental biology concepts and latest developments.",
    "pre_subname": "EES1002生物學",
    "pre_sub_id3": "EES1002",
    "pre_sub_ename": "EES1002 BIOLOGY",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解植物的構造、生長和繁殖、營養需求、養分的輸送。",
      "describe_en": "Understand the structure of the plant, growth and reproduction, nutrition requirements and nutrient transport."
    },
    {
      "seq": 2,
      "describe_ch": "理解演化論觀念、種化機制與族群遺傳的模式。",
      "describe_en": "Comprehend the principle of evolution, speciation mechanism and the pattern of population genetic structure."
    },
    {
      "seq": 3,
      "describe_ch": " 瞭解生態基礎理論與生物多樣性，進而分析當代環境生態的相關議題。",
      "describe_en": "Understand of the ecological basic theory and biodiversity, then analyze the related issues of the environment and ecology."
    }
  ],
