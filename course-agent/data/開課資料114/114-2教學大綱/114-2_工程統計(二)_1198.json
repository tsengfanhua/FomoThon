  "description": {
    "sub_id3": null,
    "sub_name": "工程統計(二)",
    "sub_ename": "ENGINEERING STATISTICS(2)",
    "describe_ch": "本課程強調與說明機率模式與統計方法在工業工程的各種應用。為達成這個目標，本課程教授下列內容：敘述統計、基本機率、抽樣分配、估計問題、假設檢定、迴歸與相關、變異數分析與無母數統計學等。",
    "describe_eh": "This course emphasizes and illustrates the use of probabilistic models and statistical methodology that is employed in countless applications in industrial engineering. To attain this goal, this course includes the following topics: descriptive statistics, basic probability, probability distributions, sampling distributions, estimation problems, tests of hypotheses, regression and correlation, analysis of variance, nonparametric statistics and so on.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能針對特定有關統計方法的應用問題，設計合理程序，並且獲得適切結論。",
      "describe_en": "Be able to design a process for a specific problem that is employed statistical methodology, and find the appropriate  onclusions and be able to effective communication."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解與解釋統計方法在工業工程的應用。",
      "describe_en": "Understand and explain the use of statistical methodology that is employed in industrial engineering."
    },
    {
      "seq": 3,
      "describe_ch": "能辨識應用統計方法的場合，並能有效的溝通與清楚表達及創新思維。",
      "describe_en": "Distinguish and make clear statement where probabilistic models can be applied and be able to effective communication and innovative thinking."
    },
    {
      "seq": 4,
      "describe_ch": "能使用統計方法與套裝程式，完成數據分析，並歸納出適當結論。",
      "describe_en": "Be able to use statistical methodology and computer package to finish a data analysis and draw appropriate conclusions."
    }
  ],
