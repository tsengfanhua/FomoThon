  "description": {
    "sub_id3": null,
    "sub_name": "專題討論",
    "sub_ename": "SEMINAR",
    "describe_ch": "引導學生學習精準提問力與心智圖的技巧，並透過小組討論之合作學習模式，來提升學生的整體學習成效。學生報告寫作要則、分組(5-7人)進行任務分派、小組分工(資料搜尋、彙整分析、提問討論、口頭報告資料製作、口頭報告答辯、討論要點追蹤)。由各組推派代表上台報告，由教師進行綜合講評。學期末，各組繳交期末書面報告、上課心得與重點紀錄，導入許多教學活動如(a)小組團體遊戲、(b)使用訓練心智圖與學習專注力的手機App、(c)集體共同手繪心智圖與曼陀羅九宮格體驗、(d)小組討論的角色分工與任務管理歷程。",
    "describe_eh": "Seminar on selected topics of materials is valuable training for each MSE student. Precision questioning and mind-map skills as well as collaborative learning are beneficial to promote overall learning performance for MSE program. Students in a group will play designated roles such as literature searching, reading and compiling, discussions and questioning, oral presentation, tracking of meeting minutes and final report. Instructor will give technical comments and suggestions after each presentation. Students are inspired with many in-class fun activities including group games, mind-map and learning focus practice apps, and brain-storming.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解材料之發展沿革及最新動態，並能實際體驗材料之應用向面，並結合吾人生活與工業活動。",
      "describe_en": "To understand the historical developments and technological frontiers for the material science and to encourage students to grasp the key concepts of the applications and products of material science to be associated with the contents of our daily life"
    },
    {
      "seq": 2,
      "describe_ch": "了解學生對材料研究與開發之專案知識及興趣。",
      "describe_en": "To understand the necessary knowledge and interests on the material science to serve the purpose of the research and development tasks in the future."
    },
    {
      "seq": 3,
      "describe_ch": "綜合材料工程之間的相關性或功能性，以整理勾勒出個人生涯之學習成長地圖佈局。",
      "describe_en": "To synthesize the inter-relationship and complementariness between this course and other subjects in materials science and engineering to delineate the life learning and career planning path."
    },
    {
      "seq": 4,
      "describe_ch": "以書面或口頭報告方式，對於所獲之技術論文及研發結果與同學及教師陳述溝通。",
      "describe_en": "To synthesize verbal and written capability as discussing or explaining the technical context and R&D results of the subject of electronic ceramics to the peers, teaching assistants or the instructor."
    }
  ],
