  "description": {
    "sub_id3": null,
    "sub_name": "醫療器材專論",
    "sub_ename": "SPECIAL TOPICS IN MEDICAL EQUIPMENT",
    "describe_ch": "醫療器材是一個產品種類多樣，我國將醫療器材定義為：包括診斷、治療、減輕、或直接預防人類疾病或足以影響人類身體結構及機能之儀器、器械、用具及其附件、配件、零件。其分為診斷與監測用醫療器材、手術與治療用醫療器材、輔助/修補用醫療器材、體外診斷器材、以及非屬上述器材之其他醫療器材等五大類。本課程旨在透過模組化的課程設計，讓學生了解醫療器材的各種相關議題，包含：        醫療器材的種類與簡介、醫療器材的安全與法規、醫療器材的產業趨勢、醫療器材的實例分析等>",
    "describe_eh": "A medical device is a product which is used for diagnosis, monitoring, treatment and surgical intervention. Medical devices include a wide range of products. The course includes the medical devices related to cardiovascular, respiratory, and renal systems. We also talk about the images, biochemisty laboratory and monitoring system in the intensive care unit.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用數學基礎，以了解醫療器材的基本知識。",
      "describe_en": "Apply mathematic foundation to understand the basic knowledge about medical devices."
    },
    {
      "seq": 2,
      "describe_ch": "理解不同醫療器材的性能的定義與定理。",
      "describe_en": "Comprehension for the definitions or theories of medical devices."
    },
    {
      "seq": 3,
      "describe_ch": "了解不同醫療器材的設計考量、製造方式、安全考量、法規限制、管理策略、認證內涵、專利內容、產業與就業趨勢，對醫療器材具備描述問題、訂定規格、建構模型之各項分析能力。",
      "describe_en": "Understand the design policy, manufacturing process, security considerations, standardization and regulatory concerns of medical devices. With analysis capability on describing problems, defining specifications, and constructing model for medical devices."
    }
  ],
