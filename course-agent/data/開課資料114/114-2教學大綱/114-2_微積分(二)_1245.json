  "description": {
    "sub_id3": null,
    "sub_name": "微積分(二)",
    "sub_ename": "CALCULUS(2)",
    "describe_ch": "內容包含 L'Hospital's Rule，積分技巧，多變元函數的偏導數、雙變數函數的極大、極小，二重積分，疊積分，極座標的二重積分，多重積分的變數變換，無窮數列與級數，冪級數，泰勒級數，馬克勞林級數，並探討相關應用。",
    "describe_eh": "Topics include L'Hospital's Rule, the Techniques of Integration, Partial Derivatives, Maximum and Minimum, Double Integrals, Iterated Integrals, Double Integral in Polar Coordinate, Change of Variables in Multiple Integrals, Infinite Sequences and Series,  Power Series, Taylor's and Maclaurin Series, and their applications.",
    "pre_subname": "MATH1005微積分(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解基本函數極限、連續、導數與積分之運算規則，及進階積分技巧，並使學生熟練運算技巧。",
      "describe_en": "Comprehend the laws of  limit, continuity and derivative, and techniques of integrations."
    },
    {
      "seq": 2,
      "describe_ch": "理解數列與級數收斂發散的理論及函數的級數表示方式，並使學生能處理相關問題。",
      "describe_en": "Comprehend the theorems of convergence and divergence of sequences and series."
    },
    {
      "seq": 3,
      "describe_ch": "理解多變數實數值函數之極限、連續、偏導數及重積分等定義，建立相關定理與運算規則，並使學生了解其幾何意義及熟練運算技巧。",
      "describe_en": "Comprehend the limit, continuity and partial derivatives of multivariable functions, and   establish relative laws and theorems. Moreover, enable students to understand the geometric meaning and to be familiar with the relative skills."
    },
    {
      "seq": 4,
      "describe_ch": "應用微積分理論及運算技巧處理相關幾何問題及極大極小值問題等，並為經濟學與物理學等跨領域學習作準備。",
      "describe_en": "Apply calculus to deal with the geometric problems and extreme value problems. It is helpful to study economics and physics."
    }
  ],
