  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(二)",
    "sub_ename": "ENGINEERING MATHEMATICS(2)",
    "describe_ch": "教導學生解決工程及應用科學中相關問題所需之基礎數學。課程內容主要涵蓋向量微積分學、傅利葉級數及偏微分方程式。",
    "describe_eh": "This course aims to teach students the fundamental mathematics for solving engineering and applied science related problems. The course content mainly contains vector calculus, Fourier series and partial differential equations.",
    "pre_subname": "MATH1001微積分(一)、MATH1005微積分(一)、MATH1002微積分(二)、MATH1006微積分(二)、MATH1001P微積分(一)實習",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1005 CALCULUS(1)、MATH1002 CALCULUS(2)、MATH1006 CALCULUS(2)、MATH1001P RECITATION OF CALCULUS (1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解何謂向量微積分，且能夠描述重要的向量積分定理及其運算步驟",
      "describe_en": "Understand what vector calculus is and be able to describe the important vector integral theorems and their operation procedures."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解何謂傅利葉級數及傅利葉轉換及其演算步驟和相關技巧",
      "describe_en": "Understand what the Fourier series and Fourier transform are, and their operation procedures and related techniques"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解何謂偏微分方程式及其解法",
      "describe_en": "Understand what partial differential equations are and their solution  methods"
    },
    {
      "seq": 4,
      "describe_ch": "能將機械工程相關問題，以微分方程式表達並求解之",
      "describe_en": "Be able to formulate mechanical engineering related problems into partial differential equations and then solve them"
    }
  ],
