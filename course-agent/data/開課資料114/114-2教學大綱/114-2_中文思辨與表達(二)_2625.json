  "description": {
    "sub_id3": null,
    "sub_name": "中文思辨與表達(二)",
    "sub_ename": "CRITICAL THINKING AND EXPRESSION IN CHINESE(2)",
    "describe_ch": "本課程以溝通式教學法(Communicative Language Teaching)為主，聽說教學法(audiolingual method)為輔，提升國際生華語聽說讀寫基本能力，培養國際生在台灣求學與生活時，有效地應用華語進行溝通與表達。",
    "describe_eh": "This course is mainly based on Communicative Language Teaching, supplemented by audiolingual method, to improve the basic skills of international students in Chinese listening, speaking, reading and writing, and to train them to effectively apply them when studying and living in Taiwan.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
