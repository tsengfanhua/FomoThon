  "description": {
    "sub_id3": null,
    "sub_name": "觀光西語",
    "sub_ename": "ANISH FOR TOURISM",
    "describe_ch": "本課程旨在培養學生於西語系國家生活、旅遊與文化交流時所需之實用西語溝通能力。內容涵蓋日常情境會話、跨國文化差異、旅遊與社會互動、生活習慣及在地實務應對，使學生能以西語在真實生活中進行有效且自然的交流。同時透過文化比較與情境模擬，增進學生對西語世界之社會、文化與生活方式的理解，建立跨文化溝通能力。課程適合未來欲至西語國家旅遊、交換或生活之學生。",
    "describe_eh": "This course aims to develop students’ practical Spanish communication skills for living, traveling, and interacting in Spanish-speaking countries. It covers everyday conversation, cross-cultural differences, social interaction, local customs, and real-life scenarios. Students will learn to use Spanish naturally and effectively in authentic situations while gaining a deeper understanding of the societies and cultures of the Spanish-speaking world. Through cultural comparison and situational practice, the course enhances students' intercultural communication abilities, making it suitable for those planning to travel, study abroad, or live in Spanish-speaking countries.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養學生在交換、遊學生活或旅遊相關情境中的西班牙語會話溝通能力",
      "describe_en": "Develop students’ conversational communication skills in exchange student life and travel-related Spanish"
    },
    {
      "seq": 2,
      "describe_ch": "提升學生跨文化溝通與應對能力",
      "describe_en": "Enhance intercultural communication and adaptability"
    },
    {
      "seq": 3,
      "describe_ch": "透過情境模擬強化學生之實務表達與互動能力",
      "describe_en": "Strengthen practical speaking and interaction skills through situational tasks"
    }
  ],
