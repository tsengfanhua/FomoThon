    {
      "seq": 4,
      "describe_ch": "瞭解進階商管專業意涵與問題",
      "describe_en": "Understand the issue and problem of advanced business and management"
    },
    {
      "seq": 5,
      "describe_ch": "學生具備企業倫理與社會責任理解能力",
      "describe_en": "Students can apply corporate ethics and social responsibility."
