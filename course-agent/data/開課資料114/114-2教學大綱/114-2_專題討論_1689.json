  "description": {
    "sub_id3": null,
    "sub_name": "專題討論",
    "sub_ename": "SEMINAR",
    "describe_ch": "邀請學術界或業界知名人士配合本研究所2個研究領域（微機電系統工程學程、控制工程學程）來作專題演講與經驗交流，並在會後進行討論和意見交流，讓學生分享專家研究經驗與成果。",
    "describe_eh": "This is a time for the students to share their research experience in the fields of MEMS and control engineering, and to listen to the talks given by invited speakers from both inside and outside university. The professor in charge will give an introduction of every session or give an introduction to the invited speakers. Followed the session, there will be a Q&A session, such that students may exchange and share ideas by asking questions and discussion.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能透過專題演講或參加研討會理解最近相關領域的研究",
      "describe_en": "Comprehension for the latest development trend about relative study field by topical lectures or conferences."
    },
    {
      "seq": 2,
      "describe_ch": "能透過有關於論文研究的特定主題演講來增進工程分析能力",
      "describe_en": "Improve the analytical ability with the specific topic and related research about thesis."
    },
    {
      "seq": 3,
      "describe_ch": "能應用相關研究領域刊物的字彙與閱讀技巧完成確切之口語表達",
      "describe_en": "Apply vocabulary skills and analytical reading skills from related publications to the oral presentation."
    },
    {
      "seq": 4,
      "describe_ch": "培養溝通協調及團隊合作之能力。",
      "describe_en": "Develop the  ability of communication, coordination and teamwork."
    }
  ],
