  "description": {
    "sub_id3": null,
    "sub_name": "ESG/SDGS與AI融合：打造永續家園",
    "sub_ename": "INTEGRATING ESG/SDGS WITH AI: BUILDING A SUSTAINABLE HOME",
    "describe_ch": "本課程深入實際問題，重視真實數據的應用與動手實踐，讓學生能夠在解決地方永續發展議題的過程中學以致用。課程鼓勵學生運用開放數據，親自面對並分析在地實際的環保與能源挑戰，並透過線上平台的操作，增強數據處理與分析能力。\n結合人文關懷與藝術元素，學生將親自設計並執行環保推廣活動，運用人工智能技術提升活動效果，從中學習如何透過創新手法提升社區對環境保護的意識，同時融入人本價值。課程採用實踐學習的方法，結合理論與實務，鼓勵學生從解決本土問題出發，逐步擴展至全球視野，為永續家園的建設貢獻一份心力。",
    "describe_eh": "This course delves into practical problems, emphasizing the application of real data and hands-on practice, enabling students to apply their learning while addressing local sustainable development issues. The course encourages students to use open data, personally confront and analyze local actual environmental and energy challenges and enhance data processing and analytical skills through the use of online platforms.\n\nCombining humanitarian care with artistic elements, students will personally design and execute environmental promotion activities, employing artificial intelligence technology to enhance the effectiveness of these activities. Through this, they learn how to raise community awareness about environmental protection through innovative methods while integrating human-centered values. The course adopts a practice-based learning approach, merging theory with practical application, and encourages students to start by solving local issues and gradually expand their perspective to a global scale, contributing to the construction of a sustainable homeland.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過動手實作，利用開放數據與AI工具，提出在地永續發展策略。",
      "describe_en": "Through hands-on projects using open data and AI, develop local sustainability strategies."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生的批判性思維和創新能力，永續發展領域內尋求創新解決方案。",
      "describe_en": "Foster critical and innovative thinking in students to find creative solutions for sustainability."
    }
  ],
