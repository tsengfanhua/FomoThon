  "description": {
    "sub_id3": null,
    "sub_name": "量子計算與應用",
    "sub_ename": "APPLICATION OF QUANTUM COMPUTING",
    "describe_ch": "本課程旨在引導同學學習量子計算的相關知識，包括量子計算的發展、重要成果與應用、物理與數學基礎、量子邏輯閘、量子演算法，以及量子電路程式實作。",
    "describe_eh": "This course introduces students to the fundamental concepts of quantum computing, including its historical development, key milestones and applications, the physical and mathematical foundations, quantum logic gates and algorithms, as well as hands-on programming of quantum circuits.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解量子計算的發展與應用",
      "describe_en": "To understand the development and applications of quantum computing"
    },
    {
      "seq": 2,
      "describe_ch": "了解量子計算的理論基礎",
      "describe_en": "To understand the theoretical foundations of quantum computing"
    },
    {
      "seq": 3,
      "describe_ch": "能夠實作量子電路程式",
      "describe_en": "To be able to implement quantum circuit programs"
    }
