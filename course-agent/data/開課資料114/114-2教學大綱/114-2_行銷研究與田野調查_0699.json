  "description": {
    "sub_id3": null,
    "sub_name": "行銷研究與田野調查",
    "sub_ename": "MARKETING RESEARCH AND FIELD SURVEY",
    "describe_ch": "認識行銷研究的方法與步驟，獨力執行行銷研究。課程內如包括研究主題的設定、文獻蒐集與閱讀、研究架構的擬定、研究資料的蒐集、資料分析與歸納、研究報告的撰寫。課程著重量化行銷研究的問卷製作，運用EXCEL之統計分析功能與SPSS統計軟體，分析研究資料，輔以質性研究的訪談與田野調查，完成研究報告。期末研究報告可用於申請研究所或科技部大專學生研究計畫，亦可有助於業界行銷實務工作能力。",
    "describe_eh": "The purpose of this course is to train students how to reduce the risk of decision-making by using marketing research methods. Marketing research can be applied in all aspects of marketing mix and it also plays an important crucial role in the process of developing marketing strategy. Marketing research uses primary and secondary data in many case studies and help to do specific researches for companies and marketing research centre.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用行銷研究工具與田野調查實務來檢視市場與消費者行為",
      "describe_en": "Apply marketing research and fieldwork survey to examine Market and consumer."
    },
    {
      "seq": 2,
      "describe_ch": "應用行銷研究規劃來撰寫行銷研究報告書",
      "describe_en": "Apply marketing research planning to design marketing research report."
    }
  ],
