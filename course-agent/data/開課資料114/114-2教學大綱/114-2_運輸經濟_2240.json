  "description": {
    "sub_id3": null,
    "sub_name": "運輸經濟",
    "sub_ename": "TRANSPORTATION ECONOMICS ANALYSIS",
    "describe_ch": "本課程旨在使學生了解適用運輸產業經濟特性的重要模型與現況實務，其內容包括旅客需求、運輸業生產成本函數、運輸市場競爭特性、運輸業管制等課題。",
    "describe_eh": "This course is designed to help students understand the important economic models and practices, which are suitable for describing the economic characteristics of transportation industries. The course covers the topics of transportation demand, transportation cost function, competition in transportation markets, regulations and efficiency in transportation, …etc.",
    "pre_subname": "ECON1001經濟學(一)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "5.教授各運輸或物流系統之營運、企業經營管理之理論及實務概念",
      "describe_en": "5. Provide students with knowledge of the theories and practices of operations and business management in transportation and logistics systems."
    },
    {
      "seq": 2,
      "describe_ch": "8.培養學生運用資料調查、數據分析或數學模型分析運輸或物流問題之能力",
      "describe_en": "8. Develop students' ability to analyze transportation and logistics problems using data collection, data analysis, or mathematical models."
    }
  ],
