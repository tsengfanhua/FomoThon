  "description": {
    "sub_id3": null,
    "sub_name": "保險科技與人工智慧應用",
    "sub_ename": "APPLICATIONS ON INSURTECH AND ARTIFICIAL INTELLIGENCE",
    "describe_ch": "本課程旨在使學習者對於金融服務業在保險科技與人工智能運用的概念與原理有所基本瞭解。因此，本課程將以科技/創新管理的角度，進一步探究金融服務業如何運用保險科技與人工智能運用為專業知識持續創造競爭優勢。學習者將透過課程的活動、案例與練習等學習工具，深化對金融服務業在保險科技與人工智能運用的瞭解，促使創新新的金融服務發展。",
    "describe_eh": "This course is intended to introduce the concepts and principles for effective InsurTech and artificial intelligence (AI) that is becoming the crucial competitive advantages for the knowledge-intensive business in financial industry from the concepts of R&D /innovation management. The course will introduce a number of related cases and exercises with a view to bridge the national, industrial and corporate InsurTech /AI activities, along with the presentation of selected approaches, methods, tools and try to make the learners to innovate new financial services.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "以理論為基礎，理解金融業在保險科技與人工智能的運作機制",
      "describe_en": "To understand the mechanism of InsurTech and AI in the finance system through solid theoretical foundation."
    },
    {
      "seq": 2,
      "describe_ch": "具備創新管理，結合新領域的能力",
      "describe_en": "To acquire the ability to innovate, integrate, and develop new research areas"
    },
    {
      "seq": 3,
      "describe_ch": "具備團隊合作的精神，有效溝通的能力",
      "describe_en": "To develop teamwork spirit, to acquire the ability to communicate effectively"
    }
  ],
