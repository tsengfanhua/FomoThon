  "description": {
    "sub_id3": null,
    "sub_name": "會計學(二)",
    "sub_ename": "ACCOUNTING(2)",
    "describe_ch": "本課程介紹基本會計學原則及觀念，主要包括：應收帳款、存貨、長期性資產取得及折舊、公司會計、投資、負債、現金流量表及財務報表分析。\r\n",
    "describe_eh": "This course introduces basic accounting principle and concepts. The main topics include receivable, inventory, plant assets acquisition and depreciation, corporate accounting, investment, liabilities, statement of cash flows and financial statements analysis。",
    "pre_subname": "ACCT1011會計學(一)",
    "pre_sub_id3": "ACCT1011",
    "pre_sub_ename": "ACCT1011 ACCOUNTING(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 19,
      "describe_ch": "1.能知道會計學(二)涵蓋的主要內容及描述現代企業的財務報表及其限制。",
      "describe_en": "1.Knowledge for the content of Accounting I and modern business financial statements and their limitations."
    },
    {
      "seq": 20,
      "describe_ch": "2.能理解可應用會計學原理的情況。",
      "describe_en": "2.Comprehension for the application accounting principle situation.　"
    }
  ],
