  "description": {
    "sub_id3": null,
    "sub_name": "災害管理理論與實務",
    "sub_ename": "THE THEORY AND PRACTICE OF DISASTER MANAGEMENT",
    "describe_ch": "因應台灣特殊的地理環境與極端氣候所帶來的災害的，災害防救的課題成了目前致力發展的重點。有鑒於此，本課程的學習目標，是建立修課同學的災害防救基本概念與操作，包含災害的成因、災害的管理、防救災體系的認識以及災害防救資訊的整合等。",
    "describe_eh": "\nDue to the disasters induced by the special characteristics of Taiwan natural environment and the extreme climate,, disaster prevention and protection has been brought to public attention. In view of this, the purpose of this course is to introduce the basic knowledge and practical application for disasters prevention. It includes the cause of disasters, the management of disaster prevention, the development of disaster management system and the integration of disaster prevention information.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解並說明災害的成因。",
      "describe_en": "Students can understand and explain the cause of disasters."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明災害管理的程序。",
      "describe_en": "Students can understand and explain the procedure of disaster management."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解防救災體系的發展過程。",
      "describe_en": "Students can understand the types and development of disaster management system."
    },
    {
      "seq": 4,
      "describe_ch": "能運用整合的災害防救資訊於防災的議題上。",
      "describe_en": "Students can apply the integrated information of disaster prevention and protection to disaster management issues."
    }
  ],
