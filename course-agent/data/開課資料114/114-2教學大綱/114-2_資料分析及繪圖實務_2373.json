  "description": {
    "sub_id3": null,
    "sub_name": "資料分析及繪圖實務",
    "sub_ename": "PRACTICAL DATA ANALYSIS AND VISUALIZATION",
    "describe_ch": "本課程使用免費軟體進行實務資料之分析及繪圖，除了介紹R程式語言及其基本統計分析功能，同時以R程式及Highcharts網頁程式進行繪圖應用，可提高學生資料處理、呈現及解讀之靈活度。",
    "describe_eh": "This course use free software to analyze data and plotting. R language with basic statistical methods is first introduced. Moreover, practical data plotting is performed by R and Highcharts so that students can be more familiar to data analysis, presentation, and interpretation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解基本的程式語言以及統計分析方法",
      "describe_en": "Comprehension of programming language and basic statistical techniques"
    },
    {
      "seq": 2,
      "describe_ch": "應用R程式及Highcharts網頁程式進行繪圖並解讀",
      "describe_en": "Application of R software and Highcharts tools in data visualization and interpretation"
    }
