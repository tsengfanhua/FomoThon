  "description": {
    "sub_id3": null,
    "sub_name": "流體力學",
    "sub_ename": "FLUID MECHANICS",
    "describe_ch": "本課程旨在介紹流體靜止與運動時之行為。內容包括流體之性質、流體靜力學、運動學及動力學。還涉及流體流動之理論分析方法、因次分析及模型試驗。在課程之後部，則論及管中黏性流、浸沒物體之外部流及明渠流等。",
    "describe_eh": "This is an introduction course in which the behavior of fluids at rest and in motion is to be presented and explored. The contents include those aspects of fluid properties, fluid statics, fluid kinematics, and fluid dynamics. Also addressed are the theoretical analysis of fluid flow, dimensional analysis and modeling. After the discussion of the fundamentals, topics of viscous flow in pipes, flow over immersed bodies and open channel flow are to be covered.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、PHYS1005普通物理(一)、PHYS1006普通物理(二)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、PHYS1005 GENERAL PHYSICS(1)、PHYS1006 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解流體力學之基本概念與原理。",
      "describe_en": "To understand the basic concepts and principles of fluid flow."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉解析流體力學問題之數學工具。",
      "describe_en": "To be familiar with the mathematical tools for analyzing fluid flow."
    },
    {
      "seq": 3,
      "describe_ch": "能應用於解決實際流力問題。",
      "describe_en": "To develop the ability of solving practical problems of fluid flow."
    }
  ],
