  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "XA01101",
    "sub_id": "97204",
    "scr_dup": "002",
    "sub_title": "日本文化、跨文化溝通",
    "sub_title_en": null,
    "sub_describe": "透過理解日本文化的文本拓展到看世界文化，並且回到自身觀點",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "日本文化",
    "sub_ename": "JAPANESE CULTURE",
    "describe_ch": "本課程介紹了日本文化和習俗的各個方面，以激發學生學習日語的興趣。主要有兩個主題：一個是現代日本文化，另一個是歷史和傳統文化。儘管我們談論的是現代日本文化，但日本的每個地區在歷史上都是獨立的，即使在今天，每個地區也有自己的差異。在本課程中，我們還將介紹日本各地區的特點。有關歷史和傳統文化，日本歷史已被納入流行文化，如漫畫、動漫和電子遊戲，不僅在老年人中，而且在日本年輕人中也非常受歡迎。通過介紹日本文化的這些魅力，我們不僅要加深學生對日本歷史和傳統文化的理解，還要促進他們對日本流行文化的興趣，鼓勵他們在課外學習日語。\r\n",
    "describe_eh": "This course introduces various aspects of Japanese culture and customs to motivate students to learn Japanese. There are two main topics: one is modern Japanese culture, and the other is history and traditional culture. Even though we are talking about modern Japanese culture, each region of Japan has historically been independent, and even today, each region has its own differences. In this course, we will also introduce the characteristics of each region of Japan. History and traditional culture: Japanese history has been incorporated into pop culture such as manga, anime, and video games, and is very popular not only among the elderly but also among Japanese youth. By introducing these attractions of Japanese culture, we aim to not only deepen students' understanding of Japanese history and traditional culture, but also to promote their interest in Japanese pop culture and encourage them to study Japanese outside the classroom.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
