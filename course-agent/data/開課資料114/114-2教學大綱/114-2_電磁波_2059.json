  "description": {
    "sub_id3": null,
    "sub_name": "電磁波",
    "sub_ename": "ELECTROMAGNETIC WAVE",
    "describe_ch": "隨著無線通信技術與應用的發展，學生應對相關領域的技術能力與要求具有基本的了解能力，本課程介紹的電磁波即是電磁場的變化，與電磁學課程所涵蓋之空間靜電場及靜磁場不同的是：在電磁波中必須將時間的因素加以考慮；這也使得電磁波的觀念與應用在追求無線行動與高速傳輸的光纖通訊現代文明日益重要。",
    "describe_eh": "Since interest and applications of wireless communications are booming, the students should respond to the demand with technical capability from the field. This course covers the time-varying EM field and electromagnetic wave, including issues of time-varying effect on EM field. We will utilize the concept of EM wave to the applications on wireless mobile communications and high-speed data optical fiber communications.",
    "pre_subname": "COME2010電磁學(一)、COME2011電磁學(二)",
    "pre_sub_id3": "COME2010",
    "pre_sub_ename": "COME2010 ELECTROMAGNETICS(1)、COME2011 ELECTROMAGNETICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂電磁波：能夠描述重要的電磁波種類及其特性；能夠描述影響電磁波的重要環境影響因素，能瞭解並說明電磁波在目前的 社會生活及經濟層面的重要性及影響",
      "describe_en": "Define EM wave with their own words: Be able to describe EM wave and their characteristics; be able to describe important environmental factors impacting EM wave. Understand and be able to explain the importance and effects of EM wave to society life and"
    },
    {
      "seq": 2,
      "describe_ch": " 能辨識出可應用電磁波的場合，並能清楚表達，能使用相關原理，規劃一評估電磁波應用及其限制的相關分析，並由分析中歸納出適當結論",
      "describe_en": "Be able to use related principles to plan an evaluation about measuring EM wave's capability and limitation, and draw appropriate conclusions from analysis."
    },
    {
      "seq": 3,
      "describe_ch": "知道於何處可找到電磁波的相關資訊、研究結果及標準，並可評估所獲資訊的適用性，能利用電磁波的原理，評估一產品或系統，並提出可行驗證方法",
      "describe_en": "Know where to locate and access related EM wave information, research, as well as standards, and be able to evaluate the appropriateness of the obtained information."
    },
    {
      "seq": 4,
      "describe_ch": "能針對一特定有關電磁波的議題或情境，設計一合理模擬，加以驗證，並適切歸納出結論，能以書面或口頭方式將所獲結果與同儕、助教及教師溝通",
      "describe_en": "Communicate results in written or oral form to classmates, teaching assistants, and the instructor."
    }
  ],
