  "description": {
    "sub_id3": null,
    "sub_name": "雲端大數據分析與應用",
    "sub_ename": "CLOUD-BASED BIG DATA ANALYTICS AND APPLICATIONS",
    "describe_ch": "本課程聚焦於雲端環境下的大數據分析流程與應用，介紹資料蒐集、儲存、處理與分析的基本架構。學生將學習如何運用雲端平台進行資料管線建置、資料分析與視覺化，並理解大數據技術在商業、金融、智慧城市與管理決策中的實際應用情境。課程強調雲端資料分析的整體流程與應用思維，培養學生以數據支持決策的能力。",
    "describe_eh": "This course focuses on big data analytics processes and applications in cloud environments, introducing the fundamental architecture for data collection, storage, processing, and analysis. Students will learn how to build data pipelines, perform data analytics, and create visualizations using cloud platforms, while gaining an understanding of real-world applications of big data technologies in business, finance, smart cities, and management decision-making. The course emphasizes end-to-end cloud-based data analytics workflows and application-oriented thinking, cultivating students’ ability to support decision-making through data-driven insights.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習雲端大數據分析的基本概念與資料處理流程",
      "describe_en": "To learn the fundamental concepts and data processing workflows of cloud-based big data analytics"
    },
    {
      "seq": 2,
      "describe_ch": "操作雲端平台進行資料蒐集、分析與視覺化應用",
      "describe_en": "To apply cloud platforms for data collection, analysis, and visualization"
    },
    {
      "seq": 3,
      "describe_ch": "透過分組專題進行雲端資料分析應用實作",
      "describe_en": "To conduct cloud-based data analytics projects through team collaboration"
    },
    {
      "seq": 4,
      "describe_ch": "分析大數據與雲端技術於商業與管理決策中的應用價值",
      "describe_en": "To analyze the value of cloud-based big data analytics in business and managerial decision-making"
    }
  ],
