  "description": {
    "sub_id3": null,
    "sub_name": "安全程式設計",
    "sub_ename": "SECURE CODING",
    "describe_ch": "本課程介紹如何撰寫安全程式的基礎觀念與實務，利用範例程式的弱點分析讓同學了解不當的程式寫法如何導致不安全的軟體，同時學習安全程式設計的規範。修課同學也將透過實驗與專題的程式寫作驗證課堂所講授的知識。",
    "describe_eh": "THIS COURSE INTRODUCES THE FUNDAMENTAL CONCEPTS AND PRACTICE OF SECURE PROGRAMMING. BY EXPLAINING THE VULNERABILITIES OF EXAMPLE CODES, STUDENTS WILL UNDERSTAND HOW PROGRAMMING ERRORS CAN LEAD TO INSECURE SOFTWARE, AND LEARN THE RULES OF WRITING SECURE CODES. THE COURSE WILL ALSO INCLUDE HANDS-ON LABS AND TERM PROJECTS FOR THE STUDENTS TO PUT THE KNOWLEDGE ABOUT SECURE CODING INTO PRACTICE.",
    "pre_subname": "IECS3042網路程式設計、IEE1000計算機概論(一)、IEE1001計算機概論(二)、IECS1001計算機概論與實習(I)、IECS1002計算機概論與實習(II)",
    "pre_sub_id3": "IECS3042",
    "pre_sub_ename": "IECS3042 NETWORK PROGRAMMING、IEE1000 INTRODUCTION TO COMPUTER(1)、IEE1001 INTRODUCTION TO COMPUTER(2)、IECS1001 INTRODUCTION TO COMPUTER SCIENCE AND ITS PRACTICE(I)、IECS1002 INTRODUCTION TO COMPUTER SCIENCE AND ITS PRACTICE(II)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解各種程式資安漏洞發生原因與攻擊手法",
      "describe_en": "COMPREHENSION OF THE THEORY BEHIND THE VULNERABILITIES OF PROGRAMS AND THEIR CORRESPONDING ATTACKING TECHNIQUES"
    },
    {
      "seq": 2,
      "describe_ch": "學習安全程式撰寫原則與檢測方法",
      "describe_en": "KNOWLEDGE ABOUT THE RULES FOR SECURE CODING AND THE VERIFICATION METHODS"
    },
    {
      "seq": 3,
      "describe_ch": "應用安全程式撰寫原則與檢測方法於專題實作",
      "describe_en": "APPLICATION OF THE SECURE CODING RULES AND VERFICATION METHODS TO REAL PROJECTS"
    }
  ],
