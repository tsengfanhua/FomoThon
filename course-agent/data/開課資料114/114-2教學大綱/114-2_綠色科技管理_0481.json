  "description": {
    "sub_id3": null,
    "sub_name": "綠色科技管理",
    "sub_ename": "GREEN TECHNOLOGY MANAGEMENT",
    "describe_ch": "本課程探討綠色科技在企業與社會中的應用，聚焦循環經濟、碳足跡管理與再生能源，結合理論與案例分析，培養學生理解科技管理如何推動永續發展與淨零轉型。課程將透過討論、研究與專題實作，培養跨領域分析與解決問題的能力。",
    "describe_eh": "This course examines the applications of green technologies in business and society, focusing on the circular economy, carbon footprint management, and renewable energy. By integrating theories with case studies, it helps students understand how technology management drives sustainable development and the net-zero transition. Through discussions, research, and project-based practice, students will develop interdisciplinary analytical and problem-solving skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生能運用科技管理與永續發展理論，分析循環經濟、碳管理與再生能源案例。",
      "describe_en": "Students will be able to apply theories of technology management and sustainable development to analyze cases related to the circular economy, carbon management, and renewable energy."
    },
    {
      "seq": 2,
      "describe_ch": "學生能整合管理、科技與永續觀點，提出創新解決方案。",
      "describe_en": "Students will be able to integrate perspectives of management, technology, and sustainability to propose innovative solutions."
    }
  ],
