  "description": {
    "sub_id3": null,
    "sub_name": "雷射與光子學導論",
    "sub_ename": "INTRODUCTION TO LASER & PHOTONICS",
    "describe_ch": "本課程介紹光的產生，傳播與接收原理。內容涉及雷射與光電元件（包含光通訊元件）的基本原理及其應用。課程中將運用講授，習作與示範等，使學生能學習到雷射的原理及光在介質傳播的特性。",
    "describe_eh": "This course intends to introduce principles of generation, propagation and detection of light, as well as the fundamental principles of lasers and photonics elements (including optical communication elements). Students will learn above subjects through lectures, exercises and demonstrations in the course.",
    "pre_subname": "OPT2001光學(一)、OPT2002光學(二)、PHYS2001電磁學(一)、PHYS2002電磁學(二)、PHYS3001量子力學導論",
    "pre_sub_id3": "OPT2001",
    "pre_sub_ename": "OPT2001 OPTICS (1)、OPT2002 OPTICS (2)、PHYS2001 ELECTROMAGNETICS(1)、PHYS2002 ELECTROMAGNETICS(2)、PHYS3001 INTRODUCTION TO QUANTUM MECHANICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠描述光子學與雷射的名詞與內涵。",
      "describe_en": "Be able to describe the glossary and the content of photonics and laser."
    },
    {
      "seq": 2,
      "describe_ch": "能描述雷射的產生與特性，及理解光在介質中傳播與光偵測的作用原理。",
      "describe_en": "Be able to describe the generation and the characteristics of laser, and comprehend principles of light propagation in the medium as well as the operation of light detection."
    },
    {
      "seq": 3,
      "describe_ch": "能熟悉光電元件，並應用於包含光通訊系統在內的實際光學系統。",
      "describe_en": "Be familiar with photonic elements, and can apply them to practical optical systems."
    },
    {
      "seq": 4,
      "describe_ch": "能利用圖書館及網路資源查詢理解光子學與雷射相關辭彙與內涵及國際最新進展。",
      "describe_en": "Be able to use the internet and library resources to investigate the glossary, content and recent development of photonics and laser."
    }
  ],
