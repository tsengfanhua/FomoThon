  "description": {
    "sub_id3": null,
    "sub_name": "表演溝通與傳達",
    "sub_ename": "ACTING COMMUNICATION AND DELIVERY",
    "describe_ch": "不論透過影像或是真人的溝通，皆須要聆聽別人的聲音與需要，找到適合的方式傳達出來的訊息，據此進行下一步有效溝通。本課旨在從個人的聲音、肢體、反應、姿態及說故事的方式來表達與傳遞想法進而建立與觀眾的關係。\r\n",
    "describe_eh": "No matter through video or real-person communication, it is necessary to listen to other people’s voices and needs, find a suitable way to convey the message, and then communicate effectively in the next step. This class aims to express and convey ideas through personal voice, body, reaction, gesture, and storytelling. After that establish a relationship and connection with the audience.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
