  "description": {
    "sub_id3": null,
    "sub_name": "土地法(二)",
    "sub_ename": "LAND LAW(2)",
    "describe_ch": "土地法第二部課程重點集中於土地利用管制之機制，由於此部分涉及公法，學生應具備憲法及行政法基本課程訓練。核心課程為區域與都市計畫。",
    "describe_eh": "This is the part 2 course of land law and concepted for students in their 2nd years summer semester. The course has its key points in the system of control mechanism for land using and -usage. It requires knowledge about the protection of estate under constitutional and administrational. The regional and urban plans will be the most important parts of this course.",
    "pre_subname": "LAND1005中華民國憲法、LAND1006民法概要(一)、LAND1007民法概要(二)",
    "pre_sub_id3": "LAND1005",
    "pre_sub_ename": "LAND1005 CONSTITUTION OF THE R.O.C.、LAND1006 INTRODUCTION TO CIVIL LAW(1)、LAND1007 INTRODUCTION TO CIVIL LAW(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "協助學生瞭解空間法制之基本原理",
      "describe_en": "Help the students to build up their theoretical knowledge basis about spatial (land) laws."
    },
    {
      "seq": 2,
      "describe_ch": "協助學生瞭解現行土地相關法制",
      "describe_en": "To assist students in understanding the contents of current land laws in Taiwan."
    },
    {
      "seq": 3,
      "describe_ch": "協助學生建立實務土地法問題之解決能力",
      "describe_en": "Build up the capability of students by solving the land law problems und conflicts."
    }
  ],
