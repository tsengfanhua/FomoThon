  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(二)",
    "sub_ename": "ENGINEERING MATHEMATICS(2)",
    "describe_ch": "教導學生解決工程及應用科學中相關問題所需之基礎數學。課程內容主要涵蓋向量微積分學、傅利葉級數及偏微分方程式。",
    "describe_eh": "This course aims to teach students the fundamental mathematics for solving engineering and applied science related problems. The course content mainly contains vector calculus, Fourier series and partial differential equations.",
    "pre_subname": "MATH1001微積分(一)、MATH1005微積分(一)、MATH1002微積分(二)、MATH1006微積分(二)、MATH1001P微積分(一)實習",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1005 CALCULUS(1)、MATH1002 CALCULUS(2)、MATH1006 CALCULUS(2)、MATH1001P RECITATION OF CALCULUS (1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解微分方程式之級數解、拉普拉斯轉換、傅立葉積分和偏微分方程。",
      "describe_en": "Be able to realize the series solutions of the differentia equation, the Laplace Transforms, the Fourier integration and the partial differential equations."
    },
    {
      "seq": 2,
      "describe_ch": "能說明微分方程式之級數解、拉普拉斯轉換、傅立葉積分和偏微分方程。",
      "describe_en": "Be able to illustrate the series solutions of the differentia equation, the Laplace Transforms, the Fourier integration and the partial differential equations."
    },
    {
      "seq": 3,
      "describe_ch": "能運算出微分方程式之級數解、拉普拉斯轉換、傅立葉積分和偏微分方程。",
      "describe_en": "Be able to operate the series solutions of the differentia equation, the Laplace Transforms, the Fourier integration and the partial differential equations."
    },
    {
      "seq": 4,
      "describe_ch": "能分析微分方程式之級數解、拉普拉斯轉換、傅立葉積分和偏微分方程。",
      "describe_en": "Be able to analyze the series solutions of the differentia equation, the Laplace Transforms, the Fourier integration and the partial differential equations."
    }
  ],
