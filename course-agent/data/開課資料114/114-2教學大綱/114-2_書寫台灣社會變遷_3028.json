  "description": {
    "sub_id3": null,
    "sub_name": "書寫台灣社會變遷",
    "sub_ename": "WRITING OF SOCIAL CHANGES IN TAIWAN",
    "describe_ch": "透過閱讀不同時期的台灣文學作品，討論「現代性」這個議題的影響。探詢不同時空下，台灣這塊土地的知識份子，如何看待與世界接軌這一項議題。\n藉由理解過去在這塊土地生存的人們，是以何種視野看待世界，從而理解這些不同的角度是如何影響現在我們面對事物的觀點。\n",
    "describe_eh": "Through reading Taiwanese literature from different periods, we discuss the impact of the topic of modernity to explore the views of Taiwanese intellectuals on the issue of connecting with the world in different time and space and understand how people who lived on this land in the past saw the world, and how these different perspectives affected the way we face things now.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "思考先民如何看待現代性與本土化",
      "describe_en": " In the history of Taiwan ,Conflict between localization and modernity"
    },
    {
      "seq": 2,
      "describe_ch": "培養獨立思考能力，重新認識全球化",
      "describe_en": "Rethink globalization"
    }
  ],
