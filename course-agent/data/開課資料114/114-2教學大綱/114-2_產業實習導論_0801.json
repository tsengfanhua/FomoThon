  "description": {
    "sub_id3": null,
    "sub_name": "產業實習導論",
    "sub_ename": "INTRODUCTION TO INDUSTRY INTERNSHIP",
    "describe_ch": "本課程為實習的職前教育，運用講座、研習或其他創新教學活動方式，以協助學生建立正確的職場實習態度。課程內容包含職場倫理與態度、實習之權利義務說明等職前訓練，以及實習公司的業務介紹等，使學生了解企業之背景及工作目標，做為選擇合適的實習企業之參考。",
    "describe_eh": " Students will learn proper work attitude in this course, in order to better prepare for an internship program.  In addition, the course covers work ethics, the rights and obligations of the internship, and an introduction to job specifications of participating businesses such that students have necessary information to help them decide where to do their internship.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生瞭解企業實習的意義與價值",
      "describe_en": "Students understand the meaning and value of an internship program."
    },
    {
      "seq": 2,
      "describe_ch": "使學生瞭解產業發展、企業倫理、與相關職場態度",
      "describe_en": "Students understand the development of industry, work ethics and professionalism."
    },
    {
      "seq": 3,
      "describe_ch": "讓學生學習面對企業求才時的履歷撰寫與面試技巧",
      "describe_en": "Students learn curriculum vitae writing and interview skills."
    },
    {
      "seq": 4,
      "describe_ch": "讓企業藉由課堂上的介紹使學生瞭解企業背景與工作目標",
      "describe_en": "Students understand job specifications and requirements."
    }
  ],
