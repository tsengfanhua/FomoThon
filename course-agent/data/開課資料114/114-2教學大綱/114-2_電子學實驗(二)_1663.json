  "description": {
    "sub_id3": null,
    "sub_name": "電子學實驗(二)",
    "sub_ename": "ELECTRONICS LAB.(2)",
    "describe_ch": "電子學實驗(二)著力於探討電子電路實務應用實作分析。電子電路設計分析訓練步驟為瞭解電路結構、選擇元件、分析應用電路模型、完成應用專題製作、評估系統規格。培養學生具有電子電路應用專題的實作技術與能力。",
    "describe_eh": "Electronics Experiment (2) focuses on the analysis of the practical application of electronic circuits. The steps of electronic circuit design analysis training are to understand the circuit structure, select components, analyze and apply circuit models, complete application project production, and evaluate system specifications. Cultivate students with practical skills and abilities on the topic of electronic circuit applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.瞭解各種電子實驗設備之基本功能與知識",
      "describe_en": "1.Understanding the basic function and knowledge of various electronic instruments."
    },
    {
      "seq": 2,
      "describe_ch": "2.理解各種電子實驗設備之工程原理",
      "describe_en": "2.Comprehension for the engineering principle of various electronic instruments."
    },
    {
      "seq": 3,
      "describe_ch": "3.應用各種電子實驗設備完成電子電路之測試與設計",
      "describe_en": "3.Application for the electronic instruments to circuit testing and design."
    },
    {
      "seq": 4,
      "describe_ch": "4.運用電子電路分析軟體完成電子電路之特性分析",
      "describe_en": "4. Apply the circuits simulation tool box to circuits characteristic analysis."
    }
  ],
