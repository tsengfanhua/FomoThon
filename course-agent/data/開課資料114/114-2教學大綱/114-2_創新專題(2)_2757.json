  "description": {
    "sub_id3": null,
    "sub_name": "創新專題(2)",
    "sub_ename": "INNOVATION PROJECT (2)",
    "describe_ch": "In the Innovation Project 1 and 2 (Design-driven Innovation 1 and 2) course, students develop research skills that support an innovation mindset and the competencies required to implement a design-driven innovation process. During this course, students are introduced to innovation theories and useful frameworks that explain the incremental and radical innovation of products, services, and experiences. Students then learn to explore the socio-cultural contexts and factors that underlie a design situation to frame a problem to solve or a potential opportunity, and create a design approach that leads to true novelty. To achieve this, students work in teams to conduct crucial design research, develop and communicate a design framework, prototype the proposed innovation, and produce a video depicting the innovation’s benefits in context.",
    "describe_eh": "In the Innovation Project 1 and 2 (Design-driven Innovation 1 and 2) course, students develop research skills that support an innovation mindset and the competencies required to implement a design-driven innovation process. During this course, students are introduced to innovation theories and useful frameworks that explain the incremental and radical innovation of products, services, and experiences. Students then learn to explore the socio-cultural contexts and factors that underlie a design situation to frame a problem to solve or a potential opportunity, and create a design approach that leads to true novelty. To achieve this, students work in teams to conduct crucial design research, develop and communicate a design framework, prototype the proposed innovation, and produce a video depicting the innovation’s benefits in context.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 17,
      "describe_ch": "Students understand design-driven innovation theory and learn to implement an effective design-driven innovation process.",
      "describe_en": "Students understand design-driven innovation theory and learn to implement an effective design-driven innovation process."
    },
    {
      "seq": 18,
      "describe_ch": "Students comprehend a prescribed design situation by framing and reframing the conceptual lens through which they interpret information generated by design research",
      "describe_en": "Students comprehend a prescribed design situation by framing and reframing the conceptual lens through which they interpret information generated by design research"
    },
    {
      "seq": 19,
      "describe_ch": "Students apply communication skills in multidisciplinary design teams to collaborate effectively in response to a prescribed design situation.",
      "describe_en": "Students apply communication skills in multidisciplinary design teams to collaborate effectively in response to a prescribed design situation."
    },
    {
      "seq": 20,
      "describe_ch": "Students exercise practical design research skills and interpret design research effectively to analyse the socio-cultural contexts and factors that underlie a design situation.",
      "describe_en": "Students exercise practical design research skills and interpret design research effectively to analyse the socio-cultural contexts and factors that underlie a design situation."
    }
  ],
