  "description": {
    "sub_id3": null,
    "sub_name": "風險評估",
    "sub_ename": "RISK ASSESSMENT",
    "describe_ch": "本課程介紹風險管理概念與風險管理流程，分析與評估財產、責任與人身風險。進一步介紹風險預測，同時引入現金流量分析法來進行風險評估。",
    "describe_eh": "This course introduce the concept and process of risk management. The content includes assess the property, liability and personal loss exposures. Furthermore, we introduce forecasting and apply the cash flow analysis method to assess risks.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用專業知識來解決企業與家庭風險管理與保險的問題",
      "describe_en": "To apply the professional knowledge to solve the problems related to the risk management and insurance in enterprise and household"
    }
  ],
