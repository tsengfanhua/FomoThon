  "description": {
    "sub_id3": null,
    "sub_name": "建築設計(四)",
    "sub_ename": "ARCHITECTURAL DESIGN(4)",
    "describe_ch": "承接建築設計(三)之設計訓練，透過 1)設計概念、創作及操作；2)空間元素、形式及材質分析；3)抽象設計概念與實質環境關聯之初探；4)模型操作與圖面繪製之表達技能，再藉由簡單機能與行為活動之建築空間設計，訓練學生建構設計概念，尋求自我對真實空間之解讀與操作，且擁有詮釋空間氛圍與情境的形態邏輯或設計語法，以對空間概念的表達能具體呈現。",
    "describe_eh": "This is a continuous course of Architectural Design Ⅲ. Student's projects will be emphasized on 1) conceptualization, planning and model making; 2) analyzing the design elements: materials, spaces and forms; 3)  examining the connections between design principles and natural environment; 4) enhancing graphic and verbal communication skills. There are at least four exercise projects which will equip  students with following capabilities : concept formulation, analysis of space function and activities, design interpretation, design methodologies, and design communication through 2-D and 3-D techniques.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
