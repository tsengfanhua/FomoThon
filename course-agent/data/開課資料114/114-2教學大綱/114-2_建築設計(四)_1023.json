      "seq": 2,
      "describe_ch": " 能理解空間情境與本質之思考與表達",
      "describe_en": "Comprehension for the thinking and representing the essence and sensation of the space."
    },
    {
      "seq": 3,
      "describe_ch": " 能應用圖面與模型表達建築設計成果",
      "describe_en": "Application for the graphic drawing and model object to present the works of architectural design."
    },
    {
      "seq": 4,
      "describe_ch": "能分析建築設計中較複雜課題",
      "describe_en": "Capacity to analysis the complexity issues in overall design."
    }
  ],
