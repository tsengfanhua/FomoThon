  "description": {
    "sub_id3": null,
    "sub_name": "現代公民與社會實踐",
    "sub_ename": "MODERN CITIZENSHIP AND SOCIAL PRACTICE",
    "describe_ch": "本課程旨在培養學生兼備人文素養、道德情操、正確價值觀，同時理解自由、平等、民主、法治的真諦，成為一位關懷人民、社會、國家，以其所學付諸實踐的現代公民。",
    "describe_eh": "The course aims to cultivate students with humanistic qualities, moral character, and correct values while understanding the true meaning of freedom, equality, democracy and the rule of law. The goal is for them to become modern citizens who care for the people, the societies, and the countries and put what they have learned into practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "提升人文素養與道德情操，理解自由、平等、民主、法治的真諦。",
      "describe_en": "To enhance humanistic qualities and moral character, and understand the true meaning of freedom, equality, democracy, and the rule of law."
    },
    {
      "seq": 2,
      "describe_ch": "培養正確的價值觀，同時具備履行社會責任的能力。",
      "describe_en": "To possess correct values and the ability to fulfill social responsibilities."
    }
  ],
