  "description": {
    "sub_id3": null,
    "sub_name": "證券投資學",
    "sub_ename": "SECURITIES  INVESTMENT",
    "describe_ch": "介紹證券市場的交易制度與投資人的行為，協助學生建立基本分析與技術分析的能力，從而在特定的時間，對合理的股價有基本的認識，並協助學生建立基本的投資組合的能力。",
    "describe_eh": "The trading system and legal requirements of TSE and behavior of investors in Taiwan will be introduced in this course. Students will learn to understand the market, to estimate the value of the firm, to time the market by technical analysis and to build a reasonable portfolio. Every student needs to present the valuation of a firm in TSE to show their abilities either in financial statements and industry analysis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
