  "description": {
    "sub_id3": null,
    "sub_name": "高頻電路設計",
    "sub_ename": "RADIO FREQUENCY CIRCUIT DESIGN",
    "describe_ch": "高頻電路設計課程是針對發射與接收電路中之射頻功率放大器,微帶電路,濾波器及相位鎖定迴路之基本原理及設計方法加以講述及進行性能之分析",
    "describe_eh": "The purpose of radio frequency circuit design is focused to describe the basic principle, design method and performance analysis of the radio frequency amplifier, microstrip circuit, filters and phase-Locked loop.",
    "pre_subname": "COME2002電子學(一)、COME2010電磁學(一)、COME3005高頻及微波電路概論",
    "pre_sub_id3": "COME2002",
    "pre_sub_ename": "COME2002 ELECTRONICS(1)、COME2010 ELECTROMAGNETICS(1)、COME3005 INTRODUCTION TO RADIO FREQUENCY AND MICROWAVE CIRCUIT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能具備分析設計高頻及微波電路的基本知識。",
      "describe_en": "Be able to obtain basic knowledge about analysis and design of radio frequency and microwave circuits."
    },
    {
      "seq": 2,
      "describe_ch": "能運用模擬軟體進行高頻及微波電路的分析。　",
      "describe_en": "Be able to use simulation tool to analyze radio frequency and microwave circuits."
    }
  ],
