  "description": {
    "sub_id3": null,
    "sub_name": "數位行銷專題實作",
    "sub_ename": "PROJECT-BASED PRACTICE IN DIGITAL MARKETING",
    "describe_ch": "以實際數位行銷專案為主要課程內容，讓學生必須在學期內完成一個或數個數位行銷專案。在已學習的行銷商業模型及理論下，運用數位行銷策略與工具，進行情境分析及商業實作。讓學生實際練習業界的需求專案，快速與實際業界需求接軌，並實際產出專案成果。",
    "describe_eh": "With actual digital marketing projects as the main course content, students must complete one or several digital marketing projects within the semester. Based on the learned marketing business models and theories, use digital marketing strategies and tools to conduct contextual analysis and commercial implementation. Let students practice actual industry demand projects, quickly integrate with actual industry demand, and actually produce project results.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
