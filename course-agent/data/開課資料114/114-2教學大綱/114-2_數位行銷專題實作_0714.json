    {
      "seq": 1,
      "describe_ch": "應用行銷理論完成數位行銷專案",
      "describe_en": "Apply marketing theory to implement the project-based practice in digital marketing."
    },
    {
      "seq": 2,
      "describe_ch": "能運用數位行銷策略分析工具，量化/非量化資料採集及模型於實際商業案例",
      "describe_en": "Able to use digital marketing strategy analysis tools, quantitative/non-quantitative data collection and modeling in actual business cases."
    }
  ],
