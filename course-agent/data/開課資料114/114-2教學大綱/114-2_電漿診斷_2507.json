  "description": {
    "sub_id3": null,
    "sub_name": "電漿診斷",
    "sub_ename": "PLASMA DIAGNOSIS",
    "describe_ch": "電漿是物質的第四態，也是一種高能量的物質態，經常使用各種不同電源型式的電場在特定的條件下將物質提昇到電漿態，從而應用於材料的製造，尤其是薄膜型式的材料。電漿的物理和化學特性是可控制變因，這些可控變因包括電漿密度、電漿電位、電子溫度、激動態離子種類和密度以及離子種類和密度等，並且從而影響材料的微觀組織和特性。如何利用各種電漿診斷手法探測這些電漿物理和化學特性，並進一步監控電漿特性成為十分重要的議題。故本課程旨在了解電漿行為、獲悉電漿診斷的運作原理以及其監控上之應用，加強相關研究之前景知識，以期能獨立閱讀相關文獻資料以及相關研究之深度。",
    "describe_eh": "Plasma, the high energy fourth state of matters, is usually sustained by a variety of electrical power supplies and is extensively used for material synthesis, particularly in form of thin film coatings. Plasma physical and chemical states themselves are controllable variables, such as plasma density, plasma potential, electron temperature, excited species and ion species, and can greatly affect microstructure of the produced thin film coatings as well as properties. It is therefore become essential to diagnose and monitor (or control) plasma states. This course provides the basic understanding of plasma behavior and the knowledge of plasma diagnostics as well as plasma state control, so as to be able to facilitate the ability for relevant literature review and the independent research of those kinds.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解電漿行為的知識架構",
      "describe_en": "Comprehension the for the framework knowledge base of plasma behavior."
    },
    {
      "seq": 2,
      "describe_ch": "應用各種電漿診斷的原理\t\t",
      "describe_en": "Application for the principle of plasma diagnostics."
    },
    {
      "seq": 3,
      "describe_ch": "具備分析電漿所得結果的能力\t",
      "describe_en": "Construct the ability to analyze the results obtained from plasma diagnostics."
    },
    {
      "seq": 4,
      "describe_ch": "建構相關電漿診斷使用的衍生問題及其解答的相關資料檢索能力。\t",
      "describe_en": "Construct the ability for relevant literature review and the independent research of those kinds."
    }
  ],
