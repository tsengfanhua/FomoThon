  "description": {
    "sub_id3": null,
    "sub_name": "傅氏光學",
    "sub_ename": "FOURIER OPTICS",
    "describe_ch": "本課程包含傅立葉轉換分析的基本原理，純量繞射原理， Fresnel繞射 與Fraunhofer繞射，光學傅立葉轉換，光學成像分析，與光信號處理。",
    "describe_eh": "The course contains (1)Introduction, (2)Basic principle of Fourier analysis, (3) Scalar diffraction theory, (4)Fresnel diffraction, (5)Fraunhofer diffraction, (6)Optical Fourier transform (7)Imaging analysis and (8)Optical signal processing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解傅氏光學的基本原理",
      "describe_en": "To comprehend the basic theory of Fourier Optics."
    },
    {
      "seq": 2,
      "describe_ch": "能應用傅氏光學原理於實際光學系統",
      "describe_en": "To apply Fourier Optics theory to real optical systems."
    }
