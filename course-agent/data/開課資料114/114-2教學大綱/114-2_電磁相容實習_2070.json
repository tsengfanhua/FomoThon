  "description": {
    "sub_id3": null,
    "sub_name": "電磁相容實習",
    "sub_ename": "EXPERIMENTS FOR ELECTROMAGNETIC COMPATIBILITY",
    "describe_ch": "配合自行發展的實驗治具與IC-EMC中心的儀器設備，從當前的科技發展趨勢來介紹目前EMC最新標準發展與法規現況(如有關IC的EMC設計技術與驗證)、高速數位電路之SI與EMC基本原理、EMC測試方法、雜訊偵測與除錯技術，以及包括屏蔽技術、電路佈線原理、PCB設計技術等技術設計等，將可提供學生對產業界EMC設計技術與測試方法有一實際且系統性的了解。",
    "describe_eh": "Following the trend of technology advancement with experimental fixtures and testing equipment of IC-EMC Center, this course intends to introduce current development of EMC regulations (eg. EMC design techniques and verification for IC, etc), SI and EMC fundamentals for high-speed digital circuit, EMI diagnosis and countermeasure, shielding techniques, PCB layout and routing. This course will provide students with practical and systematic coverage for EMC design and testing techniques.",
    "pre_subname": "COME4001電磁波、COME2010電磁學(一)",
    "pre_sub_id3": "COME4001",
    "pre_sub_ename": "COME4001 ELECTROMAGNETIC WAVE、COME2010 ELECTROMAGNETICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能辨識出可應用電磁干擾原理與技術的場合，並能清楚表達，能使用相關原理，規劃一評估電磁干擾應用及其影響的相關分析，並由分析中歸納出適當結論",
      "describe_en": "Be able to use related principles to plan an evaluation about measuring EMI and effects, and draw appropriate conclusions from analysis. Use principles of EMI to evaluate operation characteristics of a product or system and propose a feasible method for v"
    },
    {
      "seq": 2,
      "describe_ch": "能針對一特定有關電磁干擾的議題或情境，設計一合理模擬，加以驗證，並適切歸納出結論，能以書面或口頭方式將所獲結果與同儕、助教及教師溝通",
      "describe_en": "Communicate results in written or oral form to classmates, teaching assistants, and the instructor."
    }
  ],
