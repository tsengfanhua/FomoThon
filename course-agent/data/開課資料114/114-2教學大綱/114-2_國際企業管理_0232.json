  "description": {
    "sub_id3": null,
    "sub_name": "國際企業管理",
    "sub_ename": "INTERNATIONAL BUSINESS MANAGEMENT",
    "describe_ch": "國際企業管理專題旨在統整同學國際企業管理專業知識，並在指導老師的協助下，以團隊方式完成一專題研究計畫案，以建立從問題確認、研究流程設計與規劃、資料蒐集與分析、到結論與建議之系統化觀念與架構，完成學用合一之目的。專題研究成果報告書內容涵蓋：研究背景、研究動機、研究目的、文獻探討、研究架構、研究流程、研究設計、資料蒐集、資料分析、結論與建議等。",
    "describe_eh": "This is a project-based course in exploring an international business topic. The course will introduce in some international business cases. Students should formulate into teams and find an international business topic for the projects, including motivations, research goals, research questions, literature, theoretical foundations, methodology, data collection, data analysis, and conclusion.",
    "pre_subname": "MGT1001管理學、MGT2020行銷管理、MGT1002企業概論",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT、MGT2020 MARKETING MANAGEMENT、MGT1002 INTRODUCTION TO BUSINESS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "提升學生能夠應用溝通表達能力在國際企業管理報告。",
      "describe_en": "To enhance the application capabilities in communication skills on international business project reports."
    },
    {
      "seq": 2,
      "describe_ch": "提升學生瞭解國際企業之倫理道德與社會責任。",
      "describe_en": "To enhance the knowledge of the ethics and social responsibility of multinational enterprises."
    },
    {
      "seq": 3,
      "describe_ch": "提升學生能夠應用分析國際企業管理案例與解決問題能力。",
      "describe_en": "To enhance the application capabilities in analyzing international business cases and business problem resolutions."
    }
  ],
