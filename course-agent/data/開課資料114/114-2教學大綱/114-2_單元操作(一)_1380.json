  "description": {
    "sub_id3": null,
    "sub_name": "單元操作(一)",
    "sub_ename": "UNIT OPERATIONS(1)",
    "describe_ch": "單元操作(一)內容主要為流體力學(fluid mechanics)。利用數學模型去了解、描述及設計工程系統中牽涉到流體力學的部分。",
    "describe_eh": "Using mathematic models to understand, describe and design engineering systems and processes that involve the mechanics and dynamics of fluids.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂流體力學",
      "describe_en": " Define Fluid Dynamics by their own words."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明流體力學在工程系統中的作用",
      "describe_en": "Understand and be able to explain the effect of fluid dynamics to engineering systems."
    },
    {
      "seq": 3,
      "describe_ch": "能夠利用流體力學分析工程系統中流體的流場，並就其缺點提出改善設計　",
      "describe_en": "Be able to analyze the flow field using fluid dynamics and propose a better design according to the flow problems."
    },
    {
      "seq": 4,
      "describe_ch": "能利用數學模型，計算流場速度、壓力分佈及表面應力　",
      "describe_en": "Be able to use the mathematic models to calculate the velocity and pressure distribution, and the stresses."
    }
  ],
