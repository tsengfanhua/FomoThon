  "description": {
    "sub_id3": null,
    "sub_name": "固態物理(一)",
    "sub_ename": "SOLID STATE PHYSICS(I)",
    "describe_ch": "本課程主要強調固態現象與基本量子力學、電磁學、熱力學等定理的關連，並對基本的物理定律及現象作清楚且直接的描述。內容包括固態物理描述、晶體及晶格、固體的結構、波的彈性散射、鍵結、原子的振動、電子的能階。\n",
    "describe_eh": "The main attempt of this course is to emphasis strong links batween solid state phenomena and the basic laws of quantum mechanics, electromagnetism, and thermodynamics. A goal is made to describe each phenomena clearly and to show in a straightforword way how it follows from the basic laws of physics. The content is a survey of solid state physics, crystal lattices, structures of solids, elastic scattering of waves, bonding, atomic vibrations, and electron states.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解固體(包含導體、半導體及絕緣體)的物理基本特性及其相關應用。",
      "describe_en": "To know the basic physic characteristics and related applications of solids (including, conductor, semiconductor, and insulator)."
    },
    {
      "seq": 2,
      "describe_ch": "能分析並獨自解決課堂所提供的練習，並提出新問題。",
      "describe_en": "To analyze and solve the exercises provided in class by oneself and propose new problems."
    },
    {
      "seq": 3,
      "describe_ch": "能評估現代電子產業所需材料及技術，並嘗試發現未來可取代的新物資。",
      "describe_en": "To evaluate the required materials and techniques of modern electronic industry. Also attempt to discover the new replaceable materials in the future."
    }
  ],
