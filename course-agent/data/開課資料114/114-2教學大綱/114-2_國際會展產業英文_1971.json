  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CH06310",
    "sub_id": "41102",
    "scr_dup": "001",
    "sub_title": "This course covers a lot of ground, including a comprehensive topics of the MICE (Meetings, Incentives, Conventions, and Exhibitions) industry.",
    "sub_title_en": null,
    "sub_describe": "\"The theme of this course is to strengthen students' knowledge of the international MICE industry while developing relevant English communication skills. Key topics include industry trends, meeting planning and marketing, convention management, exhibition logistics and on-site operations, and the management of incentive travel.\"",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "國際會展產業英文",
    "sub_ename": "SEMINAR ON ENGLISH FOR MICE",
    "describe_ch": "本課程旨在增進學生對於國際會展（MICE）產業的認知與相關英文之應用，涵蓋：國際會展概論與趨勢、會議規劃與行銷、會議管理實務、展覽活動規劃與現場管理、獎勵旅遊及其相關議題。學生將學習並運用會展英文，包含國際會議語言、專有名詞與簡報技巧等。",
    "describe_eh": "This course aims to enhance students’ understanding of the international MICE (Meetings, Incentives, Conventions, Exhibitions) industry in theory and practice. The course covers the trend of MICE, conference/exhibition planning, marketing and management, and issues related to incentive travel. In addition, students will learn and demonstrate the use of English for MICE, including conference languages, terminology and presentation skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "融合相關產業與英語文學習的內涵，開拓人與產業的鏈結關係中，英語文當作中介之核心地位。",
      "describe_en": "To gain and develop practical experience between humans and industries, with  English as a core medium in linkage with the MICE (Meetings, Incentive travel, Conventions, Exhibitions) industry"
    },
    {
      "seq": 2,
      "describe_ch": "融合相關產業與英語文學習的內涵，探索業界現況與趨勢中，與文化、文學素材以及譯事行為結合之際，英語文當作中介之貢獻。",
      "describe_en": "To incorporate MICE-related industries and English learning, and to explore the influence of English as a medium in current trends and in connection to cultural, literary materials and translation behavior"
    }
  ],
