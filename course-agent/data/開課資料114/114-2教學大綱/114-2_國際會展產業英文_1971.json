    "tpa_score_new": "<ol>\n\t<li>30%--Mid-term Exam. --Oral Presentation</li>\n\t<li>30%--Final Exam.--Oral Presentation &amp; Event Proposal</li>\n\t<li>40%--Attendance, Participation, Discussion, Practice</li>\n</ol>\n",
    "tpa_score_new_en": null,
