    {
      "seq": 2,
      "describe_ch": "了解工具機製造廠運作實務",
      "describe_en": "Understanding how the machine tools be build."
    },
    {
      "seq": 3,
      "describe_ch": "了解工具機各主要模組的工作原理與設計要點",
      "describe_en": "Understanding the working and design principle of the major modules of machine tools."
    }
