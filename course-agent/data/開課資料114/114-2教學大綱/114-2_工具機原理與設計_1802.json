  "description": {
    "sub_id3": null,
    "sub_name": "工具機原理與設計",
    "sub_ename": "THEORY AND DESIGN OF MACHINE TOOLS",
    "describe_ch": "透過工具機加工實務介紹，以初步認識工具機的用途與工作原理，進而介紹製造工具機之工廠的運作實務，使概略瞭解工具機是如何製作出來的，接著介紹組成工具機之主要模組件以及其工作原理與設計要點，使學生了解工具機之使用目的，以及通過各組件之認識，培養工具機之基礎系統設計能力。",
    "describe_eh": "Through introducing the machining principle of machine tools to recognize the applications and principle of machine tools. And then introduce the operation practice of machine tools factory.to understand the manufacturing process of machine tools. Further, in order to educate the fundamental ability of machine tools system design, introduce and explain the working and design principle of major components of machine tools to let the students have the basic knowledge of machine and major components",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解工具機加工實務概念",
      "describe_en": "Understanding machining practice of machine tools."
