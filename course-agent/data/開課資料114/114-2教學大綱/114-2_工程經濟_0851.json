  "description": {
    "sub_id3": null,
    "sub_name": "工程經濟",
    "sub_ename": "ENGINEERING ECONOMICS",
    "describe_ch": "介紹學生時間管理與工程成本之關係，並導入複利與折舊等觀念，指導學生如何應用各種方法來評估工程時間之價值，進而分析工程投資決策及降低工程風險。",
    "describe_eh": "Introduces the relationship between student time management and engineering costs, and introduces concepts such as compound interest and depreciation. Guides students how to apply various methods to evaluate the value of engineering time, and then analyzes engineering investment decisions and reduces engineering risks.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
