  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道拉普拉斯轉換之定義及其應用於求解微分方程式的技巧。",
      "describe_en": "To know the definition of Laplace transform and its application in solving ODE.　"
    },
    {
      "seq": 2,
      "describe_ch": "使用傅立葉級數、積分和轉換。",
      "describe_en": "To apply Fourier series, integral, and transform."
    }
