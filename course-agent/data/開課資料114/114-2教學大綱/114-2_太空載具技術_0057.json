  "description": {
    "sub_id3": null,
    "sub_name": "太空載具技術",
    "sub_ename": "SPACE VEHICLE TECHNOLOGY",
    "describe_ch": "通過本課程的學習，學生將掌握太空載具技術的基本概念和原理，並能夠分析和評估太空載具的設計、開發和運行。他們將具備太空載具系統集成、通信、控制和任務規劃等方面的能力，為太空載具技術領域的發展和應用做出貢獻。",
    "describe_eh": "Through the study of this course, students will master the basic concepts and principles of space vehicle technology, and be able to analyze and evaluate the design, development and operation of space vehicles. They will have capabilities in space vehicle system integration, communication, control and mission planning, and contribute to the development and application of space vehicle technology.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生掌握太空載具技術知識及基本原理和方法。",
      "describe_en": "Enable students to understand the basic principles and methods of space vehicle technology."
    },
    {
      "seq": 2,
      "describe_ch": "使學生瞭解太空載具技術的原理和方法。",
      "describe_en": "Enable students to master the principles and methods of space vehicle technology."
    },
    {
      "seq": 3,
      "describe_ch": "使學生掌握太空載具的設計和開發。",
      "describe_en": "Equip students with skills of the design and development of space vehicles."
    },
    {
      "seq": 4,
      "describe_ch": "使學生學習太空載具的相關次系統及酬載的基本原理與技術。",
      "describe_en": "Enable students to learn the basic principles and techniques of the relevant subsystems and payloads of space vehicles."
    },
    {
      "seq": 5,
      "describe_ch": "使學生熟悉學習太空載具的控制與導航相關的基本原理與技術。",
      "describe_en": "Make students familiarize with the basic principles and techniques related to the control and navigation of space vehicles."
    },
    {
      "seq": 6,
      "describe_ch": "培養學生掌握太空載具的任務與管理關鍵要素。",
      "describe_en": "Train students to master key elements of space vehicle missions and management."
    }
  ],
