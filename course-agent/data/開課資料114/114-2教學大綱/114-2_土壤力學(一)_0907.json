  "description": {
    "sub_id3": null,
    "sub_name": "土壤力學(一)",
    "sub_ename": "SOIL MECHANICS(1)",
    "describe_ch": "土壤力學探索土壤組成、土壤分類方法、土壤夯實、土壤中的水流、土體中的應力、土壤的壓縮、土壤的剪力強度、及地下探測等內容。研習的內容是大地工程如建築物基礎、擋土構造物等相關分析與設計的必備工具。",
    "describe_eh": "Soil Mechanics explores the soil composition, methods of soil classification,\ncompaction of soils, seepage of water in soils, stresses in soils, compression of\nsoils, shear strength of soils, and subsurface exploration. The contents provide\nrequired tools for the design of geotechnical related structures such as foundations of\nbuilding and retaining structures.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解土壤組成、應力歷史、及決定土壤物理及力學性質之各種試驗方法。",
      "describe_en": "Comprehension for the formation, stress history, and those methods for determining of the physical and the mechanical roperties of soils."
    },
    {
      "seq": 2,
      "describe_ch": "能分析土體內之滲流、應力及沉陷等。",
      "describe_en": "Analyses for the seepage, stresses and settlements in soil masses."
    }
  ],
