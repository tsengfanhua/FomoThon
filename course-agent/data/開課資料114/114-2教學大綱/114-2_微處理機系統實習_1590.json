  "description": {
    "sub_id3": null,
    "sub_name": "微處理機系統實習",
    "sub_ename": "THE EXPERIMENT OF MICRO-PROCESSOR SYSTEM",
    "describe_ch": "微處理機系統實習是電機電子領域中基本的一門課程，此課程內容主要在介紹CPU, I/O, TIMERS/COUNTERS, Serial Communication，以奠定學生於電機電子及微處理機系統之實際應用。",
    "describe_eh": "The Experiment of Microprocessor System is the basic course in the area of electrical and electronic engineering. The CPU, I/O, TIMERS/COUNTERS, Serial Communication are introduced in this course. The object of this course is to give the fundamentals of microprocessor systems. Moreover, based on the completion of this course, the more deeply study can be applied to the different applications in the electrical and electronic areas.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 13,
      "describe_ch": "能用自己的專業知識設計與執行各項微處理機系統實驗。",
      "describe_en": "Knowledge for understanding and executing the various experiments based microcontroller system."
    },
    {
      "seq": 14,
      "describe_ch": "藉由微處理機專題實驗訓練，使其具系統設計、組件與製程能力。",
      "describe_en": "Obtaining the abilities for system design, assembly and processing based on the microcontroller system experiments."
    },
    {
      "seq": 15,
      "describe_ch": "獲得發掘及分析微處理機系統實驗之基礎能力，以及解決各項問題獨立思考及創新之能力。",
      "describe_en": "The abilities for developing and analyzing the microcontroller-based system, as well as independently solving problems and innovating design."
    }
  ],
