  "description": {
    "sub_id3": null,
    "sub_name": "電路電子學",
    "sub_ename": "ELECTRIC CIRCUITS AND ELECTRONICS",
    "describe_ch": "探討電路基本定理與電路相關之工程分析與設計方法，教導基本電子學理論，其中包括各種基本電子元件與電子電路分析之方法，是工程基礎課程之一。本課程適合工程之大學部初學者修習。",
    "describe_eh": "This course introduces fundamental circuit theory, engineering analysis, and design methodology. Furthermore, the fundamental electronics theories including basic electronic components and analysis methods of the electronic circuit are discussed. The course is one of the fundamental courses of engineering and is appropriate for beginners to attend undergraduate engineering.",
    "pre_subname": "MATH1005微積分(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解基礎之電路元件與運作方式。",
      "describe_en": "To understand the basic electronic components and their operation mode."
    },
    {
      "seq": 2,
      "describe_ch": "能分析電路。",
      "describe_en": " Be capable of analyzing electric circuits."
    },
    {
      "seq": 3,
      "describe_ch": "有能力以設計電路以解決基礎課程之工程問題。",
      "describe_en": "To design circuits in order to solve the basic problems of engineering."
    },
    {
      "seq": 4,
      "describe_ch": "理解電路電子在解決工程問題所扮演之重要性與其不足處。",
      "describe_en": "To comprehend the importance of the electric circuits in solving engineering problem and its insufficiency."
    }
  ],
