  "description": {
    "sub_id3": null,
    "sub_name": "線性系統分析",
    "sub_ename": "LINEAR SYSTEM ANALYSIS",
    "describe_ch": "此課程教授連續時間線性系統的分析方法，包含時域及頻率域(傅立葉轉換、拉普拉斯轉換)系統設計的基礎能力，以及離散時間線性系統的基本分析與設計。",
    "describe_eh": "This course teaches analytical methods of continuous-time linear systems, including the fundamental design of systems both in time- and frequency-domain (Fourier transform, Laplace transform). The fundamental analysis and design of discrete-time linear systems are also covered.",
    "pre_subname": "ISTM114解析幾何與微積分I、ISTM118解析幾何與微積分II",
    "pre_sub_id3": "ISTM114",
    "pre_sub_ename": "ISTM114 ANALYTIC GEOMETRY AND CALCULUS I、ISTM118 ANALYTIC GEOMETRY AND CALCULUS II",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解線性系統之特性",
      "describe_en": "An ability to comprehend the characteristics of linear systems."
    },
    {
      "seq": 2,
      "describe_ch": "能分析基本線性系統",
      "describe_en": "An ability to analyze fundamental linear systems."
    },
    {
      "seq": 3,
      "describe_ch": "能應用時域與頻率域之數學技巧來設計電路。",
      "describe_en": "An ability to apply time domain and frequency domain mathematical skills to design circuits"
    }
  ],
