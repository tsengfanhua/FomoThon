  "description": {
    "sub_id3": null,
    "sub_name": "智慧財產之保護與實務",
    "sub_ename": "PROTECTION AND PRACTICE OF INTELLECTUAL PROPERTY",
    "describe_ch": "本課程旨在介紹智慧財產權相關法律，給予學生智慧財產權基本概念。內容包括智慧財產權原理、商標法、專利法、營業秘密法、著作權法等智慧財產權相關法律之介紹。",
    "describe_eh": "This course aims to introduce the law of intellectual property, including the general concept on intellectual property, trademark, patent, copyright and trade secret law.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解智慧財產權的基本概念",
      "describe_en": "Understand the general concept of intellectual property system."
    },
    {
      "seq": 2,
      "describe_ch": "了解商標法的重要規定並能從實際案例中學習保護自己的權益",
      "describe_en": "Understand important provisions of trademark law and be able to learn to protect their rights from practical cases."
    },
    {
      "seq": 3,
      "describe_ch": "了解專利法與營業秘密法的重要規定並能從實際案例中學習保護自己的權益",
      "describe_en": "Understand important provisions of patent law and the secret trade law, and be able to learn to protect their rights from practical cases."
    },
    {
      "seq": 4,
      "describe_ch": "了解著作權法的重要規定並能從實際案例中學習保護自己的權益",
      "describe_en": "Understand important provisions of copyright law and be able to learn to protect their rights from practical cases."
    }
  ],
