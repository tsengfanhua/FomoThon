  "description": {
    "sub_id3": null,
    "sub_name": "空間與行為",
    "sub_ename": "SPACE AND BEHAVIOR",
    "describe_ch": " 本課程主要是以環境心理學為理論依據，介紹人們在不同空間或環境中所造成的行為模式。授課的重點除了相關的環境心理學理論(個人空間、領域性、擁擠性及私密性)外，並介紹相關行為研究的方法。在對相關環境心理學理論有初步的了解之後，再深入介紹如何應用在不同空間或環境之",
    "describe_eh": "the purpose of this course is to apply environmental psychology into spatial behaviors in different environments. Fundamental concepts of environmental psychology such as personal space, territoriality, crowding, and privacy will be introduced firstly. Pr",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解環境心理學基本觀念",
      "describe_en": "Be able to understand fundamental concepts of environmental psychology"
    },
    {
      "seq": 2,
      "describe_ch": "能分析不同空間之行為類型",
      "describe_en": "Be able to analyze different spatial behavior patterns"
    },
    {
      "seq": 3,
      "describe_ch": "能應用環境心理學理論分析不同空間行為模式",
      "describe_en": "Be able to apply concepts of environmental psychology to analyze different spatial behavioral patterns"
    }
  ],
