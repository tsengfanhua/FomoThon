  "description": {
    "sub_id3": null,
    "sub_name": "機器學習",
    "sub_ename": "MACHINE LEARNING",
    "describe_ch": "本課程將介紹基礎機器學習與軟計算的理論與實務。學習機包含類神經網路、廣義徑向幅基函數網路、模糊神經網路及支撐向量機。進化演算則包含基因演算法、粒子群聚最佳化演算法及布穀鳥搜尋法。教學目標為建立學生在機器學習與軟計算必要的根基，以便將所學之技術應用在他/她們自己的問題上。",
    "describe_eh": "In this course, the fundamental principles and applications of the machine learning and soft computing are introduced. The learning machines include the artificial neural networks, generalized radial basis function networks, fuzzy neural networks, and support vector machines. For evolutionary computation, the genetic algorithm, particle swarm optimization, and cuckoo search will be introduced. The goal is build the necessary background of the machine learning and soft computing for the students in order to apply these techniques in their own problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解機器學習的原理，以及正確的使用方式。",
      "describe_en": "Learn how machine learning works, and how to use it correctly."
    },
    {
      "seq": 2,
      "describe_ch": "了解機器學習在求解複雜且真實問題時的處理流程。",
      "describe_en": "Learn how machine learning works when solving complex real-world problems."
    }
  ],
