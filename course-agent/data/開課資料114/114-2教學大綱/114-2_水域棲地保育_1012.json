  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE02310",
    "sub_id": "09316",
    "scr_dup": "001",
    "tpa_score_new": "<div>期中測驗 30%</div>\n\n<div>期末測驗30%</div>\n\n<div>報告+課堂參與40%</div>\n",
    "tpa_score_new_en": null,
    "course_pol": "所有課程活動都將在同學之間的友好參與和互動氛圍中進行，彼此間尊重和欣賞每位同學的個人經歷、背景和觀點，如國內外各學制、多元入學及學習文化、性別等。希望您始終在本課程中應用最高的學術標準，並以有尊嚴和尊重的態度對待同學。",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<div>在專題報告，觀察及審閱同學彼此的學習任務，鼓勵與同學合作，以完成書面報告、或專題實作。組成學習或閱讀小組可能是學習的有效途徑。但是，當您撰寫文章或論文時，文字必須是您自己的。</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": null
  },
