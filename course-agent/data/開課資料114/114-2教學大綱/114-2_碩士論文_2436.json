  "description": {
    "sub_id3": null,
    "sub_name": "碩士論文",
    "sub_ename": "MASTER THESIS",
    "describe_ch": "本課程將要求學生針對學術專業問題進行深入研究與探討，並將研究過程和成果撰寫成研究論文，進而強化學生執行研究與解決問題的能力。論文內容架構需包含導論、文獻回顧、方法、結果與討論、結論及參考文獻。\n",
    "describe_eh": "This course will require students to conduct in-depth research and discussion on academic and professional issues and write research processes and results into research papers, strengthening students' ability to perform research and solve problems. The content structure of the paper should include introduction, literature review, methods, results and discussions, conclusions, and references.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "執行實驗、蒐集研究數據與及總結論文成果的能力　",
      "describe_en": "Specify the capability of conducting experiment, obtain the data and summarize the results　"
    },
    {
      "seq": 2,
      "describe_ch": "總結環工專業論文之撰寫能力以及論文發表的表達能力",
      "describe_en": "Compose the writing capability of thesis and the communication skills"
    },
    {
      "seq": 3,
      "describe_ch": "詳述研究議題並能提出獨到的創新結論",
      "describe_en": "Specified the research topics and results"
    },
    {
      "seq": 4,
      "describe_ch": "判斷當代環境議題並能持續學習保護環境科技　",
      "describe_en": "Judge the environmental issues, and learning the best technology for the environmental protection"
    }
  ],
