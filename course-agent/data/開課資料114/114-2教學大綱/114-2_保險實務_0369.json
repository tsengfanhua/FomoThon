  "description": {
    "sub_id3": null,
    "sub_name": "保險實務",
    "sub_ename": "PRACTICE OF INSURANCE",
    "describe_ch": "本課程將提供給曾經在過去課程獲得基礎保險理論的學生一些關於實務之議題，保險實務的課是一個包含非常廣泛之課程，本課程將提供先進國家與本國市場之實務包含危險管理、核保、理賠、法律環境、損失控制等議題。",
    "describe_eh": "This course is tend to introduce the insurance practice for those student who have achieved the insurance fundamental theory. The insurance practice is very wide range course. This course will provide the risks management, underwriting, claim, legal environment and loss control of advanced countries as well as domestic market practice.\r\n",
    "pre_subname": "INSU1001保險學",
    "pre_sub_id3": "INSU1001",
    "pre_sub_ename": "INSU1001 INSURANCE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解保險實務的概念",
      "describe_en": "To know the concepts of insurance operation."
