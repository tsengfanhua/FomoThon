  "description": {
    "sub_id3": null,
    "sub_name": "系統建模與模擬",
    "sub_ename": "SYSTEM MODELING AND SIMULATION",
    "describe_ch": "該課程關注系統建模與類比，培養學生在太空系統工程領域的核心能力。學生將學習如何使用系統建模工具和技術來描述和分析複雜的太空系統。他們將掌握建立系統模型、進行模擬和評估的方法，並學會利用模擬工具來驗證設計、優化性能和預測系統行為。通過系統建模與類比，學生將能夠更好地理解和優化太空系統，提高其可靠性和性能。",
    "describe_eh": "The course focuses on system modeling and simulation, aiming to develop students' core competencies in the field of space systems engineering. Students will learn how to use system modeling tools and techniques to describe and analyze complex space systems. They will acquire the skills to establish system models, conduct simulations, and evaluate system performance. Through system modeling and simulation, students will gain a better understanding of and optimize space systems, enhancing their reliability and performance.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生掌握系統建模知識基本原理和方法。",
      "describe_en": "Enable students to master the basic principles and methods of system modeling knowledge."
    },
    {
      "seq": 2,
      "describe_ch": "使學生瞭解系統建模語言、工具的原理和方法。",
      "describe_en": "Enable students to understand the principles and methods of system modeling languages and tools."
    },
    {
      "seq": 3,
      "describe_ch": "使學生掌握系統模擬的定義和方法。",
      "describe_en": "Enable students to master the definition and method of system simulation."
    },
    {
      "seq": 4,
      "describe_ch": "使學生學習系統模型驗證與評估的相關技巧。",
      "describe_en": "Enable students to learn skills related to system model verification and evaluation."
    },
    {
      "seq": 5,
      "describe_ch": "使學生熟悉複雜系統建模與分析的基礎知識。",
      "describe_en": "Make students familiarize students with the fundamentals of modeling and analysis of complex systems."
    },
    {
      "seq": 6,
      "describe_ch": "培養學生掌握複雜系統案例研究和實踐專案的關鍵要素。",
      "describe_en": "Train students to master key elements of complex systems case studies and hands-on projects students to master the key elements of mission and system design verification validation."
    }
  ],
