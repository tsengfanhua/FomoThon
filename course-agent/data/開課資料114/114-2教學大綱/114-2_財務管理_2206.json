  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CM01310",
    "sub_id": "37750",
    "scr_dup": "001",
    "tpa_score_new": "<ol>\n\t<li>Participation (20%)</li>\n\t<li>Paper Presentation (25%)</li>\n\t<li>Final Exam (20%)</li>\n\t<li>Research proposal (35%)</li>\n</ol>\n",
    "tpa_score_new_en": " ",
    "course_pol": "所有課程活動都將在同學之間的友好參與和互動氛圍中進行，彼此間尊重和欣賞每位同學的個人經歷、背景和觀點，如國內外各學制、多元入學及學習文化、性別等。希望您始終在本課程中應用最高的學術標準，並以有尊嚴和尊重的態度對待同學。",
    "course_pol_en": "All course activities will take place in an atmosphere of friendly participation and interaction among classmates, where mutual respect and appreciation for each student's personal experiences, backgrounds, and perspectives are valued, including various educational systems, learning cultures, and gender, etc. We hope that you will always apply the highest academic standards in this course and treat your classmates with dignity and respect.",
    "course_rem": "課程相關資料及重要資訊會同步公告在iLearn，請同學留意課程資訊。",
    "course_rem_en": null,
    "ais_meno": "<div>學習必須以誠信為基礎，任何學生企圖將自己未製作的作品，作為自己的作品，此行為是為不誠實行為。在作業、測驗或考試中作弊或抄襲的學生或協助他人的行為，該次成績以零分計，若是累犯，將依逢甲大學學生獎懲辦法提送。</div>\n",
    "ais_meno_en": "<div>Learning must be based on integrity. Any student who attempts to present work that is not their own as their own is engaging in dishonest behavior. Students who cheat or plagiarize in assignments, quizzes, or exams, or assist others in doing so, will receive a zero for that assessment. Repeat offenders will be referred for disciplinary action according to Feng Chia University&#39;s student disciplinary regulations.</div>\n",
    "ilearn_mk": "N"
  },
