  "description": {
    "sub_id3": null,
    "sub_name": "財務管理",
    "sub_ename": "FINANCIAL MANAGEMENT",
    "describe_ch": "財務管理是希望能訂定最適的財務決策，包括資本預算、資本結構、股利政策及營運資金的管理等，以達到追求股東財政極大化之目標。",
    "describe_eh": "Corporate finance has three main areas of concern: 1. Capital budgeting. 2. Capital structure. 3. Working capital management. The goal of financial management is to maximize the shareholders wealth.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能定義財務管理與理解此課程對財務經理的重要性。",
      "describe_en": "Define financial management and understand the importance of financial management for the financial managers."
    },
    {
      "seq": 2,
      "describe_ch": "能理解財務管理對公司及經濟層面的重要性及影響。",
      "describe_en": "Understand and be able to explain the importance and effects of financial management to firms and economy."
    },
    {
      "seq": 3,
      "describe_ch": "能理解國內的金融機構、金融資產及市場。",
      "describe_en": "Understand domestically financial institutions, financial assets, and marketplace."
    },
    {
      "seq": 4,
      "describe_ch": "能理解風險與報酬的關係。",
      "describe_en": "Understand the relationship between return and risk."
    }
  ],
