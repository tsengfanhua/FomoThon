  "description": {
    "sub_id3": null,
    "sub_name": "結構學",
    "sub_ename": "STRUCTURAL THEORY",
    "describe_ch": "結構學是門訓練課程，教導學生分析或設計結構的能力，結構學將專注於靜定結構，以各種方法求解結構受外\n力產生的桿件內力及其穩定性，包含桁架、樑、構架等。結構學亦將介紹靜定結構之影響線及變形。",
    "describe_eh": "Structural Theory is a training course, which leads students to have the ability to analyze or design structures. Structural\nTheory will focus on the methods to solve the determinate structures, including varied\nways to determine the internal member\nforces and stability of structures—trusses, beams and frames-- subjected to applied\nloads. Techniques to determine the\ninfluence lines and deformations of statically determinate structures will also be introduced in this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "以學生所具備之物理學、微積分、工程數學、應用力學、材料力學為基礎,培養其分析結構桿件力之能力,以備結構設計之需。",
      "describe_en": null
    },
    {
      "seq": 2,
      "describe_ch": "講解分析結構之原理、假設、定理、及公式之誘導,使同學對結構理論能通盤了解。",
      "describe_en": null
    },
    {
      "seq": 3,
      "describe_ch": "講解實際例題,增進學生解題技巧。",
      "describe_en": null
    }
  ],
