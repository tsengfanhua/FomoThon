  "description": {
    "sub_id3": null,
    "sub_name": "永續發展與碳淨零工程",
    "sub_ename": "SUSTAINABLE DEVELOPMENT AND NET ZERO CARBON ENGINEERING",
    "describe_ch": "本課程主要在介紹聯合國為因應氣候暖化所倡議的永續發展目標，為達成此目標所謂2050淨零碳排隨之而提出以供政府及民間企業推動溫室氣體減量(碳減排)。",
    "describe_eh": "17 Sustainable Development Goals, 17SDGs is high lined to reduce the climate warming. For reaching this goals, the advocacy of 2050 net zero carbon discharge is agreed with many governments and enterprises. The following reduction actions on the greenhouse gas emission (carbon discharge) are currently promoted and will be introduced in this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能清楚了解永續發展與碳淨零排放的相關知識\t",
      "describe_en": "Finding and learning about the sustainable development and Net Zero Carbon discharge"
    },
    {
      "seq": 2,
      "describe_ch": "理解聯合國17項永續發展目標\t",
      "describe_en": "Understanding 17 Sustainable Development Goals"
    },
    {
      "seq": 3,
      "describe_ch": "企業社會責任及永續發展公司治理\t",
      "describe_en": "Corporate Social Responsibility (CSR) and  Environmental, Social, Governance (ESG)"
    },
    {
      "seq": 4,
      "describe_ch": "分析綠色金融與碳邊境調整機制\t",
      "describe_en": "Analyze of Green finical and Carbon Border Adjustment Mechanism, CBAM"
    },
    {
      "seq": 5,
      "describe_ch": "負碳排及碳中和科技應用\t",
      "describe_en": "Technology application of Carbon Negative and carbon neutrality"
    },
    {
      "seq": 6,
      "describe_ch": "溫室氣體盤查及稽核\t",
      "describe_en": "Greenhouse Gas Inventory and Auditing"
    }
  ],
