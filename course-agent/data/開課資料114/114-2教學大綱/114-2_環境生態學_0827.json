  "description": {
    "sub_id3": null,
    "sub_name": "環境生態學",
    "sub_ename": "ENVIRONMENTAL ECOLOGY",
    "describe_ch": "以土地資源為主軸，探討生態系之組成、運作與永續性經營管理，期望建立學生之尊重生命、疼惜鄉土的基本態度與行為，進而落實在土地使用規劃與資源保育的學習上，並訓練學生之思辨能力，思考未來要投入的專業領域。",
    "describe_eh": "On the basis of land resources, this course is to discuss on the elements , operation and sustainable management of an ecosystem and to establish students’ basic attitudes and behaviors on a respect to life and a love to hometown, which may contribute to their learning process in land use planning and resource conservation. In addition, a training of students’ critical thinking ability is emphasized to guide their future professional field to which they will put their efforts.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解「生態」與「環境」的基礎知識、意義與內涵。",
      "describe_en": "Understanding of fundamental knowledge, significance, and essence of \"ecology\" and \"environment\"."
    },
    {
      "seq": 2,
      "describe_ch": "理解現階段生態環境現況與面臨的困境",
      "describe_en": "Comprehension of current status of ecological environment and dilemmas confronted."
    },
    {
      "seq": 3,
      "describe_ch": "運用吸取的環境生態原理進一步能應用於室內與景觀設計中",
      "describe_en": "Application of environmental and ecological principles in interior and scenery design."
    },
    {
      "seq": 4,
      "describe_ch": "理解環境生態學原理後具備分析環境課題能力",
      "describe_en": "Obtain competences to analyze environmental issues on the bases of environmental and ecological principles."
    }
  ],
