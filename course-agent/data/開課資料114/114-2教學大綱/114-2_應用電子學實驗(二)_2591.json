  "description": {
    "sub_id3": null,
    "sub_name": "應用電子學實驗(二)",
    "sub_ename": "APPLIED ELECTRONICS LAB. (2)",
    "describe_ch": "本課程的目的是提供對類比及數位電路之分析及設計的基本能力實習，包含銜接實際應用的一些進階示範。下學期介紹運算放大器及常用IC的物理原理、工作條件和基本的應用電路設計。",
    "describe_eh": "The purpose of this course is to provide a basic practice for analyzing and designing both analog and digital electronic circuits. More advanced material about practical applications are included. In the second part of this course, we introduce the physical principles and operation restrictions of the operational amplifier and other      commonly used IC and the basic circuit design in which they are used.",
    "pre_subname": "PHYS1002普通物理實驗(二)、OPT2008應用電子學實驗(一)",
    "pre_sub_id3": "PHYS1002",
    "pre_sub_ename": "PHYS1002 GENERAL PHYSICS LAB.(2)、OPT2008 APPLIED ELECTRONICS LAB. (1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠描述及推演OP-AMP及常用類比IC的基本原理。",
      "describe_en": "Be able to describe and derive the basic theory of OP-AMP and other common used analog IC devices."
    },
    {
      "seq": 2,
      "describe_ch": "能閱讀廠商發表的元件資料手冊，藉由實驗課的實作及電腦軟體的模擬去了解OP-AMP的原理及相關電路之分析。",
      "describe_en": "Be able to read and study the device datasheet of their manufacturers.Understand the theory of OP-AMP and analyze the related circuit by experiments and computer simulation."
    },
    {
      "seq": 3,
      "describe_ch": "藉由專題的施作完成簡單可運作的光電裝置。",
      "describe_en": "Be able to build a simple optoelectrical device in a project."
    },
    {
      "seq": 4,
      "describe_ch": "透過分組作業培養團隊合作精神及有效溝通能力。",
      "describe_en": "To develop team spirit and the ability of efficient communication through teamwork."
    },
    {
      "seq": 5,
      "describe_ch": "認識目前國際電子產品的應用趨勢。",
      "describe_en": "Be able to learn the world’s trend on the applications of electronics."
    }
  ],
