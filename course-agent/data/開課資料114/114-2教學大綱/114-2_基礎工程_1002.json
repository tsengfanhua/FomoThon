  "description": {
    "sub_id3": null,
    "sub_name": "基礎工程",
    "sub_ename": "FOUNDATION ENGINEERING",
    "describe_ch": "本課程主要目的在於教導學生如何將土壤力學中所學習的基本原理應用於土木工程中之基礎設計上，探討各式結構在種種不同土壤現象作用下的影響，並學習如何將所學之基礎理論應用於工程實務上。",
    "describe_eh": "This main purposes of this course focus on teaching students how to apply the basic principle of geotechnical engineering to the foundation design, probe into the influences of different soil conditions on various foundations, and to learn how to apply the fundamental theories to engineering practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得工程構造物基礎的相關知識。",
      "describe_en": "Obtain the knowledge of structure foundation."
    },
    {
      "seq": 2,
      "describe_ch": "能初步設計工程構造物的基礎。",
      "describe_en": "Be able to perform preliminary design of foundation for structures."
    }
