  "description": {
    "sub_id3": null,
    "sub_name": "水域環境生態保育",
    "sub_ename": "AQUATIC  ENVIRONMENTAL  AND  ECOLOGICAL  CONSERVATION",
    "describe_ch": "本課程主要目的是要銜接基礎河川生態學與生態工程，一方面強化學生對河川生態學的基本知識，一方面瞭解生態系統與環境的關係，培養學生以生態對策解決水域環境問題的思維及能力。\r\n",
    "describe_eh": "This course can help students learn the basic and advanced knowledge of ecosystems in water environment. Students can learn how to maintain a harmonious relationship between ecosystem and environment. Also, they can learn how to protect water environment from an ecological viewpoint.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能學習生態系統與環境的關係\t",
      "describe_en": "Understand ecological system and the relationship between ecosystem and environment."
    },
    {
      "seq": 2,
      "describe_ch": "能應用生態對策處理水域環境問題\t",
      "describe_en": "Learn how to apply ecological conservation strategies on water environmental problems."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解生態環境品質評估方式\t",
      "describe_en": "Learn how to assess ecological environment quality"
    }
  ],
