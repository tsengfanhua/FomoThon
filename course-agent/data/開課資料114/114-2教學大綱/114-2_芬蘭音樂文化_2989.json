      "describe_ch": "認識芬蘭音樂在全球音樂文化中的獨特性。",
      "describe_en": "Recognize the uniqueness of Finnish music in global music culture."
    },
    {
      "seq": 2,
      "describe_ch": "建立音樂鑑賞能力，並尊重多元文化。",
      "describe_en": "Develop music appreciation skills and respect diverse cultures."
    }
