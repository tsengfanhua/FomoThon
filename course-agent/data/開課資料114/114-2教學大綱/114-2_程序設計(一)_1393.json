  "description": {
    "sub_id3": null,
    "sub_name": "程序設計(一)",
    "sub_ename": "PROCESS DESIGN (1)",
    "describe_ch": "本課程以教科書及最新期刊內容，講授化工程序設計方法，並邀請業界專家分享化工相關產業實務與發展，以及實地參訪業界，來提升同學於化工專業科目的整合與設計應用等能力。推動各組團隊進行跨學期專題實作；同學可演練構思、設計、實施與執行實際之工程問題專題之能力，提升口頭與書面表達能力、團隊合作與整合統整等能力。",
    "describe_eh": " This course introduces design principles of chemical process by using the contents of selected textbooks and related journal papers. Industrial professionals are invited to share chemical industry-related practice and trend with students. Students will also have the chance to visit industry to realize and integrate the principles of core courses and their applications. A team-based year-long capstone project will be conducted by students to enhance their ability to conceive, design, implement and operate real engineering problem. Oral and written presentation skills, teamwork and integration ability will be trained during this course.",
    "pre_subname": "CHE2004單元操作(一)、CHE3008單元操作(三)、CHE3004單元操作(二)、CHE2020質能均衡、CHE4001化學反應工程、CHE3005化工熱力學",
    "pre_sub_id3": "CHE2004",
    "pre_sub_ename": "CHE2004 UNIT OPERATIONS(1)、CHE3008 UNIT OPERATIONS(3)、CHE3004 UNIT OPERATIONS(2)、CHE2020 MATERIAL AND ENERGY BALANCES、CHE4001 CHEMICAL REACTION ENGINEERING、CHE3005 CHEMICAL ENGINEERING THERMODYNAMICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解化工程序設計之原理與應用",
      "describe_en": "Understand the principles and applications of chemical process design"
    },
    {
      "seq": 2,
      "describe_ch": "具有資料蒐集、數據分析、書面及口頭表達之能力",
      "describe_en": "Be able to collect data, analyze data and have presentation skills"
    },
    {
      "seq": 3,
      "describe_ch": "應用電腦軟體於工程實務",
      "describe_en": "Apply computer software in engineering practice"
    },
    {
      "seq": 4,
      "describe_ch": "可規劃實驗與分析化工程序",
      "describe_en": "Be able to propose experiments and analyze chemical process"
    },
    {
      "seq": 5,
      "describe_ch": "具有團隊合作、專案管理之能力",
      "describe_en": "Be able to work in teams and manage projects"
    },
    {
      "seq": 6,
      "describe_ch": "具有規劃與執行工程問題之能力",
      "describe_en": "Be able to conceive and implement engineering problem"
    },
    {
      "seq": 7,
      "describe_ch": "認識國際工程技術、瞭解化工產業之現況與永續發展",
      "describe_en": "Understand international engineering technique, current situation and sustainable development of chemical industry"
    },
    {
      "seq": 8,
      "describe_ch": "可分析作業場所之危害風險與具有工程倫理觀念",
      "describe_en": "Be able to analyze the hazard risk of workplaces and have engineering ethics"
    }
  ],
