  "description": {
    "sub_id3": null,
    "sub_name": "測量學",
    "sub_ename": "SURVEYING",
    "describe_ch": "測量學為工程建設之基礎科學，舉凡土木工程、建築工程、運輸工程…等，皆需藉由測量，得到工程設計所需之基本資料。本課程使學生了解測量原理及作業技術，使理論與實際結合。",
    "describe_eh": "Surveying is the fundamental science to acquire necessary data of engineering design for construction such as Civil Engineering, Architectural Engineering, Transportation Engineering, .etc. Students in this course will understand the theory of surveying, operating techniques and practice the measure methods in the field.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
