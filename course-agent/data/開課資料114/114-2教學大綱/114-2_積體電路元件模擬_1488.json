  "description": {
    "sub_id3": null,
    "sub_name": "積體電路元件模擬",
    "sub_ename": "INTEGRATED CIRCUIT DEVICE SIMULATION",
    "describe_ch": "應用半導體製程與元件模擬軟體模擬各類半導體元件，學生將學習到基礎半導體各類元件經由設計與製作後的特性預估，可以結合所學的半導體元件理論與半導體製程經由模擬了解實際製作上的仿真結構與特性。",
    "describe_eh": "Apply the semiconductor process and device simulator to simulate the semiconductor devices. Students can use TCAD simulator to design and simulate semiconductor devices by changing the process and device structure.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道半導體製程與元件模擬軟體中何謂網、格點及定義電極、各類製程參數及各種材料。",
      "describe_en": "Knowledge for the definition of the mesh, grid of a semiconductor process and device simulator and how to define the electrode, and all kinds of process recipes and semiconductor materials."
    },
    {
      "seq": 2,
      "describe_ch": "應用半導體製程與元件模擬軟體進行元件結構設計及特性粹取。",
      "describe_en": "To apply semiconductor process and device simulator to design device structures and extract their characteristics."
    }
  ],
