  "description": {
    "sub_id3": null,
    "sub_name": "線性代數",
    "sub_ename": "LINEAR ALGEBRA",
    "describe_ch": "線性代數是許多現代數學及科學的基礎，為一理論、數值技術及應用之綜合，本科目標在於傳遞線性代數之核心觀念及其重要之應用。",
    "describe_eh": "Linear algebra is fundamental to a large part of modern mathematics. It is a blend of theory, numerical techniques, and applications. The objective of this course is to provide students a foundation of all the essentials of linear algebra and its significant applications.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解線性代數各個主題之重要定義及理論。",
      "describe_en": "Understand the key definitions and theorems of each topics of Linear Algebra."
    },
    {
      "seq": 2,
      "describe_ch": "能熟練演算線性代數之各項基礎運算。",
      "describe_en": "Be able to perform the fundamental mathematical  calculations regarding Linear Algebra."
    },
    {
      "seq": 3,
      "describe_ch": "能推導並證明線性代數之重要論據。",
      "describe_en": "Be able to direct and demonstrate the proof of the key theorems of Linear Algebra."
    },
    {
      "seq": 4,
      "describe_ch": "能具有應用相關原理分析及建立運用線性代數解決有關工程與管理問題之基礎能力。",
      "describe_en": "Be able to applied the relevant principles of analysis and the establishment of the use of linear algebra to solve the problem of foundation engineering and management capabilities."
    }
  ],
