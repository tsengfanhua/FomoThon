  "description": {
    "sub_id3": null,
    "sub_name": "材料機械性質",
    "sub_ename": "MECHANICAL PROPERTIES OF MATERIALS",
    "describe_ch": "提供學生對於材料機械性質之整體瞭解，目的在於增強學生能創造實用材料之基礎能力。課程包括應力/應變張量、材料彈性、塑性、破壞科學、黏彈性與時間相依特性，內容涵蓋金屬、陶瓷、高分子與複合材料，解釋巨觀與微觀的綜合性理解。此課程為以課堂講授搭配hands-on作業的應用學科，課程實施將側重於學理原理與方法論。",
    "describe_eh": "Provide the whole picture of the Mechanical behaviors of materials. This course includes stress/strain tensor, elastic, plastic, fracture science, viscoelastic and time-dependent properties. This course examines metals, ceramics, polymers and composites, providing students with comprehensive understanding on macroscopic and microscopic aspects of the mechanical behavior of materials. This course combines theoretical lecturing and hands-on homework, emphasizing the principles and methodologies.",
    "pre_subname": "MSE2025材料力學",
    "pre_sub_id3": "MSE2025",
    "pre_sub_ename": "MSE2025 MECHANICS OF MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "描述材料機械性質之意義、列舉相關的材料規範與材料選擇的依據。",
      "describe_en": "Describe the meaning of mechanical properties of materials, list the standard of engineering materials and methods of material selection."
    },
    {
      "seq": 2,
      "describe_ch": "定義並說明材料強度(strength)的意義並選擇合適的試驗方法進行檢測與分析。\t",
      "describe_en": "Define and explain the meaning of strength of materials and testing methods."
    },
    {
      "seq": 3,
      "describe_ch": "定義並說明材料剛度(rigidity)的意義並選擇合適的試驗方法進行檢測與分析。\t",
      "describe_en": "Define and explain the meaning of rigidity of materials and testing methods."
    },
    {
      "seq": 4,
      "describe_ch": "評估表面處理程序對材料或零組件微結構、機械性能之影響。\t",
      "describe_en": "Estimate the effect on microstructure and mechanical properties of parts or components by surface treatment processing"
    }
  ],
