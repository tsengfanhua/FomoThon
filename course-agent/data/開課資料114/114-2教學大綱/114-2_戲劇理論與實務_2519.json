  "description": {
    "sub_id3": null,
    "sub_name": "戲劇理論與實務",
    "sub_ename": "DRAMATIC THEORY AND PRACTICE",
    "describe_ch": "介紹中西方戲劇知識，說明戲劇的起源流變、形式與內涵之外，也導讀戲劇經典作品，使學生認識角色人物、戲劇元素，並進行文本的分析與創作展演。",
    "describe_eh": "This course introduces Chinese and Western theatrical knowledge, explain the origin and development of the form and content of the drama, but also read the works of theater classics, enable students to understand the role of drama and analyzed with the creation of the text.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解戲劇的起源與發展。",
      "describe_en": "Understanding the origin and development of drama."
    },
    {
      "seq": 2,
      "describe_ch": "認識戲劇的形式與內涵，且能賞析經典作品。",
      "describe_en": "Understanding the form of drama and Chengdu, and can enjoy reading classic works of drama."
    }
  ],
