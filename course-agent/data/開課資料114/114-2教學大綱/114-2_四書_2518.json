  "description": {
    "sub_id3": null,
    "sub_name": "四書",
    "sub_ename": "THE FOUR BOOKS",
    "describe_ch": "四書係明瞭儒家生命學說之基本教材。由孔子仁教而開顯之內聖成德之學，凝成民族生命之常道。闡述四書之基本綱領及其義理之疏導說明，期體會人性善美，天人合德之精神。",
    "describe_eh": "The Four Books-the Great Learning, the Doctrine of the Mean, the Analects of  Confucius, and the Book of  Mencius-are the basic teaching materials for the understanding of the life theory of  Confucianism. Based on the Confucius's teaching of benevolence, the Four Books explain how to develop step by step into saints and make benevolence a pary of our people.  In this class, the essential points of the Four Books will be taught, and their rationales will elaborated, with the hope that students will appreciate the kindness and beauty of human nature and the belief that man is an integral part of nature.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
