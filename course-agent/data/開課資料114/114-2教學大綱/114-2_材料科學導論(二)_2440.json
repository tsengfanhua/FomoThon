  "description": {
    "sub_id3": null,
    "sub_name": "材料科學導論(二)",
    "sub_ename": "INTRODUCTION TO MATERIALS SCIENCE(2)",
    "describe_ch": "探討各類材料科學之範疇以及工程應用之領域。包含工程合金材料之平衡相圖與合金相圖之討論，高分子材料，陶瓷材料，奈米材料，生醫材料，磁性材料，光學材料與電子半導體材料。本課程除課堂講授外，將以分組上台報告的方式，提升學生報告之技巧與團體合作之能力。",
    "describe_eh": "This course aims to discuss the several materials and related engineering applications. The materials include engineering alloy and their phase diagram/ alloy phase diagram discussion. Polymeric materials, ceramic, nanomaterials, bio-materials, Magnetic materials, optical materials and electrical/semiconductor materials. In addition, the report skill and teamwork ability will be promoted to students by using report on the stage.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習材料之相圖與動力學原理，並探討如何依據上述原理來獲得所需之顯微結構。",
      "describe_en": " Learning the principles of phase diagram and kinetics, then exploring how to control the microstructure of alloys from these principles"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解五大類型材料(金屬、陶瓷、高分子、複材、半導體)之特性，並能應用於適當領域。",
      "describe_en": "Understanding the properties of various categories of materials (metals, ceramics, polymers, composites, semiconductors) and being able to employ them to appropriate fields"
    },
    {
      "seq": 3,
      "describe_ch": "知道如何找到材料科學之相關資訊、研究結果及規格標準，並可評估所獲資訊的適用性.",
      "describe_en": " Learning how to locate and access the information related to material science, then evaluating the applicability of the obtained information"
    }
  ],
