  "description": {
    "sub_id3": null,
    "sub_name": "物聯網安全",
    "sub_ename": "CYBERSECURITY FOR INTERNET OF THINGS",
    "describe_ch": "本課程系統性介紹物聯網（IoT）於軟體與硬體層面所面臨的各類網路安全挑戰，內容結合理論與實務，透過實驗操作與案例研討，引導學生學習相對應的防禦機制與風險緩解策略。此外，本課程強調動手實作，鼓勵學生設計並實現IoT安全防護的應用功能，藉以強化物聯網安全架構的整體認知與應用能力，培養具備實務操作與問題解決能力的資安專業人才。",
    "describe_eh": "This course systematically explores the cybersecurity challenges of Internet of Things (IoT) systems. Blending theoretical concepts with practical experience, students will use hands-on labs and case studies to examine common attack vectors and develop effective defense and risk mitigation strategies. The course is designed to cultivate cybersecurity professionals with practical skills and the ability to address complex security issues in IoT environments.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備分析攻擊以及防禦措施設計之能力",
      "describe_en": "Ability to analyze attacks and design corresponding defense mechanisms"
    },
    {
      "seq": 2,
      "describe_ch": "整合或設計軟/硬體安全機制之應用能力",
      "describe_en": "Ability to integrate or design security mechanisms in software and hardware applications"
    }
  ],
