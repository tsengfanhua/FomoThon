  "description": {
    "sub_id3": null,
    "sub_name": "圖文編輯(二)",
    "sub_ename": "ARTICLES AND GRAPHIC EDITING (II)",
    "describe_ch": "本課程為圖文排版及數位編輯之進階課程，進一步強化學生的編輯採訪及文稿撰寫之能力，鼓勵Adobe InDesign軟體並考取ACP國際證照，搭配中文系CDIO深碗專題課程，讓同學進行書刊、雜誌、新聞、商務通訊之實務編輯，並於期末策展發表。",
    "describe_eh": "This course mainly focuses on the editing ability of the Chinese department. It teaches the fundamentals of typesetting and editing in theory, and trains students to be proficient in MS Word and Adobe InDesign. Students will have the opportunity to obtain international licenses such as MOS and Adobe ACA. In practical sessions, students will practice editing books, magazines, news articles, business communications, etc., and exhibit their work at the end of the semester through curation and presentation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "精進編輯採訪及文稿撰寫之能力",
      "describe_en": "Improve the ability of editing, interviewing and manuscript writing."
    },
    {
      "seq": 2,
      "describe_ch": "精進數位圖文編輯之實務能力",
      "describe_en": "Improve the practical ability of digital graphic editing."
    }
  ],
