  "description": {
    "sub_id3": null,
    "sub_name": "水處理工程與設計",
    "sub_ename": "WATER TREATMENT ENGINEERING AND DESIGN",
    "describe_ch": " 給水工程與污水處理是本課程之兩大內容。給水工程包含取水、輸水、加壓抽水、混凝、沉澱、消毒、配水管網分析等。污水處理包含污水量估算、下水道設計、初步處理、生物處理、汙泥處理等。",
    "describe_eh": "Water supply and domestic wastewater treatment are the main course contents. Water supply engineering includes pumping station, coagulation, sedimentation, disinfection and water distribution. Sewage work includes sewage flow, sewer system, primary treatment, secondary treatment, sludge treatment and disposal.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
