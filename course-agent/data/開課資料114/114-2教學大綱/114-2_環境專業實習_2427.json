  "description": {
    "sub_id3": null,
    "sub_name": "環境專業實習",
    "sub_ename": "ENVIRONMENTAL INTERNSHIP",
    "describe_ch": "本課程期提供學生在畢業前至相關產業界實習，藉由整合課程理論與實務經驗，強化學生專業技能，達成與實務接軌的目的，並進一步提昇學生未來就業競爭力。",
    "describe_eh": "This course offers students an opportunity to work off-campus before their graduation. The purposes of this course are to let students integrate the theory and practice, strengthen the professional skills, and improve the competitiveness of students.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 9.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備整合理論與實務的能力。\t",
      "describe_en": "Ability to integrate the theory and practice."
    },
    {
      "seq": 2,
      "describe_ch": "具備協調溝通與團隊合作之能力。\t",
      "describe_en": "Ability to engage in effective communication and successful teamwork."
    },
    {
      "seq": 3,
      "describe_ch": "具備終身學習、專業倫理及社會責任的基本素養。\t",
      "describe_en": "Recognition of life-long learning, professional engineer ethics and social responsibilities."
    }
  ],
