  "description": {
    "sub_id3": null,
    "sub_name": "獨立研究(二)",
    "sub_ename": "INDEPENDENT STUDY(2)",
    "describe_ch": "為本學位學程必修課程。學生需與指導教授討論其領域之相關研究議題，經由蒐集、分析與檢測研究資料等訓練，將研究成果撰寫成研究論文，並且經由學位考之程序，完成該碩士學位。",
    "describe_eh": "This is a required course for the Ph.D. students. They should discuss with their advisor about the specific business research issue. Through the well training of how to collect and analyze the research data, they could write and finish the thesis. Finally, they can obtain the Master degree after passing the oral presentation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 4.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養學生獨立思考及理解研究問題的能力",
      "describe_en": "Cultivating students' ability to think independently and understand research problems."
    },
    {
      "seq": 2,
      "describe_ch": "應用跨領域理論與研究方法進行研究設計及資料分析",
      "describe_en": "Apply interdisciplinary theories and research methods to conduct research design and data analysis."
    },
    {
      "seq": 3,
      "describe_ch": "適切應用資訊科技及學術資源進行系統性的資料整合",
      "describe_en": "Appropriately utilize information technology and academic resources to conduct systematic data integration."
    },
    {
      "seq": 4,
      "describe_ch": "培養學生具備在國際會議及學術期刊上發表論文之能力",
      "describe_en": "Cultivating students' ability to publish research papers in international conferences and academic journals."
    }
  ],
