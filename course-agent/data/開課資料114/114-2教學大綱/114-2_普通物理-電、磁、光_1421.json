    "sub_ename": "GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS",
    "describe_ch": "此課程將傳授學生基礎物理概念與知識，以利未來專業科目之修習。內容包含電學、磁學、與光學三個主題。\n",
    "describe_eh": "General physics provides knowledge basis for all science and engineering students required for their advanced courses. The topics of this course include electricity, magnetism, and optics.",
    "pre_subname": "MATH1005微積分(一)、PHYS1003普通物理(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、PHYS1003 GENERAL PHYSICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解電學原理及其應用",
      "describe_en": "Understand the principles and know the applications of electricity"
    },
    {
      "seq": 2,
      "describe_ch": "熟悉基本直流電路分析。",
      "describe_en": "Be familiar with the analysis of basic DC circuit.　"
    },
    {
      "seq": 3,
      "describe_ch": "熟悉基本光學現象及其應用。　",
      "describe_en": "Be familiar with the basic Optical phenomena and their applications.　"
    }
