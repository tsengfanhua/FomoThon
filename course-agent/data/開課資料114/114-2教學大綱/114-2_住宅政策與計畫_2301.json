  "description": {
    "sub_id3": null,
    "sub_name": "住宅政策與計畫",
    "sub_ename": "HOUSING POLICY AND PLAN",
    "describe_ch": "本課程探討政策對住宅市場及住宅開發規劃的影響，並培養學生分析住宅問題與提出對策的能力，以回應不同社會群體的居住需求。課程內容涵蓋台灣住宅政策的演進、住宅商品化的發展歷程、社會住宅與租賃住宅政策的推動，以及政府在住宅供給與市場調控中的角色。此外，本課程將探討住宅類型、居住品質與住宅相關法規，並透過國內外案例研究與實地參訪，讓學生深入理解政策制定與執行的挑戰，以提升學生在住宅政策與計畫領域的專業知識與實務應用能力。",
    "describe_eh": "This course examines the impact of policies on the housing market, development, and planning while fostering students' ability to analyze housing issues and propose solutions to meet the needs of diverse social groups. The curriculum covers the evolution of Taiwan's housing policies, the commercialization of housing, the promotion of social and rental housing policies, and the government's role in housing supply and market regulation. Additionally, the course explores housing types, residential quality, and housing-related regulations. Through case studies and field visits, students will gain in-depth insights into the challenges of policy formulation and implementation, enhancing their professional knowledge and practical skills in housing policy and planning.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解住宅政策的形成與政策內容",
      "describe_en": "Understand the formation of housing policies and their content"
    },
    {
      "seq": 2,
      "describe_ch": "培養執行住宅政策與計畫之能力",
      "describe_en": "Develop the ability to implement housing policies and plans"
    },
    {
      "seq": 3,
      "describe_ch": "培養住宅問題分析與對策能力",
      "describe_en": "Develop the ability to analyze and solve housing problems"
    }
  ],
