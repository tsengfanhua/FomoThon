  "description": {
    "sub_id3": null,
    "sub_name": "管理類專案管理理論與實務",
    "sub_ename": "PROJECT MANAGEMENT KNOWLEDGE AND PRACTICE IN MANAGEMENT",
    "describe_ch": "藉由系統化的知識傳授、管理類設計案例的學習、管理類專題實作練習、試題測驗、口頭報告與互動討論的方式讓學生熟悉運用專案管理方法，來強化邏輯分析與問題解決能力、發揮規劃與監控的技巧，讓專案能夠如期、如質、如預算地有效完成。並輔導學生報考中華專案管理學會的專案助理(PMA)認證考試(教育部推薦之乙級證照)。",
    "describe_eh": "At first, to teach the knowledge of Project Management. And then, to apply Project Management in Management practice. Second part to help the students to get PMA Certificates with National Project Management Association (NPMA).",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備專案問題辨識、分析及解決之能力。",
      "describe_en": "To identify, formulate, and solve problems."
    },
    {
      "seq": 2,
      "describe_ch": "具備專案管理於溝通協調及團隊合作的應用能力。",
      "describe_en": "To communicate effectively and function on a team work."
    },
    {
      "seq": 3,
      "describe_ch": "暸解專案管理的基本知識與發展趨勢",
      "describe_en": "To know the basic knowledge of Project Management."
    },
    {
      "seq": 4,
      "describe_ch": "具備專案管理在管理實務的綜合運用能力",
      "describe_en": "To apply Project Management in Management practice."
    }
  ],
