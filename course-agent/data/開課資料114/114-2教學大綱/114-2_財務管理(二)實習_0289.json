    },
    {
      "seq": 3,
      "describe_ch": "瞭解與選擇權相關之融資策略",
      "describe_en": "Understand the option-related financing strategies"
    },
    {
      "seq": 4,
      "describe_ch": " 瞭解財務績效評估",
      "describe_en": "Understand the evaluation of financial performance"
    }
