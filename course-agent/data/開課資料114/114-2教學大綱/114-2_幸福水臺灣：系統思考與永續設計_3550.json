  "description": {
    "sub_id3": null,
    "sub_name": "幸福水臺灣：系統思考與永續設計",
    "sub_ename": "DESIGNING A FLOURISHING TAIWAN: SYSTEMS THINKING AND SUSTAINABLE DESIGN FOR WATER & WELL-BEING",
    "describe_ch": "本課程以「水」為核心，探討永續臺灣與幸福人生的終極課題，旨在培養學生應對未來複雜挑戰的「思維工具」。這不是一門傳統的環境科學課，而是一場跨領域思辨與解方設計實戰。課程將帶領學生攀登「知水、思水、護水」智水三層次，拆解臺灣水資源背後由歷史、經濟、科技與社會交織而成的複雜網絡，並透過專案導向的學習，將洞見轉化為具體的永續行動方案。最終目標不僅是達成環境的永續，更是為了追尋與自然和諧共存的「幸福人生」，培養能推己及人、付諸實踐的現代公民。",
    "describe_eh": "This course centers on the theme of water to explore the critical issues of a sustainable Taiwan and a happy life. It aims to equip students with the thinking tools needed for future complex challenges. This is an interdisciplinary journey of critical thinking and solution design, but not a traditional environmental science class. The course will guide students through three levels of \"water wisdom\"—Knowing, Thinking, and Protecting—to deconstruct the complex interplay of history, economics, technology, and society that shape Taiwan's water resources. Through project-based learning, students will transform insights into concrete, sustainable action plans. The ultimate goal is not only to achieve environmental sustainability but also to pursue a happy life in harmony with nature, fostering modern citizens who can empathize and take practical action.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "系統洞察力：培養學生整合多維度視角，分析臺灣水資源挑戰系統性成因與價值衝突，並學習運用敘事設計與數位傳播技巧，將複雜議題轉譯為引發公眾共鳴的溝通內容。",
      "describe_en": "Systemic Insight: To cultivate students' ability to integrate multidimensional perspectives in analyzing the systemic causes and value conflicts inherent in Taiwan’s water resource challenges. Furthermore, to equip them with narrative design and digital communication skills that enable them to translate complex issues into resonant content engaging the public."
    },
    {
      "seq": 2,
      "describe_ch": "解方設計力：教導學生具備整合多元方案，並與跨領域夥伴有效協作，設計出創新的永續行動藍圖，推動永續方案的實踐。",
      "describe_en": "Solution Design: To guide students in integrating diverse strategies and effectively collaborating with cross-disciplinary partners to design innovative blueprints for sustainable action, thereby driving the implementation of sustainability-oriented solutions."
    }
  ],
