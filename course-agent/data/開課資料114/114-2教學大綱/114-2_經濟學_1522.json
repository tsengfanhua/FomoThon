  "description": {
    "sub_id3": null,
    "sub_name": "經濟學",
    "sub_ename": "ECONOMICS",
    "describe_ch": "本課程介紹同學明瞭個體經濟學及部分總體經濟學的基本概念，課程目的在於讓學生熟悉經濟學理論和方法於都市計畫領域之應用。",
    "describe_eh": "This course introduces the basics micro economics and some macro economics topics which are relevant to urban planning.  The objectives of this course is to provide students with the ability to apply economic theories and methods to urban planning practice.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能認識經濟學與都市計畫相關議題的關係，及建立相關理論的基本認知。",
      "describe_en": "The basic knowledge of economics, in particular those related urban planning."
    },
    {
      "seq": 2,
      "describe_ch": "理解與都市相關的經濟學理論，及其可能應用的方式。",
      "describe_en": "The knowledge to apply economics to future urban planning related projects."
    }
  ],
