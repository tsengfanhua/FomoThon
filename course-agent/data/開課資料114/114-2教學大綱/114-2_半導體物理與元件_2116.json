  "description": {
    "sub_id3": null,
    "sub_name": "半導體物理與元件",
    "sub_ename": "SEMICONDUCTOR PHYSICS AND DEVICES",
    "describe_ch": "描述半導體的基本特性和它的傳導過程。討論所有主要半導體元件的物理和特性。首先討論對大部分半導體元件而言最關鍵的p-n接面，接下來討論雙載子和MOSFET、CMOS、DRAM和光電元件。",
    "describe_eh": "Describe the fundamental properties of semiconductors and their conduction process. Discuss the physics and characteristics of all major semiconductor devices. First, examine the p-n junction, which is the most critical component for most semiconductor devices. Then, explore bipolar junction transistors (BJTs), MOSFETs, DRAM, and optoelectronic devices.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
