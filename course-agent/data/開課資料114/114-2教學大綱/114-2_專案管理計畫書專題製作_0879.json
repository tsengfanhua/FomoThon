  "description": {
    "sub_id3": null,
    "sub_name": "專案管理計畫書專題製作",
    "sub_ename": "DEVELOPING PROJECT MANAGEMENT PLAN",
    "describe_ch": "由於修完初階課程「專案管理學」的學生已具有較成熟的專案管理知識，因此「專案管理計畫書專題製作」課程之目的為教授專案管理相關實務應用工具與技術，並讓學生運用這些工具和技術實做一本完整的專案管理計畫書。",
    "describe_eh": "At first, to teach the tool and technique of Project Management Planning Process. And then, to develop a?Project Charter,?Project Management Plan and Lesson Learned in practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
