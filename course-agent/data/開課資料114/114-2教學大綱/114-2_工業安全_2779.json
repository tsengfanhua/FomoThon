  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "PC44100",
    "sub_id": "01750",
    "scr_dup": "001",
    "sub_title": "介紹有關職業安全領域之基礎知識",
    "sub_title_en": null,
    "sub_describe": "1.職業安全衛生之發展與主管機關\n2.事業單位之安衛組織與管理人員配置\n3.職業災害定義與預防\n4.工作安全分析與安全作業標準\n5.機械安全防護與危險性機械設備\n6.火災爆炸預防\n7.電氣安全\n8.墜落與倒崩塌危害預防\n9.物料搬運與儲存安全\n10.手工具安全",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "工業安全",
    "sub_ename": "INDUSTRIAL SAFETY",
    "describe_ch": "本課程提供學生對工業安全之基本認識，藉由了解相關職業安全知識、法規及災害預防措施，可以提升學生對作業場所安全之認知及事故應變之能力。",
    "describe_eh": "This course provides students with an appreciation of the general principles of industrial safety. Introduction to related knowledge, regulations, and prevention actions, will promote the awareness of the safety working environment and increase the capability of emergency response in the future.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識工業安全之重要性。",
      "describe_en": "Be able to understand the importance of industrial safety."
    },
    {
      "seq": 2,
      "describe_ch": "了解及說明在現行法規之要求下，工業安全衛生組織之架構與功能。",
      "describe_en": "Be able to understand and describe the structure and function of the organization of industrial safety in each sector under current regulation."
    },
    {
      "seq": 3,
      "describe_ch": "能說明不同行業別在檢查及控制程序之要求及施行方式與紀錄處理。",
      "describe_en": "Be able to explain the differences of requirement, methodology and record booking between auditing and control process in different sectors."
    },
    {
      "seq": 4,
      "describe_ch": "能說明ㄧ般工業事故之潛在原因與因應對策。",
      "describe_en": "Be able to understand and describe the general causes and related preventions of the industrial accidents."
    }
  ],
