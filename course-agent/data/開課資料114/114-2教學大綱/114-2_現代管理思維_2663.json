  "description": {
    "sub_id3": null,
    "sub_name": "現代管理思維",
    "sub_ename": "MODERN MANAGEMENT THOUGHT",
    "describe_ch": "本課程旨在讓同學們深入瞭解傳統與當代管理的基本概念，以及新一代管理思想演進的意義，好的管理必須配合時代的潮流與時並進，配合個案探討，提供最新之管理議題，以瞭解管理新趨勢；培養學生使其學以致用，學習思索將這些思維如何應用在工作實務上及生活中。",
    "describe_eh": "This course aims to give students an in-depth understanding of the traditional and contemporary management, and the significance of the evolution of the management thought. This course is based on case studies to provide up-to-date management issues in order to understand new trends in management and apply theoretical knowledge into practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能分析各重要管理觀念之主要意義與內涵之能力。\t",
      "describe_en": "Analysis for the importance and meanings of the management thought."
    },
    {
      "seq": 2,
      "describe_ch": "能綜合管理思維以培養企業家精神之能力。\t",
      "describe_en": "Synthesis for the management thought to develop the entrepreneurship."
    }
  ],
