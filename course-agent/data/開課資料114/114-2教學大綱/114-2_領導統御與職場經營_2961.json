  "description": {
    "sub_id3": null,
    "sub_name": "領導統御與職場經營",
    "sub_ename": "LEADERSHIP AND WORKPLACE MANAGEMENT",
    "describe_ch": "職場經營是全世界就業人員的共同學問，也是需要善加深刻了解的意題， 能善加了解與利用領導統御與職場經營能讓自身仍至團隊得到正向的結果，反之則一敗塗地，失敗告終，製造業/服務業等各項產業的從業人員的經營均需領悟，舉凡各式案例介紹，讓同學對於這門課程所帶來的意涵等等走向有深入淺出的了解。",
    "describe_eh": "Workplace management is the common knowledge of employees all over the world, and it is also an issue that needs to be deeply understood.\n    Being able to understand and making good use of leadership and management in the workplace can lead to positive results for oneself and the team, and vice versa.\n    The operation of employees in various industries, such as manufacturing/service industries, need to be understood. There are various cases.\nExample introduction will be offered so that students can have an in-depth understanding of the implications of this course, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "每週講解不同符合領導統御與職場經營成功人士的介紹，加深同學對本堂課程的認同與學習能力，學習人文藝術經典教育，啟蒙學生跨域學習潛能。",
      "describe_en": "We will explain the introduction of different people who are in line with leadership and management and successful career management every week, deepen students' recognition and learning ability of this course, learn the classic education of humanities and arts, and enlighten students' cross-domain learning potential"
    },
    {
      "seq": 2,
      "describe_ch": "由每週不同行業類別的講解，符合本課程主題，讓同學對畢業後走向有更深刻了解，增加競爭力，了解與分析事務能力加強，對於各科系同學有探索科技知識原理，增進科普應用能力。",
      "describe_en": "The weekly explanations of different industry categories are in line with the theme of this course, so that students can have a deeper understanding of the direction after graduation, increase their competitiveness, and strengthen their ability to understand and analyze affairs. ability.."
    }
  ],
