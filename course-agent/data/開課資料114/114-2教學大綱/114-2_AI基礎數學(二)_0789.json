  "description": {
    "sub_id3": null,
    "sub_name": "AI基礎數學(二)",
    "sub_ename": "MATHEMATICS FOUNDATIONS OF ARTIFICIAL INTELLIGENCE (2)",
    "describe_ch": "本課程將涵蓋線性代數等基礎數學概念及其應用介紹，討論向量空間之間的特殊對映-線性轉換，以及線性轉換的性質與座標表示，還有線性轉換(矩陣)的特徵值、特徵向量等，使學生對向量空間與線性轉換有基本的認識。",
    "describe_eh": "This course will cover basic mathematical concepts such as linear algebra and its application introduction, discuss the special mapping between vector spaces-linear transformation, and the properties and coordinate representation of linear transformation, as well as the eigenvalues and eigenvectors of linear transformation (matrix) Etc., so that students have a basic understanding of vector space and linear transformation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解基本函數極限、連續、導數及積分之運算規則。",
      "describe_en": "Understand the basic function limit, continuity, derivative and integral operation rules."
    },
    {
      "seq": 2,
      "describe_ch": "應用微積分理論及運算技巧處理相關幾何問題及極大極小值問題等。",
      "describe_en": "Apply calculus theory and calculation skills to deal with related geometric problems and maximum and minimum value problems."
    }
  ],
