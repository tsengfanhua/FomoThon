  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB07139",
    "sub_id": "79240",
    "scr_dup": "001",
    "sub_title": "中醫藥的特色與應用",
    "sub_title_en": null,
    "sub_describe": "• 能用自己的詞彙定義何謂中醫：能夠描述中醫的特色及基本精神，並瞭解中醫學對環境與人體的觀點。\n• 能應用望聞問切四種診斷方法來瞭解自己中醫體質狀態，並能觀察與思考有哪些因素造成與影響了自己的體質。\n• 能針對自己的中醫體質的狀態，進行相關體質調養的規劃。\n• 能瞭解中醫藥在國內與國際之研究概況和特色發展。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "中醫學導論(一)",
    "sub_ename": "ELEMENTARY OF CHINESE MEDICINE (1)",
    "describe_ch": "本課程將介紹中醫源流與特色，陰陽、五行、臟腑、經絡與氣血津液等基礎理論；望聞問切四診之診斷技巧。病因學說包含風寒暑濕燥火等外感六淫，喜怒憂思悲恐驚等內傷七情。從而進行陰陽表寒熱虛實之八綱辨證，然後加以辨證論治，並瞭解中醫養生與預防醫學。",
    "describe_eh": "This course introduce basic theory of TCM. The content includes Yin & Yang, viscera & bowls, meridium, Qi & blood & body fluid. The technique of diagnosis composed of inspection, auscultation, interrogation and pulse taking. The etiology of diseases include exogenous factors, and internal injury. Eight principles for diagnosis will be introduced. Prescriptions and herbal drugs as well as prevention of disease and health preservation will be mentioned.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂中醫：能夠描述中醫的特色及基本精神",
      "describe_en": "Define Traditional Chinese Medicine(TCM) with their own words: Be able to describe the characteristics and basic theories."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明陰陽、五行及藏象學說對中醫及健康的影響",
      "describe_en": "Understand and be able to explain the effects of Ying-Yang, five phases and Visceral theories in TCM ."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解並應用望聞問切四種診斷疾病的方法",
      "describe_en": "Understand and be able to apply the four methods of diagnosis."
    }
  ],
