  "gradeRules": [
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB26310",
      "sub_id": "45203",
      "scr_dup": "001",
      "evalb_id": "L2",
      "score_rate": 10,
      "evalb_memo": "全勤者10分全拿\n缺曠課一小時扣1分，10分扣完為止\n根據行銷系辦規定，缺曠課超過12小時，學期成績不及格(建議5/15前棄選)\n欲請假者請出示假單或證明",
      "evalb_memo_en": null,
      "evalb_name": "點名",
      "evalb_name_en": "Roll call",
      "seq": 1
    },
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB26310",
      "sub_id": "45203",
      "scr_dup": "001",
      "evalb_id": "G5",
      "score_rate": 20,
      "evalb_memo": "跨域學習週繳交作業：故事腳本\n內容必須包含\n一、故事名稱\n二、世界觀時空簡介\n三、角色簡介與功能\n四、故事結構\n五、故事內容\n六、故事推廣企畫書",
      "evalb_memo_en": null,
      "evalb_name": "書面報告",
      "evalb_name_en": "Writing report",
      "seq": 2
    },
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB26310",
      "sub_id": "45203",
      "scr_dup": "001",
      "evalb_id": "D4",
      "score_rate": 15,
      "evalb_memo": "創作作品(1)：已知世界的邊界\n媒材不限：\n從最簡單的鉛筆、色筆、水彩，到線畫、拼貼、再到電腦繪圖，甚至以上列舉之外的工具（使用AI生成請先與我討論）\n以視覺圖像創作的方式，來描繪你大腦中的已知世界\n已知世界：\n內容不限，可以是認識這個城市的地圖、可以是親友關係的遠近、可以是幻想中的異世界、可以是知識的地圖、可以是決策流程圖",
      "evalb_memo_en": null,
      "evalb_name": "作業",
      "evalb_name_en": "Homework",
      "seq": 3
    },
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB26310",
      "sub_id": "45203",
      "scr_dup": "001",
      "evalb_id": "D1",
      "score_rate": 20,
      "evalb_memo": "期中present：我家的故事\n題材可以包含例如：\n父母或祖父母的戀愛故事、家族興衰史、某個家人的特殊經歷、只有我家才有的奇怪習俗、某個遠親的奇怪傳聞等等",
      "evalb_memo_en": null,
      "evalb_name": "期中考",
      "evalb_name_en": "Midterm examination",
      "seq": 4
    },
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB26310",
      "sub_id": "45203",
      "scr_dup": "001",
      "evalb_id": "I7",
      "score_rate": 20,
      "evalb_memo": "期末作品聯展\n作品主題：「我是一本打開的書......」\n作品類型：手工書（廣義的書、可以被閱讀）\n作品規格：最大請勿超過50*50*50cm",
      "evalb_memo_en": null,
      "evalb_name": "成果展演",
      "evalb_name_en": "Shows/ Exhibitions",
      "seq": 5
    },
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB26310",
      "sub_id": "45203",
      "scr_dup": "001",
      "evalb_id": "K4",
      "score_rate": 15,
      "evalb_memo": "創作作品(2)：我的異世界冒險\n不限制特定媒材，但必須包含視覺圖像創作的方式（不接受純文字），來描繪一個「你的異世界冒險」創作\n必須具備的「要素」：\n1. 有連續性的故事性，就算只是一幅畫，也必須在其中看見不同時間點的場景\n2. 有不同角色的設定：人物設定可以參考原型設定，必須清楚辨認出個性、風格與角色特質\n3. 異世界的獨特世界觀：可以自由設定，但要讓觀者感受到「這裡不是一般日常生活的世界」\n4. 有完整的旅程情節，有因果關係與敘事節奏(不強迫一定要有結局)",
      "evalb_memo_en": null,
      "evalb_name": "海報發表",
      "evalb_name_en": "Poster presentation",
      "seq": 6
    }
  ],
