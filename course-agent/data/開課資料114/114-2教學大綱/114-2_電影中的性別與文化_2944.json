  "description": {
    "sub_id3": null,
    "sub_name": "電影中的性別與文化",
    "sub_ename": "THE GENDER AND CULTURE IN THE FILM",
    "describe_ch": "本課程將透過學期中各週的上課時間，藉由七部電影與一本書的討論，針對不同國家、族群與文化的不同面向，以性別或性別平等的議題，作為討論的主軸，希望能協助同學們對此議題有更深入和多元的認識與了解。",
    "describe_eh": "This course will focus on the discussion of genders or gender equality in different aspects of different countries with ethnic groups and cultures through seven films and one book during class time. I hope it can help students to have a diverse understanding of this topic.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生了解電影敘事風格與文本分析。",
      "describe_en": "Understanding narrative style and text analysis in films."
    },
    {
      "seq": 2,
      "describe_ch": "透過電影賞析了解不同性別議題。",
      "describe_en": "Understanding gender issues through films."
    }
