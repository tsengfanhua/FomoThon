  "description": {
    "sub_id3": null,
    "sub_name": "應用數理統計學(二)",
    "sub_ename": "APPLIED MATHEMATICAL STATISTICS(2)",
    "describe_ch": "本課程研討統計理論，以建立其他統計課程基礎，使學生在統計之理論上有較深一層之瞭解，使期能更正確的運用統計方法。主題包括：抽樣和抽樣分配、點估計、區間估計、假設檢定。",
    "describe_eh": "This course provides a solid and well-balanced introduction to statistical inference and applications. Topics covered include point estimation, interval estimation and hypotheses testing.",
    "pre_subname": "STAT3001應用數理統計學(一)",
    "pre_sub_id3": "STAT3001",
    "pre_sub_ename": "STAT3001 APPLIED MATHEMATICAL STATISTICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解統計基本觀念",
      "describe_en": "Comprehension of   the basic concept of statistical inference and its applications."
    },
    {
      "seq": 2,
      "describe_ch": "理解統計估計基本觀念與應用",
      "describe_en": "Comprehension of   the fundamental theory of point estimation, confidence intervals and their applications in various academic fields."
    },
    {
      "seq": 3,
      "describe_ch": "應用假設檢定計基本觀念",
      "describe_en": "Apply  the fundamental theory of hypothesis testing ."
    }
  ],
