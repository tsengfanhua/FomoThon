  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB26139",
    "sub_id": "30478",
    "scr_dup": "001",
    "sub_title": null,
    "sub_title_en": "Subculture, Culture Study, Popular Culture, Pop Music, Fashion Style",
    "sub_describe": null,
    "sub_describe_en": "This course will look back at the after-war mass society of the United States and United Kingsoms through the history of subcultures and popular music, and lead students to differentiate the precise visual elements and dress code of each subculture styles such like Punk, Heavy Metal, Hippies, Hip-Hop etc. and learn to use these visual codes as a marketing tool."
  },
  "description": {
    "sub_id3": null,
    "sub_name": "風格學、次文化與行銷",
    "sub_ename": "STYLES, SUBCULTURE AND MARKETING",
    "describe_ch": "本課程回顧二十世紀至今具代表性的流行文化風潮，如反戰運動、嬉皮文化、龐克與嘻哈等，從時代背景與精神內涵出發，結合文本解讀與多感官風格分析，協助學生理解其文化意涵與行銷應用。課程亦強調建立文化風格資料庫與行銷工具箱，培養學生跨領域創新能力與全球文化分析視野，以因應新媒體時代的行銷傳播挑戰。",
    "describe_eh": "This course explores influential cultural movements from the 20th century to the present, including anti-war activism, hippie culture, punk, and hip-hop. Through historical context, conceptual analysis, and multi-sensory interpretation of style, students will gain a deeper understanding of cultural aesthetics and their relevance to marketing. The course emphasizes building a comprehensive style database and marketing toolkit, fostering students’ interdisciplinary creativity and global cultural awareness to meet the demands of marketing in the new media era.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生能創造具文化深度的行銷內容，學習問題解決能力與創新能力。\t",
      "describe_en": "Students can create culturally rich marketing content while cultivating problem-solving and innovation skills."
    },
    {
      "seq": 2,
      "describe_ch": "學生具備國際文化素養並能加以分析學生能分析全球文化風潮，理解其在行銷策略中的應用。",
      "describe_en": "Students are able to analyze global cultural trends and understand their application in marketing strategies."
    }
  ],
