  "description": {
    "sub_id3": null,
    "sub_name": "微製造學",
    "sub_ename": "MICRO FABRICATION",
    "describe_ch": "學習現代微電子之重要製程技術，以高等微影及蝕刻技術與材料為內容主軸。內容包括微製造概論、微影技術、10奈米以下的浸潤式微影，極紫外光微影，電漿蝕刻原理與技術、原子層蝕刻、立體型塑技術(LIGA 製程)等。",
    "describe_eh": "To learn the modern fabrication technologies of micro-electronic devices, focusing on materials and technologies of advanced micro-lithography and etching.   The course content includes overall introduction to micro-fabrication, micro-lithography, sub-10 nm immersion lithography, extreme ultra-violet (EUV) lithography, plasma etching, atomic layer etching, and 3D pattern transfer techniques (LIGA).",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解何謂微影技術:包括微影的歷史、原理及高等製程技術的說明\t",
      "describe_en": "To understand Micro-lithography including the history, principles and advanced processes."
    },
    {
      "seq": 2,
      "describe_ch": "理解蝕刻原理與技術:包括電漿原理的簡介、高等蝕刻製程及溼式蝕刻及乾式蝕刻的比較",
      "describe_en": "To understand the principles and techniques of plasma etching, including basic theories, advanced etching processes, and comparisons between dry and wet etching"
    },
    {
      "seq": 3,
      "describe_ch": "理解何謂立體型塑技術(LIGA製程):包括製程的背景以及LIGA製程的流程步驟說明\t",
      "describe_en": "To understand the fabrication techniques of 3-D structures by LIGA processes, including background, processes, and fabrication flow"
    },
    {
      "seq": 4,
      "describe_ch": "理解當代微製造技術之發展，包括應用與整合不同技術，並學習且理解當代次微製造技術的應用及市場的分佈情形\t",
      "describe_en": "To understand the development of modern micro-fabrication technologies, including the application and integration of varies technologies, and learn an overall view of the current applications and markets"
    }
  ],
