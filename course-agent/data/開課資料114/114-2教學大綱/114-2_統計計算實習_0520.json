  "readings": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB07122",
    "sub_id": "46281",
    "scr_dup": "001",
    "tpc_seq": 1,
    "tpc_book": "<div>pdf file of the textbook can be found on the website: https://cran.r-project.org/doc/manuals/R-intro.pdf.</div>\n\n<div>Lecture notes will be uploaded on iLearn for students to study.</div>\n\n<div>&nbsp;</div>\n\n<div>Other optional textbooks for reference:<br />\n1. Introduction to Scientific Programming and Simulation Using R, 2E.&nbsp;O. Jones, R. Maillardet, A. Robinson. ISBN: 978-1-4665-7001-6</div>\n\n<div>2. Statistical Computing with R, 2E. M. L. Rizzo. ISBN: 978-1-4665-5332-3</div>\n",
    "tpc_book_en": "<div>pdf file of the textbook can be found on the website: https://cran.r-project.org/doc/manuals/R-intro.pdf.</div>\n\n<div>Lecture notes will be uploaded on iLearn for students to study.</div>\n\n<div>&nbsp;</div>\n\n<div>Other optional textbooks for reference:<br />\n1. Introduction to Scientific Programming and Simulation Using R, 2E.&nbsp;O. Jones, R. Maillardet, A. Robinson. ISBN: 978-1-4665-7001-6</div>\n\n<div>2. Statistical Computing with R, 2E. M. L. Rizzo. ISBN: 978-1-4665-5332-3</div>\n"
  },
