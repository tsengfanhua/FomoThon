  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用R與SAS繪圖及如計算敘述統計量\r\n",
      "describe_en": "To apply  either R or  SAS to draw some statistical graphs and calculate some descriptive statistics.\r\n"
    },
    {
      "seq": 2,
      "describe_ch": "能應用程式設計之基本觀念諸如:迴圈、條件判斷式等。\r\n\r\n",
      "describe_en": "To apply  basic programming concepts such as do loops, if-then-else, etc.\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "應用機率函數產生亂數。\r\n",
      "describe_en": "To apply   probability functions to  generate random samples."
    },
    {
      "seq": 4,
      "describe_ch": "知道在何處可找到R的相關資訊。",
      "describe_en": "Knowing  for finding R  related information.\r\n"
    }
  ],
