    "sub_name": "統計計算實習",
    "sub_ename": "PRACTICE OF STATISTICAL COMPUTING",
    "describe_ch": "統計計算之入門課程，將會使用不同的程式語言及套裝軟體，包含了R程式語言及SAS套裝軟體。",
    "describe_eh": "Various programming languages and packages will be used, including R and SAS.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
