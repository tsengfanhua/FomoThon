  "description": {
    "sub_id3": null,
    "sub_name": "創新管理",
    "sub_ename": "INNOVATION MANAGEMENT",
    "describe_ch": "系統性架構與基礎概念建立，瞭解創新管理的理論與知識系統為何，並建立創新管理整體性觀念。經由創新企業案例的討論，協助使學生理解創新理論在新創事業、企業策略與研究發展上的運用為何。",
    "describe_eh": "The course in Innovation Management will introduce students to the basic characteristics of innovation. Students will study and will be able to apply main approaches, methods and technique, required for the effective management of innovations in contemporary companies and will gain knowledge needed to develop and manage innovation projects. Innovation management can include a variety of topics; here are three clarifications about the approach we will take in this course: First, we will approach innovation issues from the entrepreneur and manager's perspective. While most firms have specialized R&D, other functions must all interface with R&D. Second, this course will approach the management of innovation from a strategic perspective. As such, we will consider the relationship between processes and structures for innovation in firms, the strategies for exploitation and the environment in which these must be designed e.g., competition, rate of technological change, sources of innovation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 4.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "Describe the innovation process, including the innovation value chain, the role of champions, and commercializing an innovation.",
      "describe_en": "Describe the innovation process, including the innovation value chain, the role of champions, and commercializing an innovation."
    },
    {
      "seq": 2,
      "describe_ch": "Explain the process involved in managing creativity or innovation effectively and apply this knowledge to their own creative idea or innovation.",
      "describe_en": "Explain the process involved in managing creativity or innovation effectively and apply this knowledge to their own creative idea or innovation."
    },
    {
      "seq": 3,
      "describe_ch": "Analyze organizational practices that facilitate creativity and innovation.",
      "describe_en": "Analyze organizational practices that facilitate creativity and innovation."
    },
    {
      "seq": 4,
      "describe_ch": "Develop case study analysis skills (specifically, identifying critical issues in case studies and applying course material to case studies).",
      "describe_en": "Develop case study analysis skills (specifically, identifying critical issues in case studies and applying course material to case studies)."
    }
