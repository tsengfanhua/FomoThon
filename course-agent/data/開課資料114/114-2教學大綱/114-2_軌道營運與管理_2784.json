  "description": {
    "sub_id3": null,
    "sub_name": "軌道營運與管理",
    "sub_ename": "RAILWAY OPERATION AND MANAGEMENT",
    "describe_ch": "此課程主要講授軌道營運與管理的知識，從經營策略、票價規劃與行銷、維修策略、車站管理、行車調度管理、票務系統的規劃、公共運輸票證整合、營運安全以及相關附屬事業經營與管理等全方位的軌道經營的專業，有助於學生於軌道專業學習之初，充分了解軌道經營事業的組成與各子項目專業之實務經營要素，落實軌道專業之產學研究與應用。",
    "describe_eh": "This course aims at teaching a railway fundamental knowledge on the operation and management. This course focus on introducing the framework of business strategy, pricing planning, marketing planning, maintenance strategy, station management, ticketing system, ticket integration on public transportation, operation safety and related ancillary business operation and management in order to help students to understand the framework of railway operation and management. Thus, this course would integrate the sub-project of practical element on railway in order to fix in advance the academic and practical application.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1. 教授各運輸或物流系統之特性與相關基本概念",
      "describe_en": "Introduce the characteristics and basic concepts of transportation or logistics systems."
    },
    {
      "seq": 2,
      "describe_ch": "5.教授各運輸或物流系統之營運、企業經營管理之理論及實務概念",
      "describe_en": "To teach the theory and practical concepts of transportation and logistics system operation and business management."
    }
  ],
