  "description": {
    "sub_id3": null,
    "sub_name": "景觀植物",
    "sub_ename": "LANDSCAPE PLANTS",
    "describe_ch": "植物在建築空間或是戶外開放空間一直扮演著美化空間、調節氣候、生態營造與形塑空間的角色。植物本身之季節性顏色變化，開花及結果所產生的景觀效果，顯現出植物在環境設計上的重要地位。本課程目的訓練同學對常用景觀植物的認識，透過植栽設計手法練習，使同學如何利用植物來營造空間。",
    "describe_eh": "The purpose of this course is to introduce plant materials and how to use them to increase aesthetic value, adjust micro-climate and create eco-environment and spaces. Plants with seasonal changes and their own special characteristic are regarded as important landscape design elements. By knowing the plant and basic planting design procedures students will know how to use plants to create space and landscape.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識常用之景觀植物",
      "describe_en": "knowing landscape plants"
    },
    {
      "seq": 2,
      "describe_ch": "了解景觀植物在建築與環境設計上的應用",
      "describe_en": "Application of landscape plants in architectural and environmental design"
    },
    {
      "seq": 3,
      "describe_ch": "了解以景觀植物塑造空間及活動",
      "describe_en": "Understand the ways to use plants to create space for different spaces and activities"
    }
  ],
