  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "台灣寺廟與民間信仰",
    "sub_ename": "TEMPLES AND FOLK BELIEFS IN TAIWAN",
    "describe_ch": "寺廟作為台灣民間信仰的主要承載者，某種程度上，它扮演了將民間信仰的觀念與思想具象化的角色。因此，它是台灣民眾日常生活中，經驗與認識民間信仰最為重要的?所，在民眾宗教生活上具有其不可或缺性。本課程旨在通過對於台灣寺廟整體性的觀察與具體案例解析，使學生能熟悉台灣寺廟與民間信仰的基本內涵及其宗教意義。課程內容主要範圍將涵蓋下述諸面向：台灣民間信仰發展史略；寺廟與民間社會的互動；寺廟管理與信仰媒介人物；寺廟祀神及其空間配置；寺廟祭祀儀式與宗教活動；寺廟文物與藝術等。",
    "describe_eh": "As the main bearer of folk beliefs in Taiwan, temples play a role, to some extent, in visualizing the concepts and ideas of folk beliefs. Therefore, it is the most important place for Taiwanese to experience and learn about folk beliefs in their daily lives, and it is indispensable in the religious life of the people. The course aims to familiarize students with the basic connotations and religious meanings of temples and folk beliefs in Taiwan through a holistic observation of temples in Taiwan and specific case studies. It covers the following areas: the history of the development of folk beliefs in Taiwan, the interaction between temples and civil society, temple management and faith medium, temple deities and their spatial configurations, temple rituals and religious activities, and temple artifacts and art, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生認識臺灣寺廟與民間信仰的基本知識",
      "describe_en": "To understand the fundamental knowledge of temples and folk beliefs in Taiwan"
    },
    {
      "seq": 2,
      "describe_ch": "使學生瞭解並賞析寺廟建築與藝術文物之美。",
      "describe_en": "To appreciate the beauty of temple architecture and art relics of Taiwan"
    },
    {
      "seq": 3,
      "describe_ch": "使學生瞭解人和宗教間的關係，進而可以對人所處的社會及宗教行為進行適當的判斷及分析。",
      "describe_en": "To understand the relationship between human beings and religions to have the ability to analyze the behavior of cults and beliefs"
    }
  ],
