    {
      "seq": 1,
      "describe_ch": "了解資訊電機領域的專業養成步驟與內涵",
      "describe_en": null
    },
    {
      "seq": 2,
      "describe_ch": "了解職場倫理與法規思維",
      "describe_en": null
    }
