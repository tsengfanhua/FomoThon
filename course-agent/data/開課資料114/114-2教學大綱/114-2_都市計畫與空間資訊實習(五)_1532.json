    {
      "seq": 4,
      "describe_ch": "能應用實質環境設計與都市設計的專業技能",
      "describe_en": "Application of the techniques regarding physically environmental design and urban design."
    },
    {
      "seq": 5,
      "describe_ch": "能應用城市模擬於都市設計或景觀規劃",
      "describe_en": "Application of urban simulation to urban design or landscape planning.\r\n"
    },
    {
      "seq": 6,
      "describe_ch": "能應用專業倫理與社會服務於專業實務",
      "describe_en": "Application of professional ethics and social responsibility to professional practice."
    }
  ],
