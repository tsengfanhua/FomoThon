  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE10131",
    "sub_id": "46425",
    "scr_dup": "001",
    "sub_title": "大三的都市計畫與空間資訊實習主軸設定在環境規劃與設計的實務操作訓練，藉以提升整體環境品質，建構宜居的城鄉空間環境。",
    "sub_title_en": null,
    "sub_describe": "本次實習課程以一學年進行規劃，上學期課程主要聚焦於彰化縣大村鄉的整體環境規劃與發展策略，就大村鄉地區環境屬性、基盤設施、地方特色產業及文化等項目的調查及分析，解析大村鄉與周邊區域關聯性，找出地方發展定位，據以研擬相關願景目標與課題對策，進而提出大村鄉的環境規劃構想；下學期則以上學期之階段成果為基礎，藉由進一步的地方小尺度現勘調查以及在地工作坊的辦理，據以提出空間方案的基本設計以及軟體方案的企劃，並於期末舉辦公展活動，展示各組的學年成果，同時會邀請地方政府相關科課室長官、專家與在地居民一同參與，給予規劃或設計方案的回饋。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "都市計畫與空間資訊實習(五)",
    "sub_ename": "PRACTICE OF URBAN PLANNING AND SPATIAL INFORMATION(5)",
    "describe_ch": "本課程旨在訓練學生分組團隊合作，以地區整體性的空間發展考量為基礎，進行較大尺度的都市設計或景觀風貌等實質環境設計工作，並強調城市模擬的訓練與社會服務工作。",
    "describe_eh": "This course trains students to work together and conduct the physically environmental design, such as urban design or landscape design, in larger urban settings, based on the comprehensive consideration of local spatial development.  The training also emphasizes the urban simulation and social services.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
