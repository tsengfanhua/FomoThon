  "description": {
    "sub_id3": null,
    "sub_name": "共同外語文-日文(二)",
    "sub_ename": "COMMON FOREIGN LANGUAGE-JAPANESE (2)",
    "describe_ch": "本課程以共同外語文-日文（一）所習得的語彙句型為基礎，繼續學習日語動詞的變化形式及相關句型轉換，例如禮貌體及普通體等。透過課堂練習，培養學生的基礎口語溝通及短文閱讀能力，並引導學生認識日本文化。\r\n",
    "describe_eh": "Building on the vocabulary and sentence patterns learned in Common Foreign Language-Japanese I, this course continues with verb conjugations and sentence transformations, such as polite and plain forms. Through in-class practice, students will further develop their basic oral communication skills and the ability to read short texts in Japanese.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能看懂一般日常生活使用之基本漢字所書寫之固定詞句、短文及文章。",
      "describe_en": "Be able to read and understand set phrases, short passages, and texts written with basic kanji commonly used in daily life."
    },
    {
      "seq": 2,
      "describe_ch": "在課堂或日常生活情境中，能聽懂語速較緩的簡短對話，理解必要資訊，給予適切回應。",
      "describe_en": "Be able to comprehend slower-paced short conversations in class or daily situations, grasp essential information, and respond appropriately."
    },
    {
      "seq": 3,
      "describe_ch": "認識日本節慶、風俗習慣及日常應對禮儀等文化概念。",
      "describe_en": "Gain knowledge of Japanese cultural concepts, including festivals, customs, and everyday etiquette."
    }
  ],
