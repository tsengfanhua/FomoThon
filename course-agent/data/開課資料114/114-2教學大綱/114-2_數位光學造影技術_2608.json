  "description": {
    "sub_id3": null,
    "sub_name": "數位光學造影技術",
    "sub_ename": "IMAGING TECHNIQUES OF DIGITAL OPTICS",
    "describe_ch": "本課程涵蓋三個面向。首先我們將介紹傳統光學造影原理。接著我們將討論數位影像處理方法。最後我們將討論基於光學編碼與數位解碼的數位光學造影技術。本課程內容亦將結合實作以及分組專題進行。",
    "describe_eh": "This course contains three topics. First the principle of conventional imaging is introduced. In the second part, some methods of digital image processing are discussed. The third topic is the imaging techniques of digital optics, which are based on optical encoding and digital decoding. Experiments and a team project are also included in this course.",
    "pre_subname": "PHYS1002普通物理實驗(二)",
    "pre_sub_id3": "PHYS1002",
    "pre_sub_ename": "PHYS1002 GENERAL PHYSICS LAB.(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能進行數位影像處理。",
      "describe_en": "Be able to perform digital image processing."
    },
    {
      "seq": 2,
      "describe_ch": "能以空間光調制器進行計算造影。",
      "describe_en": "Be able to apply a spatial light modulator for computational imaging."
    },
    {
      "seq": 3,
      "describe_ch": "能夠處理及分析實驗結果。",
      "describe_en": "Be able to organize and to analyze the experimental results."
    },
    {
      "seq": 4,
      "describe_ch": "能透過小組展現團隊合作能力。",
      "describe_en": "Demonstrate team spirit through teamwork."
    }
  ],
