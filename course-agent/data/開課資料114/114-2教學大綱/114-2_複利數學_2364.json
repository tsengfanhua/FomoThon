  "description": {
    "sub_id3": null,
    "sub_name": "複利數學",
    "sub_ename": "THEORY OF INTEREST",
    "describe_ch": "介紹複利觀念和財務管理上之基礎數學，並應用至日常生活常見之理財問題。\n\n內容包含：利息與利率、現值與貼現、基本年金與一般年金等重要基本財務觀念，進而培養學生健全之理財(債)觀念與計算能力。",
    "describe_eh": "Introduce the basic mathematics concepts for compound interest and financial management.  Topics include the measurement of interest as interest and rate； present value and discount；Introductions and calculation of basic annuities including annuity-immediate, annuity-due and perpetuities etc. And discusses annuities for which payments are made more or less frequently than interest is convertible and annuities with varying payments.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "介紹何謂〝利息〞、利息的經濟理論、決定利率水準因素和實務上有關利率的基本名詞",
      "describe_en": "Introduce \"what is interest\" , an economic rationale for interest, determinants of the level of interest rates and basic name about interest in practice."
    },
    {
      "seq": 2,
      "describe_ch": "以基本微積分討論利息函數和本利和函數；現值和貼現等各種利率數量測定的基本原理。",
      "describe_en": "Use basic calculus to discuss the function of interest and amount. Study the various quantitative measures of interest are analyzed and the basic principles involved in the measurement of interest."
    },
    {
      "seq": 3,
      "describe_ch": "介紹和計算基本年金包含普通年金、既期年金和永久年金等。討論滋生息期和付款期相同與相等和付款額是等額的年金。",
      "describe_en": "Introduce and evaluate basic annuities including annuity-immediate, annuity-due and perpetuities etc. The basic annuities which the payment period and the interest conversion period are equal and coincide, and for which the payments are of level amount."
    },
    {
      "seq": 4,
      "describe_ch": "討論滋生息期比付款期多或少及每次付款額是變動，更複雜年金計算。",
      "describe_en": "Discusses annuities for which  payments are made more or less frequently than interest is convertible and annuities with varying payments."
    }
  ],
