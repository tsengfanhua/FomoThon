  "description": {
    "sub_id3": null,
    "sub_name": "財務攻防戰：開源與風險",
    "sub_ename": "MONEY WARS: EARNING AND DEFENDING YOUR FINANCES",
    "describe_ch": "本課程針對非金融學院的大一新生設計。課程將金融理財的「進攻（開源、儲蓄、投資）」與風險管理的「防守（辨識、預防、轉嫁）」相結合。課程將引導學生從生活情境出發，融合金融、風險管理與保險、財務工程與精算科學三個領域的基礎知識，培養學生在資訊爆炸時代下，做出明智財務決策的素養與實踐能力。",
    "describe_eh": "This course is designed for first-year students outside the College of Finance. It combines the “offense” of personal finance—earning, saving, and investing—with the “defense” of risk management—identifying, preventing, and transferring risks. Through everyday examples, students will learn basic concepts in finance, risk management, and actuarial science, and build the ability to make smart financial decisions in the information age.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建立基本生活金融素養，培養金錢管理與風險意識。",
      "describe_en": "Build basic financial literacy for everyday life, developing money management and risk awareness."
    },
    {
      "seq": 2,
      "describe_ch": "運用簡單工具規劃收支，發展個人化理財與節流策略。",
      "describe_en": "Use simple tools to plan income and expenses, and create personal saving and budgeting strategies."
    },
    {
      "seq": 3,
      "describe_ch": "透過任務實踐與創意思維，探索可行的開源方法並反思金錢行動力。",
      "describe_en": "Through practical tasks and creative thinking, explore ways to increase income and reflect on financial motivation."
    }
  ],
