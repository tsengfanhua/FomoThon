  "description": {
    "sub_id3": null,
    "sub_name": "金融機器學習",
    "sub_ename": "MACHINE LEARNING IN FINANCE",
    "describe_ch": "本課程旨在教授學生金融機器學習的實際應用，包括各種機器學習技術，如監督學習、非監督學習和強化學習。透過學術論文案例、模型評估、風險管理和倫理探討，培養學生在金融領域運用機器學習的能力。",
    "describe_eh": "This course aims to teach students the practical applications of machine learning in finance, covering various machine learning techniques such as supervised learning, unsupervised learning, and reinforcement learning. Through academic paper cases, model evaluation, discussions on risk management, and ethical considerations, it cultivates students' ability to apply machine learning in the field of finance.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
