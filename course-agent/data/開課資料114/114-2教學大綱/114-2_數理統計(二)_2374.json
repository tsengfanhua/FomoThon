  "description": {
    "sub_id3": null,
    "sub_name": "數理統計(二)",
    "sub_ename": "MATHEMATICAL STATISTICS(2)",
    "describe_ch": "數理統計(二)介紹好的估計量需具備那些性質及介紹各種估計量的定義及其性質.內容包含點估計( 最大概似估計量,動差法估計量,均方差估計量)、區間估計、充分統計量與完備性(均勻最小變異不偏估計量)。",
    "describe_eh": "In this course, we introduce the main properties of a good estimators, and discuss the definition and method for finding estimators and its properties.Topics include the Point Estimations(maximum likelihood estimator,moment method estimator,mean square error estimator) ；Confidence intervals；Sufficient statistics and Completeness(uniformly minimum variance unbiased estimator).",
    "pre_subname": "MATH2012統計學、MATH2011機率論",
    "pre_sub_id3": "MATH2012",
    "pre_sub_ename": "MATH2012 STATISTICS、MATH2011 PROBABILITY",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解點估計的意義及評估一個估計量之優與劣，並熟悉最大概似估計量及動差法估計量之求法，即有能力分析這些估計量之基本性質並透過數據分析之。",
      "describe_en": "Let students know the meaning of the point estimation master their skills to find the maximum likelihood estimator and the estimator finding by method of moments, and have ability to analysis these estimators, and analysis these estimators based on given"
    },
    {
      "seq": 2,
      "describe_ch": "了解充份統計量的意義及其應用，並了解完備統計量及其應用。並熟悉唯一最小變異不偏估計量之求法及獨立性之探討。",
      "describe_en": "Let students know the meaning of the sufficient statistics and the complete statistics, and master their skills to find the unique minimum variance unbiased estimator and discuss the independence about them."
    },
    {
      "seq": 3,
      "describe_ch": "區間估計的了解及其計算。",
      "describe_en": "Let students know the meaning of the interval estimation and master their skills to find them."
    },
    {
      "seq": 4,
      "describe_ch": "檢定假設之了解及其計算。",
      "describe_en": "Let students know the meaning of the hypotheses and master their skills to find the optimal test."
    }
  ],
