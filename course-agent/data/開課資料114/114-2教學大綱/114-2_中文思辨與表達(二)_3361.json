  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "XF02110",
    "sub_id": "05612",
    "scr_dup": "079",
    "tpa_score_new": "<div>參考出席率、課堂互動與參與討論、作業提交及三次測驗成績</div>\n",
    "tpa_score_new_en": null,
    "course_pol": "1.尊重智慧財產權\n2.誠實參與考試\n3.注意發言禮貌\n4.能與小組互動討論\n5.作業準時繳交\n6.小組報告時能準時到教室\n7.上課準時出席",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<div>.尊重智慧財產權</div>\n\n<div>&nbsp;</div>\n\n<div>剽竊是對學術信任的嚴重破壞。在學習作業中，我們的言論和想法就是我們作業的價值；因此將他人的作品當作自己的作品繳交，是一種盜竊行為。當您使用別人的文字和想法時，無論是著名作家還是同學的作品，而不註明這些文章、詞語和想法的來源出處，您的行為就是在抄襲。原創性作品是我的底線，抄襲的作品將會收到&ldquo;0&rdquo;或&ldquo;不及格&rdquo;的分數。</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": null
  },
