  "description": {
    "sub_id3": null,
    "sub_name": "感測與量度工程",
    "sub_ename": "SENSING AND MEASUREMENT ENGINEERING",
    "describe_ch": "這課程的目的是呈現工程量測分析的方法與設計，特別討論工業儀錶之使用技術，這些技術被設計成促使學生理解有關於感測與控制工程的主題，提高對於自動控制的學習動機與興趣。",
    "describe_eh": "The objective of this course is to present methods of mechanical measurement and design, particularly with discussion of instrumentation techniques. The approach is designed to enable them to understand the topics related to sensors and control, while motivating their interest in the automatic control theory.",
    "pre_subname": "MATH1005微積分(一)、AUTO2000工程數學(一)、IEE1010普通物理-電、磁、光",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、AUTO2000 ENGINEERING MATHEMATICS(1)、IEE1010 GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用數學基礎以瞭解量度工程基本知識",
      "describe_en": "Apply mathematic foundation to understand the basic knowledge about measurement engineering."
    },
    {
      "seq": 2,
      "describe_ch": "理解量度工程各項性能的定義與定理",
      "describe_en": "Comprehend for the definitions or theories of measurement engineering performance."
    },
    {
      "seq": 3,
      "describe_ch": "應用模擬分析工具對量度工程完成分析與設計",
      "describe_en": "Application for the simulation tool box to measurement engineering analysis and design."
    },
    {
      "seq": 4,
      "describe_ch": "對量度工程具備描述問題、訂定規格、建構模型之各項分析能力",
      "describe_en": "With analysis capability on describe problems, define specifications and construct model for measurement engineering."
    }
  ],
