  "description": {
    "sub_id3": null,
    "sub_name": "功能性纖維",
    "sub_ename": "FUNCTIONAL FIBERS",
    "describe_ch": "傳統的纖維已不能滿足現代社會功能化與智慧化的要求，以及人們追求智能、前衛、時尚、與眾不同的消費需求。可穿戴具功能性智慧服裝等先進的纖維產品可作為第二層皮膚，進而加強人與外部環境的資訊交換。在這課程中，教導賦予纖維功能與智慧等特性的進展，包含高性能、自清潔、吸濕速乾、防水透濕、抗菌、自發熱、自發電、纖維狀鋰離子電池、與電致變色纖維。",
    "describe_eh": "Modern demands in functional, smart, fashion and unique products have exceeded what traditional textile can offer. In addition, smart wearable devices can provide information exchange between human body and the surrounding environment. Therefore, this course will include the current development in functional and smart textile, as well as properties like high performance, self-cleaning, moisture absorption and quick drying, waterproof and moisture permeability, antibacterial, self-heating, self-generation, fibrous lithium-ion battery, and electrochromic fiber.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使同學了解賦予傳統纖維與合成纖維功能性背後原理",
      "describe_en": "To establish the understanding on functionality between traditional fibers and synthetic fibers."
    },
    {
      "seq": 2,
      "describe_ch": "掌握功能性纖維材料特性與加工技術",
      "describe_en": "To understand the fiber characteristics and processing technology."
    },
    {
      "seq": 3,
      "describe_ch": "具備分析不同功能性纖維技術優劣與應用領域",
      "describe_en": "To determine the advantages and disadvantages of different functional fibers and their applications."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解功能性與智慧纖維的發展趨勢",
      "describe_en": "To understand the trend in functional and smart fibers development."
    }
  ],
