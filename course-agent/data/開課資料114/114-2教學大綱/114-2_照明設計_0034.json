  "description": {
    "sub_id3": null,
    "sub_name": "照明設計",
    "sub_ename": "LIGHTING DESIGN",
    "describe_ch": "照明設計基本原理為從事空間設計所不可或缺之基礎知識。授課主題包括：光源特性、人工光源及照明燈具、照度計算、以及照明環境心理學，並透過照明環境設計案例及照明輔助軟體之介紹，掌握光環境設計的方法與技巧。",
    "describe_eh": "Lighting Design is an essential science for space or architecture design. The topics of this course include optics, artificial lighting and luminaries, illuminance calculation, and environmental psychology of lighting. Through the introduction of lighting cases and application of CAD, lighting design methods and techniques could be understood.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠定義與敘述光學的基本知識、辨識各種類型的照明光源與照明系統，做為照明設計的基礎。",
      "describe_en": "Define and  express basic Optic knowledge ；Distinguish all kinds of light sources and lighting systems."
    },
    {
      "seq": 2,
      "describe_ch": "能認知、分析並鑑賞空間照明設計的美學，並能清楚轉化為個人對照明設計的構想。",
      "describe_en": "Comprehend, analyze and appreciate the sense of lighting design which can be turned to initial design concepts."
    },
    {
      "seq": 3,
      "describe_ch": "能應用照明設計原理，因應不同類型空間使用合宜的照明技巧，歸納出理想的解決方案。",
      "describe_en": "Make use of lighting design principles to solve different space problems with suitable lighting skills and and draw appropriate conclusions."
    }
  ],
