  "description": {
    "sub_id3": null,
    "sub_name": "智慧城市治理與行銷",
    "sub_ename": "SMART CITIES GOVERNANCE AND MARKETING",
    "describe_ch": "本課程介紹如何透過智慧科技協助城市管理單位解決都市相關議題，並分析台灣主要城市建構智慧城市之歷程及推動重點，最後以案例分析或實地參訪瞭解結合市場行銷策略推廣智慧城市之治理成效。",
    "describe_eh": "This course introduces the ways that the city management authorities solve urban-related issues through smart technology, analyzes the process and promotion focus of building smart cities in major cities in Taiwan. Finally, case studies or field visits will be applied to help students on understanding the promotion of smart cities governance effectiveness through marketing strategies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解城市治理及行銷之原則與概念",
      "describe_en": "To understand the principles and concepts of city governance and marketing."
    },
    {
      "seq": 2,
      "describe_ch": "能評估協助城市治理之智慧科技",
      "describe_en": "To assess the intelligent technology needed for city governance."
    },
    {
      "seq": 3,
      "describe_ch": "理解城市治理與行銷之跨域溝通與整合技巧",
      "describe_en": "To understand the cross-domain communication and integration skills of urban governance and marketing."
    }
  ],
