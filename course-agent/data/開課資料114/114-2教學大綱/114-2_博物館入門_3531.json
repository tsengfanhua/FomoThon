  "description": {
    "sub_id3": null,
    "sub_name": "博物館入門",
    "sub_ename": "INTRODUCTION TO MUSEOLOGY",
    "describe_ch": "博物館是文化遺產管理與照護的單位，也是向公眾傳遞知識的教育機構。本課程將介紹博物館的發展與其主要功能，如研究、蒐藏與展示，同時輔以實作。希望藉此讓同學對博物館作為文化遺產詮釋的機構與方法有基礎的認識。",
    "describe_eh": " Museum is a heritage institution which convey the knowledge transmission to the public.  This course will introduce the historical aspect of museum development, and how museums fulfill their key roles in collecting, preserving, and displaying the cultural heritages. Students will have to attend a project to practice curating skills. Students will be familiar with how museum contribute to the heritage interpretation in contemporary society.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解博物館的發展史與功能",
      "describe_en": "To understand the history and functions of museums"
    },
    {
      "seq": 2,
      "describe_ch": "熟悉文化詮釋與再現的方法",
      "describe_en": "Be familiar with the method of cultural interpretation and representation"
    }
  ],
