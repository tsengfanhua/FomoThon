  "description": {
    "sub_id3": null,
    "sub_name": "環境化學特論",
    "sub_ename": "SPECIAL TOPICS IN ENVIRONMENTAL CHEMISTRY",
    "describe_ch": "本課程是環境化學的延續課程，主要強調污染物在環境系統中的化學平衡、反應動力學、轉化和傳輸。課程內容亦介紹環境新興污染物的來源、影響和防治；土壤碳儲存和封存；以及現代化環境分析技術等環境化學重要相關議題。",
    "describe_eh": "This course primarily extends and strengthens the concepts of environmental chemistry. Attention is paid to understanding chemical equilibrium, kinetics, transformation, and transport of contaminants in the environment systems as applied to environmental engineering. Additional topics of this course include: (1) sources, effects, and control of contaminants of emerging concern (CECs) in the environment; (2) soil carbon storge and sequestration; and (3) modern environmental analysis techniques.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解污染物於環境中的宿命和傳輸。\t",
      "describe_en": "Understand the fate and transport of contaminants in the environment."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解環境新興污染物的來源和防治，以及其對人類和生態環境的影響。\t",
      "describe_en": "Understand the sources and control of environmental contaminants and their impact to human and ecological health."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解土壤碳儲存和封存的潛力\t",
      "describe_en": "Understand the potential of soil carbon storage and sequestration"
    },
    {
      "seq": 4,
      "describe_ch": "如何應用現代化儀器分析環境樣品\t",
      "describe_en": "Understand the analysis of complex environmental samples by modern instruments"
    },
    {
      "seq": 5,
      "describe_ch": "如何利用環境化學知識處理環境污染的實務問題\t",
      "describe_en": "Provide examples of using our knowledge of environmental chemistry to solve engineering practice problems of environmental contamination"
    }
  ],
