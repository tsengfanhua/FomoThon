  "description": {
    "sub_id3": null,
    "sub_name": "佛家思想",
    "sub_ename": "BUDDHIST THOUGHT",
    "describe_ch": "佛教思想東傳至中國，影響中國文化頗深；而印度佛教在中國生根萌芽，也受到中國文化的影響，而產生變化。佛教思想與中國文化，兩者互為影響，形成一新型的文化思風貌。\r\n本課程簡介印度佛教、中國佛教，從釋迦牟尼佛一生弘化開始，進而分析中國各宗派祖師思想，並作印度佛教聖地實景拍攝分享。\r\n本課程主旨在於：研析儒佛思想，提升人文素養，啟發覺智人生，培養真知灼見，積極關懷生命。\r\n",
    "describe_eh": "Buddhist thought passes on to China affects the Chinese culture quietly deep. But the Indian Buddhism not only takes root the seed in China, but also is influenced by the Chinese culture and makes the change. The Buddhist thought and the Chinese culture, both are mutually the influences, forms a new culture to a new thinking style. This curriculum introduces the Indian Buddhism; the Chinese Buddhism, from the Sakyamuni Buddha life start, then analyzes the Chinese various sects founder thought, and makes the Indian Buddhism Holy Land real-life scenery photography share. This curriculum primary intention lies in: Deliberates the Confucian Buddha thought, promotes humanities literacy, enlighten the wisdom life, raises the penetrating judgment, and shows loving care for the life positively.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "幫助學生了解佛法智慧，培養具全方位人生觀。",
      "describe_en": "To help students to understand the philosophy of Buddhism and broaden their horizons."
    },
    {
      "seq": 2,
      "describe_ch": "幫助學生客觀了解人事物真相，建立正確看法與見解。",
      "describe_en": "To help students to develop the objective and correct understanding of lives."
    },
    {
      "seq": 3,
      "describe_ch": "幫助學生認識自己，安定身心，開發智慧與潛能",
      "describe_en": "To help students to understand themselves and enhance their inner lives"
    }
  ],
