  "description": {
    "sub_id3": null,
    "sub_name": "中國文物欣賞",
    "sub_ename": "APPRECIATION OF CHINESE ARTIFACTS",
    "describe_ch": "中國文物欣賞之開設，乃一般之通識科目。針對理、工、商等院學子認識博大精深之中華文物(如陶器、瓷器、銅器、漆器、雕器、書法、繪畫、織繡、琺瑯、圖畫、文獻等)之入門性介紹，進而對文物之歷史、鑑賞等之基本知識，藉陶冶心性，提供研發興趣。",
    "describe_eh": "This course is a general knowledge course. The class is for students from the science, engineering and business faculties. It is hoped they will gain a good understanding of Chinese relics, for example pottery, porcelain, copper ware, lacquer carving, penmanship, drawing, embroidery and painting. The aim is to help students have a basic knowledge and appreciation of historical relics and perhaps develop a new area of research interest.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養學生欣賞中國文物之美，藉以陶冶心性，宣揚文化，並提振民族精神。",
      "describe_en": "Advocate culture and promote the spirit of national identity by treasuring Chinese relics."
    },
    {
      "seq": 2,
      "describe_ch": "開拓視野、增廣見聞、啟發思考與判斷能力。",
      "describe_en": "Broaden students’ views of the world and enlighten thinking and judgment."
    }
  ],
