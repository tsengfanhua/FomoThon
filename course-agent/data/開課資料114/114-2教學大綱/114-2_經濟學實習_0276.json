  "description": {
    "sub_id3": null,
    "sub_name": "經濟學實習",
    "sub_ename": "ECONOMICS PRACTICE",
    "describe_ch": "介紹經濟學的基本問題、價格機能的運作、市場效率的衡量、及政府各種價格與數量管制措施對市場效率的影響，再介紹消費者行為及選擇、廠商的生產與成本理論、以及不同市場結構下廠商的訂價行為。",
    "describe_eh": "This course will introduce the fundamental economic problems,operations of price mechanism, measurement of market efficiency, and the influence of alternative controls in price and quantity of government on market efficiency, then will introduce consumer behaviors and choice,production and cost theories of firm, and the pricing behaviors of firms under different market structures.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解基本的經濟問題，供需原理，價格機能的運作及相關實例之應用。",
      "describe_en": "Comprehending fundamental economic problems, principles of supply and demand, operations of price mechanism and applications"
    },
    {
      "seq": 2,
      "describe_ch": "理解市場失靈之原因及其對策。",
      "describe_en": "Comprehending the main causes of market failure and possible means of correction."
    },
    {
      "seq": 3,
      "describe_ch": "理解廠商的生產理論，及短期與長期成本理論。",
      "describe_en": "Comprehending firm's production theory and the short-run and long-run cost theories."
    },
    {
      "seq": 4,
      "describe_ch": "理解不同的市場結構，及廠商的訂價行為。",
      "describe_en": "Comprehending alternative market structures, and firm's pricing behavior."
    }
  ],
