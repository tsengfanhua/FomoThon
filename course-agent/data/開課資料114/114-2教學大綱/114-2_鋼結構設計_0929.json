  "description": {
    "sub_id3": null,
    "sub_name": "鋼結構設計",
    "sub_ename": "STEEL STRUCTURE DESIGN",
    "describe_ch": "本課程為鋼結構設計的基礎課程，其目的在提供學生設計鋼結構構件及接合的基本觀念，以及介紹目前國內設計鋼結構所用的規範及相關規定。課程重點在使學生能具備分析以及設計鋼結構中各個單獨構件（如拉力構件、壓力構件、梁及梁柱等）的能力，並能初步了解鋼構件間的連結設計。",
    "describe_eh": "This is an elementary course of steel structure design.  The objectives are to provide fundamental theory and concepts to design steel structures, and to introduce the design specifications.  Emphasis is placed on developing the students' ability to design individual members (such as tension member, compression member, beams and beam columns) as well as simple connections of a steel structure.",
    "pre_subname": "CE2078材料力學",
    "pre_sub_id3": "CE2078",
    "pre_sub_ename": "CE2078 MECHANICS OF MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解鋼結構的特性及其優缺點",
      "describe_en": "To comprehend the feature and advantages/drawbacks of steel structures."
    },
    {
      "seq": 2,
      "describe_ch": "使用規範設計鋼結構的構件（如拉力構件、壓力構件、梁及梁柱等）",
      "describe_en": "To design steel members (such as tension members, compression members, beams and beam-columns) according to specifications."
    },
    {
      "seq": 3,
      "describe_ch": "使用規範設計鋼結構構件間的簡單接合",
      "describe_en": "To design simple connections of a steel structure according to specifications."
    }
  ],
