  "description": {
    "sub_id3": null,
    "sub_name": "施工進度規劃與控制",
    "sub_ename": "CONSTRUCTION SCHEDULING AND CONTROL",
    "describe_ch": "學習營建工程之進度規劃與控制作業，事先規劃預定進度表與掌控進度，及專案規劃與排程技術的實務應用，其目的為讓學生能清楚了解工程的整體性與工程進度控管，實際透過營建工程專案中常用之排程技術來掌握進度，於進入職場時能事半工倍。",
    "describe_eh": "To learn the scheduling and progress control process in construction projects, by making schedule charts in advance and then the practical use of project planning and task queuing techniques. The goal is to establish students' understanding of construction projects as a whole system, and the ability to take control over project schedule with common techniques, helping them to be more efficient when getting adapted in their career.",
    "pre_subname": "CEM3008營建管理",
    "pre_sub_id3": "CEM3008",
    "pre_sub_ename": "CEM3008 CONSTRUCTION MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解營建工程等作業程序之能力",
      "describe_en": "The ability to understand the process in construction project operations."
    },
    {
      "seq": 2,
      "describe_ch": "理解如何實際運用排程技術管控進度",
      "describe_en": "Understand how to practically use task scheduling techniques to control project progress."
    },
    {
      "seq": 3,
      "describe_ch": "實際於營建工程應用及管理",
      "describe_en": "Practical application of knowledge in real-world construction project management."
    }
  ],
