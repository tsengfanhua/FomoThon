  "description": {
    "sub_id3": null,
    "sub_name": "高頻電路設計",
    "sub_ename": "RADIO FREQUENCY CIRCUIT DESIGN",
    "describe_ch": "本課程簡要介紹射頻電路與系統的分析與設計。此課程兼具架構與電路的講解，主要的內容著重點放在雙極性電晶體與金氧半場效電晶體的電路上。",
    "describe_eh": "This course deals with the analysis and design of RF circuits and systems. It emphasizes both architecture and circuit. The primary focus is on bipolar and CMOS circuit design.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具有基本的知識來描述不同系統架構之功能、電路方塊圖及其優/缺點。",
      "describe_en": "With the fundamental knowledge to describe the function, circuit block diagram, advantage/disadvantage of different system topology."
    },
    {
      "seq": 2,
      "describe_ch": "在特定電路規格下，具有應用的能力去設計一個合理的高頻電路。",
      "describe_en": "With the applied capability to design a reasonable RF circuit under the specific specifications."
    }
  ],
