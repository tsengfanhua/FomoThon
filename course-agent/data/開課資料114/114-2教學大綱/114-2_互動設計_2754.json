  "description": {
    "sub_id3": null,
    "sub_name": "互動設計",
    "sub_ename": "INTERACTION DESIGN",
    "describe_ch": "This course introduces students to the principles, methods, and practices of Interaction Design. It focuses on creating meaningful, usable, and engaging digital and physical interactive applications. Students will design and prototype User Experiences (UX) and Graphic User Interfaces (GUI) for screen-based applications on web and mobile devices. And interactive objects and environments in the form of Wearable Technology, Internet of Things devices, and Ubiquitous Computing experiences.",
    "describe_eh": "This course introduces students to the principles, methods, and practices of Interaction Design. It focuses on creating meaningful, usable, and engaging digital and physical interactive applications. Students will design and prototype User Experiences (UX) and Graphic User Interfaces (GUI) for screen-based applications on web and mobile devices. And interactive objects and environments in the form of Wearable Technology, Internet of Things devices, and Ubiquitous Computing experiences.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "Students learn to apply theoretical interaction design principles by implementing practical industry-standard design and production methodologies.",
      "describe_en": "Students learn to apply theoretical interaction design principles by implementing practical industry-standard design and production methodologies."
    },
    {
      "seq": 2,
      "describe_ch": "Students can effectively conduct, evaluate, interpret, and synthesise primary and secondary research to understand the requirements of interactive application users.",
      "describe_en": "Students can effectively conduct, evaluate, interpret, and synthesise primary and secondary research to understand the requirements of interactive application users."
    },
    {
      "seq": 3,
      "describe_ch": "Students learn to exercise communication skills in multidisciplinary design teams to collaborate effectively in various design situations.",
      "describe_en": "Students learn to exercise communication skills in multidisciplinary design teams to collaborate effectively in various design situations."
    },
    {
      "seq": 4,
      "describe_ch": "Students can apply critical and reflective design thinking to distinguish, analyse, and compare the meaningfulness, usability, and engagement of digital and physical interactive systems.",
      "describe_en": "Students can apply critical and reflective design thinking to distinguish, analyse, and compare the meaningfulness, usability, and engagement of digital and physical interactive systems."
    }
  ],
