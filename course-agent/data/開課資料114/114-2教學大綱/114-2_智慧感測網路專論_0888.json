  "description": {
    "sub_id3": null,
    "sub_name": "智慧感測網路專論",
    "sub_ename": "SPECIAL TOPICS ON SMART SENSOR NETWORK",
    "describe_ch": "本課程說明各類感測系統網路及其元件之基本概念，其次透過實驗模組體驗其運作方式，最後藉由案例研討或現場參訪介紹各相關領域之實際應用。",
    "describe_eh": "This course explains the basic concepts of various types of sensing system networks and their components followed by experiencing the operation of systems through the experimental modules. Finally, students will be guided to the practical applications of related fields through case studies or site visits.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解感測元件及系統之運作原理",
      "describe_en": "To understand the operational concepts of sensing components and system."
    },
    {
      "seq": 2,
      "describe_ch": "能夠操作感測系統之實驗模組",
      "describe_en": "To operate the experimental modules of sensing systems."
    },
    {
      "seq": 3,
      "describe_ch": "能夠分析相關應用領域之需求及設計",
      "describe_en": "To analyze the needs and design of related application fileds."
    }
  ],
