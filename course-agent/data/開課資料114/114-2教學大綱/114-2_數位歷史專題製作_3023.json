  "description": {
    "sub_id3": null,
    "sub_name": "數位歷史專題製作",
    "sub_ename": "THEMATIC PRODUCTION OF DIGITAL HISTORY",
    "describe_ch": "本課程讓學生體驗數位歷史相關工作，以及瞭解在文創產業中可以扮演的角色。首先，說明智慧財產權相關知識，使學生能合理使用網際網路的各種資料。接著，組織學生分成若干製作小組，進行數位專案的企劃與製作。最後，將成果以新媒體的方式發表。",
    "describe_eh": "This course let students experience work related to digital history and understand the role they can play in the cultural and creative industry. First of all, I will explain the knowledge of intellectual property rights, so that students can rationally use all kinds of Internet information.  Next, I will organize students into several task groups to plan and produce digital projects.  Finally, the results will be published in new media form.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過跨領域知識的了解，培養學生對多元學習的興趣。",
      "describe_en": "Through the understanding of cross-domain knowledge, students will cultivate interest in diverse learning."
    },
    {
      "seq": 2,
      "describe_ch": "學習分工合作，並運用工具解決問題。",
      "describe_en": "Learn division of labor and cooperation, and use tools to solve problems."
    }
  ],
