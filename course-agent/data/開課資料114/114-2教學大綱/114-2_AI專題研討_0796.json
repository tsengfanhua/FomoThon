  "description": {
    "sub_id3": null,
    "sub_name": "AI專題研討",
    "sub_ename": "ARTIFICIAL INTELLIGENCE SEMINAR",
    "describe_ch": "本課程藉由邀請國內外人工智慧相關領域學者專家蒞臨演講，讓學生了解人工智慧領域的現況與趨勢。希望藉由學術演講的聆聽與討論，啟發學生關注前瞻性與國際性的人工智慧發展與脈動，並培養學生聽講、討論、發問與撰寫書面心得報告的能力。",
    "describe_eh": " This course invites experts in related fields of artificial intelligence to discuss, so that students can understand the current situation and trends in the field of artificial intelligence. Pulse, and cultivate students' ability to listen to lectures, discuss, ask questions and write experience reports",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解人工智慧相關研究領域的發展現況與趨勢。",
      "describe_en": "To Understand the development status and trends of research fields related to artificial intelligence."
    },
    {
      "seq": 2,
      "describe_ch": "理解前瞻性與國際性的人工智慧發展與脈動。",
      "describe_en": "To Understand the development and pulse of forward-looking and international artificial intelligence."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生綜合聽講、討論、發問與寫作書面心得報告的能力。",
      "describe_en": "Cultivate students' ability to comprehensively listen to lectures, discuss, ask questions, and write written experience reports."
    }
  ],
