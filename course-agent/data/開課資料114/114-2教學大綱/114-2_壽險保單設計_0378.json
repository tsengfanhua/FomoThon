  "description": {
    "sub_id3": null,
    "sub_name": "壽險保單設計",
    "sub_ename": "DESIGN OF LIFE INSURANCE",
    "describe_ch": "人壽保險商品設計的基礎課程，探討在人壽保險商品設計應考慮社會經濟變動因素，進而瞭解商品設計的流程和壽險公司其他部門互動的關係，尤其行銷、核保、理賠等，也特別注重法令和監理單位的相關規範。課程中介紹幾類新興商品的內容和設計的動機，並融入保險科技的概念。",
    "describe_eh": "The basic course of life insurance commodity design, discuss in life insurance policy  design  should consider the social and economic change factors, and then understand the commodity design process and other departments of life insurance company interaction, especially marketing, underwriting, claims, etc., but also pay special attention to the relevant norms of decrees and supervision units. The course introduces the content and design motivations of several types of emerging policys and incorporates the concept of InsuTech.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能學習基本的壽險及健康險商品的知識",
      "describe_en": "To study knowledge of basic life and health insurance products"
    },
    {
      "seq": 2,
      "describe_ch": "能分析壽險及健康險需求",
      "describe_en": "To study analysis of need of life and health insurance"
    },
    {
      "seq": 3,
      "describe_ch": "能應用壽險及健康險商品之設計",
      "describe_en": "To apply the design of life and health insurance products"
    }
  ],
