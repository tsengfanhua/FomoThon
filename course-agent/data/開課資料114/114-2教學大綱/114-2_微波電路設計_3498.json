  "description": {
    "sub_id3": null,
    "sub_name": "微波電路設計",
    "sub_ename": "MICROWAVE CIRCUIT DESIGN",
    "describe_ch": "1. 微波低雜訊放大器 2. 壓控振盪器 3. 功率放大器 4. 鎖相迴路 5. 微波平衡混頻器 6. 微波鏡像排斥混頻器 7. IQ調變器 8. IQ解調變器 9. 數位無線發射機 10. 數位無線接收機",
    "describe_eh": "1. Microwave Low Noise Amplifier. 2. Voltage Controlled Oscillator. 3. Power Amplifier. 4. Phase Locked Loop. 5. Microwave Balanced Mixer. 6. Microwave Image-Rejection Mixer. 7. IQ modulator. 8. IQ Re-modulator. 9. Digital wireless Transmitter. digital Wireless Receiver.",
    "pre_subname": "COME6034微波電路分析",
    "pre_sub_id3": "COME6034",
    "pre_sub_ename": "COME6034 MICROWAVE CIRCUIT ANALYSIS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使了解微波低雜訊放大器之設計原理、工作原理、設計及製作，分析電路架構，電路範例實測結果討論。",
      "describe_en": "Enable of principle of design, the principle of work, the design and the manufacture of the understanding microwave low noise amplifier, analysis electric circuit construction, electric circuit model actual result discussion."
    },
    {
      "seq": 2,
      "describe_ch": "使了解壓控振盪器原理、振盪器相關規格，壓控振盪器之設計流程，電路範例分析，電路範例實測結果討論。",
      "describe_en": "Enable the decompression to control the oscillator principle, the oscillator related specification, the pressure controls design flow the oscillator , electric circuit model analysis , electric circuit model actual result discussion."
    },
    {
      "seq": 3,
      "describe_ch": "使了解功率放大器原理、功率放大器相關規格，功率放大器之設計流程，電路範例分析，電路範例實測結果討論。",
      "describe_en": "Enable the understanding power amplifier principle, the power amplifier related specification, design flow power amplifier, electric circuit model analysis, electric model actual result discussion."
    }
  ],
