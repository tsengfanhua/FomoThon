  "description": {
    "sub_id3": null,
    "sub_name": "租稅法(二)",
    "sub_ename": "TAX LAW(2)",
    "describe_ch": "在解說我國之租稅法律規定，以奠定同學完整之租稅觀念。內容主要有所得稅、遺產贈與稅、土地稅、房屋稅、貨物稅、營業稅及關稅等，希望使同學能對租稅法有一全盤而詳盡之瞭解。",
    "describe_eh": "This course is to teach the fundamentals of Tax Law and their applications. The objective of this course is to teach students to recognize the major tax issues inherent in business and financial transactions.　",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解稅法具有之能力",
      "describe_en": "To understand fundamental tax regulations."
    },
    {
      "seq": 2,
      "describe_ch": "應用租稅知識分析及解決租稅問題",
      "describe_en": "To apply the regulations for analysis and solving tax problems."
    }
