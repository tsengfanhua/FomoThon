  "description": {
    "sub_id3": null,
    "sub_name": "現代小說及習作",
    "sub_ename": "MODERN NOVEL",
    "describe_ch": "小說一直是擁有大量閱讀人口的文類，現代小說自五四以降，更發展出與古典傳統小說不同的顯著特質。本課程藉由小說史、小說家、小說作品及小說理論內容的交互講授，讓中國文學系的學生更瞭解為何小說會成為社會活動象徵之一環。",
    "describe_eh": "Fiction is a genre enjoys a wide readership. Ever since the May Fourth Movement, modern Chinese fiction has developed distinguish characteristics different from that of the traditional fiction. This course aims to help the students to understand the important issues why modern Chinese fiction has come into what it is and how it is entangled with the society and become part of the symbol system, through the study of the development of Chinese fiction, of the biography of fiction writers, and their fictional works.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "對台灣當代小說發展源流有所認知。",
      "describe_en": "For basically recognizing the Taiwanese contemporary fiction evolution."
    },
    {
      "seq": 2,
      "describe_ch": "培養寫作及研究小說的能力。",
      "describe_en": "For elevating the abilities in fiction writing and researching."
    }
  ],
