  "description": {
    "sub_id3": null,
    "sub_name": "應用力學",
    "sub_ename": "APPLIED MECHANICS",
    "describe_ch": "本課程是材料力學、結構力學與設計的先修課程，主要目的在認識與理解力與力矩向量，並將結構問題簡化，進而求解支承與桿件之受力與力矩。內容包括：力的向量，由質點平衡求解力，等效的力與力矩向量，由剛體平衡求解力與力矩，以及重心、形心與轉動慣量等。",
    "describe_eh": "This course is a prerequisite for Mechanics of Materials, Structures and Design of Structure. The major objectives are to understand force and moment, to simplify structure problem to ideal model, and to solve for the forces and moments of supports and members. The content includes force vector, solving for force from particle equilibrium, equivalent force and moment vectors, solving for force and moment from rigid body equilibrium, and center of gravity, centroid and moment of inertia. The particle and rigid body do not deform under the exertion of external force and moment. However, real structure does deform and may cause failure due to external force and moment. This part will be the subject of the next course Mechanics of Materials.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "\t能應用力向量與質點平衡,求解力系統.\r\n",
      "describe_en": "1.\t\tCan apply force vectors and equilibrium of a particle to solve a force system.\t"
    },
    {
      "seq": 2,
      "describe_ch": "能應用力,力矩,與剛體平衡,計算結構之反力與反力矩.\t",
      "describe_en": "2.Can apply forces, moments, and equilibrium of a rigid body to calculate the reactions of a structure. \t"
    },
    {
      "seq": 3,
      "describe_ch": "能應用並計算重心,形心,與轉動慣量.\t\t",
      "describe_en": "3.\tCan apply and compute center of gravity, centroid, and moments of inertia. \n   \n"
    }
  ],
