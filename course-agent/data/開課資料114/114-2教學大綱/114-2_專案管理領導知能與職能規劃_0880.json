  "description": {
    "sub_id3": null,
    "sub_name": "專案管理領導知能與職能規劃",
    "sub_ename": "PROJECT MANAGEMENT LEADERSHIP DEVELOPMENT AND COMPETENCY PLANNING",
    "describe_ch": "專案經理的主要工作為帶領團隊使命必達，以及與利害關係人溝通，故需要有完整的領導能力做為支撐。本課程主要為教授擔任一位專案經理應有的特質、職能與如何用自屬的軟能力於領導統御與領導技巧，並藉由相關體驗式設計案例從互動學習與討論來有效率地提升學生的專案管理領導統御能力。",
    "describe_eh": "Major works of project manager are to lead the team and communicate with stakeholders efficiently. Above key factor for success is the leadership. Therefore, the aim of this course is to teach knowledge of leadership development and competency planning, and how to apply in project management through case study and interactive discussion.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解領導統御對專案團隊的重要觀念",
      "describe_en": "Understand the important concepts of leadership and team management"
    },
    {
      "seq": 2,
      "describe_ch": "能運用領導知能於專案管理",
      "describe_en": "Ability to apply leadership in project management"
    },
    {
      "seq": 3,
      "describe_ch": "具備領導思維於統合外在變化的能力",
      "describe_en": "Ability to lead thinking to integrate external changes"
    },
    {
      "seq": 4,
      "describe_ch": "可以自我了解與提升社會發展",
      "describe_en": "Can self-understand and promote social development"
    }
