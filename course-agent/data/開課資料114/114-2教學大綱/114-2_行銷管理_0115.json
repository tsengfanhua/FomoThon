      "scr_dup": "001",
      "evalb_id": "D1",
      "score_rate": 30,
      "evalb_memo": "小組期中報告\n小組成員一起討論，挑選一個大家真心喜愛的商品，偶像藝人、遊戲、漫畫都無所謂，重點是你有自信你對它的了解勝過任何人\n期中報告必須涵蓋的範圍包含：市場、消費者、消費行為",
      "evalb_memo_en": null,
      "evalb_name": "期中考",
      "evalb_name_en": "Midterm examination",
      "seq": 3
    },
