      "scr_dup": "001",
      "evalb_id": "K2",
      "score_rate": 15,
      "evalb_memo": "個人分享報告：假如我是行銷總監\n假如你是商品的行銷總監，你會怎麼行銷它呢?\n你的報告必須包含以下幾點\n(1)這個產品的市場大致是甚麼狀態?\n(2)你要怎麼去找到你的消費者?\n(3)你要讓消費者接收到甚麼樣的訊息?\n(4)所以你設計了甚麼樣的行銷企劃?",
      "evalb_memo_en": null,
      "evalb_name": "口頭報告",
      "evalb_name_en": "Oral presentation",
      "seq": 2
    },
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CB01122",
