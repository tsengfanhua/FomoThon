  "description": {
    "sub_id3": null,
    "sub_name": "製造學",
    "sub_ename": "MANUFACTURING",
    "describe_ch": "以工程師的觀點探討各種製造程序有關之材料選擇，力學分析及製程決定等問題，並能理解製造學在工業的重要性及影響。",
    "describe_eh": "To investigate the selection of material , mechanics analysis , selection of manufacturing process from the view point of an engineer .",
    "pre_subname": "PSD1012工程材料學",
    "pre_sub_id3": "PSD1012",
    "pre_sub_ename": "PSD1012 ENGINEERING MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解製造學在工業的重要性及影響。",
      "describe_en": "Be able to comprehend the importance and effects of manufacturing process to industry."
    },
    {
      "seq": 2,
      "describe_ch": "能應用製造學的原理，分析一零件或產品，並提出可行驗證方法。",
      "describe_en": "Apply principles of manufacturing process to analyze a part or product and propose a feasible method for validation."
    },
    {
      "seq": 3,
      "describe_ch": "能理解破壞理論並與基礎力學整合，俾可製造出安全、有品質、可靠的機械元件。\r\n",
      "describe_en": "Understand the theory of failure, and integrate the fundamentals of mechanics toward the goal of analyzing and producting mechanical elements to achieve satisfactory levels of safety, quality, reliability, and life.\r\n"
    }
  ],
