  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB00101",
    "sub_id": "48898",
    "scr_dup": "001",
    "tpa_score_new": "<div><strong>期末成果發表競賽評分標準</strong></div>\n\n<ol>\n\t<li><strong>痛點解決精準度</strong><strong> (30%)</strong></li>\n\t<li><strong>財務與商業價值</strong><strong> (30%)</strong></li>\n\t<li><strong>技術可行性與創新</strong><strong> (20%)</strong></li>\n\t<li><strong>簡報發表與答詢</strong><strong> (20%)</strong></li>\n</ol>\n\n<div><strong>特別說明</strong><strong> </strong></div>\n\n<ol>\n\t<li><strong>分組原則：</strong>每組 4-6 人，建議跨專業組隊。</li>\n\t<li><strong>業界演講：</strong>本課程邀請之業界專家將教授特定的 AI 軟體，<strong>專家工作坊之出席與實作紀錄將直接影響平時成績</strong>。</li>\n\t<li><strong>企業實務：</strong>期末競賽將面對上市櫃公司與在地企業的真實數據或場景，學生需簽署保密協議 (NDA) 方可使用部分企業資訊。</li>\n</ol>\n",
    "tpa_score_new_en": null,
    "course_pol": "1.上課時應專心聽講，不得瞌睡、不高聲談笑與課程無關議題、不妨礙教室上課秩序。\n2.教室保持整潔，不得任意塗污或亂丟紙屑、果皮、髒物",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<div>1 .努力完成老師對課程活動的要求。<br />\n2. 秉持開放的心態與他人互動。<br />\n3. 評論事情時應盡量保持客觀與理性。<br />\n4. 在不確定資訊的真偽前，不任意分享這些資訊給他人。<br />\n5. 一旦有使用到他人的著作、構想或創作時，應以正確格式去聲明原創者。</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": "Y"
  },
