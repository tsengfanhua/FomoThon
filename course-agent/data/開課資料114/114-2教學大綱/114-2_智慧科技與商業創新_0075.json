    "scr_dup": "001",
    "tpb_seq": 1,
    "tpb_book": "<div><strong>書名：</strong> 《AI 商業應用與實務》</div>\n\n<div><strong>作者：</strong> 廖文華</div>\n\n<div><strong>出版社：</strong> 全華圖書</div>\n\n<div><strong>出版日：</strong> 2025 年 1 月 15 日</div>\n\n<div><strong>ISBN-13：</strong> 9786264011822</div>\n\n<div><strong>核心內容：</strong> 涵蓋 AI 在電商、金融、行銷科技的個案分析，並探討企業數位轉型的管理議題，是目前市面上最貼近您課程需求的實務教材。</div>\n",
    "tpb_book_en": null
  },
  "readings": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB00101",
    "sub_id": "48898",
    "scr_dup": "001",
    "tpc_seq": 1,
    "tpc_book": "<div>1.</div>\n\n<div>書名：<strong>AI </strong><strong>商業應用與實務</strong></div>\n\n<div>作者：廖文華、張志勇、石貴平、張榮貴、蒯思齊（廖文華為主要作者</div>\n\n<div>出版社：全華圖書</div>\n\n<div>出版日期：2025</div>\n\n<div>ISBN： 9786264011822</div>\n\n<div>2.</div>\n\n<div>書名：<strong>生成式</strong><strong> AI </strong><strong>專案實踐指南：從模型挑選、上線、</strong><strong>RAG </strong><strong>技術到</strong><strong> AI</strong> <strong>Agent </strong><strong>整合</strong></div>\n\n<div>作者：劉育維</div>\n\n<div>出版社：博碩文化</div>\n\n<div>出版日期：2025</div>\n\n<div>ISBN： 9786264141895</div>\n\n<div>&nbsp;</div>\n",
    "tpc_book_en": null
  },
