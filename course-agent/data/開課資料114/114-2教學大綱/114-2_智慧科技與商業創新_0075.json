  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB00101",
    "sub_id": "48898",
    "scr_dup": "001",
    "sub_title": "智慧科技如何應用於商業創新。",
    "sub_title_en": null,
    "sub_describe": "1、了解 AI／機器學習的基本概念與常見誤解。\n2、能以商業語言說明幾種典型 AI 應用（推薦、預測、自動化）。\n3、培養資料思維：知道要蒐集什麼資料、如何用來改善決策。\n4、具備初階 AI 素養與倫理意識，能判斷 AI 應用的風險與限制。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "智慧科技與商業創新",
    "sub_ename": "INTELLIGENT TECHNOLOGY AND BUSINESS INNOVATION",
    "describe_ch": "課程提供商業創新應用智慧科技概念，啟發學生科技創業或者協助傳統業者利用物聯網、大數據、人工智慧、機器人、生物辨識、區塊鏈等技術以及社群網絡及行動載具應用，強化利用本身既有通路，提供數位化創新商業服務。",
    "describe_eh": "This course provides the concept of intelligent technology in business innovation applications, inspiring students to innovate in new startups or assist traditional industries to use the Internet of Things, big data, artificial intelligence, robotics, biometrics, blockchain and other technologies through the use of social networking and mobile applications",
