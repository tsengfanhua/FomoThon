  "description": {
    "sub_id3": null,
    "sub_name": "光纖通訊",
    "sub_ename": "OPTICAL FIBER COMMUNICATION",
    "describe_ch": "本課程介紹光纖基本波導理論、特性及製作方法，將光纖作為光訊號的傳輸介質，並說明光纖通訊可提供長距離及高速資料傳輸的用途，在光纖通訊系統所包含之元組件如光源、光調變器、光纖放大器與光接收機，使學生了解光纖通訊中分波多工(WDM)之基本概念。",
    "describe_eh": "This course is to introduce the basic wave-guiding theory、characteristics and fabricating methods of fibers. The fiber is used for the long-distance communication and can provide the high-speed data transmission. The fiber communication system includes light source、light modulations、fiber amplifiers and optical receivers. Let students understand the wavelength dividing multiplexing (WDM) technology of fiber communications.",
    "pre_subname": "EEEN3029光纖工程",
    "pre_sub_id3": "EEEN3029",
    "pre_sub_ename": "EEEN3029 OPTIC FIBER ENGINEERING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能清楚說明光纖通訊的基本工作原理與其特點。",
      "describe_en": "Describe clearly the basic operating principle and characteristics of optical fiber communication systems."
    },
    {
      "seq": 2,
      "describe_ch": "能使用相關數學方法，完成一個簡單光纖通訊系統的計算，並歸納出適當的結論。",
      "describe_en": "Have the ability to utilize related mathematical methods to achieve the calculation of a simple optical fiber communication system and draw appropriate conclusions from calculating results."
    }
  ],
