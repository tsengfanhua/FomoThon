  "description": {
    "sub_id3": null,
    "sub_name": "行銷管理",
    "sub_ename": "MARKETING MANAGEMENT",
    "describe_ch": "從策略性的觀點，研討行銷管理的程序，包括分析行銷環境、策略性行銷決策、戰術性行銷決策，以及執行與控制等，期使能結合理論與實務，提昇行銷管理素養，並培養分析判斷之能力。\r\n\r\n",
    "describe_eh": "To understand the overall concepts and theory of marketing management from strategic point of view.  To discuss the marketing management process, including marketing environment analyzing, strategic marketing decision making, static marketing decision making, implementing and controlling.  To apply the marketing management theory to the practical cases.\r\n\r\n",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)、MKT1019行銷管理、MGT1002企業概論",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)、MKT1019 MARKETING MANAGEMENT、MGT1002 INTRODUCTION TO BUSINESS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 49,
      "describe_ch": "學生將發展商管領域的批判性思維，學會從多角度分析和評估商業問題，從而做出有根據的決策。",
      "describe_en": "Students will develop critical thinking skills pertinent to business management, learning to analyze and evaluate business issues from various perspectives for informed decision-making."
    },
    {
      "seq": 50,
      "describe_ch": "透過小組討論和案例研究，學生將學習有效的溝通策略，包括語言表達與非語言溝通，以及如何在多元文化環境中清晰傳達信息。",
      "describe_en": "Through group discussions and case studies, students will master effective communication strategies, encompassing both verbal and non-verbal expressions, as well as the ability to convey messages clearly in multicultural contexts."
    },
    {
      "seq": 51,
      "describe_ch": "學生將學習如何結合不同的學科知識來解決複雜的行銷問題，這包括資料分析、市場研究及策略規劃。",
      "describe_en": "The course will instill the importance of adhering to professional ethics, encouraging students to maintain integrity and responsibility in marketing practices."
    },
    {
      "seq": 52,
      "describe_ch": "課程特別強調全球視野的培養，使學生理解國際市場的多樣性與複雜性，並能夠在全球化的商業環境中成功運作。",
      "describe_en": "Students will learn to integrate knowledge from different disciplines to address complex marketing issues, including data analysis, market research, and strategic planning."
    }
  ],
