  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE11129",
    "sub_id": "18550",
    "scr_dup": "001",
    "sub_title": "電腦系統軟體",
    "sub_title_en": null,
    "sub_describe": "理解電腦系統的運作原理及系統運作的相關程式。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "系統程式",
    "sub_ename": "SYSTEM PROGRAMMING",
    "describe_ch": "藉由組合語言、組譯程式、載入與鏈結程式的介紹，使學生瞭解計算機系統的軟體運作核心技術，並再加強有關作業系統的介紹及實務演練，使學生能對計算機系統軟體奠定基礎的認識。",
    "describe_eh": "The introductions about Assembly language, Assembler, and Linker/Loader can help students to understand the kernel techniques of computer software. The other topic in the course is the introduction of Operating System, by the introduction and practices of OS, the basic knowledge about system software is then established.",
    "pre_subname": "IEE1000計算機概論(一)、IEE1001計算機概論(二)",
    "pre_sub_id3": "IEE1000",
    "pre_sub_ename": "IEE1000 INTRODUCTION TO COMPUTER(1)、IEE1001 INTRODUCTION TO COMPUTER(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 11,
      "describe_ch": "使學生瞭解計算機軟體運作原理以及各項影響計算機運作的關鍵技術。\t",
      "describe_en": "Knowledge for computer software processing model and the factors that will influence the processing of computer."
    },
    {
      "seq": 12,
      "describe_ch": "使學生能瞭解作業系統在計算機系統運作所扮演的角色，以及相關的操作理念。\t",
      "describe_en": "Comprehension for The techniques about operating system to make students to understand the related issues about system features."
    }
  ],
