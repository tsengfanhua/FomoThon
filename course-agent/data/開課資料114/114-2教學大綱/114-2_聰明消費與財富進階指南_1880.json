  "description": {
    "sub_id3": null,
    "sub_name": "聰明消費與財富進階指南",
    "sub_ename": "SMART SPENDING & WEALTH MANAGEMENT GUIDE",
    "describe_ch": "本課程專為財金新手而設計，幫助學生建立正確的消費觀與理財概念，學習如何在數位時代做出明智的財務決策。透過生活案例、消費心理學、數位金融工具、投資入門與財務規劃，培養學生良好的財務習慣，避免不必要的財務風險，並學習如何有效累積個人財富，為未來財務自由奠定基礎。",
    "describe_eh": "The goal of this course is to teach financial beginners how to make smart financial decisions in the digital era by teaching them proper consumer perspectives and financial management principles. It teaches students how to effectively build personal wealth, avoid needless financial risks, and develop sound financial habits through real-life examples, consumer psychology, digital financial tools, investment fundamentals, and financial planning. This lays the groundwork for future financial independence.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建立學生的消費觀與財務管理能力，培養預算規劃習慣",
      "describe_en": "Develop students' financial management skills and budgeting habits to build responsible spending behavior."
    },
    {
      "seq": 2,
      "describe_ch": "認識數位金融環境與工具，提升數位金融素養",
      "describe_en": "Understand the digital financial environment and tools to enhance financial literacy."
    }
  ],
