  "description": {
    "sub_id3": null,
    "sub_name": "大數據分析",
    "sub_ename": "BIG DATA ANALYSIS",
    "describe_ch": "在機率觀念定義與區間估計的基礎上，導引學生利用統計軟體，例如EXCEL, SPSS、EVIEWS或STATA熟悉運用基本統計方法來驗證現實環境所觀察之實際關係。所應用之統計方法包括統計假設檢定、母體變異數的推論、變異數分析、迴歸分析等。",
    "describe_eh": "Based on the foundation of probability concept and interval estimate, students will learn how to use basic statistical techniques to examine empirical relationship what they observe in the real world. by using required statistical software, e.g., EXCEL, SPSS, EVIEWS or STATA. Topics include hypothesis testing, inference about population variances, analysis of variance, and regression technique.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解交叉表的觀念與應用方法",
      "describe_en": "Comprehend goodness-of-fit tests and cross table analysis."
