  "description": {
    "sub_id3": null,
    "sub_name": "保險數學",
    "sub_ename": "MATHEMATICS FOR INSURANCE",
    "describe_ch": "這門課主要的目的是介紹保險的一些基本知識和精算科學的觀念。主題有存活函數、危險函數、生命表之介紹、終生壽險保費、生死合險保費、定期險保費、期初年金現值、期末年金現值、保費及責任準備金之計算原理。",
    "describe_eh": "The main purpose of this course is to introduce some basic knowledge and concepts of actuarial science. The topics include the survival function, the hazard function, the life table, the whole life, and the endowment.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能描述精算數學於人壽保險上對於個人財務保障的應用。",
      "describe_en": "Describe the application of the actuarial science to life insurance to achieve individual's financial security."
    },
    {
      "seq": 2,
      "describe_ch": "能解釋說明人身意外及風險理論的重要性。",
      "describe_en": "Understand and explain the importance and effects of life contingencies and risk theory."
    },
    {
      "seq": 3,
      "describe_ch": "能分辨應用精算科學的場合,並能清楚表達。",
      "describe_en": "Clearly distinguish the circumstances under which the actuary science can be applied."
    }
  ],
