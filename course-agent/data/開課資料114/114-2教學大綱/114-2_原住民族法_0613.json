  },
  "description": {
    "sub_id3": null,
    "sub_name": "原住民族法",
    "sub_ename": "INDEGENOUS LAW",
    "describe_ch": "有鑑於推廣原住民族法學為實現我國憲法上多元文化社會之重要性，任課教師除課堂介紹當代原住民法重要議題之外，並以劇場教學創新模式導入本課程，期收引發學生學習興趣、推廣原住民法學教育之功效。",
    "describe_eh": "Learning and Promoting indigenous law are significant for fulfilling a multicultural society.  The instructor will not only introduce important indigenous issues but also apply theatrical teaching method, like role playing, role reversal…, etc. in this course. By using this new teaching method, rising students’ learning motive and interest and promoting indigenous legal education are anticipated.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠辨明與了解當代原住民法重要議題",
      "describe_en": "Understanding modern important indigenous legal issues"
    },
    {
      "seq": 2,
      "describe_ch": "運用公法與國際法概念解析原住民族法律議題",
      "describe_en": "Analyzing indigenous cases with relevant public and international law"
    },
    {
      "seq": 3,
      "describe_ch": "分析原住民法與多元文化、永續發展促進之關聯，並能對現行法加以檢討與提出建議",
      "describe_en": "Recognizing the correlation between indigenous law and multicultural and sustainable society. Furthermore, developing critical thinking and being able to give suggestions to current regulations"
    }
  ],
