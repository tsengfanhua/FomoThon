  "description": {
    "sub_id3": null,
    "sub_name": "刑法分則",
    "sub_ename": "CRIMINAL LAW: THE SPECIAL PART",
    "describe_ch": "在對刑法總則的原理原則有一定程度的認識後，刑分的課程將帶領學生進入刑法各罪的『森林』，認識各個犯罪的構成要件內容。除了介紹不同犯罪的構成要件要素外，課堂上將輔以案例解析，俾使學生能將刑總、刑分融會貫通，對刑事案件能以邏輯分析與系統的論證，獲致合理且具說服力的結論。",
    "describe_eh": "This is a continuation course building upon the general principles developed in Criminal Law General Part. Its focus is a detailed study of specific criminal offenses in the special part of the Taiwan Penal Code. The approach of this course is to work through stimulated cases, discussing the definition and application of the most important offenses covering homicide, rape, theft, fraud, and so on.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "本課程為使學生能將刑總、刑分融會貫通，對刑事案件能以邏輯分析與系統的論證，獲致合理且具說服力的結論。",
      "describe_en": "The approach of this course is to work through stimulated cases, discussing the definition and application of the most important offenses covering homicide, rape, theft, fraud, and so on.\n"
    },
    {
      "seq": 2,
      "describe_ch": "針對刑法分則內各種犯罪之構成要件進行詳細研究。",
      "describe_en": "Detailed study of specific criminal offenses in the special part of the Taiwan Penal Code."
    },
    {
      "seq": 3,
      "describe_ch": "以假設性案例為輔助來討論如何解釋與適用殺人罪、強制性交罪、詐欺罪等各種犯罪之要件。",
      "describe_en": "Discussing the definition and application of the most important offenses covering homicide, rape, theft, fraud, and so on."
    }
  ],
