  "description": {
    "sub_id3": null,
    "sub_name": "相變化",
    "sub_ename": "PHASE TRANSFORMATION",
    "describe_ch": "利用材料動力學及材料熱力學以充分了解材料之相變化行為，藉以得知溫度、壓力及時間效應對於材料性質之影響。講授內容涵蓋熱力學與相圖、擴散、晶體介面與微結構、凝固、擴散相變化及非擴散相變化等。課程除了學理講授外，並輔以相關文獻報導以強化學生學習。\n",
    "describe_eh": "This course describes the phase transformation behavior of material by using the fundamentals of kinetics and thermodynamics, resulting in understanding the effect of temperature, pressure, and time on material properties. The course includes thermodynamics and phase diagrams, diffusion, interfaces and microstructure of metal, solidification, diffusional transformations, and diffusionless transformations. In addition to lecture in class, this course also assists with relevant literature review for strengthening the learning efficiency.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解相和相圖",
      "describe_en": "To comprehend the phase and phase diagram"
    },
    {
      "seq": 2,
      "describe_ch": "理解固溶體內的擴散",
      "describe_en": "To comprehend diffusion in solid solution"
    },
    {
      "seq": 3,
      "describe_ch": "理解金屬的界面、顯微結構及凝固行為",
      "describe_en": "To comprehend the interfaces,  microstructures and solidification behaviors of metals"
    }
  ],
