  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB35539",
    "sub_id": "30620",
    "scr_dup": "001",
    "sub_title": "認識風險與各樣風險種類、了解因應風險的管理與實施步驟、風險管理與保險規劃、高齡風險與金融工具介紹。",
    "sub_title_en": null,
    "sub_describe": "讓同學們了解如何因應人生中各樣的風險、並善用法規、信託、保險與各樣金融工具規避風險，並佐以案例分享實務。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "風險管理",
    "sub_ename": "RISK MANAGEMENT",
    "describe_ch": "風險為損失的不確定性，本課程介紹風險的定義、特性與分類，並說明衡量風險的方法與各種風險管理策略，培養學生進行風險管理規劃的能力。",
    "describe_eh": "Risk is uncertainty of loss. This course introduces definition, characteristics as well as categories of risk and elaborates methods to measure risk and strategies of risk management. The objective is to cultivate student’s ability to draw up risk management plans.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用專業知識來解決企業與家庭風險管理與保險的問題。",
      "describe_en": "To apply the professional knowledge to solve the problems related to the risk management and insurance in enterprise and household."
    }
  ],
