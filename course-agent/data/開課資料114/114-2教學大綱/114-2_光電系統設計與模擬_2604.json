  "description": {
    "sub_id3": null,
    "sub_name": "光電系統設計與模擬",
    "sub_ename": "DESIGN AND SIMULATION OF  OPTOELECTRONIC SYSTEM",
    "describe_ch": "本課程先回顧基礎光學，之後會介紹光學與光電元件與光源設計流程，並以軟體進行光電系統的設計與視覺化模擬驗證。",
    "describe_eh": "The course begins with a review of fundamentals of optics. The design concept of optical components, optoelectronic components, and light sources will be also introduced. The design and visual validation of optoelectronic system will be implemented through software simulation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用幾何光學、波動光學以及光度學。",
      "describe_en": "To apply geometric optics, wave optics, and photometry."
    },
    {
      "seq": 2,
      "describe_ch": "能以軟體進行光學元件的模擬。",
      "describe_en": "To implement the simulation of optical elements."
    },
    {
      "seq": 3,
      "describe_ch": "能設計與執行光電系統整合。",
      "describe_en": "To design and implement optoelectronic system integration."
    },
    {
      "seq": 4,
      "describe_ch": "透過閱讀國際期刊培養光電系統設計之創新思考與環境永續能力。",
      "describe_en": "To have innovative thinking and environmental sustainability of optoelectronic system design via international journal reading."
    }
  ],
