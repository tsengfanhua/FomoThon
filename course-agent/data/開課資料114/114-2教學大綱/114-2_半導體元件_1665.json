  "description": {
    "sub_id3": null,
    "sub_name": "半導體元件",
    "sub_ename": "SEMICONDUCTOR DEVICES",
    "describe_ch": "半導體元件介紹半導體相關元件特性與原理，含PN接面二極體、雙極性和場效電晶體、光電元件和功率元件。本課程促進學生應用半導體元件能力，提高對於半導體相關產業的學習動機與興趣。學生將由理論與模型基礎，發展到各類半導體元件的應用分析。",
    "describe_eh": "Semiconductor components introduces the characteristics and principles of semiconductor-related components, including PN junction diodes, bipolar and field-effect transistors, optoelectronic components and power components. This course promotes students' ability to apply semiconductor components and enhances their learning motivation and interest in semiconductor-related industries. Students will develop from theoretical and model foundations to application analysis of various types of semiconductor components.",
    "pre_subname": "PHYS1003普通物理(一)、PHYS1004普通物理(二)、AUTO2022半導體原理",
    "pre_sub_id3": "PHYS1003",
    "pre_sub_ename": "PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)、AUTO2022 SEMICONDUCTOR PRINCIPLES",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": " 整合量子力學、固體量子理論、半導體材料物理、及半導體元件物理原理，理解半導體元件特性、操作、及限制的基礎。",
      "describe_en": " To supply knowledge about fundamental quantum mechanics, solid-state quantum theory, semiconductor physics, and related materials and devices understanding the semiconductor device characteristic, operation modes, design rule and applications　introduc"
    },
    {
      "seq": 2,
      "describe_ch": " 理解pn接面的物理特性，並決定pn接面的電流-電壓特性。",
      "describe_en": " Comprehension for the physical background of pn junction and I-V characteristics of pn junction."
    },
    {
      "seq": 3,
      "describe_ch": " 以半導體pn接面理論，討論分析三種基本電晶體：雙極性電晶體、金屬-氧化物-半導體場效電晶體、及接面場效應電晶體的基本幾何結構及操作特性與應用。",
      "describe_en": " Based on pn junction theory to discussion and analysis about the semiconductor characteristic and their behaviors of operational modes of BJTs, MOSFETs, and JFETS."
    },
    {
      "seq": 4,
      "describe_ch": " 利用半導體材料特性的原理，應用於光電元件上，並提出元件操作原理、設計合理的計算程序，並適切歸納出結論；以書面或口頭方式將所獲結果與同儕、助教及教師溝通。",
      "describe_en": " Application for optoelectronic devices with bias condition and operation modes can be discussed and right conclusions are provided through design of calculation procedures. To communicate results in written or oral form to classmates, teaching assistan"
    }
  ],
