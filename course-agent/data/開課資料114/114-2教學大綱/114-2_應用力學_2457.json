  "description": {
    "sub_id3": null,
    "sub_name": "應用力學",
    "sub_ename": "APPLIED MECHANICS",
    "describe_ch": "應用力學旨在教導學生學習剛體靜力學，內容涵蓋質點與剛體之平衡，圖心、重心與慣性矩等分佈力，結構分析與磨擦力，學生將可對各種工程結構物之靜力平衡分析奠定良好之基礎。",
    "describe_eh": "The statics of rigid bodies is studied in this course.Three topics are included in the course : Equilibria of Particles and Rigid Bodies, Distributed Forces : Centroids, Centers of Gravity and Moments of Inertia, and Analysis of Structures and Friction. The fundemantals of various structure analyses in engineering applications can be well established.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習力之等效系統與剛體之平衡",
      "describe_en": "To learn equivalent systems of forces and equilibrium of rigid bodies."
    },
    {
      "seq": 2,
      "describe_ch": "應用剛體平衡，探討圖心 、重心與慣性矩之分佈力。",
      "describe_en": "To study centroids，centers of gravity and moments of inertia based on the equilibrium of rigid bodies."
    },
    {
      "seq": 3,
      "describe_ch": "應用剛體平衡，探討結構分析與磨擦力。",
      "describe_en": "To study analysis of structures and friction based on the equilibrium of rigid bodies."
    }
  ],
