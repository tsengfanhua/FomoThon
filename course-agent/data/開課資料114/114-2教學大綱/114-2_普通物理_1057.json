  "description": {
    "sub_id3": null,
    "sub_name": "普通物理",
    "sub_ename": "GENERAL PHYSICS",
    "describe_ch": "課程主題包含電磁學與光學。在學習物理原理的同時，學生也需熟練所需的數學工具。同時，這些內容與當代之科技發展所需之知識也密切關聯。故本課程以物理原理、數學能力、與科技應用三者並重為目標。",
    "describe_eh": "The course encompasses the topics of electromagnetism and optics, and the contents contain electric field, voltage, capacitance, circuit analysis, magnetic field, magnetic force, electromagnetic induction, electromagnetic wave, wave optics, polarization, etc. In addition to understanding of physics principles, students are required to be acquainted with the related mathematical tools, eg., vector integral. Meanwhile, the contents are closely relevant to contemporary technology development. Thus, physics concepts, mathematical ability, and application are three aims of this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解與能說明基本電學、磁學及光的基本觀念。",
      "describe_en": "Understand and be able to explain the basic concepts used in electricity, magnetism and optics."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉基本電路現象及其應用。",
      "describe_en": "Be familiar with the of basic circuit phenomena and their applications."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉基本光學現象及其應用。",
      "describe_en": "Be familiar with the basic Optical phenomena and their applications."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解基本電學、磁學及光的定律，並能應用解決機械問題。",
      "describe_en": "Understand the basic laws of electricity, magnetism and optics, and be able to solve mechanical problems."
    }
  ],
