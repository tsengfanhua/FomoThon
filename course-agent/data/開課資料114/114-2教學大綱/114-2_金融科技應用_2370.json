  "description": {
    "sub_id3": null,
    "sub_name": "金融科技應用",
    "sub_ename": "APPLICATIONS IN FINANCIAL TECHNOLOGY",
    "describe_ch": "利用程式與數學模型分析金融市場。內容包含程式相關套件的介紹、財務工程知識、資產價格動態模型的配適、寫程式計算衍生性金融商品價格、蒙地卡羅模擬方法。理論課程輔以電腦實作。",
    "describe_eh": "Apply mathematical models to analyze financial markets. The content includes introducing related packages, financial engineering knowledge, the fitness of asset price dynamic models, writing programs to calculate the price of derivative financial products, and Monte Carlo simulation. The course focus on theoretical topics, supplemented by programming practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用程式能力對金融衍生性商品進行理論定價",
      "describe_en": "To apply programming skills to evaluate the theoretical price of financial derivatives"
    },
    {
      "seq": 2,
      "describe_ch": "能透過數學模型與科學計算方法分析金融市場",
      "describe_en": "To analyze the financial market on the basis of mathematical models and scientific computation techniques"
    }
  ],
