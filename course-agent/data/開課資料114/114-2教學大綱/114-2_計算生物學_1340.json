  "description": {
    "sub_id3": null,
    "sub_name": "計算生物學",
    "sub_ename": "COMPUTATIONAL BIOLOGY",
    "describe_ch": "生物資訊的興起，是「人類基因體計畫」所帶來的重大成就。本課程將介紹各個層次的生物問題所需之計算方法。計算以及數學方面之議題均將被探討。",
    "describe_eh": "This course studies a subset of important problems in computational biology at the molecular level (proteins and nucleic acids), cellular level (metabolic and other biological networks), and organism level (development, cellular interactions). The emphasis is on the contributions that computer science can bring to the study of biological problems in the post genomic data era. From the engineering perspective, both mathematical and computational issues are considered. An introduction to the biological issues is also provided.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
