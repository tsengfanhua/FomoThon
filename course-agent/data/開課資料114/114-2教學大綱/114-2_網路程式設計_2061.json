  "description": {
    "sub_id3": null,
    "sub_name": "網路程式設計",
    "sub_ename": "NETWORK PROGRAMMING",
    "describe_ch": "這門課目標瞭解各種使用 socket API 的裝置並設計穩定傳輸的網路程式。很多裝置透過不同的 protocol socket API 相互溝通，設計穩定的網路程式是重要的課題。",
    "describe_eh": "The course covers the basic and advanced issues of socket programming such as multiple processes, I/O multiplexing, multi-threaded processes, multicasting and secure network programming. Application examples such as Internet browsing, proxy and file transfer are discussed. \n \n Process stability is an important issue.",
    "pre_subname": "COME3033作業系統",
    "pre_sub_id3": "COME3033",
    "pre_sub_ename": "COME3033 OPERATING SYSTEMS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解 socket programming 以及客戶端－伺服器網路程式通信模式。",
      "describe_en": "Comprehension for socket programming and client-server models in networks."
    },
    {
      "seq": 2,
      "describe_ch": "這門課目標瞭解各種使用 socket API 的裝置並設計穩定傳輸的網路程式，目前很多protocol使用於Linux OS，例如 PF_INET, PF_INET6, PF_UNIX, PF_PACKET, PF_NETLINK,PF_BLUETOOTH, PF_CAN (CAN BUS), and PF_IEEE802154。很多裝置透過不同的 protocol socket API 相互溝通，設計穩定的網路程式是重要的課題。",
      "describe_en": "The course covers the basic and advanced issues of socket programming such as multiple processes, I/O multiplexing, multi-threaded processes, multicasting and secure network programming. Application examples such as Internet browsing, proxy and file transfer are discussed.\r\n\r\nProcess stability is an important issue."
    }
  ],
