    "sub_name": "水利工程與水土保育專論",
    "sub_ename": "ADVANCED TOPICS IN WATER RESOURCES ENGINEERING AND CONSERVATION",
    "describe_ch": "滾動式教授與當前國際趨勢、國家政策目標相關及既有儀器使用之議題。內容涵蓋自集水區至出海口之水利工程與水土保持相關議題",
    "describe_eh": " Contemporary topics cover international trend, national policy, and instrument utilization. The contents can include both hydraulic engineering and soil/water conservation knowledge from upstream watershed to downstream estuary.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解國際水利工程與水土保育發展趨勢",
      "describe_en": "\tComprehension on the international trends of water resources engineering and conservation"
    },
    {
      "seq": 2,
      "describe_ch": "應用河川防洪都市淹水與LIDs\t",
      "describe_en": "Application on flood control system, urban flooding and LIDs"
    },
    {
      "seq": 3,
      "describe_ch": "理解水下 (地形、流速、流量)量測技術之演進與無人機之應用\t",
      "describe_en": "Evolution of underwater (topography, velocity, flow) measurement technology and drones application"
    },
    {
      "seq": 4,
      "describe_ch": "應用地下水模擬暨地下水保育與地層下陷防治\t",
      "describe_en": "Apply groundwater simulation/conservation and land subsidence prevention"
    }
  ],
