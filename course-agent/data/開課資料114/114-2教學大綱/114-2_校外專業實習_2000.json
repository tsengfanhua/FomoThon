  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CI00101",
    "sub_id": "30637",
    "scr_dup": "001",
    "tpa_score_new": "<div>(一)成績考評：本課程為學院統籌開課，成績考評依學生所屬學系專業實習考評辦理，以通過與未完成登錄。&nbsp;</div>\n\n<div>(二)學分採計：依學生所屬學系規定辦理。</div>\n",
    "tpa_score_new_en": " ",
    "course_pol": "一、依照業界教師的指示，並時實記錄學習心得 \n二、在公司請依照公司的各項規定，遵守公司的上下班時間\n三、實習期間務必注意學習與工作態度",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<div>一、實習生代表逢甲大學的形象，注意各種禮節與學習態度&nbsp;</div>\n\n<div>二、尊重知識產權，不能洩漏公司機敏資料，包含技術、人力資源、商業訊息等</div>\n\n<div>三、尊重業界教師教導，注意學習態度以及禮貌</div>\n\n<div>四、學習過程中須注意公司生產過程中的安全，避免危害公司權益</div>\n\n<div>&nbsp;</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": null
  },
