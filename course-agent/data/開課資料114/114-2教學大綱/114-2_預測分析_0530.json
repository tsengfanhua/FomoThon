  "description": {
    "sub_id3": null,
    "sub_name": "預測分析",
    "sub_ename": "PREDICTIVE ANALYTICS",
    "describe_ch": "本課程介紹預測和時間數列分析的統計方法及其在商業、經濟、及科學上的應用。主題包括時間數列分解法、多變量迴歸、Box-Jenkins方法論、指數平滑法、及預測的評估。",
    "describe_eh": "This course presents an introduction to the statistical methods of forecasting and time series analysis applicable to business, economic, and scientific settings.  Topics include time series decomposition, multivariate regression models, Box-Jenkins approach to forecasting, exponential smoothing methods, and forecast evaluation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解主要預測方法並評估預測表現",
      "describe_en": "Comprehension for  forecasting methods, provide a complete description of characteristics of methods and models, and carry out forecast evaluation."
    },
    {
      "seq": 2,
      "describe_ch": "理解Box-Jenkins 時間數列方法論",
      "describe_en": "Comprehension for  the application of the Box-Jenkins methodology  included  identification, estimation, diagnostic checking, and forecasting."
    },
    {
      "seq": 3,
      "describe_ch": "分析時間數列資料",
      "describe_en": "To analysis the time series data."
    }
  ],
