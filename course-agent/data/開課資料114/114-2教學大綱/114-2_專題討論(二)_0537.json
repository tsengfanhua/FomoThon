  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(二)",
    "sub_ename": "SEMINAR(2)",
    "describe_ch": "本課程目的在於幫助學生了解最新研究及應用方向。內容包含統計推論的原理、近來最新的統計方法、統計的應用、財務數學和精算等相關領域。",
    "describe_eh": " The aim of this course is to help students to understand cutting edge research and application. Topics include principles of statistical inference, new statistical methods, statistical applications, financial mathematics, and actuarial science, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道如何下載資料與期刊論文",
      "describe_en": "To know how to access databases and reference papers"
    },
    {
      "seq": 2,
      "describe_ch": "理解最新的統計研究領域及應用資訊",
      "describe_en": "Comprehension for the modern fields of  statistical researches and teh information about applications"
    },
    {
      "seq": 3,
      "describe_ch": "分析解讀統計問題並提供可行的解決方案",
      "describe_en": "To analyze statistical problems and provide possible solutions"
    },
    {
      "seq": 4,
      "describe_ch": "綜合相關統計研究議題以發展未來研究方向",
      "describe_en": "Synthesis for special topics on statistical and actuarial researches todevelop future work"
    }
  ],
