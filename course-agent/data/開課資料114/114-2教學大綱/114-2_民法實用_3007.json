  "description": {
    "sub_id3": null,
    "sub_name": "民法實用",
    "sub_ename": "PRACTICE IN CIVIL LAW",
    "describe_ch": "民法係規範私人生活關係、包括財產與身分關係，人之一生可永不犯法，但卻無法與民法相脫離。民法計分總則、債、物權、親屬、繼承五大編。有關民法總則：闡述人之權利義務及各項相關規定此為債法、物權法、親屬法與繼承法之共同原則。;以及 債：特定當事人間債權債務關係，諸如買賣租賃等彼此間權益之保護;和物權：動產、不動產物權之取得設定應辦理手續及注意事項;與親屬：因婚姻、出生、或收養而取得之身分關係進而構成彼此間權利義務。以及繼承：因死亡而發生繼承人繼承財產種種問題。",
    "describe_eh": "This course introduces some general laws. Topics covered include debt, substance rights and kinfolk and inheritance. Other topics covered include human rights and common principles of debt, such as rights of commerce and leasing, as swell as issues related to substance rights, for example terms and regulations of movable property and immovable property. Inheritance laws are also examined, as well as laws relating to marriage, birth and adoption.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "協助學生從生活中認識民法規定，瞭解攸關自身的權利與義務，藉以學習人文藝術經典教育的知識探索，啟蒙學生跨領域學習潛能。",
      "describe_en": "Assist students in understanding the provisions of Civil Code from their lives and understand their rights and obligations."
    },
    {
      "seq": 2,
      "describe_ch": "協助學生從實際案例中學習，強化學習的實用性，並適時透過比較法觀點，開展全球歷史宏觀視野的公民實踐。",
      "describe_en": "Assist students in learning from practical cases and enhance the practicality of learning."
    }
  ],
