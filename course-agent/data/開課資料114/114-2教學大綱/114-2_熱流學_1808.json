  "description": {
    "sub_id3": null,
    "sub_name": "熱流學",
    "sub_ename": "THERMAL-FLUIDS ENGINEERING",
    "describe_ch": "熱流學係一門探討能量儲存、傳遞及轉換之基礎科學，由於熱流學於現今工程設計上扮演一個決定性之角色，因此瞭解及應用熱流學對工程領域學生極為重要。本課程整合介紹熱力學、流體力學、及熱傳學，目的係使學生瞭解熱流系統之基本原理，並將其應用於工程上之熱流系統之設計與分析。",
    "describe_eh": "Thermal-fluid engineering involves the storage, transfer, and conversion of energy.  Understanding and application of the thermal-fluid system is important since it plays a crucial role in engineering design. This course provides an integrated introductory of thermodynamic, fluid mechanics, and heat transfer.  The objectives of this course are: (1) To provide the basic theories of thermal-fluid systems; and (2) To develop the skill of design and analysis of thermal-fluid systems.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、PSD2021工程力學、PHYS1005普通物理(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、PSD2021 ENGINEERING MECHANICS、PHYS1005 GENERAL PHYSICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解熱流系統之基本原理。",
      "describe_en": "Understand the basic theories of thermal-fluid systems."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解熱流學理論於日常生活及實際工程之應用。",
      "describe_en": "Understand the theories and applications of thermal-fluid systems on real life and engineering practices."
    },
    {
      "seq": 3,
      "describe_ch": "建立熱流系統分析模型之能力",
      "describe_en": "Develop the ability of creating analysis models of thermal-fluid systems."
    },
    {
      "seq": 4,
      "describe_ch": "培養利用數值分析方法或套裝軟體進行熱流系統設計及分析之能力",
      "describe_en": "Develop the ability of thermal-fluid systems design and analysis by using numerical method and/or commercial software."
    }
  ],
