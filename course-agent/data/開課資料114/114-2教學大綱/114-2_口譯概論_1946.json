  "description": {
    "sub_id3": null,
    "sub_name": "口譯概論",
    "sub_ename": "INTRODUCTION TO INTERPRETATION",
    "describe_ch": "中英口譯入門課程。除介紹口譯理論、種類、技巧等，並透過口譯前置訓練如：閱讀技巧、聽力策略、跟述、意譯、公眾演說等來加強學生對中英語言讀聽說分析及整合的能力。課程重點亦包括中英口譯轉換、演練，培養學生在就業市場上具備基本口譯的能力。",
    "describe_eh": "This course is designed to introduce to students basic English-Chinese interpretation theory, types and skills. It aims to acquaint students with preparatory trainings for interpreting such as reading skills, listening strategies, shadowing, paraphrasing and public speaking techniques, so that students' abilities to analyze and integrate English and Chinese will be reinforced. In addition, intensive interpreting exercises will be administered to assist students in developing the competence to interpret in the workplace.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備中英口筆譯基礎理論與策略的知識。",
      "describe_en": "To learn basic English-Chinese translation and interpretation theory and approaches"
    },
    {
      "seq": 2,
      "describe_ch": "綜合演練中英口筆譯，以精進聽說讀寫的能力。",
      "describe_en": "To integrate students' listening, speaking, reading and writing abilities through repeated English-Chinese translating and interpreting exercises"
    }
  ],
