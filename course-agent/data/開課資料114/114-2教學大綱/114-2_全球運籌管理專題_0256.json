  "description": {
    "sub_id3": null,
    "sub_name": "全球運籌管理專題",
    "sub_ename": "INTERNATIONAL LOGISTICS MANAGEMENT SEMINAR",
    "describe_ch": "此課程包含全球營運的概念、國際物流、越境作業及全球運籌的專業知識。在課程中將拉高學生學習的角度從全球營運觀點學習國際物流的運作。研究所的全球運籌管理課程較偏重於個案分析與問題的解決。",
    "describe_eh": "Under the global operation concept, four elements are included in the international logistics management: shipping, air freight, warehouse management and trucking。The aim of this course is to train students to manage international logistics from the global operation view of point. This course is designed to be more strategic basis and problem solving in global operation management as well.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能分析國際物流管理知識，增進學生本身的國際貿易經營管理能力。",
      "describe_en": "Application for the knowledge of international logistics management in order to improve students' self-abilities of strategic management on international business."
    },
    {
      "seq": 2,
      "describe_ch": "綜合研判國際物流管理發生的問題與方向並找出解決辦法。",
      "describe_en": "Synthesis for the solutions of the problems and direction in the arena of international logistics."
    }
  ],
