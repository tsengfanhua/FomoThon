  "description": {
    "sub_id3": null,
    "sub_name": "電磁學(二)",
    "sub_ename": "ELECTROMAGNETICS(2)",
    "describe_ch": "本課程為電磁領域的入門課程，尤其強調靜磁場及時變電磁場的基本觀念及應用。主要內容包含磁場強度、磁通密度、向量磁位、馬克斯威爾方程式及時變電磁場。。",
    "describe_eh": "This course is an introductory subject on electromagnetics , emphasizing fundamental concepts and applications of static magnetic fields and time-varying fields. Topics covered include : magnetic field intensity, magnetic flux density, vector magnetic potential, maxwell's equation, time-varying fields.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、IEE1010普通物理-電、磁、光",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、IEE1010 GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
