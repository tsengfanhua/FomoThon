  "description": {
    "sub_id3": null,
    "sub_name": "消費權益與生活素養",
    "sub_ename": "CONSUMER RIGHTS AND LIVELIHOOD LITERACY",
    "describe_ch": "介紹消者保護理念與法律思維，並以實例研討方式，說明消費權益保護的相關議題，學習日常生活中所涉網路交易、電視購物、不實廣告、定型契約、產品責任、消費申訴等問題處理知能。同時加強同學們對本課程與各種社會脈絡、社會文化的整體瞭解，針對課本舉述的案例以及最近發生的消費者受害新聞事件，引導同學們對話溝通，學思並進，深化研討主題，增進其消費生活素養，並開展其社會關懷與關注社會問題的公民實踐。",
    "describe_eh": "This course introduces the concept of consumer protection and knowledge of related laws as well as dedicated issues related to consumer rights protection. Cases shall be introduced and discussed in the class for students to learn about online transactions, TV shopping, false advertising, stereotyped contracts, product liability, consumer complaints and other issues involved in daily life. At the same time, various social contexts and social cultures shall be submitted for students to communicate with each other, to learn and think simultaneously, to upgrade the discussion topics, and to increase their knowledge according to the cases cited in the textbook and the recent news of consumer victimization. It is to increase life literacy, and to develop students’ care and civic practice on social issues.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能熟悉消費權益保護的法律知識探索。",
      "describe_en": "To be familiar with the knowledge for consumer rights protection laws."
    },
    {
      "seq": 2,
      "describe_ch": "能開展學生的社會關懷視野，增進其法律生活素養的公民實踐。",
      "describe_en": "To develop the students’ civil practice and develop the vision of social care and improve their legal life literacy."
    }
  ],
