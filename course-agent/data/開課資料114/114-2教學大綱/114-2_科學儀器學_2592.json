  "description": {
    "sub_id3": null,
    "sub_name": "科學儀器學",
    "sub_ename": "SCIENTIFIC INSTRUMENTATIONS",
    "describe_ch": "教授學生現代實驗室中基礎的實驗工具與儀器以及相關技術，並輔以小組專題計畫的實施，以訓練學生整合應用所學的能力。",
    "describe_eh": "In this course, students will learn and be familiar with basic tools, instruments and techniques used in modern laboratory. Students shall work out three projects to show their ability to integrate and apply what they learn in this course.",
    "pre_subname": "PHYS1003普通物理(一)、PHYS1004普通物理(二)",
    "pre_sub_id3": "PHYS1003",
    "pre_sub_ename": "PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉科學儀器之相關知識。",
      "describe_en": "Be familiar with the knowledge related to scientific instrumentation."
    },
    {
      "seq": 2,
      "describe_ch": "能應用科學儀器及技術解決問題。",
      "describe_en": "Be able to employ scientific instruments and technologies to solve a problem."
    },
    {
      "seq": 3,
      "describe_ch": "知道如何找到科學學儀器或技術的相關資訊，並可評估其適用性。",
      "describe_en": "Know where and how to find the information about scientific instruments and technologies, and be able to evaluate the appropriateness of the obtained information."
    },
    {
      "seq": 4,
      "describe_ch": "能透過小組團隊合作進行專題計畫。",
      "describe_en": "Be able to perform a project through teamwork."
    }
  ],
