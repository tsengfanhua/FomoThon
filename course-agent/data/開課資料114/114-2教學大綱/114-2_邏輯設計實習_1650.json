  "description": {
    "sub_id3": null,
    "sub_name": "邏輯設計實習",
    "sub_ename": "LOGIC DESIGN LAB.",
    "describe_ch": "數位系統相關課程之基礎實驗, 實驗課是「為學而做，從做而學」的入門；經過本實習的親自動手，學習者應學會邏輯設計課程相關閘組合/序向網路的設計驗證, 在實務上實際面臨的尋求元件， 擺放元件、元件拉線、 儀器平台的使用與 電路功能測試等基本能力養成。此外也包括一些計算機模擬工具CAD的使用，快速驗證設計的正確性與簡單的偵錯性。引領學生對對?輯電?的思考與探討。期末將有一個小專題作設計與PCB之製作。",
    "describe_eh": "This course is a entrance training course based on \" Learning by doing , Doing for learning\" concept . After studying ,students should be able to apply their logic design theory to the analysis of logic design problems and be familial to the IC chip and Instrument's application. Especially a little topic study in the minister final is asked to all the students .They will design a circuit and to implement it using PCB.",
    "pre_subname": "IEE1006邏輯設計、IEE1000計算機概論(一)、IEE1002計算機概論實習(一)",
    "pre_sub_id3": "IEE1006",
    "pre_sub_ename": "IEE1006 LOGIC DESIGN、IEE1000 INTRODUCTION TO COMPUTER(1)、IEE1002 THE  PROGRAMMING LABORATORY(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備邏輯設計實習的基礎知識與理論",
      "describe_en": "Possess the fundamental knowledge and theory of logic design laboratory."
    },
    {
      "seq": 2,
      "describe_ch": "理解基礎的邏輯設計實習方法",
      "describe_en": "Comprehend the fundamental logic design laboratory methods."
    }
