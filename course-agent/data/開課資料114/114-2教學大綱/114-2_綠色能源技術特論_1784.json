  "description": {
    "sub_id3": null,
    "sub_name": "綠色能源技術特論",
    "sub_ename": "SPECIAL TOPICS ON GREEN ENERGY TECHNOLOGY",
    "describe_ch": "本課程旨在探討綠色能源的形成、開發及轉化的科學，並學習各種綠色能源之利用與技術發展現況，包括風力、太陽熱能與太陽光電、地熱、海洋能、水力能，以及生質能源，同時瞭解國內外綠色能源發展之策略，以及其與氣候變遷之關係與解決方法。",
    "describe_eh": "The aim of this course is to introduce the science of green energy formation, development, and conversion. This course also provides the information of green energy utilization and technology development, including wind energy, thermal solar and PV energy, geothermal, ocean, hydro energy, and biomass energy. The global and Taiwan green energy strategies and climate change related to energy utilization and its solutions are also introduced.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂綠色能源：能夠描述再生能源的生成、開發及轉化",
      "describe_en": "Define green energy with their own words: Be able to describe renewable energy formation, development, and conversion."
    },
    {
      "seq": 2,
      "describe_ch": "能理解綠色能源技術利用原理",
      "describe_en": "Comprehension for green energy technology application principles."
    },
    {
      "seq": 3,
      "describe_ch": "知道於何處可找到綠色能源的相關資訊、研究結果及標準，並可分析所獲資訊的適用性",
      "describe_en": "Know where to locate and access related green energy information, research, as well as standards, and be able to analyze the appropriateness of the obtained information."
    },
    {
      "seq": 4,
      "describe_ch": "能透過小組合作綜合綠色能源資料，並進行結果之發表",
      "describe_en": "To synthesize all green energy information and present the results through teamwork."
    }
  ],
