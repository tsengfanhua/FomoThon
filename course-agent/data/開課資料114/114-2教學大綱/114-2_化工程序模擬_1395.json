  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE08139",
    "sub_id": "07580",
    "scr_dup": "001",
    "sub_title": "化工製程與它們的電腦模擬",
    "sub_title_en": null,
    "sub_describe": "化工製程常見的、重要的有哪些？\n如何在電腦上使用套裝軟體去模擬與計算你有興趣的化工製程的質能均衡、產能、投資成本、回本期與獲利？",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "化工程序模擬",
    "sub_ename": "CHEMICAL PROCESS SIMULATION",
    "describe_ch": "近年來在化學或石油工業的製程操作上，為因應綠色製程及節能高效率的需求，快速量化的製程設計及模擬技術需求迫切，拜現今科技的發達及高速多功能電腦與軟體的發展，使得電腦輔助的化工程序模擬的夢想得以實現。為了幫助學生深入瞭解電腦輔助製程設計及模擬的重要性，本課程將利用商業套裝軟體DESIGN II教授流體力學、熱傳、及質傳等化工單元操作的製程模擬與設計。課程目標期能：1. 教導學生瞭解如何應用專業套裝軟體從事化工程序模擬與設計2. 培養學生統合理論分析與實務技術的能力",
    "describe_eh": "Over the past years in the chemical and petroleum industries there has been a gradual trend toward a more quantitative approach to problems in the design and operation of chemical processes. This trend has been made possible by the increasing use of powerful electronic computers in the solution of complex systems of mathematical equations. To complete the in-depth understanding of the design and simulation of chemical processes, the special topics of unit operations in the fluid mechanics, heat transfer, and mass transfer will be presented in this course. The course goal is to teach the fundamentals of unit operations and their applications in chemical process simulation and design with the help of commercialized DESIGN II software.",
    "pre_subname": "CHE3005化工熱力學",
    "pre_sub_id3": "CHE3005",
    "pre_sub_ename": "CHE3005 CHEMICAL ENGINEERING THERMODYNAMICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "教導學生瞭解如何應用專業套裝軟體從事化工程序模擬與裝置設計，如 DESIGN II。",
      "describe_en": "To teach the fundamentals of unit operations and their applications in chemical process simulation and design with the help of commercial software, DESIGN II."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生統合理論分析與實務技術的能力。",
      "describe_en": "Teach students to practice the ability of analysis and problem-solving techniques."
    }
  ],
