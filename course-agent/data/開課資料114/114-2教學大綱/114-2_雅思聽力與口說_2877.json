  "description": {
    "sub_id3": null,
    "sub_name": "雅思聽力與口說",
    "sub_ename": "IELTS LISTENING & SPEAKING PREPARATION",
    "describe_ch": "本堂課主要為幫助學生理解雅思聽力測驗與口說測驗兩大題型的重點以及需求，並且熟悉上述兩部分常用的基本單字與文法句型。此課程最終目標為讓學生能夠針對雅思測驗的要求以及情境順利完成兩大題型。",
    "describe_eh": "This course aims at helping students understand the listening and speaking sections in IELTS and become familiar with essential vocabulary and sentence patterns to accomplish the two sections which in the end will enable them to understand questions effectively in response to IELTS listening and speaking sections.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
