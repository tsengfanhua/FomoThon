  "description": {
    "sub_id3": null,
    "sub_name": "日文(二)",
    "sub_ename": "JAPANESE(2)",
    "describe_ch": "學習日本日常生活必備之單字、文法變化、句型及會話應用。由練習聽、讀，到進一步加強說、寫，培養興趣，並學會自修的方法。增加異國文化的介紹，拓展國際觀。",
    "describe_eh": "The course will focus on understanding basic sentence and grammatical structures and strengthening students' vocabulary skills.  This will be reinforced by the reading of articles. In addition, we will also look at Japanes culture. By increasing students' interest in the language and the culture, it is hoped that students will learn how to communicate and study more independently.",
    "pre_subname": "JAPN1001日文(一)",
    "pre_sub_id3": "JAPN1001",
    "pre_sub_ename": "JAPN1001 JAPANESE(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.學習日常生活必備表現，加強聽說讀寫。",
      "describe_en": "Learning key words that come up often in everyday life and to improve one's listening, speaking, reading, and writing abilities."
    },
    {
      "seq": 2,
      "describe_ch": "2.認識異國文化，拓展國際觀",
      "describe_en": "Understanding a foreign country's culture , expanding your global perspective."
    }
  ],
