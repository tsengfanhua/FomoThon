  "description": {
    "sub_id3": null,
    "sub_name": "雲端運算基礎",
    "sub_ename": "CLOUD FOUNDATION",
    "describe_ch": "本課程以雲端運算的基礎概念與平台服務為核心，介紹雲端服務模型（IaaS、PaaS、SaaS）、雲端架構原理、成本與安全觀念，並透過實作了解雲端平台的基本操作與資源管理方式。課程結合理論說明與雲端平台實務操作，使學生建立雲端運算的整體認知與應用基礎。",
    "describe_eh": "This course focuses on the fundamental concepts of cloud computing and cloud platform services. It introduces cloud service models (IaaS, PaaS, and SaaS), cloud architecture principles, cost management, and security considerations. Through hands-on exercises, students will gain practical experience with basic cloud platform operations and resource management. By integrating theoretical explanations with practical cloud platform usage, the course aims to build a comprehensive understanding of cloud computing and establish a solid foundation for its applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習雲端運算的基本概念、架構與服務模式",
      "describe_en": "To learn the fundamental concepts, architectures, and service models of cloud computing"
    },
    {
      "seq": 2,
      "describe_ch": "理解雲端平台在企業與產業中的應用情境與運作原理",
      "describe_en": "To understand the operational principles and enterprise applications of cloud platforms"
    },
    {
      "seq": 3,
      "describe_ch": "分析雲端服務對企業營運、成本與資訊系統架構之影響",
      "describe_en": "To analyze the impact of cloud services on enterprise operations, cost, and IT architecture"
    }
  ],
