  "description": {
    "sub_id3": null,
    "sub_name": "退休理財規劃",
    "sub_ename": "RETIREMENT FINANCIAL PLANNING",
    "describe_ch": "本課程希望訓練全方位的專業退休理財規劃人員，主要內容包括台灣長壽風險趨勢、退休理財規劃原則與金融保險退休市場相關專業理論基礎與重要市場商品實務。",
    "describe_eh": "This course trains students to be retirement financial advisors with full dimensional professional knowledge. This content contains the trend of longevity risk in Taiwan, the principles in retirement financial planning, professional theoretical foundation for the financial market, and retirement product practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知道長壽風險、台灣社會保險與退休制度",
      "describe_en": "Students can know the longevity risk, social insurance and retirement system in Taiwan."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解各種退休理財商品的功用",
      "describe_en": "Students can understand the different functions of different financial products linked with retirement."
    },
    {
      "seq": 3,
      "describe_ch": "能製作退休理財計畫",
      "describe_en": "Students can make a financial plan for retirement."
    }
  ],
