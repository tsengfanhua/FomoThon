    {
      "seq": 1,
      "describe_ch": "具備整合及評估理論與實務的能力\t",
      "describe_en": "Ability to integrate and evaluate the theory and practice."
    },
    {
      "seq": 2,
      "describe_ch": "具備綜合評估實務案例及撰寫專業技術報告的能力\t",
      "describe_en": "Ability to evaluate practical engineering analysis and to write professional engineering report."
    },
    {
      "seq": 3,
      "describe_ch": "具備終身學習、專業倫理及社會責任的基本素養",
      "describe_en": "\tRecognition of life-long learning, engineering ethics and social responsibilities."
    }
