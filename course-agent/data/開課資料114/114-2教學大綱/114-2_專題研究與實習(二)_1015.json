    "sub_name": "專題研究與實習(二)",
    "sub_ename": "FIELD STUDIES AND INTERNSHIP(2)",
    "describe_ch": "本課程提供學生在業界實習及專題研究之經驗，強化學生實習實務及專題研究知識，培養學生務實致用能力，以提升畢業生就業力。\r\n",
    "describe_eh": "This course offers students an experience to study and research off-campus in enterprise. The course purposes are to let students integrate the theory and practice, strengthen professional skills, and improve professional competitiveness.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 8.0
  },
