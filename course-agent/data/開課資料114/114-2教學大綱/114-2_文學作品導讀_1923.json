  "description": {
    "sub_id3": null,
    "sub_name": "文學作品導讀",
    "sub_ename": "APPROACHES TO LITERATURE",
    "describe_ch": "由淺而深循序漸進閱讀詩歌、小說、戲劇中的代表作品，導覽學生一探西洋文學殿堂的寶藏，教導學生基本閱讀策略、鑑賞分析與邏輯批判、文學術語及基礎理論。\r\n",
    "describe_eh": "This is an elective course for English-major freshman students. Through reading methodically on English general popular works of fiction, poetry, and drama, the course offers a guided tour to the treasure island of Western literature. It aims to give basic and fundamental training in reading strategy, perceptive analysis, and logical thinking, and furthermore, literary terms and critical approaches are introduced.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
