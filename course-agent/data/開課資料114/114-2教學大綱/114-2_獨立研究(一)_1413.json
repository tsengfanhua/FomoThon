  "description": {
    "sub_id3": null,
    "sub_name": "獨立研究(一)",
    "sub_ename": "INDEPENDENT STUDY(1)",
    "describe_ch": "獨立研究作為教育的一種形式，涉及直接研究、且是個人在較少或甚至無監督的情形下進行 研究的教育活動。學生和教授共同討論出一個研究主題，並在教師的輔導 (tutorial meetings) 下 進行研究。本學期的主要目標是協助學生面對該解決的問題，並擬定研究方法及策略。",
    "describe_eh": "Independent study is a form of education. It is referred to as directed study, and is an educational activity undertaken by an individual with little to no supervision. A student and professor agree upon a topic for the student to research with guidance from the tutor for an agreed upon amount of credits.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "提供學生主動的持續探索其感興趣的主題",
      "describe_en": "To provide a way for well-motivated students to pursue a topic of interest."
    },
    {
      "seq": 2,
      "describe_ch": "取得獨特的材料之道",
      "describe_en": "To learn specialized material"
    },
    {
      "seq": 3,
      "describe_ch": "獲取研究經驗",
      "describe_en": "To gain research experience"
    },
    {
      "seq": 4,
      "describe_ch": "提供更深入地去探索自己的興趣的機會",
      "describe_en": "To provide students opportunities to explore their interests deeper."
    },
    {
      "seq": 5,
      "describe_ch": "為其未來將如何即在何處引導其才能做出決定提供機會",
      "describe_en": "To make important decisions about how and where they will direct their talents in the future."
    }
  ],
