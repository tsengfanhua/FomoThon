  "description": {
    "sub_id3": null,
    "sub_name": "電子學實驗(二)",
    "sub_ename": "ELECTRONICS LAB.(2)",
    "describe_ch": "接續電子學實驗(一)，訓練學生對於電晶體元件特性、基本類比放大電路特性量測和頻率響應以及多極放大迴授電路分析。學生必須熟悉電路接線技術和電路模擬分析技術，藉由電子學(二)所教授的內容，實驗操作驗證各種電子電路功能，培養學生應用電路量測與設計。　",
    "describe_eh": "This lab course is an extention of Electronics Lab (1). Students will explore fundamental electronic principles and electronic circuit operation including transistor characteristics, basic analog amplifier circuit design, frequency response and feedback circuits. Students in laboratory will learn the use of electronic instruments, layout technique, and computer programming in PSPICE through hands-on circuit design experiments and computer simulation.select components, analyze and apply circuit models, complete application project production, and evaluate system specifications. Cultivate students with practical skills and abilities on the topic of electronic circuit applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能分類不同電晶體結構。理解電子學(二)所教授之內容。",
      "describe_en": "Be able to classify the structures of different transistors, understand the content of the course Electronics (2)."
    },
    {
      "seq": 2,
      "describe_ch": "運用實際電路之技巧，說明電晶體及放大電路之工作情形。",
      "describe_en": "Be able to apply the techniques to real circuits, to explain how transistors and amplifying circuits work."
    },
    {
      "seq": 3,
      "describe_ch": "分析電路技術，評析電路特性及頻率響應。　",
      "describe_en": "Be able to analyze the electronic circuits, to evaluate the characteristics of circuits and the frequency response."
    }
  ],
