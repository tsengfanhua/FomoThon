  "description": {
    "sub_id3": null,
    "sub_name": "生醫信號處理",
    "sub_ename": "BIOMEDICAL SIGNAL PROCESSING",
    "describe_ch": "生醫信號處理為一門應用學科，本科目最主要之學習目的為將數位信號處理應用於醫學工程當中。主要學習過程可分成三個部分，分別為程式軟體、硬體儀器、理論與演算法，將理論與實務結合，期能提升學生學習成效。",
    "describe_eh": "Biosignal processing is an applied course that involves digital signal processing in biomedical engineering. The main topics include programming, devices, theories and algorithms. To increase the outcome of this course, methodologies for both teaching and practicing will be emphasized.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解生醫信號特性與生醫信號量測的知識。",
      "describe_en": "Knowledge on the characteristics and measurement principles of biomedical signals."
    },
    {
      "seq": 2,
      "describe_ch": "理解數位信號處理的基本原理。",
      "describe_en": "Comprehension on the basic principles of digital signal processing."
    },
    {
      "seq": 3,
      "describe_ch": "分析生醫信號並解釋其生理意義。",
      "describe_en": "Analysis of biomedical signal and its physiological implication."
    }
  ],
