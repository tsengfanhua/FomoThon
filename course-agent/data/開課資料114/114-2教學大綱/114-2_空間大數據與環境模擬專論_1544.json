  "description": {
    "sub_id3": null,
    "sub_name": "空間大數據與環境模擬專論",
    "sub_ename": "ADVANCED DISCUSSION ON SPATIAL BIG DATA AND ENVIRONMENTAL SIMULATION",
    "describe_ch": "本課程可讓學生學習分析環境及生態變數之空間大數據分佈特性、空間異質性、空間尺度與空間不確定性的方法，並培養學生對GIS領域之實務分析及理論研究之相關能力。",
    "describe_eh": "The course will provide basic knowledge of the characteristics of big data on spatial distribution, spatial heterogeneity, spatial scale and spatial uncertainty of environmental and ecological variables. Students can also learn the ability of practical analysis and theory research in the GIS field.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用空間分析之理論與技術",
      "describe_en": "Application of theories and techniques of spatial analysis."
    },
    {
      "seq": 2,
      "describe_ch": "能應用專業技能解決實務問題",
      "describe_en": "Application of the professional skills to solve practical problems."
    },
    {
      "seq": 3,
      "describe_ch": "能導出專業判斷與分析決策",
      "describe_en": "Synthesis of professional judgement and analytical decision-making."
    }
  ],
