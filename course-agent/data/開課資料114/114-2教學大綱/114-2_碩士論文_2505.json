  "description": {
    "sub_id3": null,
    "sub_name": "碩士論文",
    "sub_ename": "MASTER THESIS",
    "describe_ch": "本課程將要求學生針對學術專業問題進行深入研究與探討，並將研究過程和成果撰寫成研究論文，進而強化學生執行研究與解決問題的能力。論文內容架構需包含導論、文獻回顧、方法、結果與討論、結論及參考文獻。",
    "describe_eh": "This course will require students to conduct in-depth research and discussion on academic and professional issues and write research processes and results into research papers, strengthening students' ability to perform research and solve problems. The content structure of the paper should include introduction, literature review, methods, results and discussions, conclusions, and references.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備材料科學與工程的專業知識\t\t",
      "describe_en": "To Possess professional knowledge on material science and engineering"
    },
    {
      "seq": 2,
      "describe_ch": "具備規劃與執行研究計畫的能力\t",
      "describe_en": "Be able to plan and implement research projects"
    },
    {
      "seq": 3,
      "describe_ch": "具備完成正式學術著作的能力。",
      "describe_en": "Be able to finish the dissertations formally."
    },
    {
      "seq": 4,
      "describe_ch": "具備學術研究創見與解決材料研發問題的能力。\t",
      "describe_en": "Be able to have the innovative originality in academic research and solve the problem of material."
    },
    {
      "seq": 5,
      "describe_ch": "具備協調溝通與團隊合作之能力\t",
      "describe_en": "To engage in effective communication and strategies of teamwork"
    },
    {
      "seq": 6,
      "describe_ch": "具備蒐集與整理文獻的能力。\t\t",
      "describe_en": "Be able to collect, survey and review the literature."
    },
    {
      "seq": 7,
      "describe_ch": "具備帶領材料研究與分析問題的能力。\t",
      "describe_en": "Be able to lead materials research and issue analysis."
    },
    {
      "seq": 8,
      "describe_ch": "具備終身學習的基本素養\t\t",
      "describe_en": "To possess the cultivation of life-long learning responsibilities"
    }
  ],
