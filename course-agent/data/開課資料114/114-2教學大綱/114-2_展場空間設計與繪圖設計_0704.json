  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB26129",
    "sub_id": "41013",
    "scr_dup": "001",
    "sub_title": "以電腦繪圖軟體輔助學生學習空間及嘗試空間規劃設計。",
    "sub_title_en": null,
    "sub_describe": "空間的學習早期均以製作模型來協助教學，到了電腦繪圖非常普及的時代，教師採用電腦繪圖軟體來輔助學生學習，是非常符合時代潮流，之外，學生也因此學習到科技的技能和運用。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "展場空間設計與繪圖設計",
    "sub_ename": "EXHIBITION SPACE DESIGN AND DRAWING DESIGN",
    "describe_ch": "運用3Ds Max與Auto CAD軟體教學，讓學生了解展場空間設計的操作與實務，以增進學生的就業競爭力，課程涵蓋展場的行銷設計策略與空間規劃。",
    "describe_eh": "Teach students how to design and operate the practice of exhibition space by using the design software of 3Ds Max and Auto CAD in order to enhance their competitiveness. The course covers the marketing design strategy and spatial planning of the exhibition.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.\t展場空間的設計專業",
      "describe_en": "Design space for exhibition space"
