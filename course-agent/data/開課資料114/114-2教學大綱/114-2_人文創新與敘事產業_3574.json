  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CS04130",
    "sub_id": "12351",
    "scr_dup": "001",
    "sub_title": "以「敘事力」作為人文創新的核心探討人文社會如何以創意實踐推動文化永續與社會轉型。",
    "sub_title_en": null,
    "sub_describe": "本課的人文「敘事力」將文學、劇場、廣播、影視、自媒體、地方創生等多重角度與跨國比較的模式來放眼在地與全球。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "人文創新與敘事產業",
    "sub_ename": "HUMANISTIC INNOVATION AND THE NARRATIVE INDUSTRIES",
    "describe_ch": "本課程以「敘事力」作為人文創新的核心，從文學、劇場、廣播、影視、自媒體、地方創生等多重角度與跨國比較的模式增加國際視野，以探討人文社會如何以創意實踐推動文化永續與社會轉型。",
    "describe_eh": "This course takes “narrative competence” as the core of humanistic innovation.\nThrough multiple perspectives—including literature, theater, radio, film, digital media, and regional revitalization—and a comparative international approach, it broadens global vision while exploring how the humanities and social sciences can employ creative practices to promote cultural sustainability and social transformation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "在跨領域合作中發展創造力與同理心",
      "describe_en": "Develop creativity and empathy through interdisciplinary collaboration"
    },
    {
      "seq": 2,
      "describe_ch": "以故事、影像、聲音與行動為媒介，探索文化與社會的連結",
      "describe_en": "Use story, image, sound, and action as mediums to explore the connections between culture and society"
    },
    {
      "seq": 3,
      "describe_ch": "透過藝術與人文的力量，回應當代社會的挑戰與變化",
      "describe_en": "Respond to contemporary social challenges and changes through the power of art and the humanities"
    }
  ],
