  "description": {
    "sub_id3": null,
    "sub_name": "專案管理導論",
    "sub_ename": "FUNDAMENTALS OF PROJECT MANAGEMENT",
    "describe_ch": "介紹專案管理的理論，說明專案的各個階段，以及闡述規劃、執行及控制專案活動的方法和程序。\r\n",
    "describe_eh": "The purpose of this course is to introduce the principles of project management, to describe the stages of a project, and to investigate the methods and procedures for planning and controlling project activities.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂專案管理，而且知道如何運用於各種不同環境中。",
      "describe_en": "Be able to define Project Management with their own words and know how to use it in various environments."
    },
    {
      "seq": 4,
      "describe_ch": "知道於何處可找到專案管理的相關資訊，並可評估所獲資訊的適用性。",
      "describe_en": "Know where to locate and access related Project Management information, research, as well as standards, and be able to evaluate the appropriateness of the obtained information."
    },
    {
      "seq": 5,
      "describe_ch": "能以書面或口頭方式將所獲結果與同儕、助教及教師溝通。",
      "describe_en": "Communicate results in written or oral form to classmates, teaching assistants, and the instructor."
    },
    {
      "seq": 6,
      "describe_ch": "能透過小組展現團隊合作能力。",
      "describe_en": "Demonstrate esprit de corps (team spirit) through teamwork."
    }
  ],
