  "description": {
    "sub_id3": null,
    "sub_name": "微生物學實驗",
    "sub_ename": "MICROBIOLOGY LAB.",
    "describe_ch": "本課程規畫主要搭配微生物學中所介紹之分析工具及方法，包含微生物鏡檢，細菌之培養，鑑定及生長控制，水質指標微生物檢測及生長因素等之基礎實驗。有助於未來從事環境檢驗、評估工作上及未來繼續進修之基礎專業技能。",
    "describe_eh": "The primary object of this course is to provide the students having skills in basic microbiological methods, including examination with microscope, aseptic techniques, culturing of bacteria and identification of bacteria.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能分析微生物與生物之差異，並了解微生物學之進展。　",
      "describe_en": "Be able to clearly differenciate the difference between microorganisms and organisms, and understand the development of microbiology.　"
    },
    {
      "seq": 2,
      "describe_ch": "能理解微生物應用之範圍，並能清楚表達。　\t",
      "describe_en": "Distinguish and clearly express the fields in which the microorganisms can be applied.　"
    },
    {
      "seq": 3,
      "describe_ch": "應用相關設備，分析探討結果。　\t",
      "describe_en": "Be able to use related equipments to perform an experiment, and draw appropriate conclusions from the results.　"
    },
    {
      "seq": 4,
      "describe_ch": "能夠正確執行微生物實驗器材和儀器的操作維護",
      "describe_en": "know how to operate and maintain the experimental equipment and instruments"
    },
    {
      "seq": 5,
      "describe_ch": "能夠透過分組實驗培養團隊溝通合作能力\t",
      "describe_en": "Develop communication and cooperation ability through teamwork"
    },
    {
      "seq": 6,
      "describe_ch": "應用微生物實驗所學之實驗技巧協助評估及解決環境問題\t",
      "describe_en": "To assess and solve environmental problems by applying the experimental skills in this course"
    },
    {
      "seq": 7,
      "describe_ch": "連結並理解當今的環境問題以及生物處理成程序適用範圍\t",
      "describe_en": "Be able to understand current environmental problem and the application of biological treatment process"
    },
    {
      "seq": 8,
      "describe_ch": "理解學術倫理以及不當研究行為的嚴重性\t",
      "describe_en": "Understand academic ethics and the seriousness of research misconduct"
    }
  ],
