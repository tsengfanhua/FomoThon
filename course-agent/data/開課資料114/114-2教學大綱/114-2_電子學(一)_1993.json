  "description": {
    "sub_id3": null,
    "sub_name": "電子學(一)",
    "sub_ename": "ELECTRONICS(1)",
    "describe_ch": "本課程介紹基礎電子學原理、電子元件特性和分析基本電子電路。課程包括電子學發展史、基礎放大器觀念、半導體電子元件與電子電路模擬分析，電子元件的特性與操作應用講授，含半導體物理概論、運算放大器、二極體和雙載子電晶體之直流與交流模型分析。",
    "describe_eh": "The course is design to introduce fundamental principle of electronics, electronic device's characteristics, and electronic circuit analysis. Students will engage in the study of basic concepts including amplifiers and circuit models, history of microelectronics, basic semiconductor physics, operational amplifiers, diodes and bipolar junction transistor circuit models. A student fulfills the course requirements who will have demonstrated a familiarity with basic electrical characteristics of common semiconductor devices and to analyze dc bias circuits.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解各種電子元件之基本功能與電路知識",
      "describe_en": "Understanding the basic function and circuit knowledge of various electronic devices."
    },
    {
      "seq": 2,
      "describe_ch": "理解各種電子元件與電子電路的工程原理",
      "describe_en": "Comprehension for the engineering principle of various electronic devices and electronic circuits."
    },
    {
      "seq": 3,
      "describe_ch": "應用各種電子實驗設備完成電子電路之測試與設計",
      "describe_en": "Application for the electronic instruments to circuit testing and design."
    },
    {
      "seq": 4,
      "describe_ch": "運用電子電路分析軟體完成電子電路之特性分析",
      "describe_en": "Apply the circuits simulation tool box to circuits characteristic analysis."
    }
  ],
