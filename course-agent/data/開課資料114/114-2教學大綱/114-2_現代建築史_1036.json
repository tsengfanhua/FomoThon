  "description": {
    "sub_id3": null,
    "sub_name": "現代建築史",
    "sub_ename": "HISTORY OF CONTEMPORARY ARCHITECTURE",
    "describe_ch": "本課程的重點主要在探討1945年以後的建築史發展，焦點集中在主要的建築理論家、設計潮流、建築師和他們在世界各地的知名建築。另外，也特別針對從第二次世界大戰以後，全世界各地在建築上的發展原則進行分析討論。因此本課程不僅僅只是探討建築物其歷史、風格與文化背景的差異，而是更希望去瞭解這些理論與目標背後的時代精神。",
    "describe_eh": "This lecture is devoted to the modern history of architecture since the 1945s, focusing on the major theorists, design trends, architects and their buildings according to different district and era. Emphasis is placed on analysis of some of the principal developments in architecture throughout the world since World War II. This includes not just on the buildings as seen within their original historical, style, and cultural contexts, but the theories and aims that motivated them.",
    "pre_subname": "ARCH3301近代建築史",
    "pre_sub_id3": "ARCH3301",
    "pre_sub_ename": "ARCH3301 HISTORY OF MODERN ARCHITECTURE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "對於現代建築史的發展以及現代的建築大師及其傑出作品能夠有充份的認識。",
      "describe_en": "To be able to comprehend the history of Contemporary Architecture and to get a good understanding of architectural masters and masterpieces on history of Contemporary Architecture."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解建築史在建築設計與建築發展過程中的重要性，同時透過課程的訓練思考設計並將所學應用在建築設計上。",
      "describe_en": "To understand the importance of architectural history on the process of design, and how to apply architectural history, style, masters and masterpieces into architectural design."
    },
    {
      "seq": 3,
      "describe_ch": "透過大量建築文獻的深入閱讀來瞭解建築作品的深層價值，同時能以書面或口頭方式將所獲結果與同儕、助教及教師溝通，並且透過小組報告展現團隊合作能力。",
      "describe_en": "Through documents reading and discussion to cultivate an ability to converse about cases (of architecture) with classmates by teamwork and communicate with teachers by oral reports."
    }
  ],
