  "description": {
    "sub_id3": null,
    "sub_name": "英文書報討論(二)",
    "sub_ename": "REVIEW ON TECHNICAL WRITINGS(2)",
    "describe_ch": "本課程目標在於如何從圖書館查詢英文專業論文，與如何使用適當修辭學寫作純熟的文章。介紹大學寫作元素以便利學生之專業寫作能力。",
    "describe_eh": "This course aims at how to find an English technical paper from the library and how to write a sophisticated essay using proper rhetoric. Elements of college composition will be introduced to facilitate students in technical writings.",
    "pre_subname": "COND6085英文書報討論(一)",
    "pre_sub_id3": "COND6085",
    "pre_sub_ename": "COND6085 REVIEW ON TECHNICAL WRITINGS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能熟悉學校之英文資料庫使用及搜尋方法。",
      "describe_en": "Be able to be familiar with the use of the English electronic resources in FCU."
    },
    {
      "seq": 2,
      "describe_ch": "能夠利用寫作元素於研究專業寫作。",
      "describe_en": "Be able to utilize the elements of composition in research technical writings."
    },
    {
      "seq": 3,
      "describe_ch": "能夠對一主題綜合分析不同出處的資訊。",
      "describe_en": "Be able to synthesize information from different sources on a subject."
    }
  ],
