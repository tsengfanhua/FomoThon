    "sub_name": "高階領導與人力資源管理",
    "sub_ename": "LEADERSHIP AND HUMAN RESOURCES MANAGEMENT",
    "describe_ch": "本課程提供學生瞭解並掌握人力資源管理的基本概念、理論與應用技術，以期達到理論與實務相結合的目標，引發學生關切人力資源管理與發展的興趣。",
    "describe_eh": "This course provides students with an understanding and mastery of the basic concepts, theories and application techniques of human resource management, in order to achieve the goal of combining theory and practice, and arouse students' interest in human resource management and development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "分析人力資源管理功能以討論跨文化上的差異　 　　\t",
      "describe_en": "Analysis of the functions of HRM for distinguishing the cross-cultural experiences."
    },
    {
      "seq": 2,
      "describe_ch": "評鑑人力資源管理之重要概念，並提升領導能力與人際網絡之發展\t",
      "describe_en": "Application of the main concepts of HRM for increasing the leadership ability as well as the develop of network relationships."
    }
