  "description": {
    "sub_id3": null,
    "sub_name": "積體光學",
    "sub_ename": "INTEGRATED OPTICS",
    "describe_ch": "本課為為跨入任何以積體光學元件製作的先修課程。本課程將由電磁學之基本概念與模型出發，介紹平面波導的物理特性，如分光、分波等，最後將討論相關元件在日常生活的應用。",
    "describe_eh": "As a fundamental course of device, it is suitable for students to take the course before taking other advanced courses of integrated optics device. The course begins from the basic concepts and models via electromagnetism theory. The principles and physical characteristics of planar waveguide are discussed, including beam-splitter, wavelength division Multiplexing, ect. Finally, several devices in the daily life will be introduced.",
    "pre_subname": "OPT2002光學(二)、PHYS2002電磁學(二)",
    "pre_sub_id3": "OPT2002",
    "pre_sub_ename": "OPT2002 OPTICS (2)、PHYS2002 ELECTROMAGNETICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "以電磁傳播基本概念，瞭解平面波導的物理模型。",
      "describe_en": "With the basic concepts of electromagnetic wave propagation, and understand the physics model of planar waveguide."
    },
    {
      "seq": 2,
      "describe_ch": "理解積體光學工作原理與光學特性，元件應用。",
      "describe_en": "Understand the principles and optical characteristics, and the applications of integrated optical devices."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉積體光學元件的專業術語，指引學生處理和分析積體光學元件的問題。",
      "describe_en": "Be familiar with the related terms in the integrated optical device. Be able to solve and analysis the problems of integrated optical devices."
    }
  ],
