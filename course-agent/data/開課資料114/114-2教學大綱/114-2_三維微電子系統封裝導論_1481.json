  "description": {
    "sub_id3": null,
    "sub_name": "三維微電子系統封裝導論",
    "sub_ename": "INTRODUCTION TO 3D MICROELECTRONIC SYSTEM PACKAGE",
    "describe_ch": "此課程主要針對三維積體電路系統封裝和技術開發，其中包含二維至三維封裝設計，電性特徵及可靠度分析，從凸塊技術，扇出形晶圓級封裝至三維小晶片堆疊，包含三維積體電路異質整合與應用。",
    "describe_eh": "This course focuses on 3D IC system package and technology development including 2D-to-3D package design, electrical characterization and reliability from bumping, wafer-level fan-out technology and chiplet 3D stacking with 3D IC heterogenous integration and application coverage.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "三維積體電路系統封裝和異質整合之全面概念。",
      "describe_en": "Overall concept of 3DIC system-in-package and heterogenous integration"
    },
    {
      "seq": 2,
      "describe_ch": "三維積體電路系統封裝製程技術及可靠度分析。",
      "describe_en": "Process and reliability of 3DIC system-in-package technology"
    },
    {
      "seq": 3,
      "describe_ch": "三維積體電路系統封裝技術之實際市場需求與商業應用。",
      "describe_en": "Markets and applications of state-of-art 3DIC system-in-package technology"
    }
  ],
