  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CD00101",
    "sub_id": "45881",
    "scr_dup": "001",
    "sub_title": "智慧城市與生活建構過程中所扮演角色",
    "sub_title_en": null,
    "sub_describe": "教導學生清楚定義未來城市智慧生活與永續指標（SDGs）的關聯對照，並藉由未來生活的想像，探究智慧城市應有之功能。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "未來城市與智慧生活",
    "sub_ename": "FUTURE CITIES AND SMART LIVING",
    "describe_ch": "本課程係針對非建設學院學生開設，主要在透過國外案例之介紹，及學生對未來城市和智慧活的想像和體驗，探索建設學院相關專業在智慧城市與生活建構過程中所扮演角色。課程以包浩斯教育模式為靈感，採用「基礎理論 → 工坊實作 → 整合實踐」的三階段架構，讓學生建立對「智慧城市」發展在知識、技術與經驗上的探索，從認知建構到能力培養，最終能夠具備面對未來城市挑戰的基礎素養。",
    "describe_eh": "This course is designed for students outside the College of Construction and Development. Through global case studies and imaginative engagement with future cities and smart living, students explore how construction-related disciplines contribute to shaping urban life. Inspired by the Bauhaus model, the course follows a three-stage structure: Theory → Workshop → Integrated Practice. Students build foundational knowledge of smart city development, gain hands-on experience, and integrate insights across disciplines. The course fosters creative thinking and practical skills, preparing students to meet the challenges of future urban environments with confidence and interdisciplinary awareness.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "強化學生跨領域整合能力與國際化視野。",
      "describe_en": "Strengthen students' integration ability on cross-disciplines and with international vision."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生創新、獨立思考與團隊合作能力。",
      "describe_en": "Cultivate students' ability of innovation, independent thinking and teamwork."
    },
    {
      "seq": 3,
      "describe_ch": "培育學生專業及資訊倫理並具備聯合國永續發展目標(SDGs)素養。",
      "describe_en": "Cultivate students in professional and information ethics and have SDGs literacy."
    }
  ],
