  "description": {
    "sub_id3": null,
    "sub_name": "不動產估價實務",
    "sub_ename": "EXERCISE OF REAL ESTATE VALUATION",
    "describe_ch": "本課程係探討不動產估價之實務面，經由理論、原則、方法之介紹，結合不動產估價相關法規用運用及實例予以說明，裨益學習者參加不動產估價師證照考試，希望達到學習者能親自體會如何估價，進而達到能掌握合理不動產市場價格。",
    "describe_eh": "The first goal of this course is to introduce the terminology & definition of value, the appraisal principles and concepts of property and property rights. The second goal is to learn the market data approach, cost approach, income approach to estimate the property value. The third goal is to learn how to use the methods to accomplish the first uniform standard report.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解各種不動產估價方法與計算",
      "describe_en": "Understanding the method and calculation of real estate valuation"
    },
    {
      "seq": 2,
      "describe_ch": "具備不動產估價報告撰寫能力",
      "describe_en": "To have the ability of making real estate appraisal report"
    }
  ],
