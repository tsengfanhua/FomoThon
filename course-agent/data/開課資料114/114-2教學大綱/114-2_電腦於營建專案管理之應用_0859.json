  "description": {
    "sub_id3": null,
    "sub_name": "電腦於營建專案管理之應用",
    "sub_ename": "THE APPLICATION OF COMPUTER IN CONSTRUCTION PROJECT",
    "describe_ch": "本課程介紹營建專案管理方法在電腦上之應用實例。內容包含營建專案之進度、成本等基本概念與初步應用，使學生能學習如何將電腦應用在營建專案管理。",
    "describe_eh": "This course discusses computer applications for construction project management, and the creation and distribution of information within the construction industry. It includes such topics as: networking and communication technologies; digital document formats and environments; spreadsheets; database systems; computer programs for project planning, cost estimating and cost management; shared project information databases; and project management with estimating and planning applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生認知工程專案管理基本概念",
      "describe_en": "Be able to understand the concept of project management in construction."
    },
    {
      "seq": 2,
      "describe_ch": "使學生了解電腦化工程專案管理的內容",
      "describe_en": "To understand the content of   computer-based project management in construction."
    },
    {
      "seq": 3,
      "describe_ch": "教導學生瞭解如何讓電腦應用於工程專案管理",
      "describe_en": "To understand the application of project-based in construction."
    },
    {
      "seq": 4,
      "describe_ch": "藉由電腦應用提昇學生面對工程專案管理的能力",
      "describe_en": "To promote students' capability in facing the related problems of construction management through the education of morality."
    },
    {
      "seq": 5,
      "describe_ch": "能以書面或口頭方式將所獲結果與同儕、助教及教師溝通",
      "describe_en": "Be able to communicate results either in written or oral form with classmates, teaching assistants, and the instructor."
    },
    {
      "seq": 6,
      "describe_ch": "能透過小組展現團隊合作能力",
      "describe_en": " Be able to demonstrate management leadership through teamwork."
    }
  ],
