  "description": {
    "sub_id3": null,
    "sub_name": "法律解釋方法與法學論文撰寫",
    "sub_ename": "STATUTE INTERPRETATION METHOD AND LEGAL THESIS WRITING",
    "describe_ch": "本課程將使學生理解法律解釋方法與法學研究論文撰寫，使學生熟悉法律解釋的基本方法以及法學論文寫作的基本技巧，以求培養學生具備基本的法律解釋方法與法學論文寫作之能力。",
    "describe_eh": "This course will introduce statutory interpretation method and legal thesis writing skills. The teaching goal of this course is to develop students’ abilities to statutory interpretation method and basic legal thesis writing skills",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉並了解法律解釋的基本概念",
      "describe_en": "Understanding basic concept of statutory interpretation method."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉並瞭解如何進行法學論文寫作",
      "describe_en": "Learning the approach of legal thesis writing."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉並能應用法律解釋與論文寫作之技巧",
      "describe_en": "Understanding and being able to apply statutory interpretation method and legal thesis writing skills."
    }
