  "description": {
    "sub_id3": null,
    "sub_name": "大眾運輸系統學",
    "sub_ename": "PUBLIC TRANSPORTATION SYSTEM",
    "describe_ch": "首先介紹各種不同之大眾運輸系統，其次規劃設計不同之大眾運輸系統，最後學習大眾運輸系統之各種營運管理方法。",
    "describe_eh": "The purpose of this course consists of (1) to introduce the various system of public transportation. (2) To learn how to plan and design the various public transportation systems. (3) To learn how to manage the various.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.教授各運輸或物流系統之特性與相關基本概念",
      "describe_en": "1.Provide students with knowledge of the characteristics and fundamental concepts of various transportation and logistics systems."
    },
    {
      "seq": 2,
      "describe_ch": "3.教授相關先進科技與技術於運輸或物流領域之應用潛力與案例",
      "describe_en": "3. Provide students with knowledge of the potential applications and case studies of advanced technologies and techniques in the transportation and logistics field."
    },
    {
      "seq": 3,
      "describe_ch": "4.教授運輸或物流相關政策與法規內涵及時事之評析能力",
      "describe_en": "4. Provide students with knowledge of transportation and logistics-related policies and regulations, and develop their ability to analyze current issues."
    }
  ],
