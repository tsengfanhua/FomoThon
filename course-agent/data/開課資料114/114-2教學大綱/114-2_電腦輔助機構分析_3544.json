  "description": {
    "sub_id3": null,
    "sub_name": "電腦輔助機構分析",
    "sub_ename": "COMPUTER-AIDED MECHANISM ANALYSIS",
    "describe_ch": "學習使用以電腦圖形為介面，結合機構學、剛體動力學、數值分析的機械運動模擬軟體MSC.ADAMS ，將多剛體運動解析過程與電腦輔助技術結合，使動力學與機動學課程更具機器設計之工程實務應用性。本課程為虛擬原型的基礎課程。",
    "describe_eh": "Build up the ability of using multibody dynamics software MSC.ADAMS  which is a graphic interface and integrating mechanisms, rigid body dynamics and numerical method commercial software. The goal of this course is to build a solid foundation in practical machine design. This course is a basic technology in virtual product development.",
    "pre_subname": "MCAE2003機動學(一)、MCAE2004機動學(二)、ENGS1009應用力學(二)",
    "pre_sub_id3": "MCAE2003",
    "pre_sub_ename": "MCAE2003 MECHANISM(1)、MCAE2004 MECHANISM(2)、ENGS1009 APPLIED MECHANICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建立開發電腦輔助虛擬機械原型的能力。",
      "describe_en": "Develop the ability of building a computer-aided virtual prototype of machine."
    },
    {
      "seq": 2,
      "describe_ch": "建立利用運動學與動力學測試虛擬原型的能力。",
      "describe_en": "Develop the ability of testing the virtual prototype by analyzing the kinematics and dynamics."
    },
    {
      "seq": 3,
      "describe_ch": "建立檢視並改進虛擬原型的能力，以解決機構設計的問題。",
      "describe_en": "Develop the ability of reviewing and improving the prototype to solve the design problem."
    }
  ],
