  "iSoftwares": [
    {
      "yms_year": 114.0,
      "yms_smester": 2.0,
      "cls_id": "CE04149",
      "sub_id": "53955",
      "scr_dup": "001",
      "seq_no": 1,
      "soft_kind": "2",
      "soft_name": "Solidworks Motion\n\nPython",
      "soft_memo": "<div>1. SolidWorks Motion<br />\n導入 SolidWorks Motion 進行機構運動學與動力學模擬。重點在於引導使用者熟悉商業軟體的約束（Mates）、驅動（Motor）設定，並學習產出位移、速度、加速度與受力數據圖表。此階段作為後續程式開發的基準驗證，協助學生理解機構運動的直覺物理現象。</div>\n\n<div>&nbsp;</div>\n\n<div>2. Python<br />\n利用 Python 進行數值運算與底層演算法實作。核心目標為撰寫演算法來求解連桿機構的非線性向量閉迴路方程式。此外，結合 Peter Corke 的 Robotics Toolbox 進行開放式與封閉式連桿的建模與模擬對比，讓學生掌握從幾何約束到機器人運動學架構的系統化分析能力。</div>\n",
      "soft_name_en": null,
      "soft_memo_en": null
    }
  ],
