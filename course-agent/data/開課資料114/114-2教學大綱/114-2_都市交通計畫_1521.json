  "description": {
    "sub_id3": null,
    "sub_name": "都市交通計畫",
    "sub_ename": "URBAN TRANSPORTATION PLANNING",
    "describe_ch": "本課程為都市或都會區運輸規劃的基礎概論課程。課程內容著重在觀念與方法的概念建構。課程內容涵蓋：如何建立運輸規劃所需的資料庫、運輸規劃所需資料的蒐集與調查、運輸規劃的一般步驟與程序、運輸與土地使用關係、總體程序性運輸需求模式、公路容量與服務水準分析、大眾運輸規劃、交通衝擊等。",
    "describe_eh": "This course is a fundamental introduction to transportation planning in city and metropolitan areas. It addresses on the built up of both conceptual knowledge and methodology. Topics will cover data acquiring, surveying and analyzing, database creation, urban transportation planning process, highway capacity and level of service, public transportaion, and transportation impacts.",
    "pre_subname": "STAT1001統計學(一)、UPSI1002都市計畫概論",
    "pre_sub_id3": "STAT1001",
    "pre_sub_ename": "STAT1001 STATISTICS(1)、UPSI1002 INTRODUCTION TO URBAN PLANNING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠清楚地認識及利用流程圖與文字描述都市交通計畫的規劃程序與步驟",
      "describe_en": "Be able to clearly knowledge and utilize flow chart to depict the steps and procedure of Urban Transportation Planning."
    },
    {
      "seq": 2,
      "describe_ch": "能夠清楚地分析人口、土地使用與交通運輸之間的關係",
      "describe_en": "Be able to clearly analysis and express the relationship among Urban Population, Urban Land Use and Urban Transportation."
    },
    {
      "seq": 3,
      "describe_ch": "能夠用自己的辭彙清楚地詳述及定義各主題的意義，並能夠描述內容的不同",
      "describe_en": "Be able to clearly synthesis and define, with their own words, what the Aggregate and Disaggregate Transportation Planning are as well as identify the difference between them.\r\n"
    },
    {
      "seq": 5,
      "describe_ch": "能夠判斷總體運輸需求模式的四個步驟與資料庫中的資料，如交通分區、路網、及旅次資料，應用前述分析方法，分析規劃區的旅次產生吸引、旅次分布、運具選擇、交通量指派等結果",
      "describe_en": "Be able to evaluate and integrate the Aggregate Transportation Planning model and data in database, such as traffic zones, trips and networks, and utilize the four steps, trip generation, trip distribution, modal split and assignment, for transportation planning purpo"
    }
  ],
