  "description": {
    "sub_id3": null,
    "sub_name": "專案管理專論",
    "sub_ename": "SPECIFIC TOPICS OF PROJECT MANAGEMENT",
    "describe_ch": "本課程主要探討專案管理的理論和應用、專案各階段如何規劃、執行與熟悉運用專案管理各種方法，以展現解決問題及進行團隊協同合作的能力。並輔導學生報考專案管理相關證照（如PMA認證考試）。",
    "describe_eh": "This course mainly discusses the theory and application of project management, how to plan, execute and familiarize various methods of project management at each stage of the project, in order to demonstrate the ability to solve problems and carry out team collaboration. And counsel students to apply for project management related licenses (such as PMA certification exam).",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解專案管理基本知識，並知道如何運用於各種不同環境中，並提出可行驗證方法。",
      "describe_en": "To understand the basic knowledge of project management, to apply it in various environments, and to propose feasible verification methods."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明專案管理在社會及經濟層面的重要性及影響，並落實與社會責任關係。",
      "describe_en": "To understand and explain the importance and impact of project management on the social and economic levels, and implement the relationship with social responsibility."
    }
  ],
