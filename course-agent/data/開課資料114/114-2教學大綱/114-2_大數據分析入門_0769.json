  "description": {
    "sub_id3": null,
    "sub_name": "大數據分析入門",
    "sub_ename": "INTRODUCTION TO BIG DATA ANALYSIS",
    "describe_ch": "大數據已成為目前全球學術單位、政府機關以及頂級企業必須認真面臨的挑戰，隨著有關大數據的程式語言、運算平台、基礎理論，以及虛擬化、容器化的技術成熟，了解大數據的原理、實作、工具、應用以及未來趨勢，都將會是求學、進修、求職、深造的必備技能。本課程包含大數據及人工智慧、大數據分析、資料科學之分析技術及工具、大數據統計的應用技術、大數據工具及雲端運算概念與挑戰。",
    "describe_eh": "Big data has been a challenge to academic, governments, and enterprises. Due to mature technology of program language, computing platform, basic theory, virtualization, and containerization, understanding principles, practice, tools, applications, and trends becomes an important and necessary ability. The course includes Big Data and Artificial Intelligence, Big Data Analysis, Analysis Technique and Tools of Data Sciences, Application Techniques of Big Data Statics, Big Data Tools and Concept of Cloud Computing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解大數據與人工智慧的關聯",
      "describe_en": "To understand relationship between big data and artificial intelligence"
    },
    {
      "seq": 2,
      "describe_ch": "認識大數據分析的技術發展",
      "describe_en": "To understand the technological development of big data analysis"
    },
    {
      "seq": 3,
      "describe_ch": "認識各產業對於大數據分析技術的需求",
      "describe_en": "To understand the needs of various industries for big data analysis technology"
    },
    {
      "seq": 4,
      "describe_ch": "分析與討論新的科技及產業發展對於大數據分析技術應用的影響",
      "describe_en": "Analyze and discuss the impact of new technology and industrial developments on application of big data analysis technology"
    },
    {
      "seq": 5,
      "describe_ch": "認識大數據分析技術於應用層面的倫理議題",
      "describe_en": "To understand the ethics issues that must be paid attention to in the application of data analysis technology"
    }
  ],
