  "description": {
    "sub_id3": null,
    "sub_name": "LabVIEW在化工上應用",
    "sub_ename": "APPLICATIONS OF LABVIEW IN CHEMICAL ENGINEERING",
    "describe_ch": "本課程旨在針對主修化工的學生教授LabVIEW。除了教授基本的LabVIEW程式概念，課程同時設計一些應用專案用以讓學生熟悉工程所需要的程式能力。進一步的應用主題包括硬體配置，測量數據，以及程式除錯等等。",
    "describe_eh": "This course aims to teach LabVIEW for students who major in chemical engineering. In addition to fundamental concepts of LabVIEW, I have designed some applicative projects to acquaint students with programming which is useful for an engineer.  Other contents include hardware configuration, data measurement, debugging skills, and so on.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解LabVIEW圖控式程式語言的基礎",
      "describe_en": "Understanding basic concepts of LabVIEW graphical programming language"
    },
    {
      "seq": 2,
      "describe_ch": "能夠使用數據擷取硬體與感測器",
      "describe_en": "Being able to work with sensors and data acquisition devices"
    },
    {
      "seq": 3,
      "describe_ch": "以LabVIEW執行自動化控制量測專題",
      "describe_en": "Carry out research projects by LabVIEW"
    }
  ],
