  "description": {
    "sub_id3": null,
    "sub_name": "校外專業實習",
    "sub_ename": "OFF-CAMPUS INTERNSHIP",
    "describe_ch": "本課程提供學生至電子相關產業進行實習的機會，經由遴選讓學生到合作的機構服務，透過實務的練習加強專業技能。目的在加強理論與實務的整合，提供實際的工作經驗來培訓學生將來成為電子專業人才，以提升未來就業和職涯競爭力。",
    "describe_eh": "This course provides students with opportunities for internships in electronic and related industries. Through selection, students can serve in cooperative institutions and strengthen their professional skills through practical exercises. The purpose is to strengthen the integration of theory and practice, and provide practical work experience to train students to become electronic professionals in the future, so as to enhance future employment and career competitiveness.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 9.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "讓學生學習職場的溝通協調與團隊合作之能力。",
      "describe_en": "To encourage students to learn effective communication and teamwork skills in workplace."
    },
    {
      "seq": 2,
      "describe_ch": "培育學生具備終身學習、專業倫理及社會責任等基本素養。",
      "describe_en": "To cultivate students’ general capabilities in terms of life-long learning, professional ethics and social responsibilities."
    },
    {
      "seq": 3,
      "describe_ch": "以實務經驗強化學生之專業技能。",
      "describe_en": "To strengthen students' professional skills through their participation in industry."
    }
  ],
