  "description": {
    "sub_id3": null,
    "sub_name": "電力系統運轉與控制",
    "sub_ename": "POWER SYSTEM OPERATION AND CONTROL",
    "describe_ch": "主要教學項目有發電機的控制、電力和能量的交換、電力系統安全、電力系統中狀態評估的一個介紹、電力系統狀態估計、最大值Likelihood Weighted Least-Square估計、交流電網路的狀態估計、最佳電力潮流、線性靈敏性分析、線性設計方法、安全約束最佳電力潮流、匯流排遞增成本。",
    "describe_eh": "One-year course. Lectures include control of generator, interchange of power and energy, power system security, introduction to state estimation in power systems, power system state estimation, maxium likelihood weighted Least-Square estimation, state estimation of an AC network, optimal power flow, near sensitivity analysis, linear programming methods, urity-constrained optimal power flow, bus incremental costs.",
    "pre_subname": "EEEN3017電力系統(一)、EEEN3018電力系統 (二)",
    "pre_sub_id3": "EEEN3017",
    "pre_sub_ename": "EEEN3017 POWER SYSTEM ANALYSIS(1)、EEEN3018 POWER SYSTEM ANALYSIS (2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能藉由電力系統的基本原理，了解電力系統運轉與控制的設計準則。",
      "describe_en": "Understand the design basis of power generation operation and control by basic power system principles."
    },
    {
      "seq": 2,
      "describe_ch": "能運用電力系統運轉與控制設計之原理，並解析應用於實際案例上。",
      "describe_en": "Apply theory of  power generation operation and control design to real case and can analyze them."
    },
    {
      "seq": 3,
      "describe_ch": "能辨識出可應用定理與模型的場合，並能清楚表達。",
      "describe_en": "Distinguish and make clear statement where theory and modeling of  power  system can be applied."
    },
    {
      "seq": 4,
      "describe_ch": "能將分組討論中所獲結果以書面或口頭方式與同儕及教師溝通。",
      "describe_en": "Show the obtained results in report or oral form to classmates, teaching assistants, and the instructor."
    }
  ],
