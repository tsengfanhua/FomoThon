  "targets": [
    {
      "seq": 1,
      "describe_ch": " 使學生藉由討論方式，增進專業知識的了解與發問能力。.",
      "describe_en": " Comprehension for the professional knowledge and questioning ability by ways of discussion.."
    },
    {
      "seq": 2,
      "describe_ch": "藉由彼此間的觀摩學習，增進學習的樂趣，並認知專業與道德責任的能力，具備自我要求、負責的態度。",
      "describe_en": " Enhancement of the joy of learning, ability and awareness of professional and moral responsibility, self-requirements and responsible attitude through imitation of learning each other."
    },
    {
      "seq": 3,
      "describe_ch": "訓練學生製作與設計演講稿的能力。",
      "describe_en": "Enhancement of the students' design capacity and knowledge of paper presentations."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解纖維與複合材料相關研究發表之基本能力。",
      "describe_en": "Be able to present the materials regarding the related research in fiber and composite materails."
    }
  ],
