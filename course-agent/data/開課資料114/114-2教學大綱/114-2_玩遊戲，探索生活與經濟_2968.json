  "description": {
    "sub_id3": null,
    "sub_name": "玩遊戲，探索生活與經濟",
    "sub_ename": "EXPLORE LIFE AND ECONOMY FROM THE GAMES",
    "describe_ch": "本課程透過「邊玩邊學」的方式來介紹幾個經典的經濟學原理，讓學生從遊戲中去思考如何在既定的規則下增加勝率。藉由觀察其他玩家所採行的策略及整體遊戲的結果，去討論遊戲所對應的理論概念，學會理性判斷，進而能分析與解釋生活中的經濟現象，獲得分析周遭環境大小事的能力，從解開日常生活看似矛盾的行為中獲得樂趣。",
    "describe_eh": "This course will introduce several classic economic principles through the method of Learning by Playing, allowing students to think about how to increase the winning percentage under the established rules from the game. From observing the strategies adopted by other players and the results of the overall games, students are expected to discuss the theoretical concepts corresponding to the game, learn rational judgment, be able to analyze and explain economic phenomena in life, and gain the ability to analyze the surrounding environment. Students will have fun in unraveling the seemingly contradictory behaviors of daily life.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習經典的經濟原理，關注社會問題，理性分析周遭環境大小事。",
      "describe_en": "Learn classic economic principles, pay attention to social issues, and rationally analyze the surrounding environment."
    },
    {
      "seq": 2,
      "describe_ch": "提升學習社會經典教育的興趣，培養跨域思考、統整跨領域知識的能力。",
      "describe_en": "Uplift the interest in learning social classic education, and build up the ability to think and integrate different domains."
    }
  ],
