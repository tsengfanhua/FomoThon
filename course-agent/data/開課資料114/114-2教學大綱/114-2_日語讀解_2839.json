  "description": {
    "sub_id3": null,
    "sub_name": "日語讀解",
    "sub_ename": "JAPANESE READING ANALYSIS",
    "describe_ch": "本課程係為提升學生們對日語文章的理解能力，主要目標是希望在日語能力測驗項目取得高分，同時也強化日語的解讀能力。",
    "describe_eh": "This course focuses on enhancing students' ability to comprehend Japanese articles. The central aim of the course is to help students achieve high scores on Japanese language proficiency exams, and simultaneously, improve Japanese comprehension.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.透過該課程的學習讓學生能具備更充分的語言能力，在專業領域上發揮所長，進而追求更高深學問。",
      "describe_en": "1. Equip the students with proficient language ability so that they can thrive professionally and pursuit more advanced studies."
    },
    {
      "seq": 2,
      "describe_ch": "2.從學習中了解日語原文素材，具備相當程度的日語熟稔度，進而能自由的表達自我。",
      "describe_en": "2. Understand source material in Japanese, so as to become more familiar with the language and express oneself more freely."
    }
  ],
