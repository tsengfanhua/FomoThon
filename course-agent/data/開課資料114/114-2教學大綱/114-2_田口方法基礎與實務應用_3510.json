  "description": {
    "sub_id3": null,
    "sub_name": "田口方法基礎與實務應用",
    "sub_ename": "BASIC AND PRACTICAL APPLICATION OF TAGUCHI METHOD",
    "describe_ch": "本課程將介紹田口方法的理論基礎，探討線外品管及線上品管，將以最低的成本、最有效率的方 法及穩健性的實驗設計，找到製程及產品的競爭力。學生將藉由個案，進行減少變異的實驗設 計，將可減少實驗成本，並達到產品或製程的品質改善。",
    "describe_eh": "This course will introduce the fundamentals of Taguchi method, and discuss off-line and online quality control. By designing experiments with lowest cost and most efficient and robust methods, the competitivity of process products will be achieved. Students will use individual cases to practice experimental design to reduce variability, reduce the cost and improve the quality of product or process.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解田口方法的理論基礎。",
      "describe_en": "Be familiar with the fundamentals of Taguchi experimental design and its methodology."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉各種直交表實驗設計的原理及其應用 的能力。\r\n",
      "describe_en": "Be familiar with the methodology of Taguchi experimental design and their applications."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生運用田口方法分析工程問題的能 力。 \r\n",
      "describe_en": "Develop ability of analyzing engineering problem by using Taguchi method"
    }
  ],
