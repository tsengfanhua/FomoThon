  "description": {
    "sub_id3": null,
    "sub_name": "程式設計",
    "sub_ename": "COMPUTER PROGRAMMING",
    "describe_ch": "利用Visual C++ MFC建構一個視窗操作介面，在此視窗上可以明確的顯示出各個控制項目，實驗過後的結果也能將資訊顯示在該畫面上，方面使用者查看。",
    "describe_eh": "The objective of this course is to design a window monitor and handle interface by Visual C++ MFC. In this window it can distinctly display every control items. Also, the window monitor can show the related result of the experiment. User can look over all information conveniently.",
    "pre_subname": "IEE1000計算機概論(一)、IEE1001計算機概論(二)",
    "pre_sub_id3": "IEE1000",
    "pre_sub_ename": "IEE1000 INTRODUCTION TO COMPUTER(1)、IEE1001 INTRODUCTION TO COMPUTER(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.運用程式基礎以瞭解程式設計基本知識",
      "describe_en": "1.Apply program foundation to understand the basic knowledge about program design systems."
    },
    {
      "seq": 2,
      "describe_ch": "2.理解程式設計各項性能的定義與定理",
      "describe_en": "2.Comprehension for the definitions or theories of program design  performance."
    },
    {
      "seq": 3,
      "describe_ch": "3. 應用分析設計軟體對程式設計完成分析與設計",
      "describe_en": "Application for the simulation software to program design analysis and design."
    }
  ],
