  "description": {
    "sub_id3": null,
    "sub_name": "台灣現代主義詩學專題",
    "sub_ename": "AN IN-DEPTH STUDY OF MODERNISM IN TAIWANESE POETRY",
    "describe_ch": "研究西方現代主義(包括象徵主義、超現實主義、達達主義、立體主義、後現代主義)對台灣現代詩產生的影響，進而探索詩人如何結合本土現實發揚傳統，以及「廣義的現代主義」等潮的反省與轉向。",
    "describe_eh": "This course explores the impact of Western modernism (including symbolism, surrealism, dadaism, cubism, and postmodernism) on Taiwanese modern poetry, while investigating how poets integrate local realities with classical traditions, and reflects on poetic trends such as \"the broad-spectrum modernism\" etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "深化詩學素養，認知台灣現代詩人的創發實驗及現代詩潮的遞變。",
      "describe_en": "To deepen the understanding of poetic literacy, recognize the creative experiments of contemporary Taiwanese poets, and grasp the evolution of the modern poetry movement."
    },
    {
      "seq": 2,
      "describe_ch": "了解西方現代主義流派及名家，能加以運用，鑑賞批評現代詩作。",
      "describe_en": "To acquire the knowledge of Western modernist movements and prominent figures and apply this understanding to appreciate and critique modern poetry."
    }
  ],
