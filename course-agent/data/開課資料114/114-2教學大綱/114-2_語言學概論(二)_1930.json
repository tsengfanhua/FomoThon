  "description": {
    "sub_id3": null,
    "sub_name": "語言學概論(二)",
    "sub_ename": "INTRODUCTION TO LINGUISTICS (2)",
    "describe_ch": "語言學概論旨在研究語言的本質、其複雜性與其多元性。目的在訓練學生養成系統性分析語言結構的能力，並學習重要的語言學應用領域。主題包括語音學、音韻學、構詞學、句法學、語意學、語用學、心理語言學、社會語言學、語言變異現象、及語言與文化關係之探討。",
    "describe_eh": "This course is a general introduction to the nature of language, its complexity, and its diversity. It aims to train students to analyze languages’ highly organized systems and study the subfields of linguistics. The topics include phonetics, phonology, morphology, syntax, semantics, pragmatics, psycholinguistics, sociolinguistics, language variation, and issues in culture, society and language.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習語言學與英語教學相關領域的理論基礎與專業知識。",
      "describe_en": "To learn knowledge and theories in the fields of linguistics, Teaching English as a Foreign Language (TEFL) and the related areas."
    },
    {
      "seq": 2,
      "describe_ch": "理解語言的特性與語言在文化上的重要性。",
      "describe_en": "To understand the characteristics of language and its importance in culture."
    }
  ],
