    {
      "seq": 1,
      "describe_ch": "理解Python程式語言的基本語法與邏輯概念\t",
      "describe_en": "Comprehension for the syntax and logical concept of the Python languages."
    },
    {
      "seq": 2,
      "describe_ch": "學習分析問題建立演算法及程式\t",
      "describe_en": "To learn the problem analyzed, algorithm and to develop and implement a program."
    },
    {
      "seq": 3,
      "describe_ch": "應用Python 語言設計程式以解決基礎課程之工程問題\t",
      "describe_en": "Application the Python languages to write a program that can do simple problem solving for basic engineering courses."
    }
