  "description": {
    "sub_id3": null,
    "sub_name": "產險專題研討",
    "sub_ename": "SPECIAL TOPICS ON PROPERTY INSURANCE",
    "describe_ch": "本課程由整合性之角度介紹財產保險，包括險種、行銷與通路、核保與理賠處理、費率決定、監理等，透過理論與實務之分析，期使學生建立清楚完整的概念。",
    "describe_eh": "This course introduces property and casualty insurance from an integral angle, including lines of business, marketing and distribution channel, underwriting and claims adjustment, rating decision, regulation, and so on. The objective is to let students have clear and complete conception from theoretical and practical analyses.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解產險問題及強化學術性探討與研究能力",
      "describe_en": "Having ability to identify problems in property insurance and enhancing ability of academic exploration."
    },
    {
      "seq": 2,
      "describe_ch": "能應用產險技能於企業實務及個人生活",
      "describe_en": "Enabling students to apply management skills in business practice and personal life."
    }
