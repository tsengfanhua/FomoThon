  "description": {
    "sub_id3": null,
    "sub_name": "進階職場專業實習(二)",
    "sub_ename": "ADVANCED PROFESSIONAL INTERNSHIP (2)",
    "describe_ch": "本課程旨在加強專業實務的應用並深化學術研究成效。學生每週至少在實習單位實習3天，並由學生指導教授與實習單位業師共同指導，學生提供工作日誌給指導教授與業師進行督導控管，並返校參加期中座談會、提交成果報告與參加成果發表會。",
    "describe_eh": "This course aims to intensify students’ ability of the professionally practical application and to deepen the effect of academic research. Three days per week at least in the internship institution is needed for students enrolled in this class.  Students have to turn in the daily log to their advisors from the university and the institution.  Students also have to attend a mid-term discussion meeting and a final presentation in addition to turning in their final reports.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用溝通協調與團隊合作的操作模式",
      "describe_en": "Application of the operation patterns for professional ethics and team-working. \r\n"
    },
    {
      "seq": 2,
      "describe_ch": "能應用專業技能解決實務問題",
      "describe_en": "Application of the professional skills to solve practical problems.\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "能導出專業判斷與分析決策",
      "describe_en": "Synthesis of professional judgement and analytical decision-making.\r\n"
    }
  ],
