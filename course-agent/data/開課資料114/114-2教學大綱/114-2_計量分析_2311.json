    "sub_name": "計量分析",
    "sub_ename": "QUANTITATIVE ANALYSIS",
    "describe_ch": "內容包括基本概念介紹、交叉分析、變異數分析、複迴歸分析與模式診斷、主成份分析與因子分析、群落分析與判別分析、整合應用",
    "describe_eh": "Topics include Introduction, Cross Table, Multivariate Analysis of Variance, Multiple Regression, Principal Components Analysis and Factor Analysis, Cluster Analysis,  Discriminant Analysis, and Emerging Techniques in Multivariate Analysis.",
    "pre_subname": "LAND2016統計學(一)、LAND2017統計學(二)",
    "pre_sub_id3": "LAND2016",
    "pre_sub_ename": "LAND2016 STATISTICS(1)、LAND2017 STATISTICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
