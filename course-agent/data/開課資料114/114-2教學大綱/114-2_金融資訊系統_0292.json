    {
      "seq": 1,
      "describe_ch": "認識財務資訊和數量分析的基本概念",
      "describe_en": "To know the essential concepts of financial information and quantitative analysis."
    },
    {
      "seq": 2,
      "describe_ch": "使用軟體來記錄、彙整和分析財務資訊",
      "describe_en": "使用軟體來記錄、彙整和分析財務資訊\tTo use the software to record, sort and analyze financial information.\tD2"
    }
