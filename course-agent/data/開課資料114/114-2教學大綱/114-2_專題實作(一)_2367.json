  "description": {
    "sub_id3": null,
    "sub_name": "專題實作(一)",
    "sub_ename": "PRACTICE OF SPECIAL TOPICS (1)",
    "describe_ch": "專題實作(一)為必修之終端課程，乃是整合學生修習之各項課程、所學之專業知識、或強調技能應用面之課程，以銜接學生畢業後升學、就業及社會之需求。",
    "describe_eh": "Practice of special topics (1) is the terminal lesson of all required courses in school. It emphasizes how to apply the knowledge learned from all previous mathematical courses to solve a practical problem. It also provides an exercise for students that will be helpful for their future professional career.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "藉由團隊合作完成專題作品。",
      "describe_en": "Team work on solving a practical problem."
    },
    {
      "seq": 2,
      "describe_ch": "整合學生修習之各項課程、所學專業知識，尋求解決問題方案。\r\n",
      "describe_en": "Applying all knowledge learned from previous mathematical courses to solve a practical problem."
    },
    {
      "seq": 3,
      "describe_ch": "強調技能應用面，以銜接學生畢業後升學、就業及社會之需求。\r\n",
      "describe_en": "Emphasizing the employment of mathematical techniques when solving the practical problem, which will be helpful for students’ future professional career."
    }
  ],
