  "description": {
    "sub_id3": null,
    "sub_name": "管理會計",
    "sub_ename": "MANAGERIAL ACCOUNTING",
    "describe_ch": "本課程是成本會計的進階延伸，強調會計資訊在內部決策上的應用，主要的內容包含：精算產品成本、預算與差異分析、成本習性與獲利分析、差異成本決策、部門績效衡量與內部轉嫁，以及管理會計因應商業環境變遷的主題。本課程使用個案。",
    "describe_eh": "This course is an in-depth study of cost accounting focusing on the basic concepts of managerial accounting for internal decision-making. Major topics include product costing, budgeting and variance analysis, cost behavior and profit planning, differential costs for decision making, divisional performance evaluation and transfer pricing. costing approaches used in today's business environments. Cases are used.",
    "pre_subname": "ACCT3050成本會計",
    "pre_sub_id3": "ACCT3050",
    "pre_sub_ename": "ACCT3050 COST ACCOUNTING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用成本計算的理論與技法以便更精確地決定產品成本。",
      "describe_en": "Application for using costing approaches and/or skills to determine product cost more accusatorially."
    },
    {
      "seq": 2,
      "describe_ch": "能分析管理會計資訊在內部管理決策上提升效能的應用。",
      "describe_en": "Analysis for using managerial accounting information to improve internal decision-making effectively and efficiently."
    },
    {
      "seq": 3,
      "describe_ch": "能理解經管理會計因應經濟環境變遷的作法",
      "describe_en": "Comprehension for management accounting how to respond to the changing economic environment."
    }
  ],
