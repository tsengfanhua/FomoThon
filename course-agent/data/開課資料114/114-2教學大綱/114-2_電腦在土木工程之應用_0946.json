  "description": {
    "sub_id3": null,
    "sub_name": "電腦在土木工程之應用",
    "sub_ename": "COMPUTER APPLICATION IN CIVIL ENGINEERING",
    "describe_ch": "指導學生使用SAP2000及ETABS套裝軟體進?結構分析與設計，藉由圖形輸入與螢幕輸出結果以印證他們曾經學過的理論解。課程亦將以簡單例子介紹使用SAP2000和ETABS來分析結構動力與側推問題。",
    "describe_eh": "To use the software of SAP2000 and ETABS to conduct structural analysis and design. By using the graphical input and on screen output results, the analytical results will be approved with theoretical results they ever learned. This curriculum includes analyzing structural dynamics and pushover problems by means of SAP2000 and ETABS with the simplest cases as well.",
    "pre_subname": "CE2078材料力學、CE2070結構學(一)、CE3071結構學(二)",
    "pre_sub_id3": "CE2078",
    "pre_sub_ename": "CE2078 MECHANICS OF MATERIALS、CE2070 STRUCTURAL THEORY(1)、CE3071 STRUCTURAL THEORY (2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識ETABS與SAP2000的功能並熟悉ETABS與SAP2000之環境。",
      "describe_en": "To know the functions of ETABS, SAP2000 and to be familiar with ETABS and SAP2000 environment"
    },
    {
      "seq": 2,
      "describe_ch": "認識ETABS與SAP2000分析流程與模擬方法。",
      "describe_en": "To know the procedure of analysis and modeling method in ETABS and SAP2000"
    },
    {
      "seq": 3,
      "describe_ch": "能以ETABS與SAP2000定義土木結構的材料行為、負載及邊界條件並建構一個土木結構的分析模型進?結構分析與設計。",
      "describe_en": "To be able to define material properties, loading, boundary conditions and establish a structural model to analyze and design a structure by means of ETABS and SAP2000"
    }
  ],
