  "description": {
    "sub_id3": null,
    "sub_name": "建築醫學",
    "sub_ename": "BUILDING MEDICINE",
    "describe_ch": "本課程擬藉由建築物擬人化的概念，導引學生思考如何從醫學管理類比至建築物的健康管理機制設計上，例如住宅建診、建築病歷表、建築疾病編碼、建築醫生導航系統、建築物生理訊號監測系統等，以期創造具醫學級的專業性維護管理。",
    "describe_eh": "The course introduces building health management analogized to human health management based on ideas of Anthropomorphized Building Medicine Management. The concept and implement of Building Medicine in lessons are management processes of building health diagnosis, Building Medical Records, Building Diseases Code, Building Doctor Navigation System, and Building Physiology Information System which have analogy to human medicine management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識與建築物健康管理有關的人類醫學與公共衛生學門管理內容概要",
      "describe_en": "To learn building health management from respective of medicine and public health issues."
    },
    {
      "seq": 2,
      "describe_ch": "具備健康建築的知識",
      "describe_en": "To acquire knowledge of \"healthy building\""
    },
    {
      "seq": 3,
      "describe_ch": "對於國內建築修繕產業、法令體制與規模量體能有所認識",
      "describe_en": "To recognize industry, legislation, system and market context of building maintenance."
    },
    {
      "seq": 4,
      "describe_ch": "培養同學成為建築小醫生",
      "describe_en": "Students were trained for junior Building Doctor"
    }
  ],
