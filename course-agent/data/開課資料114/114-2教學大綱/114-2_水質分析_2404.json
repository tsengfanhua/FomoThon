  "description": {
    "sub_id3": null,
    "sub_name": "水質分析",
    "sub_ename": "WATER QUALITY ANALYSIS",
    "describe_ch": "本課程為提供學生水質分析的基礎概念與相關環境應用。內容包括統計表示、數據品質保證與控制、濁度、色度、酸度與鹼度、鐵與錳、氯化學、消毒、溶氧、有機污染、生化需氧量、化學需氧量、氮與磷化學、優養化等相關議題。",
    "describe_eh": "This course provides students on gaining a comprehensive understanding of the principles and fundamentals of water quality, including statistical expression, quality assurance and quality control (QA/QC), turbidity, color, acidity and alkalinity, iron and manganese, chlorine chemistry, disinfection, dissolved oxygen, organic pollution, biochemical oxygen demand (BOD), chemical oxygen demand (COD), chemistry of nitrogen and phosphor, and eutrophication, applied to environmental engineering and science, and to develop expertise in pollution issues of water and wastewater associated with these principles",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "說明水質數據在統計學之意義與品質保證與品質管制之重要性。 \t",
      "describe_en": "Be able to explain the meanings of data of water quality on statistics and learn the significance of quality assurance and quality control."
    },
    {
      "seq": 2,
      "describe_ch": "理解水源水質特性與影響因數。 \t",
      "describe_en": "Be able to understand the characteristics of water quality from its source and some influential factors functioning on water quality."
    },
    {
      "seq": 3,
      "describe_ch": "分析自來水淨水廠處理水質之效能與意義。 \t",
      "describe_en": "Analyze the efficacy and meanings of water quality from the operation of drinking water treatment plant."
    },
    {
      "seq": 4,
      "describe_ch": "理解廢污水之水質特性與發生來源。 \t",
      "describe_en": "Be able to understand the characteristics of wastewater and its origination."
    },
    {
      "seq": 5,
      "describe_ch": "理解水質分析於淨水和污水處理廠實務的應用及其原理 \t",
      "describe_en": "Understand the application and principles of water quality analysis to drinking water and wastewater treatment practice"
    }
  ],
