  "description": {
    "sub_id3": null,
    "sub_name": "國際貿易法",
    "sub_ename": "INTERNATIONAL TRADE LAW",
    "describe_ch": "國際貿易法規範所有產品、服務、人力及智慧財產權的跨國界交易。本課程考慮國際貿易法範圍的廣度，擇要介紹下列主題：爭端解決、國外投資、WTO架構下諸貿易協定，貨品買賣、服務買賣、智慧財產權以及聯合國國際貨物買賣公約。",
    "describe_eh": "International Business Law involve all cross border of products, services, people and ideas. Major topics included Dispute Settlement, Foreign Investment, WTO Agreements, Trade in Good and Service, Intellectual Property, CISG .\r\n\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解國際貿易法體系，國際爭端解決，WTO架構下之貿易協定。",
      "describe_en": "To understand the basic structure of international business law, and the basic issues in International Dispute Settlement and WTO Agreements."
    },
    {
      "seq": 2,
      "describe_ch": "能理解聯合國國際貨物買賣公約內容並運用之。",
      "describe_en": "To understand the basic issues and practices of CISG."
    }
  ],
