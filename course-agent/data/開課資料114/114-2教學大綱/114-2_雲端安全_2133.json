      "seq": 1,
      "describe_ch": "了解雲端運算安全議題與管理措施",
      "describe_en": "Understanding cloud computing security issues and management measures"
    },
    {
      "seq": 2,
      "describe_ch": "了解雲端運算環境之安全部署",
      "describe_en": "Understanding the security deployment of cloud computing environment"
