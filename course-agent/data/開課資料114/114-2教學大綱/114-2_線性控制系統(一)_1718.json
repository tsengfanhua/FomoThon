  "description": {
    "sub_id3": null,
    "sub_name": "線性控制系統(一)",
    "sub_ename": "LINEAR CONTROL SYSTEM(1)",
    "describe_ch": "控制系統領域之入門，並藉此培植學生具備控制系統工程師之養成智識。其內容涵蓋基礎的動力學系統之數學模型建構。各種模式(例如： Time-Domain) 之數學模型建構及分析，自動控制系統理論及電腦控制系統等。細部的重要理論包括：例如block diagram algebra, the root locus.  此外，MATLAB - 目前在工業界控制領域中最為廣泛使用之電腦程式輔助設計語言，亦納入本課程內容中且學生必須實際上機實作及驗證作業。",
    "describe_eh": "This course is the introductory course in control systems, and is intended to equip students with detailed familiarity with historically significant tools of the control engineer.  Topics include the fundamentals of dynamics system modeling; modeling systems from various physical domains and systems; and an introduction to the concepts and theory pertinent to automatic control systems, including computer control systems.  The course also covers a detailed discussion of block diagram algebra, the root locus.  Besides, the most well-known computer-aided learning and design software in control field industry, MATLAB, is also introduced and performed for most of the assigned homework.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建構線性控制系統工程科技之基本概念。",
      "describe_en": "To have a basic knowledge of the linear control systems engineering technologies."
    },
    {
      "seq": 2,
      "describe_ch": "認識Open-Loop, Closed-Loop, 及Feedback控制系統之差異。",
      "describe_en": "To be aware of the differences of Open-Loop, Closed-Loop, and Feedback control systems."
    },
    {
      "seq": 3,
      "describe_ch": "了解Block Diagram & Signal-Flow Graphs模型建構。",
      "describe_en": "To understand the Block Diagram & Signal-Flow Graphs models."
    },
    {
      "seq": 4,
      "describe_ch": "熟悉Stability of Linear Control System及Routh-Hurwitz Criterion分析之方法。",
      "describe_en": "To get familiar with Stability of Linear Control System, and Routh-Hurwitz Criterion method."
    },
    {
      "seq": 5,
      "describe_ch": "認識Time Domain Response。",
      "describe_en": "To be able to conduct Time Domain Response plot."
    },
    {
      "seq": 6,
      "describe_ch": "了解系統模型及其Transfer Function建構。",
      "describe_en": "To understand the Modeling of Physical Systems, and Transfer Function."
    },
    {
      "seq": 7,
      "describe_ch": "了解Root-Locus 圖形建構及分析控制系統之穩定性。",
      "describe_en": "To have a basic knowledge of the linear control systems engineering technologies."
    }
  ],
