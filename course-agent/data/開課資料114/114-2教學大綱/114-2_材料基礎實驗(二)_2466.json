  "description": {
    "sub_id3": null,
    "sub_name": "材料基礎實驗(二)",
    "sub_ename": "BASIC MATERIALS EXPERIMENT(2)",
    "describe_ch": "本實驗課程目的在於訓練學生具備基礎材料特性分析之能力，其內容單元包括：電化學實驗、粉體燒結及其分析檢測，期望學生能藉此強化學生相關實作之能力。",
    "describe_eh": "This experimental course aims to train students to have the ability to analyze the characteristics of basic materials. Its content units include electrochemical experiments, powder sintering, analysis, and testing. It is expected that students can use this to strengthen their ability to perform related tasks.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解電化學之理論與實務，並知道如何用以電鍍(或無電鍍)鎳膜及測定其腐蝕速率。",
      "describe_en": "Understanding electrochemical theory and practice, based on which students could learn to deposit a nickel film by electroplating/electroless plating, and measure the corrosion rate of the film"
    },
    {
      "seq": 2,
      "describe_ch": "學習離子氮化、鋼材硬化能測定、析出硬化機制，並探討如何運用上述學理與實務以改善金屬之耐磨性及抗沖蝕性。",
      "describe_en": "Learning ion nitriding, hardenability measurement and precipitation hardening mechanism, from which students could explore a method to improve the wear and erosion resistance of the treated steel"
    },
    {
      "seq": 3,
      "describe_ch": " 知道如何找到材料實驗科學之相關資訊－特別是材料之性質及技術規格，並能評估所獲資訊的適用性。",
      "describe_en": " Learning how to locate and access Materials Lab information－especially related to material properties & specifications, then evaluating the applicability of the obtained information"
    }
  ],
