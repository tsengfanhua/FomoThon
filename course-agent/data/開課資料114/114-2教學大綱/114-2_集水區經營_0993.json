  "description": {
    "sub_id3": null,
    "sub_name": "集水區經營",
    "sub_ename": "WATERSHED MANAGEMENT",
    "describe_ch": "本課程之主要目的在於介紹集水區自然環境與人類活動之互動關係，並且藉由探討自然災害之發生過程與其對應防治方法來傳達以維持集水區生態平衡為目的之集水區經營概念",
    "describe_eh": "To introduce the interactive relationship between natural environment of watershed and human activities, this course explores the processes of natural disasters along with their mitigation approaches such that watershed management concepts rooted on maintaining watershed ecosystems equilibrium can be delivered to the learners.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠以自己的辭彙說明進行集水區經營所需基本資料、土砂災害之特性及防治方法。",
      "describe_en": "\t1.\tStudents can define the necessary data, the characteristics and their mitigation methods of soil disasters for watershed management by their own terms."
    },
    {
      "seq": 2,
      "describe_ch": "能夠利用網路環境及工具，進行集水區經營基本資料或相關研究之收集及比較\t",
      "describe_en": "2.Students can collect and compare the necessary data and the current research results of watershed management through internet environment and tools."
    },
    {
      "seq": 3,
      "describe_ch": " 能夠在分組討論與作業中表現有效溝通及團隊合作的能力。\t",
      "describe_en": "3. Students can apply their abilities of effective communication and teamwork in group discussions and assignments."
    }
  ],
