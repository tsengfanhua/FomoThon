  "description": {
    "sub_id3": null,
    "sub_name": "職場英語口語表達",
    "sub_ename": "BUSINESS ENGLISH CONVERSATION",
    "describe_ch": " 研究顯示，許多社會人士面臨在職場上使用英語溝通表達的困境。職場英文EZ Talk課程目的在培養學生未來在英語職場上的所需要表達能力。課程設計著重於增進學生的口說能力及英語聽力。課程內容針對職場常用的主題和情境，提供專業職場英文會話練習。課程包含多元的學習活動來引起學生的學習動機。",
    "describe_eh": "Research shows that speaking problems can be major challenge to many people in the workplace. The Business Conversation course aims at preparing students for working in an English-speaking job environment. The design of the course focuses on improving students’ speaking and listening skills by providing conversation practices of different workplace settings. The course includes a variety of activities to motivate students’ learning interests.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1. 協助學生分辨並應用所學到的知識於未來職場中。並提升學生未來所需要具備的溝通能力及技巧。",
      "describe_en": "1.Assist students to identify and apply their knowledge in the workplace and develop students’ communicative skills in English."
    },
    {
      "seq": 2,
      "describe_ch": "2. 協助學生應用所學到的知識，和不同的專業背景的學生互助合作，建立良好的關係。",
      "describe_en": "2.Assist students to apply their knowledge to cooperate with different professions and establish positive relationships."
    }
  ],
