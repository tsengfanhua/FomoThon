  "description": {
    "sub_id3": null,
    "sub_name": "營建管理",
    "sub_ename": "CONSTRUCTION MANAGEMENT",
    "describe_ch": "本課程將介紹營建產業環境之發展與制度，進而以營建專案管理所涵蓋之工程進度排程、成本控制、品質管理、安衛管理、及相關契約法令等領域範疇，進行深入淺出之專業介紹，以使學生能具備營建管理專業之基本知能。",
    "describe_eh": "Based on the comprehension of construction industry environment, this course is about controlling time, cost, quality, safety, and contract issues of construction projects. It will give students a general understanding to construction industry and management practices.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解營建產業之組成、環境現況與工程生命週期之概念",
      "describe_en": "Comprehension for the participants of construction industry and the management of project life cycle"
    },
    {
      "seq": 2,
      "describe_ch": "理解基本工程進度網圖、成本控制、品質管理等方法",
      "describe_en": "Comprehension for the scheduling network, cost control and quality management methods"
    },
    {
      "seq": 3,
      "describe_ch": "具備有效溝通與訊息簡報之能力",
      "describe_en": "Application for the efficient communications and information reporting skills"
    }
  ],
