  "description": {
    "sub_id3": null,
    "sub_name": "產業學院校外實習(一)",
    "sub_ename": "INDUSTRIAL INTERNSHIP(1)",
    "describe_ch": "本課程提供大學部學生至合作產業進行實習的機會，經由遴選讓學生到合作機構學習實務業務。透過實務的練習加強學生相關的專業技能。\n本課程目的在加強理論與實務的整合，提供實際專業經驗以培訓學生成為產業專業人才，縮小就業落差，提升學生就業與職涯發展的競爭力。",
    "describe_eh": "This course provides undergraduate students with internship opportunities in partner industries. Students are selected to learn practical skills at partner organizations. Through hands-on practice, students strengthen their relevant professional skills.\nThis program aims to strengthen the integration of theory and practice, providing real-world professional experience to train students to become industry professionals, narrow the employment gap, and enhance students' competitiveness in employment and career development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
