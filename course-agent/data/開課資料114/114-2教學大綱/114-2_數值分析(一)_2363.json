  "description": {
    "sub_id3": null,
    "sub_name": "數值分析(一)",
    "sub_ename": "NUMERICAL ANALYSIS(1)",
    "describe_ch": "課程目的為熟悉數值分析的基本理論及其應用，學習關鍵內容包含解單變數方程式的根、多項式內差法、數值微分及積分法，主要學習活動為課堂講述?作業練習?考試評量並融入CDIO之精神利用電腦教室以MATLAB 或Python進行實作，以達成學習成效。",
    "describe_eh": "The purpose of the course is to be familiar with the basic theories and applications of numerical analysis. The key content of learning is solving equations of single variable, polynomial interpolation, and numerical differentiation and integration. The main learning activities are class lectures, homework exercises, and examination. Besides, based on CDIO, students are requested to practice coding by MATLAB or Python in computer lab activity in order to achieve effective learning.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)、MATH1011線性代數(一)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)、MATH1011 LINEAR ALGEBRA(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.\t理解數值方法解單變數方程式。\r\n2.\t理解內插數值法。\r\n3.\t理解數值積分法。",
      "describe_en": "1.\tComprehension for numerical methods for solutions of equations in one.\r\n2.\tComprehension for interpolation of a function.\r\n3.\tComprehension for numerical integration methods. \r\n"
    },
    {
      "seq": 2,
      "describe_ch": "1.\t分析數值方法解單變數方程式之收斂性分析及比較。\r\n2.\t分析內插數值法及誤差估計。\r\n3.\t分析數值積分法之誤差。\r\n",
      "describe_en": "1.\tAnalysis of the convergence of numerical methods for solutions of equations in one.\r\n2.\tError analysis of numerical interpolation of a function.\r\n3.\tError analysis of numerical integration methods.\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "以程式解決解單變數方程式、內插數值法及數值積分法。",
      "describe_en": "Apply programs to solve equations, interpolations and integrations."
    }
  ],
