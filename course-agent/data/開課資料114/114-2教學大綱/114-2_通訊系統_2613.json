  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CS06149",
    "sub_id": "44940",
    "scr_dup": "001",
    "sub_title": "1. 讓學了解資通信產業的現況.\n2. 讓學生兩姊通信系統的各單元及其應用",
    "sub_title_en": null,
    "sub_describe": "本課程介紹通訊原理及系統架構。首先將說明通信系統各單元功能，並針對訊號源(電波傳播模式)、訊號調變模式、多工技術、通道編解碼、錯誤控制技術等各項功能單元進行細部說明。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "通訊系統",
    "sub_ename": "COMMUNICATION SYSTEMS",
    "describe_ch": "本課程介紹通訊原理及系統架構。首先將說明通信系統各單元功能，並針對訊號源(電波傳播模式)、訊號調變模式、多工技術、通道編解碼、錯誤控制技術等各項功能單元進行細部說明。",
    "describe_eh": "This course introduces the principles and system architecture of communication. First, the functions of each unit of the communication system are explained. Subsequentially, the details of signal source (radio wave propagation mode), signal modulation mode, multiplexing technology, channel encoding and decoding, error control technology, and other functional units are discussed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知道不同通訊系統主要結構、種類及應用。",
      "describe_en": "Be able to know the main structures, types and applications of different communication systems."
    },
    {
      "seq": 2,
      "describe_ch": "能應用通訊系統的設計技巧。",
      "describe_en": "Be able to apply the design skill of communication systems."
    },
    {
      "seq": 3,
      "describe_ch": "能分析通訊相關文獻並進行報告。",
      "describe_en": "Be able to analyze the literature relevant to communication and make a report."
    },
    {
      "seq": 4,
      "describe_ch": "能理解通訊領域相關之專業倫理與資訊倫理。",
      "describe_en": "Be able to comprehend professional ethics and information ethics relevant to the field of communication."
    }
  ],
