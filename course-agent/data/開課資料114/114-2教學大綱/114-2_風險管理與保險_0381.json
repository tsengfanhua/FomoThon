  "description": {
    "sub_id3": null,
    "sub_name": "風險管理與保險",
    "sub_ename": "RISK MANAGEMENT AND INSURANCE",
    "describe_ch": "本課程在討論風險對個人及企業的財務狀況的影響，及對這些風險的控制、財源的取得等。風險控制著重於損失的預防與抑制，風險財源的取得則包括各種提存準備方法或隨收隨付制。",
    "describe_eh": "The mission of the course is to educate students in the theory and practice of risk management at an advanced level. Business organizations are exposed to loss-causing events that may have significant impact on their financial position.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
