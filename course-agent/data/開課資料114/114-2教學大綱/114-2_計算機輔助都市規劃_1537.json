  "description": {
    "sub_id3": null,
    "sub_name": "計算機輔助都市規劃",
    "sub_ename": "COMPUTER AID DESIGN FOR URBAN PLANNING",
    "describe_ch": "本課程教授同學如何應用ArcGIS軟體來從事都市規劃輔助。透過分享政府機關實際都市規劃業務及系統、包含建物管理、非都法規、土地規劃、法規實務應用、交通甚至治安，與學生分享計算機在實際都市規劃，可以展現都市規劃成果。以期透過案例分享與都市規劃學術教育，兩者結合，讓學生可以準備未來更多的生涯發展與技能。",
    "describe_eh": "This course teaches students how to utilize ArcGIS software for urban planning assistance. Through the sharing of actual urban planning tasks and systems from government agencies, including building management, non-urban regulations, land planning, regulatory practical applications, transportation, and even public safety, students will gain insights into the practical applications of computers in urban planning. The goal is to demonstrate urban planning achievements through case studies and the integration of academic education in urban planning, enabling students to acquire additional knowledge and skills for future career development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 5,
      "describe_ch": "能夠用自己的辭彙定義與描述計算機輔助都市規劃，以及理解一個計算機輔助都市規劃系統的基本架構",
      "describe_en": "Be able to clearly define and describe the common characteristics of the Computer Aid Urban Planning with their own words as well as understand the primary architecture of a Computer Aid Urban Planning System."
    },
    {
      "seq": 6,
      "describe_ch": "能夠清楚地說明計算機輔助都市規劃系統如何應用在都市規劃實務上",
      "describe_en": "Be able to clearly describe how to apply a Computer Aid Urban Planning System to Practical Urban Planning."
    },
    {
      "seq": 7,
      "describe_ch": "給定清楚的需求後，能夠綜合前述能力以完成一個都市規劃製圖案例",
      "describe_en": "Be able to comprehend above capabilities to complete a urban planning project focused on cartography when needs are clear defined."
    }
  ],
