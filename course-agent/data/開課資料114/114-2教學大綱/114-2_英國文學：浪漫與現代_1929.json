  "description": {
    "sub_id3": null,
    "sub_name": "英國文學：浪漫與現代",
    "sub_ename": "ENGLISH LITERATURE: ROMANTICS AND MODERNS",
    "describe_ch": "這門課將引導學生孰悉英國文學從浪漫時期，維多利亞時期到現當代的發展，課程將涵蓋各個時期主要作家的重要作品，透過文本閱讀與分析，訓練學生的批判思考與判斷能力。",
    "describe_eh": "This is a required core-course for English-major junior students. The course offers a guided tour to the treasure island of English literature from Romanticism to the modern period which covers mainly the literary lives of major authors and their individual works. It aims to give a basic training in reading strategy, perceptive analysis and logical thinking, and also to help students familiarize themselves with literary terms and critical approaches.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
