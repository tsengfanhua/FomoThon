  "description": {
    "sub_id3": null,
    "sub_name": "管理經濟學",
    "sub_ename": "MANAGERIAL ECONOMICS",
    "describe_ch": "追求效率，是本課程介紹的重點。因此，不論是組織改造、制度變更、薪資調整、人力資本、教育訓練及市場策略，均會有所分析。特別是在不同廠商規模、集團式或跨國式經營，將以交易成本的觀點，來介紹其運作的效率。",
    "describe_eh": "We emphasize on the efficiency of business management. Analyzing subjects include organization evolution, institution change, wage structure, human capital, and strategies of markets. Especially, we will apply viewpoints of transaction cost to firm scale, group or multinational enterprises.",
    "pre_subname": "ECON1001經濟學(一)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠瞭解管理經濟學對企業營運的重要性。",
      "describe_en": "Understand the importance of Managerial Economics to business administration."
    },
    {
      "seq": 2,
      "describe_ch": "能夠將經濟分析應用到管理經濟學上。",
      "describe_en": "To apply the economic analysis in the managerial economics."
    },
    {
      "seq": 3,
      "describe_ch": "能夠瞭解如果你是ㄧ位企業經營者，當面對全球化，企業如何做決策。",
      "describe_en": "Know how to make decision whom enterprise face globalization."
    },
    {
      "seq": 4,
      "describe_ch": "訓練學生實作能力，以便在未來投入職場時有競爭力。",
      "describe_en": "Have competitive advantage when student enter into job market due to practical training."
    }
  ],
