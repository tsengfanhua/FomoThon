  "description": {
    "sub_id3": null,
    "sub_name": "管理與人文素養",
    "sub_ename": "MANAGEMENT AND HUMANITIES",
    "describe_ch": "管理是一門反應人的內心，與人性本質息息相關的社會科學，本課程以人文為基礎，結合商管領域專業，培養學生從「人」與「文化」角度出發的思辨能力，並提昇其對社會責任與專業倫理之認知，以實踐博雅教育。",
    "describe_eh": "Management and Humanities can reflect human's truly heart and is closely related to the essence of human nature. This course is based on humanities, combined with majors in the field of business management, to cultivate students' critical thinking from the perspective of \"people\" and \"culture\", thereby enhancing their awareness of social responsibility and professional ethics.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "提昇學生對「企業與社會之間連動性」之敏銳度，並將其應用於實務中。",
      "describe_en": "Enhance students' sensitivity to \"the linkage between business and society\" and apply it in practice."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解近代企業管理之趨勢，將商管知識與人文素養進行整合，培養學生全方位的商業領導力。",
      "describe_en": "Understand the trend of modern enterprise management, integrate business management knowledge with humanistic quality, and cultivate students' comprehensive business leadership."
    }
  ],
