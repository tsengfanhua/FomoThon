  "description": {
    "sub_id3": null,
    "sub_name": "光電半導體元件",
    "sub_ename": "SEMICONDUCTOR DEVICES OF OPTO-ELECTRONICS",
    "describe_ch": "討論以下光電元件的設計與應用:  金氧半元件、半導體光源（發光二極體、激光二極體、有機發光二極體）。光檢測器（光二極體、雪崩二極體、光電晶體、CCD）及矽光子學。",
    "describe_eh": "Discuss the design of the following Opto-electronics semiconductor devices: MOS、Light sources (LED、laser diode、oled)、photo detectors (photo-diode、avalanche diodes、photo transistors、CCD) and silicon photonics.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解金氧半元件、半導體光源（發光二極體、激光二極體、有機發光二極體）",
      "describe_en": "Understand MOS、Light sources (LED、laser diode、oled)"
    },
    {
      "seq": 2,
      "describe_ch": "了解光檢測器（光二極體、雪崩二極體、光電晶體、CCD）及矽光子學",
      "describe_en": "Understand photo detectors (photo-diode、avalanche diodes、photo transistors、CCD) and silicon photonics"
    }
  ],
