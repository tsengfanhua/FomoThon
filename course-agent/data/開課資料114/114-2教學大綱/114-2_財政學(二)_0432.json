  "description": {
    "sub_id3": null,
    "sub_name": "財政學(二)",
    "sub_ename": "PUBLIC FINANCE(2)",
    "describe_ch": "綜觀公共經濟學的基礎內涵。探討市場失靈的原因以及政府在經濟活動中扮演的角色、公共財、外部性、公共選擇、成本效益分析、公共支出計畫、租稅理論(如租稅的效率與公平，租稅對工作、儲蓄、風險承擔及逃稅的影響等)以及地方財政等課題。",
    "describe_eh": "This course provides an overview of economics of public sector. Discuss market failures and the role of government, public goods, externalities, public choice, cost-benefit analysis, public expenditure programs, the basis theory of taxation (such as the efficiency and equity effects of taxes, effects of a tax on labor supply, saving, risk taking, and tax evasion etc.) and state and local public finance.",
    "pre_subname": "ECON2001個體經濟學(一)、ECON2002個體經濟學(二)",
    "pre_sub_id3": "ECON2001",
    "pre_sub_ename": "ECON2001 MICROECONOMICS(1)、ECON2002 MICROECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解財政學的意涵",
      "describe_en": "Understand the definition of public finance and important factors affecting public expenditures and government revenues."
    },
    {
      "seq": 2,
      "describe_ch": "能辨識公共收支的重要性及影響力",
      "describe_en": "Distinguish and make clear statement pf public expenditure"
    }
  ],
