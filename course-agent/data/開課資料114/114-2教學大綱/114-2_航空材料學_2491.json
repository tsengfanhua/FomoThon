  "description": {
    "sub_id3": null,
    "sub_name": "航空材料學",
    "sub_ename": "AIRCRAFT MATERIALS",
    "describe_ch": "本課程之目的為培養學生由航空器系統設計的觀念進一步學習基本航太金屬材料以及先進複合材料等材料科學應用的專業知識，幫助學生日後對航太材料於製造、設計及製程評估等材料工程領域的專業上，更具有評估與分析能力。",
    "describe_eh": " The purpose of this course will teach basic metal and composite materials epistemology via aircraft system design theory. In order to enhance aircraft materials engineering capability, course contents emphasize design demand, materials properties, and manufacture process.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "從航空工程設計需求學習材料特性需求，建立航空材料基礎專業知識。",
      "describe_en": "lishment basic aircraft materials knowledge and properties via aircraft system design theory."
    },
    {
      "seq": 2,
      "describe_ch": "能評估金屬材料製程參數選擇並了解工程規範，進而具有選定製程之工程能力。\t",
      "describe_en": "Evaluate and select correct metal materials standard."
    },
    {
      "seq": 3,
      "describe_ch": "能評估金屬材料破損與腐蝕型態，建立可進一步提出修正或預防的工程建議能力。",
      "describe_en": "Evaluate/Analysis of Materials Fracture Mechanics and Damage Tolerance."
    }
  ],
