  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CI02149",
    "sub_id": "01136",
    "scr_dup": "001",
    "tpa_score_new": "<div>(1) 平時成績：20%</div>\n\n<div>\n<ul>\n\t<li>完成期中形成性評量：1%</li>\n\t<li>完成總結性評量：4%</li>\n\t<li>完成課程學習問卷(5次)：5%</li>\n\t<li>出席率(缺席一次扣2%)：10%</li>\n\t<li>缺席定義：只要沒到課(實體)，不論是否有正常請假，均算缺席。</li>\n</ul>\n\n<div>(2) 期中成績: 30%</div>\n\n<div>\n<ul>\n\t<li>作業、實驗報告(含程式檔案)、心得報告：30%</li>\n</ul>\n</div>\n\n<div>(3) 期末成績：50%</div>\n\n<div>\n<ul>\n\t<li>期末專題提案報告(簡報)：5%</li>\n\t<li>期末專題發表(海報)：5%</li>\n\t<li>期末專題發表(簡報)：30%</li>\n\t<li>期末專題成果報告(書面)：10%</li>\n</ul>\n</div>\n\n<div>&nbsp;</div>\n\n<div>&nbsp;</div>\n</div>\n",
    "tpa_score_new_en": null,
    "course_pol": "1. 同學應準時出席上課，出席紀錄列入平時成績計算。\n2. 同學在課堂上都應尊重每個人，上課時請勿講話影響他人。\n3. 要確保在上課時，將手機調整為靜音。\n4. 不得戴耳機上課。",
    "course_pol_en": null,
    "course_rem": "老師在學期初提供預訂教學進度表給同學作參考，但實際教學進度可能會隨同學的學習狀況適度調整，確定的考試時間會於上課時公布。",
    "course_rem_en": null,
    "ais_meno": "<div>同學學習必須以誠信為基礎，考試中作弊或抄襲的學生或協助他人的行為，該次成績以零分計，若是累犯，將依逢甲大學學生獎懲辦法提送。</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": "N"
  },
