  "description": {
    "sub_id3": null,
    "sub_name": "環境生物學特論",
    "sub_ename": "SPECIAL TOPICS IN ENVIRONMENTAL BIOLOGY",
    "describe_ch": "本課程主要介紹生物學於環境工程與科學領域上最新研究與應用探索，涵蓋微生物學、生態學、生物多樣性與演化學等學科。其中包含環境基因體學、自然解方、環境遺傳物質等主題；將討論文獻並整理歸納，有助修課同學提升學術知能及生物學應用於環境工程職場上之相關專業。",
    "describe_eh": "This course focuses on the latest research and application of biology in environmental engineering and science, covering disciplines such as microbiology, ecology, biodiversity, and evolution. Topics include environmental genomics, natural based solutions, and environmental DNA. The course will discuss and summarize the literature to enhance students' academic knowledge and the application of biology to environmental engineering careers.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能描述生物學中各學科的新發展以及其重要性\t",
      "describe_en": "To describe new developments in various disciplines of biology and their significance"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解生物學發展在環境工程與科學領域上的應用\t",
      "describe_en": "To understand the application of biological developments in environmental engineering and science"
    },
    {
      "seq": 3,
      "describe_ch": "評估生物學的知識與技術提供現今環境保護與永續發展的創新策略\t.",
      "describe_en": "To evaluate biological knowledge and technologies to provide innovative strategies for environmental protection and sustainable development"
    }
  ],
