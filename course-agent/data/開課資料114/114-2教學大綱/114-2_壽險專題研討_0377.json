  "description": {
    "sub_id3": null,
    "sub_name": "壽險專題研討",
    "sub_ename": "SPECIAL TOPICS ON LIFE INSURANCE",
    "describe_ch": "依壽險之原理，原則探討壽險經營之四大支柱-企劃、展業、管理及財務，並分項列出專題並進行研討，以期將理論印證於實務。",
    "describe_eh": "This course studies four pillars – planning, business, management, and finance – for operation of life insurance based on principles of life insurance. The course proceeds by discussing topics related to the four pillars to verify theory with practice.",
    "pre_subname": "INSU1001保險學、INSU2001人壽保險",
    "pre_sub_id3": "INSU1001",
    "pre_sub_ename": "INSU1001 INSURANCE、INSU2001 LIFE INSURANCE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解壽險理論與經營。",
      "describe_en": "Principle and Management of life insurance."
    },
    {
      "seq": 2,
      "describe_ch": "能理解危險管理與保險的關係、保險契約特性與種類及保險市場供需的結合。",
      "describe_en": "Understanding and exercise in the four management foundations."
    }
