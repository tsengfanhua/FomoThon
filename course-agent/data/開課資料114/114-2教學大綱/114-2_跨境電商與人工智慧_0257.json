  "description": {
    "sub_id3": null,
    "sub_name": "跨境電商與人工智慧",
    "sub_ename": "CROSS-BORDER E-COMMERCE AND ARTIFICIAL INTELLIGENCE",
    "describe_ch": "以跨境電子商務的理論與實務，融入大數據及人工智慧，內含基本商業模式、網站經營與管理、產品評論、社交媒體分析等。跨境進階主題含文化衝突、跨境網路行銷與策略、人工智慧與大數據工具應用分析跨境網站流量等。",
    "describe_eh": "This course aims to equip the graduates with the knowledge and practice of cross-border e-commerce, with newly developed applications of big data and artificial intelligence. This course covers some basic issues including business modes, operation and management of websites, product review and social media, etc. In addition, this course probes into many advanced topics, such as the culture difference/adaption, cross-border e-marketing, cross-border strategy, artificial intelligence and big data application case studies, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
