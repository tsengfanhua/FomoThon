    "tpb_seq": 1,
    "tpb_book": "<div>This course will not have a formal textbook.&nbsp;Since electronic commerce is a fast-growing field, this course will use news and journal papers to help students understand cross-border e-commerce knowledge.&nbsp;</div>\n",
    "tpb_book_en": "<div>Electronic Commerce Twelfth Edition</div>\n\n<div>&nbsp;</div>\n\n<div>This textbook will provide some of the important information in Electronic Commerce.&nbsp;</div>\n"
  },
