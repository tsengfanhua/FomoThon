  "description": {
    "sub_id3": null,
    "sub_name": "材料力學",
    "sub_ename": "MECHANICS OF MATERIALS",
    "describe_ch": "教導學生使用於一般機械結構元件之機械設計時所需要了解之材料強度,變形量之計算,及選擇判定的方法及法則，在涉及電動機工作環境時，加強其特殊影響環境及工作目標因素的設計考量，並舉應用例讓學生了解如何將材料力學知識於電動機機械或微機電元件設計上之應用。",
    "describe_eh": "This course mainly teaches students to know the principleof material strength, and know which means and principals should be chosen when using motors and mechanical design of motor drivers.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用數學基礎以瞭解材料力學基本知識",
      "describe_en": "Apply mathematic foundation to understand the basic knowledge about mechanics of material."
    },
    {
      "seq": 2,
      "describe_ch": "理解材料力學各項性能的定義與定理",
      "describe_en": "Comprehend for the definitions or theories of mechanics of material performance."
    },
    {
      "seq": 3,
      "describe_ch": "應用模擬分析工具對材料力學完成分析與設計",
      "describe_en": "Application for the simulation tool box to mechanics of material analysis and design."
    },
    {
      "seq": 4,
      "describe_ch": "對材料力學具備描述問題、訂定規格、建構模型之各項分析能力",
      "describe_en": "With analysis capability on describe problems, define specifications and construct model for mechanics of material."
    }
  ],
