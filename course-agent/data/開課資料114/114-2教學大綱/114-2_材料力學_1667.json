    "tpb_book": "<div>Mechanics of Materials, Sixth Edition,Riley, William F., Sturges, LeRoy D., Morris, Don H.&nbsp; &nbsp;ISBN:047170511X&nbsp; &nbsp;ISBN-13:9780471705116<br />\n&nbsp;</div>\n",
    "tpb_book_en": " "
