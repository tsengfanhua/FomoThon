  "description": {
    "sub_id3": null,
    "sub_name": "高分子材料學",
    "sub_ename": "MATERIAL SCIENCE OF POLYMERS",
    "describe_ch": "本課程為介紹材料領域中高分子材料之相關資訊。知識部分包括基礎高分子材料概論、基礎高分子物性、高分子聚合、功能性高分子的介紹等。輔以高分子材料相關範例的解釋與解說，以增進學習成效。",
    "describe_eh": "This course introduces related information of polymer materials. The knowledge part includes an introduction to basic polymer materials, basic polymer properties, polymer polymerization, and introduction to functional polymers. This course is supplemented with explanations of related examples of polymer materials to enhance learning effectiveness.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "列舉高分子材料種類，並且描述高分子材料應用原理。\t",
      "describe_en": "Classification of polymeric materials and describe its application principle."
    },
    {
      "seq": 2,
      "describe_ch": "理解高分子材料在工程及學術層面的重要性。\t",
      "describe_en": "Comprehension for the importance of polymeric material to academia and engineering."
    },
    {
      "seq": 3,
      "describe_ch": "定義並說明機能性高分子的製備方法並選擇合適的試驗方法進行檢測與分析。\t",
      "describe_en": "To define and describe preparation and characterization of functional polymeric materials."
    },
    {
      "seq": 4,
      "describe_ch": "能應用高分子科技的原理與相關材料。\t",
      "describe_en": "To apply the principle of polymer science and related materials."
    }
  ],
