  "description": {
    "sub_id3": null,
    "sub_name": "駕駛行為",
    "sub_ename": "DRIVER BEHAVIOR",
    "describe_ch": "駕駛行為與交通安全有相當大的關係，一位具有駕駛基本駕駛能力的人，因在行為上的疏忽、錯誤與意圖的違規，且在道路風險出現時，欠缺注意、判斷不當、反應太慢、應變動作不確實，即會引發可能的事故後果，故探討駕駛行為的理論以及相關的影響因素，可以有效預防事故的產生，因此本課程將介紹一系列的駕駛行為問卷，包括自評風險、駕駛能力、關注不當行為、記錄衝突類型，以及分析這些行為的影響變數，期能有效提升駕駛安全。",
    "describe_eh": "There is strong relationship between driver behavior and safety, a skilled driver can involve in traffic accident because he neglects, is wrong, or intentionally violents traffic rules while facing roadway risks, as well as he un-intends these risks, improperly judges, slowly responses, or wrongly reacts. Therefore, exploring theory regarding driver behavior and its affecting variables can effectively prevent occurrence of accident. This course aims at introducing a serial of questionnaires about risk self evaluation, driver performance, concern on improper behavior, recording types of conflicts, and analyzing influence of related factors, in order to promote driver safety.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "4.教授運輸或物流相關政策與法規內涵及時事之評析能力",
      "describe_en": "4. Provide students with knowledge of transportation and logistics-related policies and regulations, and develop their ability to analyze current issues."
    },
    {
      "seq": 2,
      "describe_ch": "8.培養學生運用資料調查、數據分析或數學模型分析運輸或物流問題之能力",
      "describe_en": "8. Develop students' ability to analyze transportation and logistics problems using data collection, data analysis, or mathematical models."
    }
  ],
