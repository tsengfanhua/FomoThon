  "description": {
    "sub_id3": null,
    "sub_name": "敘事視覺化",
    "sub_ename": "VISUAL STORYELLING",
    "describe_ch": "本課程目標在於運用基本視覺元素，透過資料分析，以完成傳達訊息的目的。課程設計將涵蓋四大部分：(1)當代視覺資訊圖表的趨勢；(2)以說故事和視覺思考方式重新組織和呈現資料；(3)視覺元素的設計練習；(4)繪製工具的運用。",
    "describe_eh": "This course introduces students to methods and tools for visual storytelling to create relevant and engaging audiences presentations. To develop the ability of visual communication effectively, the course focuses on four interrelated sections: (1) the trend of contemporary infographic design, (2) applying ways of visual thinking to synthesize various sources of information, (3) learning design principles for constructing information graphics and(4) utilizing the infographic technology tools.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培育學生應用視覺化圖表和軟體技巧於表達和溝通過程",
      "describe_en": "Develop students' ability of learning visual design and applying technology tools for presentations."
    },
    {
      "seq": 2,
      "describe_ch": "培育學生以圖像思考和說故事方式來綜合分析資料",
      "describe_en": "Develop students' ability of applying storytelling and visual thinking for synthesizing various sources of information."
    }
  ],
