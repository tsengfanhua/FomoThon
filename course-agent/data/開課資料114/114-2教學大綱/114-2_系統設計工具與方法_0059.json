  "description": {
    "sub_id3": null,
    "sub_name": "系統設計工具與方法",
    "sub_ename": "SYSTEM DESIGN TOOLS AND METHODS",
    "describe_ch": "本課程旨在介紹太空工程領域中的系統設計工具和方法。學生將學習如何運用現代工具和技術來支援太空系統的設計過程，包括需求分析、功能分配、架構設計、模擬和驗證等方面。同時，他們將瞭解各種常用的設計方法，如系統工程、模型化與模擬、多目標優化等，並學會選擇和應用適合的方法解決複雜的設計挑戰。通過實際案例和團隊項目，學生將培養系統思維和解決問題的能力，並提高他們的設計效率和創新能力。",
    "describe_eh": "This course aims to introduce system design tools and methods in the field of space engineering. Students will learn how to utilize modern tools and techniques to support the design process of space systems, including requirements analysis, functional allocation, architecture design, simulation, and verification. They will also gain knowledge of various commonly used design methods such as systems engineering, modeling and simulation, and multi-objective optimization, and learn to select and apply appropriate methods to address complex design challenges. Through practical case studies and team projects, students will develop system thinking and problem-solving skills, enhancing their design efficiency and innovation capability.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養學生運用系統設計工具和方法進行太空系統設計的能力。",
      "describe_en": "Develop students' ability to utilize system design tools and methods for space system design"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解需求分析、功能分配和架構設計等系統設計的基本概念和技巧。",
      "describe_en": "Understand the fundamental concepts and techniques of requirements analysis, functional allocation, and architecture design in system design."
    },
    {
      "seq": 3,
      "describe_ch": "學習運用模擬和驗證技術驗證設計方案的有效性。",
      "describe_en": "Learn to use simulation and verification techniques to validate design solutions effectively."
    },
    {
      "seq": 4,
      "describe_ch": "掌握常用的系統工程方法和工具，並能夠適應不同的設計挑戰。",
      "describe_en": "Master common systems engineering methods and tools, and adapt to different design challenges."
    },
    {
      "seq": 5,
      "describe_ch": "培養學生的團隊合作和溝通能力，以有效地參與跨學科的設計項目。",
      "describe_en": "Cultivate students' teamwork and communication skills to effectively participate in interdisciplinary design projects."
    },
    {
      "seq": 6,
      "describe_ch": "促進學生的創新思維和解決問題的能力，以推動太空工程領域的發展。",
      "describe_en": "Emphasize teamwork and professional communication skills, fostering students' ability to work in interdisciplinary teams."
    }
  ],
