  "description": {
    "sub_id3": null,
    "sub_name": "有限元素分析",
    "sub_ename": "FINITE ELEMENT ANALYSIS",
    "describe_ch": "透過對於有限元素法基礎概念的教學，使學生瞭解有限元素之理論基礎並能有效地利用商用軟體解析實際工程問題。",
    "describe_eh": "To teach the students with the fundamentals of finite element methods and coding procedures , so that they can write their own or revise any existing software to solve related problems in mechanical engineering.",
    "pre_subname": "MCAE3000熱傳學、ENGS2001材料力學(一)、ENGS2002材料力學(二)",
    "pre_sub_id3": "MCAE3000",
    "pre_sub_ename": "MCAE3000 HEAT TRANSFER、ENGS2001 MECHANICS OF MATERIALS(1)、ENGS2002 MECHANICS OF MATERIALS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解有限元素法的基本學理",
      "describe_en": "Understand the basic principles of the finite element method"
    },
    {
      "seq": 2,
      "describe_ch": "利用有限元素法解機械工程相關問題",
      "describe_en": "Solve the related problems in mechanical engineering by the finite element method"
    },
    {
      "seq": 3,
      "describe_ch": "驗證利用有限元素軟體分析結果的正確性",
      "describe_en": "Validate the computed results obtained by the finite element codes"
    }
  ],
