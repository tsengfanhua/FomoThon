  "description": {
    "sub_id3": null,
    "sub_name": "策略聯盟管理",
    "sub_ename": "STRATEGIC ALLICANCE MANAGEMENT",
    "describe_ch": "本課程將以個案方式，教授大學部學生有關策略聯盟管理的知識、理論應用，與實例分析，並結合企業管理與組織之知識，瞭解在全球競爭環境下如何能借力使力快速切入市場並發揮企業夥伴之綜效，更進一步將探討公私部門協力的夥伴聯盟關係的國內外發展趨勢下，應如何兼顧經營管理績效與企業社會責任。",
    "describe_eh": "This course will introduce the concept, theoretical applications, and case analysis for strategic alliance management issues by the case-teaching approach at the undergraduate level. Under the globalization trend, this course will provide the analytic skills on examining the complementary synergy among strategic alliance partners. In addition, on the current global trend of public-private partnerships, students will learn the balanced management of managerial performances as well as corporate social responsibility.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解企業社會責任與跨部門聯盟的結合與可行性",
      "describe_en": "Comprehension for the feasibility of the integration between corporate social responsibility and cross-sectoral alliances"
    },
    {
      "seq": 2,
      "describe_ch": "能應用個案分析於策略聯盟的機會與潛在的應用場域",
      "describe_en": "Application for the case analysis on opportunities of strategic alliance in the potential fields"
    }
  ],
