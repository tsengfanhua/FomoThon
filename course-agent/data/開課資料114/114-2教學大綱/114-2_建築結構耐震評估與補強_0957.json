  "description": {
    "sub_id3": null,
    "sub_name": "建築結構耐震評估與補強",
    "sub_ename": "SEISMIC ASSESSMENT AND REINFORCEMENT OF BUILDING STRUCTURES",
    "describe_ch": "台灣位處環太平洋地震?,地震活動頻繁，因此，座落在台灣之結構物，其設計必須足以承受地震之考驗。本課程闡述建築結構耐震評估輿補強之理論與實務，?容涵蓋結構之耐震設計，耐震能力評估及結構耐震補強方法。",
    "describe_eh": "Taiwan is located in the Pacitic Rim Scismic Belt, and seismic activity is frequent. Therefore, structures located in Taiwan must be designed to withstand earthquakes.  This course expounds the theory and practice of Seismic Assessment and Reintorcement of Building Structures, covering the Seismic Design, Seismic Capability Evaluation and Seismic Reinforcement Methods for Structures.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解並熟悉建築結構耐震評估之基本理論與方法，包括初步評估、簡易詳細評估及詳細評估程序。",
      "describe_en": null
    },
    {
      "seq": 2,
      "describe_ch": "具備執行建築物耐震分析與補強設計的能力，能應用簡易側推分析及補強設計方法進行實務操作。",
      "describe_en": null
    },
    {
      "seq": 3,
      "describe_ch": "能綜合運用評估與設計技術完成案例實作，完成一棟既有二層建築物之補強評估與設計報告。",
      "describe_en": null
    }
  ],
