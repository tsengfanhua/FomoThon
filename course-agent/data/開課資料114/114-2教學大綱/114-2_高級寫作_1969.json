  "description": {
    "sub_id3": null,
    "sub_name": "高級寫作",
    "sub_ename": "ADVANCED ENGLISH WRITING",
    "describe_ch": "此為一門幫助初為研究生者學習正確書寫和有效書寫的課程，以便其掌握撰寫研究論文的基本技巧。為此，此一課程將要求學生詳細地分析樣本寫作和各式論文的結構，以使他們熟悉不同文本的格式和結構。學生還須學習學術寫作的所有過程，並知道如何有意義地分析和解釋不同的寫作文本。",
    "describe_eh": "This is a class to help beginning graduate students learn how to write correctly and to write effectively so that they could grasp the basic techniques of writing research papers. To do so, this class will ask students to analyze sample writings and research papers in greater details to familiarize them with the format and structures of different texts. Students have also to learn all the processes of academic writing and know how to analyze and interpret different writing texts meaningfully.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "增進學生英語文專業溝通能力",
      "describe_en": "To improve students’ proficiency in professional communications"
    },
    {
      "seq": 2,
      "describe_ch": "改善學生文本賞析、文化理解、語言應用及翻譯能力",
      "describe_en": "To better students’ readiness to explore literature, culture, applied linguistics, and translation studies"
    },
    {
      "seq": 3,
      "describe_ch": "具有終身學習能力",
      "describe_en": "To have the ability for life-long learning"
    }
  ],
