  "description": {
    "sub_id3": null,
    "sub_name": "創新與研發管理",
    "sub_ename": "INNOVATION MANAGEMENT",
    "describe_ch": "本課程將從創新與研發管理之理論出發，配合案例討論，以培養學生對創新與研發管理之能力。本課程並將以課堂講授輔助案例討論之方式，培養學生對創新科技管理新知主動之吸收能力。希望透過此雙管齊下之方式，使學生具備未來對創新與研發管理之基本能力。",
    "describe_eh": "This class introduces the theoretical bases of innovation management such as innovation models, innovation value chain, and the practice of innovation strategy. Students of this class are expected to participate in-class discussion as well as complete a term project in order to establish a basic understanding to the subject.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具有流程及模式的資料蒐集、分析、驗證、推論及整合能力。",
      "describe_en": "To acquire the capability in collection, analyses, verification, theorization and integration of data with Processes & Modules.　"
    },
    {
      "seq": 2,
      "describe_ch": "具有引導團隊持續改善、創新思維。",
      "describe_en": "To acquire the capability of leading a team to constantly improvement, innovatory thought."
    },
    {
      "seq": 3,
      "describe_ch": "具有發掘、分析及處理問題的能力。",
      "describe_en": "To acquire the capability of discover, analysis and dealing with the problem."
    }
  ],
