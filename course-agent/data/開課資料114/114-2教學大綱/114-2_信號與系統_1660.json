  "description": {
    "sub_id3": null,
    "sub_name": "信號與系統",
    "sub_ename": "SIGNALS AND SYSTEMS",
    "describe_ch": "介紹描述與分析系統與訊號所需之基本數學工具。其內容包括系統與訊號之基本概念、連續時間與離散時間之訊號與系統、線性非時變系統、傅立葉轉換、拉氏轉換、系統之狀態空間描述法及z轉換等。除此之外， 基本物理觀念的建立，將是鞏固工程教育的最有價值與永久的部分。本課程亦特別強調各種物理觀念的講述，並輔以數學技巧的說明。期使學生經由簡單理論基礎與相關模型建立，進而可以擴展延伸至到工程系統應用分析。",
    "describe_eh": "This course presents the mathematical descriptions and tools to the signals and systems in applications of engineering. The course includes: introduction to systems and signals, continuous-time and discrete-time signals and systems, linear time-invariant systems, Fourier transform, Laplace transform, State variables for systems, and z-transform etc. Both theory and practical skill are emphasis in this course from beginnings so students can extend it to new and complex of signal analysis.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、AUTO2000工程數學(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、AUTO2000 ENGINEERING MATHEMATICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用數學基礎以瞭解連續時間與離散時間的信號與系統之基本知識",
      "describe_en": "Apply mathematic foundation to understand the basic knowledge about continuous-time and discrete-time signals."
    },
    {
      "seq": 2,
      "describe_ch": "理解線性非時變系統之特性及應用",
      "describe_en": "Comprehension for the properties and applications of linear time-invariant system."
    },
    {
      "seq": 3,
      "describe_ch": "理解傅立葉級數、傅立葉轉換及拉普拉斯轉換及z轉換之基本理論、相關特性以及應用",
      "describe_en": "Comprehension for the fundamental theories, properties and applications of Fourier series, Fourier transform, Laplace transform, z-transform and its applications."
    },
    {
      "seq": 4,
      "describe_ch": "具備使用狀態變數於連續時間系統分析之能力",
      "describe_en": "With analysis capability on using state variables for continuous-time system."
    }
  ],
