  "description": {
    "sub_id3": null,
    "sub_name": "水文學",
    "sub_ename": "HYDROLOGY",
    "describe_ch": "本課程介紹水文現象之基本要素，包括水文學的定義、水在環境中分佈及移轉之特性、原理，並介紹水文變化與分布評估的經驗或學理方法，這些觀念與方法可以作為環境工程(給排水工程、污水處理、環境管理、防洪等)、土木與水利工程應用之依據。",
    "describe_eh": "This course introduces the fundamental elements of hydrological phenomena, including definition of hydrology, characteristics, theories of water distribution and transformation in our environment as well as empirical or theoretical methodologies used for estimating temporal and spatial variations of water distribution in the environment.  These concepts and methodologies can be applied in environmental as well as in civil and hydraulic engineering for various system designs.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得水文學的基本概念",
      "describe_en": "To obtain the basic concepts of hydrology　"
    },
    {
      "seq": 2,
      "describe_ch": "分析水文量測及數據意義　",
      "describe_en": "To analyze and explain data of the hydrologic measurement."
    },
    {
      "seq": 3,
      "describe_ch": "應用水文原理進行流量之模擬預測",
      "describe_en": "To apply hydrologic principles to simulate and predict flow rate for engineering application."
    }
  ],
