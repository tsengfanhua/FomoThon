  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(二)",
    "sub_ename": "ENGINEERING MATHEMATICS(2)",
    "describe_ch": "本課程主要在教導學生如何將科學或工程上的問題用數學方法來表示，提升學生數學思考能力。課程的內容主要包含Fourier級數、Fourier轉換求解、波動方程式、Laplace方程式、熱傳導方程式、二階偏微分方程及不同座標系的邊界值問題等議題。",
    "describe_eh": "This course is a study of the concept and method in engineering mathematics. To enhance student fundamental capability to solve some problems in science and engineering. Topics include: Fourier analysis, orthogonal expansions, Fourier transform, wave equation, Laplace equation, heat equation, partial differential equations and boundary value problem in different coordinates.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、EEEN2000工程數學(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、EEEN2000 ENGINEERING MATHEMATICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠理解傅立葉及偏微分方程式的計算方法。\r\n\r\n",
      "describe_en": "Comprehension for the calculation methods in Fourier series and partial differential equations."
    },
    {
      "seq": 2,
      "describe_ch": "能應用偏微分方程式以解決科學或工程問題。\r\n\r\n",
      "describe_en": "Apply the partial differential equations to solve the problems in science or engineering."
    },
    {
      "seq": 3,
      "describe_ch": "能分析一個線性系統計算程序，並得出其解。",
      "describe_en": "Analysis for the calculating procedures in a linear system, and to obtain the solution."
    }
  ],
