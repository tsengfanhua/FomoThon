  "description": {
    "sub_id3": null,
    "sub_name": "策略管理",
    "sub_ename": "STRATEGY MANAGEMENT",
    "describe_ch": "策略管理旨在探討策略決策之重要觀念架構、程序、方法、理論及相關知識。 本課程企圖使同學能學習到：\r\n1.整合企管教育主要課程所學，並能深入融會了解策略之理論觀念與運用。\r\n2.建立架構化觀念，培養系統性之分析、規劃能力。\r\n3.能運用理論知識、觀念能力及適當之方法、工具，對企業之發展方向及資源分配進行整體性、前瞻性之理解與思考。\r\n4.建立策略執行有關公司治理及企業倫理。\r\n",
    "describe_eh": "Strategy Management aims at exploring and understanding the important conceptual frameworks, general processes, methods, theories, and related knowledge of strategies. This course attempts :\r\n1. To integrate what students learn in all different functional areas of Business Management, in turn, to fully understand theoretical concepts of strategies and their applications.\r\n2. To establish students' structural concepts, and to enhance their systematic analysis and planning abilities.\r\n3. To make students be able to use theories, knowledge, concepts and methodologies to think, understand, analyze, and vision the development direction of firms.\r\n4. Establish strategy for executing the management of corporation and the vision of Business Ethic.\r\n",
    "pre_subname": "MGT1001管理學",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解策略管理之意義與內涵。",
      "describe_en": "To understand the meaning and contents of strategic management."
    },
    {
      "seq": 2,
      "describe_ch": "能與他人針對相關策略問題進行有效溝通",
      "describe_en": "To engage in effective communication on related strategic issues."
    },
    {
      "seq": 3,
      "describe_ch": "能有效分析組織中之策略問題並提出解決方案。",
      "describe_en": "To effectively analyze the strategies in organizations and to solve related problems."
    },
    {
      "seq": 4,
      "describe_ch": "能運用適當之策略管理相關知識及本身理念能力，以提昇組織之倫理效能與競爭優勢。",
      "describe_en": "To apply related knowledge of Strategy .Management and conceptual skills to improve organizational ethic effectiveness and sustainable competitive advantages ."
    }
  ],
