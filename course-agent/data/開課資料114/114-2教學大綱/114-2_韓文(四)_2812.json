  "description": {
    "sub_id3": null,
    "sub_name": "韓文(四)",
    "sub_ename": "KOREAN(4)",
    "describe_ch": "韓文初級課程(韓文(一)到韓文(四))，採互動式的教學，訓練學生正確的發音，並介紹基本、實用的單字、常用句型，透過反覆地練習使學習韓文?容?，讓學生能使用標準韓文進行表達溝通。\r\n修韓文(四)者必須修過韓文(三)或修滿至少90小時的韓文課程。",
    "describe_eh": "The Korean elementary level consists of four courses which are Korean (1), Korean (2), Korean (3) and Korean (4) and will train students to pronounce Korean precisely, introduce fundamental vocabulary and practical sentences so that they can study or work in a Korean language environment.\r\nKorean (4) is for students who have taken Korean (3) in FCU or have taken 90 hour Korean class.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備日常生活韓文使用能力，並提高同學對於語言的應變能力。",
      "describe_en": "Communicate in a Korean language environment and increase students' response to this target language."
    },
    {
      "seq": 2,
      "describe_ch": "增進同學對韓國的社會變遷與生活環境有深刻的瞭解，拓寬身為知識份子的宏觀視野，掌握韓國與台灣的互動關係。　",
      "describe_en": "Understand more about the living environment and changing society in Korea. Also, broaden students' views so they can better understand interactions between Taiwan and Korea."
    },
    {
      "seq": 3,
      "describe_ch": "將著重於培養同學學習韓文的興趣，願意自主地繼續學習韓語。",
      "describe_en": "Increase students' interest in learning Korean and have ability to pursue further study independently."
    }
  ],
