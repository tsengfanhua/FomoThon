    {
      "seq": 1,
      "describe_ch": "了解不同的信號與系統其離散時間之數學架構。",
      "describe_en": "To comprehend various mathematical models of discrete-time signals and systems."
    },
    {
      "seq": 2,
      "describe_ch": "能使用數學工具分析與處理通訊工程領域中的問題。",
      "describe_en": "Be able to use mathematical methods to analyze and deal with the problems in the fields of communication engineering."
    }
