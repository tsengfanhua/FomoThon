  "description": {
    "sub_id3": null,
    "sub_name": "資電技術專利實務",
    "sub_ename": "PATENT PRACTICE FOR INFORMATION AND ELECTRICAL TECHNOLOGY",
    "describe_ch": "透過專利的意義、專利的特色、專利制度簡介、專利申請、以及專利核准要件之介紹，期望學生能夠充分理解專利對於國家資電科技發展之重要性，同時也期望學生能夠初步理解專利制度與申請流程外，更期望與會者能夠經由此實務課程由淺入深的講解而獲得日後科技之技術啟發。",
    "describe_eh": "This course focuses on the information and electrical technology and intellectual property course, through the meaning of patents, patent characteristics, patent system introduction, patent application, and introduction of patent approval requirements, students are expected to fully understand the importance of patents for the development of national science and technology as well gainning future technology inspiration through shallow explanations through this practical course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生認識專利權與專利申請之實務關係。\t",
      "describe_en": "Make students aware of the relationship between patent rights and patent application."
    },
    {
      "seq": 2,
      "describe_ch": "使學生具備應用技術分析工具、專利檢索軟體、專利地圖等方法，探討資電技術專利佈局策略的能力。\t",
      "describe_en": "Enable students with the ability to apply technology analysis tools, patent search software, patent maps, etc., and explore strategies for the layout of information and electrical technology patents."
    }
  ],
