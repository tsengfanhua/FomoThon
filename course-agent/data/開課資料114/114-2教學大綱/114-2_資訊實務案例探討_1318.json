  "description": {
    "sub_id3": null,
    "sub_name": "資訊實務案例探討",
    "sub_ename": "CASE STUDY ON PRACTICAL INFORMATION SYSTEM",
    "describe_ch": "課程將以市面上資訊產品之實際案例，由上而下剖析，從產品中的元件規格說明到技術應用，講解與資訊工程的關係。除了講授產品的規格與技術，也會分析產品銷售之商業模式，並剖析新型態的商業營運模式，讓同學了解產業趨勢的發展。期末成果階段，規劃學生分組尋找實務案例並分析產品，提升自主學習團隊合作能力。",
    "describe_eh": "The course will analyze the actual cases of information products on the market from top to bottom. The component specifications in the description to technical application, explain the relationship with computer science and information engineering. In addition to teaching product specifications and technology, it will also analyze the business model of product sales, and analyze new business operation models, so that students can understand the development of industry trends. At the final stage of the results, students are planned to work in groups to find practical cases and analyze products to improve the ability of independent learning and teamwork.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解當今資訊系統之設計",
      "describe_en": "To know the design of up-to-date information system."
    },
    {
      "seq": 2,
      "describe_ch": "培養自我學習能力",
      "describe_en": "To develop the ability of self-learning and team working."
    },
    {
      "seq": 3,
      "describe_ch": "培養上台報告及整理報告文件能力",
      "describe_en": "Cultivate the ability to report and organize documents"
    }
  ],
