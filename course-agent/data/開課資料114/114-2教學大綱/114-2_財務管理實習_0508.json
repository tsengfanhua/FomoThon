  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB07121",
    "sub_id": "37740",
    "scr_dup": "001",
    "tpa_score_new": "<div>課堂參與討論 40% (正課與實習各占20%)</div>\n\n<div>書面報告 20%</div>\n\n<div>期中考與期末考各 20% (期中考與期末考請假者務必完成學校請假程序始得補考，並於考試後一週內主動找老師完成補考)</div>\n",
    "tpa_score_new_en": " ",
    "course_pol": "上課期間切勿發出聲音干擾其他同學學習與老師授課，若有任何問題可舉手或於休息時間與老師討論。 \n上課期間可使用電子產品查詢課堂所介紹的相關資訊。",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<div>財務管理描述公司財務管理的基本概念、管理與應用。請同學務必了解企業社會責任、永續經營的內涵價值。&nbsp;</div>\n\n<div>上課期間，鼓勵同學舉手發問，可與老師和助教互動；課後練習有助於期中考與期末考之準備。</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": null
  },
