  "description": {
    "sub_id3": null,
    "sub_name": "專業實習",
    "sub_ename": "INTERNSHIP",
    "describe_ch": "本課程為提供學生至產業機構進行實務實習的課程，其目的在加強學生全面了解學術理論與實務運作之交互關係，以強化學生專業技能，進而在畢業前學習溝通技巧，提升未來就業競爭力。",
    "describe_eh": "This course provides prospective students internship opportunities in industrial institutions or firms to learn practically. The purpose is to strengthen students’ comprehensive understanding of the interaction between theories of practices in the company, and in turn to improve students’ expertise as well as competitiveness in their future career.",
    "pre_subname": "FEAS4098校外實習導論",
    "pre_sub_id3": "FEAS4098",
    "pre_sub_ename": "FEAS4098 INTRODUCTION TO OFF-CAMPUS INTERNSHIP",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 9.0
  },
