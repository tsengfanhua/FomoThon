  "description": {
    "sub_id3": null,
    "sub_name": "英文(二)",
    "sub_ename": "ENGLISH(2)",
    "describe_ch": "這門課的主要重點是藉由課堂上不同的活動，來增進學生的英文單字量、文法分析與閱讀理解。過程當中，也會帶領同學們學習不同的閱讀技巧，來強化同學們的閱讀能力。除了單字、文法以及閱讀能力的強化外，亦將透過特定主題，來選取不同背景之文章來進行授課，以期厚實學生的文化底蘊。",
    "describe_eh": "This course aims to improve students’ vocabulary, grammar, and reading abilities through various kinds of in-class activities. In order to achieve this goal, teachers will also introduce different reading strategies to enhance students’ reading comprehension. In terms of students’ cultural cultivation, teachers will teachers will choose articles revealing different cultural values.\r\n\r\n",
    "pre_subname": "FLL1006英文(二)",
    "pre_sub_id3": "FLL1006",
    "pre_sub_ename": "FLL1006 ENGLISH(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備英文聽、說、讀、寫的應用能力。",
      "describe_en": "To be equipped with English  listening, speaking, reading, writing abilities"
    },
    {
      "seq": 2,
      "describe_ch": "具備職涯發展的英文知識。",
      "describe_en": "To be equipped with the knowledge of using English for career development"
    }
