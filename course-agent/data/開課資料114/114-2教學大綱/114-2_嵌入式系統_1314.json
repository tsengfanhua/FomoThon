  "description": {
    "sub_id3": null,
    "sub_name": "嵌入式系統",
    "sub_ename": "EMBEDDED SYSTEMS",
    "describe_ch": "在現今的世界中，到處都有嵌入式系統的蹤跡 - 住家、辦公室、汽車、工廠、醫院、和消費性電子產品。因此，本課程包含嵌入式軟硬體工具的使用與高低階語言的程式設計與應用；主要包括下列幾個主題，簡介嵌入式系統；嵌入式實驗平台； 嵌入式周邊程式設計，嵌入式作業系統製作，嵌入式作業系統程式設計與周邊控制等",
    "describe_eh": "In today's world, embedded systems are everywhere -- homes, offices, cars, factories, hospitals, plans and consumer electronics. Therefore, the course can use embedded related tools and hardware platforms to control and design embedded systems. This course introduces the following topics including the embedded systems, the Embedded Platforms; the Embedded Software Design; and Embedded Operating Systems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "讓學生知道設計嵌入式系統的基礎知識。",
      "describe_en": "Knowledge for embedded systems and programming environments."
    },
    {
      "seq": 2,
      "describe_ch": "應用組織能力與溝通技術，讓學生們能夠發揮團隊力量來設計嵌入式系統。",
      "describe_en": "Apply the capability of organization and communications between team members for solving the problems in designing embedded systems."
    },
    {
      "seq": 3,
      "describe_ch": "應用嵌入式系統的原理與實務以控制嵌入式系統。",
      "describe_en": "Apply the principals of embedded systems to control and design embedded systems."
    }
  ],
