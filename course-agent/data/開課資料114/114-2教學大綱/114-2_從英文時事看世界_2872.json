  "description": {
    "sub_id3": null,
    "sub_name": "從英文時事看世界",
    "sub_ename": "USE ENGLISH NEWS TO LEARN ABOUT THE WORLD AROUND US",
    "describe_ch": "本課程透過閱讀與討論時事主題，介紹英文字彙形成方式、閱讀技巧、英文標題基礎寫作與媒體素養。學生將從文章討論與觀賞新聞片段學會製作主題式英文播報短片。",
    "describe_eh": "News English aims to familiarize students with blended words in news articles, news English reading skills, basic headline writing skills, and media literacy by introducing commonly used media terms, and techniques. Through reading, discussing, and watching a wide range of news articles and video clips, students will also learn to make a short news video based on a current/controversial topic.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1. 能與他人合作製作英文新聞短片。",
      "describe_en": "1. To collaboratively produce a short English news clip."
    },
    {
      "seq": 2,
      "describe_ch": "2. 能閱讀英文新聞，並與他人討論時事。",
      "describe_en": "2. To be able to read English news, and discuss current issues with others."
    }
  ],
