  "description": {
    "sub_id3": null,
    "sub_name": "X光繞射原理",
    "sub_ename": "INTRODUCTION TO X-RAY DIFFRACTION IN MATERIALS SCIENCE",
    "describe_ch": "X光繞射原理是一門結合材料、物理、化學、數學、工程科學等領域的統整性學科。其目的在於瞭解結晶材料分析，包括：X光之特性介紹、結晶學(含對稱、晶格、晶系、晶格點等)、繞射基本原理(含繞射物理、粉末繞射儀原理、薄膜繞射儀及單晶繞射儀介紹等)、X光強度、X光的相鑑定、複雜多相分析、其他X光繞射分析方法 (粒度、應力、纖構)等。此課程為以課堂講授搭配hands-on作業的應用學科，課程實施將側重於學理原理與方法論。",
    "describe_eh": "The course of The Principles of X-Ray Diffraction in Materials Science and Engineering includes physics, chemistry, mathematics and engineering. This course aims to  explain the properties of x-rays, crystallography (symmetry, point group, lattice, unit cell, crystal system, space group, and equi-point, etc), x-ray diffraction theory (powder diffractometry, thin-film diffraction, and single-crystal diffractometry), diffraction peak intensity and measurement, phase analysis, diffraction from more complex structures, miscellaneous x-ray diffraction methods (particle size, stress analysis, and texture). This course combines theoretical lecturing and hands-on homework, emphasizing the principles and methodologies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習基本晶體結構，包括晶系、Bravais晶格、對稱學、Wulff網目圖、及倒置晶格等，並能針對上述結構資料做數據轉換。",
      "describe_en": "Learning the basic structure of crystals (e.g. crystal systems, Bravais lattices, symmetry, Wuff net, and reciprocal lattice), and being able to transform these crystalline data"
    },
    {
      "seq": 2,
      "describe_ch": "學習利用X-Ray光譜學、Bragg定律、結構因子等來進行晶體結構分析。",
      "describe_en": "Being able to analyze crystal structures by X-ray spectroscopy, Bragg's law, and structure factor, etc."
    },
    {
      "seq": 3,
      "describe_ch": "知道如何找到X光繞射學之相關資訊－特別是與材料晶體結構鑑定相關之實驗科學，並據以評估所獲資訊的適用性。",
      "describe_en": "Learning how to locate and access XRD information－especially related to the analysis of crystal structure, then evaluating the applicability of the obtained information"
    }
  ],
