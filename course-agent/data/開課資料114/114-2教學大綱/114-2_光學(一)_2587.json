  "description": {
    "sub_id3": null,
    "sub_name": "光學(一)",
    "sub_ename": "OPTICS (1)",
    "describe_ch": "介紹(a)幾何光學原理及其在光學系統的應用；(b)光波動性質；(c)雙光束干涉。內容包含(1)費瑪原理及應用；(2)球面反射和折射；(3)近軸光學之矩陣方法；(4)基本像差；(5)基本光學系統；(6)波之疊加；(7)雙光束干涉原理及方法。",
    "describe_eh": "Introduce (a) geometrical optics and its application in simple optical systems; (b) wave properties of light; (c) two-beam interference. The contents include (1) Fermat's principle and its application; (2) refraction and reflection by spherical surfaces; (3) the matrix method in paraxial optics; (4) elementary aberrations; (5)simple optical systems; (6) superposition of waves; (7) principles and methods of two-beam interference",
    "pre_subname": "PHYS1004普通物理(二)、OPT1005基礎光電工程數學",
    "pre_sub_id3": "PHYS1004",
    "pre_sub_ename": "PHYS1004 GENERAL PHYSICS(2)、OPT1005 BASIC MATHEMATICS FOR PHOTONIC ENGINEERING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠應用近軸幾何光學的基本原理。",
      "describe_en": "Be able to describe the principle of geometrical optics."
    },
    {
      "seq": 2,
      "describe_ch": "能蒐集及閱讀光學相關英文文獻資料。",
      "describe_en": "Be able to collect and read optical related English literatures."
    },
    {
      "seq": 3,
      "describe_ch": "能理解專業與資訊倫理。",
      "describe_en": "To comprehend professional ethics and information ethics."
    }
  ],
