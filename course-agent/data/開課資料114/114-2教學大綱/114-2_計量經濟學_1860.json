  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CF03120",
    "sub_id": "28300",
    "scr_dup": "001",
    "sub_title": "簡單迴歸模型   多元迴歸模型",
    "sub_title_en": null,
    "sub_describe": "1. 計量經濟學，是一門以資料驗證經濟理論和探究現象的學門。在應用上，經常經濟學家手上有個不知是否為真的假說，希望能透過資料驗證。如：最低工資是否會提高失業率、 小班教學是否有益於提升成績等等。\n\n2. 迴歸分析更是經常被用來分析兩個變量之間的因果關係，如「服務業比例提高是否造成職災總數上升」\n在統計軟體(EXCEL, R, STATA...)的幫助之下，迴歸分析也不過是數行指令便能完成的事。然而，要能準確詮釋迴歸分析的結果，仍需要紮實的統計基礎，否則容易淪為作者一廂情願。\n3. 大數據(Big data) 年代，我們更需要迴歸分析去解讀 數據 背後的經濟涵意。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "計量經濟學",
    "sub_ename": "ECONOMETRICS",
    "describe_ch": "計量經濟學是一門結合經濟理論與統計方法等領域的數理學科。其目的在於使用線性與非線性迴歸或其他計量方法來找出合理、可信的經濟模型中的參數。在使用各種計量方法時需先了解模型的假設條件及其估計、檢定方法。若假設條件不符，資料需先作修正。除理論知識外，學生需學習如何使用電腦計量軟體。",
    "describe_eh": " Econometrics is a course which combines the knowledge of the Economic theories and Statistics. The purpose of it is to find the reasonable and reliable parameters in an economic model by using the proper Econometrics methods. Before applying any econometrics method, students should have the knowledge about the assumptions, estimating methods, inferences of each method. The data should be revised if it does not meet the assumptions. Students should also be able to use at least one kind of Econometrics software.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解計量經濟學概念：掌握計量經濟學的基本概念及其在實證研究中的應用。",
      "describe_en": "Understand Econometric Concepts: Grasp fundamental concepts in econometrics and their applications in empirical research."
    },
    {
      "seq": 2,
      "describe_ch": "應用迴歸分析：應用簡單線性迴歸來分析多個變數、解釋係數並進行假設檢定。",
      "describe_en": "Apply Regression Analysis: Apply simple linear regression to analyze the multiple variables, interpret coefficients and conduct hypothesis tests."
    },
    {
      "seq": 3,
      "describe_ch": "我們應用計量經濟學方法來分析現實世界的經濟問題。",
      "describe_en": "We apply econometric methods to analyze real-world economic problems."
    }
  ],
