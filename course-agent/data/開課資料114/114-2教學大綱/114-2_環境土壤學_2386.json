  "description": {
    "sub_id3": null,
    "sub_name": "環境土壤學",
    "sub_ename": "ENVIRONMENTAL SOIL SCIENCE",
    "describe_ch": "本課程為提供學生土壤科學基礎概念。內容包括土壤礦物組成、分類、固液相間的平衡、離子交換、吸附現象之概念模式及量化方法、電雙層觀念以及土壤酸度與pH等。並且以此土壤基礎概念探討土壤污染問題。",
    "describe_eh": "This course introduces the students to the fundamental concepts of soil structure, mineral compositions, soil- water equilibrium, ion exchange, adsorption, and soil acidity.  Afterwards, the relationships of these concepts and soil contamination and remediation are provided to illustrate the importance of these concepts.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解土壤在生態系統中的主要功能及重要性。",
      "describe_en": "Comprehension of the important roles of soil in ecosystem"
    },
    {
      "seq": 2,
      "describe_ch": "了解土壤的主要組成成分。",
      "describe_en": "Comprehension of the major components of soil"
    },
    {
      "seq": 3,
      "describe_ch": "敘述水在土壤中之分布及對植物的影響。",
      "describe_en": "Description of how water is distributed among the soil components and affects the plants growth"
    },
    {
      "seq": 4,
      "describe_ch": "敘述土壤中離子交換反應成因。",
      "describe_en": "Description of the genesis of ion exchange reaction in soils"
    }
  ],
