    "scr_dup": "001",
    "sub_title": "消費者行為- 洞察生活掌握行銷",
    "sub_title_en": null,
    "sub_describe": "•\t使同學習得消費者行為與消費者心理的專業知識\n•\t使同學能將所學到的理論應用到生活中",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "消費者行為",
    "sub_ename": "CONSUMER BEHAVIOR",
    "describe_ch": "消費者行為的研究可以使我們可以觀察、分析消費趨勢與消費者的反應、行動、特徵，這不但可以使學生成為行銷的專業人員，更可以擴及其他生活的領域。",
    "describe_eh": "This course introduces Consumer Decision Process (CDP Model) in depth and how it affects on marketing mix strategy, branding and consonance.",
    "pre_subname": "MGT1001管理學",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 8,
      "describe_ch": "培養學生邏輯分析能力",
      "describe_en": "develop students' logical and analytical thinking ability"
    },
    {
      "seq": 9,
      "describe_ch": "應用消費決策理論於小組報告。",
      "describe_en": "Apply the consumption decision theory to the group project."
