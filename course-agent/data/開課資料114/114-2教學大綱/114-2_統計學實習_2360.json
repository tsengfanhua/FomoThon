  "description": {
    "sub_id3": null,
    "sub_name": "統計學實習",
    "sub_ename": "RECITATION OF STATISTICS",
    "describe_ch": "瞭解統計理論和方法，並能應用於生活所遭遇的實務問題。課程內容包括樣本分配與中央極限定理的介紹，以及參數的點估計、區間估計和假設檢定的基本概念。並輔以統計軟體來進行資料分析與結果解釋。此課程實施將側重於解題，並以作業、小考、報告等來進行檢核。",
    "describe_eh": "Understand statistical theories and methods, and be able to apply them to practical problems encountered in life.The course lectures on the sampling distribution, the CLT, and the concepts for the point estimation, interval estimation and hypothesis testing of population parameters.Also using statistical software as tool to present the data analysis and results interpretation.The implementation of this course will focus on problem solving, and will be checked with homework, tests, reports, etc.",
    "pre_subname": "MATH2011機率論",
    "pre_sub_id3": "MATH2011",
    "pre_sub_ename": "MATH2011 PROBABILITY",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解樣本分配與中央極限定理的概念\r\n\n",
      "describe_en": "Comprehension for the concepts of the sampling distribution and the central limit theorem.\r\n\n"
    },
    {
      "seq": 2,
      "describe_ch": "理解母體參數的估計方法\n",
      "describe_en": "Comprehension for the methods used at the estimation of population parameters.\r\n\n"
    },
    {
      "seq": 3,
      "describe_ch": "理解母體參數的假設檢定方法\n",
      "describe_en": "Comprehension for the methods used at the hypothesis testing of population parameters.\r\n\n"
    },
    {
      "seq": 4,
      "describe_ch": "理解兩樣本的估計及檢定方法",
      "describe_en": "Comprehension for the methods used at the estimation and the hypothesis testing for two samples.\r\n\n"
    }
  ],
