  "description": {
    "sub_id3": null,
    "sub_name": "新世代CNC工具機",
    "sub_ename": "NEW GENERATION OF CNC MACHINES",
    "describe_ch": "介紹新世代CNC工具機基本架構,傳動系統,包括高速主軸,滾珠螺桿,線性滑軌,線性馬達等先進機械先進機電組件以及高速切削應用.並安排代表性工具機廠參觀,使講授與實務並用.",
    "describe_eh": "This course explores the subject of New Generation of CNC Machine Tools -the combination of high speed and high precision machining. This course focus on topics such as High-speed spindle, Ball-screw, Linear-guide and Linear-motor, which are regarded as advanced mech-tronic components.Visiting MTB(machine tool builder) is included in this course as well, aims to provide a clear map starting from both knowledge and practice to students.",
    "pre_subname": "MCAE3075控制系統(一)、MCAE3076控制系統(二)",
    "pre_sub_id3": "MCAE3075",
    "pre_sub_ename": "MCAE3075 CONTROL SYSTEMS (1)、MCAE3076 CONTROL SYSTEMS (2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能針對一特定工程系統，評估一工程系統，設計一合理實驗加以驗證，並適切歸納出結論。",
      "describe_en": "For a specific engineering system, be able to evaluate the system, conduct the experiment, and draw appropriate conclusions."
    }
  ],
