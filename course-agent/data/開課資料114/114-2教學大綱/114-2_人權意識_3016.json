  "description": {
    "sub_id3": null,
    "sub_name": "人權意識",
    "sub_ename": "AWARENESS OF HUMAN RIGHTS",
    "describe_ch": "本課程旨在使同學們對人權保障有初步的認識，並進而關懷社會，尤其是對弱勢族群的處境的了解與尊重。",
    "describe_eh": "This courses focus our work on the founding ideals of the human rights, the human rights movement, those most purely represented in the 1948 Universal Declaration of Human Rights (UDHR), and the 1976 International Covenant on Civil and Political Rights (ICCPR). And it strongly related to the Taiwan present situation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解國際人權體制沿革與內容",
      "describe_en": "To understand the law of international human rights"
    },
    {
      "seq": 2,
      "describe_ch": "了解人權實踐並運用批判思考",
      "describe_en": "To Understand contemporary human rights practice and apply critical thinking"
    }
  ],
