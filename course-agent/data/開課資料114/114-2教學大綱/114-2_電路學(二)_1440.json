  "description": {
    "sub_id3": null,
    "sub_name": "電路學(二)",
    "sub_ename": "CIRCUIT THEORY(2)",
    "describe_ch": "學生將藉由課程講授、電路分析演練與隨堂考/會考等方式，學習並建立電路學基本學理。學期課程內容包含：交流訊號表示、串/並聯交流電路分析、各式交流網路分析、交流功率、共振電路分析及雙埠網路系統分析等單元。",
    "describe_eh": "Students will learn and establish fundamental concepts of a.c. circuitry through lecture teaching, practice and quiz, including basic elements and phasors, signal expressions, ac network analysis, resonance, and introductory of system analysis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備交流訊號表示與交流功率分析之基本知識。",
      "describe_en": "Knowledge of mathematical expressions of ac signals and ac power analyses."
    },
    {
      "seq": 2,
      "describe_ch": "理解交流網路、共振電路與雙埠網路之基本分析。",
      "describe_en": "Comprehension of fundamental analyses of ac networks, resonant circuits, and two-port networks."
    }
  ],
