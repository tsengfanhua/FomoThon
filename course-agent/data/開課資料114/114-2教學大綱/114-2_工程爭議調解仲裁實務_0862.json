  "description": {
    "sub_id3": null,
    "sub_name": "工程爭議調解仲裁實務",
    "sub_ename": "MEDIATION AND ARBITRATION OF ENGINEERING DISPUTE WITH THEIR PRACTICAL APPLICATION",
    "describe_ch": "闡明工程爭議之發生緣由與癥結所在，進而以調解或仲裁手法之依據及重點來解決紛爭，並輔以實務應用以結合法規及理論，達到理論與實務合而為一之目的。",
    "describe_eh": "Clarify the reason of the occurrence of Engineering and the Crux of the Dispute, and then to Mediation or Arbitration in accordance with the Practices and Priorities to resolve disputes, and Supplemented by Practical Application of Regulations and to incorporate theory, to Achieve the purpose of the Theory and Practice into One.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "土木或營建工程或管理基本概念及民法履約基本認知。",
      "describe_en": "Basic concepts of Civil or Construction engineering with management and basic understanding of the civil law performance"
    },
    {
      "seq": 2,
      "describe_ch": "履約爭議之發生原因癥結及解決爭議之基本法規與調解仲裁之規定與應用結合之要領。",
      "describe_en": "The reasons for the occurrence of the dispute and the basic rules for settlement of disputes and mediation arbitration provisions and application of the essentials."
    },
    {
      "seq": 3,
      "describe_ch": "安排實務案例以說明攻防之依據及重點闡明，訓練學生辯論之技巧。",
      "describe_en": "Arrange practical cases to illustrate the basis of attack and defense and focus on elucidating the skills of students to debate."
    }
  ],
