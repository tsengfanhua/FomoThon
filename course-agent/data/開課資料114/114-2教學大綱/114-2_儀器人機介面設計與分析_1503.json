  "description": {
    "sub_id3": null,
    "sub_name": "儀器人機介面設計與分析",
    "sub_ename": "DESIGN AND ANALYSIS OF INSTRUMENT HUMAN-MACHINE INTERFACE",
    "describe_ch": "主要探討如何運用各類型的 開源程式建立自動化半導體與元件量測儀器控制系統，幫助使用者瞭解如何通過自行開發應用程序來監視或者控制電子儀器硬體。實驗場域的設備藉由 開源程式  儀器監控內容涵蓋了從接線到建立接口，直到完成可用與智慧人機介面的整個過程。",
    "describe_eh": "This course focuses on how to quickly build an automated instrument control system using Python to help users understand how to monitor or control instrument hardware by developing their own applications. The experimental field's devices are monitored by Python instruments, covering everything from wiring to building interfaces to completing the available software.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用開源程式讀取各類型儀器設備與感測元件的應用程式的基本操作與知識。",
      "describe_en": "Provide students with the ability to use electronic related software and hardware tools."
    },
    {
      "seq": 2,
      "describe_ch": "結合儀器設備量測監控待測物件，並設計人機介面進行資料蒐集與可視化",
      "describe_en": "Enable students to integrate data from circuit design, electronic components and open source software."
    }
  ],
