  "description": {
    "sub_id3": null,
    "sub_name": "電子學(二)",
    "sub_ename": "ELECTRONICS(2)",
    "describe_ch": "電子學(二)介紹金氧半場效電晶體之特性、直流偏壓模型、放大器電路的小信號模型、積體電路放大器、差訊放大器、多級放大器、和運算放大器等分析模式。本課程實驗講授及習作並重，訓練學生具有分析電晶體放大器電路的能力，提昇工程教學成效。",
    "describe_eh": "Electronics (2) introduces the characteristics of metal oxide half field effect transistors, DC bias models, small- signal models of amplifier circuits, integrated circuit amplifiers, difference amplifiers, multi-stage amplifiers, and operational amplifiers. This course emphasizes both experimental teaching and assignments, training students to have the ability to analyze transistor amplifier circuits, and improving the effectiveness of engineering teaching.",
    "pre_subname": "PHYS1003普通物理(一)、PHYS1004普通物理(二)",
    "pre_sub_id3": "PHYS1003",
    "pre_sub_ename": "PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.瞭解各種電子元件之基本功能與電路知識",
      "describe_en": "1.Understanding the basic function and circuit knowledge of various electronic devices."
    },
    {
      "seq": 2,
      "describe_ch": "2.理解各種電子元件與電子電路的工程原理",
      "describe_en": "2.Comprehension for the engineering principle of various electronic devices and electronic circuits."
    },
    {
      "seq": 3,
      "describe_ch": "3.應用各種電子實驗設備完成電子電路之測試與設計",
      "describe_en": "3.Application for the electronic instruments to circuit testing and design."
    },
    {
      "seq": 4,
      "describe_ch": "4.運用電子電路分析軟體完成電子電路之特性分析",
      "describe_en": "4. Apply the circuits simulation tool box to circuits characteristic analysis."
    }
  ],
