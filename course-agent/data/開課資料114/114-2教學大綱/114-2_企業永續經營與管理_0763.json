  "description": {
    "sub_id3": null,
    "sub_name": "企業永續經營與管理",
    "sub_ename": "CORPORATE SUSTAINABLE DEVELOPMENT AND MANAGEMENT",
    "describe_ch": "如何在經濟、社會與環境中取得平衡，是企業面臨社會責任與永續發展的挑戰。本課程綜觀國內外企業永續發展之趨勢脈絡，透過個案深入剖析企業落實永續的策略，培養學生批判思考與實踐永續之能力，進而提升社會競爭力。",
    "describe_eh": "How to achieve a balance among environment, social and governance (ESG) is the main challenge for enterprises to face social responsibility and sustainable development. This course looks at the trend of sustainable development of domestic and foreign enterprises, and analyzes the strategies of enterprises to implement sustainable development through case teaching, so as to cultivate students' ability to think critically and practice enterprise sustainability, thereby enhancing their competitive power.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解近代全球永續發展之趨勢，並通過個案分析，將知識和實務進行整合。",
      "describe_en": "To Understand global sustainable development trends and integrate knowledge and practice through case studies."
    },
    {
      "seq": 2,
      "describe_ch": "能夠充分運用永續經營管理之知識，並以國際視野分析企業，從而實踐永續管理目標。",
      "describe_en": "Be able to apply the knowledge of sustainable management and analyze enterprises from an international perspective, so as to implement the goal of corporate sustainability."
    }
  ],
