  "description": {
    "sub_id3": null,
    "sub_name": "記帳相關法規",
    "sub_ename": "BOOKKEEPING LAWS AND REGULATIONS",
    "describe_ch": "本課程主要闡述記帳相關法規，詳細介紹記帳法規與實務，使學生對記帳相關法制及實務，能有一全盤而詳盡之瞭解。課程內容包括稅務代理制度概述、記帳士法、商業會計法、商業會計處理準則、公司登記規則、商業登記法、行政程序法第二章行政處分、職業倫理與道德；使學生具備從事稅務代理及記帳之基本法律觀念。",
    "describe_eh": "This course aims to introduce and interpret so that the students have a comprehensive and detailed of the understanding of keep accounts regulations. Curriculum encompasses an overview of tax agent system, keep accountant law, business accounting law, guidelines governing business accounting, regulations of company registration, administrative procedure act, chapter II administrative penalty, business registration act, professional ethics and moral. It is anticipated that the students will be armed with correct conceptions of taxation agency and keep accounts.",
    "pre_subname": "ACCT2001中級會計學(一)、ACCT2002中級會計學(二)",
    "pre_sub_id3": "ACCT2001",
    "pre_sub_ename": "ACCT2001 INTERMEDIATE ACCOUNTING(1)、ACCT2002 INTERMEDIATE ACCOUNTING(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解稅務代理及記帳之基本觀念。",
      "describe_en": "Comprehend correct conceptions of taxation agency and keep accounts. 　"
    },
    {
      "seq": 2,
      "describe_ch": "運用記帳相關法規於商業會計事務之處理。",
      "describe_en": "Able to apply regulations concerning keep accounts of handling business accounting affairs"
    }
  ],
