  "description": {
    "sub_id3": null,
    "sub_name": "顧客關係行銷",
    "sub_ename": "CUSTOOMER RELATIONSHIP MARKETING",
    "describe_ch": "提供經營管理者一套可以系統性分析顧客關係行銷問題的架構工具，因為面對日趨複雜的行銷環境，無論是B to B或B to C的市場，顧客關係行銷的皆起了相當大的變化，新的行銷名詞與觀念不斷地在市場上出現，經營管理者需要一個能更宏觀、更具系統的顧客關係行銷架構來幫助他們制訂具市場長期競爭力的行銷策略。本課程透過分析買者在行銷交換行為時所面對的問題，找出行銷癥結，並提供解決這些問題的實務方法，以便順利達成顧客關係行銷目的。將使用大量台灣企業之行銷相關案例來說明的架構顧客關係行銷觀點。",
    "describe_eh": "This course is designed to deliver knowledge of Customer Relationship Marketing problems, cause the increasing complexity of marketing environment. The aim of this course is to assist students to develop the new marketing terms and concepts are constantly appearing on the market. This course covers theory and development of CRM, customer data and information technology, impacts of CRM on marketing strategy, evaluation of CRM, and future challenges for CRM.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能利用4C架構分析個案公司並提出可行的顧客關係行銷策略\t",
      "describe_en": "Use principles of 4 transaction costs to analyze a case study and suggest feasible Customer Relationship Marketing."
    },
    {
      "seq": 2,
      "describe_ch": "綜合顧客關係行銷的理論與實務\t",
      "describe_en": "Synthesis the theory and practice of Customer Relationship Marketing."
    }
  ],
