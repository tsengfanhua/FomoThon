  "description": {
    "sub_id3": null,
    "sub_name": "跨時代的音樂延續",
    "sub_ename": "A MUSICAL CONTINUITY ACROSS GENERATIONS",
    "describe_ch": "音樂的發展從古至今，無論是樂器的構造和聲音的傳播，在每個時代都具有獨特的藝術風格和特質。\n本課程藉由探討音樂的發展與變革，帶領學生深入暸解不同時期之音樂風格和代表作曲家，培養學生暸解跨時代音樂的傳承，以及如何將音樂的藝術涵養和人文教育素養推廣延續至生活中。",
    "describe_eh": "The development of music from ancient times to the present, whether it is the construction of musical instruments or the transmission of sound, has a unique artistic style and characteristics in each era.\nBy exploring the development and transformation of music, this course will lead students to have an in-depth understanding of musical styles and representative composers in different periods. The course will also cultivate students' understanding of the inheritance of music across the ages, and how to promote the artistic and humanistic education quality of music in lives.\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "暸解從古至今的音樂發展知識",
      "describe_en": " Understand the development of music from the ancient to the present."
    },
    {
      "seq": 2,
      "describe_ch": "透過聆聽音樂了解各國的音樂和文化",
      "describe_en": "Learn about different music and styles around the world by listening to music"
    }
  ],
