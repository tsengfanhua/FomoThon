  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CM02119",
    "sub_id": "19051",
    "scr_dup": "001",
    "sub_title": "汽車車輛碰撞及價值評估",
    "sub_title_en": null,
    "sub_describe": "本課程旨在讓學生深入了解汽車在不同環境與條件下的碰撞行為，並培養正確的車輛損害分析與價值評估能力。課程內容涵蓋車輛結構設計原理、材料特性、碰撞能量吸收機制、以及碰撞後損害評估方法。透過理論講解與實務案例分析，學生將學習如何依據車輛種類、重量、速度、碰撞角度與環境因素，判斷車輛損壞程度及其經濟修復價值。\n課程重點：\n1.車輛結構與材料特性分析\n2.不同速度、重量與環境條件下的碰撞行為探討\n3.碰撞能量吸收與變形模式研究\n4.車輛損害評估與修復經濟性分析\n5.車輛價值與殘值評估方法\n6.實際案例解析與模擬評估練習",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "車輛碰撞學",
    "sub_ename": "MECHANICS OF VEHICLE COLLISION",
    "describe_ch": "介紹各式車輛（機車、小型車、大型車等）之構造、駕駛人之反應時間、車速、向量、動量守衡、車輛碰撞受力行為等，作為事故重建之依據。",
    "describe_eh": " Introduction of structures and functions of vehicles such as motorcycle, passenger cars, and trucks etc., the reaction perception time, speed, vectors, momentum equilibrium, and the vehicle behaviors after collision. From those basis skills, then we can reconstruct the happening of a traffic accident.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
