  "description": {
    "sub_id3": null,
    "sub_name": "英語教學活動設計",
    "sub_ename": "INTRODUCTION TO ENGLISH LANGUAGE TEACHING AND ACTIVITYDESIGN",
    "describe_ch": "此課程幫助對於未來想成為英語教師者或對相關領域有興趣者，提供對於未來職涯上的準備與理解。課程內容涵蓋相關英語教學議題，透過多元的課堂活動，幫助學生理解英語教學活動的知識及應用，像是繪本閱讀，多元文化議題討論等等。此課程也探討學生從英語學習者進階到英語教育者，將會面臨語言使用的挑戰與身分轉換的適應。",
    "describe_eh": "The course aims at preparing students’ knowledge to work in English teaching and other related fields. The course includes important English teaching and learning issues and diverse learning activities to help students gain knowledge of English teaching, such as reading picture books, discussing multicultural issues, etc... Also, the course prepares students to meet the challenges of changing their identities from a language learner to language educators.   \r\n \r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1. 協助學生能清楚表達所學到的英語教學知識，建立良好的溝通能力及人際關係。",
      "describe_en": "1. Assist students to apply their understanding of English language teaching knowledge and develop effective communicative skills and interpersonal relationships."
    },
    {
      "seq": 2,
      "describe_ch": "2. 協助學生應用所學到的知識，和不同的專業背景的學生互助合作，建立良好的關係。",
      "describe_en": " 2. Assist students to use their knowledge to cooperate with different professions and establish positive relationships."
    }
  ],
