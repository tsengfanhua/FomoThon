  "description": {
    "sub_id3": null,
    "sub_name": "資訊管理",
    "sub_ename": "INFORMATION MANAGEMENT",
    "describe_ch": "資訊科技與組織各層面的整合與應用，主要目標有四：(1)資訊科技的策略應用；(2)電子商務的衝擊；(3)資訊科技對個人、組織、與整個社會的影響；(4)流程管理與資訊科技。學生學習後應能整合各種不同教材(如個案、教科書、演講、以及報告等)，並應用於真實狀況。",
    "describe_eh": "This course focuses on the integration and application of information technology on the organization. The main goal is as follows: (1) strategic application of information technology; (2) Impact of e-commerce; (3) the impact of Information technology on individuals, organization, and society; (4) Process management and information technology. Students should be able to combine all kinds of teaching material after the study (such as case, textbook, lecture, and report,etc.), and apply to the true state.A",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "分析資訊系統的應用，以及它對組織運作的影響。",
      "describe_en": "Analyze the applications of information systems and the impact on organization."
    },
    {
      "seq": 2,
      "describe_ch": "綜合電子商務對企業的應用。",
      "describe_en": "Synthesize the applications of e-commerce on business models."
    }
  ],
