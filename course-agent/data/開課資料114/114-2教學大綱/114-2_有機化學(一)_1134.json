  "description": {
    "sub_id3": null,
    "sub_name": "有機化學(一)",
    "sub_ename": "ORGANIC CHEMISTRY(1)",
    "describe_ch": "介紹烷類、烯類、炔類的命名、結構、物性、製備、化學反應及其工業上的應用，並強調這些化合物在化學反應的機轉中能量與立體結構的變化.",
    "describe_eh": "Introduction to nomenclature, structures, physical properties, preparation, chemical reactions, industrial applications of the compounds in the organic families of alkanes, alkenes, alkynes and alkyl halides.  The mechanism, energy change, and stereochemistry of their chemical reactions are thoroughly investigated.",
    "pre_subname": "ENGS1012普通化學(一)",
    "pre_sub_id3": "ENGS1012",
    "pre_sub_ename": "ENGS1012 GENERAL CHEMISTRY(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "藉由認識有機化學各類型官能基之特性及反應性。",
      "describe_en": "By realizing the characteristic and responsive of all kinds of sense base of organic chemistry."
    },
    {
      "seq": 2,
      "describe_ch": "具備構思、規劃及有機化學合成的技能。",
      "describe_en": "Possess the technical ability that conceiving, planning and organic chemistry formation."
    },
    {
      "seq": 3,
      "describe_ch": "強調在有機化學反應中的反應機轉、能量與立體結構的變化",
      "describe_en": "The changes of energy, reaction mechanism, and three-dimensional structure emphasized in the organic chemical reaction."
    }
  ],
