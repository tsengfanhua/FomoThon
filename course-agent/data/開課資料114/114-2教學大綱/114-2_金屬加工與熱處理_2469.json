  "description": {
    "sub_id3": null,
    "sub_name": "金屬加工與熱處理",
    "sub_ename": "MANUFACTUREING PROCESSES AND HEAT TREATMENT OF METALS",
    "describe_ch": "金屬加工與熱處理是要掌握金屬材料中相變化的基本規律，具有運用、分析和研究金屬熱處理製程問題能力，深入探討成分、組織與金屬與性能之間的關係，以及熱處理在實際生產中的應用。",
    "describe_eh": "Metal processing and heat treatment are dealing with the fundamental rules of phase change of metals. These techniques involve the abilities of application, analysis and research on the metals and alloys. This course will teach students about the relationships between compositions, microstructures and properties of metals and alloys. Meanwhile, the application of heat treatment to the practical manufacturing process is also discussed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "詳細解釋一般熱處理（退火、正火、淬火和回火）方法，充分瞭解鋼在加熱及冷卻的組織轉變。",
      "describe_en": "To illustrate proficiently the general heat treatments (annealing, normalizing, quenching and tempering); thoroughly understand the structure change of steel under heating and cooling processes."
    },
    {
      "seq": 2,
      "describe_ch": "理解鋼的硬化能概念，基本掌握硬化能測量方法和影響硬化能的因素，掌握防止淬火開裂和減少變形的措施。",
      "describe_en": "To realize the concepts, the basic measuring methods and the affecting factors of the hardenability of steel. To know the precautions of avoiding fracture and decreasing deformation during the quenching process."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解鋼的表面硬化、表面化學熱處理的製程特點及應用範圍。\r\n",
      "describe_en": "To comprehend the surface hardening and the distinguishing features & applicable range of the process of surface chemical heat treatment of steel."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解工業用各式熱處理爐的原理與功能。",
      "describe_en": "To understand the principle and function of different heat-treatment furnace using in industry."
    }
  ],
