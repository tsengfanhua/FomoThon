  "description": {
    "sub_id3": null,
    "sub_name": "電腦科學概論",
    "sub_ename": "INTRODUCTION TO COMPUTER SCIENCE",
    "describe_ch": "本課程將分類介紹計算機硬體的重要的部件、作業系統基礎概念、基礎APPs程式設計、軟硬體的協作原理，並逐步衍伸到物聯網通訊與架構設計，以及雲端服務平台與傳統計算機的同異之處與優劣特性比較。",
    "describe_eh": "This course will classify and introduce the important components of computer hardware, basic concepts of operating systems, basic APPs programming, software and hardware collaboration principles, and gradually extend to the communication and architecture design of the Internet of Things, as well as the cloud service platform and traditional computer Similarities and differences and comparison of advantages and disadvantages.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "以APP實作學習設計理解基礎軟體設計理念與軟、硬體溝通原理",
      "describe_en": "By APP design implementation, understand basic software design concepts and the principles of software and hardware communication"
    },
    {
      "seq": 2,
      "describe_ch": "分析與討論智慧聯網與傳統計算機的差別以及產業應用上的差異性",
      "describe_en": "A Analyze and discuss the difference between smart networking and traditional computers and the differences in industrial applications"
    },
    {
      "seq": 3,
      "describe_ch": "學習電腦科學與計算機知識的同時，建立所應遵守的專業倫理與社會責任之觀念",
      "describe_en": "While learning computer science and computer knowledge, establish professional ethics and social responsibility concepts that should be observed"
    }
  ],
