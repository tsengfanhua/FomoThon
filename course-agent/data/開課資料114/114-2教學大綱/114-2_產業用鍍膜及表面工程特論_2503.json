  "description": {
    "sub_id3": null,
    "sub_name": "產業用鍍膜及表面工程特論",
    "sub_ename": "ADVANCED COATINGS & SURFACE ENGINEERING FOR INDUSTRIAL APPLICATION",
    "describe_ch": "真空鍍膜技術為近代產業升級轉型所倚賴的基礎重點科技之一，本課程涵蓋真空技術基礎、鍍膜製程與材料分析及相關表面工程技術的基礎知識傳授，並配合產業實例分享，探討產業用鍍膜及表面工程的現況與未來趨勢。\r\n\r\n",
    "describe_eh": "Vacuum coating technology is one of the basic key technologies for the advanced industries. This course includes the basic knowledge of vacuum, the deposition process, the materials characterization, and the related surface engineering. In this class, the content will share the real cases in the corresponding industry and explore the trends of the advanced industry.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建構真空技術的知識架構",
      "describe_en": "Construct the framework for the knowledge base of vacuum technology"
    },
    {
      "seq": 2,
      "describe_ch": "認識相關鍍膜技術原理與製程發展",
      "describe_en": "Understand the principle of coating process and the development of deposition method"
    },
    {
      "seq": 3,
      "describe_ch": "建構薄膜材料分析與性質研究能力",
      "describe_en": "Construct the ability to analyze the materials in structure and properties"
    },
    {
      "seq": 4,
      "describe_ch": "建構相關產業化鍍膜技術應用的衍生問題及其解答的相關資料檢索能力",
      "describe_en": "Construct the ability of the literature review and the independent research in the application for the industry"
    }
  ],
