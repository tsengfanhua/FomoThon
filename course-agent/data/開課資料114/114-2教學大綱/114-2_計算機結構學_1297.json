  "description": {
    "sub_id3": null,
    "sub_name": "計算機結構學",
    "sub_ename": "COMPUTER ARCHITECTURE",
    "describe_ch": "本課程的目的在介紹計算機系統中CPU的設計。主要內容包括CPU架構的效率評估、ALU的設計、控制單元的設計、管線式結構的設計、計憶體結構的設計、計算機系統的輸入及輸出、以及現代計算機結構的發展趨勢。",
    "describe_eh": "The objective of this course is to introduce the design of the CPU in a computer system. Contents of this course include the estimation of the CPU performance, the ALU design, Control unit design, pipeline architecture, memory hierarchy, the input/output of a computer system,and current trends of computer architecture design.",
    "pre_subname": "IEE1006邏輯設計",
    "pre_sub_id3": "IEE1006",
    "pre_sub_ename": "IEE1006 LOGIC DESIGN",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備計算機系統基本架構的知識",
      "describe_en": "Knowledge for computer architecture"
    },
    {
      "seq": 2,
      "describe_ch": "理解增進計算機系統效能的各項設計技術與原理",
      "describe_en": "Comprehension for technologies, principles, and current trends of computer architecture design"
    },
    {
      "seq": 3,
      "describe_ch": "應用效率模型來評估計算機系統各元件的設計能力",
      "describe_en": "To apply the performance model to estimate the design capability of computer architecture components"
    }
  ],
