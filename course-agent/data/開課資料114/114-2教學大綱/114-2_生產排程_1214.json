  "description": {
    "sub_id3": null,
    "sub_name": "生產排程",
    "sub_ename": "PRODUCTION SCHEDULING",
    "describe_ch": "介紹在各種環境中所遇到之排程問題和介紹不同排程技術去解決這些排程問題。課程主題包括：單機排程-基本結果、單機排程-先後次序限制、流程式生產和零工生產方式之建構式演算法、裝配線、群組技術、限制理論。",
    "describe_eh": "The purpose of this course is to introduce the scheduling problems encountered in various environments and to provide scheduling techniques to resolve these scheduling problems.  Course topics include: single machine processing - basic results, single machine processing - precedence constraints and efficiency, constructive algorithms for flow-shops and job shops, assembly lines, group technology, and theory of constraints.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂排程，而且知道如何運用於各種不同環境中。",
      "describe_en": "Define Scheduling with their own words , and to know how to use it in various environments."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明排程在社會及經濟層面的重要性及影響。",
      "describe_en": "Understand and be able to explain the importance and effects of Scheduling to society and economy."
    },
    {
      "seq": 4,
      "describe_ch": "知道於何處可找到排程的相關資訊，並可評估所獲資訊的適用性。",
      "describe_en": "Know where to locate and access related Scheduling information, research, as well as standards, and be able to evaluate the appropriateness of the obtained information."
    },
    {
      "seq": 5,
      "describe_ch": "能利用排程的原理，評估產品或系統，並提出可行驗證方法。",
      "describe_en": "Use principles of Scheduling to evaluate a product or system and propose a feasible method for validation."
    }
  ],
