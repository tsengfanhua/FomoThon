  "description": {
    "sub_id3": null,
    "sub_name": "資料探勘於土木工程之應用",
    "sub_ename": "DATA MINING FOR CIVIL ENGINEERING APPLICATIONS",
    "describe_ch": "本課程將介紹資料蒐集、資料格式轉換、資料探勘理論與免費公開實作平台等主題，並結合土木工程領域相關應用。此外，學生必須嘗試將所學理論、實務套用至個人研究主題，以期拓展或精進研究成果。",
    "describe_eh": "This course will present the data collection, transformation of data format, data mining theories and, practices based on the open-source platform for applications of civil engineering domain. In addition, applying the data mining methods to personal research topic is expected in order to extend and improve research achievements",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 4,
      "describe_ch": "瞭解資料探勘演算法原理",
      "describe_en": "Realize the principles of data mining algorithms"
    },
    {
      "seq": 5,
      "describe_ch": "培養資料探勘演算法實作技能",
      "describe_en": "Use the open-source platforms in the data mining field"
    },
    {
      "seq": 6,
      "describe_ch": "應用資料探勘於個人研究主題(土木工程相關)",
      "describe_en": "Apply the data mining algorithms to personal research topic (related to civil engineering domain)."
    }
