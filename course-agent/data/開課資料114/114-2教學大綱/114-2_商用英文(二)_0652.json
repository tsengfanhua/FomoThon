  "description": {
    "sub_id3": null,
    "sub_name": "商用英文(二)",
    "sub_ename": "ENGLISH FOR BUSINESS (2)",
    "describe_ch": "本課程是商務英文(一)的延伸，旨在深入探討商業溝通的高級主題和技巧。課程將重點介紹商務會議、談判、專業演講以及商業書信的撰寫。學生將通過模擬情景和案例研究來應用他們的知識，並進一步提高他們的商業英語能力。",
    "describe_eh": "This course is an extension of Business English (I), aiming to delve deeper into advanced topics and skills of business communication. The course will focus on business meetings, negotiations, professional presentations, and the composition of business correspondence. Students will apply their knowledge through simulations and case studies, further enhancing their proficiency in Business English..",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生可以製定商務英語的跨文化交流策略。",
      "describe_en": "Students can develop intercultural communication strategies in Business English."
    },
    {
      "seq": 2,
      "describe_ch": "學生能商業環境中有效的跨文化溝通",
      "describe_en": "Students communicate effectively across cultures in a business context."
    }
