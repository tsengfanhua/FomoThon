  "description": {
    "sub_id3": null,
    "sub_name": "永續金融與投資",
    "sub_ename": "SUSTAINABLE FINANCE AND INVESTMENT",
    "describe_ch": "本課程將引領學生探索如何在金融和投資領域中實現永續發展目標。從理論到實踐，我們將深入探討永續金融的各個方面，包括原則、實踐方法、綠色金融，以及環境、社會和治理（ESG）準則的應用。",
    "describe_eh": "This course will explore how to achieve sustainable development goals in the realms of finance and investment. From theory to practice, we will delve into various aspects of sustainable finance, including principles, methodologies, green finance, and the application of environmental, social, and governance (ESG) criteria.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
