  "description": {
    "sub_id3": null,
    "sub_name": "基礎光電實驗",
    "sub_ename": "BASIC PHOTONICS LAB.",
    "describe_ch": "本課程培養學生於光電實驗室以動手實作方式學習，增進實作經驗並印證相關光學理論，課程重點為介紹光電領域中必備的專業知識及相關技術應用，課程內容包含幾何光學成像、干涉與干涉術、繞射、偏振、光電元件、液晶光學、聲光效應、半導體雷射應用、光訊號處理及光譜量測技術等各項實驗。",
    "describe_eh": "Experiments developed to enhance and supply practical hands-on experience of optical theory are covered in this course. Topics include the basic required knowledge and related technologies in the field of electro-optics. The contents in the course cover the basic theory of geometrical optics, interference and optical interferometry, diffraction, polarization, optoelectronic devices, LCD optics, optical fiber optics, optical signal process and optical metrology.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解光電實驗中使用的光電元件用途。",
      "describe_en": "Comprehension for the  electro-optics device used in the electro-optical experiment."
    },
    {
      "seq": 2,
      "describe_ch": "能夠應用光電相關原理進行操作實驗。",
      "describe_en": "Application for the related principle of the electro-optics field to a practical experiment."
    },
    {
      "seq": 3,
      "describe_ch": "能分析及解釋實驗結果。",
      "describe_en": "Analysis and explanation for the experimental results."
    }
  ],
