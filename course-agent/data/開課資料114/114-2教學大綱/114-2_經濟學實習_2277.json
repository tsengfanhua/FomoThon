  "description": {
    "sub_id3": null,
    "sub_name": "經濟學實習",
    "sub_ename": "ECONOMICS PRACTICE",
    "describe_ch": "讓學生從經濟學的課程中瞭解經濟體系中的消費者、生產者、及政府單位如何在有限制的條件下做選擇。將理論的邏輯推理運用在日常生活當中。",
    "describe_eh": "Economics explains how consumers, producers, and the government make their best decisions based on the different constraints. Students can apply the theory of Economics to deal with their problems in real life.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "讓學生從經濟學的課程中瞭解經濟體系中的消費者、生產者、及政府單位如何在有限制的條件下做選擇。",
      "describe_en": "Understanding how consumers, producers, and the government make their best decisions based on the different constraints."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生具有經濟學方式的思考能力及邏輯推理之能力。",
      "describe_en": "To help students develop the capacity of economics way of thinking and logical reasoning."
    }
