  "description": {
    "sub_id3": null,
    "sub_name": "環境變遷與永續發展",
    "sub_ename": "ENVIRONMENT CHANGE AND SUSTAINABLE DEVELOPMENT",
    "describe_ch": "使學生了解環境倫理思想對環境的影響，透過各種環境議題的深入討論，建立整體生態共存的全球觀和價值信念，進而創造出對環境關懷的永續發展行為啟發環保意識。",
    "describe_eh": "The purpose of this course is to help the student to understand the influence of environmental ethics on the environment. The following environmental consciousness that could be inspired the establishment of a global view of the overall ecological coexistence and value beliefs, and thus create a sustainable development of environmental care behavior inspire environmental awareness.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能描述現今各種環境議題，如全球暖化、海洋污染、生物滅絕、酸雨的成因與影響\t",
      "describe_en": "Be able to describe the causes and the influence of contemporary environment issues, e.g. global warming, ozone hole, ocean pollution, biological extinction, acid rain etc."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解永續發展中環境、社會與經濟的關係\t",
      "describe_en": "Understand the relation between environment, society, and the economical for the sustainable development"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解人與環境的關係，進而能持續關心並評估永續發展與環境保護等相關議題\t",
      "describe_en": "Understand the relation between humanity and environment, then continue care and evaluate the subjects of the environmental protection and the sustainable development."
    }
  ],
