  "description": {
    "sub_id3": null,
    "sub_name": "網路攻防演練",
    "sub_ename": "CYBERSECURITY EXERCISE",
    "describe_ch": "本課程教授各類型之網路安全攻防議題。網路攻防演練課程涵蓋入侵偵測系統、APT攻擊、數位鑑識、Deepfake、零信任、LLM安全等議題。授課規劃將以案例分析、議題研究與模擬演練進行。於本門課中，學生可強化自身對於網路威脅的辨識能力，同時具備防禦策略設計的能力。",
    "describe_eh": "This course explores cybersecurity technologies and AI applications. Topics include Intrusion Detection Systems (IDS), Advanced Persistent Threat (APT) attack, digital forensics, Deepfake, and Zero Trust Architecture (ZTA), LLM Security. Through case studies and simulation practices, students will enhance their knowledge of cyber threat awareness, as well as the ability to design defense strategies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
