  "description": {
    "sub_id3": null,
    "sub_name": "商業模式應用與創新",
    "sub_ename": "BUSINESS MODEL PRACTICE AND INNOVATION",
    "describe_ch": "許多社會企業與社會創業皆試圖透過商業機制與創新運作來達到解決當代社會問題的目標。本課程的討論重點將著重於企業經營與社會目標的價值主張下，能兼顧創新過程中的有效性、持續性與可利用性。",
    "describe_eh": "Many social enterprises and entrepreneurs were built to solve social problems through social entrepreneurship and innovation. The class aims to discuss 1) value proposition during business operation and social issues, and 2) the effectives, sustainability and usability of innovation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
