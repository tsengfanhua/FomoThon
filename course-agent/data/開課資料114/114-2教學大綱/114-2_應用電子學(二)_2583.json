  "description": {
    "sub_id3": null,
    "sub_name": "應用電子學(二)",
    "sub_ename": "APPLIED ELECTRONICS(2)",
    "describe_ch": "本課程的目的是提供對類比及數位電路之分析及設計的基本能力，包含銜接實際應用的一些進階示範。下學期介紹運算放大器及常用IC的物理原理、工作條件和基本的應用電路設計。",
    "describe_eh": "The purpose of this course is to provide a basic foundation for analyzing and designing both analog and digital electronic circuits. More advanced material about practical applications are included. In the second part of this course, we introduce the physical principles and operation restrictions of the operational amplifier and other      commonly used IC and the basic circuit design in which they are used.",
    "pre_subname": "PHYS1003普通物理(一)、PHYS1004普通物理(二)、OPT2006應用電子學(一)",
    "pre_sub_id3": "PHYS1003",
    "pre_sub_ename": "PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)、OPT2006 APPLIED ELECTRONICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠描述及推演及OP-AMP的基本原理",
      "describe_en": "Be able to describe and derive the basic theory of OP-AMP device."
    },
    {
      "seq": 2,
      "describe_ch": "能理解OP-AMP IC與分立式元件所組成的放大器之差異，並了解其頻率響應及功率放大運用上的限制。",
      "describe_en": "Be able to understanding the difference between OP-AMP IC and discrete device circuit，and realize the application limit about frequency response and power amplifier application."
    },
    {
      "seq": 3,
      "describe_ch": "能知悉電子技術對環境、社會及全球影響的議題。",
      "describe_en": "Be able to understanding the Global environment influence of new Electronic technology."
    },
    {
      "seq": 4,
      "describe_ch": "透過分組作業培養團隊合作精神及有效溝通能力。",
      "describe_en": "To develop team spirit and the ability of efficient communication through teamwork."
    }
  ],
