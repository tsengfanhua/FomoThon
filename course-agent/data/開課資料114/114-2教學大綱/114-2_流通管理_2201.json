    "sub_name": "流通管理",
    "sub_ename": "LOGISTICS & DISTRIUTION CHANNELS MANAGEMENT",
    "describe_ch": "本課程旨在讓學生明瞭流通管理的相關理論與重要性念，並藉由案例分享讓學生了解企業界實際應用的現況。",
    "describe_eh": "AThe purpose of this course to introduce basic concept and importance for distribution management to make students understand. To make students be able to explain the importance and effects of distribution management to business activities. By the end of the semester, students should be able to understand real-life cases in an enterprise.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解並應用流通管理在商業活動的重要性與影響。",
      "describe_en": "Understand and be able to apply the importance and effects of distribution management to business activities."
    },
    {
      "seq": 2,
      "describe_ch": "能以書面和口頭方式將實際案例分析結果與同學、老師分享。",
      "describe_en": "Communicate real-life cases of analyzing results in written and oral form to classmates and teacher."
    }
