  "description": {
    "sub_id3": null,
    "sub_name": "流體力學(一)",
    "sub_ename": "FLUID MECHANICS(1)",
    "describe_ch": "從流體之特性談起，論述流體靜力學、流體運動學及流體動力學之基本理論，並探討流體力學在管流、明渠流與流體機械之設計與應用。流體力學在環境工程、土木、水利工程、甚至工業製程中應用甚廣，請用心研習。",
    "describe_eh": "Starting from the fluid properties, the class mentions the basic theory of fluid statics, fluid kinematics and fluid dynamics, and their application on pipe flow, open channel flow and fluid machines, and their engineering design.",
    "pre_subname": "MATH1001微積分(一)、PHYS1003普通物理(一)、ENGS1003工程圖學(一)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、PHYS1003 GENERAL PHYSICS(1)、ENGS1003 ENGINEERING GRAPHICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得流體力學的基本概念",
      "describe_en": "To obtain the basic concepts of fluid mechanics　"
    },
    {
      "seq": 2,
      "describe_ch": "應用流體力學公式與圖表工具於管流,明渠流等工程系統之設計與動力計算　",
      "describe_en": "應用流體力學公式與圖表工具於管流,明渠流等工程系統之設計與動力計算　"
    },
    {
      "seq": 3,
      "describe_ch": "分析、構思與解決流體力學問題",
      "describe_en": "To analyze and identify key point in solving fluid mechanic problems.　"
    }
  ],
