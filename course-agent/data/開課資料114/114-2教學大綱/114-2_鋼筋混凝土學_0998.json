  "description": {
    "sub_id3": null,
    "sub_name": "鋼筋混凝土學",
    "sub_ename": "REINFORCED CONCRETE",
    "describe_ch": "介紹鋼筋混凝土構件行為及分析設計之完整理論，並配合最新ACI及我國建築技術規則之設計規範規定，講解鋼筋混凝土構件之分析與設計實例。",
    "describe_eh": "behavior, analysis and design method of reinforced concrete members are introduced. Some practical structural members are analyzed and designed in accordance with rules prescribed by the newest ACI design code and ROC building code.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解鋼筋混凝土的特性\n",
      "describe_en": "1、 To understand the mechanical properties of reinforced concrete."
    },
    {
      "seq": 2,
      "describe_ch": "學習鋼筋混凝土的設計方法與規範\n",
      "describe_en": "2. To learn the design method of reinforced concrete and to know the design code."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉鋼筋混凝土構件的分析與設計",
      "describe_en": "3、 To know the analysis and design  of reinforced concrete members."
    }
  ],
