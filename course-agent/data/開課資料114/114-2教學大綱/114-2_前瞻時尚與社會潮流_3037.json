  "description": {
    "sub_id3": null,
    "sub_name": "前瞻時尚與社會潮流",
    "sub_ename": "FORWARD LOOKING, FASHION AND SOCIAL TRENDS",
    "describe_ch": "時尚與潮流瞬息萬變，倘若能抓住且看見時尚與潮流之細節，便能掌握著無限商機。本課程將透過大量的時尚潮流案例分析，並且抓其細節與重點同時與過往年份之潮流進行交叉分析，協助同學建立前瞻性思考方向及邏輯。",
    "describe_eh": "Fashion and trends are changing rapidly. If you can grasp and see the details of fashion and trends, you can grasp the unlimited business opportunities.\nThis course will analyze the situation of a large number of fashion trends, and grasp the details and key points and cross-analysis with the trend of the past years to help students establish forward thinking and logic.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過邏輯協助同學根據可能之下一潮流重點尋找商機",
      "describe_en": " Assisting students in logic to find business opportunities based on potential trends"
    },
    {
      "seq": 2,
      "describe_ch": "透過全英文報告以及師生對談，培養國際化之發表能力",
      "describe_en": "Develop presentation skills in English reports and teacher-student dialogues"
    }
  ],
