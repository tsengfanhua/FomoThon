  "description": {
    "sub_id3": null,
    "sub_name": "特殊合金",
    "sub_ename": "SPECIALTY ALLOY",
    "describe_ch": "在工業上被廣泛使用的特殊合金主要包括不銹鋼、超合金、鋁合金、及鎂合金，本課程將針對這些特殊合金之合金設計、分類、製造方法、性能、及應用做詳盡的介紹。此外，學生亦將分組進行專題報告。",
    "describe_eh": "Specialty alloys including stainless steals, super alloys, aluminum alloys, and magnesium alloys are used widely in industry. The alloy design, classifications, manufactures, properties, and applications will be introduced in detail in this course. In addition, all students will do paper report in group.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "識別不♫鋼、超合金、鋁合金、及鎂合金的分類。",
      "describe_en": "Identify the classification of stainless steals, super alloys, aluminum alloys, and magnesium alloys."
    },
    {
      "seq": 2,
      "describe_ch": "了解不♫鋼、超合金、鋁合金、及鎂合金的性質和用途。",
      "describe_en": "Comprehend the properties and applications of stainless steals, super alloys, aluminum alloys, and magnesium alloys."
    },
    {
      "seq": 3,
      "describe_ch": "藉由小組討論與報告，建立文獻蒐集、溝通、判斷、與總結能力。",
      "describe_en": "Build up the abilities at paper search, communication, determination, and summary through group discussion and report."
    }
  ],
