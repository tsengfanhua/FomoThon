  "description": {
    "sub_id3": null,
    "sub_name": "混凝土品質控制",
    "sub_ename": "QUALITY CONTROL OF CONCRETE",
    "describe_ch": "本課程介紹有關建築結構混凝土品質控制及管理之觀念，並配合內政部建築技術規則及美國混凝土學會ACI 318-95 Building Code、ACI 301-72及ACI 214品質管理觀念，使學生能夠了解混凝土材料品管及品保的觀念。",
    "describe_eh": "Introduce the concept of quality control and management of concrete and cooperate with the Construction Technical Code, ACI 318-95 Building Code, ACI 301-72, ACI 214 Code, to make them realize the quality control and management of concrete materials.",
    "pre_subname": "CEM2090工程材料",
    "pre_sub_id3": "CEM2090",
    "pre_sub_ename": "CEM2090 ENGINEERING MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解混凝土材料之品質管制。",
      "describe_en": "Comprehension for the quality control and management of concrete materials."
    },
    {
      "seq": 2,
      "describe_ch": "能理解新拌混凝土的性質、品質管制及配比設計。",
      "describe_en": "Be able to understand the properties, quality control and management and concrete mixture proportioning design of fresh concrete."
    },
    {
      "seq": 3,
      "describe_ch": "能理解硬固混凝土的性質及品質管制。",
      "describe_en": "Be able to understand the properties, quality control and management of hardened concrete."
    },
    {
      "seq": 4,
      "describe_ch": "能知道混凝土之施工及檢驗。",
      "describe_en": "Comprehension for the construction and test of concrete."
    }
  ],
