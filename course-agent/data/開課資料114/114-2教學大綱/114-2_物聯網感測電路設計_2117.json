  "description": {
    "sub_id3": null,
    "sub_name": "物聯網感測電路設計",
    "sub_ename": "SENSOR INTERFACE CIRCUIT DESIGN FOR INTERNET OF THINGS APPLICATIONS",
    "describe_ch": "本課程主要目的在於介紹物聯網常使用之感測器介面電路，內容包含介紹感測器介面電路之基本知識與原理，以及感測器介面電路分析設計方法。並進一步介紹感測器電路整合於無線晶片形成無線感測模組之方法。",
    "describe_eh": "This course will introduce the sensor interface circuit for internet of things applications. The course includes basic knowledge of the sensor interface circuits, and analysis and design methods of the circuits. Moreover, the sensor interface circuits integrated with wireless communication module are introduced.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉各種感測器元件感測原理。",
      "describe_en": "Familiar with the sensing principles of various sensor elements"
    },
    {
      "seq": 2,
      "describe_ch": "了解各種感測讀取電路的原理與分析方法，與應用各類感測器於物聯網情境。",
      "describe_en": "Understand the principles and analysis methods of various sensing and reading circuits, and apply various sensors to the IoT."
    }
  ],
