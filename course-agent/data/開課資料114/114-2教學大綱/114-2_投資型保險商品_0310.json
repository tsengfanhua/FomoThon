  "description": {
    "sub_id3": null,
    "sub_name": "投資型保險商品",
    "sub_ename": "INVESTMENT -ORIENTED INSURANCE PRODUCT",
    "describe_ch": "課程將介紹保險商品理論及實務的運用，並針對金融市場、投資學、及債券、證券的評價作分析與介紹，課程內容結合市場各保險公司推出的投資型保險及連結績效分析並搭配同學訪談保險從業人員實際銷售投資型保險經驗與銷售實務，透過課程安排結合理論與壽險市場實務狀況，讓同學能加深對這門課能有更深入了解。",
    "describe_eh": "The course will introduce the application of insurance commodity theory and practice, and for the financial market, investment, and bonds, securities evaluation analysis and introduction, the course content combined with the market insurance companies launched investment-type insurance and linked performance analysis and with students interview insurance practitioners actually sell investment-oriented insurance experience and sales practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解投資保險實務的操作",
      "describe_en": "Understand the practical operation in investment and insurance."
    },
    {
      "seq": 2,
      "describe_ch": "能分析投資型保單績效",
      "describe_en": "Enable to analyze the performance of investment-type insurance products."
    }
