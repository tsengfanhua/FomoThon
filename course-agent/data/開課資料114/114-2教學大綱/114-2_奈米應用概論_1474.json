  "description": {
    "sub_id3": null,
    "sub_name": "奈米應用概論",
    "sub_ename": "INTRODUCTION TO NANO APPLICATION",
    "describe_ch": "陳述奈米科技原理、製作技術與應用產品。能概述應用於微電子、能源及光電、生技及環境等領域之奈米技術。實施案例說明與問題討論。",
    "describe_eh": "Present the various electronic materials and the application for semiconductor, electronic device and the integrated circuits (IC) system. Case studies are also explained and discussed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知道奈米應用導論中，光觸媒、單電子電晶體、奈米記憶晶片、奈米碳管量子電腦。",
      "describe_en": "To know introduction to Nanotechnology Application, photocatalyst, single electron transistor, nano memory chip, carbon nano tube and guantum computer."
    },
    {
      "seq": 2,
      "describe_ch": "能知道奈米生物醫學、奈米機器人、生醫晶片、電腦斷層掃描、核磁共振影像。",
      "describe_en": "To know nano biomedicine, nano robot and biomedical chip, computer tomography, nuclear magnetic resonance imaging"
    },
    {
      "seq": 3,
      "describe_ch": "能理解燃料電池的分類與應用，鋰離子電池、儲能元件、仿生科技。\tC2",
      "describe_en": "\tTo comprehend fuel cell clasification and application, lithium ion battery, energy storage device, biomirnetics."
    },
    {
      "seq": 4,
      "describe_ch": "能知道奈米科技在傳統產業的應用，顏料、染料、塑膠、橡膠、電子封裝。",
      "describe_en": "To know nanotechnology application in traditional industry; pigment, dye, rubber, plastics and electronic package."
    }
  ],
