  "description": {
    "sub_id3": null,
    "sub_name": "非破壞檢測概論",
    "sub_ename": "INTRODUCTION OF NONDESTRUCTIVE TESTING",
    "describe_ch": "介紹土木工程範疇中常用到之非破壞檢測技術的基本原理、試驗設備以及工程應用，除了加強土木人對於非破壞檢測新科技有全面性的瞭解，也同時希望藉由一系列之試驗來培養同學之特殊專長。",
    "describe_eh": "This course introduces students the basic principle, testing equipment, and their application of some nondestructive testing techniques daily-used in civil engineering practice. This course not only focuses on strengthening civil engineers' overall understanding over the newly-developed nondestructive techniques, but also on developing students' specialty through a series laboratory and field tests.",
    "pre_subname": "CE1001應用力學、CEM2008材料力學",
    "pre_sub_id3": "CE1001",
    "pre_sub_ename": "CE1001 APPLIED MECHANICS、CEM2008 MECHANICS OF MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得各種常見之非破壞檢測技術相關的知識及其應用",
      "describe_en": "Obtain the knowledge of various nondestructive testing techniques and their corresponding applications"
    },
    {
      "seq": 2,
      "describe_ch": "能初步分析與解釋實驗結果",
      "describe_en": "Be able to perform preliminary analysis and make interpretation of experimental results"
    },
    {
      "seq": 3,
      "describe_ch": "獲得撰寫專業報告初等能力的知識",
      "describe_en": "Obtain the knowledge of writing an elementary professional report"
    }
  ],
