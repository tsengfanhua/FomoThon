  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CH00101",
    "sub_id": "50342",
    "scr_dup": "002",
    "sub_title": "生成式人工智慧之提示語不同層次應用與AI數位創作。",
    "sub_title_en": null,
    "sub_describe": "1.透過關鍵語詞精準引導 AI，系統化掌握提示語的結構與應用，並熟悉各類生成式 AI 軟體工具。\n2.運用 SCAMPER 法進行專題規劃與實作，透過問題解決與創意設計，開展具創新性的生成式 AI 數位創作。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "提示語工程與AI數位創作",
    "sub_ename": "PROMPTS ENGINEERING AND AI DIGITAL CREATION",
    "describe_ch": "「提示語工程」（Prompt Engineering）是利用自然語言來引導AI生成人們期望的結果的一種新型人機溝通技術，涵蓋了規劃、提示、生成和評估等階段。課程前半部分從基礎到創新介紹提示語工程的不同層次及使用技巧；接著，介紹常見的提示語AI工具；最後，探討如何運用提示語與不同的AI工具合作，創造獨特的AI數位作品。",
    "describe_eh": "\"Prompt Engineering\" is a novel human-computer interaction technique using natural language to guide AI towards desired outcomes, encompassing planning, prompting, generation, and evaluation. The course covers prompt engineering basics to advanced techniques, introduces common AI tools, and explores creating unique digital works with AI collaborations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養人文與科技之跨域融合的STEAM能力",
      "describe_en": "Cultivating the STEAM capabilities of interdisciplinary integration between humanities and technology."
    },
    {
      "seq": 2,
      "describe_ch": "能產生具有人文價值之AI創新應用方案",
      "describe_en": "Generating AI innovation applications with value in the humanities."
    }
