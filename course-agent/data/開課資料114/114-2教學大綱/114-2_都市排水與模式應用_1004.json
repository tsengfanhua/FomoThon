  "description": {
    "sub_id3": null,
    "sub_name": "都市排水與模式應用",
    "sub_ename": "URBAN DRAINAGE THEORY AND MODEL APPLICATION",
    "describe_ch": "面對氣候變遷和都市快速開發的挑戰，都市排水已由依賴雨水下水道系統轉為逕流分擔的方式。本課程延續水文學對於水文循環中各項定義，以海綿城市和排水計畫書為授課主軸，並學習操作US的 EPA SWMM模式，建置都市排水系統和各項低衝擊開發單元，並由模式中的各項輸出結果了解所規劃之排水方案對逕流量和洪峰量的影響。",
    "describe_eh": " Rapid urbanization and global climate change challenge the stormwater drainage capacity.  This modern urban drainage system doesn’t only depend on sewers but runoff apportion. Hydraulic cycle, catchment basin, sponge city, and drainage planning for lands development will be the primary contents in this course. The LID (low impact development) units and drainage system would be built in USEPA SWMM; and the runoff apportion and flood peak reduction from SWMM model needs to be processed and evaluated.",
    "pre_subname": "HY1005水文學、HY3010明渠水力學、HY3014明渠水力學",
    "pre_sub_id3": "HY1005",
    "pre_sub_ename": "HY1005 HYDROLOGY、HY3010 OPEN CHANNEL HYDRAULICS、HY3014 OPEN CHANNEL HYDRAULICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解台灣出流管制計畫書之意義和相關法規",
      "describe_en": "\tUnderstand the legislations and contents of the Outflow Control Plan"
    },
    {
      "seq": 2,
      "describe_ch": "應用SWMM模式於都市排水設計的操作模式\t",
      "describe_en": "Apply SWMM model to urban drainage system design"
    },
    {
      "seq": 3,
      "describe_ch": "分析都市排水系統方案的可行性\t",
      "describe_en": "Analyze the feasibility of urban drainage system alternatives"
    },
    {
      "seq": 4,
      "describe_ch": "撰寫出流管制計畫書內排水衝擊因應策略\t",
      "describe_en": "Compose the flood mitigation strategies of the Outflow Control Plan"
    }
  ],
