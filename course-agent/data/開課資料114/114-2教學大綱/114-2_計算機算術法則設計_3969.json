    {
      "seq": 1,
      "describe_ch": "設計計算機算術電路依據計算機算術法則。\t",
      "describe_en": "Design the computer arithmetic circuits according  to the computer arithmetic algorithms."
    },
    {
      "seq": 2,
      "describe_ch": "評鑑整體成效藉由閱讀相關期刊並口頭報告。",
      "describe_en": "Evaluate the total effects by paper reading and oral reporting.\t"
    }
