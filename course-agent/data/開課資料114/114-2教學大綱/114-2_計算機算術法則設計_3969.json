  "description": {
    "sub_id3": null,
    "sub_name": "計算機算術法則設計",
    "sub_ename": "DESIGN OF COMPUTER ARITHMETIC ALGORITHM",
    "describe_ch": "本課程適合電機電子領域研究所一年級程度。邏輯設計觀念為必備。本課程主要目的為使學生?解高性能之計算機系統，在執行算術運算時所使用的基本法則原理。課程包含高速非浮點運算與浮點運算之加法器、減法器、乘法器、除法器，以及更複雜之開方器、指數、對數、三角函數之設計技巧。\n\n",
    "describe_eh": "This course is suitable for first-year graduate students in electrical engineering. A minimum background in basic logic design is assumed. The goal of this course is to explain the fundamental principles of algorithms available for performing arithmetic operations in modern digital computer systems. These include basic arithmetic operations and more complex operations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
