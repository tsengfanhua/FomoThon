  "description": {
    "sub_id3": null,
    "sub_name": "高頻及微波電路實習",
    "sub_ename": "EXPERIMENT TO RADIO FREQUENCY AND MICROWAVE CIRCUIT",
    "describe_ch": "高頻及微波電路是無線通訊系統的關鍵技術之一，本課程主要在介紹微波電路之原理與製作，包括：匹配網路、低雜訊放大器、濾波器等，並提供相關的微波電路模擬軟體教學與實習，如ADS、AppCAD、IE3D等。",
    "describe_eh": "Microwave circuit is one of the key technologies of wireless communications. The theories and experiments of microwave circuit, such as matching network, low noise amplifier, filter, will be introduced and proceed in this course. Students will also learn and practice on the microwave circuit simulation tools, including ADS, AppCAD, and IE3D, etc.",
    "pre_subname": "COME2002電子學(一)、COME2010電磁學(一)、COME3005高頻及微波電路概論",
    "pre_sub_id3": "COME2002",
    "pre_sub_ename": "COME2002 ELECTRONICS(1)、COME2010 ELECTROMAGNETICS(1)、COME3005 INTRODUCTION TO RADIO FREQUENCY AND MICROWAVE CIRCUIT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用電子電路的理論, 完成高頻電路之設計與製作",
      "describe_en": "Be able to apply electronic circuit theory so as to achieve RF circuit design and implementation.　"
    },
    {
      "seq": 2,
      "describe_ch": "能運用模擬軟體進行高頻及微波電路的分析。　",
      "describe_en": "Be able to use simulation tool to analyze radio frequency and microwave circuits."
    }
  ],
