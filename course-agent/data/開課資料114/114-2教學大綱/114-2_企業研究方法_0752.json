  "description": {
    "sub_id3": null,
    "sub_name": "企業研究方法",
    "sub_ename": "BUSINESS RESEARCH METHODOLOGY",
    "describe_ch": "本課程是企管研究領域的基礎課程，透過教師課程講授、研究論文研討、上機實習、及進行研究報告等方法，培養修課同學研究方法的基本觀念、知識及技能，以建立學生企業管理領域研究的基本觀念、知識及技能。",
    "describe_eh": "This course is an introductory course in the field of business research. Through lectures, seminar paper research, computer practice, reports, etc., students will develop basic concepts, knowledge, and skills in research methods in business management to establish fundamental concepts, knowledge, and skills for research.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "研究方法是所有科學學術與實證研究的基礎，本課程旨在引介與闡述從事企業研究的基本方法與原則，從研究法的基本概念為始，進而介紹研究設計的方法、資料蒐集、分析與表達，完成論文寫作的主要步驟，藉由論文評析提升對方法論的瞭解，同時詳細操演常用的統計軟體（Excel、SPSS），以便建立研究方法論的理論基礎與其運用。",
      "describe_en": "a"
    }
  ],
