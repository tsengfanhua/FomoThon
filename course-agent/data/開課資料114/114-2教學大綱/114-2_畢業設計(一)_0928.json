  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備應用土木工程知識於相關設計之能力。",
      "describe_en": "Possess ability to apply knowledge of civil engineering in related design."
    },
    {
      "seq": 2,
      "describe_ch": "具備解決設計或研究所遭遇問題的能力。",
      "describe_en": "Possess ability to resolve the problems encountered in design or research."
    },
    {
      "seq": 3,
      "describe_ch": "具備採用模型或圖文展現成果，並進行口頭報告之能力。",
      "describe_en": "Possess ability to employ model, or diagram and text, as well as oral report to demonstrate the end product."
    }
  ],
