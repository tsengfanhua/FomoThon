  "description": {
    "sub_id3": null,
    "sub_name": "普通物理實驗(二)",
    "sub_ename": "GENERAL PHYSICS LAB.(2)",
    "describe_ch": "普通物理實驗(二) 共安排12項實驗，包含電學、磁學與光學之實驗，也介紹兩項基礎測量工具：三用電表與示波器。在此課程中訓練學生動手操作儀器，及整理數據、分析數據的能力。藉由高科技產品-智慧型手機和SLM(光空間調制器)的使用，讓學生在動手做這些實驗時能提高學習興趣。",
    "describe_eh": "In General Physics Experiment (2), a total of 12 experiments are arranged. This course includes the topics of electricity, magnetism, and optics. The course also introduces two fundamental measuring tools required in electromagnetism. The students will be trained to operate the instrument, and the ability to organize and analyze the data. When high-tech products - smartphones and SLM are used, students can improve their interest in doing these experiments.",
    "pre_subname": "PHYS1003普通物理(一)、PHYS1001普通物理實驗(一)",
    "pre_sub_id3": "PHYS1003",
    "pre_sub_ename": "PHYS1003 GENERAL PHYSICS(1)、PHYS1001 GENERAL PHYSICS LAB.(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉科學探究方法，並體會科學精神。",
      "describe_en": "Be familiar with scientific enquiry methods, and comprehend the culture of scientific society."
    },
    {
      "seq": 2,
      "describe_ch": "配合普通物理(二)課程，親身體驗所學之電學，磁學與光學原理。",
      "describe_en": "Experience the phenomena of electricity, magnetism and optics discussed in general physics (2) course"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解基礎測量工具之原理，並能正確使用基礎測量工具。",
      "describe_en": "Understand the principle of basic instruments and be able to operate them correctly."
    },
    {
      "seq": 4,
      "describe_ch": "能夠應用電腦處理實驗數據。",
      "describe_en": "Be able to use computer to organize and to analysis the experimental data"
    },
    {
      "seq": 5,
      "describe_ch": "能執行使用光、電相關技術之實驗。",
      "describe_en": "Be able to perform experiments employing optical or electronic technique."
    }
  ],
