  "description": {
    "sub_id3": null,
    "sub_name": "天線原理",
    "sub_ename": "ANTENNA THEORY",
    "describe_ch": "提供電波學程學生深入探討天線系統的基本原理及工程應用，從設計到量測以及各種應用實務，課程從基礎的電磁理論及物理現象開始介紹集成為波動方程式，系列數學模式建立，基礎傳輸線模型直至於建立各型天線的模型，電磁輻射場的形成，傳播模式，不同材料設計的特性與現象，以及發展趨勢、大型天線系統、陣列天線到最新的AESA雷達等實際應用。",
    "describe_eh": "The objective of this course is to further research the fundamental theory and design engineering applications of Antennas for study in microwave field students. The basic electromagnetic theory, physical phenomenon and mathematic model will be introduced. And discuss a variety of antennas radiation pattern forming, propagation modes, and the characteristic and phenomenon in different material. Last, explain the large antenna system, array and modern AESE radar in practice applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解並說明馬克斯威爾方程式及電磁波的產生、傳輸線理論及模型，推導輸入阻抗、特性組抗、反射係數、傳輸係數、電壓駐波比及材料與波速關係。",
      "describe_en": "Be able to understand Maxwell equation and the relationship with EM wave, and modeling of transmission line. Be able to derive the Zin, Zo, Γ,Τ,VSWR and velocity with different materials."
    },
    {
      "seq": 2,
      "describe_ch": "能了解天線基本理論及模型，各式基本天線特性，包括增益、場形、極化及各參數意義。",
      "describe_en": "Understand theory and modeling of antenna, include antenna gain, pattern, polarization, and understand the define of different parameters."
    }
  ],
