  "description": {
    "sub_id3": null,
    "sub_name": "書報討論(二)",
    "sub_ename": "LITERATURE SURVEY (2)",
    "describe_ch": "以口頭發表之方式訓練學生能夠於台上報告專業論文研究，並互相討論。帶領研究生了解各種儀器分析設備之原理與測試方法，進而能夠應用於紡織工程之領域，提昇學生之研究水準。",
    "describe_eh": "Training students with an oral presentation for reporting a professional research and discuss it thereafter. Lead the graduate students to understand the principle and the test method of various analysis instruments, and further applied in the field of textile engineering for improving the quality of research.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "訓練學生資料蒐集的能力",
      "describe_en": "promoting the ability of reference search"
    },
    {
      "seq": 2,
      "describe_ch": "使學生瞭解國際相關研究的現況",
      "describe_en": "Make student realize the recent state of international related researches."
    },
    {
      "seq": 3,
      "describe_ch": "使學生藉由討論方式，增進專業知識的了解與發問能力。",
      "describe_en": "promoting the professional knowledge and questioning ability through discussion."
    },
    {
      "seq": 4,
      "describe_ch": "藉由彼此間的觀摩學習，增進學習的樂趣。",
      "describe_en": "promoting the learning joy through imitation of learning each other."
    }
  ],
