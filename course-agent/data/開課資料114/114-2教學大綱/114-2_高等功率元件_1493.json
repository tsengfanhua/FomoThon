  "description": {
    "sub_id3": null,
    "sub_name": "高等功率元件",
    "sub_ename": "ADVANCED POWER DEVICES",
    "describe_ch": "教導學生對高功率元件的認識及如何設計功率半導體元件，從高耐壓設計包含元件主體與元件終止區設計的不同，讓學生學習到各類功率元件特性及設計手法及針對某一特性可以提出的改善架構，並學習超接面概念與酖急性與雙極性元件合併的特性。",
    "describe_eh": "Teach student to know the high Power Devices and how to design them. Students can hearn how to design a high breakdown device in semiconductor material at main die and termination area. The super junction concept will also be introduced in this class.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道各類功率元件的高耐壓及大電流的原理。",
      "describe_en": "Knowledge for the theory of how to support high voltahe and high current for all kinds of Power devices."
    },
    {
      "seq": 2,
      "describe_ch": "理解各類功率元件的設計方式。",
      "describe_en": "To comprehend how to design all kinds of Power devices."
    },
    {
      "seq": 3,
      "describe_ch": "應用各類功率元件於電力電子系統上時須注意的元件特性。",
      "describe_en": "To apply Power devices using in power electronics systems need to take care of some devices characteristics."
    }
  ],
