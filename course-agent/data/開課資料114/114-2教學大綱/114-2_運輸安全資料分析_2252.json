  "description": {
    "sub_id3": null,
    "sub_name": "運輸安全資料分析",
    "sub_ename": "TRANSPORTATION SAFETY DATA AND ANALYSIS",
    "describe_ch": "本課程以透過運輸安全資料蒐集、清洗、分析與應用的流程，利用資料驅動方式(DataDriven)教導學生從過去事故分析找出時間與空間的問題，並由不同的車種與駕駛人事故，整合天候、道路環境影響因素，進一步研提改善策略。",
    "describe_eh": "This course teaches students to use a data-driven approach to collect, clean, analyze, and apply transportation safety data. By analyzing past accidents, students will learn to identify time and space-related issues, as well as factors such as different vehicle types and driver behavior, and integrate weather and road environmental factors to develop further improvement strategies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
