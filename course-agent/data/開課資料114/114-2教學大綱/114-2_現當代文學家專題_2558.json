  "description": {
    "sub_id3": null,
    "sub_name": "現當代文學家專題",
    "sub_ename": "THE RESEARCH ON MODERN CHINESE WRITERS AND CONTEMPORARY CHINESE WRITERS",
    "describe_ch": "透過細讀現當代中國文學及台灣文學的重要作品，了解現當代重要文學家的寫作風格、代表作、文學觀及藝術表現，以窺見現當代文學史的流變，培養對現當代重要文學家的認識。",
    "describe_eh": "Through attentive reading by important works of Modern Chinese Writers and Contemporary Chinese Writers, the students will understand the styles, masterpieces, literary points and artistic expression, to peek the rheology of literary history of modern Chinese literature and contemporary Chinese literature, and have accomplishment of Modern Chinese Writers and Contemporary Chinese Writers.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
