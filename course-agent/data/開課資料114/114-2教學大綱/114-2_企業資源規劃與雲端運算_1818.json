  "description": {
    "sub_id3": null,
    "sub_name": "企業資源規劃與雲端運算",
    "sub_ename": "ENTERPRISE RESOURCE PLANNING AND CLOUD COMPUTING",
    "describe_ch": "本課程主要探討企業資源規劃系統的整合性應用以及如何因應雲端運算技術的發展與應用來強化組織效益與價值創造。課程將深入探討企業資源規劃（ERP）系統設計、實施和管理，以及雲端運算在企業資源規劃系統的整合應用趨勢。學生將學習如何選擇適合企業需求的ERP系統，並瞭解如何將其整合到現有業務流程中。此外，課程還將介紹雲端運算的基本概念，包括基礎設施即服務（IaaS）、平台即服務（PaaS）和軟體即服務（SaaS），以及它們如何與ERP系統集成以提供更靈活和可擴展的解決方案。透過案例研究和實作項目，學生將能夠掌握在企業環境中成功實施和管理ERP系統以及雲端運算解決方案所需的技能和知識。",
    "describe_eh": "This course focuses on integrating Enterprise Resource Planning (ERP) systems and leveraging cloud computing to enhance organizational efficiency and value creation. It covers ERP system design, implementation, and management, as well as trends in cloud computing integration. Students will learn to select suitable ERP systems and integrate them into existing processes. Furthermore, fundamental cloud computing concepts such as IaaS, PaaS, and SaaS are introduced and demonstrate the integration with ERP for flexible solutions. Through case studies and projects, students gain skills for successful implementation and management of ERP and cloud solutions in enterprises.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養學生對企業資源規劃系統和雲端運算的理解，包括相關概念、技術與產業發展趨勢。",
      "describe_en": "Foster understanding of ERP systems and cloud computing, covering key concepts, technologies, and industry trends."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生掌握企業資源規劃系統和雲端運算的實務應用技能，包括系統設計、實施和管理等技能。",
      "describe_en": "Develop practical skills in ERP systems and cloud computing, including design, implementation, and management."
    },
    {
      "seq": 3,
      "describe_ch": "引導學生了解企業資源規劃和雲端運算相關領域研究議題，並具備整合理論與實務的問題解決能力。",
      "describe_en": "Guide students to grasp research topics in ERP and cloud computing and cultivate integrated problem-solving abilities."
    }
  ],
