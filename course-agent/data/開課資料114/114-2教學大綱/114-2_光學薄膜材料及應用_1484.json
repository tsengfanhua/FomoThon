  "description": {
    "sub_id3": null,
    "sub_name": "光學薄膜材料及應用",
    "sub_ename": "MATERIALS AND APPLICATIONS OF OPTICAL THIN FILMS.",
    "describe_ch": "光學薄膜係指運用於純光學或光電等領域之薄膜，例如利用薄膜的光學特性，可以形成抗反射膜、濾光膜，利用半導體的光學特性，製造發光二極體、光的感測器，運用層面廣泛。課程內容：半導體光學；波動與量子光學回顧；代表性光學薄膜之製造與運用(如ITO、感光元件、發光元件)。\n",
    "describe_eh": "Optical film means the film used in pure optics or photoelectricity fields, e.g. to utilize the optical characteristics of the film to generate the antireflection coating and filter coating and to utilize the optical characteristics of semiconductor to fabricate light emitting diodes (LED) and optical sensor, with a wide application range. Course content: semiconductor optics, review on wave and quantum optics; fabrication and application of representative optical film.\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解材料的波動與量子光學的知識。",
      "describe_en": "To able to understand the knowledge about material wave and quantum optics."
    },
    {
      "seq": 2,
      "describe_ch": "具備瞭解當代光學電子薄膜新科技的應用能力。",
      "describe_en": "Be able to understand the new technologies of modern photoelectric film."
    }
  ],
