  "description": {
    "sub_id3": null,
    "sub_name": "契約與規範",
    "sub_ename": "CONTRACTS & SPECIFICATIONS OF ENGINEERING",
    "describe_ch": "工程契約與規範是每一個工程專案執行的依據，尤其在判定法律責任或解決爭議時，均應回歸到契約內容的解釋與範圍。因此，專業工程人員對於工程法律與契約規範必須有基本的認識，才能符合專案的要求，預防爭議發生。\r\n本課程主要在講授工程法律與契約規範之基本內容，並透過案例的探討，分析工程專案常見的法律問題，以補強專案人員對於工程法律之專業知識，提昇契約管理之能力。\r\n",
    "describe_eh": "The goal of this course is to encourage students to think independently and develop ability in organizing facts, finding issues and solving problems via analyzing and discussing cases of construction legal disputes.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "訓練管理工程契約之能力",
      "describe_en": "To develop ability of contract management."
    },
    {
      "seq": 2,
      "describe_ch": "認識常見工程爭議，並培養分析個案爭點之能力",
      "describe_en": "To identify major disputes of construction contracts and develop ability to analyze issues of individual cases."
    },
    {
      "seq": 3,
      "describe_ch": "透過爭議報告之撰寫，訓練處理工程爭議之能力",
      "describe_en": "To increase ability to deal with construction disputes."
    }
  ],
