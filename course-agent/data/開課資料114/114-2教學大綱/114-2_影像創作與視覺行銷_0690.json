    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB26119",
    "sub_id": "67987",
    "scr_dup": "001",
    "sub_title": "探究Ai賦能與影像創作應用於視覺行銷範疇",
    "sub_title_en": "Explore the application of AI empowerment and image creation in the field of visual merchandising",
    "sub_describe": "熟悉影像攝影美學基礎，應用Ai賦能於美學設計創造準確高效率之視覺行銷。",
    "sub_describe_en": "Familiar with the aesthetic foundations of video photography, apply AI to empower aesthetic design to create accurate and efficient visual merchandising."
  },
  "description": {
    "sub_id3": null,
    "sub_name": "影像創作與視覺行銷",
    "sub_ename": "IMAGE CREATION AND VISUAL MARKETING",
    "describe_ch": "藉由數位攝錄影器材認識與應用、平面影像攝影技巧、動態影片製作實務等基礎實力之養成，建立學生影像美學創作基礎及熟悉運用，加值產品價值、強化消費者眼球黏著度，創造高行銷績效，迎向數位網路行銷大時代。",
    "describe_eh": "This course aims to help students understand and learn the knowledge of image creation and aesthetics, which can enhance the value of products. This course includes the operation and applications of digital video processing, graphic image photography and videos making.",
    "pre_subname": "",
    "pre_sub_id3": null,
