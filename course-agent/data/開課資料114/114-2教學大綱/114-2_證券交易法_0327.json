  "description": {
    "sub_id3": null,
    "sub_name": "證券交易法",
    "sub_ename": "SECURITIES REGULATION",
    "describe_ch": "證券交易的法令規範研究,證券商成立之要件與法令規範,公開發行公司的法令規範,市場交易秩序維護與懲罰,社會秩序與交易信對經濟發展的影響,以及為護信用所需的必要機制。",
    "describe_eh": "Research the law of security exchange, incloude the set-up of security agent company and maintenance the order of exchange.",
    "pre_subname": "ELAW2005公司及票據法",
    "pre_sub_id3": "ELAW2005",
    "pre_sub_ename": "ELAW2005 COMPANY ACT & NEGOTIABLE INSTRUMENTS ACT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解證券交易法之立法目的及精神",
      "describe_en": "Understand the Legislative Purpose and Principles of Securities and Exchange Law"
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解證券管理法規之發展",
      "describe_en": "Understand the Development of Securities Laws and Regulations"
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解公司治理與證券交易法之關係",
      "describe_en": "Understand the Relation between Corporate Governance and Securities and Exchange Law"
    },
    {
      "seq": 4,
      "describe_ch": "能瞭解證券發行的規範",
      "describe_en": "Understand the Regulations of Issuance of Securities"
    }
  ],
