  "description": {
    "sub_id3": null,
    "sub_name": "程式設計與問題解決",
    "sub_ename": "PROBLEM SOLVING PROGRAMMING",
    "describe_ch": "本課程以介紹各種解題演算法為基礎，以期補強和提升學生的程式設計能力。教學上以實作為主，以大學程式能力檢定(Collegiate Programming Examination, CPE)和國際大學生程式設計競賽(International Collegiate Programming Contest, ICPC)相關題庫做為課程參考。本課程供四下未通過CPE測驗的學生優先選修。",
    "describe_eh": "This course introduces different algorithms for problem solving to enhance students’ coding skills. Taking the CPE/ICPC problem database as references, the course asks students to solve programming problems every week and pass the CPE at the end of the semester. This course is designed for senior students who did not pass CPE.",
    "pre_subname": "IECS2001資料結構、IECS3002計算機演算法",
    "pre_sub_id3": "IECS2001",
    "pre_sub_ename": "IECS2001 DATA STRUCTURE、IECS3002 COMPUTER ALGORITHMS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
