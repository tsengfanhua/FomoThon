  "description": {
    "sub_id3": null,
    "sub_name": "精密系統設計專題實作",
    "sub_ename": "PRECISION SYSTEM DESIGN PROJECT IN PRACTICE",
    "describe_ch": "透過自我創意媒合廠商之實務應用，從產品研發到產品運行的生命週期為載體，讓學生以主動的、實踐的、課程之間有聯繫的方式學習。培養學生的工程實踐和創新實踐的能力,尤其是專案的構思、設計、開發和實施能力,以及較強的自學能力、組織溝通能力和團隊協作能力。",
    "describe_eh": "This course allows students to use their practice of creative to match the companies practical application, from product development to product produce cycle, let students learn in a proactive, practical, and linked way, develop engineering practice and innovative practice ability, especially in project conception, design, development and implementation capacity, And a strong self-learning ability, organizational communication and teamwork skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解精密系統之發展沿革及最新動態。",
      "describe_en": "Understand the evolution and the latest developments of the precision system."
    },
    {
      "seq": 2,
      "describe_ch": "訓練學生利用各種軟體來分析，呈現，與定義工程問題。",
      "describe_en": "To develop the ability of analyzing, expressing, and defining mechanical engineering by using software"
    },
    {
      "seq": 3,
      "describe_ch": "培養設計基礎與解決複雜工程問題之能力",
      "describe_en": "Develop design basis and solve complex engineering problems."
    },
    {
      "seq": 4,
      "describe_ch": "能實際體驗實務之應用面向，並結合現代生活與工業活動。",
      "describe_en": "Can actually experience the practical application, and combination of modern life and industrial activities."
    },
    {
      "seq": 5,
      "describe_ch": "讓學生以實作、組織、推廣、彙整報告方式，對於所獲之技術論文及研發結果與同學、教師及媒合廠商陳述溝通。\t",
      "describe_en": "Enable students to implement, organize, promote, aggregate reporting, describe the completed essay and research results to students, teachers and manufacturers."
    },
    {
      "seq": 6,
      "describe_ch": "訓練學生分工合作、互相討論、整合結果之能力及開發專案的知識及興趣。\t",
      "describe_en": "To develop the ability of peel cooperation, discussion and integration., and  Develop project knowledge and interests developed."
    },
    {
      "seq": 7,
      "describe_ch": "綜合工程之間的相關性或功能性，以整理勾勒出個人生涯之學習成長地圖佈局。",
      "describe_en": "The relevance or functionality of integrated engineering, and list systematically the personal Learning Portfolio."
    }
  ],
