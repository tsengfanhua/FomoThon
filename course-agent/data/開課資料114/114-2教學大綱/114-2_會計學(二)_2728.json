  "description": {
    "sub_id3": null,
    "sub_name": "會計學(二)",
    "sub_ename": "ACCOUNTING(2)",
    "describe_ch": "本課程介紹基本會計原理和概念。 主要議題包括應收賬款、存貨、工廠資產收購和折舊、企業會計、投資、負債、現金流量表和財務報表分析。",
    "describe_eh": "This course introduces basic accounting principle and concepts. The main topics include receivable, inventory, plant assets acquisition and depreciation, corporate accounting, investment, liabilities, statement of cash flows and financial statements analysis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解會計 II 和現代商業財務報表的內容及其局限性。\r\n對應用會計原則情況的理解。",
      "describe_en": "Knowledge for the content of Accounting II and modern business financial statements and their limitations.\r\nComprehension for the application accounting principle situation.　"
    }
  ],
