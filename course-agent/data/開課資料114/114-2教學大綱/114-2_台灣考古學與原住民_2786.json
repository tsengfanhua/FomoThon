    },
    {
      "seq": 2,
      "describe_ch": "理解台灣舊石器及新石器文化",
      "describe_en": "A brief understanding of the Paleolithic culture and the Neolithic Cultures in Taiwan"
    },
    {
      "seq": 3,
      "describe_ch": "具備從人文歷史角度理解台灣環境的能力",
      "describe_en": "Capable of viewing our environment from the perspective of humanties"
    }
  ],
