  "description": {
    "sub_id3": null,
    "sub_name": "人壽保險",
    "sub_ename": "LIFE INSURANCE",
    "describe_ch": "介紹各種人壽保險商品的架構、運作方式以及商品間的差異，這些商品包括定期險、生死合險、終身壽險以及萬能壽險等，除了基本的人身風險管理概念外，牽涉到的議題還包括保險商品的保單條款、費率以及準備金等。",
    "describe_eh": "This course introduces a variety of life insurance products, including term life, endowment, whole life insurance and universal life insurance. This course will elaborate the structures and the differences of these products. In addition to fundamental personal risk management concept, it will also cover insurance clauses, rating and reserving.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能獲悉各種人壽保險商品的差異",
      "describe_en": "To understand the differences among life insurance products."
    },
    {
      "seq": 2,
      "describe_ch": "能理解家庭與個人面對的人身風險",
      "describe_en": "To comprehend personal risk facing the family and the individual"
    },
    {
      "seq": 3,
      "describe_ch": "能應用人壽保險商品在人身風險管理中",
      "describe_en": "To apply life insurance products in personal risk management"
    }
  ],
