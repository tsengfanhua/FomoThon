  "description": {
    "sub_id3": null,
    "sub_name": "智慧製造應用與實作",
    "sub_ename": "APPLICATION AND IMPLEMENTATION OF SMART MANUFACTURING",
    "describe_ch": "俱備智慧製造技術應用的能力，串接機電系智慧製造廊道的各研究室，並運用電腦輔助軟體，學習跨領域的不同技術，訓練學生針對工業界現有製造技術，落實智慧製造精神。",
    "describe_eh": "This course is mainly for students to have the ability to apply smart manufacturing technology. It is connected to the research laboratories of the Smart Manufacturing Corridor of the Department of Mechanical and Computer-Aided Engineering and applies engineering software to learn different technologies across different fields. Train students to have the abilities regarding existing manufacturing technology in the industry, and implements the spirit of smart manufacturing.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "讓學生瞭解智慧製造的基本概念，並應用於現有製造技術。",
      "describe_en": "Train students to understand the basic concepts of smart manufacturing and apply them to existing manufacturing technologies."
    },
    {
      "seq": 2,
      "describe_ch": "應用工程軟體如Solidworks, Inspire分析計算工程問題，提昇設計的能力。",
      "describe_en": "Apply engineering software such as Solidworks, Inspire to analyze and calculate engineering problems and improve design capabilities."
    },
    {
      "seq": 3,
      "describe_ch": "整合機械廊道各研究室、學習跨領域先進技術，培養學生落實智慧製造的能力。",
      "describe_en": "Integrate the research room of the mechanical corridor, learn advanced technologies across fields, and cultivate students' ability to implement intelligent manufacturing."
    },
    {
      "seq": 4,
      "describe_ch": "培育學生處理跨領域工程問題之能力。",
      "describe_en": "Cultivate students' ability to solve cross-domain engineering problems."
    }
  ],
