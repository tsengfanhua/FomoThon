  "description": {
    "sub_id3": null,
    "sub_name": "保險學",
    "sub_ename": "INSURANCE",
    "describe_ch": "本課程講授風險與保險學的基本理論與實務運用。首先介紹風險性質、傳統風險管理與整合型風險管理之發展；再介紹保險制度的基本運作原則及保險監理，最後個別介紹人身保險與非人身保險概論及其個案例證",
    "describe_eh": "Risk and Insurance theory as well as practical are introduced in this course. In the first section including: risk, integrated risk management and its development. In the 2nd section including insurance contract, basic principles and government regulation. Lastly, Life insurane and Non-life insurance are Introduced respectively and comprehensive cases are also illustrated.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生具分析風險及風險管理的基本知識。",
      "describe_en": "enabling student to analyze risk and have  elemental ability to manage risks."
    },
    {
      "seq": 2,
      "describe_ch": "認識保險原理與大數法則，進而奠定未來修習保險專業課程的基礎。",
      "describe_en": "reconizing the relationship btw principles of insurance and the law of large number."
    },
    {
      "seq": 3,
      "describe_ch": "認識保險契約的種類與特性，有助於財務風險管理之工作。",
      "describe_en": "reconizing the characters of insurance contract in order to strengthen the ability of Financial Risk Management jobs."
    },
    {
      "seq": 4,
      "describe_ch": "認識保險業的監督與管理，讓學生正確的認識保險業的社會責任。",
      "describe_en": "understanding the insurance regulations that is necessary for social responsibility."
    }
  ],
