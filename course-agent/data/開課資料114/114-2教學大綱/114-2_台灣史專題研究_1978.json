  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CH19310",
    "sub_id": "11882",
    "scr_dup": "001",
    "sub_title": "台灣史",
    "sub_title_en": null,
    "sub_describe": "透過台灣史發展的歷程，以專題的方式，引導學生進行學習及討論。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "台灣史專題研究",
    "sub_ename": "SEMINAR ON THE HISTORY OF TAIWAN",
    "describe_ch": "本課程目標在讓學生能熟悉台灣歷史發展的相關議題，內容包含從明末海上世界的發展，荷蘭、西班牙人的入據台灣，清代以來台灣歷史發展的諸般面貌，日治時期台灣社會的蛻變，以及戰後台灣的發展，至現代世界霸權崛起下的台灣等諸多議題，藉以勾勒並討論台灣歷史發展下的特質。",
    "describe_eh": "This seminar shall focus on the study of the history of Taiwan.  The main concern of this seminar are to introduce the development of the sea area in the southern Asia in the begaining. And according the occupation of the different authority in Taiwan to discuss the historical issues during 17 to 21century in Taiwan.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "達成學生瞭解此一課題的相關學術背景",
      "describe_en": "This course shall help the students understanding the background of the learning of this field."
    },
    {
      "seq": 2,
      "describe_ch": "培養對此專題的批判及反省能力",
      "describe_en": "This course shall train the students to have the ability of criticizing and reflecting."
    },
    {
      "seq": 3,
      "describe_ch": "培養論文寫作能力及邏輯推理能力",
      "describe_en": "This course shall help the students to have the ability of writing and   reasoning."
    }
  ],
