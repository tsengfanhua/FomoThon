  "description": {
    "sub_id3": null,
    "sub_name": "先進半導體設備技術概論",
    "sub_ename": "INTRODUCTION OF ADVANCED SEMICONDUCTOR EQUIPMENT TECHNOLOGY",
    "describe_ch": "陳述先進半導體設備的功能用途、操作及技術原理，如先進微影曝光設備、蝕刻、奈米薄膜沉積等機台以及後段製程設備等等。能概述應用於半導體、電子元件與積體電路的製作及設備技術，實施案例說明與問題討論。",
    "describe_eh": "This course describes the advanced semiconductor equipment of integrated circuits (devices or thin films) manufacturing process. It includes the advanced lithography, etching, and thin film deposition equipment. Some special topics and examples of advanced semiconductor equipment will be discussed and explained.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知悉先進半導體設備的功用與目的",
      "describe_en": "To know the purpose and function of the advanced semiconductor equipment of the semiconductor fabrication process."
    },
    {
      "seq": 2,
      "describe_ch": "能了解先進半導體設備在半導體製程的應用與技術概況",
      "describe_en": "To understand the application and technology of the advanced semiconductor equipment of the semiconductor fabrication process."
    }
  ],
