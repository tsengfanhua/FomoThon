  "description": {
    "sub_id3": null,
    "sub_name": "機率與統計",
    "sub_ename": "PROBABILITY AND STATISTICS",
    "describe_ch": "機率與統計是在工程與科學領域重要的基礎課程。本課程首先將幫助修課學生建立機率與統計的基本概念，藉由介紹機率學的隨機變數、多種離散與連續的機率分佈及隨機變數的函數等重要概念，連結統計學上基本抽樣分佈與資料敘述、單樣本與多樣本的推定方法及單樣本與多樣本的假定檢驗的使用。",
    "describe_eh": "Probability and statistics are very important and basic in science and engineering. The course contents include following parts: the concept of probability and statistics, random variables, distribution functions of random variables, functions of random variables, fundamental sampling distributions and data descriptions, one- and two-sample estimation problems, one- and two-sample hypothesis tests",
    "pre_subname": "CEM1006微積分、IECS2007離散數學",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS、IECS2007 DISCRETE MATHEMATICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解隨機變數、多種離散與連續的機率分佈及隨機變數的函數等重要機率概念",
      "describe_en": "To know the concept of probability and statistics, random variables, distribution functions of random variables, functions of random variables"
    },
    {
      "seq": 2,
      "describe_ch": "應用抽樣分佈與資料敘述、單樣本與多樣本的推定方法及單樣本與多樣本的假定檢驗方法",
      "describe_en": "To understand the usage of fundamental sampling distributions and data descriptions, one- and two-sample estimation problems, one- and two-sample hypothesis tests."
    }
  ],
