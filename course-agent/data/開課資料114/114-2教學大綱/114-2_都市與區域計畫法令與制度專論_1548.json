    {
      "seq": 1,
      "describe_ch": "能理解都市與區域計畫法令與制度之內涵。",
      "describe_en": "Comprehension of the significance of urban and regional planning regulations and urban and regional planning system."
    },
    {
      "seq": 2,
      "describe_ch": "能培養學生都市與區域計畫法規應用能力。",
      "describe_en": "Application of urban and regional planning regulations."
    }
