  "description": {
    "sub_id3": null,
    "sub_name": "工程圖學(二)",
    "sub_ename": "ENGINEERING GRAPHICS(2)",
    "describe_ch": "本課程以課堂解說及習作來建立學生必須的工程圖學知識基礎，修習本課程後學生應熟悉點、線、面、投影幾何、立體與平面三視圖互相轉換、立體之剖面及立體草圖的繪製及其應用，並將工程圖學的圖例以AutoCAD電腦繪圖軟體工具將其繪製出圖。\r",
    "describe_eh": "This course is to establish the fundamental concepts and knowledge of engineering drawings. After this course, student shall be familiarized with point, line and surface geometric projections, solid and planar view mutual transformation, and cross section. The AutoCAD software is a tool to draw the examples of exercise form.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習者能正確瞭解三角等視圖投影之原理",
      "describe_en": null
    },
    {
      "seq": 2,
      "describe_ch": "學習者能正確描述Auto-CAD立體繪圖之相關工具列及其每項圖示之功用\r\n",
      "describe_en": null
    },
    {
      "seq": 3,
      "describe_ch": "學習者能從立體圖繪製三視圖，反之亦能從平面視圖繪製立體圖",
      "describe_en": null
    },
    {
      "seq": 4,
      "describe_ch": "學習者的作業及上機考試兩項來評估學習成果",
      "describe_en": null
    }
  ],
