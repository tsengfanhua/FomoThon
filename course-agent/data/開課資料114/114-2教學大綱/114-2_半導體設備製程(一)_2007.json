  "description": {
    "sub_id3": null,
    "sub_name": "半導體設備製程(一)",
    "sub_ename": "SEMICONDUCTOR EQUIPMENT PROCESS (1)",
    "describe_ch": "本課程是一門針對半導體設備製程的專業課程，旨在教授學員如何操作、控制和維護半導體設備。學員將學習到如何使用各種設備和工具，以及如何進行製程控制和品質管理。課程重點在於培養學員具有實際應用能力的技能。",
    "describe_eh": "This course is a professional course for the semiconductor equipment manufacturing process, aiming to teach students how to operate, control and maintain semiconductor equipment. Students will learn how to use various equipment and tools and carry out process control and quality management. The course focuses on developing students' skills with practical application.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解半導體設備元件在半導體製程的重要性",
      "describe_en": "Understand the importance of semiconductor equipment components in the semiconductor process"
    },
    {
      "seq": 2,
      "describe_ch": "結合理論知識初步了解半導體設備與元件",
      "describe_en": "Combining theoretical knowledge with a preliminary understanding of semiconductor equipment and components"
    },
    {
      "seq": 3,
      "describe_ch": "培養融入公司文化及工程技術養成",
      "describe_en": "Cultivate and integrate into company culture and develop engineering technology"
    }
  ],
