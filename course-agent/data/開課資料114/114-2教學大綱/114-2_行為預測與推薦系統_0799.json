  "description": {
    "sub_id3": null,
    "sub_name": "行為預測與推薦系統",
    "sub_ename": "BEHAVIOR PREDICTION AND RECOMMENDATION SYSTEM",
    "describe_ch": "本課程將介紹機器演算法如何運用於行為預測與推薦系統，教授基本的線性模型、非線性模型、深度學習方法等，隨後介紹推薦目標以及行為預測目標函數中常見的損失函數，以及最佳化方法以及推薦系統常用的評價方法以及其實作。",
    "describe_eh": "This course will introduce how machine learning algorithms are used in behavior prediction and recommendation systems and teach basic linear models, nonlinear models, deep learning methods, etc. Then we will also introduce recommendation goals, common loss functions in behavior prediction and objective functions, and optimization methods, evaluation methods commonly used in recommendation systems, and its implementations finally.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "強化學生熟捻數學統計工具以及實作之專業能力。",
      "describe_en": "Reinforce the ability of mathematic and statistical analysis tools and application"
    },
    {
      "seq": 2,
      "describe_ch": "介紹常用的行為預測以及推薦系統技術，並搭配教授Python程式操作，以期日後能運用於不同案例上的相關實作解法。",
      "describe_en": "Introduce the behavior prediction and recommendation system analysis skills and Python programming in order to implement related solutions in different real cases"
    },
    {
      "seq": 3,
      "describe_ch": "培養學生之專業分析能力，使其滿足學界與業界對於大數據人才的需求。",
      "describe_en": "Train the ability of statistical analysis"
    }
  ],
