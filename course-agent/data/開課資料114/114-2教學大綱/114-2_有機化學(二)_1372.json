  "description": {
    "sub_id3": null,
    "sub_name": "有機化學(二)",
    "sub_ename": "ORGANIC CHEMISTRY(2)",
    "describe_ch": "對有機族類---鹵化烷類、共軛二烯類、苯、醇、酚、醚、醛、酮、有機酸及其衍生物與胺類---的命名、結構、物性、製備、化學反應、與工業上的應用有詳細的解說。有機合成的方法與途徑的規劃也會被強調.",
    "describe_eh": "Nomenclature, structures, physical properties, preparations, chemical reactions, and industrial applications of Rxs, conjugated dienes, benzene, alcohols, phenols, ethers, the compounds containing carbonyl group, including aldehydes, ketones, carboxylic acids, and their derivatives, and amines are all discussed in details.  The mechanisms and stereochemistry involved in the chemical reactions in each of the above mentioned organic families are also thoroughly investigated.  Synthetic methods and pathways are emphasized throughout the course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解鹵化烷類的命名，結構，物性，製備，化學反應及其合成上的應用",
      "describe_en": " Comprehension for the nomenclature, structures, physical properties, preparations, chemical reactions, and industrial applications of alkyl halides."
    },
    {
      "seq": 2,
      "describe_ch": "理解共軛二烯類的特殊穩定性及其化學反應，並且能解讀共軛系統的紫外線光譜圖。",
      "describe_en": "Comprehension for the characteristic stability and chemical reactions of a conjugated diene and to be able to interpreter an ultraviolet spectroscopy of a conjugated system.　"
    },
    {
      "seq": 3,
      "describe_ch": "能理解醛、酮、酸及酸的衍生物的命名、結構、製備、化學反應、合成方法與工業上的應用。　",
      "describe_en": "Comprehension for the nomenclature, structures, preparation, chemical reactions, synthetic pathways and industrial applications of the organic families of the organic compounds containing carbonyl group, such as aldehydes, ketones, carboxylic acids and th"
    },
    {
      "seq": 4,
      "describe_ch": "能應用苯的特殊化學,進而有能力合成芳香族化合物。",
      "describe_en": "To apply the special chemistry of benzene and furthermore to be able to synthesize aromatic compounds."
    }
  ],
