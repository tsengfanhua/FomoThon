  "description": {
    "sub_id3": null,
    "sub_name": "當前經營管理問題研討",
    "sub_ename": "SEMINAR ON CURRENT BUSINESS AND MANAGEMENT ISSUES",
    "describe_ch": "本課程針對學員需要，選擇具有當前經營管理重要意義的議題，邀請相關專家學者引言，其目的在建立討論的平台，經由實務經驗與學術理論的對話，不同產業觀察的角度，釐清當前經營管理的重大議題。",
    "describe_eh": "For fulfilling the practicing needs and wants of the students, the course plays as a platform of academic-practical dialog. The most current business issues will be introduced through the most specialist and academician and be discussed in a frame of different views of business point in the hope that the issues will be clarified in a further way.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能充實管理面的基本知識與技能並且加以實踐及分析 　\t",
      "describe_en": "Can learn more management knowledge and skills to its practicing and analysis"
    },
    {
      "seq": 2,
      "describe_ch": "對最新的市場動態清楚掌握、分析並且回應在自我工作上 　\t",
      "describe_en": "Can grasp and analyze the current market dynamics and respond basing on own business."
    },
    {
      "seq": 3,
      "describe_ch": "綜合理解新興市場的優勢與機會，劣勢與威脅 　\t",
      "describe_en": "Can synthesis their own position and recognize the opportunities, weakness, strength and threats in the new market."
    }
  ],
