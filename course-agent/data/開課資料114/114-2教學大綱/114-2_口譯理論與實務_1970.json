  "description": {
    "sub_id3": null,
    "sub_name": "口譯理論與實務",
    "sub_ename": "INTERPRETING: THEORY AND PRACTICE",
    "describe_ch": "口譯，一如筆譯，是一項重要的翻譯活動，二者相互輝映，卻又截然不同。本課程作爲口筆譯概論的延續，以課堂講授以及學生發言和分組討論的形式，涵蓋四種口譯模式(同步，逐步，耳語以及視譯)，並融入跨文化溝通以及語言學的元素。另外，課堂上也進行口譯演練，並延請口譯業師現身説法，以期帶給學生口譯理論和實務的全貌。",
    "describe_eh": "This seminar provides theoretical foundations for interpreting studies theory and professional practice, as required by perspective certified interpreters. It aims to develop students’ knowledge and understanding of contemporary theories in interpreting studies, cross-cultural linguistics and cross-cultural communication relevant to interpreting. It will also introduce students to professional ethics and code of conduct, familiarizing students with the development of the profession in Taiwan and worldwide. Moreover, students will be given the opportunity to hands-on practice (under the instruction of real-life professionals given in the form of in-class guest lectures). All in all, this seminar serves as a booster parallel to the translation seminar.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "在知識建構上，口譯學是進階翻譯學課程必要且更高階的專業",
      "describe_en": "Interpreting is a necessary follow-up to translation studies at an advanced level"
    },
    {
      "seq": 2,
      "describe_ch": "學生學習與產業接軌的技能與知識，以利他們迅速就業",
      "describe_en": "By means of guest lectures by real-life professional interpreters, students get to learn skills in industry-aligned, real-life scenarios, which will ready them for a career in the area"
    }
  ],
