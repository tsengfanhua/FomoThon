  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE05120",
    "sub_id": "00788",
    "scr_dup": "001",
    "sub_title": "由學習基礎建模至實際3D列印作品製作，強調設計思考、軟體操作與實作整合。",
    "sub_title_en": null,
    "sub_describe": "本課程旨在培養學生具備以SolidWorks進行3D建模與3D列印實作的能力，結合產品設計思維與工程應用，從基礎建模到功能性作品完成。學生將學習3D列印流程、材料特性、建模技術及設計展示，培養創新設計與團隊協作能力。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "工業數位設計",
    "sub_ename": "INDUSTRIAL DIGITAL DESIGN",
    "describe_ch": "工業數位設計是一門幾何圖形表現與追求現代時尚感的主題式教學。本課程促使學生瞭解數位繪圖語言，並深入頗析數位圖形表達方式，讓學生在數位潮流的素養薰陶中，呈現出當代的工業設計美學和時尚感。",
    "describe_eh": "Digital Design is a thematic teaching on the expression of geometric designs and the pursuit of modern fashion sense. This course enables students to understand the usage of digital graphics and to expend the digital graphical expression ideas, allowing students to update contemporary industrial design aesthetics and fashion automatically.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
