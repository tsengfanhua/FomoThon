  "description": {
    "sub_id3": null,
    "sub_name": "認識個資法、資訊倫理及應用",
    "sub_ename": "INTRODUCTION TO PERSONAL DATA PROTECTION LAW, INFORMATION ETHICS AND APPLICATION",
    "describe_ch": "釐清我國個人資料保護法當中，有關個人資料的定義，並就該法當中，有關個資的蒐集、處理及利用的相關規定，輔以現實生活中的案例，作體系性的介紹。此外，也會特別強調，在現今人工智慧的發展以及數位化的浪潮之下，如何在其與個人資料保護之間，取得平衡。",
    "describe_eh": "This course is to clarify the definition of personal data in my country's Personal Data Protection Law, and give a systematic introduction to the relevant provisions of the Law on the collection, processing and utilization of personal data, supplemented by real-life cases. In addition, special emphasis will be placed on how to strike a balance between it and personal data protection under the current development of artificial intelligence and the wave of digitization.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "探索個資保護與數位化發展之關聯，探索資訊利用與個資保護之間的權衡",
      "describe_en": "Explore the relationship between personal information protection and digital development, and cultivate the literacy of personal information protection and information utilization"
    },
    {
      "seq": 2,
      "describe_ch": "比較歐美等國的個資保護法規，拓展視野並思索不同文化背景下的資訊倫理",
      "describe_en": "Compare personal information protection laws and regulations in Europe, America, to expand horizons and think about information ethics in different cultural backgrounds"
    }
  ],
