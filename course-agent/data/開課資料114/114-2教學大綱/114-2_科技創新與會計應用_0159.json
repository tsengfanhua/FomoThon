  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CB01139",
    "sub_id": "22667",
    "scr_dup": "001",
    "sub_title": "本課程的探究主題核心在於：研究會計專業人士如何應用 Power BI 進行高效能的資料視覺化分析、實作 RPA 流程自動化技術以提升會計作業效率與準確性，並探討人工智慧等新興科技對審計、財務記錄與會計道德帶來的變革與挑戰，最終目標是培養學生具備科技整合能力，針對複雜的會計問題提出創新的數位解決方案。",
    "sub_title_en": null,
    "sub_describe": "本課程的探究主題分為四大核心：\n1.\t數位時代會計資訊的傳播與效率。\n2.\t應用型圖表於會計實務分析的效益比較。\n3.\tRPA 對重複性會計流程效率提升與風險控制。\n4.\t科技整合會計問題的創新解決方案設計。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "科技創新與會計應用",
    "sub_ename": "TECHNOLOGY INNOVATION AND ACCOUNTING APPLICATION",
    "describe_ch": "因應全球科技及企業數位化之發展，公司的作業流程已全面自動化。本課程將介紹物聯網、大數據分析、區塊鏈、人工智慧、及其他科技如何影響企業決策制定的過程。本課程亦會探討上述科技議題對會計、財務、成本管理、與審計方面之影響。本課程之目標為培養學生創新思考之能力，並具備跨領域知識，以因應未來的職涯發展。",
    "describe_eh": "The corporate operational process has been entirely automatic for the development of global technology and business digitization. This course will introduce how Internet of Things (IoT), big data, block chain, artificial intelligence (AI), and other emerging technology will affect corporate decision-making process. Further, this course will introduce the influence of these issues on accounting, finance, cost management, and auditing process. This course aims to enable students possess innovative thinking abilities and cross-disciplinary knowledge for future career development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知道科技創新在會計產業如何應用",
      "describe_en": "Knowledge for the technology application in accounting industry."
    },
    {
      "seq": 2,
      "describe_ch": "能理解會計實務上須具備哪些資料分析之能力",
      "describe_en": "Comprehension for the ability of data analysis in accounting practice."
    }
  ],
