  "description": {
    "sub_id3": null,
    "sub_name": "管理科學",
    "sub_ename": "MANAGEMENT SCIENCE",
    "describe_ch": "本課程旨在讓學生明瞭管理科學之概念、基本數學理論之介紹、數學模型之建構及電腦軟體之操作，並且能將此數學模型，透過電腦軟體，實際應用於企業管理相關領域。",
    "describe_eh": "The main purpose of this course is to introduce students the basic mathematical theory and computer programs for modeling business problems and techniques for solving them. By the end of the semester, students should be able to model large amount of business problems mathematically and find the optimal solution for them.",
    "pre_subname": "MATH1005微積分(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙描述管理科學的範疇、重要性與應用",
      "describe_en": "The comprehension of management science with their own words about its scope, importance and application."
    },
    {
      "seq": 2,
      "describe_ch": "能暸解並說明管理科學在商業活動的重要性與影響",
      "describe_en": " Can apply the importance and effects of management science to business activities."
    }
  ],
