  "description": {
    "sub_id3": null,
    "sub_name": "奈米粉體製程實驗",
    "sub_ename": "EXPERIMENTS OF NANOCRYSTALLINE POWDER SYNTHESIS",
    "describe_ch": "本實驗課程之目的在使學生瞭解奈米粉體製程與合成粉體之特性，實驗分3-4個部分進行，包括以溶膠凝膠、共沈、水熱及球磨技術等製備奈米晶粉體、薄膜或奈米顆粒之合成實驗。奈米粉體合成後，也會進行部分相關之檢測分析使學生更加瞭解材料製程與特性之關聯性。此課程為實驗操作的應用學科，課程實施將側重於實驗前後的報告、測驗與課程中的表現為主。",
    "describe_eh": "The purposes of this experimental course is to increase the understanding of nanoparticle processing and its corresponding characteristics. The course can be divided into 3-4 main synthesis experiments: nanocrystalline particle, film or nanoparicle preparations by sol-gel, co-precipitation, hydrothermal and ball-milling techniques. The characterization technique of the prepared nanoparticles or films are also carried to further understand the relationships between processing and their relative properties. This course is an applied subject of experimental operation. The implementation of the course will focus on the report before and after the experiment, the test and the performance in the course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "介紹如何以沉澱法與溶膠凝膠法製備出奈米粉體，並在後續課程中分析不同製程之間的差異。",
      "describe_en": "Introduce how to prepare nano-powder by precipitation method and sol-gel method, and analyze the difference between different processes in subsequent courses."
    },
    {
      "seq": 2,
      "describe_ch": "介紹水熱法與超音波合成法兩種常見的奈米粉體製程，製備奈米氧化物粉體，並探討其粉體特性的差異。",
      "describe_en": "Introduce two common nano-powder systems, hydrothermal method and ultrasonic synthesis method, to prepare nano-oxide powders, and discuss the difference in powder properties."
    },
    {
      "seq": 3,
      "describe_ch": "介紹三種不同類型之三維列印製程，材料的選擇、製程之優缺點以及BET量測的原理，並探討其待測粉體內部結構的吸附機制。",
      "describe_en": "Introduce three different types of 3D printing processes, the selection of materials, the advantages and disadvantages of the process, and the principle of BET measurement, and discuss the adsorption mechanism of the internal structure of the resulting powders."
    }
  ],
