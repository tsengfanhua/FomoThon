  "description": {
    "sub_id3": null,
    "sub_name": "高等半導體元件",
    "sub_ename": "ADVANCED SEMICONDUCTOR DEVICES",
    "describe_ch": "學生將藉由本課程熟悉諸如：p/n接面二極體、BJT、金屬-半導體接觸理論、JFET、MESFET、MIS二極體、CCD、MOSFET、隧道二極體、TED、HEMT等半導體元件之結構、理論與特性。",
    "describe_eh": "Students will learn the operation principles and establish physical advanced of various semiconductor devices, including: p/n Diode, BJT, M/S contact theory, JFET, MESFET, MIS diode, CCD, MOSFET, Tunneling Diode, TED and HEMT.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解各種半導體元件之結構、工作原理與應用。\t",
      "describe_en": "To comprehend the structure, operation principle and applications of various semiconductor devices."
    },
    {
      "seq": 2,
      "describe_ch": "能應用半導體物理之知識，描述基礎半導體元件之特性。",
      "describe_en": "To apply the knowledge of semiconductor physics and to describe the fundamental characteristics of semiconductor devices"
    },
    {
      "seq": 3,
      "describe_ch": "能分析半導體元件之特性能力。",
      "describe_en": "To analyze the characteristics of semiconductor devices"
    },
    {
      "seq": 4,
      "describe_ch": "能綜合半導體元件知識完成作業或專題討論，展現團隊合作的能力。",
      "describe_en": "To synthesize the knowledge of semiconductor devices to demonstrate spirit of teamwork by team-up studies or project discussions"
    }
  ],
