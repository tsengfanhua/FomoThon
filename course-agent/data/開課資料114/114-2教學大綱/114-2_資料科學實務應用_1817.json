  "description": {
    "sub_id3": null,
    "sub_name": "資料科學實務應用",
    "sub_ename": "PRACTICAL APPLICATIONS OF DATA SCIENCE",
    "describe_ch": "本課程介紹數據科學相關的一系列主題，包含數據前處理、模型建構與分析、超參數調校、視覺化呈現等，也結合機器學習方法處理迴歸、分群與分類問題。修課同學需具備數學、統計與程式撰寫等基礎知識及能力以進行跨領域整合學習。課程使用電腦軟體（如Excel、Jupyter等）搭配程式語言進行低代碼/無代碼開發，課程目標為建立同學朝數據科學發展必要之根基，以便於進行各自專業領域的研究。",
    "describe_eh": "This course introduces a series of related topics to Data Science, including data preprocessing, model construction and analysis, visualization, etc. Machine learning methods are also introduced to deal with regression, clustering and classification problems. Students should have fundamental knowledge of mathematics, statistics and programming for interdisciplinary studies. This course develops No-Code / Low-Code applications by computer software tools, e.g., Excel and Jupyter, and programming language. The course target is to construct required skills of Data Science, and subsequently students can conduct individual studies in professional fields.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解並說明數據科學與視覺化之主要概念與內涵。",
      "describe_en": "To understand and explain the major meaning and contents of Data Science and Visualization."
    },
    {
      "seq": 2,
      "describe_ch": "能透過團隊合作，應用跨領域學習與知識處理實際問題。",
      "describe_en": "By the teamwork, one can cooperatively solve practical problems with interdisciplinary learning and knowledge."
    }
  ],
