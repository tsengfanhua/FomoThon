  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CH06129",
    "sub_id": "06545",
    "scr_dup": "001",
    "sub_title": "以採訪紀實寫作，全面鍛鍊口語與書寫表達力",
    "sub_title_en": null,
    "sub_describe": "透過採訪寫作的紀實書寫歷程，學生需先進行口語訪談，學習提問、傾聽與即時回應，培養清楚表達與溝通能力；再將訪談內容轉化為文字，進行整理、取捨與組織，訓練書寫的精準度與結構感。此一過程結合說與寫，使語言能力在實作中同步深化。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "中文寫作",
    "sub_ename": "CREATIVE WRITING IN CHINESE",
    "describe_ch": "透過作品研讀、文學理論，與實務創作，鍛鍊語言表述能力，強調藝術化的表現形式，並且藉由實務創作的檢討，深化學習效果。",
    "describe_eh": "This course aims to enhance students’ Chinese writing ability by means of reading literary works and theories and doing creative writing practices. By reflecting on their writing practices, students will have a better understanding regarding the art of writing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "進階中文書寫表達能力",
      "describe_en": "Enable students to have advanced Chinese writing ability"
    },
    {
      "seq": 2,
      "describe_ch": "掌握詩、散文、小說的文體特質",
      "describe_en": "Enable students to understand features of poem, prose and novel"
    }
  ],
