  "description": {
    "sub_id3": null,
    "sub_name": "品牌美學與行銷策略",
    "sub_ename": "BRAND AESTHETICS AND MARKETING STRATEGY",
    "describe_ch": "本課程將探討高階行銷決策中的品牌美學與行銷策略問題，並提供策略行銷架構與美學理論進行分析。本課程包括品牌定位分析與美學策略評估，以檢視產業成長、市場競爭結構、客戶行為，與經營治理。",
    "describe_eh": "This course will explore the issues in high-level marketing decision-making and provide a strategic marketing framework and aesthetics theories for analysis. This course includes methods of brand position analysis and aesthetic strategy assessment to examine industry growth, market structure of competition, customer behavior and corporate governance.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
