  "description": {
    "sub_id3": null,
    "sub_name": "電磁學實習(二)",
    "sub_ename": "RECITATION OF ELECTROMAGNETISM (2)",
    "describe_ch": "電磁學(一)由靜電及靜磁學導出Maxwell's equations, 電磁學(二)則以Maxwell's equations為基礎，探討傳輸線、波導裝置、共振器、天線及輻射系統的理論及應用。",
    "describe_eh": "Maxwell's equations are derived in electromagnetism (1). Starting with Maxwell's equations. We Study the theory and applications of transmission lines, waveguides and cavity resonators and antennas and radiating systems in electromagnetism.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、PHYS2001電磁學(一)、PHYS1005普通物理(一)、PHYS1006普通物理(二)、ENGS2011工程數學(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、PHYS2001 ELECTROMAGNETICS(1)、PHYS1005 GENERAL PHYSICS(1)、PHYS1006 GENERAL PHYSICS(2)、ENGS2011 ENGINEERING MATHEMATICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉Maxwell's equations 的微分及積分形式。",
      "describe_en": "Be familiar with the differential and integral form of Maxwell's equations."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解電磁技術和最新應用。",
      "describe_en": "To underdtand the technology of electromagnetics."
    }
  ],
