  "description": {
    "sub_id3": null,
    "sub_name": "運輸安全",
    "sub_ename": "TRANSPORTATION SAFETY",
    "describe_ch": "本課程在探討運輸安全重要課題。課程重點包括「系統要素概說」，「認知與資訊處理」，「駕駛者認知反應時間」，「開車時駕駛看哪裡又看多久」，「個別差異」，「與交通安全有關的政策或法規」等。本課程內容可連結SDG3的目標。",
    "describe_eh": "This course focuses on basic Transportation Safety issues. The purpose of this course is to provide the students with tools & methods to prevent traffic accidents. The course consists of introduction to system elements, perception and information processing, driver perception-response time, where to look and for how long while driving, individual differences, policy and regulation related to traffic safety.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
