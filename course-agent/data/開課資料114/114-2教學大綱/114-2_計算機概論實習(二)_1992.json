  "description": {
    "sub_id3": null,
    "sub_name": "計算機概論實習(二)",
    "sub_ename": "THE  PROGRAMMING LABORATORY(2)",
    "describe_ch": "實際上機講解並指派作業演練，訓練電腦的各項基本應用技能以及解決問題的技巧，同時配合計算機概論課程之進度及內容，以上機實做的方式演練各項程式設計的觀念及技術。",
    "describe_eh": "By examining the operations of various applications on computer step by step to accumulate the actual experience about computer usage. Training the techniques of various applications and the methods for resolving problems. Furthermore, the course is scheduled to cooperate with the progress of the course, \"Introduction to Computer Science(2)\", for establishing various techniques of programming.",
    "pre_subname": "IEE1002計算機概論實習(一)",
    "pre_sub_id3": "IEE1002",
    "pre_sub_ename": "IEE1002 THE  PROGRAMMING LABORATORY(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能使用C++語言設計物件導向應用程式",
      "describe_en": "Use C++ Language to design object-oriented application programs."
    },
