  "description": {
    "sub_id3": null,
    "sub_name": "光電綜論(二)",
    "sub_ename": "OVERVIEW OF PHOTONICS(2)",
    "describe_ch": "本課程目的為簡介光電領域的主要課題及其發展。本課程會安排演講分享多元學習與光電產業介紹，以引導學生思考未來出路與生涯規劃。為協助學生及早建立專業與資訊倫理的觀念，課程中也會探討相關的議題。學生將在本課程中完成Arduino與程式語言為基礎的新鮮人專題。\r\n",
    "describe_eh": "The goal of this course is to introduce the main fields and their evolutions in Optics and Photonics. Seminars on diverse learning and photonic industries will be included to promote students’ prospect and career planning in the field. To help students establish concepts of professional ethics and information ethics early, the course will also explore related topics. The freshman project based on Arduino and a programming language will be completed in this course. Diversified teaching and evaluation methods will be employed in his course. \r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "描述光電領域的基礎概念。",
      "describe_en": "To describe the basic principles of Optics and Photonics."
    },
    {
      "seq": 2,
      "describe_ch": "透過演講認識多元學習、光電科技新興技術之趨勢與永續發展。",
      "describe_en": "To understand diverse learning, the trends of emerging photonics technologies, and sustainable development through the seminars."
    },
    {
      "seq": 3,
      "describe_ch": "能理解工程倫理。",
      "describe_en": "To comprehend engineering"
    },
    {
      "seq": 4,
      "describe_ch": "透過團隊合作應用Arduino完成新鮮人專題。",
      "describe_en": "To apply Arduino to complete the freshman project through teamwork."
    }
  ],
