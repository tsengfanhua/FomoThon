  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(二)",
    "sub_ename": "ENGINEERING MATHEMATICS(2)",
    "describe_ch": "本課程主要在教導學生如何將科學或工程上的問題用數學方法來表示，提升學生數學思考與分析的能力。課程的內容主要包含Fourier級數、Fourier轉換、二階偏微分方程: 波動方程式、Laplace方程式、熱傳導方程式及不同座標系的邊界值問題等主題。",
    "describe_eh": "The main objective of this course is to teach students how to describe scientific and engineering problems using mathematical methods and to promote students' mathematical thinking and analysis abilities. The course contents include Fourier series、Fourier transform、second order partial differential equations: Wave equation, Laplace equation, Heat equation, and Boundary Value Problem of the different coordinate systems.",
    "pre_subname": "CEM1006微積分",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
