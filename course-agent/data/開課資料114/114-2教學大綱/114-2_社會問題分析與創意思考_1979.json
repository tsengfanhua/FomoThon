  "description": {
    "sub_id3": null,
    "sub_name": "社會問題分析與創意思考",
    "sub_ename": "SOCIAL PROBLEMS ANALYSIS AND CREATIVE THINKING",
    "describe_ch": "此課程首先會使學生了解並學會運用「系統思考」「本質思考」等有助於解決社會問題的思維方式,再籍由世界各國的個案討論,了解一般社會問題的根源所在為何,最後經由台灣社會中所存在之間題,進行結構性探討,我出具有可行性的解決方案,並進行公開的成果報告。\r\n",
    "describe_eh": "This course aims to let the students to learn how using the essential thinking to solve social problems. And then, help students to learn the core factors about social problems through the cases of world around. Finally, let students to study the social problems of Taiwan with the structural perspectives and work out some feasibility solutions for them, and to present publicly as well.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解與運用本質思考",
      "describe_en": "To learn the essential thinking and know how to use it."
    },
    {
      "seq": 2,
      "describe_ch": "能分析社會問題之本質與其背後存在之關係結構",
      "describe_en": "Be able to analyze the essence of social problems and their social contexts."
    }
  ],
