  "description": {
    "sub_id3": null,
    "sub_name": "建築概論",
    "sub_ename": "INTRODUCTION TO ARCHITECTURE",
    "describe_ch": "建築概論為協助學生對建築基本知識的瞭解，從觀察及體驗中認識建築的生產過程及背景因素，理解人們良好居住品質的要件，以應用於土地合理開發的探討。",
    "describe_eh": "Introduction to Architecture will allow students to understand the basic  knowledge on architecture. Through observation and application, one will be introduced to the production cycle and its background. Moreover, students will comprehend what qualities are needed to be considered as a good living space, and discuss the applications of landscape development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能認識建築的表達語彙及理念的表現方式；能描述建築的概要及其物件要素。",
      "describe_en": "Be able to correctly express the ideas in architecture and describe the design concept of buildings."
    },
    {
      "seq": 2,
      "describe_ch": "能理解建築的生產影響因素及其環境背景。",
      "describe_en": "Understand the influences on production and its various background."
    },
    {
      "seq": 3,
      "describe_ch": "能理解建築的設計理念及分析其機能性。",
      "describe_en": "Be able to understand the concept of design and analyze the function."
    },
    {
      "seq": 4,
      "describe_ch": "能瞭解建築的管理体系及其生產計劃。",
      "describe_en": "Understand the management system and production plan."
    }
  ],
