  "description": {
    "sub_id3": null,
    "sub_name": "創新綠色科技",
    "sub_ename": "INNOVATION GREEN TCHNOLOGIES",
    "describe_ch": "涵蓋5C產品(電腦、消費電子、通訊、汽車、零組件)、材料、建築土木、農業生技等領域，闡述綠色科技之內涵、在不同領域的具體表現型態、以及當初綠色創意構想由來等，適合未曾接觸上述領域任何課程的學生修習。",
    "describe_eh": "This course provides the basic information of 5C productions (i.e. Computer, Consumption electronic, Communication, Automobiles (Car), Compartments). It also introduces the content of green technology, the application outlook in each field, and the original ideal of these innovation inventions.  This course is designed mainly to the students who are non-major in the above-mention fields.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
