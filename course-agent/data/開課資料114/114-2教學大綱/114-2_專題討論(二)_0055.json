  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(二)",
    "sub_ename": "SEMINAR(2)",
    "describe_ch": "藉由文獻專題討論講授研究方法，培養學生發掘問題及蒐集資料之能力，進而熟悉各領域所探討的訴求及重點，以加強對IE的應用能力。",
    "describe_eh": "This course is designed to study and discuss concept and applications of IE by literature review.  Students then should know how to collect and analyze information and how to apply IE theory and skills solve problems.",
    "pre_subname": "ENGS6931專題討論(一)",
    "pre_sub_id3": "ENGS6931",
    "pre_sub_ename": "ENGS6931 SEMINAR(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 6,
      "describe_ch": "培養學生的專業知識和學術能力，以掌握太空領域的最新研究成果。",
      "describe_en": "Develop students' expertise and academic abilities to grasp the latest research findings in the field of space."
    },
    {
      "seq": 7,
      "describe_ch": "促進學生的批判性思考和問題解決能力，培養獨立思考和學術討論的能力。",
      "describe_en": "Foster students' critical thinking and problem-solving skills, cultivating independent thinking and engaging in academic discussions."
    },
    {
      "seq": 8,
      "describe_ch": "培養學生的演講和表達能力，使其能夠清晰地傳達和展示自己的研究成果。",
      "describe_en": "Enhance students' presentation and communication skills, enabling them to effectively convey and showcase their research findings."
    },
    {
      "seq": 9,
      "describe_ch": "強化學生的團隊合作和協調能力，透過小組討論和合作專題研究。",
      "describe_en": "Strengthen students' teamwork and coordination abilities through group discussions and collaborative project work."
    },
    {
      "seq": 10,
      "describe_ch": "促進學生對太空科學、技術和應用的綜合理解，鼓勵跨學科的學習和思考。",
      "describe_en": "Facilitate students' comprehensive understanding of space science, technology, and applications, encouraging interdisciplinary learning and thinking."
    },
    {
      "seq": 11,
      "describe_ch": "激發學生對太空研究的興趣和熱情，培育未來的太空專業人才。",
      "describe_en": "Ignite students' interest and passion for space research, nurturing future professionals in the field of space."
    }
  ],
