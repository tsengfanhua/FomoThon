  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "AS03130",
    "sub_id": "58918",
    "scr_dup": "001",
    "sub_title": "本課程涵蓋居家改造、長照機構空間創新、輔具設備與福祉科技應用等主題。",
    "sub_title_en": null,
    "sub_describe": "學生將透過實地參訪或實際案例與設計思維導向的小組合作，逐步培養從使用者觀察、問題分析到創新提案撰寫的能力。課程結合翻轉教室、設計思維與跨域討論，並延伸至真實社會場域，實踐以人為本的設計理念，強化學生的創意思考與跨域整合能力。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "樂齡住宅設計與福祉科技應用",
    "sub_ename": "DESIGN FOR SENIOR LIVING AND ASSISTIVE TE0CHNOLOGY",
    "describe_ch": "本課程涵蓋居家改造、長照機構空間創新、輔具設備與福祉科技應用等主題。學生將透過實地參訪或實際案例與設計思維導向的小組合作，逐步培養從使用者觀察、問題分析到創新提案撰寫的能力。課程結合翻轉教室、設計思維與跨域討論，並延伸至真實社會場域，實踐以人為本的設計理念，強化學生的創意思考與跨域整合能力。",
    "describe_eh": "This course covers topics such as home modification, innovative spatial design for long-term care facilities, assistive device design, and the application of welfare and assistive technologies. Through field visits and team-based projects guided by design-thinking methods, students gradually develop the ability to observe users, analyze problems, and formulate innovative design proposals. The course integrates flipped-classroom strategies, design thinking, and interdisciplinary discussions, extending learning into real-world community contexts to promote human-centered design practices and strengthen students’ creativity and interdisciplinary integration skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
