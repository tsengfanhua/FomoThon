  "description": {
    "sub_id3": null,
    "sub_name": "管理個案研討與分析",
    "sub_ename": "MANAGEMENT CASE STUDIES AND ANALYSIS",
    "describe_ch": "本課程旨在透過不同的管理實務個案，訓練同學獨立思考分析能力、溝通能力，更企圖藉由參與跨校個案競賽培養團隊合作能力，更進一步將個案所學與企業管理實務進行結合。",
    "describe_eh": "This course aims to train students’ independent thinking ability, communication skills through various management case studies. Also, by attending case analysis competitions, group cooperation skills will be taught. Furthermore, students can apply these to business practices.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能適當整合多項重要管理思維，並對企業提出適當之應用建議",
      "describe_en": null
    },
    {
      "seq": 2,
      "describe_ch": "能提昇本身之分析、思辨、組織、決策與應用等等之能力",
