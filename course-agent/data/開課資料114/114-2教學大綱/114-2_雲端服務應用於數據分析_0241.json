  "description": {
    "sub_id3": null,
    "sub_name": "雲端服務應用於數據分析",
    "sub_ename": "APPLICATION OF CLOUD SERVICES TO DATA ANALYTICS",
    "describe_ch": "本課程旨在應用雲端平台AWS的軟體服務(SaaS)於數據分析，期間將帶領同學學習AWS的無伺服器架構，使得線上數據收集、統合、分析與呈現得以於AWS上實現。在學習的過程中，學生亦參與發想應用場景，並以實踐應用服務作為實際練習。",
    "describe_eh": "The course aims to teach AWS’s software (Software as a Service, SaaS) and apply to data analytics. Students will be familiar with on-line data collection, data integration, data analytics and data presentation within the AWS serverless framework, and they will also be guided to develop application projects as practical exercise.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能清楚AWS中不同無伺服器服務的用途",
      "describe_en": "To clarify the purpose of AWS serverless services"
    }
