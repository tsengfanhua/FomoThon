  "description": {
    "sub_id3": null,
    "sub_name": "資料庫系統",
    "sub_ename": "DATABASE SYSTEMS",
    "describe_ch": "瞭解資料庫的基本原理和結構。課程內容包括資料庫系統概念和架構，實體關係模型，檔案與索引結構，關連式模型，SQL，從ER轉換成關連式綱目，以及正規化。",
    "describe_eh": "This course introduces the fundamental concepts and structures of databases, including database system concepts and architecture, Entity-Relationship Model, primary file organizations, index structures, relational data models. SQL, converting ER model to relational schema, and normalization.",
    "pre_subname": "IECS2001資料結構、IEE1002計算機概論實習(一)、IEE1003計算機概論實習(二)",
    "pre_sub_id3": "IECS2001",
    "pre_sub_ename": "IECS2001 DATA STRUCTURE、IEE1002 THE  PROGRAMMING LABORATORY(1)、IEE1003 THE  PROGRAMMING LABORATORY(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解資料庫管理系統之功能",
      "describe_en": "Understand the functions of database management system."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解資料庫塑模和關連式資料庫之基礎與運用。",
      "describe_en": "Understand the fundamentals of database modeling and relational databases."
    },
    {
      "seq": 3,
      "describe_ch": "說明資料庫正規化的目的及方法",
      "describe_en": "Explain the purpose and methods of normalization"
    },
    {
      "seq": 4,
      "describe_ch": "運用SQL於查詢資料庫之資料",
      "describe_en": "Apply SQL to query databases"
    }
  ],
