  "description": {
    "sub_id3": null,
    "sub_name": "半導體製程設備與實務",
    "sub_ename": "SEMICONDUCTOR PROCESS EQUIPMENT AND PRACTICE",
    "describe_ch": "透過半導體製程與設備實務，建立半導體製程相關理論知識與實務之連結，安排參訪製程產線，以實地驗證課程所學，進而建立未來在半導體領域的基礎。",
    "describe_eh": "Through practical experience in semiconductor processes and equipment, this study aims to establish a connection between theoretical knowledge and practical skills related to semiconductor manufacturing. We will organize visits to production lines to validate the concepts learned in the course, thereby laying a solid foundation for future endeavors in the semiconductor field.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解半導體製程相關理論知識\t",
      "describe_en": "Understanding the theoretical knowledge related to semiconductor processes"
    },
    {
      "seq": 2,
      "describe_ch": "結合理論知識初步瞭解半導體製程設備與實務\t",
      "describe_en": "Integrating theoretical knowledge to gain an initial understanding of semiconductor processing equipment and practices"
    },
    {
      "seq": 3,
      "describe_ch": "結合ESG概念認識半導體製程產線\t",
      "describe_en": "Integrating the concept of ESG to understand semiconductor manufacturing processes."
    }
  ],
