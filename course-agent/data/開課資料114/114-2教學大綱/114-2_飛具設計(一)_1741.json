  "description": {
    "sub_id3": null,
    "sub_name": "飛具設計(一)",
    "sub_ename": "AIRCRAFT DESIGN(1)",
    "describe_ch": "『飛具設計（一）』是整合性的終端課程，藉由上課講解及搭配實際上機操作CAD等電腦輔助飛機設計軟體，並配合期中考試及期末專題計畫等方式以使學生們：1) 認識各種軍用機與民航機之設計理念及功能；2) 了解飛機設計的初步原理及方法；3) 能操作CAD飛機設計軟體以從事初步的飛機設計與分析。",
    "describe_eh": "\"Aircraft Design (I)\" is a integrated senior level course.  The major purposes of this course are to teach students: (1) to have knowledge of the design ideals and functions of military and civil airplane (2) to get familiar with the preliminary theory and methodology of aircraft design (3) to be able to operate the AAA aircraft design software and apply it to aircraft design and analysis.",
    "pre_subname": "AERO3002空氣動力學(一)、AERO3007飛行力學(一)、AERO1002航太工程概論",
    "pre_sub_id3": "AERO3002",
    "pre_sub_ename": "AERO3002 AERODYNAMICS(1)、AERO3007 FLIGHT MECHANICS(1)、AERO1002 INTRODUCTION  TO  AEROSPACE  ENGINEERING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識各種軍用機與民航機之設計理念及功能",
      "describe_en": "To have knowledge of the design ideals and functions of military and civil airplanes"
    },
    {
      "seq": 2,
      "describe_ch": "熟悉飛機設計的初步原理及方法\n",
      "describe_en": "To get familiar with the preliminary theory and methodology of aircraft design\n"
    },
    {
      "seq": 3,
      "describe_ch": "能將所學之CAD電腦輔助工程軟體應用於飛機設計\n",
      "describe_en": "To be able to apply the CAD software to aircraft design\n"
    },
    {
      "seq": 4,
      "describe_ch": "具團隊合作精神以進行工程設計之能力\n\n",
      "describe_en": "To be able to work as a team member and pursue design of engineering applications"
    },
    {
      "seq": 5,
      "describe_ch": "訓練口頭報告其設計作品之能力",
      "describe_en": "To be capable of making a fine presentation of their design works to their classmates and instructor."
    }
  ],
