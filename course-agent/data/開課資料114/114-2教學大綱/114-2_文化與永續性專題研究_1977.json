  "description": {
    "sub_id3": null,
    "sub_name": "文化與永續性專題研究",
    "sub_ename": "CULTURE AND SUSTAINABILITY",
    "describe_ch": "本課程以人類學視角，探討不同文化對生態與環境的理解與生態實踐。透過比較性的分析架構，引導學生檢視社群在維繫環境永續時所動員的資源與網絡標準，進而評估全球永續指標的適用性，並對永續概念進行批判性的反思。",
    "describe_eh": "This course, from an anthropological perspective, examines cultural understandings of ecology and the environment alongside diverse ecological practices. Through a comparative framework, students will analyze how communities mobilize resources and networks to sustain environmental well-being, evaluate the applicability of global sustainability indicators, and critically reflect on the concept of sustainability.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解文化差異下的生態與永續觀念。",
      "describe_en": "Understand ecological and sustainability concepts across cultural differences。"
    },
    {
      "seq": 2,
      "describe_ch": "以文化視角分析當代環境與永續議題。",
      "describe_en": "Apply cultural perspectives to contemporary environmental and sustainability issues。"
    }
  ],
