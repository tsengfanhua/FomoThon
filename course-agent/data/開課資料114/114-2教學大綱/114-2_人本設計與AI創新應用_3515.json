  "description": {
    "sub_id3": null,
    "sub_name": "人本設計與AI創新應用",
    "sub_ename": "HUMAN-CENTERED DESIGN AND AI INNOVATION APPLICATIONS",
    "describe_ch": "介紹促進社會包容與人本關懷的永續理念，並透過設計人類學方法深化人本設計思維，來發展感知落差與需求發現。後續，將探索AI技術的創新應用，從人本價值與科技賦能的角度，分析人本AI的設計思維，培養將AI科技創新與社會永續及人本價值觀緊密結合的能力。",
    "describe_eh": "Introduces sustainable principles for social inclusion and human care, using Design Anthropology to deepen human-centered design for identifying gaps and needs. It explores AI's innovative applications from Human Values and Technology Affordance, aiming to integrate AI innovation with societal sustainability and human-centric values.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養人文與科技之跨域融合的STEAM能力",
      "describe_en": "Cultivating the STEAM capabilities of interdisciplinary integration between humanities and technology."
    },
    {
      "seq": 2,
      "describe_ch": "能產生具有社會影響力之以人為本的AI創新應用方案",
      "describe_en": "Able to generate human-centered AI innovation application schemes with social impact."
    }
  ],
