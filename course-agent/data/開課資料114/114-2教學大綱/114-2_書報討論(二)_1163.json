  "description": {
    "sub_id3": null,
    "sub_name": "書報討論(二)",
    "sub_ename": "LITERATURE SURVEY (2)",
    "describe_ch": "是一門學習 學術研究規畫及研究論文與報告內容之學科。其目的在學習下列三大方向：\r\n(1) 學術研究之規劃\r\n(2) 研究論文之撰寫內容及格式 \r\n(3) 口頭及書面報告之能力培養\r\n",
    "describe_eh": "This course is designed to establish the capability of the following area:\r\n1. Academicals research planning\r\n2. be able to write and edit a proper content of an academicals paper or thesis.\r\n3. be able to oral or written presentation of research results with classmates and teacher.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能具備學術研究之規劃能力",
      "describe_en": "Be able to plan of research properly."
    },
    {
      "seq": 2,
      "describe_ch": "具備認知論文與學術報告正確格式的能力",
      "describe_en": "Recognizing of format of thesis and  technical report."
    },
    {
      "seq": 3,
      "describe_ch": "能自行進行資料蒐集、評估並歸納成結論；並能以書面或口頭方式將所獲結果同學及教師溝通",
      "describe_en": "Be able to collect data , execution and draw conclusion independently. and be able to communicate research result with classmate and instructor."
    },
    {
      "seq": 4,
      "describe_ch": "使了解國際相關纖維紡織領域之研究進展",
      "describe_en": "Recognizing the progress of international research on fiber and textile fields."
    }
  ],
