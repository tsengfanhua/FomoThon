  "description": {
    "sub_id3": null,
    "sub_name": "組織行為與經營管理",
    "sub_ename": "ORGANIZATIONAL BEHAVIOR AND BUSINESS MANAGEMENT",
    "describe_ch": "課程目的主要介紹組織行為的內容和範圍，藉由探討影響組織行為的相關變數，讓學習者瞭解個體、團體、組織因素對員工生產力、離職率、曠職率、組織士氣、組織公民行為的影響，並探討上述行為與組織績效的關聯性。",
    "describe_eh": "The purpose is to introduce the content and scope of organizational behavior. Due to discuss what is the factors affects the organizational behavior, to help learners to know the effect upon the individual, groups and organization factors among the productivity, employee turnover rate, absent rate、citizen behavior and performance.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用組織行為的理論與實務在經營管理上面\t",
      "describe_en": "Application of the theories and praxis of Organizational Behaviors on Business Management."
    },
    {
      "seq": 2,
      "describe_ch": "分析個體因素、群體因素與組織因素對於員工生產力、離職率、曠職率、組織士氣、組織公民行為與組織績效的影響\t",
      "describe_en": "Analysis of the individual, groups and organization factors affecting the productivity, employee turnover rate, absent rate, citizen behavior and performance."
    }
