  "description": {
    "sub_id3": null,
    "sub_name": "進階 C#程式設計",
    "sub_ename": "ADVANCED C# PROGRAMMING",
    "describe_ch": "目標是養成學生除基本電路專業外，還有獨立設計進階程式能力，用循序漸進的方式訓練，若能融會貫通便具有企業人才有關程式設計技能檢定的能力。觀念和語法並陳，循序漸進由淺入深，更貼近生活。為了能夠輕鬆入門，設計許多由淺而深利用創新教材腦波儀的應用與週邊硬體實作。",
    "describe_eh": "The aim of the project is to grow students' ability to design programs independently and train them in stages. Concepts and material are given side by side, from the beginner to a more in-depth phase, until they are close to the real situation. In order for students to get started easily, many applications and hardware peripheral implementations using EEG and innovative teaching materials are developed from the basic to the more in-depth.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解與使用C#程式語法",
      "describe_en": "Understand and use C# programming syntax"
    },
    {
      "seq": 2,
      "describe_ch": "了解與使用C#程式語言進行穿戴式腦波裝置開發應用",
      "describe_en": "Understand and use the C# programming language for the development and application of wearable brainwave devices"
    }
  ],
