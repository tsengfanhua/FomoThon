  "description": {
    "sub_id3": null,
    "sub_name": "普通物理(二)",
    "sub_ename": "GENERAL PHYSICS(2)",
    "describe_ch": "普通物理(二)延續上學期之普物課程(一)，課程涵蓋電磁學和光學主題，內容包括電場、電壓、電容、電路分析、磁場、磁力、電磁感應、電磁波、波動光學等。本課程以教師課堂講授為主，逐步推導和講解理論，配合課堂視聽資料。",
    "describe_eh": "General Physics (2) continues course of the general physics (1) of the previous semester. The course encompasses the topics of electromagnetism and optics, and the contents contain electric field, voltage, capacitance, circuit analysis, magnetic field, magnetic force, electromagnetic induction, electromagnetic wave, wave optics, etc. This course is mainly based on teachers’ classroom lectures, gradually deriving and explaining theories, and matching audio-visual materials in the classroom.",
    "pre_subname": "MATH1001微積分(一)、PHYS1003普通物理(一)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、PHYS1003 GENERAL PHYSICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解並能應用基本電學、磁學及光定律\t",
      "describe_en": "Understand the basic laws of electricity, magnetism and optics, and be able to apply them."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉基本直流電路分析\t",
      "describe_en": "Be familiar with the analysis of basic DC circuit."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉基本光學現象及其應用\t",
      "describe_en": "Be familiar with the basic Optical phenomena and their applications"
    }
  ],
