  "description": {
    "sub_id3": null,
    "sub_name": "物聯網應用實務",
    "sub_ename": "PRACTICAL APPLICATIONS OF INTERNET OF THINGS",
    "describe_ch": "訓練學生認識如何進行系統設計與規劃，了解相關文件的內容以及寫作，並且以一個假設性的題目練習寫作系統需求文件(SRS)，計畫起始文件(PID)，以及部分與系統設計文件(SDS)相關的圖表。",
    "describe_eh": "The goal is training students to understand how to proceed with system design and planning, what are the content of related documents and how to write those documents.  Each student with have an assumptive system to practice on system requirement specification (SRS), project initiation document (PID), and some charts/diagrams used in system design documents (SDS).",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "讓學生了解物聯網統架構",
      "describe_en": "Enable students to understand the architecture of the Internet of Things (IoT)."
    },
    {
      "seq": 2,
      "describe_ch": "了解物聯網情境中感測層、網路層與應用層各項技術之原理、應用與發展趨勢。",
      "describe_en": "Understand the principles, applications, and development trends of technologies in the sensing layer, network layer, and application layer within IoT scenarios."
    }
  ],
