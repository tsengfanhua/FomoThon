  "description": {
    "sub_id3": null,
    "sub_name": "水資源工程",
    "sub_ename": "WATER RESOURCES ENGINEERING",
    "describe_ch": "水資源工程是控制或調節自然界水量的工程手段，水資源的開發利用或控制計畫都須要相當多的基本知識與經驗去作整體研究以解決其特有的情況。本課程將使學生瞭解在不同的用水標的中，可採用的構造物以對水加以控制、調節與處理，並瞭解其規劃原理與設計實務。",
    "describe_eh": " The purpose of this course is to introduce different engineering practices to control or regulate the process of natural water resources. It includes water supply, drainage, water law, river management and flood mitigation, engineering economics and water resources planning for development.",
    "pre_subname": "HY1005水文學、HY2008流體力學(一)、HY2009流體力學(二)、HY3010明渠水力學",
    "pre_sub_id3": "HY1005",
    "pre_sub_ename": "HY1005 HYDROLOGY、HY2008 FLUID MECHANICS(1)、HY2009 FLUID MECHANICS(2)、HY3010 OPEN CHANNEL HYDRAULICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠描述各類水資源管理與應用設施的功能特性    \r\n      \r\n",
      "describe_en": " describe the function characteristics of  various water management utility"
    },
    {
      "seq": 2,
      "describe_ch": "能夠說明各類水資源管理與應用設施的設計原則\r\n\r\n",
      "describe_en": "explain the design principle of various water management utility"
    },
    {
      "seq": 3,
      "describe_ch": "能夠評估水資源開發方案的適宜性",
      "describe_en": "evalue the suitability of water resoures     development alternatives"
    }
  ],
