  "description": {
    "sub_id3": null,
    "sub_name": "大陸與東協台商資金管理",
    "sub_ename": "FINANCIAL MANAGEMENT OF TAIWAN FIRMS IN CHINA AND ASEAN",
    "describe_ch": "本課程介紹中國大陸及東協國家之金融市場，包含銀行、貨幣市場、債券市場、股票市場、外匯市場等，以及在大陸與東協經營之台商融資管道、資金調度等，以增進學生於大陸與東協金融市場及操作之了解。",
    "describe_eh": "This course aims to introduce the Chinese and ASEAN financial markets (including banking system, money markets, equity markets, bond markets, foreign exchange markets, etc.), and the related issues of financial management of Taiwanese firms operating in China and ASEAN. The purpose is to help students’  understanding of China and ASEAN financial markets and operations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解中國大陸及東協之金融市場運作",
      "describe_en": "To understand the Chinese and ASEAN financial markets"
    },
    {
      "seq": 2,
      "describe_ch": "能理解中國大陸及東協台商之融資管道與資金調度相關議題",
      "describe_en": "To understand the related issues of financial management of Taiwanese firms in China and ASEAN."
    }
  ],
