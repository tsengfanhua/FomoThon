  "description": {
    "sub_id3": null,
    "sub_name": "電路學(二)",
    "sub_ename": "CIRCUIT THEORY(2)",
    "describe_ch": "電路學(一)的延伸。主要內容由直流電路分析上，擴展到交流電路的分析。其中包括了弦波響應暫/穩態的分析、功率的計算、雙埠網路等。另外，也介紹頻率響應在電路分析方面的應用等。本課程銜接電子學等相關課程。",
    "describe_eh": "This course is an extension of Electric Circuits（1）. The main object of this course is to analyze ac circuits as well as dc circuits. That includes the analysis of sinusoidal transient/steady-state responses, power calculations, and two-port networks. Frequency response and its application on circuit analysis are also introduced in this course. This course lays the foundations of electronics and the corresponding courses.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解並解釋各種交流電路定義及分析方法，同時可區別他們的同異。",
      "describe_en": "Be able to comprehend various circuit theorems and analytical methods. Be able to distinguish their differences."
    },
    {
      "seq": 2,
      "describe_ch": "能應用電路定理與分析方法計算電路內各個元件的參數。",
      "describe_en": "Be able to compute the circuit parameter of each element in a given circuit by applying the appropriate circuit theorem and analytical."
    }
  ],
