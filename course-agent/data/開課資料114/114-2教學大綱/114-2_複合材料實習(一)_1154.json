  "description": {
    "sub_id3": null,
    "sub_name": "複合材料實習(一)",
    "sub_ename": "EXPERIMENTAL OF COMPOSITE MATERIALS(1)",
    "describe_ch": "本課程除了建立學生對複合材料的基本的認識外，並對複合材料的基本製程原理、製造方法、靜態機械性質測試與評估方法等知識做一探討。完成此一課程同學將可了解對複合材料的基本靜態機械性能測試方法與評估技巧。",
    "describe_eh": "The aims of this course are except to establish the basic knowledge of composite materials and also to investigate the manufacturing concepts, manufacturing process, mechanical property and evaluation methods of fiber composite materials. When students complete this course, s/he should be able to understand the fundamental static mechanical property testing methods and evaluation technology.",
    "pre_subname": "FCME3088複合材料學",
    "pre_sub_id3": "FCME3088",
    "pre_sub_ename": "FCME3088 COMPOSITE MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解複合材料試片之製作方法。",
      "describe_en": "Understand the fabrication method of composite test coupon."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解複合材料之拉張、壓縮、彎曲等測試方法與分析能力。",
      "describe_en": "Understand the tensile, compression, and bending test method and analysis of composite materials."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解複合材料之靜態機械性質測試與評估方法。",
      "describe_en": "Understand the test methods and evaluation of static mechanical properties of composite materials."
    },
    {
      "seq": 4,
      "describe_ch": "訓練學生能和同儕、及教師討論相關作業問題之解答",
      "describe_en": "Training the students can to discuss the solution procedures for homework problems with classmates, and the instructor."
    }
  ],
