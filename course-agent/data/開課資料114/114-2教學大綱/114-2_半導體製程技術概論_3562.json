  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE08139",
    "sub_id": "11288",
    "scr_dup": "001",
    "sub_title": "半導體技術演進與晶圓製程實務介紹",
    "sub_title_en": null,
    "sub_describe": "建構學生對半導體製造技術的完整認知。教學初期回顧發展史與產業演進，隨後系統性解析晶圓製造中各項核心單元製程的原理與實務應用，內容著重於電路圖案轉移、材料沉積、移除工藝及摻雜技術，並分析製程參數對元件性能之影響。\n\n預期學習成效包含：精確業界通用術語並理解其物理意義；具備將結構拆解為單一製程步驟並分析工序因果的能力；建立對良率控制、變異管理與技術權衡的專業判斷力。透過嚴謹的技術解讀，協助學生掌握半導體產業的核心製造邏輯。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "半導體製程技術概論",
    "sub_ename": "INTRODUCTION TO SEMICONDUCTOR MANUFACTURING TECHNOLOGY",
    "describe_ch": "本課程旨在提供學生對半導體製程技術的完整理解，內容涵蓋製程發展沿革、晶圓製造流程與主要步驟，包括薄膜沉積、微影、離子佈植、蝕刻、晶圓檢測與封裝測試等核心技術。課程以理論講授與實例分析為主，使學生能掌握各製程步驟的原理、相互關聯及應用場景。並透過業界技術趨勢介紹，使學生能對當前半導體製程技術有完整的理解，銜接未來實務應用與產業發展需求。",
    "describe_eh": "This course offers a fundamental overview of semiconductor manufacturing technology, guiding students through the evolution, structure, and core techniques of modern wafer fabrication. Topics include thin film deposition, lithography, ion implantation, etching, wafer inspection, and packaging/testing processes. Emphasis is placed on understanding the underlying principles, process sequence, and interdependencies within semiconductor fabrication. The course also examines current industry developments and technology trends to provide students with a comprehensive grasp of today’s semiconductor manufacturing landscape and its practical relevance to future industrial applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解半導體製程技術的基本原理與流程",
      "describe_en": "Develop a fundamental understanding of the principles and sequence of semiconductor manufacturing processes."
    },
    {
      "seq": 2,
      "describe_ch": "認識各製程步驟的技術特性與相互關聯",
      "describe_en": "Identify the characteristics and interrelationships among key process steps such as thin film deposition, lithography, ion implantation, and etching."
    },
    {
      "seq": 3,
      "describe_ch": "建立對現行製程技術發展趨勢與產業應用的整體認知",
      "describe_en": "Develop an integrated perspective on current semiconductor process technologies and their industrial relevance."
    }
  ],
