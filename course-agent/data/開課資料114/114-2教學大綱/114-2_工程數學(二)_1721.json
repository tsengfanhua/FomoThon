  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(二)",
    "sub_ename": "ENGINEERING MATHEMATICS(2)",
    "describe_ch": "教導學生解決工程及應用科學中相關問題所需之基礎數學。課程內容主要涵蓋向量微積分學、傅利葉級數及偏微分方程式。",
    "describe_eh": "This course aims to teach students the fundamental mathematics for solving engineering and applied science related problems. The course content mainly contains vector calculus, Fourier series and partial differential equations.",
    "pre_subname": "MATH1001微積分(一)、MATH1005微積分(一)、MATH1002微積分(二)、MATH1006微積分(二)、MATH1001P微積分(一)實習",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1005 CALCULUS(1)、MATH1002 CALCULUS(2)、MATH1006 CALCULUS(2)、MATH1001P RECITATION OF CALCULUS (1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解梯度、旋度、散度的幾何意義或物理意義。",
      "describe_en": "To recognize the geometric or physical meanings of gradient of scalar functions, curl and divergence of vector functions."
    },
    {
      "seq": 2,
      "describe_ch": "學習如何應用梯度、旋度、散度於流體力學或其他領域。",
      "describe_en": "To learn how to use the operators of gradient, curl and divergence in fluid mechanics and other fields."
    },
    {
      "seq": 3,
      "describe_ch": "學習如何計算線積分、雙重積分、面積分、體積分。",
      "describe_en": "To learn how to evaluate line integrals, double integrals, surface integrals and volume integrals."
    },
    {
      "seq": 4,
      "describe_ch": "熟悉各種積分的基本應用。",
      "describe_en": "To know the general applications of all kinds of integrals."
    },
    {
      "seq": 5,
      "describe_ch": "熟悉上述各種積分之間的重要轉換原理。",
      "describe_en": "To know the important theorems relates an integral mentioned previously to another integral."
    }
  ],
