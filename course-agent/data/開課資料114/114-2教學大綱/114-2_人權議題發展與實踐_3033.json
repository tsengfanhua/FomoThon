  "description": {
    "sub_id3": null,
    "sub_name": "人權議題發展與實踐",
    "sub_ename": "DEVELOPMENT AND PRACTICE OF HUMAN RIGHTS ISSUES",
    "describe_ch": "本課程旨在使同學們能對於人權意識與相關國際公約發展之理論與概念的理解與建構，提升對人權議題問題之分析與解決能力，培養參與相關人權議題活動之核心素養能力。以期促使學生意識到個人尊嚴及尊重他人的重要性，進而承擔個人權利與責任、社會責任、全球責任的理解與實踐。\n本課程應對SDGs 4.7細項目標。",
    "describe_eh": "This course aims to enable students to understand and construct the theory and concept of human rights awareness and the development of related international conventions, improve their ability to analyze and solve human rights issues, and cultivate their core competencies to participate in activities related to human rights issues. The goal is to promote students to realize the importance of personal dignity and respect for others, and then to undertake the understanding and practice of personal rights and responsibilities, social responsibilities, and global responsibilities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "協助學生對人權意識與相關國際公約發展之理論與概念的理解與建構。",
      "describe_en": "Assist students in understanding and constructing theories and concepts of human rights awareness and the development of relevant international conventions."
    },
    {
      "seq": 2,
      "describe_ch": "協助學生具備人權議題分析能力，實踐並運用批判思考。",
      "describe_en": "Equip students with the ability to analyze human rights issues, practice and apply critical thinking."
    }
  ],
