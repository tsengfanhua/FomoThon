  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CI02149",
    "sub_id": "38822",
    "scr_dup": "001",
    "sub_title": "深度學習的數學基礎以及人工智慧與智慧系統之應用與前瞻探索",
    "sub_title_en": null,
    "sub_describe": "本課程以「模型為何能被有效訓練（trainable）」作為貫穿全學期的探究主軸，從傳統機器學習的可分性與 SGD 出發，逐步推進到深度學習的鏈式法則與反向傳播，並延伸到卷積與序列模型的結構化運算，最後以 Transformer 與弱／自監督學習為現代主流方法，帶領學生進入頂會論文閱讀與研究表達。\n\n（一）從 Machine Learning 到 Deep Learning：把「SGD」推進到「Backprop」\n\n課程前段以 perceptron、SGD、線性可分與不可分問題為起點，讓學生理解「學習」的本質是最小化 loss 的優化過程；接著透過 MLP 的 chain rule、activation function 與 loss back propagation，建立一套可重複使用的推導框架：模型＝函數組合；訓練＝梯度傳遞；更新＝optimizer。\n在此基礎上，引入 CNN 的 convolution operator、parameter sharing 與 receptive field，使學生理解卷積不是黑箱，而是將「局部線性運算」與「共享參數」嵌入模型結構，從而改變表徵能力與資料效率。對應課程設計，學生需完成「手寫 CNN loss backprop 並以無框架程式驗證」的探究作業，確保推導、程式與結果一致。\n\n（二）任務全景：用同一套基本元素理解 CV 與 NLP 的主要問題型態\n\n課程中段不以深入推導為主，而以「概論＋任務分解」引導學生看見：同樣的 loss、optimizer、CNN/RNN 等基本元件，如何發展出完整的應用任務版圖。\n在 CV 部分，課程依序涵蓋 image classification（ILSVRC / ImageNet 與典型模型）、object detection（one-/two-stage family 概念）、image segmentation（pixel-wise、mask-based、contour-based 方法），並延伸到 advanced CV（video object tracking / segmentation / recognition），讓學生建立「任務需求→輸出形式→模型結構→評估方式」的對應關係。\n在 NLP 部分，從 RNN 時代的 sequence modeling、language modeling、LSTM 出發",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "深度學習概論",
    "sub_ename": "INTRODUCTION OF DEEP LEARNING",
    "describe_ch": "本課程將介紹深度學習的概念與架構，並且透過程式設計實現深度學習神經網路的模型，讓同學們發揮創意產出深度學習神經網路的相關應用，達到落地應用的目的。",
    "describe_eh": "This course will introduce the concept and architecture of deep learning and realize deep-learning neural networks through programming design. So that students can implement innovative applications in real life using deep-learning neural networks.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "反向傳播算法(BP algorithm)的基本認知",
      "describe_en": "Basic knowledge of the back propagation (BP) algorithm"
    },
    {
      "seq": 2,
      "describe_ch": "將觀測值依據特定目標數值化(如影像表示為RGB強度值向量、汙水程度表為透明度、酸鹼值等)",
      "describe_en": "Numericalize observations against a specific target"
    },
    {
      "seq": 3,
      "describe_ch": "應用深度學習演算法進行分類、回歸問題計算",
      "describe_en": "Applying deep learning algorithms for classification and regression problems"
    }
  ],
