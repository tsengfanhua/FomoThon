  "description": {
    "sub_id3": null,
    "sub_name": "義大利文化與歌劇的發展",
    "sub_ename": "ITALIAN CULTURE AND THE DEVELOPMENT OF OPERA",
    "describe_ch": "本課程希望引導學生認識義大利文化與其在西方歌劇發展上所具有的地位與影響，同時透過對西方歌劇具代表性創作者與其作品的閱讀及其實際表演方式的欣賞，使學生能對西方近代知名歌劇作品有更深入的認識，進而能了解西方歌劇藝術在西方文化發展史上的重大成就。",
    "describe_eh": "This course aims to lead students to learn the Italian culture and its impact on the development of western opera. Through reading scripts of masterpieces of western opera and their performances, students not only can learn them deeply, but also can understand the achievements of opera in the cultural development of the Western.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能認識義大利文化對西方歌劇發展所具有貢獻。",
      "describe_en": "To learn the contribution of Italian culture for the development of western opera."
    },
    {
      "seq": 2,
      "describe_ch": "能欣賞西方重要歌劇作品與其所展現的文化意涵。",
      "describe_en": "Be able to appreciate the great masterpieces of western opera and can understand their cultural implication."
    }
  ],
