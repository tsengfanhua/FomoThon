  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "XC04111",
    "sub_id": "GM674",
    "scr_dup": "001",
    "tpa_score_new": "<div>作業(30 %) 報告( 30 %) 其他(40 %) 請說明:平時成績(含討論報告及參加校內藝文活動)</div>\n",
    "tpa_score_new_en": " ",
    "course_pol": "準時點名，請使用學校系統請假\n缺課4次就當掉\n（缺課包含事假病假生理假，只要沒到課都是缺課。）\n 病假：\n　附上醫生證明\n 事假：\n只接受提早請假，要附上電話\n請假理由不正當不予受理",
    "course_pol_en": "◆ Attendance will be taken on time. Please submit leave requests through the school system if necessary.\n◆ If you are absent 4 times, you will fail the course.\n(All absences are counted, including personal leave, sick leave, and menstrual leave. Any absence from class is considered an absence.)\n\nSick Leave:\n◆ A doctor’s certificate must be provided.\n\nPersonal Leave:\n◆ Only advance requests are accepted. A contact phone number must be provided.\n◆ Leave requests with inappropriate reasons will not be accepted.",
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<div>需參加學校藝文活動的音樂會兩場，透過這門&quot;義大利文化與歌劇的發展&quot;的課程,讓我們一起進入音樂家真實的生活面,並透過他們畢生的經歷,進而瞭解他們偉大的創作。</div>\n",
    "ais_meno_en": "<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>\n<div>Students are required to attend two school-organized music concerts as part of this course. Through the subject <em>&ldquo;Italian Culture and the Development of Opera,&rdquo;</em> we are invited to explore the real lives of composers and musicians. By learning about their lifelong experiences, we can gain a deeper understanding of the great works they created.</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n",
    "ilearn_mk": "N"
  },
