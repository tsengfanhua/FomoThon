  "description": {
    "sub_id3": null,
    "sub_name": "生物技術",
    "sub_ename": "BIOTECHNOLOGY",
    "describe_ch": "本課程提供學生了解分子遺傳之知識，尤其著重於重組DNA以及DNA雜合之技術，與其應用於環境中作為偵測或鑑定特殊微生物之工具，及其產物之應用。",
    "describe_eh": "This course offers the students having an understanding of basic ideas from biochemistry, molecular genetics and microbiology. Especially emphasizes how recombinant DNA and DNA hybridization technology can be used to detect or identify bacteria in the environment as well as to create various useful products.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解由DNA至蛋白質之分子生物基本知識。",
      "describe_en": "Understand the theory of molecular biology, i.e. the relationship of DNA to protein."
    },
    {
      "seq": 2,
      "describe_ch": "理解由分子生物開發的各種方法技術，以及其應用範疇。",
      "describe_en": "Undersyand all the technologies related to molecular biology and the application of biotechnologies.　"
    },
    {
      "seq": 3,
      "describe_ch": "綜合資料收集，以書面方式表達所獲得之知識。",
      "describe_en": "Through the term papers to communicate wish classmates and instructors.　"
    }
  ],
