  "description": {
    "sub_id3": null,
    "sub_name": "韓國文化概論",
    "sub_ename": "INTRODUCTION TO KOREAN CULTURE",
    "describe_ch": "在本課程中，授課教師說明韓國文化的起源、發展與現代轉化進行結構性的理解，來讓同學們掌握傳統－現代－全球化之間的連結。",
    "describe_eh": "This course aims to help students gain a structured understanding of the origins, development, and modern transformations of Korean culture, and then to grasp the connections between tradition, modernity, and globalization.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
