  "description": {
    "sub_id3": null,
    "sub_name": "運輸工程",
    "sub_ename": "TRANSPORTATION ENGINEERING",
    "describe_ch": "此課程主要是介紹工程相關的管理與建設所需要的觀念與知識，領域包含公路工程、軌道工程、航空工程及海港工程等，課程內容將會以聯合國SDG的第11項目標，「永續城市與社區」，為主要發展方向。學生除了可以學習相關知識外，也會經由期末報告的撰寫過程訓練團隊合作，提升課題研析的能力。",
    "describe_eh": "This course mainly introduces the principle of necessary knowledge in the field of the highway, railway, airport, and harbor engineering; furthermore, this course also considers the 11th SDG goal, Sustainable Cities and Communities, as the future goal of the transportation environment. Students may learn knowledge and problem analyzing skills via making the final report of this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.教授各運輸或物流系統之特性與相關基本概念",
      "describe_en": "1.Provide students with knowledge of the characteristics and fundamental concepts of various transportation and logistics systems."
    },
    {
      "seq": 2,
      "describe_ch": "2.教授各運輸或物流系統之規劃、設計理論與實務概念",
      "describe_en": "2.Provide students with knowledge of the theories and practices of planning and design in transportation and logistics systems."
    },
    {
      "seq": 3,
      "describe_ch": "8.培養學生運用資料調查、數據分析或數學模型分析運輸或物流問題之能力",
      "describe_en": "8. Develop students' ability to analyze transportation and logistics problems using data collection, data analysis, or mathematical models."
    }
  ],
