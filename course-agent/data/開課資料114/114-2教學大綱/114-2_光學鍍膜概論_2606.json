  "description": {
    "sub_id3": null,
    "sub_name": "光學鍍膜概論",
    "sub_ename": "INTRODUCTION TO OPTICAL COATING",
    "describe_ch": "光學鍍膜是光電產業不可或缺的一環，且其應用範圍亦愈來愈廣泛。本課程主要會介紹光學鍍膜之基本理論、鍍膜機構造、各種鍍膜方法及膜層之改善等主題。",
    "describe_eh": "Optical coating is an important subject for opto-electronic industry and its applications are more extensive in recent years. The instructor will introduce the basic theory of optical coating, the structure of optical coating machine, the various methods of coating, and the improvement of coating layers in this course.",
    "pre_subname": "OPT2002光學(二)、PHYS1003普通物理(一)、PHYS1004普通物理(二)",
    "pre_sub_id3": "OPT2002",
    "pre_sub_ename": "OPT2002 OPTICS (2)、PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解光學鍍膜之基本理論。",
      "describe_en": "To understand the basic theory of optical thin film."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解光學元件有鍍膜與未鍍膜之差異，並具體實現其應用範圍。",
      "describe_en": "To understand the difference between coated and uncoated optical elements. Realize the limit and applications of optical coating."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解光學鍍膜製程及鍍膜方法，俾利將來就業。",
      "describe_en": "To understand the process of optical coating and the method of coating in order to apply the job in the future."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解光學鍍膜製程及鍍膜方法，俾利將來就業。",
      "describe_en": "To understand the process of optical coating and the method of coating in order to apply the job in the future."
    }
  ],
