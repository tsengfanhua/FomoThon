  "description": {
    "sub_id3": null,
    "sub_name": "物理化學實驗(二)",
    "sub_ename": "PHYSICAL CHEMISTRY LAB.(2)",
    "describe_ch": "物理化學實驗(二)主要內容包括化學反應動力學、電化學、化學及物理吸附等實驗之操作，藉由實驗結果驗證物理化學課程中各相關上述主題之學理，如化學反應速率常數和級數、離子遷移數之測定、各種吸附方法的解析等。",
    "describe_eh": "Physical Chemistry Lab(2) involves the experimental manipulations about the topics of chemical kinetics, electrochemistry, and chemical or physical adsorption etc.  The results of experimental data can be used to proof the theory of those topics, such as: rate constants and reaction orders of chemical reactions, transference number of ions in water, and Langmuir adsorption theory etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解化學相關實驗安全之重要性",
      "describe_en": "Understand the significant importance in the safety of chemical experiments"
    },
    {
      "seq": 2,
      "describe_ch": "熟習實驗操作技巧及設備之使用",
      "describe_en": "Be familiar with manipulating technique of experiments and instruments"
    },
    {
      "seq": 3,
      "describe_ch": "能自行撰寫實驗報告",
      "describe_en": "Be able to analyze the data from experimental"
    }
  ],
