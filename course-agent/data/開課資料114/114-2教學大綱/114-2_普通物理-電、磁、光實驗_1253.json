  "description": {
    "sub_id3": null,
    "sub_name": "普通物理-電、磁、光實驗",
    "sub_ename": "GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS LAB.",
    "describe_ch": "共安排15項實驗，包含電學、磁學與光學之實驗，也介紹兩項基礎測量工具：三用電表與示波器。其中包含三項電腦化實驗，彌補了傳統儀器難以探討的主題。",
    "describe_eh": "There are 15 experiments in this course, including the topics of electricity, magnetism, and optics. The course also introduces two fundamental measuring tools required in electromagnetism. Meanwhile, the course contains three computer-sensing experiments. Take the advantage of the sophisticated sensor, the computer-aided data acquisition experiments enable students to investigate topics such as electromagnetic induction, which are hardly observed by traditional equipments.",
    "pre_subname": "IEE1010普通物理-電、磁、光、IEE1011普通物理-電、磁、光實驗",
    "pre_sub_id3": "IEE1010",
    "pre_sub_ename": "IEE1010 GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS、IEE1011 GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS LAB.",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "驗證電學、磁學與光學的現象和定律。",
      "describe_en": "Verify the relations between phenomena and theories of electricity, magnetism, and optics."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉基礎量測儀器的操作。",
      "describe_en": "Be familiar with the operation of measuring instruments."
    },
    {
      "seq": 3,
      "describe_ch": "有分析與解釋實驗數據的能力",
      "describe_en": "Be able to analyze and interpret the experimental data"
    },
    {
      "seq": 4,
      "describe_ch": "具備實驗報告撰寫能力",
      "describe_en": "Be able to write lab reports."
    }
  ],
