  "description": {
    "sub_id3": null,
    "sub_name": "生產管理導論",
    "sub_ename": "INTRODUCTION TO PRODUCTION MANAGEMENT",
    "describe_ch": "針對企業或組織的經營與保持永續的競爭力，本課程關於現今生產與作業管理實務的重要議題提供學生系統性的觀點與架構，內容包含競爭力的理解、生產策略的擬訂、產品與服務的設計、生產系統的介紹、流程與瓶頸的管理等。",
    "describe_eh": "This course provides the introduction to fundamentals of production and operations management such as production strategies, product and service design, production systems, and process analysis and bottleneck management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
