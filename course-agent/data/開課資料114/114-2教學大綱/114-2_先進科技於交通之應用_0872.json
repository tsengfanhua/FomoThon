  "description": {
    "sub_id3": null,
    "sub_name": "先進科技於交通之應用",
    "sub_ename": "APPLICATION OF ADVANCED TECHNOLOGIES ON TRANSPORTATION",
    "describe_ch": "介紹先進科技的演進以及對於交通領域的影響，並說明先進科技導入傳統運輸系統之效益，使其運輸系統智慧化，運輸服務便利化。其中課程涉及先進交通管理系統、先進旅行者資訊系統、先進車輛控制及安全系統、商用車輛營運系統、先進大眾運輸系統、先進郊區運輸系統。",
    "describe_eh": "To introduce the evolution of advanced technology and the influence of advanced technologies on transportation. The benefit description of on advanced technology involves Advanced Traffic Management Systems (ATMS), Advanced Traveler Information Systems (ATIS), Advanced Vehicle Control and Safety Systems (AVCSS), Commercial Vehicle Operations (CVO), Advanced Public Transportation Systems (APTS), Advanced Rural Transportation Systems (ARTS).",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
