    {
      "seq": 1,
      "describe_ch": "強化學生獨立思考的分析及整合實務技術的專業管理能力",
      "describe_en": "To promote the professional management competence of independently thinking for analysis and comprehension on practical techniques"
    },
    {
      "seq": 2,
      "describe_ch": "訓練學生具備社會創新能力並落實專業倫理與社會責任",
      "describe_en": "To train for provision of social innovation and for fulfillment of professional ethics and social responsibility"
    }
