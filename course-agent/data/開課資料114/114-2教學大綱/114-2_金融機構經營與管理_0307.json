  "description": {
    "sub_id3": null,
    "sub_name": "金融機構經營與管理",
    "sub_ename": "FINANCIAL INSTITUTIONS MANAGEMENT",
    "describe_ch": "本課程著重於金融機構之風險管理，主要內容包括：金融機構經營概論、利率風險之衡量與管理、市場風險之衡量與管理、流動性風險之衡量與管理、營運風險的衡量與管理、銀行監理與存款保險。",
    "describe_eh": "This course focuses on the risk analysis and risk management of financial institutions. Topics include the introduction of financial institution operations, measurement and management of interest rate risk, market risk, liquidity risk, and operation risk. Also include bank regulations and deposit insurance.",
    "pre_subname": "FINA2030財務管理(一)、FINA2031財務管理(二)",
    "pre_sub_id3": "FINA2030",
    "pre_sub_ename": "FINA2030 FINANCIAL MANAGEMENT(1)、FINA2031 FINANCIAL MANAGEMENT(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解金融機構經營與管理涵蓋的主要內容。",
      "describe_en": "Comprehension for the content of Financial Institutions Management."
    },
    {
      "seq": 2,
      "describe_ch": "能應用有效的口語、書寫表達，於專業職場環境中。",
      "describe_en": "Application for oral communication and writing communication sufficient for general business environment."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解市場風險的衡量與管理之方法",
      "describe_en": "Understand how to measure and manage the market risk."
    },
    {
      "seq": 4,
      "describe_ch": "能瞭解流動性風險的衡量與管理之方法",
      "describe_en": "Understand how to measure and manage the liquidity risk."
    }
  ],
