    "scr_dup": "001",
    "tpa_score_new": "<div>平時成績：50% = [課堂參與 20%] + [小考或作業 10% (2次)] + [專題報告 20%] 期中考 20% 期末考 30%</div>\n",
    "tpa_score_new_en": " ",
    "course_pol": "課堂上不允許以任何方式影響其他同學上課的權益，缺席超過1/2點名次數平時成績將歸0，作業請準時繳交不接受補交，如有不可抗拒之因素缺席考期中、期末考請提前告知並獲得老師同意。",
    "course_pol_en": null,
    "course_rem": "期末報告如有分組請同學在報告繳交時附上組內分工與自評分數並全組同學簽名。",
    "course_rem_en": null,
    "ais_meno": "<div>可以使用各種合法工具收集資料、但必須詳列資料與參考資料來源與查證，嚴禁抄襲與瞟竊他人之著作，如有違反將依學校規定處置。</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": "Y"
  },
