  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "PC04100",
    "sub_id": "98090",
    "scr_dup": "001",
    "sub_title": "行政法基礎理論",
    "sub_title_en": null,
    "sub_describe": "行政法為基礎法學，包含總則、基本原理、行政組織法、行政作用法、行政救濟法等",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "行政法",
    "sub_ename": "ADMINISTRATIVE LAW",
    "describe_ch": "行政法係研究政府活動之一種法學，行政乃立法、司法以外，國家為實現其任務而遵循\n法律規範之行為或其他公權力之行為，行政法並非一種法律名稱，而係研究此項法律之\n一種總合。亦即各種行政法規之整體研究，包含總則原理及分則各論。\n",
    "describe_eh": "Administrative Law is a branch of legal research that studies governmental activities, it is established, other than legislature and jurisdiction, for the nation to comply with its main statutes and other authorization right. Administrative Law is not a legal title, but the integration of the legal researches on this law. Also, it is a general researching of all administrative legislation, including the principles of general rules and separating into specifically details.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生獲得行政法之基本智識，其重要者為：基本原理、行政法之範圍、全盤\r\n概念。\r\n",
      "describe_en": "To acquire basic intellectual of Administrative Law, including the basic principal, overall concept."
    },
    {
      "seq": 2,
      "describe_ch": "將行政法之各種原理，應用在日常生活中、學生事務上、社會現象、政府部門事務。",
      "describe_en": "Apply each principles of Administrative Law in daily life, student's affairs, social phenomenon and government department affairs."
    },
    {
      "seq": 3,
      "describe_ch": "使學生具備綜合能力，對於法律產生興趣，啟發學生參加國家相關法律類科就業考試，進入政府部門工作。",
      "describe_en": "To acquire the comprehensive ability, and inspiring to study and research. Joining the public employment by learning."
    }
  ],
