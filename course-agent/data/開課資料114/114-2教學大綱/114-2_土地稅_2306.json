  "description": {
    "sub_id3": null,
    "sub_name": "土地稅",
    "sub_ename": "LAND TAXATION",
    "describe_ch": "協助學生了解包含地價稅、土地增值稅、房屋稅、契稅、遺產稅及贈與稅之現行規定、計算方式及政策意義。",
    "describe_eh": "To assist students in understanding the current regulation, calculation and policy implication of land value tax, land value increment tax, housing tax, contract tax, gifts tax and inheritance tax.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
