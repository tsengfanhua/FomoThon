  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解如何蒐集資料、執行實驗與詮釋數據。\r\n",
      "describe_en": "To learn how to collect materials and information, carry out an research design, and analyze the data."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解論文撰寫技巧。",
      "describe_en": "To learn the skills of writting a thesis."
    },
    {
      "seq": 3,
      "describe_ch": "練習組織發表與演說報告。\r\n",
      "describe_en": "To drill the abilities in organization and present their research results."
    }
  ],
