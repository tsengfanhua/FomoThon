  "description": {
    "sub_id3": null,
    "sub_name": "材料力學",
    "sub_ename": "MECHANICS OF MATERIALS",
    "describe_ch": "說明各種型式之載重作用於結構構件時，材料如何發揮其相關性質，以對應內力分佈與變形間之相互關連，提供對建築結構問題的設計與分析之適當基礎。",
    "describe_eh": "This course provides the students with a basic knowledge of structural materials, which will present internal forces to resist applied force when is loaded by forces of tensile, compression, shear and moment. The relationships between the stress and strain within the structural materials also will be explained.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能認識材料之基本力學性質與定義",
      "describe_en": "Understand basic mechanics property and definition of materials."
    },
    {
      "seq": 3,
      "describe_ch": "能分析靜定梁的內力分佈及變形關係",
      "describe_en": "Be able to analysis the relationship of internal forces and deformation of statically determinate beams."
    }
  ],
