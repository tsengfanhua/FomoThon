  "description": {
    "sub_id3": null,
    "sub_name": "ESG與高階專案管理",
    "sub_ename": "ESG AND ADVANCED PROJECT MANAGEMENT",
    "describe_ch": "藉由系統化的知識傳授讓學生認識高階專案管理(專案集管理、專案組合管理)與ESG（E，環境保護、S，社會責任、G，公司治理），接著透過案例互動討論的方式來瞭解兩者如何整合應用，最後指導學生撰寫相關規劃書。",
    "describe_eh": "At first, to teach the knowledge of Advanced Project Management(Program Management, Portfolio Management) and ESG（E，Environment、 S，Social 、G，Governance）. And then, to apply Advanced Project Management in ESG. Second part to help the students to develop an Advanced Project Management Plan with ESG.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解高階專案管理(如: 專案集管理、專案組合管理等)基本知識。",
      "describe_en": "To know the basic knowledge of Advanced Project Management."
    },
    {
      "seq": 2,
      "describe_ch": "具備撰寫高階專案管理(專案集管理、專案組合管理)ESG規劃書的能力。",
      "describe_en": "An ability to design Advanced Project Management with ESG."
    },
    {
      "seq": 3,
      "describe_ch": "ESG的案例經驗學習。",
      "describe_en": "Analysis of ESG lessons learn."
    }
  ],
