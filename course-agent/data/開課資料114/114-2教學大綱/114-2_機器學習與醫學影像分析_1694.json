  "description": {
    "sub_id3": null,
    "sub_name": "機器學習與醫學影像分析",
    "sub_ename": "MACHINE LEARNING FOR MEDICAL IMAGE ANALYSIS",
    "describe_ch": "本課程介紹臨床上常用的醫學影像之成像原理，以及機器學習和數位影像處理在醫學影像中的應用了解醫學成像原理是醫學圖像處理的第一步，因為不同模態下的圖像強度呈現出不同的生理特徵課程除介紹醫學影像，還應用機器學習和數位影像處理於醫學影像分析，包括二維空間域和頻域理論，以及圖像對比度增強、圖像復原、圖像分割、圖像形態學和醫學圖像分類本課程不僅是理論介紹，而且使用電腦程式實際執行。",
    "describe_eh": " This course introduces medical imaging principles, and machine learning and digital image processing in medical imaging. Understanding the medical imaging principle is the first step for medical image processing because the image intensity on different modalities presents different physiological characteristics. The patterns of pictures can be recognized using machine learning techniques that can be applied to medical images for the prediction or diagnosis of diseases.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具有醫學影像成像原理、數位影像處理、和機器學習知識。",
      "describe_en": "Knowledge on medical imaging principle, digital image processing, and machine learning."
    },
    {
      "seq": 2,
      "describe_ch": "能了解數位影像處理和機器學習知識於醫學影像的應用。",
      "describe_en": "To understand the application of digital image processing and machine learning knowledge to medical imaging."
    },
    {
      "seq": 3,
      "describe_ch": "能執行數位影像處理、和機器學習分析醫學影像。",
      "describe_en": "Ability to perform digital image processing and machine learning to analyze medical images."
    }
  ],
