  "description": {
    "sub_id3": null,
    "sub_name": "伺服控制(含實驗)",
    "sub_ename": "SERVO CONTROL (WITH EXPERIMENT)",
    "describe_ch": "了解什麼是與馬達(包括直流、同步、感應、步進和線性馬達)有關的伺服控制，說明在嵌入式的運動控制單元、驅動器或者PC電腦上如何實現伺服控制。",
    "describe_eh": "To understand what are motors(including DC、Synchronous、Inductive、Step and Linear motors) and the related servo controls which are embedded in motion controller or driver or PC computer.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用微處理機基礎以瞭解可程式控制系統基本知識",
      "describe_en": "Apply microprocessor foundation to understand the basic knowledge about programmable control systems."
    },
    {
      "seq": 2,
      "describe_ch": "理解可程式控制系統各項性能的定義與定理",
      "describe_en": "Comprehension for the definitions or theories of programmable control  system performance."
    },
    {
      "seq": 3,
      "describe_ch": "應用分析設計軟體對可程式控制系統完成分析與設計",
      "describe_en": "Application for the simulation software to programmable analysis and design."
    }
  ],
