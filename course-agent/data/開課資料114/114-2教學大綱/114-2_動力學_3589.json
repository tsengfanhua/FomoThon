  "description": {
    "sub_id3": null,
    "sub_name": "動力學",
    "sub_ename": "DYNAMICS",
    "describe_ch": "學習質點與剛體運動學，包括位置、速度及加速度等。學習質點與剛體動力學，包括牛頓第二運動定律、功與能量、衝量與動量等。。",
    "describe_eh": "Study of the kinematics of particles and rigid bodies, including position, velocity and acceleration. Kinetics of particles and rigid bodies, including Newton's 2nd law of motion, work and energy, impulse and momentum.",
    "pre_subname": "CEM1006微積分、ENGS1006應用力學",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS、ENGS1006 APPLIED MECHANICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解工程動力學之基本觀念。",
      "describe_en": "Learn the fundamental concepts of engineering dynamics."
    },
    {
      "seq": 2,
      "describe_ch": "能建立動力學問題之數學模型。\n",
      "describe_en": "Learn the mathematical formulations of dynamics problems."
    },
    {
      "seq": 3,
      "describe_ch": "能分析質點與剛體之動力學應用問題。",
      "describe_en": "Analyze the dynamics of particles and rigid bodies with application."
    },
    {
      "seq": 4,
      "describe_ch": "學會應用於動力學及座標轉換之向量代數及向量微積分。",
      "describe_en": "To study vector algebra and vector calculus in dynamics and transformation of coordinates."
    },
    {
      "seq": 5,
      "describe_ch": "學會不同坐標下之質點運動學及剛體運動學。",
      "describe_en": "To study the kinematics of particles in various coordinates and kinematics of rigid bodies."
    },
    {
      "seq": 6,
      "describe_ch": "學會質點及剛體動力學-牛頓運動定律。",
      "describe_en": "To study the kinetics of a particle and a rigid body under Newton laws of motion."
    },
    {
      "seq": 7,
      "describe_ch": "學會質點及剛體動力學另一型式-功與能量、衝量與動量。",
      "describe_en": "To study the kinetics of a particle and a rigid body in alternate forms: work and energy, impulse and momentum."
    }
  ],
