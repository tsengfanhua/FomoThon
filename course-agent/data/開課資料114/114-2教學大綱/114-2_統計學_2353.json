  "description": {
    "sub_id3": null,
    "sub_name": "統計學",
    "sub_ename": "STATISTICS",
    "describe_ch": "這是統計入門的課程，也是機率論的延續課程。建立在機率觀念原理的基礎上，進一步介紹抽樣分配與中央極限定理，以及基本統計方法之運用。內容包括母體參數的點估計、區間估計和統計假設檢定，過程中也透過統計分析工具加以說明。",
    "describe_eh": "This is an introductory course in statistics and a continuation course in probability theory. Based on the principle of probability theory, it further introduces sampling distribution and the central limit theorem, as well as the application of basic statistical methods. Topics will be included the point estimation, interval estimation and statistical hypothesis testing. The process will also be explained by ?statistical software.",
    "pre_subname": "MATH2011機率論",
    "pre_sub_id3": "MATH2011",
    "pre_sub_ename": "MATH2011 PROBABILITY",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解樣本分配與中央極限定理的概念\r\n\n",
      "describe_en": "Comprehension for the concepts of the sampling distribution and the central limit theorem.\r\n"
    },
    {
      "seq": 2,
      "describe_ch": "理解母體參數的估計方法",
      "describe_en": "Comprehension for the methods used at the estimation of population parameters.\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "理解母體參數的假設檢定方法\n",
      "describe_en": "Comprehension for the methods used at the hypothesis testing of population parameters.\r\n\n"
    },
    {
      "seq": 4,
      "describe_ch": "理解兩樣本的估計及檢定方法",
      "describe_en": "Comprehension for the methods used at the estimation and the hypothesis testing for two samples.\r\n"
    }
  ],
