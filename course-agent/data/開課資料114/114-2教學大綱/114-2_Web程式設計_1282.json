  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 2.0,
    "cls_id": "CE07129",
    "sub_id": "11592",
    "scr_dup": "001",
    "sub_title": "全端網頁應用程式開發實務",
    "sub_title_en": null,
    "sub_describe": "透過 HTML、CSS、JavaScript 等前端技術，結合 Node.js、Express.js 與 SQLite 後端開發，以及 Vue 前端框架，探究如何建構完整的網頁應用程式，並培養學生前後端整合與實務專題開發能力。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "Web程式設計",
    "sub_ename": "WEB PROGRAMMING",
    "describe_ch": "本課程主要目的是教導學生開發Responsive Web應用程式的知識與能力。Responsive Web設計可以針對不同的裝置提供相對應的呈現與使用方式。本課程將以Web應用程式前端相關語言、技術、功能以及Responsive Web設計方法進行介紹與實作演練。在完成此一課程後，學生將能夠應用所學的程式語言、軟體架構與開發工具來實作高品質與良好使用者體驗的Web應用程式。",
    "describe_eh": "The purpose of this course is to teach students knowledge and skills of the development of Responsive Web applications. Responsive Web design can provide adaptive user interfaces according to various devices. This course presents introductions and practices including relevant languages, technologies and responsive designs required for building Web applications. Upon completion of this course, students can leverage the languages, software architectures and tools to develop applications with high quality and good user experience.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解Responsive Web應用程式開發知識與技術",
      "describe_en": "Understand key knowledge and techniques of the development of responsive Web applications"
    },
    {
      "seq": 2,
      "describe_ch": "應用Responsive Web應用程式開發於學期專案中",
      "describe_en": "Realize how to apply advanced programming skills of responsive Web applications in the term project"
    },
    {
      "seq": 3,
      "describe_ch": "應用網際網路為基礎之程式設計技巧於學期作業中",
      "describe_en": "Realize how to apply web-based programming skills in the assignments"
    }
  ],
