  },
  "targets": [
    {
      "seq": 6,
      "describe_ch": "能理解都市規劃分析技術與方法",
      "describe_en": "Be able to comprehend analytical methods and techniques of urban planning.\r\n"
    },
    {
      "seq": 7,
      "describe_ch": "能應用都市規劃分析技術與方法於都市規劃實務",
      "describe_en": "Be able to apply analytical methods and techniques to practical urban planning."
    },
    {
      "seq": 8,
      "describe_ch": "能應用都市規劃分析技術與方法於區域規劃",
      "describe_en": "Be able to apply analytical methods and techniques to regional planning."
    },
    {
      "seq": 9,
      "describe_ch": "建立橫向課程與領域專業技能的溝通聯繫",
      "describe_en": "To establish the interaction between academic research and professional practice"
    },
    {
      "seq": 10,
      "describe_ch": "兼顧專業實踐、學術研究及證照考試之教學課程",
      "describe_en": "To prepare students for professional examinations.\t"
    }
  ],
