  "description": {
    "sub_id3": null,
    "sub_name": "行銷管理",
    "sub_ename": "MARKETING MANAGEMENT",
    "describe_ch": "本課程為行銷基礎課程，其內容在於理論與實務之介紹，其中包括了行銷系統之架構、行銷組織、行銷環境、策略性規劃、市場區隔及目標市場之選定與行銷組合策略等。在教學上應以理論及實際案例為主，一一介紹及敘述，讓學生能在簡單而易明暸情況下，得到應有的行銷知識。",
    "describe_eh": "The course is the basic course of marketing. It focuses on the introduction of theory and practice. Topics include marketing system structure, marketing organization, marketing environment, strategic planning, market segmentation, choice of target market and strategy of marketing mix, and etc. The instruction focuses on theories and practical cases. Students can learn marketing knowledge that they should have by following the instruction given in the classroom.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備用書面與口頭簡報說明行銷策略之能力",
      "describe_en": "To Have Appropriate Written Communication and Oral Presentation Skill in Relation to Marketing Strategy"
    },
    {
      "seq": 2,
      "describe_ch": "能結合行銷管理理論與企業社會責任以提升品牌權益",
      "describe_en": "To Integrate Marketing Management Theory with CSR to Increase Brand Equity"
    }
  ],
