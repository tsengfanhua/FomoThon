  "description": {
    "sub_id3": null,
    "sub_name": "跨領域畢業專題(一)",
    "sub_ename": "INTERDISCIPLINARY GRADUATION PROJECT(1)",
    "describe_ch": "本課程讓本院學生與跨院學生共同製作畢業專題，專題融入聯合國永續發展目標(SDGs)以接軌國際，並培養學生跨領域合作能力及為未來就業做準備。",
    "describe_eh": "To provide college students collaborating with interdisciplinary students to finish graduation project which integrates with United Nations Sustainable Development Goals (SDGs) to achieve international integration. Simultaneously, to train students possessing interdisciplinary collaboration ability and preparing for future employment.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過專題實作學習與同儕間協調工作範疇以共同解決癥結所在",
      "describe_en": "To collectively overcome bottleneck through project practical learning and trade-off between teammates for research category."
    },
    {
      "seq": 2,
      "describe_ch": "問題分析與獨立思考能力",
      "describe_en": "Problem analysis and independent thinking ability"
    },
    {
      "seq": 3,
      "describe_ch": "能與同儕協調溝通，能訂定預期的成效，能依據專題研究的執行及結果，撰寫成書面報告並做成口頭報告。",
      "describe_en": "Be able to communicate and cooperate with teammate to conduct the study. Be able to estimate the final results expected and be able to make written reports and oral presentations."
    },
    {
      "seq": 4,
      "describe_ch": "能由專題研究的學習過程，理解專業倫理及社會責任",
      "describe_en": "Be able to comprehend the vocational ethics and responsibility of engineers on the whole society during the learning period."
    }
  ],
