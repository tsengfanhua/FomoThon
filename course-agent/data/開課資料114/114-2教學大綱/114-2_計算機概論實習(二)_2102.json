  "description": {
    "sub_id3": null,
    "sub_name": "計算機概論實習(二)",
    "sub_ename": "THE  PROGRAMMING LABORATORY(2)",
    "describe_ch": "實際上機講解並指派作業演練，訓練電腦的各項基本應用技能以及解決問題的技巧，同時配合計算機概論課程之進度及內容，以上機實做的方式演練各項程式設計的觀念及技術。",
    "describe_eh": "By examining the operations of various applications on computer step by step to accumulate the actual experience about computer usage. Training the techniques of various applications and the methods for resolving problems. Furthermore, the course is scheduled to cooperate with the progress of the course, \"Introduction to Computer Science(2)\", for establishing various techniques of programming.",
    "pre_subname": "IEE1002計算機概論實習(一)",
    "pre_sub_id3": "IEE1002",
    "pre_sub_ename": "IEE1002 THE  PROGRAMMING LABORATORY(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1介紹計算機及網路相關軟體應用基本術語及觀念，使學生能以專業的詞彙做溝通",
      "describe_en": "1. To introduce the basic technology terms related to computer applications and network to help students to communicate with professional engineer."
    },
    {
      "seq": 2,
      "describe_ch": "2 使學生瞭解各種計算機的基本運用技能",
      "describe_en": "2. To teach students familiar to the techniques about the usage of various applications."
    },
    {
      "seq": 3,
      "describe_ch": "3使學生能瞭解軟體在計算機系統運作所扮演的角色，以及相關的操作理念",
      "describe_en": "3. The knowledge about computer software is introduced to make students to understand the related issues about computer applications."
    },
    {
      "seq": 4,
      "describe_ch": "4. 以C及C++語言的程式設計練習，使學生熟習基本的程式設計語法及觀念技巧",
      "describe_en": "4. By assigning the programming examinations in C and C++ language to establish the basic capability about programming."
    },
    {
      "seq": 5,
      "describe_ch": "5. 訓練學生程式設計的邏輯思維，建立日後專業程式撰寫的基礎",
      "describe_en": "5. Training the capability of logic reasoning and building the basics for professional programming."
    },
    {
      "seq": 6,
      "describe_ch": "6. 增進學生以專業的知識思維以解決問題，奠定優良的工程師專業素養",
      "describe_en": "6. To improve students' ability for professional thinking and to establish good features to be a good engineer."
    }
  ],
