  "description": {
    "sub_id3": null,
    "sub_name": "人力資源管理",
    "sub_ename": "HUMAN RESOURCES MANAGEMENT",
    "describe_ch": "本課程探討人力資源在企業/組織扮演的重要性和關鍵角色。因此，本課程將重點介紹 人力資源管理的重要概念和精實，即包含了招聘、選才、培訓、績效評估、薪酬與福利等議題。同學也將在具互動的環境中學習本課程，並學習將理論與實務的運用連結起來。\r\n",
    "describe_eh": "This course explores the central, strategic role that HR plays in making organizations competitive. This course focuses on the concepts and practices of human resource management, namely recruitment and selection of employees, equal opportunity, training and development, performance appraisals, compensation and benefits issues. Participants will study the subject in a highly interactive classroom environment and be required to connect their learning with real world experience in human resource management.",
    "pre_subname": "MGT1001管理學、MGT1002企業概論",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT、MGT1002 INTRODUCTION TO BUSINESS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 3,
      "describe_ch": "理解人力資源管理理論與實務。",
      "describe_en": "Comprehending the theory and practice of human resource management."
    },
    {
      "seq": 4,
      "describe_ch": "理解人力資源管理理論與實務。",
      "describe_en": "Comprehending the theory and practice of human resource management."
    },
    {
      "seq": 5,
      "describe_ch": "應用人力資源管理知識於跨領域學習。",
      "describe_en": "To apply the knowledge of human resource management for interdisciplinary practice."
    }
  ],
