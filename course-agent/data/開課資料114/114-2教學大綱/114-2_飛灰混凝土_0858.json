    "sub_name": "飛灰混凝土",
    "sub_ename": "FLY ASH CONCRETE",
    "describe_ch": "介紹飛灰使用於混凝土中之基本性質與配比設計，期使學生對飛灰混凝土有深入之瞭解，並推廣飛灰混凝土之使用。",
    "describe_eh": "Introduce the essential properties and mixture designing of fly ash and how to use it in concrete.",
    "pre_subname": "CE2072工程材料、CEM2090工程材料",
    "pre_sub_id3": "CE2072",
    "pre_sub_ename": "CE2072 ENGINEERING MATERIALS、CEM2090 ENGINEERING MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解飛灰的基本性質。",
      "describe_en": "Be able to understand the fundamental properties of fly ash concrete."
