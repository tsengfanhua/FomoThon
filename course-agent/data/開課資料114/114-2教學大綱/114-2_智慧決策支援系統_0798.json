  "description": {
    "sub_id3": null,
    "sub_name": "智慧決策支援系統",
    "sub_ename": "INTELLIGENCE DECISION SUPPORT SYSTEM",
    "describe_ch": "本課程目的在介紹決策支援系統的知識與技術，以及智能化決策支援系統發展趨勢與應用關鍵，並完成案例實作，以期望未來同學可以將決策支援系統應於企業之中。",
    "describe_eh": "The purpose of this course is to introduce the knowledge and technology of decision support systems, as well as the development trend and key applications of intelligent decision support systems. With complete case implementations, in the hope that students can apply decision support systems to enterprises in the future.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "介紹引導學生瞭解電腦化決策支援系統理論、技術、系統、架構與應用",
      "describe_en": "Introduce and guide students to understand the theory, technology, system, architecture and application of computerized decision support systems"
    },
    {
      "seq": 2,
      "describe_ch": "培養學生於電腦化決策支援系統技術方法之應用與研究的基本能力。",
      "describe_en": "Cultivate students' basic abilities in the application and research of computerized decision support system technology methods."
    },
    {
      "seq": 3,
      "describe_ch": "以產業別特性與企業案例需求，綜合設計與實作體驗智慧決策支援系統",
      "describe_en": "Based on industry-specific characteristics and corporate case requirements, comprehensively design and implement a smart decision support system for experience"
    }
  ],
