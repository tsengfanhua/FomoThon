  "description": {
    "sub_id3": null,
    "sub_name": "機構學",
    "sub_ename": "MECHANISMS",
    "describe_ch": "由機構的定義和概念著手，討論機構的類型、連接形式，據此探討機構的運動形式，並介紹如何計算自由度。並更進一步介紹如何分析以及計算機構的運動狀態，推導運動方程式，並介紹如何設計以及組成機構。並介紹幾種常見機械元件構造與其運動模態，包括凸輪，齒輪，三維運動的連桿機構運動分析，設計方法，以及機構組成和應用。",
    "describe_eh": "Wish the students with the ability to analyze the kinematics of fundamental mechanism. How to calculate the degree of freedom of mechanism and use graphical and analytical methods to analyze the position, velocity and acceleration of mechanism is introduced. How to synthesis the mechanism is also introduced. And introduce mechanisms of spatial linkages, cams and gears. Wish the students with the ability to analyze the kinematics of mechanisms of spatial linkages, cams and gears. Model the geometry of the mechanisms and analyze the kinematics of these mechanisms is goals of this course. It also introduces how to design of these mechanisms.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 4.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解機構基本概念，並能分析機構自由度。",
      "describe_en": "Comprehend basic concepts of mechanism, and be able to analyze degree of freedom of mechanisms."
    },
    {
      "seq": 2,
      "describe_ch": "能分析連桿運動狀態",
      "describe_en": "Be able to analyze motion conditions of mechanisms."
    },
    {
      "seq": 3,
      "describe_ch": "理解凸輪設計原理。",
      "describe_en": "Comprehend design theorem of cams."
    },
    {
      "seq": 4,
      "describe_ch": "理解齒輪設計原理。",
      "describe_en": "Comprehend design theorem of gears."
    },
    {
      "seq": 5,
      "describe_ch": "理解齒輪組傳動方式，並能計算速比。",
      "describe_en": "Comprehend transmission concepts of gear trains, and be able to calculate velocity ratio."
    }
  ],
