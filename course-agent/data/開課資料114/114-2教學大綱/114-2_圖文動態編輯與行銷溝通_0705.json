  "description": {
    "sub_id3": null,
    "sub_name": "圖文動態編輯與行銷溝通",
    "sub_ename": "MOTION GRAPHIC & MARKETING COMMUNICATION",
    "describe_ch": "品牌的行銷與推廣需要的是多種媒體的運用與結合。本課程著重於平面影像處理實作與觀念解說，來提升學生的影像視覺設計能力，同時培養學生掌握影像、動態編輯與版面編排的應用，以引導同學完成整合性行銷設計作品。",
    "describe_eh": "Brand marketing and promotion need to use and combination of multiple media, and Adobe Creative Suite (CS) is a discontinued software suite of digital image processing (Photoshop), vector computer graphics (Illustrator), video editing (Premiere), and motion graphic (After Effects). This course focuses on image processing and image related design applications. \r\nThis course focuses on image processing and image related design, vector graphics, motion graphic and layout design, and they will complete integrated marketing design works.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "訓練影像處理的邏輯思考觀念及知識",
      "describe_en": "Training the concept and knowledge of logical thinking in image processing."
    },
    {
      "seq": 2,
      "describe_ch": "培養影像處理的各種表現技法及綜合應用",
      "describe_en": "Training image processing of a variety of performance techniques and integrated applications."
    },
    {
      "seq": 3,
      "describe_ch": "培養影像處理的各種表現技法及綜合應用",
      "describe_en": "Training image processing of a variety of performance techniques and integrated applications."
    }
