  "description": {
    "sub_id3": null,
    "sub_name": "太陽能模組開發與系統設計",
    "sub_ename": "PV MODULE DEVELOPMENT AND SYSTEM DESIGN",
    "describe_ch": "此課程的重點在於從材料端出發到產品設計及終端應用。理解太陽能模組的基本電路設計、材料組成、產品製作、老化分析及可靠度試驗後，進一步結合目前的最新發展，包含BIPV、BAPV、VAPV等光電解決方案，來思考不同領域的應用性，同時解說IEC國際法規及專利解析，了解何謂“產品開發”及“客戶需求” ，達到學以致用。",
    "describe_eh": "The focus of this course is from material side to product design and system applications. The content includes basic circuit design, material composition, product manufacturing, aging analysis and reliability testing of solar modules. It also combines the latest developments, including BIPV, BAPV, VAPV and other photovoltaic solutions to consider the applicability in different fields.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "太陽能模組基本組成與原理(包含基本電路、材料組成、製程方式)\t\r\n",
      "describe_en": "Basic composition and theory of PV module (Including basic circuit, material composition, and manufacturing method)"
    },
    {
      "seq": 2,
      "describe_ch": "產品信賴性及加速老化試驗(包含失效模式、戶外老化及風險評估)\r\n",
      "describe_en": "Product reliability and accelerated aging test (Including failure mode, outdoor aging and risk estimation)"
    },
    {
      "seq": 3,
      "describe_ch": "太陽能系統架構與設計(包含系統配件、案場介紹、併網迴路、自發自用等設計)\r\n",
      "describe_en": "PV system design(Including system accessories, field side introduction, off-grid and on-grid design)\r\n"
    },
    {
      "seq": 4,
      "describe_ch": "利基型太陽能模組的應用與發展(包含p型PERC、n型Topcon及目前MBB G12R電池片技術、BIPV、BAPV、VAPV等應用)\r\n",
      "describe_en": "Application and development of niche PV module (Including p-type PERC, n-type Topcon technology, MBB G12R cell development, BIPV, BAPV, VAPV and other application)"
    }
  ],
