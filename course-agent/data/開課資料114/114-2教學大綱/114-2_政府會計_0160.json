  "description": {
    "sub_id3": null,
    "sub_name": "政府會計",
    "sub_ename": "GOVERNMENTAL ACCOUNTING",
    "describe_ch": "政府施政績效須有一套管理工具而政府會計是現階段最重要的工具之一，本課程將分章介紹政府會計之原理並輔以實務，讓學生能對我國政府會計實務體系有一清晰之認識與瞭解，進而促成學生加入政府會計工作領域。",
    "describe_eh": "There must be a set of management tool in government's administrative performance but the governmental accounting is one of the most important tools at the present stage, the principle of the governmental accounting that this course will divide into the chapter to recommend and complementing with the practice, enable students to have a clear understanding and understand about the accounting practice system of our government, and then facilitate students to join the working field of governmental accounting.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能描述政府會計觀念性架構之用途。",
      "describe_en": "Describe the use of the idea structure of government accounting"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解並能用自己的詞彙定義政府會計之基本要素及假設",
      "describe_en": "Understand and define the basic element and assumption of the governmental accounting with one's own vocabulary"
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解並說明政府會計處理程序。",
      "describe_en": "Understand and state that deals with the procedure in governmental accounting"
    },
    {
      "seq": 4,
      "describe_ch": "能利用政府會計資訊以編製財務報表及進行分析。",
      "describe_en": "Utilize governmental accounting information in order to work out the financial statement and analyse"
    }
  ],
