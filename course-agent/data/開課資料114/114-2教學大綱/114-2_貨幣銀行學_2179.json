  "description": {
    "sub_id3": null,
    "sub_name": "貨幣銀行學",
    "sub_ename": "MONEY AND BANKING",
    "describe_ch": "本課程闡述貨幣與銀行對經濟體系貢獻（尤其對貨幣政策貢獻）。著重個人、企業與政府如何利用貨幣銀行體系達政策效果。配以相關時事議題深入剖析國際金融與國內金融，期達理論與實務相互配合。貨幣學方面著重貨幣創造機制及過程、貨幣理論與政策等；銀行學方面則著重金融機構與管理、商業銀行與中央銀行體系介紹等。以期末研究報告將理論與實務達相互配合之效。",
    "describe_eh": "This course introduces the contribution of Money and Banking to economic system It will provide students with the basic understanding of monetary economics, focus in th e creating process of deposit money, Asset & Liability management, monetary theories & policies, international banking system. Final research paper will be assigned to students during the semester. The purpose is to familiarize students with the theories & concepts learned from the class and apple them to the real world.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": " 能瞭解貨幣的本質與功能。",
      "describe_en": "Understand the nature and function of money."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解金融機構、金融資產與金融市場之功能。",
      "describe_en": "Understand the function of the financial institutions, financial assets, and financial markets."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解中央銀行的本質與角色。",
      "describe_en": "Understand the nature and role of central bank."
    },
    {
      "seq": 4,
      "describe_ch": "能以書面或口頭方式將所獲結果與同儕及教師溝通，並能透過小組展現團隊合作能力",
      "describe_en": " Communicate results in written or oral form to classmates and the instructor. Demonstrate esprit de corps (team spirit) through teamwork."
    }
  ],
