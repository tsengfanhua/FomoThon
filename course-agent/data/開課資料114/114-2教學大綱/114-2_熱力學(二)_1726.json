  "description": {
    "sub_id3": null,
    "sub_name": "熱力學(二)",
    "sub_ename": "THERMODYNAMICS(2)",
    "describe_ch": "此課程內容首先適切的呈現熱力學第二定理並介紹一種熱力學性質─熵。此外，將不可逆性與有效性也引入第二次定理去處理適當問題。內容中更包含動力與冷凍系統，在熱力學的關係式中產生Helmholtz和Gibbs函數。同樣有很多符合真實環境的實際範例來協助學生達到暸解熱力學的目的。",
    "describe_eh": "Entropy with the second law of thermodynamics are presented in the context where they are first relevant in natural progression. We have incorporated the use of the second law with the irreversibility and availability. Furthermore, the course includes power and refrigeration system, Helmholtz and Gibbs functions on thermodynamics\r\nrelations. Many real world realistic examples have been included in the course to assist the student in gaining an understanding of thermodynamics.\r\n",
    "pre_subname": "MCAE2001熱力學(一)",
    "pre_sub_id3": "MCAE2001",
    "pre_sub_ename": "MCAE2001 THERMODYNAMICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解能源與功之轉換效率。",
      "describe_en": "To understand the conversion efficiency between energy and work."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解做功循環系統之原理與應用。\n",
      "describe_en": "To understand the principle and application of power cycles."
    },
    {
      "seq": 3,
      "describe_ch": "為學生有效的把熱力學應用在實際工程上打好基礎。",
      "describe_en": "To prepare the student to effectively use thermodynamics in the practice of engineering."
    }
  ],
