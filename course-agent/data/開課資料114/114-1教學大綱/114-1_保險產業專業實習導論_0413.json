  "description": {
    "sub_id3": null,
    "sub_name": "保險產業專業實習導論",
    "sub_ename": "INTRODUCTION TO INSURANCE INTERNSHIP",
    "describe_ch": "為銜接保險產業實習課程，使學生實習前能了解實習企業基本規範，特別安排此項課程。課程主要安排，產壽險的高階主管到校演講，介紹保險公司各部門的工作內容及處理的業務概況，以利學生未來實習時，可預作充分準備。",
    "describe_eh": "This course is specifically arranged to well connect internship in the insurance industry and let students realize basic norms of the industry before the internship. The course proceeds by inviting high-level managers of the insurance industry to give a speech and introduce the work content and business overview of the firm so that students can have a full preparation for the internship later.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生理論與實務的整合",
      "describe_en": "To integrate the theory and practice for students"
    },
    {
      "seq": 2,
      "describe_ch": "強化學生專業技能，具備協調溝通與團隊合作之能力",
      "describe_en": "To strengthen students' professional skills and engage in effective communication and strategies of teamwork"
    }
