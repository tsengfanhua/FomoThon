    {
      "yms_year": 114.0,
      "yms_smester": 1.0,
      "cls_id": "CB04149",
      "sub_id": "28552",
      "scr_dup": "001",
      "evalb_id": "L4",
      "score_rate": 10,
      "evalb_memo": "出席狀況雖不作為成績計算的依據，但將影響授課業師評選個別學生參與實習的資格。缺席次數不得少於應出席次數的一半(業師2次，授課教師 1次)，業師授課的書面學習心得報告的10%，將分配10%在此項下。\n缺席(含請假)超過一半以上者，請自行辦理退選，以免影響個人的學習紀錄。",
      "evalb_memo_en": null,
      "evalb_name": "出席狀況",
      "evalb_name_en": "Attendances",
      "seq": 3
    }
