  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "海商法與海洋法",
    "sub_ename": "MARITIME COMMERCIAL LAW AND LAW OF THE SEA",
    "describe_ch": "海商法規範一切與海商事件有關的國內外法規範，包含貨物運送、旅客運送暨船舶拖帶、海難救助與海上保險等行為規範。海洋法則培養學生認識國際海洋法之相關主題，聯合國海洋法公約內容與國際海洋爭端之和平解決。",
    "describe_eh": "Maritime commercial law introduces domestic and international regulations regarding vessels, carriage by sea, collision, salvage, average, and maritime insurance, etc. The Law of the Sea introduces to legal topics on ocean affairs, United Nations Convention on the Law of the Sea, pacific settlement on international maritime disputes. The course aims to make students have understanding and knowledge of maritime commerce and Law of the Sea through the lecturing of theories and discussion of practical issues and cases.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "海商法規範一切與海商事件有關的國內外法規範，專指在海上及與海相通水面，以船舶經營商業之活動，包含貨物運送、旅客運送暨船舶拖帶、海難救助與海上保險等行為規範。",
      "describe_en": "Maritime commercial law introduces domestic and international regulations regarding vessels, carriage by sea, collision, salvage, average, and maritime insurance, etc. The course aims to make students have understanding and knowledge of maritime commerce."
    },
    {
      "seq": 2,
      "describe_ch": "學習外文資料庫(Lexis和Westlaw)，查閱英美法之相關法令、判決和文獻。",
      "describe_en": "Learn to use on-line computer research databases (Lexis and Westlaw) for legislations, case laws, various categories of legal documents and academic papers."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生處理海上跨國契約、訴訟之能力。",
      "describe_en": "Training students have capability to deal with tultinational maritime contract and transnational litigation ."
    }
  ],
