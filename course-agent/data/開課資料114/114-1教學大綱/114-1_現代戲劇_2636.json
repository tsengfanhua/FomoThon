  "description": {
    "sub_id3": null,
    "sub_name": "現代戲劇",
    "sub_ename": "THE CONTEMPORARY DRAMA",
    "describe_ch": "本課以台灣的現代戲劇、現代戲劇作家作品及演出為主。主要以台灣常用的幾種形式和內容，介紹寫實主義與社會寫實作品，超現實、魔幻寫實與荒謬派戲劇等劇本的發展。包括:梅特林克、斯特林堡、貝克特、契訶夫、布萊希特、姚一葦、賴聲川、紀蔚然、汪其楣乃至於新生代施如芳等劇作家。表演部分也包括各種挪移，文本的、跨文化的、傳統戲曲與現代戲劇；或是新創的新劇種。",
    "describe_eh": "This course is based on Taiwanese Theatre development, includes the drama, the playwright and performance.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識台灣現代戲劇發展的路徑。",
      "describe_en": "Knowing the developing path of Taiwanese contemporary theater."
    },
    {
      "seq": 2,
      "describe_ch": "從而檢視在現代的場域的應用。",
      "describe_en": "Applying this skill on and to the newly develop area."
    }
  ],
