  "description": {
    "sub_id3": null,
    "sub_name": "材料熱力學(一)",
    "sub_ename": "THERMODYNAMICS OF MATERIALS(1)",
    "describe_ch": "材料的特性、相變化關係皆與其製程或使用的溫度息息相關。材料熱力學為一門判斷系統狀態是否穩定、預測反應進行的可行性及預測變化的趨勢之科學，本課程特以材料領域之熱力學應用範圍作為教學主體，包含熱力學三大定律、相平衡、氣體及溶液行為等。以課堂授課與測驗等方式建立學生基本學理的基礎。",
    "describe_eh": "The relations between material characteristic and phase transformation correlate closely with process or temperature. Thermodynamic of materials is a subject used to determine a system is steady or not, expect the possibility of reaction, and the tendency of variation. This course contains the material field of thermodynamics as a leading role of teaching, including correlations among the major three thermodynamics laws, phase equilibrium, the behaviors of gas and solution etc., for the purpose of establishing student’s basic knowledge of the subject by both teaching and examination.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "定義何謂熱力學並描述重要的性質和現象\n",
      "describe_en": "Define Thermodynamics and Be able to important Thermodynamics' quality and phenomenon."
    },
    {
      "seq": 2,
      "describe_ch": "能歸納並解釋熱力學在工程及學術層面的重要性\r\n\n",
      "describe_en": "Understand and be able to explain the importance and effects of Thermodynamics to academia and engineering. \n"
    },
    {
      "seq": 3,
      "describe_ch": "知道於何處可蒐集熱力學的相關資訊及研究結果\n",
      "describe_en": "Know where to locate and access related Thermodynamics information, research\r\n"
    },
    {
      "seq": 4,
      "describe_ch": "能利用熱力學的原理，建造一系統，並提出可行解決方法\n",
      "describe_en": "Use principles of Thermodynamics to build a system and propose a feasible method for validation.\r\n\n"
    }
  ],
