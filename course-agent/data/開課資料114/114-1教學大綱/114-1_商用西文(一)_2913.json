  "description": {
    "sub_id3": null,
    "sub_name": "商用西文(一)",
    "sub_ename": "BUSINESS SPANISH 1",
    "describe_ch": "西班牙語是目前全球第三大語言，大部分的中南美洲國家都使用西班牙文，而台灣與這些國家以及西班牙都有著重要的貿易往來。本課程乃針對已有基礎西班牙語程度的學生而開設，本課程將透過與國際貿易實務相關的主題式教學: 公司介紹、打電話、客戶接送、市場調查、詢價與報價、合約等，讓學生可以掌握基礎西班牙文商業用語並了解西語系國家職場活動、習俗及文化背景。",
    "describe_eh": "Today, Spanish is the third language in the world. Most central and south America countries use Spanish as the main language. Taiwan has important trade relations with these countries and Spain. This course aims to design for students who have basic Spanish ability and to train them with the skills language for international trade, such as company introduction, E-mail business, business phone calls, greeting clients, marketing research, inquiry, quotation, contract and so on. The students will get to know primary business Spanish and understand workplace culture, custom and background of Spanish-speaking countries.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過主題式文章以或對話內容，學生能應用不同商業語境中適當的西班牙文用語與字彙。",
      "describe_en": "To train students to use appropriate Spanish language and vocabulary in different business workplaces through thematic articles and conversations"
    },
    {
      "seq": 2,
      "describe_ch": "了解西語系國家職場活動、習俗及文化背景。",
      "describe_en": "To understand workplaces, customs and cultural backgrounds in Spanish-speaking countries"
    }
  ],
