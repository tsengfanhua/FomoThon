  "description": {
    "sub_id3": null,
    "sub_name": "研究方法",
    "sub_ename": "RESEARCH METHODS",
    "describe_ch": "本課程範圍涵蓋廣泛，旨在闡述從事社會科學研究的基本方法，並因應上課時數限制將內容重點強調於研究計畫書的完成所需之知識與程序，其中包含研究的基本觀念、研究設計、資料來源與調查蒐集、及資料的分析與呈現等。",
    "describe_eh": "The purpose of this course is to introduce basic methods to social science studies. This course focuses on the implementation of proposal to a thesis, which is a requirement on subjects in land management studies.  In addition to knowledge delivering in proposal procedure, the course includes basic concepts, research design, data collection and surveying, data analysis, and thesis writing and presentation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能充分瞭解研究方法與工具",
      "describe_en": "Understand research methods and data analyse approaches"
    },
    {
      "seq": 2,
      "describe_ch": "能闡述社會科學研究方法的基本概念",
      "describe_en": "Be able to understand the basic concepts of social science."
    },
    {
      "seq": 3,
      "describe_ch": "能研擬從事科學研究的研究計畫書",
      "describe_en": "Be able to develop a proposal of a specific research topic."
    }
  ],
