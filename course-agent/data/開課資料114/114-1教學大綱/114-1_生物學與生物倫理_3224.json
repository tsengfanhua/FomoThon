  "description": {
    "sub_id3": null,
    "sub_name": "生物學與生物倫理",
    "sub_ename": "BIOLOGY AND BIOETHICS",
    "describe_ch": "地球的生物圈是由環境與無數的生命共同組成的，本課程將以「人」同為生物界中的一員之觀點，認識生物界的組成，生物與環境的互動。進一步瞭解各種生命現象。亦將藉由社會中對於生命的價值觀與生命倫理作主題性的討論。",
    "describe_eh": " The biosphere is composed of biotic elements and their environment. This class will introduce the components of biosphere, the interactions with environment in the role as a member of the biological world to realize the biological phenomena. We will also discuss the famous bioethics issues with specific titles.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解關於生物學的基本知識，包含組成、相互關係以及系統的運作。",
      "describe_en": "To understand the general knowledge of biology, including the composition, interaction and system operation."
    },
    {
      "seq": 2,
      "describe_ch": "能藉由特定議題的討論，獲得資料彙整與呈現的能力，並藉由團體合作培養協調與溝通以及議題批判的技巧。",
      "describe_en": "To understand how to get and summarize information for specific issues and to learn how to cooperate and communicate in group."
    }
  ],
