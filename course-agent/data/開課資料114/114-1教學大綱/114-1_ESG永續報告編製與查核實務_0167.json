    {
      "seq": 1,
      "describe_ch": "協助學生了解目前永續揭露準則",
      "describe_en": "Comprehension for the present sustainable disclosure standards"
    },
    {
      "seq": 2,
      "describe_ch": "經由報告實作引導學習永續報告書撰寫與查核實務",
      "describe_en": "Application for the sustainability report and assurance practices through the term report"
    }
  ],
