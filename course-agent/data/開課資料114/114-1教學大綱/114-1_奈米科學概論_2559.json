  "description": {
    "sub_id3": null,
    "sub_name": "奈米科學概論",
    "sub_ename": "INTRODUCTION TO NANO SCIENCE",
    "describe_ch": "奈米科學概論為一門介紹目前最新奈米科技的學科，本課程特以材料領域之奈米科技應用範圍作為教學主體，包含奈米材料的合成、性質和應用等，以建立學生的基本學理基礎。本課程以課堂講授為主，也將所獲得奈米科學相關資訊，進行團隊合作方式，課堂上分組報告，同時增強基本學理與口頭報告之能力。",
    "describe_eh": "Introduction to Nanoscience is a subject that introduces the latest nanotechnology. This course focuses on the application of nanotechnology in the field of materials as the main body of teaching, including the synthesis, properties and applications of nanomaterials, so as to establish the basic academic foundation of students . This course is mainly lectured in the classroom, and the acquired nanoscience-related information is also used in teamwork, group reports in the classroom, and the ability of basic theory and oral reporting is enhanced.",
    "pre_subname": "PHYS2005近代物理、PHYS1003普通物理(一)、PHYS1004普通物理(二)",
    "pre_sub_id3": "PHYS2005",
    "pre_sub_ename": "PHYS2005 MODERN PHYSICS、PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂奈米科技，描述重要的奈米科技性質和現象\r\n",
      "describe_en": "Define nanotechnology by their own words. Be able to describe important property and phenomenon for nanotechnology."
    },
    {
      "seq": 2,
      "describe_ch": "理解奈米科技在工程及學術層面的重要性。\t",
      "describe_en": "Comprehension for the importance of nanotechnology to academia and engineering."
    },
    {
      "seq": 3,
      "describe_ch": "能應用奈米科技的原理與相關材料。\t",
      "describe_en": "To apply the principle of nanotechnology and related materials."
    },
    {
      "seq": 4,
      "describe_ch": "綜合學生以書面或口頭報告方式，達成與同儕或教師清楚陳述有效溝通。\t\t",
      "describe_en": "Synthesis for written and oral report to achieve effective communication with classmates or the instructor.\t"
    }
  ],
