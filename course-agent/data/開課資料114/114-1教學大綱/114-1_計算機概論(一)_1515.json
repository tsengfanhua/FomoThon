  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE09111",
    "sub_id": "27410",
    "scr_dup": "001",
    "sub_title": "資訊科技的發展簡介, 程式語言的基礎與應用, 計算機組織與網路通訊簡介.",
    "sub_title_en": null,
    "sub_describe": "1. 簡介資訊科技的發展.\n2. 使用 C 語言說明程式撰寫的基本概念.\n3. 簡介計算機組織與網路通訊.",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "計算機概論(一)",
    "sub_ename": "INTRODUCTION TO COMPUTER(1)",
    "describe_ch": "廣泛地認識電腦科學相關的主題，概述計算機中軟體與硬體相關的基本知識。課程主要為電腦原理的介紹，及使用計算機解決方法論與演譯法的問題。",
    "describe_eh": "The purpose of this course is to let the students know the related topics of Computer Science, and to state the knowledge of software/hardware in Computer Science. The course mainly focuses on the introduction of the Computer Science, and the use of computer to solve the problems of methodology and algorithm.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解計算機資料處理及組織架構之知識。",
      "describe_en": "Knowledge of the computer hardware design."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解計算機軟體之演繹方法及執行之觀念。",
      "describe_en": "Knowledge of the computer software design."
    }
  ],
