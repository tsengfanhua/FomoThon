  "description": {
    "sub_id3": null,
    "sub_name": "作業研究",
    "sub_ename": "OPERATIONS RESEARCH",
    "describe_ch": "作業研究 (OR) 在現實生活問題中有許多應用。正確理解和建模問題並應用適當的方法來求解數學模型非常重要。本課程將側重於優化問題的數學建模和分析解決方案，包括博弈論、決策分析、馬爾可夫鏈、排隊論和庫存理論。",
    "describe_eh": "Operations research (OR) has many applications in real life problems. It is important to understand and model the problem correctly and apply appropriate method to solve the mathematical model. This course will focus on mathematical modeling and analytical solutions of optimization problems including game theory, decision analysis, Markov chains, queueing theory, and inventory theory.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "兩人零和對局的數學模式並分析出兩人的最佳對策。",
      "describe_en": "The mathematical model of  a two persons, zero sum game. Analyze the problem and find  an optimal strategy for both players."
    },
    {
      "seq": 2,
      "describe_ch": "以決策樹來分析出一連串最佳的決策。",
      "describe_en": "Use decision tree to analyze the optimal sequence of decisions."
    },
    {
      "seq": 3,
      "describe_ch": "使用Markov鏈來解決隨機問題，並找出此問題的長期性質。分析等候線系統，並找出長期性質；如等候線長度、等待時間的期望值、以及該系統使用率。",
      "describe_en": "Model stochastic problems as a Markov chain and use the theories for Markov chain to find some long run facts about the problems. Analyze a queueing system including the limiting probability of each state, expected queue length, expected waiting time, and"
    },
    {
      "seq": 4,
      "describe_ch": "研究存貨的問題，並導出最佳訂貨時間及訂購量。使用亂數產生原理模擬一個機率分配。",
      "describe_en": "Study the cycle of the inventory level.  Use mathematical methods to derive the best time and quantity to replenish the goods. Use random number generator to simulate a probability distribution."
    }
  ],
