  "description": {
    "sub_id3": null,
    "sub_name": "物理化學實驗(一)",
    "sub_ename": "PHYSICAL CHEMISTRY LAB.(1)",
    "describe_ch": "物理化學實驗(一)主要內容包括化學熱力學之相關實驗操作，藉由實驗結果驗證物理化學課程中各相關主題之學理，如蒸氣密度、表面張力、分子量、溶質於互不相溶二溶劑間的分配率以及轉相點之測定，二成分系的氣液平衡與固液平衡以及三成分系的液液平衡之分析等。",
    "describe_eh": "Physical Chemistry Lab(1) involves the experimental manipulations about the topics of chemical thermodynamics.  The results of experimental data can be used to proof the theory of those topics, such as: the measurement of vapor density and surface tension, molecular weight determination by freezing point depression and viscosity method, the measurement of phase transition point and distribution constant, the analysis of vapor-liquid equilibrium and liquid-solid equilibrium in a binary system and the analysis of liquid-liquid equilibrium in a ternary system etc.eory etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟習實驗操作技巧及設備之使用",
      "describe_en": "Be familiar with manipulating technique of experiments and instruments　"
    },
    {
      "seq": 2,
      "describe_ch": "能自行撰寫實驗報告",
      "describe_en": "Be able to analyze the data from experimental"
    },
    {
      "seq": 3,
      "describe_ch": "由實驗結果驗證物理化學課程之理論與應用　",
      "describe_en": "Verify and test the applications and theories of physical chemistry from the experimental results　"
    }
  ],
