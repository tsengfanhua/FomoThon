  "description": {
    "sub_id3": null,
    "sub_name": "光顯示器概論",
    "sub_ename": "INTRODUCTION TO DISPLAYS",
    "describe_ch": "簡介顯示器的基本原理，以及顯示器的應用及發展。主要探討對象包括液晶顯示器、電漿顯示器、電機發光顯示器、場發光顯示器、以及投影顯示系統",
    "describe_eh": "In this course, students will learn the fundamental principles of displays and further understand the applications and developments of displays. We will focus on the liquid crystal display, plasma display panel, electron luminescence display, field emission display, and the projector systems.",
    "pre_subname": "OPT4044色彩工程學、OPT1001光電綜論、OPT4011液晶導論",
    "pre_sub_id3": "OPT4044",
    "pre_sub_ename": "OPT4044 COLOR ENGINEERING、OPT1001 OVERVIEW OF PHOTONICS、OPT4011 INTRODUCTION TO LIQUID CRYSTAL",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備顯示器的原理、設計與應用之知識。",
      "describe_en": "Explore the principles, designs, and applications of displays"
    },
    {
      "seq": 2,
      "describe_ch": "具備閱讀顯示器之技術的文章之能力。",
      "describe_en": "Have an ability to read the paper or article of display technology"
    },
    {
      "seq": 3,
      "describe_ch": "能以書面或口頭方式將所閱讀之顯示器相關知識與同儕及教師分享。",
      "describe_en": "Share the display technology with classmates and advisor by writing or oral presentation.　"
    }
  ],
