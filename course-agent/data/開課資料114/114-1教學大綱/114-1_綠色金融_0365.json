    {
      "seq": 1,
      "describe_ch": "能知道綠色金融相關商品與市場",
      "describe_en": "Knowledge for basic concepts of green finance related commodities and markets."
    },
    {
      "seq": 2,
      "describe_ch": "能理解綠色金融相關法規與風險管理",
      "describe_en": "Comprehension for green finance related regulations and risk management."
    }
