  "description": {
    "sub_id3": null,
    "sub_name": "企業研究方法",
    "sub_ename": "BUSINESS RESEARCH METHODOLOGY",
    "describe_ch": "本課程在講授解決研究問題的方法，特別是問題與研究設計之關係。內容包括(1)調查研究法-調查過程、抽樣、問題編寫、問卷設計、執行調查、處理資料及報告撰寫 (2)實驗法-實驗設計步驟、實驗設計與解析。",
    "describe_eh": "This course introduces students to the methods of solving a scientific research problem, focusing on the relationship between the problem and the research design. Course content includes (1) survey research-survey process, drawing samples, writing questions, designing questionnaires, conducting interviews, processing data and report writing (2) experimentation- experimental design procedures, classical experimental design, statistical experimental design.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生瞭解研究方法在學術研究與產業績效評估的重要性與影響",
      "describe_en": "Students understand and be able to explain the importance and effects of the research method to academic research and performance evaluation of business activities."
    },
    {
      "seq": 2,
      "describe_ch": "學生能使用正確研究方法解決學術研究及實際生活案例，並提出合理的解釋與建議",
      "describe_en": "Students are able to use the research method to accomplish academic research, real data analysis, and draw appropriate conclusions from the reporting of data analysis."
    }
  ],
