  "description": {
    "sub_id3": null,
    "sub_name": "工程經濟",
    "sub_ename": "ENGINEERING ECONOMICS",
    "describe_ch": "本課程為提供學生了解經濟分析的基礎與原理，並發展工程實務與案例之經濟分析技術。內容包括等值觀念、現金流動、因子計算、有效與名義利率、現值與年金分析法、資金成本法、生命週期成本計算、報酬率比較法、益本分析法、重置分析法、通貨膨脹之影響、損益平衡分析等相關議題。",
    "describe_eh": "To gain a comprehensive understanding of the principles and fundamentals of economic analysis as applied to engineering practices by comparing different alternatives. The concepts include equivalence, cash flow, factors, effective and nominate interest rates, present and annual worth analysis, capitalized cost analysis, life cycle cost (LCC), comparison of rate of return, benefit cost analysis, replacement analysis, inflation effect, and breakeven analysis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解金錢在時間上的價值與等值的觀念。",
      "describe_en": "Be able to understand the value of money on time and the concept of equivalence.　"
    },
    {
      "seq": 2,
      "describe_ch": "學習繪製現金流動圖的技巧。",
      "describe_en": "Learn the techniques of drawing cash flow diagrams."
    },
    {
      "seq": 3,
      "describe_ch": "理解名義利率與實際利率之換算方法與意義。",
      "describe_en": "Understand the difference of nominate and effective interest rates and calculation between them.　"
    },
    {
      "seq": 4,
      "describe_ch": "學習利用不同工程經濟分析方法來比較工程選擇方案。",
      "describe_en": "Learn how to use varieties of techniques to evaluate the best choice among engineering alternatives."
    }
  ],
