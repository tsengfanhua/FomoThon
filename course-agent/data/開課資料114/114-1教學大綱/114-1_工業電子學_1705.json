  "description": {
    "sub_id3": null,
    "sub_name": "工業電子學",
    "sub_ename": "INDUSTRIAL ELECTRONICS",
    "describe_ch": "本課程主要是以探討工業常用之電子元件與控制電路之原理、結構及其應用的科學及控制電路於工業控制應用實例分析。",
    "describe_eh": "This curriculum mainly with inquire into the industry with science that the principle, structure of the electronics component and the control electric circuit and it applies as well as the practical control circuit for industry and power electronics application.",
    "pre_subname": "EEEN2002電子學(一)、EEEN2003電子學(二)、EEEN2008電路學(一)、EEEN2009電路學(二)",
    "pre_sub_id3": "EEEN2002",
    "pre_sub_ename": "EEEN2002 ELECTRONICS(1)、EEEN2003 ELECTRONICS(2)、EEEN2008 CIRCUIT THEORY(1)、EEEN2009 CIRCUIT THEORY(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "對工業用電子元件的結構、特性有充分之瞭解。",
      "describe_en": "Understand the structure and characteristics of the industry electronic components."
    },
    {
      "seq": 2,
      "describe_ch": "對工業上常見之電子電路的動作原理有充分之瞭解，並能分析說明之。",
      "describe_en": "Analyze and explain the action principle of the industrial familiar electronics electric circuit."
    },
    {
      "seq": 3,
      "describe_ch": "收集一些工業上常見的電子電路，檢討電路之優缺點，並設計出更適當之電路。",
      "describe_en": "Collect up the some industries familiar electronics electric circuit, examine the merit and shortcoming of the electric circuit, and design more appropriate of electric circuit."
    }
  ],
