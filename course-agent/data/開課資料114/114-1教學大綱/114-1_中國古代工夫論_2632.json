  "description": {
    "sub_id3": null,
    "sub_name": "中國古代工夫論",
    "sub_ename": "ANCIENT CHINESE SELF-TRANSFORMATION THEORY",
    "describe_ch": "中國古典思想有一強烈的實踐性格，而此實踐性格表現的方式多元。本課程將把握此傳統，並結合當代「高階覺察」的學理，融合進課程教學，期能引導學生在古、今交會中，一方面瞭解古代的工夫論述，二方面逐漸培養起自我轉化的機制和方法。",
    "describe_eh": "Chinese classical thought has a strong practical character expressed in diverse ways. One significant expression is the Gongfu Theory found across Confucianism, Buddhism, and Daoism, representing a common intellectual domain and essential aspect of these three traditions. This course will engage with this tradition while integrating contemporary theories of Advanced Awareness into the curriculum. The aim is to guide students at the intersection of ancient and modern approaches, helping them both understand classical Gongfu Theory and gradually develop mechanisms and methods for personal transformation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "教授學生初步掌握中國古代儒、釋、道三家重要的工夫論。",
      "describe_en": "Teach students a preliminary understanding of the key Gongfu Theories in ancient Chinese Confucianism, Buddhism, and Daoism."
    },
    {
      "seq": 2,
      "describe_ch": "教授學生理解作為中國主流工夫論之基礎的身體論。",
      "describe_en": "Teach students to understand Somatic Philosophy as the foundation of mainstream Chinese Gongfu Theory."
    },
    {
      "seq": 3,
      "describe_ch": "引導學生初步理解當代高階覺察的理論與實務，並透過相關知識與練習更深入自我覺察。",
      "describe_en": "Guide students to develop an initial understanding of contemporary advanced awareness theories and practices."
    }
  ],
