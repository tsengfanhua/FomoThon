  "description": {
    "sub_id3": null,
    "sub_name": "材料力學",
    "sub_ename": "MECHANICS OF MATERIALS",
    "describe_ch": "讓學生了解應力、應變、彈性模數、波松比等材料力學基礎概念，並讓學生具備分析與計算各種外界施加的負載造成材料的應力應變以及形變的能力。",
    "describe_eh": "This course will let students understand the fundamental concepts of mechanics of materials which includes stress, strain, modulus of elasticity, Poisson’s ratio, and so on Students from this course can obtain the abilities of calculating and analyzing stress, strain, and deflection of materials which are induced from outside applying loadings.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠了解材料力學的基本概念",
      "describe_en": "Be able to understand fundamental concepts of mechanics of materials."
    },
    {
      "seq": 2,
      "describe_ch": "能夠理解材料變形和形變的原理",
      "describe_en": "Be able to comprehend theory of deformation and deflection of materials."
    },
    {
      "seq": 3,
      "describe_ch": "能夠分析材料受負載的影響",
      "describe_en": "Be able to analyze the effect of loadings."
    },
    {
      "seq": 4,
      "describe_ch": "能夠知道材料力學的分析方法",
      "describe_en": "Be able to know analysis methods of mechanics of materials."
    }
  ],
