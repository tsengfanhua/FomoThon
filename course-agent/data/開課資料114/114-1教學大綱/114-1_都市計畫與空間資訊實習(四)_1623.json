  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE10131",
    "sub_id": "46424",
    "scr_dup": "001",
    "sub_title": "彰化縣大村鄉整體環境規劃設計",
    "sub_title_en": null,
    "sub_describe": "大三的都市計畫與空間資訊實習主軸設定在環境規劃與設計，藉以提升整體環境品質，建構宜居的城鄉空間環境。本次實習課程以一學年進行規劃，上學期課程主要聚焦於彰化縣大村鄉的整體環境規劃與發展策略，參考期能透過「114年度地方創生計畫-幸福大村，青年留鄉、智慧創生新樣貌」、「彰化縣大村鄉鄉村地區整體規劃作業」、及「大村鄉112年鄉政建設諮詢顧問及專案管理計畫」等計畫之現階段成果，就大村鄉地區環境屬性、基盤設施、地方特色產業及文化等項目的調查及分析，了解大村鄉與周邊區域關聯性，以研擬相關發展願景目標與課題，進而具體提出大村鄉的整體環境規劃構想與發展策略；下學期則會以上學期之階段成果為基礎，選擇數處基地進行實質敷地計畫與基本設計。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "都市計畫與空間資訊實習(四)",
    "sub_ename": "PRACTICE OF URBAN PLANNING AND SPATIAL INFORMATION(4)",
    "describe_ch": "本課程旨在訓練學生分組團隊合作，以地區整體性的空間發展考量為基礎，進行較小尺度的都市設計或景觀風貌等實質環境設計工作，並強調城市模擬的訓練與社會服務工作。",
    "describe_eh": "This course trains students to work together and conduct the physically environmental design, such as urban design or landscape design, in smaller urban settings, based on the comprehensive consideration of local spatial development.  The training also emphasizes the urban simulation and social services.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 4,
      "describe_ch": "能理解實質環境設計與都市設計的專業技能",
      "describe_en": "Comprehension for the techniques of physically environmental design and urban design."
    },
    {
      "seq": 5,
      "describe_ch": "能理解城市模擬於都市設計或景觀規劃的內涵",
      "describe_en": "Comprehension for the content of urban simulation in urban design or landscape planning."
    },
    {
      "seq": 6,
      "describe_ch": "能應用專業倫理與社會服務於專業實務",
      "describe_en": "Application of professional ethics and social responsibility to professional practice.\r\n"
    }
  ],
