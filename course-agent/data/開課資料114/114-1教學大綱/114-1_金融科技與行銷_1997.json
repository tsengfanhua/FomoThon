  "description": {
    "sub_id3": null,
    "sub_name": "金融科技與行銷",
    "sub_ename": "FINANCIAL TECHNOLOGY AND SERVICES MARKETING",
    "describe_ch": "學習金融科技與行銷的原理及技術。在課程中將教導如何在金融服務業中，從數位金融轉型重要的關鍵能力。透過數位科技和客戶互動、提供客戶價值與服務和增加銷售機會與客戶關係。",
    "describe_eh": "This course is designed to make the MBA students learn principles and techniques about financial technology (FinTech) and services marketing. This course will demonstrate to students the benefits of using the FinTech to marketing in the financial services industry, and will show students how to undertake the FinTech. The students will develop an understanding of the FinTech and services market, and develop competence in key finance concepts, digital and interpersonal skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
