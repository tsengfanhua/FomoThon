  "description": {
    "sub_id3": null,
    "sub_name": "室內健康環境實務與應用",
    "sub_ename": "IMPLEMENTATION PRACTICE FOR INDOOR HEALTH ENVIRONMENT",
    "describe_ch": "本課程以室內感知環境理論為基礎，進階探討室內健康診斷與評價為主要方向，作為訓練具有環境控制的規劃實務與空間診斷之數據分析評價之研究人才為目的。本課程透過多名師資共授，除了環境控制理論與方法之外，更結合量測與分析工具，藉以現場實務案例與國外學術機構之合作，",
    "describe_eh": "This course is based on the theory of indoor perception environment and is taught by a number of teachers., with advanced discussion of indoor health diagnosis and evaluations as the main direction. For the purpose of training research methods and applica",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解室內環境健康指標探查方法的適用條件與限制",
      "describe_en": "Comprehension for the applicable criterion and restriction of indoor health environment"
    },
    {
      "seq": 2,
      "describe_ch": "能應用室內環境健康指標相依方法的條件及其分析解讀",
      "describe_en": "Application for the applicable conditions and results in indoor health environment techniques"
    },
    {
      "seq": 3,
      "describe_ch": "能分析室內環境健康指標相互整合的物理量參數",
      "describe_en": "To analyze the results and applicable criterion in indoor health environment integrated with physical parameters"
    }
  ],
