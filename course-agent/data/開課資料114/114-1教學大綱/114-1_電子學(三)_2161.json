  "description": {
    "sub_id3": null,
    "sub_name": "電子學(三)",
    "sub_ename": "ELECTRONICS(3)",
    "describe_ch": "以含電子學(一)和電子學(二)為理論基礎，介紹高階電子電路分析與應用，內容含：頻率響應、回授、功率放大器、類比積體電路、濾波器及可調放大器設計，讓學生對電子學和應用電子電路具有完整且較專業的理論知識。",
    "describe_eh": "Students will engage in the study of analog circuit design with an advanced-technology to analog and digital integrated circuits. This course includes：frequency response, feedback, power amplifiers, analog integrated circuits, filters and tuned amplifiers. The student who fulfills the course requirements will have an ability to design, build and test instrumentation circuits.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的專業詞彙定義電子學中，何謂增益、輸入電阻、輸出電阻、頻寬、效率、頻率響應以及轉移特性。　",
      "describe_en": "Be able to define various terminologies in electronic circuits: gain, input /out resistance, bandwidth, circuit  efficiency, frequency response and transfer characteristics."
    },
    {
      "seq": 2,
      "describe_ch": "能辨識出各種不同組態的電晶體電路，並能清楚表達。",
      "describe_en": "Be able to distinguish and make clear statement of various configurations of transistor circuits."
    },
    {
      "seq": 3,
      "describe_ch": "能利用電子學的原理，評估一個真實的電子電路，並提出計算分析程序。",
      "describe_en": "Be able to use principles of microelectronics to evaluate a true electronic circuit and propose a feasible method for computational algorithms."
    }
  ],
