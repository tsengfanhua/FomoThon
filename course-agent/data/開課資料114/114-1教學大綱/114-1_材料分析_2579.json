  "description": {
    "sub_id3": null,
    "sub_name": "材料分析",
    "sub_ename": "MATERIALS CHARACTERIZATION AND ANALYSIS",
    "describe_ch": "了解各種分析儀器基本構造、分析原理及其應用，以探測材料表面性質之微觀組織、晶體結構、化學組成及鍵結結構，使學生能正確選擇適當的材料分析工具及判斷分析結果。本課程將著重學理及實際案例解析，以期學生建立獨立思考及材料分析技能。",
    "describe_eh": "This course provides the introduction of configuration, principle, and application of analysis instrument to explore the microstructure, crystal structure, chemical composition, and bonding structure of material surface. It enables student to choose the appropriate analysis methods, and analyzes the experimental results correctly. This course focuses on theory and practical case study, so that students can build independent thinking and material analysis skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解材料分析的重要原理，以及在材料科技中重要性",
      "describe_en": "Understand the important principle of materials analysis, and make clear statement with its importance to Material science and technology."
    },
    {
      "seq": 2,
      "describe_ch": "透過實驗課程，能使用相關設備，並由實驗中歸納出適當結論",
      "describe_en": "Be able to use related equipment in Experiment , and draw appropriate conclusions from experiment results."
    },
    {
      "seq": 3,
      "describe_ch": "知道於何處可找到材料分析的相關資訊，並可評估所獲資訊的適用性",
      "describe_en": "Know where to access related materials analysis information, research, as well as standards, and be able to evaluate the appropriateness of obtained information."
    }
  ],
