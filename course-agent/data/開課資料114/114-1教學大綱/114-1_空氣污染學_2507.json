  "description": {
    "sub_id3": null,
    "sub_name": "空氣污染學",
    "sub_ename": "AIR POLLUTION",
    "describe_ch": "本課程是提供對空氣污染控制工程有興趣之大學高年級學生影。課程的一半內容是講述防制設備、理論與其應用。另一半內容是選擇這些設備的背景資料：如空氣污染影響、台灣空氣污染法規的結構、大氣模式等強烈影響設備之選擇及設計題材。",
    "describe_eh": "This course is intended for university senior students who would like an overview of air pollution control engineering. About half of the class is devoted to control devices, their theory and practice. The other half is devoted to topics that form some of background for selection of such devices, e.g., air pollution effects, the structure of Taiwan air pollution law, atmospheric models, etc., These topics interact strongly with the device selection and design, which is the reason for their inclusion.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解空氣污染的定義與描述空氣污染對人體健康、財產與能見度之影響。",
      "describe_en": "Explain the definition of air pollution and describe the effects of air pollution on human health, property, and visibility."
    },
    {
      "seq": 2,
      "describe_ch": "詳述環境監測與排放源檢測，及空氣污染物之濃度計算與單位換算。\t",
      "describe_en": "Specify ambient and emission source measurements, and analysis the concentration of air pollutants calculating and converting with the unit"
    },
    {
      "seq": 3,
      "describe_ch": "解釋大氣之水平與垂直運動與說明空氣污染物濃度模式。\t",
      "describe_en": "Explain the horizontal and vertical atmospheric motions and state the air pollutant concentration models"
    },
    {
      "seq": 4,
      "describe_ch": "理解空氣污染防制概念(替代方法、資源回收、成本效益、去除率與貫穿率)與空氣污染物控制方法。\t",
      "describe_en": "Explain the general ideals in air pollution control (alternatives, resource recovery, cost-effective, efficiency, and penetration) and the control methods."
    }
  ],
