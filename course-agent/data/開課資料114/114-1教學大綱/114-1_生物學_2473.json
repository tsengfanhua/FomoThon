  "description": {
    "sub_id3": null,
    "sub_name": "生物學",
    "sub_ename": "BIOLOGY",
    "describe_ch": "生物學是一門探討生命現象的科學，內容相當廣泛，涵蓋細胞、遺傳、演化以及生態與保育等主題，是與其它眾多學科皆有關連的基礎課程，也是大學生必須具備之基本知識；本課程介紹生物學中的重要知識概念與最新發展。",
    "describe_eh": "Biology is a science explore the phenomenon of life, is quite extensive, covering cell, genetics, evolution and ecology and conservation theme, with many other disciplines are related to a basic course, but also the students must have basic knowledge; This course introduces the important knowledge in biology concepts and latest developments.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解生命的基本單位-細胞內的組成、化學物質和細胞構造。",
      "describe_en": "Comprehend the various characteristics of cells: macromolecules, structures and functions of organelles."
    },
    {
      "seq": 2,
      "describe_ch": "理解生物的基礎生化反應-酵素反應機制及重要的生化反應。\r\n",
      "describe_en": " Comprehend the basic biochemical reactions of organism: enzyme reaction mechanism and important biochemical reactions."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解及珍惜物種多樣性，辨識並描述各種生物的形態、構造、特性及生活方式。",
      "describe_en": "Comprehend and appreciate biodiversity. Distinguish the morphology, structure, characteristics and life pattern of various organisms."
    },
    {
      "seq": 4,
      "describe_ch": "理解基礎的分子生物學與生物科技應用，包含細胞分裂、遺傳機制與基因調控。\r\n",
      "describe_en": "Understand the basic molecular biology and biotechnology applications, including cell division, genetic mechanisms and gene regulation"
    }
  ],
