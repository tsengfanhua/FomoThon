  "description": {
    "sub_id3": null,
    "sub_name": "企業概論",
    "sub_ename": "INTRODUCTION TO BUSINESS",
    "describe_ch": "闡述企業與社會的關係及經營環境如何影響企業經營，企業又如何使用社會資源、管理技能，以達成企業組織有效目標。其內容包括企業基本概念、企業環境、企業組織、企業人力資源、財務、生產、行銷及企業的未來發展趨勢等。",
    "describe_eh": "Introduction to the basic principles of Management and their applications：Business Environment、Business Organizations、Human Resources Management、Production Management、Marketing Management、Future Trend Research and Development Management.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解何謂企業和企業如何運作。",
      "describe_en": "Comprehend business and how to operate business."
    },
    {
      "seq": 2,
      "describe_ch": "能理解企業如何將社會責任和企業倫理等重要議題，融入企業經營的決策，強化企業永續經營理念。",
      "describe_en": "Comprehend how business to combine the social responsibility and business ethic issue into decision making. Make business sustainable growth."
    },
    {
      "seq": 3,
      "describe_ch": "能分析企業個案，評估內外在環境因素；發現問題；比較各種可行方案；提出最佳方案維持企業競爭優勢。",
      "describe_en": "Capable analysis practice case study. Evaluate business environment factors, find out the problems, compare the alternatives, and choice a best alternative"
    }
  ],
