  "description": {
    "sub_id3": null,
    "sub_name": "銀行授信管理",
    "sub_ename": "CREDIT AND LENDING MANAGEMENT",
    "describe_ch": "授信係指銀行對顧客授予信用並承擔風險之業務，內容包含企業授信、外匯授信、消費者授信、事後管理、催收等議題。本課程將介紹各種授信與風險，並搭配相關個案討論以完整了解銀行授信之業務。",
    "describe_eh": "Credit refers to the business in which a bank grants credit to customers and bears risks. It includes issues such as corporate credit, foreign exchange credit, consumer credit, ex-post management, and collection. In this course, you will learn about various credits and risks. From case studies, you will also fully learn about the business of bank credit.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
