  "description": {
    "sub_id3": null,
    "sub_name": "強化學習",
    "sub_ename": "REINFORCEMENT LEARNING",
    "describe_ch": "本課程將介紹強化學習的基礎理論與實務。本課程將介紹馬可夫決策過程、動態規劃法、蒙地卡羅法、時間差分法、多步回溯法、規劃及學習、同策略預測及控制逼近法、異策略預測及控制逼近法、資格跡及政策梯度法等。教學目標為建立學生在強化學習必要的根基，以便將所學之技術應用在他/她們自己的問題上。",
    "describe_eh": "In this course, the fundamental principles and applications of the reinforcement learning are introduced. Topics included are finite Markov decision processes, dynamic programming methods, Monte Carlo methods, temporal-difference methods, n-step bootstrapping, planning and learning, on-policy prediction and control with approximation, off-policy prediction and control with approximation, eligibility traces, and policy gradient methods. The goal is build the necessary background of the reinforcement learning for the students in order to apply these techniques in their own problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解強化學習之基本概念。",
      "describe_en": "Understanding the fundamental concepts of the reinforcement learning."
    },
    {
      "seq": 2,
      "describe_ch": "具備強化學習程式撰寫能力。",
      "describe_en": "Having the ability to write computer programs for reinforcement learning problems."
    },
    {
      "seq": 3,
      "describe_ch": "具備將強化學習之技術應用於實務問題上。",
      "describe_en": "Having the ability to apply the techniques of the reinforcement learning in practical problems."
    }
  ],
