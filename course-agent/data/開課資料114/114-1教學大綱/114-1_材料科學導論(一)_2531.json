  "description": {
    "sub_id3": null,
    "sub_name": "材料科學導論(一)",
    "sub_ename": "INTRODUCTION TO MATERIALS SCIENCE(1)",
    "describe_ch": "探討材料本質之基礎知識與特性。基礎科學部分包含原子結構、分子間鍵結型態、結晶與非結晶、材料固化過程晶格缺陷，瞭解材料本質的變化衍伸出材料特性之討論，其中包含材料熱力學、固態擴散、機械強度、材料電性以及化學穩定性。本課程除課堂講授外，將以分組上台報告的方式，提升學生報告之技巧與團體合作之能力。",
    "describe_eh": "This course aims to realize the basic knowledge of materials and related properties. The fundamental of materials science include atomic structure, types of molecule bonding, crystalline and amorphous, material solidification, and crystalline imperfections. Thereafter, the properties of materials have been discussed to course including thermally activated process, diffusion in solid, mechanical properties, electrical properties and chemical stability. In addition, the report skill and teamwork ability will be promoted to students by using report on the stage.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義材料科學：能說明為何研讀材料科學，並能對不同材料加以分類。",
      "describe_en": "Defining Materials Science with students' own words: Be capable of distinguishing various categories of materials and explaining why to study Materials Science."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解晶體結構、材料缺陷、擴散理論等基本，並能應用於材料製程與檢測。",
      "describe_en": "Understanding the fundamentals of crystal structures, crystal defects, and diffusion, then employing them to materials processing and characterization."
    },
    {
      "seq": 3,
      "describe_ch": "知道如何找到材料科學之相關資訊、研究結果及規格標準，並可評估所獲資訊的適用性。",
      "describe_en": " Learning how to locate and access the information related to material science, and evaluating the applicability of the obtained information"
    }
  ],
