  "description": {
    "sub_id3": null,
    "sub_name": "向量分析",
    "sub_ename": "VECTOR ANALYSIS",
    "describe_ch": "這課程的目的是使學生了解向量分析的相關技巧,包含向量的基本運算,不同的座標系統, 及各類向量分析衍伸的定理應用。此課程將使學生對向量系統具備分析能力,也教導學生熟悉各類向量計算及定理對未來的微波或電磁學奠定基礎。",
    "describe_eh": "The objective of this course is to demonstrate the related analysis technology of vector. The course includes the introduction vector function, different coordinates, and some vector theorems. This course makes students to have the analysis ability of vector function. In addition, the theory of vector function helps students go into the world of microwave and electromagnetism.",
    "pre_subname": "CEM1006微積分、PHYS1003普通物理(一)",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS、PHYS1003 GENERAL PHYSICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道何謂向量、向量場、純量場與各類空間座標系統。",
      "describe_en": "Knowledge for vector, vector field, scalar vector, and different space coordinate systems."
    },
    {
      "seq": 2,
      "describe_ch": "理解並說明各類向量運算。\t",
      "describe_en": "To comprehend all kinds of vectors calculations."
    },
    {
      "seq": 3,
      "describe_ch": "應用向量運算求出線、面、體積分及各類積分轉換。",
      "describe_en": "To apply the vectors calculation in line、surface and volume integrals and integral theorems of vector."
    }
  ],
