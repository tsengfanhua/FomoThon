  "description": {
    "sub_id3": null,
    "sub_name": "電磁學(一)",
    "sub_ename": "ELECTROMAGNETICS(1)",
    "describe_ch": "修習本課程學生需先掌握本課程教科書第一章的向量分析(如梯度、散度、旋度…等)概念。因此，授課內容將從教科書第二章開始，先介紹一些特殊數學技巧(如，Laplace's Eq.、邊界值問題、鏡像解法、變數分離、多極展開)，並將其應用於靜電學相關問題(如電場、電位、Gauss's law…等)的分析上。課程最後將延伸至介質內的靜電學問題，並以基本靜磁學概念作終結。　",
    "describe_eh": "Students are assumed being able to handle the basic techniques of vector analysis and calculus. The second part of the course introduces the fundamental postulates and problems of electrostatics for E-field, potential and Gauss's law. Successively, problems solving with Laplace's Eq., boundary-value problems, variable separation and multipole expansion are presented. The final part of this course will include electrostatics in dielectric materials and the fundamental concepts of magnetostatics.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、PHYS1003普通物理(一)、PHYS1004普通物理(二)、OPT1005基礎光電工程數學",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)、OPT1005 BASIC MATHEMATICS FOR PHOTONIC ENGINEERING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習靜電場之基本假定，庫倫定律，高斯定律，電場與電位關係，導體和介電質中靜電場的行為，鏡像法及邊界值問題。　",
      "describe_en": "Study the fundamental postulates of electrostatics, Coulomb's law, Gauss's law, the relations between electric fieldand potential, behavior of conductorsand dielectrics in electric field, methodof images and boundary-value problems."
    },
    {
      "seq": 2,
      "describe_ch": "學習靜磁場之基本假定，穩定電流，Biot-Savart定律。　",
      "describe_en": "Study the fundamental postulates of Magnetostatics, steady electric currents and Biot-Savart law.　"
    },
    {
      "seq": 3,
      "describe_ch": "每章習題是用來加強學生對公式中不同量值之間關係的理解力，同時亦可增進學生應用這些公式來處理實際問題的能力。",
      "describe_en": "The problems in each chapter are designed to reinforce students' comprehension of the interrelationships between the different quantities in the formulas and to extend their ability of applying the formulas to solve practical problems."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解電磁技術和最新應用。",
      "describe_en": "To underdtand the technology of electromagnetics."
    }
  ],
