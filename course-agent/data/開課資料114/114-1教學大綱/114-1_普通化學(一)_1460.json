  "description": {
    "sub_id3": null,
    "sub_name": "普通化學(一)",
    "sub_ename": "GENERAL CHEMISTRY(1)",
    "describe_ch": "課程以原子、分子、離子的構造來說明化學計量，化學反應平衡的相互關係，並介紹原子組成氣體與固體液體的物理化學原理，最終介紹化學鏈結的生成與軌域。",
    "describe_eh": "Optical include Chemical Foundations, Atoms, Molecules, and Ions Stoichiometry, Type of Chemical Reactions and Solution Chemical Gases,Thermochemistry, Atomic Structure and Periodicity, Bonding : General Concepts, Covalent Bonding : Orbitals, Liquids and Solids",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備化學的基礎知識。",
      "describe_en": "Have the fundamental chemistry knowledge"
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解化學在工業應用層面的重要性及影響",
      "describe_en": "Understand the importance and effects of chemistry to industrial application."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解化學原理、物質化學特性、分析方法。建立解題之思考邏輯。",
      "describe_en": " Understand the chemical theory, chemical properties of matters, analyzing methods. Think logically to solve the problem.　"
    }
  ],
