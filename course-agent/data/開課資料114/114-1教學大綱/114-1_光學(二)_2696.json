  "description": {
    "sub_id3": null,
    "sub_name": "光學(二)",
    "sub_ename": "OPTICS (2)",
    "describe_ch": "介紹(a)多光束干涉及應用；(b)光極化及雙折射；(c)光繞射。內容包含(1)多光束干涉原理；(2)多光束干涉系統；(3)折射率古典理論；(4)惠更斯原理及應用；(5)光極化及雙折射；(6)Fraunhofer繞射；(7)Fresnel繞射。",
    "describe_eh": "Introduce (a) multiple-beam interference and its application; (b) light polarization and double refraction; (c) light diffraction. The contents include (1) the principle of the multiple-beam interference; (2) multiple-beam interference systems; (3) the classical theory of the refraction index; (4) Huygen's principle and its application; (5) light polarization and double refraction; (6) Fraunhofer diffraction; (7) Fresnel diffraction.",
    "pre_subname": "OPT2001光學(一)、PHYS1004普通物理(二)",
    "pre_sub_id3": "OPT2001",
    "pre_sub_ename": "OPT2001 OPTICS (1)、PHYS1004 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解光傳播原理和多光束干涉及光繞射原理。",
      "describe_en": "Be able to understand the principle of light propagation and the multi-beam interference and diffraction."
    },
    {
      "seq": 2,
      "describe_ch": "能理解光之同調性、偏振態及偏振元件改變光偏振態之原理。",
      "describe_en": "Be able to understand the coherence of light, the polarization state of an optical wave and working principles of various optical polarization elements."
    },
    {
      "seq": 3,
      "describe_ch": "能分析多光束干涉系統。",
      "describe_en": "Be able to analyze multi-beam interference systems."
    },
    {
      "seq": 4,
      "describe_ch": "能分析Fraunhofer 及Fresnel 繞射系統。",
      "describe_en": "Be able to analyze Fraunhofer and Fresnel diffraction systems."
    },
    {
      "seq": 5,
      "describe_ch": "能蒐集及閱讀光學相關英文文獻資料。",
      "describe_en": "Be able to collect and read optical related English literatures."
    }
  ],
