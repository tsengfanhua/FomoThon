  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解如何蒐集資料、執行實驗與詮釋數據。",
      "describe_en": "To know how to collect materials and information, execute an experiment and analyze the data."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解論文撰寫技巧。",
      "describe_en": "To know the skill of writing in thesis."
    },
    {
      "seq": 3,
      "describe_ch": "練習組織發表與演說報告。",
      "describe_en": "To practice the abilities in presentation and organization of a speech."
    }
