  "description": {
    "sub_id3": null,
    "sub_name": "英語教學概論",
    "sub_ename": "THEORIES OF EFL TEACHING AND LEARNING",
    "describe_ch": "了解英語教學領域中之學說，特別著重在得知第一及第二語言習得之原理。學生在學習此課程時應同時思考個人學習英文的學習信念及經驗，以便能理解及分析各家學說的基本原理。學生在上此課程時應參與討論主題、分享個人看法、及完成課程中所要求的任務。",
    "describe_eh": "This course helps students to understand key principles of teaching and learning English. In particular, it focuses on the aspects of first and second language acquisition. Students are expected to draw upon their own belief and experience in the learning of English more consciously in order to comprehend and analyze the fundamental framework of language acquisition. Students are encouraged to discuss topics, share ideas, and complete tasks in this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習語言學與英語教學相關領域的理論基礎與專業知識。",
      "describe_en": "To learn knowledge and theories in the fields of linguistics, Teaching English as a Foreign Language (TEFL) and the related areas"
    },
    {
      "seq": 2,
      "describe_ch": "應用語言學與英語教學相關知識於教學實務與教材設計。",
      "describe_en": "To apply the knowledge of linguistics and Teaching English as a Foreign Language (TEFL) to English Language Teaching (ELT) and course design"
    }
  ],
