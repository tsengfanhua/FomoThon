  "description": {
    "sub_id3": null,
    "sub_name": "筆譯概論",
    "sub_ename": "INTRODUCTION TO TRANSLATION",
    "describe_ch": "中英筆譯入門課程。除介紹筆譯原則、手法、技巧等，並透過中英互譯反覆演練，由句子開始進行到段落的翻譯，訓練學生分析譯入語和譯出語以及掌握中英文讀寫的技巧，培養學生未來在就業市場上具備基本筆譯的能力。 \r\n\r\n",
    "describe_eh": "This course is designed to introduce to students English-Chinese translation principles, approaches and techniques. Through repeated English-Chinese translation exercises beginning with sentences and progressing to paragraphs, students are trained to analyze source and target texts and to master reading and writing skills in both languages. It also aims to assist students in developing the competence to translate in the workplace.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備中英口筆譯基礎理論與策略的知識。",
      "describe_en": "To learn basic English-Chinese translation and interpretation theory and approaches"
    },
    {
      "seq": 2,
      "describe_ch": "綜合演練中英口筆譯，以精進聽說讀寫的能力。",
      "describe_en": "To integrate students' listening, speaking, reading and writing abilities through repeated English-Chinese translating and interpreting exercises"
    }
  ],
