  "targets": [
    {
      "seq": 4,
      "describe_ch": "能夠瞭解進行研究工作之方法及所需之邏輯概念，而能有效率且正確地進行各種不同類型的研究。",
      "describe_en": "The objective is to aid students in\r\nunderstanding the required logistical\r\nconcepts for conducting research works.\r\n"
    },
    {
      "seq": 5,
      "describe_ch": "能瞭解進行研究工作前所需之準備工作，如文獻蒐集，及研究進行時所需之方法及邏輯概念。",
      "describe_en": "The objective is to help students know\r\nhow to prepare the prerequisite works such as literature survey before starting research\r\n"
    },
