  "description": {
    "sub_id3": null,
    "sub_name": "國土規劃專論",
    "sub_ename": "SPECIAL TOPICS OF NATIONAL SPATIAL PLANNING",
    "describe_ch": "國土計畫為現今最高法定計畫，其內容影響整體都市及區域長期生活、生產及生態環境?甚至於一個地區的產業經濟活力?產業區發展方向?氣候變遷對於自然與人居環境的衝擊?又如空間發展結構未來國土計畫之推行，現行非都市土地使用管制應如何因?因此國土議題解決及應如何制訂相關對策，為本課程探討之重點。",
    "describe_eh": "The class focuses on the issues of national spatial planning development. Readings will be assigned and be prepared for class discussion during the seminar. Topics include urban spatial structure, national and resgional planning, environmental planning, land use issues, citizen participation, urban renewal, and GIS, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得及加強國土規劃計畫及研究之能力。",
      "describe_en": "Increase knowledge and ability of doing research in related national spatial planning research topics."
    },
    {
      "seq": 2,
      "describe_ch": "理解國土計畫時勢及趨勢及對國土及區域發展議題之了解及興趣。",
      "describe_en": "Increase ability and comprehension in understanding the trend and knowledge in national spatial planning research topics."
    }
  ],
