  "description": {
    "sub_id3": null,
    "sub_name": "家族傳承",
    "sub_ename": "FAMILY INHERITANCE",
    "describe_ch": "本課程幫助學生了解何謂家族傳承?家族傳承已經成為越來越重要的議題,尤其是企業從大陸轉戰回台,如何永續傳承經營企業變成一個重要的熱門課題,內容涵蓋法規制度與實務介紹, 增強學生未來職業生涯之就業能力。",
    "describe_eh": "We hope this course can help students understand what is ‘Family Inheritance”? Family inheritance becomes more important than ever before. Especially after the Taiwan business retreats from Mainland China and How to continue this business empire become an important issue for the Big boss of this business empire. Inheritance becomes important. Family inheritance becomes a hot issue. Students will learn basic law and some practical issues. Enchance their ability in future job career.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知道有關家族傳承的基本概念及其運作模式",
      "describe_en": "Knowledge for basic concept of family inheritance and management model"
    },
    {
      "seq": 2,
      "describe_ch": "能理解家族傳承經營理念",
      "describe_en": "Comprehension for family inheritance and operation concept."
    },
    {
      "seq": 3,
      "describe_ch": "具備家族傳承溝通能力",
      "describe_en": "Communication skill is an important skill for family inheritance"
    },
    {
      "seq": 4,
      "describe_ch": "具備家族傳承之解決問題能力",
      "describe_en": "Knowing the problem solving skill is also an important skill family inheritance"
    }
  ],
