    "cls_id": "CE09310",
    "sub_id": "45171",
    "scr_dup": "001",
    "sub_title": "新世代半導體製程技術介紹",
    "sub_title_en": null,
    "sub_describe": "介紹半導體製程，相關主題為熱製程, 擴散製程, 薄膜沉積, 蝕刻與金屬化製程介紹",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "新世代積體電路製程技術",
    "sub_ename": "SEMICONDUCTOR PROCESS AND TECHNOLOGY OF NEXT-GENERATION　INTEGRATED CIRCUITS",
    "describe_ch": "陳述新世代積體電路製程技術與原理，如高溫熱製程、薄膜沉積、微影、蝕刻、高介電薄膜、?緣層上矽、應變矽等製程技術，以及新世代邏輯與3維積體電路製程。能概述新世代半導體元件與積體電路半導體製程技術。",
    "describe_eh": "To states the semiconductor process technologies of the integrated circuit, such as high-temperature thermal process, film deposition, lithography, etching, high-k films, silicon-on-insulator, strained silicon, and other next-generation process technologies. The new-generation logic and 3D integrated circuit process technology of nano-semiconductor devices fabrication is also introduced.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知悉新世代積體電路半導體製程技術與原理",
      "describe_en": "To know the principle and technology development of next generation integrated circuits of semiconductor fabrication process."
    },
    {
      "seq": 2,
      "describe_ch": "能了解新世代奈米半導體元件製程與積體電路製程技術與應用",
      "describe_en": "To understand the technology and application of the next generation integrated circuits of nano-device semiconductor fabrication process."
    }
  ],
