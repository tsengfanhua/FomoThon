  "description": {
    "sub_id3": null,
    "sub_name": "不動產投資",
    "sub_ename": "REAL ESTATE INVESTMENT",
    "describe_ch": "本課程旨在介紹不動產的基本與重要知識，並提供學生學習如何在不動產市場做出投資決策。主要內容包括不動產基本概念、不動產市場發展與投資環境、不動產市場分析方法、不動產法規制度與稅賦，以及金融市場的分析與應用。",
    "describe_eh": "This course introduces the concepts of real estate and provides students to learn how to make investment decisions in the real estate market. Topics covered knowledge of real estate, as well as the tendency, investment environment, finance management, tax, and financial market in the real estate market.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道不動產市場之基本知識",
      "describe_en": "Knowledge for basic concepts of the real estate market"
    },
    {
      "seq": 2,
      "describe_ch": "理解不動產投資相關分析工具與管理",
      "describe_en": "Comprehension for real estate investment-related analytical instruments and management"
    },
    {
      "seq": 3,
      "describe_ch": "利用財務管理分析工具，分析與評估不動產投資之決策",
      "describe_en": "Be able to use instruments of financial management to analyze and evaluate decisions of real estate investment"
    }
  ],
