  "description": {
    "sub_id3": null,
    "sub_name": "生醫工程導論",
    "sub_ename": "INTRODUCTION TO  BIOCHEMICAL ENGINEERING",
    "describe_ch": "簡介生物醫學工程學。生物醫學工程是結合工程科學、生物與臨床醫學之學科。它包含領域相當廣泛，有電子、光學、化學、機械、控制等等工程領域，應用其工程原理於醫學上去了解和控制生物系統，以利疾病之診斷與治療科，為一健康照護之生命科學。",
    "describe_eh": "It is a introduction course of biomedical engineering. Biomedical engineering is a highly interdisciplinary field, which include biology, medicine and engineering. It applies electrical, chemical, optical, mechanical, and other engineering principles to understand, modify, or control biological systems. It combines the design and problem solving skills of engineering with medical and biological sciences to improve healthcare diagnosis, monitoring and therapy.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": " 瞭解專門工程領域應用於生物醫學的科技新知。",
      "describe_en": " To understand the novel application of engineering principles to medicine and biology in special topic."
    },
    {
      "seq": 2,
      "describe_ch": "能以書面或口頭方式表達所研讀的生醫工程相關資料。",
      "describe_en": "Communicate the reading data about biomedical engineering by written or oral form."
    },
    {
      "seq": 3,
      "describe_ch": "經由實驗了解醫療器材工作原理。",
      "describe_en": "Comprehension for the working principle of medical devices by experiments."
    }
  ],
