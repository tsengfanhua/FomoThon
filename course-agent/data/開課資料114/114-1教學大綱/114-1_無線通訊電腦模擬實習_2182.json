  "description": {
    "sub_id3": null,
    "sub_name": "無線通訊電腦模擬實習",
    "sub_ename": "PRACTICAL TRAINING FOR COMPUTER SIMULATION OF WIRELESS COMMUNICATIONS",
    "describe_ch": "本實習課程以軟體來模擬在不同通道模式下的無線通訊系統之收發架構。學生可從實習中學到包括展頻通訊、多載波通訊、空時碼、多輸入多輸出等當代重要的無線通訊技術，並將模擬結果與理論互相印證。",
    "describe_eh": "This course adopts software to simulate various transceiver and channel models in modern wireless communication systems, including spread-spectrum systems, multicarrier systems, space-time coding systems, MIMO systems, and etc.. By simulation, students can learn and verify modern communication theories and technologies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解不同無線通訊系統其收發架構之數學模型。",
      "describe_en": "To comprehend various mathematical models for different wireless communication systems."
    },
    {
      "seq": 2,
      "describe_ch": "能藉由實習來驗證並瞭解不同無線通訊系統之間的差異。",
      "describe_en": "Be able to verify and understand the differences between various wireless communication systems."
    }
  ],
