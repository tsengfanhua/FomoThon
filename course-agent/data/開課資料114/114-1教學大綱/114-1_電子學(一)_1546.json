  "description": {
    "sub_id3": null,
    "sub_name": "電子學(一)",
    "sub_ename": "ELECTRONICS(1)",
    "describe_ch": "本課程的目標是使學生了解電子學元件特性及電子電路的相關設計技術，包含運算放大器電路、二極體、雙載子電晶體及金氧半場效電晶體等元件及相關電路應用。此課程將使學生對電子元件及電路具備分析及設計的能力,也教導學生熟悉各類的放大器電路並對未來的類比及數位電路設計奠定基礎。",
    "describe_eh": "This course will let students understand the characteristics of electronic devices including operational amplifier circuits, diodes, bi-carrier transistors, and metal-oxide field-effect transistors(MOSFET), and related circuit applications. This course will also Inspire students with the ability to analyze and design electronic devices and circuits. It will also teach students to be familiar with various amplifier circuits and lay the foundation for the circuit design.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的專業詞彙描述電子學中基本半導體理論與電子元件，諸如，各類二極體與BJT電晶體等，相關知識。",
      "describe_en": "Have the knowledge of fundamental semiconductor and basic electronic devices , such as diodes and BJT transistors."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明各類電子元件的操作以及其應用電子電路的組成。",
      "describe_en": "Comprehend the operation of all electronic devices mentioned above, and their applications on electronic circuits."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解與應用方程式以及模型數學算式技術，做電子開關電路與放大器的偏壓分析、電路分析與放大器分析，以及放大器的小信號交流特性分析方法。",
      "describe_en": "Comprehension of the techniques about using the equation and models to analyze the DC-biasing of the circuits , such as the switch -circuits and amplifiers, and the small-signal ac characteristics of an amplifier."
    }
  ],
