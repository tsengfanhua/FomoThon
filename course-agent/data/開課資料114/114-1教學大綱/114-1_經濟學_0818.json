  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB35512",
    "sub_id": "57550",
    "scr_dup": "001",
    "sub_title": "包含個人與市場、企業與市場、政府與經濟、總體經濟學與行為經濟學。",
    "sub_title_en": null,
    "sub_describe": "將經濟學的觀念文字化，以敘述方式說明經濟學的觀念，並且以日常生活事例，讓學生能輕易理解經濟學的思惟方式和運用方法。\n本課程強調市場經濟運作中，各個參與者（包括家庭、企業、非營利事業和政府）的互動關係，以及由其形成的各種經濟現象，以平易近人的方式介紹經濟理論，更加入即席思考與個案實例，探索事件的經濟觀點，有助於學生在生活中落實經濟學的理論。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "經濟學",
    "sub_ename": "ECONOMICS",
    "describe_ch": "本課程提供個體與總體經濟的基礎介紹，主題包括：供給、需求與價格機能運作；市場經濟下的家戶、廠商與政府決策；整體產出、金融體系、失業、物價膨脹、匯率與利率；財政與貨幣政策。\r\n",
    "describe_eh": "This course provides an introduction to microeconomic and aggregate economic analysis. Topics include supply, demand, and the coordinating role of prices in a market economy; decision making by households, firms, and government in a market-oriented economy; national output, banking systems, unemployment, inflation, exchange rates, and interest rates； fiscal policy and monetary policy.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 5,
      "describe_ch": "理解供需原理與價格機能運作",
      "describe_en": "Comprehending principles of supply and demand, and operations of the price mechanism"
    },
    {
      "seq": 6,
      "describe_ch": "理解市場經濟下的家戶、廠商與政府決策",
      "describe_en": "Comprehending decision making by households, firms, and government in a market-oriented economy"
    },
    {
      "seq": 7,
      "describe_ch": "理解整體產出、金融體系、失業、物價膨脹、匯率與利率",
      "describe_en": "Comprehending an economy's output, banking systems, unemployment, inflation, exchange rates, and interest rates"
    },
    {
      "seq": 8,
      "describe_ch": "理解貨幣政策與財政政策",
      "describe_en": "Comprehending fiscal policy and monetary policy"
    }
  ],
