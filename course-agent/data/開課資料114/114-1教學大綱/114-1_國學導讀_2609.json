  "description": {
    "sub_id3": null,
    "sub_name": "國學導讀",
    "sub_ename": "GUIDED READING OF CLASSICAL CHINESE STUDIES",
    "describe_ch": "本課程旨在引導學生瞭解中國古代知識分類架構及其內涵，通過對經、史、子、集等歷代重要文獻之介紹，掌握傳統學術發展脈絡，進而引發研究國學之興趣。",
    "describe_eh": "The introduction to basic knowledge of documentation will serve as the foundation of the course. This will be followed by guiding students to know major texts of the four categories of traditional texts and relevant auxiliary knowledge. All these aim at providing students with a broad perspective, critical attitude and thus enable them to discover and solve problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解中國古代知識分類架構。",
      "describe_en": "To understand the categories of China's ancient knowledge."
    },
    {
      "seq": 2,
      "describe_ch": "綰合傳統文獻與當代文化議題。",
      "describe_en": "Connect the tradition literature and current culture issues"
    }
  ],
