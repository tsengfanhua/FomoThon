  "description": {
    "sub_id3": null,
    "sub_name": "現代軍事學概論",
    "sub_ename": "A STUDY ON THE MODERN THEORIES OF MILITARY STRATEGICS",
    "describe_ch": "本課程是教導青年學生必要的軍事科學知識，藉以培養未來理性決策的多元能力，並且能凝聚國家精神與意志；並對軍事學有興趣的學生開設，教導學生從古至今軍事學理念及發\n展，以期充實學生對於人類在文明的過程中所產生的衝突及發生戰爭的原因，增廣其對於軍事學的內涵和知能之課程目標。",
    "describe_eh": "The course teaches students necessary militaristic and scientific knowledge needed to cultivate a strong sense of national spirit. For students who are interested in militaristic theories, this course offers guidance pertaining to the theories starting from ancient times to the present. Students can be enriched with a broadened sense of mind on topics of war, mankind and civilization.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "開展全球歷史地理宏觀視野，能尊重多元價值、能進行價值的反思、能提出個人的價值判斷。",
      "describe_en": "While taking a worldwide perspective and highlighting multicultural values, we are to bring forth our value judgments with reflective thinking."
    },
    {
      "seq": 2,
      "describe_ch": "探索科技知識原理，能整合跨領域的知識並持續該相關領域的學習。",
      "describe_en": "We are to explore cross-disciplinary know-why, starting from the technical field and spreading into related areas."
    }
  ],
