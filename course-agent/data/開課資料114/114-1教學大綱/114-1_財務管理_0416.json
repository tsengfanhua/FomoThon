  "description": {
    "sub_id3": null,
    "sub_name": "財務管理",
    "sub_ename": "FINANCIAL MANAGEMENT",
    "describe_ch": "財務管理是希望能訂定最適的財務決策，包括資本預算、資本結構、股利政策及營運資金的管理等，以達到追求股東財政極大化之目標。",
    "describe_eh": "Corporate finance has three main areas of concern: 1. Capital budgeting. 2. Capital structure. 3. Working capital management. The goal of financial management is to maximize the shareholders wealth.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能獲得財務評價方面的知識。",
      "describe_en": "To know the basic knowledge of financial valuation."
    },
    {
      "seq": 2,
      "describe_ch": "能理解影響金融商品價值的因素",
      "describe_en": " Comprehension for the values of financial products be affected"
    },
    {
      "seq": 3,
      "describe_ch": "能應用數學、統計與使用電腦與程式設計解決財務評價的問題",
      "describe_en": "To apply Mathematics and Statistics, computer software to solve the valuation problems."
    }
  ],
