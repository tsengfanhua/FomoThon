    "tpa_score_new": "<div>(1)&nbsp;&nbsp;&nbsp; Paper presentation: 40%</div>\n\n<div>(2)&nbsp;&nbsp;&nbsp; Mid-term: 20%</div>\n\n<div>(3)&nbsp;&nbsp;&nbsp; Final-term: 20%</div>\n\n<div>(4)&nbsp;&nbsp;&nbsp; Participation: 10%</div>\n\n<div>(5)&nbsp;&nbsp;&nbsp; Discussion: 10%</div>\n\n<div>i.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Asking questions</div>\n\n<div>ii.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Answering questions</div>\n",
