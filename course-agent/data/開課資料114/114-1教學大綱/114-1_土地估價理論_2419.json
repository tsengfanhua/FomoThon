  "description": {
    "sub_id3": null,
    "sub_name": "土地估價理論",
    "sub_ename": "SPECIAL TOPIC ON LAND VALUATION",
    "describe_ch": "內容包括價值理論、估價原則、價格影響因素分析、成本法、收益法、比較法、旅遊成本法、特徵估價法、條件估價法等，引導對不動產市場與土地資源估價課題之研究。\r\n\r\n",
    "describe_eh": "Topics include value, appraisal principles, factors and concepts of property and property right. Learn how to use the cost approach, income approach, market approach, travel cost, hedonic prices valuation, contingent method to estimate the property and resources value. Analysis of the valuation problems by theorem and methods.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得土地估價基本知識\t",
      "describe_en": "Obtain the basic knowledge of land valuation."
    },
    {
      "seq": 2,
      "describe_ch": "了解各類土地估價運用現況\t",
      "describe_en": "Understanding the current regulation of land valuation."
    },
    {
      "seq": 3,
      "describe_ch": "將理論運用於土地管理實務\t",
      "describe_en": "Application of land valuation."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解國際土地估價現況\t",
      "describe_en": "Understanding the global land valuation."
    }
  ],
