  "description": {
    "sub_id3": null,
    "sub_name": "機電概論與工程倫理",
    "sub_ename": "INTRODUCTION TO MECHANICAL AND COMPUTER-AIDED ENGINEERING & ENGINEERING ETHICS",
    "describe_ch": "本課程提供大一新生對機械與電腦輔助工程領域有整體的認知，並介紹工程倫理概念。課程內容涵蓋工程倫理，數理基礎課程以及固力、設計、製造、熱流、控制、電腦輔助等專業領域課程之介紹。本課程並介紹相關專業領域在機械工業及其他產業之應用.",
    "describe_eh": "This course introduces the undergraduate basis for mechanical and computer-aided engineering, and introduces the concept of engineering ethics. The introduced courses include engineering ethics, solid mechanics, design and manufacturing, thermal and fluid mechanics, automatic control, and computer-aided engineering. The applications of the fundamental principles on the mechanical industries are also introduced.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.建立工程倫理(企業倫理)與職業道德之正確觀念，使學生習得專業智識外，亦能對就業觀念有所認知。",
      "describe_en": "Construct correct concept of engineering ethics (enterprise ethics). Let students understand techniques, also touch employment knowledge."
    },
    {
      "seq": 2,
      "describe_ch": "通盤了解本系必修與選修之基礎學科及專業科目。(基礎科學、固力與設計、熱流、製造、控制等)",
      "describe_en": "Understand the courses for mechanical and computer-aided engineering."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解機械與電腦輔助工程技術在產業界之應用。(工具機、航太、產業機械、零組件、加工技術等)",
      "describe_en": "Understand the application of mechanical and computer-aided engineering techniques on the industry."
    },
    {
      "seq": 4,
      "describe_ch": "4. 藉由工程倫理之探討，建立個人與群體良性互動關係，以順利融入職場與社會。",
      "describe_en": "Obtain a good relationship between personal and group by means of engineering ethics."
    }
  ],
