  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(一)",
    "sub_ename": "ENGINEERING MATHEMATICS(1)",
    "describe_ch": "本課程主要在教導學生如何將科學或工程上的問題用?學方法?表示，提升學生?學思考能?。課程的內容主要包含一階、二階微分方程求解、?普?斯轉換與冪級?等議題。",
    "describe_eh": "This course is a study of the concept and method in engineering mathematics. To enhance student fundamental capability to solve some problems in science and engineering. Ordinary differential equations (ODE's) deal with functions of one variable, which can often be thought of as time. Topics include: Solution of first-order ODE's methods, solution of second-order ODE's methods, Laplace transform methods, and Power series.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 10,
      "describe_ch": "能理解微分方程式及拉普拉斯變換的特性。",
      "describe_en": "Comprehension for the characteristics of differential equations and Laplace transform."
    },
    {
      "seq": 11,
      "describe_ch": "能應用微分方程式以解決科學或工程問題。",
      "describe_en": "Apply differential equations to solve the problems in science or engineering."
    },
    {
      "seq": 12,
      "describe_ch": "能分析一個線性系統計算程序，並得出其解。",
      "describe_en": "Analysis for the calculating procedures in a linear system, and to obtain the solution."
    }
  ],
