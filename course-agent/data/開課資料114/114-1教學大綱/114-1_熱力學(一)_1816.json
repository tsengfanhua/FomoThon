  "description": {
    "sub_id3": null,
    "sub_name": "熱力學(一)",
    "sub_ename": "THERMODYNAMICS(1)",
    "describe_ch": "首先適切的呈現一些新的熱物理觀念與定義並定義出那些可量測和其他不可量測的熱力學性質，接著介紹各種熱力學性質表。透過熱力學第一定理介紹兩種熱力學性質─內能與焓，由第二定理介紹另一種性質─熵。此外，包含很多符合真實環境的實際範例來協助學生達到瞭解熱力學的目的。",
    "describe_eh": "New thermophysical concepts and definitions are presented in the context where they are first relevant in natural progression. The first thermodynamic properties to be defined are those that can be readily measured and others. Internal energy and enthalpy are introduced in connection with the first law, entropy with the second law. Many real world realistic examples have been included in the course to assist the student in gaining an understanding of thermodynamics.",
    "pre_subname": "PHYS1003普通物理(一)、PHYS1004普通物理(二)",
    "pre_sub_id3": "PHYS1003",
    "pre_sub_ename": "PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解對古典熱力學範圍廣泛和嚴密的處理方法。",
      "describe_en": "To know a comprehensive and rigorous treatment of classical thermodynamics."
    },
    {
      "seq": 2,
      "describe_ch": "了解系統之能量守恆分析。",
      "describe_en": "To understand the energy conservation analysis for thermodynamic systems."
    },
    {
      "seq": 3,
      "describe_ch": "應用熱力學第一及第二定律進行工程系統分析。",
      "describe_en": "To apply the 1st and 2nd thermodynamic laws to engineering systems."
    }
  ],
