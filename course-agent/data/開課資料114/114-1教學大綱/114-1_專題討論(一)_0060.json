  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(一)",
    "sub_ename": "SEMINAR(1)",
    "describe_ch": "藉由文獻專題討論講授研究方法, 培養學生發掘問題及蒐集資料之能力, 進而熟悉各領域所探討的訴求及重點, 以加強對IE的應用能力。",
    "describe_eh": "This course is designed to study and discuss concept and applications of IE by literature review.  Students then should know how to collect and analyze information and how to apply IE theory and skills solve problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 6,
      "describe_ch": "培養學生的研究和探索能力，並擴展他們對太空領域的知識和洞察力。",
      "describe_en": "Cultivate students' research and exploratory skills, and expand their knowledge and insights into the field of space."
    },
    {
      "seq": 7,
      "describe_ch": "強化學生的批判思考和問題解決能力，並培養獨立思考和學術討論的能力。",
      "describe_en": "Enhance students' critical thinking and problem-solving skills, and foster independent thinking and academic discussions."
    },
    {
      "seq": 8,
      "describe_ch": "提供學生學術演講和研究報告的機會，培養他們的溝通和表達能力。",
      "describe_en": "Provide students with opportunities for academic presentations and research reports, cultivating their communication and presentation skills."
    },
    {
      "seq": 9,
      "describe_ch": "促進學生之間的跨學科交流和合作，擴大他們的學習視野。",
      "describe_en": "Facilitate interdisciplinary exchange and collaboration among students, broadening their learning perspectives."
    },
    {
      "seq": 10,
      "describe_ch": "探索太空科學和工程領域的前沿議題和研究趨勢，培養學生對新興技術和創新方案的敏感度。",
      "describe_en": "Explore cutting-edge issues and research trends in space science and engineering, cultivating students' sensitivity to emerging technologies and innovative solutions."
    },
    {
      "seq": 11,
      "describe_ch": "培養學生的專業態度和職業素養，並提供就業和進一步學術研究的準備。",
      "describe_en": "Foster students' professional attitude and work ethics, while preparing them for future employment and further academic research."
    }
  ],
