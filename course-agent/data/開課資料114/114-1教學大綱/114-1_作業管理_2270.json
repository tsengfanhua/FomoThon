  "description": {
    "sub_id3": null,
    "sub_name": "作業管理",
    "sub_ename": "OPERATIONS MANAGEMENT",
    "describe_ch": "本課程的目的是使學生能在作業策略的基礎應用，著重作業管理實務的應用，使學生能由所學的技能應用在企業經營活動，並以實際的案例問題，使學生具備分析問題與解決問題的能力，並達成QCD的作業效率。",
    "describe_eh": "This curriculum's goal is enables the student in the Operations strategy foundation application, the Operations management practice's application, enables the student emphatically by the skill application which studies in the business Model, and by the actual case question, causes the student to have the analysis question with to solve the question ability, and achieves QCD the Operations efficiency.",
    "pre_subname": "MGT1001管理學",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能以中英文描述生產與作業管理的定義，以及它對組織運作的影響。",
      "describe_en": "Describe the definition of production and operations management and the impact on organization in both Chinese and English."
    },
    {
      "seq": 2,
      "describe_ch": "能以團隊方式完成生產作業管理問題分析。",
      "describe_en": "Team work on production operations management problem to enhance students' problem solving skill."
    }
  ],
