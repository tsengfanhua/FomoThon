  "description": {
    "sub_id3": null,
    "sub_name": "矩陣原理",
    "sub_ename": "MATRIX PRINCIPLES",
    "describe_ch": "本課程將探討矩陣與線性變換的進階理論與相關應用，內容包括內積空間、最小平方法、極小範數解、二次型式、傅立葉級數、喬登標準型式、奇異值分解等主題。",
    "describe_eh": "This course will explore advanced theory and related applications of matrices and linear transformations. The materials include inner product spaces, least squares, minimum solutions, quadratic forms, Fourier series, Jordan canonical form and singular value decompositions.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解矩陣與線性變換的進階性質",
      "describe_en": "To comprehend advanced properties of matrices and linear transformations"
    },
    {
      "seq": 2,
      "describe_ch": "能應用矩陣分解解決實際問題",
      "describe_en": "To apply matrix decompositions to solve practical problems"
    },
    {
      "seq": 3,
      "describe_ch": "能分析向量空間與內積空間的代數結構",
      "describe_en": "To analyze the algebraic structures of vector spaces and inner product spaces"
    }
  ],
