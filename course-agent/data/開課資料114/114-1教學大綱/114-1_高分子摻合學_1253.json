    {
      "seq": 1,
      "describe_ch": "高分子/高分子摻合、混煉與加工知識",
      "describe_en": "Knowledge of polymer/polymer blending, compounding, and processing"
    },
    {
      "seq": 2,
      "describe_ch": "高分子/添加劑摻合、混煉與加工知識",
      "describe_en": "Knowledge of polymer/additive blending, compounding, and processing"
    },
    {
      "seq": 3,
      "describe_ch": "高分子複合材料檢測分析知識",
      "describe_en": "Knowledge of polymer composite characterization and analysis"
    }
  ],
