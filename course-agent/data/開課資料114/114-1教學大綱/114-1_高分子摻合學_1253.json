  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE05140",
    "sub_id": "33771",
    "scr_dup": "001",
    "sub_title": "高分子摻合、混煉與複合材料加工知識",
    "sub_title_en": null,
    "sub_describe": "1. 高分子/高分子摻合、混煉與加工知識\n2. 高分子/添加劑摻合、混煉與加工知識\n3. 高分子複合材料檢測分析知識",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "高分子摻合學",
    "sub_ename": "POLYMER BLENDS",
    "describe_ch": "課程內容涵蓋摻合物的熱力學與相容性、界面現象、加工技術、結構－性能關係等基礎理論，並結合實例介紹如工程塑膠、生醫材料與環保材料等應用。學生將學習如何設計具備特定機械性質、熱穩定性或功能性的高分子複材，培養材料設計與應用整合的能力，為未來研究或產業發展奠定基礎。",
    "describe_eh": "\r\nThe course content encompasses fundamental theories such as the thermodynamics and compatibility of polymer blends, interfacial phenomena, processing techniques, and structure–property relationships. These topics are integrated with practical examples, including applications in engineering plastics, biomedical materials, and environmentally friendly materials. Students will learn how to design polymer composites with tailored mechanical properties, thermal stability, or specific functionalities, thereby developing the ability to integrate material design with practical applications. This course aims to lay a solid foundation for future research or industrial development.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
