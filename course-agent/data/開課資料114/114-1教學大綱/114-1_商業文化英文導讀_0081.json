  "description": {
    "sub_id3": null,
    "sub_name": "商業文化英文導讀",
    "sub_ename": "INTRODUCTION TO BUSINESS CULTURE ENGLISH",
    "describe_ch": "本課程旨在使學生習得商用英文基本觀念及用語, 解析文章的架構與表達方式並能夠閱讀的全球商業相關文章。",
    "describe_eh": "This course is designed to equip students with the basic concepts and terminology of business English, an understanding of the structure and presentation of texts, and the ability to read texts related to global business.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能熟悉商業用語，增加字彙量，進而理解報導文意。",
      "describe_en": "Familiarise with business terminology and increase vocalisation in order to understand the meaning of the report."
    },
    {
      "seq": 2,
      "describe_ch": "具有商業文章報導重點歸納分析能力。",
      "describe_en": "Ability to summarise and analyse the main points of a business article."
    }
  ],
