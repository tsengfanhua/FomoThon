  "description": {
    "sub_id3": null,
    "sub_name": "稅務會計理論與實務",
    "sub_ename": "TAX ACCOUNTING THEORY AND PRACTICE",
    "describe_ch": "本課程主要目的在於提供會計分析基礎理論及稅務上的討論，並提供學術及實務上的重要議題探討，提供學生未來分析企業商業行為及實務應用上。",
    "describe_eh": "The course provides the basic accounting theory and tax practice for students to learn how to analysis the business behavior and incorporate the theory into the practice. Using theories of accounting academic research and current accounting debate cases, we will critically evaluate contemporary issue based on accounting issues and the profession.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生能運用實證分析及邏輯分析評估現階段會計議題。",
      "describe_en": "Student possess critical thinking capability in advanced accounting theory and issue on accounting debate cases."
    },
    {
      "seq": 2,
      "describe_ch": "學生能理解、使用並活用會計專業理論知識",
      "describe_en": "Students are able to be effective communicators and develop a problem-solving skill in the accounting practice."
    }
  ],
