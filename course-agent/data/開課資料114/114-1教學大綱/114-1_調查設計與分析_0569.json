  "description": {
    "sub_id3": null,
    "sub_name": "調查設計與分析",
    "sub_ename": "SURVEY DESIGN & ANALYSIS",
    "describe_ch": "主要內容為學習調查過程之所需的設計方法、抽樣方法及分析方法，包括抽樣設計的步驟及問卷設計所需注意的事情及其優缺點、調查誤差及處理未回答問題，並討論常用於分析調查資料的類別資料分析及多變量分析的方法。",
    "describe_eh": "This course aims to learn statistical methodologies in survey designs. The content includes learning how to design and pretest a questionnaire such as reliability and validity analysis in sampling methods, identifying the advantage/disadvantage of various survey design, survey error, dealing with nonresponse questions, and the methods for analyzing questionnaire data. We will discuss methods include categorical data analysis and multivariate data analysis for survey design.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解調查設計的原理及各種方法",
      "describe_en": "Comprehend theory, principle and methods of survey design"
    },
    {
      "seq": 2,
      "describe_ch": "應用設計原理提出一適當的抽樣設計",
      "describe_en": "Apply the principle of design to propose suitable sampling scheme for a given case"
    },
    {
      "seq": 3,
      "describe_ch": "應用調查資料進行統計分析",
      "describe_en": "Apply the methods to analyzing the data from questionnaire"
    }
  ],
