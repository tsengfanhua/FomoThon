  "description": {
    "sub_id3": null,
    "sub_name": "當代土地利用爭議議題",
    "sub_ename": "CONTEMPORARY ISSUES OF LAND USE",
    "describe_ch": "帶領同學本於所學專業討論近年國內、外所發生的土地問題，包括土地開發、土地稅、租賃關係、環境變遷等在社會上所引發高度關注的議題，希望讓學生可以學以致用，對於目前社會上所發生的重要土地利用議題具有一定程度的了解與觀察，並有自己的看法及回應能力。",
    "describe_eh": "This course plans to lead students to discuss some critical issues about land policies and laws base on the knowledge that students have learned in this two years. Issues could include land development and conservation, environmental protection, land tax, real estate rent, and climate change in Taiwan or worldwide. This course expects that students would have abilities to put into practice what has been learned, also have ability to analyze and respond to these important events in our society.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 4,
      "describe_ch": "掌握每個土地利用問題的核心議題\t",
      "describe_en": "Handle the core issues in all of the problems about land use."
    },
    {
      "seq": 5,
      "describe_ch": "熟悉國家法規及政策，並能夠活用來解決並分析問題\t",
      "describe_en": "Know the laws and policies in Taiwan, and use it to solve the problems."
    },
    {
      "seq": 6,
      "describe_ch": "隨時了解全球及臺灣所發生的土地利用議題\t",
      "describe_en": "Follow the land use issue which happened in the world."
    }
  ],
