  "description": {
    "sub_id3": null,
    "sub_name": "都市計畫與空間資訊實習(六)",
    "sub_ename": "PRACTICE OF URBAN PLANNING AND SPATIAL INFORMATION(6)",
    "describe_ch": "本課程為較大尺度的專案執行綜合訓練，並應用新技術回應生態永續、氣候變遷與都市防災的需求。課程主要在培育學生地區整體規劃及策略研擬能力，透過資料收集、現勘、調查等方法學習對一個地區的整體發展提出策略。",
    "describe_eh": "This course offers a comprehensive training in project implementation for a larger spatial scale and places great emphasis on ecological sustainability, climate changing, and urban disaster prevention. It is intended to enhance students’ strategic planning ability. By means of data collection, field survey, group discussion and oral presentation, students are expected to learn the skills of issues analysis and strategic development for a district.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 6,
      "describe_ch": "能獲得發現問題解決問題的專案管理能力",
      "describe_en": "Synthesis of possessing project management abilities of problem founding and solving."
    },
    {
      "seq": 7,
      "describe_ch": "能應用溝通協調與團隊合作的成效解決問題",
      "describe_en": "Application of effects in communication, negotiation and team working to problem-solving.\r\n"
    },
    {
      "seq": 8,
      "describe_ch": "能應用專業倫理與社會服務於專業實務",
      "describe_en": "Application of professional ethics and social responsibility to professional practice."
    },
    {
      "seq": 9,
      "describe_ch": "能應用生態永續、氣候變遷與都市防災的技術於大尺度計畫",
      "describe_en": "Application of techiques in ecological sustainability, climate changing, and urban disaster prevention to larger scale planning."
    },
    {
      "seq": 10,
      "describe_ch": "能分析複雜城鄉議題並培養決策能力",
      "describe_en": "Analysis of complex urban-rural development issues as well as fostering abilities of decision making.\r\n"
    }
  ],
