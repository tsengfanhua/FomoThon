  "description": {
    "sub_id3": null,
    "sub_name": "電子學實驗(一)",
    "sub_ename": "ELECTRONICS LAB.(1)",
    "describe_ch": "本課程以實驗教學驗證電子學(一)課程內容，學生可實際操作分析基本電子元件與應用電路，訓練學生使用電子儀表，瞭解二極體、雙載子接面電晶體和運算放大器等元件特性，熟練電子電路接線技術，並能應用電腦軟體模擬分析基本電子電路。",
    "describe_eh": "Students will learn design and breadboarding of small signal electronic devices and circuits, experimental measurement of diode and BJT device characteristics, and verification of circuit performance employing laboratory instrumentation. The courses includes laboratory familiarity with electronic instrumentation, diode and BJT characterization, power supply circuits, BJT amplifiers, operational amplifiers and electronic circuit simulation using PSPICE.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解各種電子實驗設備之基本功能與知識",
      "describe_en": "Understanding the basic function and knowledge of various electronic instruments."
    },
    {
      "seq": 2,
      "describe_ch": "理解各種電子實驗設備之工程原理",
      "describe_en": "Comprehension for the engineering principle of various electronic instruments."
    },
    {
      "seq": 3,
      "describe_ch": "應用各種電子實驗設備完成電子電路之測試與設計\r\n",
      "describe_en": "Application for the electronic instruments to circuit testing and design."
    },
    {
      "seq": 4,
      "describe_ch": "運用電子電路分析軟體完成電子電路之特性分析",
      "describe_en": "Apply the circuits simulation tool box to circuits characteristic analysis."
    }
  ],
