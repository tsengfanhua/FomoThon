  "description": {
    "sub_id3": null,
    "sub_name": "財務統計應用",
    "sub_ename": "APPLICATIONS OF STATISTICS TO FINANCE",
    "describe_ch": "本課程延伸大二統計學課程內容，並探討統計於財務的應用。課程涵蓋隨機變數、多元分配、期望值與變異數、非常態分配之參數估計與檢定、順序統計量。",
    "describe_eh": "This course focuses on the applications of statistics to finance and covers several topics, such as random variables, multi-variate distributions, expected value and variance, estimating and testing the parameters of non normal distribution, and order statistics.",
    "pre_subname": "CEM1006微積分",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
