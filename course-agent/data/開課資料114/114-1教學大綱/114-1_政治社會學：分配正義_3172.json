    {
      "seq": 1,
      "describe_ch": "意識形態作為追求理想生活的基礎",
      "describe_en": " Ideology as the basis for the pursuit of an ideal life"
    },
    {
      "seq": 2,
      "describe_ch": "全球化下的左派與右派價值的選擇",
      "describe_en": " In a Globalized World, the Left and the Right clash."
    }
