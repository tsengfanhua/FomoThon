  "description": {
    "sub_id3": null,
    "sub_name": "國際商用英文寫作實務",
    "sub_ename": "INTERNATIONAL BUSINESS ENGLISH WRITING PRACTICE",
    "describe_ch": "本課程著重於學術與商業寫作。課程將涵蓋摘要寫作、 三類短文體裁及商業書信，使學生能夠在學術與商業情境下以英文撰寫組織嚴謹、條理清晰的文章與商業文件；並且整合所學的內容完成團隊寫作專案。",
    "describe_eh": "The course focuses on academic and business writing trainings, including summary/abstract writing; three modes of essays; and business letters and documents. The course aims to equip students with the ability to produce well-organized, logical, and lucid essays and business documents.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
