  "description": {
    "sub_id3": null,
    "sub_name": "氣候變遷與城市化",
    "sub_ename": "CLIMATE CHANGE AND URBANIZATION",
    "describe_ch": "本課程將著重於探討氣候與環境變遷、都市化及永續發展相關議題，透過課程講授與討論，使學生對於全球環境變遷其過去、現在、未來趨勢、成因及影響等有所瞭解，並檢視國際上可行、成功之都市減緩及調適策略與案例。",
    "describe_eh": "This course will focus on the issues related to climate and environmental change, urbanization, and sustainable development via lecture and interative discussion. The student will be familiar with the past, present, and future of the global climate change, and the causes and effects of it. The feasible and successful strategies /case studies of the mitigation and adaptation will be also introduced.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養學生具備有因應未來氣候與環境變遷下都市規劃之相關知識。",
      "describe_en": "Teach students with relevant knowledge of urban planning in response to future climate and environmental changes."
    },
    {
      "seq": 2,
      "describe_ch": "增進學生發展學術獨立研究能力",
      "describe_en": "Increase the academic independent research ability for the students."
    },
    {
      "seq": 3,
      "describe_ch": "利用相關議題國際案例與策略教授，強化學生國際觀",
      "describe_en": "Strengthen the international perspective of the  students via introducing the international mitigation and adaptation stategies/case studies."
    }
  ],
