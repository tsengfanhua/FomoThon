  "description": {
    "sub_id3": null,
    "sub_name": "整合性專題實作(一)",
    "sub_ename": "INTEGRATED PRACTICAL PROJECT (1)",
    "describe_ch": "本課程的主要目的為提升大學部同學之研究與寫作能力。學生須依照專題計畫書完成專題研究。經由此課程的訓練，學生可增加在資料蒐集、研究報告寫作、及獨立研究的能力。學生須與指導老師經常討論專題。",
    "describe_eh": "The objective of this course is to enhance college students' research and writing ability. Students select their preferred research topics in the fields of transportation, which are provided by teachers. Through this course, we intend to increase student's ability on data collection, paper writing and independent study. Students will have to meet with their supervisor to discuss the research topic on a regular basis",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.各類交通運輸系統的特性以及運作概念\r\n\r\n",
      "describe_en": "1. Understand characteristics and operation concept of various transportation systems."
    },
    {
      "seq": 2,
      "describe_ch": "20.獨立或團隊力量完成專題研究計畫",
      "describe_en": "20.Be able to complete research or practical projects through independent or joint efforts."
    },
    {
      "seq": 3,
      "describe_ch": "12.能規劃、設計與執行交通運輸相關研究議題之流程與實作",
      "describe_en": "12.Be able to plan, design, and execute transportation related research topics."
    },
    {
      "seq": 4,
      "describe_ch": "21.簡報製作、語文撰寫、口頭報告以及提問研討之實力",
      "describe_en": "21.Possess the abilities of presentation documents preparation, essay writing, oral presentations, and comments making."
    },
    {
      "seq": 5,
      "describe_ch": "8.陸路運輸系統運作與企業之理論及實務的概念",
      "describe_en": "8. Comprehend operational theory and practice of ground transportation systems and companies."
    },
    {
      "seq": 6,
      "describe_ch": "5.認識國內、外交通運輸之相關先進科技與技術",
      "describe_en": "5. Understand worldwide transportation related advanced technologies."
    },
    {
      "seq": 7,
      "describe_ch": "13.能採電腦資訊科技或分析軟體以模擬或處理實務問題之現象",
      "describe_en": "13. Be able to apply computer systems and software packages to simulate or handle practical problems."
    }
  ],
