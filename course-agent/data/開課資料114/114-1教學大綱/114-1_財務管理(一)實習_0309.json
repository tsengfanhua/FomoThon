  "description": {
    "sub_id3": null,
    "sub_name": "財務管理(一)實習",
    "sub_ename": "FINANCIAL MANAGEMENT PRACTICE(1)",
    "describe_ch": "此為財務管理的入門課程，旨在熟悉財務資產評價、資本預算、及公司投資決策等重要課題，學期中需作研究報告，以期將財務理論與實務予以融會貫通。",
    "describe_eh": "This is an introductory course in the field of financial management.  It will provide students with the basic understanding of financial asset valuation, capital budgeting, and corporate investment decision.  Research projects will be assigned to students during the semester.  The purpose is to familiarize students with the theories and concepts learned from the class and apply them to the real financial world.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解財務資產評價",
      "describe_en": "Understand the financial asset valuation"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解資本預算",
      "describe_en": "Understand the capital budgeting"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解公司投資決策",
      "describe_en": "Understand the corporate investment decision"
    },
    {
      "seq": 4,
      "describe_ch": "以研究報告訓練學生具備獨立思考及分析財務金融問題之能力",
      "describe_en": "Use the research projects to train students with the ability of pondering and analyzing financial problems independently"
    }
  ],
