  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CC03130",
    "sub_id": "64514",
    "scr_dup": "001",
    "sub_title": "深度學習於圖像識別之理論與實作",
    "sub_title_en": null,
    "sub_describe": "本課程聚焦於圖像識別技術在深度學習中的理論基礎與實務應用。學生將學習卷積神經網路（CNN）等深度模型的原理與訓練方法，並進一步探討影像分類、物件偵測、語意分割、實例分割與姿態估計等核心電腦視覺任務。課程強調理論理解與實作能力並重，鼓勵學生透過專題開發與公開資料集練習，實際建立圖像識別系統，並分析其效能與限制，培養面對真實問題的解決能力。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "圖像識別",
    "sub_ename": "PATTERN RECOGNITION",
    "describe_ch": "本課程將介紹傳統的圖形識別( Pattern Recognition ) 技術，包括PCA、ICA、LDA、SVM等技術，使學生了解圖形識別的分類方法，經由對分類問題的分析，瞭解如何將輸入樣本依不同特性加以分類，並熟悉圖形識別系統。另外，介紹深度學習如何在圖形識別中嶄露頭角，課程將以Python為開發工具，搭配Tensorflow為開發平台，以期幫助學生在理論與實務應用上相輔相成，加強學生之學習興趣及效果。",
    "describe_eh": " In this course, we will study the traditional pattern recognition techniques including PCA, ICA, LDA, SVM and so on. Based on these techniques, students can understand classification methods of pattern recognition. Deep learning techniques for pattern recognition will be introduced and students can learn how deep learning performs quite well in this field. We will use Python and Tensorflow as the programming language and developing platform to teach students the ability of implementation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "明瞭影像處理之基本理論及演算法",
      "describe_en": "Understand the basic theories and algorithms of image processing"
    },
    {
      "seq": 2,
      "describe_ch": "應用各種轉換及影像濾波器於各種環境下之影像處理問題",
      "describe_en": "Applying various conversion and image filters to image processing problems in various environments"
    },
    {
      "seq": 3,
      "describe_ch": "能夠分析各種影像處理架構及其效能",
      "describe_en": "Able to analyze various image processing architectures and their performance"
    }
  ],
