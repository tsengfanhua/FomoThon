  "description": {
    "sub_id3": null,
    "sub_name": "專案管理學",
    "sub_ename": "PROJECT MANAGEMENT KNOWLEDGE",
    "describe_ch": "藉由系統化的知識傳授、試題測驗、口頭報告與互動討論的方式讓學生熟悉運用專案管理方法，來強化邏輯分析與問題解決能力、發揮規劃與監控的技巧，讓專案能夠如期、如質、如預算地有效完成。並輔導學生報考中華專案管理學會的專案助理(PMA)認證考試(教育部推薦之乙級證照)。",
    "describe_eh": "At first, to teach the knowledge of Project Management. And then, to apply Project Management in practice. Second part to help the students to get PMA Certificates with National Project Management Association (NPMA).",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備專案管理證照",
      "describe_en": "To get Project Management Certificates"
    },
