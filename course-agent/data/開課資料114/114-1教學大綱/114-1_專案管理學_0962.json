      "seq": 2,
      "describe_ch": "瞭解專案管理基本知識",
      "describe_en": "To know the basic knowledge of Project Management"
    },
    {
      "seq": 3,
      "describe_ch": "增進管理專案的責任感",
      "describe_en": "To create the responsibility in managing projects"
    }
