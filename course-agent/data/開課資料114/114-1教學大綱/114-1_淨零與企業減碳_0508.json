  "description": {
    "sub_id3": null,
    "sub_name": "淨零與企業減碳",
    "sub_ename": "NET ZERO AND CORPORATE CARBON REDUCTION",
    "describe_ch": "本課程探討全球淨零趨勢及其對企業的影響，以及企業在碳中和、節能減碳、再生能源和社區回饋等方面的應對策略。通過介紹企業案例，課程將引導學生思考企業如何運用跨界合作和創新方法以發展永續企業。",
    "describe_eh": "This course aims to explore the global net zero trend and its implications for businesses, as well as practical strategies for businesses in carbon offsetting, energy conservation and emission reduction, renewable energy and community engagement. Through the introduction of corporate case studies, the course will guide students in contemplating how businesses can utilize cross-sector collaboration and innovative approaches to develop sustainable enterprises.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生實際了解淨零趨勢的原因和影響",
      "describe_en": "The students gain a practical understanding of the reasons and impacts of the net zero trend."
    },
    {
      "seq": 2,
      "describe_ch": "學生掌握並應用企業在淨零趨勢中的發展策略",
      "describe_en": "Students will grasp and apply the development strategies of enterprises in the net zero trend."
    }
  ],
