  "description": {
    "sub_id3": null,
    "sub_name": "電力系統分析",
    "sub_ename": "POWER SYSTEM ANALYSIS",
    "describe_ch": "本課程的理論使學生達成理解有關於電力系統工程學，提高對於電力工業的學習興趣。本課程強調各種物理觀念的講述，並輔以數學技巧的說明。期使學生經由簡單理論基礎與相關模型建立，進而可擴展延伸至到新的且複雜的電力系統分析。",
    "describe_eh": "The objective of this course is to present methods of power system analysis and design, particularly with the aid of a personal computer, in sufficient depth to give the student the basic theory at the undergraduate level. The approach is designed to develop students' thinking process, enabling them to reach a sound understanding of a broad rang of topics related to power system engineering, while motivating their interest in the electrical power industry.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
