  "description": {
    "sub_id3": null,
    "sub_name": "普通物理(一)",
    "sub_ename": "GENERAL PHYSICS(1)",
    "describe_ch": "普通物理為奠定理工科系學生的基礎物理概念與知識，以利未來本系專業科目之修習。普通物理(一)的主題包含力學與熱力學。力學是規範物體運動的原則，熱力學則分別以微觀與巨觀探討氣體的物理特性。",
    "describe_eh": "General physics provides knowledge basis for all science and engineering students required for their advanced courses. General physics (1) includes the topics of mechanics and thermodynamics. Mechanics regulates fundamental principles of motion. Thermodynamics explains both of microscopic and macroscopic natures of gases and objects.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解並能應用基本運動定律。",
      "describe_en": "Understand and be able to apply the laws of motion."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解能量的意義並可應用於力學問題。",
      "describe_en": "Understand the concept of energy and be able to solve mechanical problems in terms of energy."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉基本之轉動、振動及波動相關物理。",
      "describe_en": "Be familiar with the basic physics of rotation, oscillation, and waves."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解並能應用基本熱力學定律。",
      "describe_en": "Understand and be able to apply the  laws of thermodynamics."
    }
  ],
