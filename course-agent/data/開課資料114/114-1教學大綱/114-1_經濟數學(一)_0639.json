  "description": {
    "sub_id3": null,
    "sub_name": "經濟數學(一)",
    "sub_ename": "MATHEMATICS FOR ECONOMICS (1)",
    "describe_ch": "經濟數學(一)是一門結合經濟學、線性代數與微積分的學科。其目的在於針對已具備基本經濟學概念與圖形分析能力的學生，提供以數學工具表達經濟學語言的另一種管道。內容包括：靜態分析、比較靜態分析，涵蓋商品及要素市場模型、消費者與廠商最適化模型、國民所得決定模型、IS-LM模型；採用的數學工具有：集合、矩陣、導式、微分與積分。此課程將著重於利用數學工具陳述與求解經濟問題。",
    "describe_eh": "Mathematics for Economics (1) is a course involving economics, linear algebra, and calculus. The purpose of this course is to provide a mathematical approach to explain economics for those students who understand the basic economic concept and graphical analysis skill for economics. The contents of this course include static analysis and comparative-static analysis, markets such as goods and factor market models, optimization models for consumers and firms, national income determination model, and IS-LM model. The mathematical tools, for example, set, matrix, derivative, differential and integral, will be introduced. In this course, how to express the economic concepts through mathematics and how to solve the economic problems would be emphasized.",
    "pre_subname": "CEM1006微積分",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知道數學式所代表的經濟名詞意義，並描述其間的關係。",
      "describe_en": "Understand the meanings of economic terminologies in terms of mathematics, and can describe the relationships between them."
    },
    {
      "seq": 2,
      "describe_ch": "能理解數學模型的經濟意涵、基本假設與建構原理。",
      "describe_en": "Comprehend the economic meanings, basic assumptions and theoretical framework of mathematical models."
    },
    {
      "seq": 3,
      "describe_ch": "能應用經濟數理模型求解經濟問題，並分析其意義。",
      "describe_en": "Apply mathematical models to solve economic problems, and analyze the economic implications."
    }
  ],
