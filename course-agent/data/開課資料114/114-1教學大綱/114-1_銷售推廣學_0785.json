    "cls_id": "CB26139",
    "sub_id": "68452",
    "scr_dup": "001",
    "sub_title": "企業如何進行銷售推廣工作",
    "sub_title_en": null,
    "sub_describe": "銷售推廣的成果，是企業能否成長茁壯的關鍵，更是行銷人必須具備專業能力。本課程旨在建立學子銷售推廣的智能，使其能成為未來的行銷專才。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "銷售推廣學",
    "sub_ename": "SALES AND PROMOTION",
    "describe_ch": "課程主要目標，在於學習銷售推廣工作的操作方式，讓學生理解銷售推廣的任務、策略、創意、管理等面向，並透過案例研究、小組討論等，培養企業需要的專業能力。",
    "describe_eh": " The main objective of the course is to learn how to operate the sales promotion work, to enable students to understand the tasks, strategies, ideas, management and other orientation of sales promotion, and to develop the professional skills required by the enterprise through case studies, group discussions, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
