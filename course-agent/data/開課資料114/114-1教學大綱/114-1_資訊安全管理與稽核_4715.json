  "description": {
    "sub_id3": null,
    "sub_name": "資訊安全管理與稽核",
    "sub_ename": "INFORMATION SECURITY MANAGEMENT AND COMPLIANCE AUDIT",
    "describe_ch": "本課程旨在培養學生具備資訊安全管理與稽核的專業知識與實務能力。課程內容涵蓋資訊安全管理系統（ISMS）的架構、國際標準（如ISO/IEC 27001、ISO 19011）要求、資安政策制定、風險評鑑、控制措施設計與實施。學生將學習如何規劃、執行與報告資訊安全稽核，並了解內部稽核、供應商稽核及第三方認證的流程與重點。課程強調理論與實務並重，透過案例分析、模擬演練與角色扮演，提升學生解決資安問題與稽核實作的能力。完成本課程後，學生將能獨立參與資訊安全管理系統的建置、維運及稽核工作，並具備因應組織資訊安全挑戰與持續改善的專業素養。",
    "describe_eh": "This course provides students with essential knowledge and practical skills in information security management and auditing. Covering ISMS structure, key international standards (ISO/IEC 27001, ISO 19011), policy development, risk assessment, and security controls, the course teaches students to plan, conduct, and report information security audits. Through case studies and simulations, students gain hands-on experience in internal, supplier, and third-party audits. Graduates will be prepared to independently manage and audit information security systems and address organizational security challenges.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解資訊安全管理系統（ISMS）的目的、組織效益，以及國際標準(如ISO/IEC 27001、ISO 19011、ISO 17021)對管理系統與稽核的要求",
      "describe_en": "Understand the purpose and organizational benefits of Information Security Management Systems (ISMS), as well as the requirements that international standards-such as ISO/IEC 27001, ISO 19011, and ISO 17021-place on management systems and auditing processes."
    },
    {
      "seq": 2,
      "describe_ch": "掌握資訊安全管理系統的建置、運作、監督、檢視及持續改善流程",
      "describe_en": "Master the processes of establishing, operating, monitoring, reviewing, and continuously improving an Information Security Management System (ISMS)."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉資訊安全管理系統內部稽核、供應商稽核及第三方認證的實務操作",
      "describe_en": "Be familiar with the practical operations of internal audits, supplier audits, and third-party certifications within an Information Security Management System (ISMS)."
    },
    {
      "seq": 4,
      "describe_ch": "具備規劃、執行、報告、追蹤與完成稽核的能力，理解稽核員角色與應具備的專業素養",
      "describe_en": "Possess the ability to plan, execute, report, follow up, and complete audits, as well as understand the role of an auditor and the professional qualities required."
    }
  ],
