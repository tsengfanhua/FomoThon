  "description": {
    "sub_id3": null,
    "sub_name": "材料力學(一)",
    "sub_ename": "MECHANICS OF MATERIALS(1)",
    "describe_ch": "材料力學(一)介紹結構物承受不同外力作用下之內力、形變及載重承載力等力學行為，課程目標為培養學生解決材料與結構力學問題的基本能力。主要內容包括應力、應變、材料力學性質、軸力桿件、扭力桿件、梁之應力分析、應力轉換及柱之挫屈等。",
    "describe_eh": "Material mechanics (1) introduces the mechanical behaviors such as internal\nforces,deformations, and loading capacity of structures subjected to various external\nforces.The objective of the course is to develop students?? basic ability to solve\nmechanical\nproblems of materials and structures. The main contents include stress, strain,\nmechanical properties of materials, members under axial loading, torsion members,\nstress analysis of beams, transformations of stress, and buckling of columns.",
    "pre_subname": "MATH1005微積分(一)、CE1001應用力學、PHYS1005普通物理(一)、CE2073工程數學(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、CE1001 APPLIED MECHANICS、PHYS1005 GENERAL PHYSICS(1)、CE2073 ENGINEERING MATHEMATICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解材料的力學性質",
      "describe_en": "To understand the mechanical behavior of materials."
    },
    {
      "seq": 2,
      "describe_ch": "應用材料力學知識分析結構構件在不同外力作用下的應力、應變、變形及載重承載力。並能瞭解材料力學在土木工程之應用。",
      "describe_en": "To apply Mechanics of Materials knowledge in analyzing the stresses, strains, deformations and loading capacity of structural members subjected to various loading."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解材料力學在土木工程之應用與重要性。",
      "describe_en": "To understand the application and importance of Mechanics of Materials in civil engineering."
    },
    {
      "seq": 4,
      "describe_ch": "學會有效溝通與團隊合作的相關能力。",
      "describe_en": "To learn about effective communication and teamwork."
    }
  ],
