  "description": {
    "sub_id3": null,
    "sub_name": "運輸物流與生活科技",
    "sub_ename": "APPLICATIONS OF TRANSPORTATION AND LOGISTICS FOR LIFE ACTIVITY AND TECHNOLOGY",
    "describe_ch": "由於運輸與物流與民眾生活息息相關,為能夠讓同學及早了解專業領域與生活議題的關聯性以及未來就業市場的需求供給，特開設此課程。課程為介紹運輸與物流領域與民眾生活議題的相關性並從專業角度探討各頂生活機能及其相關科技應用。學生必須在課程中選取適當的生活議題，並利用運輸專業詞語進行批判與討論。本課程內容與聯合國提倡的SDG目標相關。",
    "describe_eh": "Since transportation and logistics are closely related to people's lives, this course is designed to enable students to understand the relevance of transportation and life issues, as well as the demand and supply of the future job market. This course introduces the relevance of the transportation and logistics to people's daily life issues, and discusses various life functions and related technological applications from a professional perspective.  Students must select an appropriate life issue in the course, and use professional terms for criticism and discussion.  The content of this course is related to SDG Goal 11 advocated by the UN.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "教授相關先進科技與技術於運輸或物流領域之應用潛力與案例",
      "describe_en": "Teach the application potential and cases of advanced technology and technology in transportation or logistics field."
    },
    {
      "seq": 2,
      "describe_ch": "教授各運輸或物流系統之營運、企業經營管理之理論及實務概念",
      "describe_en": "To teach the theory and practical concepts of transportation and logistics system operation and business management."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生簡報製作、報告撰寫、口頭報告以及提問研討之能力。",
      "describe_en": "To develop  students' ability of presentation making, report writing, oral presentation and question discussion."
    }
  ],
