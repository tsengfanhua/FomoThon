  "description": {
    "sub_id3": null,
    "sub_name": "財務管理",
    "sub_ename": "FINANCIAL MANAGEMENT",
    "describe_ch": "介紹學生從會計學和財務管理的基本分析技巧開始，進而探討如何運用各種決策分析技術做好營運資金管理、資本預算、長期融資和其他相關主題的公司理財決策。",
    "describe_eh": "The goals of this course are to develop students' basic analytical skills in accounting and financial management and then utilize decision-making techniques in the capital management, and capital budgeting, long-term financing ,etc.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解財務資產評價及資本預算",
      "describe_en": "Understand the financial asset valuation and the capital budgeting"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解公司投資決策",
      "describe_en": "Understand the corporate investment decision"
    }
