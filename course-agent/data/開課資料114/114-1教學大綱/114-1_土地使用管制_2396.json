  "description": {
    "sub_id3": null,
    "sub_name": "土地使用管制",
    "sub_ename": "LAND USE CONTROL",
    "describe_ch": "本課程涵蓋土地使用管制的基本概念；土地使用規劃的理論基礎；發展管制；管制體系；土地使用分區管制及經濟分析；開發許可制；土地使用管制與財產權；規劃、管制與地價。",
    "describe_eh": "This course will cover the following major components: Definition of land use control; The concept of land use planning theory; The Control of Development; Land Use Control System; The Economic Theory of Zoning; Zoning System; Planning Permission; Land Use Control and Property Right; Planning, Land and Land Values.　",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得土地使用管制之基本知識",
      "describe_en": "Obtain the basic knowledge of land use controls"
    },
    {
      "seq": 2,
      "describe_ch": "具備查閱土地使用管制之能力",
      "describe_en": "To have the ability of searching land use controls"
    },
    {
      "seq": 3,
      "describe_ch": "將理論運用於土地管理實務",
      "describe_en": "Application of land management theory"
    }
  ],
