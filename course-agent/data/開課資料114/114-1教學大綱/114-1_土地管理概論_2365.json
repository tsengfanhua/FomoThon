  "description": {
    "sub_id3": null,
    "sub_name": "土地管理概論",
    "sub_ename": "INTRODUCTION TO LAND MANAGEMENT",
    "describe_ch": "使學生初步瞭解土地管理的專長領域方向，如土地經濟、土地開發、不動產估價、土地稅法、遊憩資源、及上述開發及管理所需的一些技術或工具（如地理資訊系統、測量學、統計學），以作為未來的課程選修規劃的參考，確立學生個人的主修及第二專長的基礎。",
    "describe_eh": "To get student to understand the direction of land management, i.e. Land Economics, Land development, Land assessment, Law of Land and tax, recreation resources, and the technical still or tools (i.e. GIS, Surveying, Statistics), in order for future courses-chosen basis, make themselves to have major and minor career.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "協助學生瞭解土地管理的基本觀念",
      "describe_en": "To assist students in understanding basic concept of Land Management."
    },
    {
      "seq": 2,
      "describe_ch": "協助學生從事生涯規劃、培養社會責任",
      "describe_en": "To assist students in career planning for future and Social responsibilities"
    },
    {
      "seq": 3,
      "describe_ch": "協助學生瞭解土地管理相關可使用的書圖內容",
      "describe_en": "To assist students understand the pictures about Land Management"
    }
  ],
