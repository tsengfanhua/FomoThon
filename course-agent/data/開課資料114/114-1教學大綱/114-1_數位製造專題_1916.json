  "description": {
    "sub_id3": null,
    "sub_name": "數位製造專題",
    "sub_ename": "SPECIAL TOPICS ON DIGITAL MANUFACTURING",
    "describe_ch": "本課程運用電腦輔助設計原理，並依據CDIO（構思Conceive、設計Design、實現Implement、運作Operate)流程，進行創意產品之構思與設計、實體建模、3D列印製程等等，推動數位化製造專題。\r\n",
    "describe_eh": "This course uses computer-aided design principles, based on CDIO (Conceive, Design, Implement, Operate) process to achieve the idea of creative products and design, solid modeling, 3D printing process, etc., to promote digital manufacturing topics.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
