  "description": {
    "sub_id3": null,
    "sub_name": "會計專題",
    "sub_ename": "SPECIAL TOPICS IN ACCOUNTING",
    "describe_ch": "將學生分組對不同專題做深入廣泛的研討。冀望此專題的學習讓學生應用所學的會計理論、審計及稅務知識來解決企業問題。預期學生對會計相關議題有?廣的見解及想法。而團隊的討論與分工合作可培養學生溝通的能力。",
    "describe_eh": "In this course students will be divided into groups to present and discuss various topics with breadth or depth. Students are expected to integrate what they have learned in accounting theory, auditing, and taxes knowledge to solve business problems. They also are expected to broaden their perspective and open their mind in doing related accounting issues. Emphasis is placed upon teamwork, written and oral communication in their presentations and discussions.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能蒐集與研究問題相關的資料",
      "describe_en": "Be able to collect data which is related to the research problem"
    },
    {
      "seq": 2,
      "describe_ch": "綜合組員討論並向同學及老師報告結果",
      "describe_en": "Synthesize the discussion between team members and report the results to classmates and instructor."
    },
    {
      "seq": 3,
      "describe_ch": "了解專題涉及之專業倫理",
      "describe_en": "Understand project related professional ethics."
    },
    {
      "seq": 4,
      "describe_ch": "能分析資料並適切歸納出結論",
      "describe_en": "Be able to analyze data and draw appropriate conclusions"
    },
    {
      "seq": 5,
      "describe_ch": "了解研究問題的世界脈動",
      "describe_en": "Understand the global nature of research problem"
    }
  ],
