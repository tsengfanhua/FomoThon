  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CM03139",
    "sub_id": "06331",
    "scr_dup": "001",
    "sub_title": "本課程的目的為讓學生演練如何運用信託法理，製作不動產信託契約及進行不動產信託登記，以達到信託契約之目的。",
    "sub_title_en": null,
    "sub_describe": "本課程的目的為介紹信託法制之基本原理，並解析現行不動產信託應用於都市更新、危老重建、以房養老、遺囑信託、履約保證、預售屋買賣與包租代管，修習課程後能應用不動產信託法制於符合社會需求之不動產信託產品。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "不動產信託實習",
    "sub_ename": "REAL ESTATE TRUST PRACTICE",
    "describe_ch": "本課程的目的為讓學生演練如何運用信託法理，製作不動產信託契約及進行不動產信託登記，以達到信託契約之目的。",
    "describe_eh": "The purpose of this course is to allow students to practice how to apply trust law to prepare real estate trust deeds and register real estate trusts in order to achieve the purpose of the trust deed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解與適用土地信託專業與實務之能力。",
      "describe_en": "Ability to understand and apply land trust expertise and practices"
    },
    {
      "seq": 2,
      "describe_ch": "應用信託法理、處理與分析之能力。",
      "describe_en": "Ability to apply trust legal theory, processing and analysis."
    },
    {
      "seq": 3,
      "describe_ch": "培養積極創新、邏輯思考、團隊合作之能力並具備社會責任。",
      "describe_en": "Cultivate the ability of active innovation, logical thinking, teamwork and social responsibility."
    }
  ],
