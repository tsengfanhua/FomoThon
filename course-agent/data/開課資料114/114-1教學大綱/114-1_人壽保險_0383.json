  "description": {
    "sub_id3": null,
    "sub_name": "人壽保險",
    "sub_ename": "LIFE INSURANCE",
    "describe_ch": "人壽保險是本系一門專業課程，它涉及到法律、會計、經濟、行銷、財務、企管、精算與行為科學等課程之應用。它具有影響深遠之社會與經濟意義，透過其組織以制度化方式為個人、家庭、企業提供財務上安全保障。亦為企業提供經濟上服務，即發揮企業資金來源重要管道之功能。",
    "describe_eh": "Life insurance is a professional course. It involves law, accounting, economics, marketing, finance, business administration, actuarial science and organizational behavior. It has compound meaning for society and economics. Via issurance companies, the life insurnce product provides protection for an individual, family and corporation. It also provides the economic value to certain corporations, i.e., one important channel for funding.",
    "pre_subname": "INSU1001保險學、INSU1002風險管理",
    "pre_sub_id3": "INSU1001",
    "pre_sub_ename": "INSU1001 INSURANCE、INSU1002 RISK MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能獲悉各種人壽保險商品的差異",
      "describe_en": "To know the differences of various insurance products."
    },
    {
      "seq": 2,
      "describe_ch": "能理解家庭與個人面對的人身風險",
      "describe_en": "Comprehension for the personal risks facing families and individuals"
    },
    {
      "seq": 3,
      "describe_ch": "能應用人壽保險商品在人身風險管理中",
      "describe_en": "To apply life insurance products in personal risk management"
    }
  ],
