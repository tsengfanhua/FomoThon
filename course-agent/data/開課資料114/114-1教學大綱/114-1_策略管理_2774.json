  "description": {
    "sub_id3": null,
    "sub_name": "策略管理",
    "sub_ename": "STRATEGY MANAGEMENT",
    "describe_ch": "培養學生企業策略分析、規劃、執行與控管的基本認知。課程議題包括：策略管理基本概念、競爭優勢的本質，事業和公司策略及策略執行；透過本土與國外實際企業個案教學的研討，亦可增進學生的策略邏輯與分析技巧。",
    "describe_eh": "The purpose of this course is designed for students to generate the fundamental knowledge of the analyzing, planning, executing and controlling of business strategies. Main topics include the basic concepts of strategic management, the nature of competitive advantage, business and corporate-level strategies, and implementing strategy. By applying case teaching methods, students can improve strategic logic and analytical skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解策略的本質並進行產業分析與策略發展　\t",
      "describe_en": "Understand the nature of strategy and execute the industry analysis and strategy development　"
    },
    {
      "seq": 2,
      "describe_ch": "藉由企業個案研討，增進學生的策略邏輯與分析技巧。\t",
      "describe_en": "By business case discussion, students can improve strategic logic and analytical skills."
    }
