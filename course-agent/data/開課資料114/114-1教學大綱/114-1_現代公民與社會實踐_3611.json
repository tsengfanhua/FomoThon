  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "XF07110",
    "sub_id": "06857",
    "scr_dup": "030",
    "tpa_score_new": " ",
    "tpa_score_new_en": null,
    "course_pol": "本堂課的教學設計是透過講授、提問、影片、分組討論及口頭報告等方式，協助學生對於社會、國家發展、國際事務等有敏銳意識及視野 .  在課堂上重視同學間與老師的互動, 團隊小組的討論與發表，並鼓勵同學就上課所介紹之案例內容進行評論，所以同學上課要積極的參與",
    "course_pol_en": null,
    "course_rem": "準時上課",
    "course_rem_en": null,
    "ais_meno": "<div>上課同學請務必要確實出席</div>\n\n<div>師長上課時 請務必要專心的聆聽並作筆記</div>\n\n<div>上課分組討論時 請同學務必要積極的參與討論並尊重其他同學的意見發表</div>\n\n<div>繳交學期報告 請同學務必不要抄襲他人作品或著作 尊重智慧財產權</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": null
  },
