  "description": {
    "sub_id3": null,
    "sub_name": "固體廢棄物",
    "sub_ename": "SOLID WASTE MANAGEMENT",
    "describe_ch": "本課程主要介紹固體廢棄物之處理、管理與再利用技術，課程內容包括廢棄物清除處理與管理體系之介紹、法令沿革與發展趨勢，一般廢棄物數量與特性、前處理技術、焚化處理技術、堆肥處理技術、以及衛生掩埋處置技術等。",
    "describe_eh": "This course introduces the management, treatment and recycling of solid waste. The topics include solid waste management system, legislation and development trend, municipal solid waste characteristics and quantities, preprocessing technology, incineration technology, composting technology, and sanitary landfill technology.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解廢棄物管理體系與零廢棄政策之目標與策略。　\t",
      "describe_en": "To understand the hierarchy of solid waste management and strategy of zero waste policy.　\t"
    },
    {
      "seq": 2,
      "describe_ch": "理解都市垃圾相關處理技術之應用知識與未來發展趨勢。\t",
      "describe_en": "To understand the relevant technologies of municipal solid waste treatment and the development trends. 　\t"
    }
  ],
