  "description": {
    "sub_id3": null,
    "sub_name": "國際標準認證與組織因應實務",
    "sub_ename": "INTERNATIONAL CERTIFICATION STANDARDS AND ORGANIZATIONAL IMPLEMENTATIONS",
    "describe_ch": "此課程帶引學生理解國際標準認證在企業的國際化，與如何使企業及貿易運作更具效率，以及降低國際間商品交易的障礙等商業與社會面向的效益。並以國際標準認證為基礎，引導學生進行案例分析及評估，使其具備規劃企業永續營運與發展策略，以應對全球化的永續浪潮。",
    "describe_eh": "This course aims to help students understand how the International certification standards make business operations more efficient, reduce barriers to international trade, and finally bring benefits to businesses and society. The course is based on international standards, to guide students to analyze and evaluate case studies, and to plan  possible implementing strategies for enterprises which are responsive to the global sustainability demanding.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解與應用永續的國際標準認證理論與實務。",
      "describe_en": "To understand the international certification standards about sustainability."
    },
    {
      "seq": 2,
      "describe_ch": "可以經由學習國際標準組織的準則獲得由國際組織所頒發之永續相關證照。",
      "describe_en": "To got international certification about sustainability from learning the standards issued by international organizations."
    }
  ],
