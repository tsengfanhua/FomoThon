  "description": {
    "sub_id3": null,
    "sub_name": "空間資訊應用分析方法",
    "sub_ename": "ANALYSIS METHODS FOR SPATIAL INFORMATION APPLICATIONS",
    "describe_ch": "以跨領域與資訊整合的教學方式，讓學生學習分析環境及生態變數之空間分佈特性、空間異質性、空間尺度及空間不確定性的方法，並培養學生對GIS領域之實務分析及理論研究之相關能力。",
    "describe_eh": "Use interdisciplinary and information integration method to help students learn how to analyze the characteristics of spatial distribution, spatial heterogeneity, spatial scale and spatial uncertainty of environmental and ecological variables. Students can also learn practical analysis and theory research in the GIS field.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
