  "description": {
    "sub_id3": null,
    "sub_name": "針織工程實習",
    "sub_ename": "KNITTING TECHNOLOGY PRACTICE",
    "describe_ch": "介紹針織物之成型原理及織造工程中各運動之動作原理。使學習者擁有織品製造之理論基礎，並啟發學習者研究與開發的實作能力。\n",
    "describe_eh": "To introduce principles of knitting fabrics formation and the motion of the process. To help the student to build up the foundation of theory and practical training, and to enlighten the study on the topic.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "探討與瞭解針織物工程各式機器的\r\n操作原理\r\n",
      "describe_en": "To understand the operation principles of knitting machines processes."
    },
    {
      "seq": 2,
      "describe_ch": "探討與瞭解各種針織物製品的實作\r\n原理\r\n",
      "describe_en": "To study functions and principles of knitted fabrics in the practical training."
    },
    {
      "seq": 3,
      "describe_ch": "探討與培養針織物的研究及開發實\r\n作能力\r\n",
      "describe_en": "To train up the abilities about the research and development of knitted fabrics."
    }
  ],
