  "description": {
    "sub_id3": null,
    "sub_name": "廢棄物處理與土壤污染實驗",
    "sub_ename": "EXPERIMENT OF WASTE TREATMENT AND SOIL POLLUTION",
    "describe_ch": "本課程提供學生有關廢棄物與土壤分析之實際操作與環境應用。主要實驗內容包括：廢棄物採樣技術(四分法)、單位容積重、近似分析、元素分析、熱量分析、灼燒減量、毒性溶出試驗及重金屬含量分析，廢棄物資材化與能源化，以及土壤採樣與分析等相關實驗。",
    "describe_eh": "This course provides students with practical operations and environmental applications related to waste and soil analysis. The main contents of the experiment include: waste sampling technology (quarter method), bulk density, approximate analysis, element analysis, thermal analysis, ignition loss, toxicity charateristic leaaching procedure, heavy metal content analysis, waste to materials and energy, and soil sampling and analysis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解實驗過程品質保證與品質管制之技巧與方法。　\t",
      "describe_en": "To explain the approaches and skills of assuring quality assurance and quality control in experimental procedure.　"
    },
    {
      "seq": 2,
      "describe_ch": "訓練各項廢棄物與土壤分析之技巧，以掌握各項分析數據之準確性與再現性。　\t",
      "describe_en": "Be able to train students experience waste and soil characteristics analysis and have the abilities on accuracy and repeatability of analysis work.　."
    }
  ],
