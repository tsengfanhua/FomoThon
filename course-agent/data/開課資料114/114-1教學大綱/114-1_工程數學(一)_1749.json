  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(一)",
    "sub_ename": "ENGINEERING MATHEMATICS(1)",
    "describe_ch": "初等微積分後，有關計算上的數學需求及從事理論所需要的計算技巧。主要教材含解微分方程式、Laplace變換、Fourier級數、Fourier積分及Fourier變換。",
    "describe_eh": "This course is to make available much of the post-calculus mathematics need and is to engage theory with computional facility. The main topics include ordinary differential equations, Laplace transforms, Fourier series, The Fourier integral and Transforms.",
    "pre_subname": "CEM1006微積分",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1. 能用自己的辭彙定義工程數學，描述重要的數學模型種類及其應用限制。",
      "describe_en": "1. Define engineering mathematics with their own words: be able to depict many important types of mathematic models and to understand its limitations of application."
    },
    {
      "seq": 2,
      "describe_ch": "能使用相關軟體，完成一工程數學議題，並從中歸納出適當結論。",
      "describe_en": "Complete an engineering mathematics issue by using the related software and be able to generalize a conclusion from it."
    },
    {
      "seq": 3,
      "describe_ch": "3. 能針對一特定工程數學的議題或情境，定義問題、提出數學模型、求解，並適切歸納出容易了解的結論。",
      "describe_en": "3. Target a specific issue or a situation relating to engineering mathematics and then define the issue, submit the mathematic model, get the solution, and finally generalize a proper conclusion."
    },
    {
      "seq": 4,
      "describe_ch": "4. 能以書面或口頭方式將所獲結果與同儕、助教及教師溝通。",
      "describe_en": "4. Communicate results in written or oral form to classmates, teaching assistants, and the instructor."
    }
  ],
