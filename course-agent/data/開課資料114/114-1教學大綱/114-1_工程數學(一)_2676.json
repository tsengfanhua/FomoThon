  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(一)",
    "sub_ename": "ENGINEERING MATHEMATICS(1)",
    "describe_ch": "工程數學(一)的主要內容即在介紹向量分析、線性代數與常微分方程式(ODE)的基本知識及相關解題方法。",
    "describe_eh": "The major subjects of Engineering Mathematics(一) include the vector analysis, linear algebra, fundamental knowledge of ordinary differential equations and the related problem-solving skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解微分運算和向量運算(divergence、curl、方向導函數)與曲線、曲面、體積之數學描述的關連。",
      "describe_en": "To comprehend the basics and applications of vector operations (such as scalar product, cross product, divergence, curl, directional derivative) and their connections to the descriptions of curves, surfaces and volumes in space."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解線性聯立方程式與矩陣之關係；且瞭解矩陣的「基本列操作運算」、反矩陣計算、本徵值方程式。",
      "describe_en": "To comprehend the relationships between the system of linear equations and the matrix; to comprehend with the elementary row operations of the matrix, the inverse matrix, and the problem of eigenvalue equation."
    },
    {
      "seq": 3,
      "describe_ch": "依據物理或工程相關問題寫出微分方程式並了解各種求解技巧。",
      "describe_en": "To derive the ODE from the given Physics or Engineering problems and to understand their corresponding solving skills.　"
    }
  ],
