  "description": {
    "sub_id3": null,
    "sub_name": "熱力學",
    "sub_ename": "THERMODYNAMICS",
    "describe_ch": "熱力學主要在講解熱和功以及與熱和功相關物質性質的科學，包括動力的產生、冷凍，及相關物質之性質間的關係。內容包括功和熱、熱力學第一定律、熱力學第二定律、及熵。",
    "describe_eh": "The objective is to make students soundly understand the science of heat and work and the properties of substances related to heat and work. Contents include  work and heat、 the first law of thermodynamics、the second law of thermodynamics、 and  entropy.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解純物質之性質，且能夠描述熱力性質表之應用",
      "describe_en": "Understand the properties of pure substances and be able to describe the application of thermodynamic property table."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解功和熱的定義，且能夠描述功和熱的運算\r\n",
      "describe_en": "Understand the definition of work and heat and be able to describe how to calculate the change of work and heat."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解熱力學第一定律，且能夠描述第一定律之應用。",
      "describe_en": "Understand the first law of thermodynamics and be able to describe its application."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解熱力學第二定律，且能夠描述何謂熵。",
      "describe_en": "Understand the second law of thermodynamics  and be able to describe what is entropy."
    }
  ],
