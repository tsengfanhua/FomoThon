  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(一)",
    "sub_ename": "SEMINAR(1)",
    "describe_ch": "本課程藉由邀請國內外電機與通訊工程相關領域的學者專家蒞臨演講，讓學生了解的大電機領域的現況與趨勢，並熟悉學術倫理和智慧財產權相關的法規、知識與個案實例。希望藉由學術演講的聆聽與討論，啟發學生關注前瞻性與國際性科技的發展與脈動，並培養學生聽講、討論、發問與撰寫書面心得報告的能力。",
    "describe_eh": "By inviting scholars and experts from various areas of electrical and communications engineering to delivery their domain knowledge to students , their course allows students to understand the current status and future friends towards existing and newly established research areas , and families students with academic ethics and intellectual property rights issues and legislation . also , through listening and discussion in the seminars , it will inspires students' attention to the visionary and global developments in technologies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解電機與通訊工程相關研究領域的發展現況與趨勢。",
      "describe_en": "understand current status and future trends of electrical and communications   engineering related research areas."
    },
    {
      "seq": 2,
      "describe_ch": "理解學術倫理和智慧財產權相關的法規、知識，並舉出適當的個案實例。",
      "describe_en": "understand academic ethics and intellectual property related issues and legislation，and then propose suitable examples"
    },
    {
      "seq": 3,
      "describe_ch": "理解前瞻性與國際性科技的發展與脈動。",
      "describe_en": "Be able to pay attention to visionary and global developments of technologies."
    },
    {
      "seq": 4,
      "describe_ch": "培養學生綜合聽講、討論、發問與寫作書面心得報告的能力。",
      "describe_en": "Strengthen students, listening, discussion, questioning, concluding, and writing capability."
    }
  ],
