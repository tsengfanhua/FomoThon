  "description": {
    "sub_id3": null,
    "sub_name": "體育－舞動有氧",
    "sub_ename": "Body Gym: Aerobic Dance Moves",
    "describe_ch": "結合了所有舞蹈性的動作，從簡易的舞步開始入門，清楚詳細的分解，由淺入深，循序漸進，讓你在音樂中舞動肢體。藉由練習搭配有氧流行音樂跟著擺動肢體，學習街舞、爵士、Funky、拉丁 等基礎的舞步與律動。透過仔細的分解，讓大家除了學習舞蹈，增加自信與成就感之餘，也可以達到在旋律中釋放壓力、放鬆心情、雕塑身形曲線、獲得活力和心靈上正面的能量。",
    "describe_eh": "The course combines all dance moves and leads students to start from simple steps with music. It introduces Hip-Pop, Jazz, Funky, Latin and other dances. Through detailed instructions, students can learn dance, gain confidence, relieve stress, body sculpting and obtain spiritual vitality and positive energy.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "擺脫一般有氧運動的固定動作，用生動活潑的教學內容以扭腰、擺臀、抖肩、屈膝等動作，達到增進心肺功能、訓練肌力、增強柔軟度、燃燒體脂肪、美化曲線的有氧運動。",
      "describe_en": "Instead of fixed action, to use lively teaching content such as swing hips, shake shoulders, knees to improve heart and lung function, strengthen muscle, enhance flexibility, burn body fat and beautify the curve"
    },
    {
      "seq": 2,
      "describe_ch": "建立正確的運動方法，養成規律的運動習慣，紓解壓力、協調自律神經、整合身心靈、力求健康體適能。",
      "describe_en": "To establish the proper exercise methods, develop the habit of regular exercise, relieve stress, coordinate autonomic nervous system, integrate body, mind, and strive to physical fitness"
    }
  ],
