  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE08149",
    "sub_id": "30570",
    "scr_dup": "001",
    "sub_title": "界面活性劑化學",
    "sub_title_en": null,
    "sub_describe": "本課程主要以教師自編之《界面活性劑化學》教材為核心，內容針對表面張力、界面活性劑、潤濕性、接觸角、吸附現象與膠體系統等界面現象進行深入探討，並輔以適當之中英文參考書目，提供學生多元知識來源與跨領域視野。課程進行方式以 PowerPoint 簡報講授為主，結合理論講解與圖像輔助，協助學生掌握抽象概念之內涵與應用邏輯。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "界面活性劑化學",
    "sub_ename": "CHEMISTRY OF SURFACE ACTIVE AGENTS",
    "describe_ch": "介紹界面活性劑的化學結構與相關的界面之物理與化學現象，例如表面張力、微胞構成、乳化機構、起泡與消泡作用和清潔作用等以及這些界面活性劑的工業應用。",
    "describe_eh": "Introduction on the relations between the physical phenomena and chemical structure of surface active agents. Discussion covers topics in surface tension, micell formation, emulsion mechanism, foaming and defoaming and cleansing for general and industrial applications of surface active agents.",
    "pre_subname": "PHYS1007普通物理(一)、ENGS1012普通化學(一)",
    "pre_sub_id3": "PHYS1007",
    "pre_sub_ename": "PHYS1007 GENERAL PHYSICS(1)、ENGS1012 GENERAL CHEMISTRY(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解界面活性劑化學",
      "describe_en": "To understand the chemistry of surfactants"
    },
    {
      "seq": 2,
      "describe_ch": "終身學習、融會貫通",
      "describe_en": " Lifelong study for consolidation"
    }
  ],
