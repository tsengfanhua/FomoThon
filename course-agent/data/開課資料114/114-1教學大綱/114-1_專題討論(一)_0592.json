  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(一)",
    "sub_ename": "SEMINAR(1)",
    "describe_ch": "本課程目的在於幫助學生了解統計及精算的最新研究及應用。本課程將會邀請教授、學者和企業界的菁英人士來做專題演講。演講的內容包含統計推論的原理、近來最新的統計方法、統計的應用、財務數學和精算等相關學科。在課堂上學生應積極參與討論。\r\n\r\n",
    "describe_eh": "The aim of this course is to help student to understand the modern research and application in Statistics and Actuarial Science. This course will invite talks by masters, scholars and industry experts. Topics include principles of statistical inference, new statistical method, statistical applications, financial mathematics and actuarial science.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解統計及精算領域的最新研究資訊",
      "describe_en": "Comprehension for the information about modern researches in statistics, actuarial science and finance disciplines"
    },
    {
      "seq": 2,
      "describe_ch": "知道如何使用有關統計、精算與財務之資料庫",
      "describe_en": "To know how to use statistics-related, actuarial and finance-related database"
    },
    {
      "seq": 3,
      "describe_ch": "應用所學之統計及精算理論方法至實務資料",
      "describe_en": "To apply the statistical and actuarial methodologies of learning for real data"
    },
    {
      "seq": 4,
      "describe_ch": "分析數據報表並執行解釋與決策",
      "describe_en": "To analyze numerical outputs and make explanation and decision"
    }
  ],
