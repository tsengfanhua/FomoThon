  "description": {
    "sub_id3": null,
    "sub_name": "電磁學(一)",
    "sub_ename": "ELECTROMAGNETICS(1)",
    "describe_ch": "本課程為電磁領域的入門課程，尤其強調靜電場及穩定電流場的基本觀念及應用。主要內容包含向量分析、電場強度、靜電位、電通量密度、介電質材料、影像法、邊界值問題及穩定電流場。",
    "describe_eh": "This course is an introductory subject on electromagnetics , emphasizing fundamental concepts and applications of static electric fields and steady electric currents . Topics covered include : vector analysis , electric field intensity , electric potential , electric flux density , dielectric materials , method of image , boundary value problems , steady electric currents.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、IEE1010普通物理-電、磁、光",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、IEE1010 GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
