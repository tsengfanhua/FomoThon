  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE01139",
    "sub_id": "80610",
    "scr_dup": "001",
    "sub_title": "實務上，工程與勞務之預算書要如何編列。",
    "sub_title_en": null,
    "sub_describe": "1.參據政府採購法，說明何謂工程採購。\n2.參據政府採購法，說明何謂勞務採購。\n3.參據採購法採購金額級距，如何編列工程預算書、勞務預算書(以實務案例說明)。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "施工規劃及估價",
    "sub_ename": "CONSTRUCTION PLANNING AND ESTIMATION",
    "describe_ch": "施工規劃與估價學是營建工程之一門整合性學科，其目的在於使學生明白施工規劃與估價之要旨，並藉由品質管制達到降低成本、提昇品質的目的。",
    "describe_eh": "Construction Planning and Estimate is an interdisciplinary course for construction\nengineering. The purpose of this course is to let students realize the main ideas of\nconstruction planning and estimate. Then, by applying the schemes of quality control,\nthe purposes for reducing cost and enhancing quality can be achieved.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠描述施工計劃與估價之主體內容，並能清楚地表達",
      "describe_en": null
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明施工計劃與估價之方法",
      "describe_en": null
    },
    {
      "seq": 3,
      "describe_ch": "能進行工地實務調查、分析及撰寫報告",
      "describe_en": null
    },
    {
      "seq": 4,
      "describe_ch": "能以書面或口頭方式將所獲結果與同儕、助教及教師溝通",
      "describe_en": null
    }
  ],
