  "description": {
    "sub_id3": null,
    "sub_name": "文獻研討",
    "sub_ename": "LITERATURE DISCUSSION",
    "describe_ch": "文獻研討訓練學生閱讀報告科技文獻，並完成碩士論文提案。本課程預期修習之研究生需學習組織研究動機、管理論文提案之範圍、架構研究計畫、論文格式和完成文獻報告寫作。",
    "describe_eh": "The purpose of this course is to help students get through the thesis research process by focusing on a key step: designing a research proposal. Thesis proposal will be evaluated. The course is intended to help students organize ideas, manage the scope of proposal, plan for the research structure and format of a thesis. It gives students a chance to collaborate group persons others in the research field.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解文獻研討之設計與實務應用。",
      "describe_en": "Comprehend the design and application of the literature survey."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明如何口頭提報碩士論文。",
      "describe_en": "Understand and explain how to present the master thesis orally."
    },
    {
      "seq": 3,
      "describe_ch": "能辨識與分析出在碩士論文之研究上可能遭遇之困難，並能清楚表達。",
      "describe_en": " Distinguish and make clear statement where the difficulties of master thesis may be encountered."
    },
    {
      "seq": 4,
      "describe_ch": "能利用文獻研討，解決碩士論文之研究上可能遭遇之困難。",
      "describe_en": "Using the literature survey to solve the difficulties of master thesis may be encountered."
    },
    {
      "seq": 5,
      "describe_ch": "培養溝通協調及團隊合作之能力。",
      "describe_en": "Developing the ability of communication, coordination and teamwork."
    }
  ],
