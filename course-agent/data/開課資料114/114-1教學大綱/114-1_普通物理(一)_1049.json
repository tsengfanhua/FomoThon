  "description": {
    "sub_id3": null,
    "sub_name": "普通物理(一)",
    "sub_ename": "GENERAL PHYSICS(1)",
    "describe_ch": "普通物理學(一)將系統地介紹基礎物理學課題，包括牛頓力學、波動力學、熱力學。本課程的目標是教授學生作為科學基礎的基礎物理的核心知識。本課程以教師課堂講授為主，逐步推導和講解理論，配合課堂視聽資料。",
    "describe_eh": "General physics (1) will systematically introduce the fundamental physics topics, including Newtonian mechanics, wave dynamics, thermodynamics. The goal of this course is to teach students the core knowledge of basic physics as the basis of science. This course is mainly based on teachers’ classroom lectures, gradually deriving and explaining theories, and matching audio-visual materials in the classroom.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解並能應用基本運動定律\t",
      "describe_en": "Understand and be able to apply the laws of motion."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解能量的意義並可應用於力學問題\t",
      "describe_en": "Understand the concept of energy and be able to solve mechanical problems in terms of energy."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉基本之轉動、振動及波動相關物理\t",
      "describe_en": "Be familiar with the basic physics of rotation, oscillation, and waves."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解並能應用基本熱力學定律\t",
      "describe_en": "Understand and be able to apply the laws of thermodynamics.　"
    }
  ],
