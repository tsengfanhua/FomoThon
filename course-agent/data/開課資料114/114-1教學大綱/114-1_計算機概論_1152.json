  "description": {
    "sub_id3": null,
    "sub_name": "計算機概論",
    "sub_ename": "INTRODUCTION TO  COMPUTER AND COMPUTING",
    "describe_ch": "廣泛地認識電腦科學相關的主題，概述計算機中軟體與硬體相關的基本知識。課程主要為電腦原理的介紹，及使用機算機來解決方法論與演算法的問題。",
    "describe_eh": "The purpose of this course is to understand Computer Science，and to  state the knowledge of software/hardware in Computer Science. The course mainly focuses on the introduction of the computer theories，and the use of computer to solve the problems of methodology and algorithm.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建構計算機軟、硬體基本概念。",
      "describe_en": "To construct the basic knowledge of computer software and hardware."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解網路及作業系統基本知識與應用。",
      "describe_en": "To know the basic knowledge and application of computer networks and operation systems."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解程式語言及程式邏輯。",
      "describe_en": "To know program language and program logic."
    },
    {
      "seq": 4,
      "describe_ch": "電腦文書、資料庫、試算表及簡報能力。",
      "describe_en": "To be able to use the software for paper work, database, spreadsheet and presentation."
    },
    {
      "seq": 5,
      "describe_ch": "使用程式語言計算與解決問題。",
      "describe_en": "To design programs for computing and problem solving."
    }
  ],
