  "description": {
    "sub_id3": null,
    "sub_name": "不動產爭議案例解析",
    "sub_ename": "THE CASES STUDY OF REAL ESTATE ISSUES",
    "describe_ch": "本課程綜整學生所學民法、行政法、土地法、土地登記規則等法學科目，以臺灣既有產生社會爭議的案例為教材，訓練學生釐清法律爭點、運用所學解決問題的能力，以回應實務發展，銜接學生於公部門及產業界之就業需求。",
    "describe_eh": " This course integrates several subjects which students have learned, such as Civil Code, Land Act, Regulations of The Land Registration. Also, this course uses the disputes have happened in Taiwan’s social society as teaching material. We want train students have abilities to clarify legal disputes, and solve problems from this course. By this way, students could respond the requirement in public domain and private domain, and use their knowledge in practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具整體性適用法規的能力",
      "describe_en": "Have ability to use laws holistically"
    },
    {
      "seq": 2,
      "describe_ch": "具解決實務問題的能力",
      "describe_en": "Have ability to solve problems in practice"
    },
    {
      "seq": 3,
      "describe_ch": "蒐集資料並釐清法律爭點的能力",
      "describe_en": "Have ability to gather literatures and clarify legal arguments"
    }
  ],
