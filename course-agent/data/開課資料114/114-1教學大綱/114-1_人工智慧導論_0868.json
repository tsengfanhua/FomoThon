  "description": {
    "sub_id3": null,
    "sub_name": "人工智慧導論",
    "sub_ename": "INTRODUCTION TO ARTIFICIAL INTELLIGENCE",
    "describe_ch": "本課程引導學生從歷史、未來發展趨勢、產業的應用瓶頸和需求、應用倫理和治理四個主題群，認識、思考、分析與評論AI技術的發展應用。在教學策略中，除講座外，將通過小組討論和課堂互動交流形式，培養學生的AI素養。",
    "describe_eh": "This course will guide students to understand, think, comment and analyze the development and application of AI technology from four thematic groups of history, future development trends, application problems and needs of various industries, application ethic, and governance. In the teaching strategies, in addition to lectures, students' AI literacy will be cultivated in the form of group discussions and interactive communication.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解人工智慧的發展歷史",
      "describe_en": "To understand the development history of artificial intelligence"
    },
    {
      "seq": 2,
      "describe_ch": "認識人工智慧各應用面向的技術發展",
      "describe_en": "To understand the technological development of artificial intelligence applications"
    },
    {
      "seq": 3,
      "describe_ch": "學習人工智慧的技術與特性，於體驗後嘗試規劃與實作合理的應用",
      "describe_en": "Learn the technology and characteristics of artificial intelligence, try to plan and apply after experiencing it"
    },
    {
      "seq": 4,
      "describe_ch": "認識人工智慧技術於應用上須注意的道德倫理，與治理原則",
      "describe_en": "To understand the ethics and governance principles that must be paid attention to in the application of artificial intelligence technology"
    }
  ],
