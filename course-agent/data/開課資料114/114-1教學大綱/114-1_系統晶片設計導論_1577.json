  "description": {
    "sub_id3": null,
    "sub_name": "系統晶片設計導論",
    "sub_ename": "SYSTEM-ON-CHIP SYSTEM DESIGN OVERVIEW",
    "describe_ch": "系統晶片(SoC)具備微型化、低功率、高效能等優點，是現代晶片設計技術的主流趨勢，本課程講授系統晶片(SoC)之基本觀念與實務操作，預期修課後之學生將具備建構與驗證系統晶片之能力。",
    "describe_eh": "System on a Chip Design (SoC), a mainstream for modern chip design, has advantages such as low cost, low power, and high performance. This course gives basic concepts and practice for designing SoC. After taking this course, students are expected to have ability to establish and verify SoC designs.",
    "pre_subname": "ELEN3015可規劃邏輯設計實務",
    "pre_sub_id3": "ELEN3015",
    "pre_sub_ename": "ELEN3015 PROGRAMMABLE LOGIC DESIGN AND REALIZATION",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知曉如何建構系統晶片。",
      "describe_en": "Knowing how to establish systems on a chip."
    },
    {
      "seq": 2,
      "describe_ch": "知曉如何驗證所建構之系統晶片。",
      "describe_en": "Knowing how to verify established SoC designs"
    }
  ],
