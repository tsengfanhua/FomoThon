  "description": {
    "sub_id3": null,
    "sub_name": "產品開發與數位行銷",
    "sub_ename": "PRODUCT DEVELOPMENT AND DIGITAL MARKETING",
    "describe_ch": "在競爭激烈的全球產業環境下，企業均推出具有競爭力的新產品，以在市場占有一席之地，並維持企業的生存空間。然而為有效將產品銷售於顧客，如何利用數位行銷並發揮數位行銷之優勢，同時了解網路商務與行動商務之各種行銷議題，是本課程探討之重點。本課程的主要目的是提供學生了解系統性的產品開發與數位行銷，並且闡述產品開發與數位行銷之互動式關係，以及企業因正確的產品開發與數位行銷概念，保持其永續競爭優勢。",
    "describe_eh": "To deliver the new products to customers, it is essential to understand the concepts of internet business and mobile business coping with the digital marketing strategy. This course aims to provide a systematic concepts of product development and digital marketing, depict the mutual relationships between product development and digital marketing and obtain the sustainability based on the correct concepts of product development and digital marketing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "分析並使用相關科技工具將數位行銷發展成經營模式\t",
      "describe_en": "Analyze and use relevant tools to develop business models for digital marketing solutions."
    },
    {
      "seq": 2,
      "describe_ch": "學生能綜合應用產品開發之知識並具備企業家之精神於產業中\t",
      "describe_en": "Synthesize knowledge in product development and obtain the spirit of entrepreneurship in industries."
    }
  ],
