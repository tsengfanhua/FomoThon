  "description": {
    "sub_id3": null,
    "sub_name": "國土及區域計畫",
    "sub_ename": "NATIONAL & REGIONAL PHYSICAL PLANNING",
    "describe_ch": "課程主要探討：國土規劃理念，國土復育及保育，區域計畫相關法規，區域發展理論，都會區發展，自然資源的利用與保護，國土及區域土地使用規劃與管制，國土及區域計畫的流程，成長管理，及開發許可制。\r\n\r\n",
    "describe_eh": "Major topics in: Related law and Act for National and regional land use planning, regional development theories, metropolitan-region development, natural resource development and conservation, regional environment management, national and regional land use planning, control, and management; planning process of national and regional planning, growth management, and development permit.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 4,
      "describe_ch": "認識國土及區域計畫演變過程",
      "describe_en": "Knowledge for the evolution of national and regional land use planning"
    },
    {
      "seq": 5,
      "describe_ch": "培養學生理解及應用國土及區域計畫於都市規劃的方法",
      "describe_en": "Comprehension of training of the application of national and regional plan as the guidance of urban planning"
    },
    {
      "seq": 6,
      "describe_ch": "應用國土及區域發展政策及區域競爭力等概念",
      "describe_en": "Application of national and regional development policy and regional competitiveness"
    }
  ],
