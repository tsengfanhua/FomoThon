  "description": {
    "sub_id3": null,
    "sub_name": "非營利組織策略管理",
    "sub_ename": "STRATEGIC MANAGEMENT FOR NONPROFIT ORGANIZATIONS",
    "describe_ch": "本課程重點在強調非營利組織的經營策略，透過完善的策略研擬，以提昇非營利組織的經營績效。課程設計包括：組織使命的建立、非營利組織與營利組織、政府機構的競合關係、資金的募集及預算的編製等項目。",
    "describe_eh": "1. To use the Process of mission-setting. 2. To competitive analysis for the profit：The industry level. 3. To understand cooperation among nonprofits and competing with for-profit organizations and public agencies. 4. To analyze the optimal level of fundraising effect. 5. To introduce the budget process.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知道非營利策略管理之概念。",
      "describe_en": "To know the concept of strategic management for nonprofit organization."
    },
    {
      "seq": 2,
      "describe_ch": "理解策略管理系統與程序。",
      "describe_en": "Comprehending the strategic management system and procedure."
    }
