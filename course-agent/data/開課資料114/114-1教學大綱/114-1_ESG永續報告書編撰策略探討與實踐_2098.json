  "description": {
    "sub_id3": null,
    "sub_name": "ESG永續報告書編撰策略探討與實踐",
    "sub_ename": "THE STUDY OF MAKING STRATEGIES AND PRACTICE ABOUT ESG REPORT",
    "describe_ch": "本課程主要是希望透過國際標準的認識與解讀，帶引學生了解如何進行ESG的報告書的撰寫，以及其所可依照的原理與規則為何，並透過對既有國內外ESG報告書優點與缺點的探討，使學生學會如何撰寫可以和企業現況與國際永續需求趨勢結合的ESG報告書。",
    "describe_eh": "This course is trying to let students learn how to design the ESG report, and understand the principles and rules of international standards that the ESG report will be able to follow. In the end, this course will give students a workout on making an ESG report which can match the business situation and the international demanding for sustainability.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生理解如何依照全球標準來進行ESG報告書的規劃。",
      "describe_en": "To let students learn how to design the ESG report following the principles and rules of global standard."
    },
    {
      "seq": 2,
      "describe_ch": "帶領學生練習如何撰寫ESG報告書。",
      "describe_en": "To give students a workout on making an ESG report."
    }
  ],
