  "description": {
    "sub_id3": null,
    "sub_name": "工業 4.0 製造專論",
    "sub_ename": "SPECIFIC TOPICS ON MANUFACTURING OF INDUSTRY 4.0",
    "describe_ch": "介紹因應新世代製造技術與提升國際競爭力的思維與技術。探討工業 4.0 的意義，以及軟硬體\r\n基礎建置與科技水準的條件，包括智能製造、物聯網、大數據分析，並進一步介紹我國各產業 實務應用的現況。讓學生學習如何利用工業 4.0 製造技術，協助公司更具備核心能力以快速回 應能力，迎接競爭激烈的市場。",
    "describe_eh": "Introduce the thinking and technology for the new generation of manufacturing technology and enhance global competitiveness. Explore the significance of Industry 4.0, as well as the conditions for the establishment of hardware and software infrastructure and technology, including smart manufacturing, Internet of things, and big data analysis. Explain the current status of practical applications in variant industries in Taiwan. Guide students to use Industry 4.0 manufacturing technology to promote companies core capabilities by quick response to challenge the fierce global market.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解工業 4.0 的內涵與基礎建設",
      "describe_en": "To understand the meaning of industry 4.0 and infrastructure"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解智能製造、物聯網與大數據分析",
      "describe_en": "To understand the Smart Manufacturing, Internet of Things (IOT) and Big Data Analysis. \r\n"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解工業 4.0 導入流程的技能",
      "describe_en": "To understand the skill of application procedure of Industry 4.0."
    },
    {
      "seq": 4,
      "describe_ch": "學習導入工業 4.0 的技能",
      "describe_en": "To  understand the infrastructure of Industry 4.0-. \r\n"
    }
  ],
