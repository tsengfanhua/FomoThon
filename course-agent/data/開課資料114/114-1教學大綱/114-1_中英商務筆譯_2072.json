  "description": {
    "sub_id3": null,
    "sub_name": "中英商務筆譯",
    "sub_ename": "CHINESE-ENGLISH BUSINESS TRANSLATION",
    "describe_ch": "本課程旨在訓練學生精進中英筆譯技巧、策略與修辭，並透過閱讀商務領域英文文本，加強背景知識與專業詞彙，以進行中英雙向的商業實務筆譯，期使學生能運用語文、翻譯技能順利就業。",
    "describe_eh": "This course aims to reinforce students' Chinese-English translation techniques, strategies and rhetoric. Students will read business-related English texts to strengthen their background knowledge and terminology so as to translate market-oriented business topics between Chinese and English. Students are expected to apply the language and translation skills learned in this course to secure job opportunities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解中英口筆譯技巧及相關修辭",
      "describe_en": "To understand English-Chinese translation and interpretation techniques and the rhetoric involved"
    },
    {
      "seq": 2,
      "describe_ch": "具備口筆譯實務的應用能力",
      "describe_en": "To apply the knowledge of translation and interpretation in the workplace"
    }
  ],
