  "description": {
    "sub_id3": null,
    "sub_name": "流體力學(一)",
    "sub_ename": "FLUID MECHANICS(1)",
    "describe_ch": "本課程係一入門課程，旨在介紹流體靜止與運動時之行為。流體力學（一）之內容包括流體之性質、流體靜力學、基礎流體力學、流體運動學、以及有限控制體積分析。涉及工程應用計有：壓應力計，水門及水壩之受力及力矩，壓縮機之非恆態質量守恆，彎管固定力，抽水機馬力計算等。",
    "describe_eh": "This is an introduction course in which the behavior of fluids at rest and in motion is to be presented and explored. The contents of Fluid Mechanics (1) include those aspects of fluid properties, fluid statics, elementary fluid dynamics, fluid kinematics, and finite control volume analysis.",
    "pre_subname": "CEM1006微積分、MATH1001微積分(一)、MATH1005微積分(一)、MATH1006微積分(二)、PHYS1005普通物理(一)、PHYS1006普通物理(二)",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS、MATH1001 CALCULUS(1)、MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、PHYS1005 GENERAL PHYSICS(1)、PHYS1006 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用流體性質與流體靜力學.\t",
      "describe_en": "1 Can apply fluid properties and fluid statics."
    },
    {
      "seq": 2,
      "describe_ch": "能應用Bernoulli方程式.\t",
      "describe_en": "2Can apply Bernoulli equation."
    },
    {
      "seq": 3,
      "describe_ch": "\t能理解Reynolds轉換定律.\t",
      "describe_en": "3 Can understand Reynolds transport equation."
    },
    {
      "seq": 4,
      "describe_ch": "能應用連續,動量,與能量方程式.\t",
      "describe_en": "4 Can apply continuity, momentum, and energy equations."
    }
  ],
