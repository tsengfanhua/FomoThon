  "description": {
    "sub_id3": null,
    "sub_name": "建設產業數位原型實作",
    "sub_ename": "DIGITAL PROTOTYPING FOR AEC INDUSTRY",
    "describe_ch": "課程目標在講授如何運用計算機軟體及應用程式開發工具，以數位化的方式快速實現建設產業相關的創意、功能、或問題解決方案，透過課堂實例演練與分組專案，訓練學生具備數據處理與表達、設計開發簡易應用程式的數位原型實作能力。",
    "describe_eh": "The course aims to teach students how to use computer software and application development tools to digitally prototype innovative ideas, functional ideas or problem-solving solutions related to the construction industry. Through in-class exercises and group projects, students will develop their ability to implement digital prototypes, which may involve data processing, presentation, and application development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
