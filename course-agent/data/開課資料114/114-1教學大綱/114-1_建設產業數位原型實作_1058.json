    {
      "seq": 1,
      "describe_ch": "理解資訊科技在建設產業的發展與應用",
      "describe_en": "To understand the development and application of information technology in the AEC industry"
    },
    {
      "seq": 2,
      "describe_ch": "具備數據處理及表達的能力\t",
      "describe_en": "To have ability to process and present data"
    },
    {
      "seq": 3,
      "describe_ch": "具備數位原型實作能力\t",
      "describe_en": "To have ability to implement digital prototypes"
    }
