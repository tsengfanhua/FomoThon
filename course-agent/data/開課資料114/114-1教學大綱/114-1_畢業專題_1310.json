  "description": {
    "sub_id3": null,
    "sub_name": "畢業專題",
    "sub_ename": "GRADUATION PROJECT",
    "describe_ch": "本課程為本系終端課程，由全系所有教師共同開設，每組3~5位大四學生於此門課程中與其指導老師討論專題實作之題目與方向，由擬定計畫書開始，內容包含動機、背景說明、實行方法、時程及經費規劃等，逐步確實執行並完成計畫，以培育學生解決實務問題之整合能力。",
    "describe_eh": "The course is taught by all IESM faculty members. 3~5 senior students team up to complete a project under guidance of their advisor. The course is designed to move students away from departmentalized learning toward a more interdisciplinary approach allowing students to use a variety of skills in the areas of writing, speaking, documentation , and research.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "提升學生專業領域的知識學習與分析技能。\r\n\r\n",
      "describe_en": "Improve students' knowledge learning and analytical skills in the field of expertise."
    },
    {
      "seq": 2,
      "describe_ch": "訓練學生定義、瞭解問題及蒐集資料之能力。\r\n\t",
      "describe_en": "Train students' ability to define, understand problems and collect data.\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "訓練學生整合不同課程作一綜合應用之能力。\r\n\t",
      "describe_en": "Train students' ability to integrate different courses for a comprehensive application.\r\n"
    },
    {
      "seq": 4,
      "describe_ch": "訓練學生應用專案管理技巧和團隊合作能力完成專題工作。\r\n\t",
      "describe_en": "Train students to apply project management skills and teamwork skills to complete project work.\r\n"
    },
    {
      "seq": 5,
      "describe_ch": "培養學生具有引導團隊問題持續改善、培育創新思維的能力。\r\n\t",
      "describe_en": "Cultivate students' ability to guide the continuous improvement of team problems and cultivate innovative thinking.\r\n"
    },
    {
      "seq": 6,
      "describe_ch": "訓練學生問題分析與獨立思考能力，及撰寫研究報告與口頭發表之能力。\r\n\t",
      "describe_en": "Train students' problem analysis and independent thinking skills, as well as the ability to write research reports and make oral presentations.\r\n\r\n"
    },
    {
      "seq": 7,
      "describe_ch": "增進學生增進學生對工程時事議題的認識，培養學生持續學習的習慣與能力。\r\n\t\r\n\r\n\r\n",
      "describe_en": "To enhance students' understanding of current engineering issues and cultivate students' habit and ability of continuous learning.\r\n"
    },
    {
      "seq": 8,
      "describe_ch": "培養學生從專題研究過程中，理解與實踐專業倫理及社會責任之觀念。\r\n\t",
      "describe_en": "Cultivate students to understand and practice the concepts of professional ethics and social responsibility from the process of special research.\r\n\r\n"
    }
  ],
