  "description": {
    "sub_id3": null,
    "sub_name": "專題研究討論",
    "sub_ename": "RESEARCH PROJECT",
    "describe_ch": " 由學生於大三選擇與個人興趣相關的專題與指導老師，並透過專題指導老師指導研究專題，透過相關研究文獻檢索、閱讀與小組討論設計題目，並應用所學理論與團隊合作將執行與實驗所設計之專題，並於大四專題討論課了解專題論文架構與相關議題的討論，最後透過公開發表，由專家與教授進行評分與建議。",
    "describe_eh": "Studients choose their advisor by their will in the Junior year. Through discussion the project topic with advisor, create a project plan. Cultivate students' ability of paper searching、paper reading、and presentation. Moreover, based on carrying out the project, cultivate students' ability of teamwork, understanding the basic theory. The studients give an oral presentation of their projects in the Senior year. The achievements of the projects were evaluate via the professors and experts.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "小組討論。",
      "describe_en": "Group discussion."
    },
    {
      "seq": 2,
      "describe_ch": "與專題老師設計題目。",
      "describe_en": "Design project with advisor."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生檢索論文、閱讀論文、整理論文之能力。",
      "describe_en": "Cultivate students' ability of paper searching、paper reading, and organization paper."
    },
    {
      "seq": 4,
      "describe_ch": "使學生熟悉相關論文研究議題與內容。",
      "describe_en": "Make students be familiar with research topics."
    },
    {
      "seq": 5,
      "describe_ch": "培養學生聽講、思考、發問、與探討專業問題之能力。",
      "describe_en": "Cultivate students' ability of listening、thicking、asking、and discussing  problems."
    },
    {
      "seq": 6,
      "describe_ch": "執行專題計畫時應用系上所學之相關理論。",
      "describe_en": "Learning theory applied to carry out the project."
    },
    {
      "seq": 7,
      "describe_ch": "實驗與驗證所提專題計畫，並進行修正。",
      "describe_en": "Testing the feasibility of project and then modifying it."
    },
    {
      "seq": 8,
      "describe_ch": "整理與分析數據，能以書面或口頭方式將所獲結果與同儕、助教及教師溝通。",
      "describe_en": "Communicate results in written or oral form to classmates, teaching assistants, and the instructor."
    },
    {
      "seq": 9,
      "describe_ch": "口頭發表與書面報告。",
      "describe_en": "Oral presentation and written report."
    }
  ],
