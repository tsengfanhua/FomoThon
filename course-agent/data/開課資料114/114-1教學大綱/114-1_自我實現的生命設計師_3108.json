  "description": {
    "sub_id3": null,
    "sub_name": "自我實現的生命設計師",
    "sub_ename": "SELF-REALIZATION IN LIFE",
    "describe_ch": "大部分的人不小心就過了別人的日子，而不是活出自己的精彩。邁向有自信的生命歷程，不僅要熱情，還需要設計，還要有互相扶持成長的夥伴關係。循著過去的歷史軌跡，翻閱「之所以為你」的一切線索，找回初心檢視資產，朝著適合自己的道路前進。以終為始，找到自己的天命，邁向無限可能。",
    "describe_eh": "This course aims to make students confident and passionate in their lives rather than following the track of other people. Also, they need to find partners in lives and find the way moving on to their goals and then there will be various possibilities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "面對已經發生的過去，思索個人發展與定位",
      "describe_en": "To find one’s development and destine from past experiences."
    },
    {
      "seq": 2,
      "describe_ch": "窺看即將到來的未來，開展宏觀視野的公民實踐",
      "describe_en": "To broaden vision for civil practice towards the future."
    }
  ],
