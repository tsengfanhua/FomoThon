  "description": {
    "sub_id3": null,
    "sub_name": "資訊安全與生活",
    "sub_ename": "INFORMATION SECURITY IN LIFE",
    "describe_ch": "隨資通訊科技發展，越來越多行動裝置或數位應用於生活中，然而，越來越多資安問題也隨之增加。因此，希望經本課程提升學生之資安概念與資安認知，進而確保生活上之資訊安全。",
    "describe_eh": "With development of information and communication technology, more and more devices or digital applications are applied in life. However, more and more security problems are increasing. Hence, students will obtain concept and awareness of information security, and further, ensure security in life.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
