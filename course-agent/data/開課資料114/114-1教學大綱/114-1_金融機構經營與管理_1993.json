  "description": {
    "sub_id3": null,
    "sub_name": "金融機構經營與管理",
    "sub_ename": "FINANCIAL INSTITUTIONS MANAGEMENT",
    "describe_ch": "本課程著重於金融機構之風險管理，主要內容包括：金融市場與金融機構、利率風險之衡量與管理、市場風險之衡量與管理、流動性風險的衡量與管理、外匯風險的衡量與管理、銀行監理與存款保險。",
    "describe_eh": "This course focuses on the risk analysis and risk management of financial institutions. Topics include the introduction of financial institution operations, measurement and management interest risk, market risk, liquidity risk, and foreign risk. Also include bank regulations and deposit insurance.",
    "pre_subname": "FINA6030財務管理",
    "pre_sub_id3": "FINA6030",
    "pre_sub_ename": "FINA6030 FINANCIAL MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解金融機構所提供的功能",
      "describe_en": "Understand the functions of financial institutions"
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解利率風險以及應用衡量與管理利率風險的方法",
      "describe_en": "Understand how to measure and manage the interest risk"
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解市場風險及應用市場風險的衡量與管理之方法",
      "describe_en": "Understand how to measure and manage the market risk."
    },
    {
      "seq": 4,
      "describe_ch": "能瞭解流動性風險及應用流動性風險的衡量與管理之方法",
      "describe_en": "Understand how to measure and manage the liquidity risk."
    },
    {
      "seq": 5,
      "describe_ch": "能瞭解外匯風險及應用外匯風險的衡量與管理之方法",
      "describe_en": "Understand how to measure and manage the foreign risk"
    },
    {
      "seq": 6,
      "describe_ch": "能瞭解銀行監理制度及其對金融機構風險管理的影響",
      "describe_en": "Understand the system of bank regulations."
    },
    {
      "seq": 7,
      "describe_ch": "能衡量及分析一特定金融機構之各項風險",
      "describe_en": "Be able to measure and analyze the risks of a financial institution."
    }
  ],
