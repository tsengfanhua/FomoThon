    {
      "seq": 1,
      "describe_ch": "學生了解交易策略和原理。",
      "describe_en": "Students understand the trading strategies and principles."
    },
    {
      "seq": 2,
      "describe_ch": "學生具有量化交易的基本能力。",
      "describe_en": "Students have basic abilities of quantitative trading."
