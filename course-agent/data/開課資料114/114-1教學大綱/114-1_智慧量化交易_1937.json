  "description": {
    "sub_id3": null,
    "sub_name": "智慧量化交易",
    "sub_ename": "INTELLIGENT QUANTITATIVE TRADING",
    "describe_ch": "本課程將介紹以人工智慧為基礎的投資交易方法，協助學生培養資料分析，及運用人工智慧技術進行量化交易的能力，並建立交易策略和進行風險管控。",
    "describe_eh": "This course will introduce investment trading methods based on artificial intelligence, helping students develop skills in data analysis and the use of AI technology for quantitative trading. It will also cover building trading strategies and risk management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
