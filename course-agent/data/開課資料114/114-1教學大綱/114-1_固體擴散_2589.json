  "description": {
    "sub_id3": null,
    "sub_name": "固體擴散",
    "sub_ename": "DIFFUSION IN SOLIDS",
    "describe_ch": "本課程講述固態擴散的基本理論以及在材料科學與工程中擴散的應用。在課程中除了針對微觀之原子理論與巨觀之現象理論，二方面之觀點加以探討外，也針對相關固態擴散文獻進行闡述。本課程除了透過課堂講授外，也藉由每一位同學閱讀相關文獻進行口頭報告方式，來強化相關知識的學習。",
    "describe_eh": "This course describes the basic theory of solid-state diffusion and its application in materials science and engineering. In addition to discussing the two aspects of the microscopic atom theory and the macroscopic phenomenon theory, the course also elaborates on the related solid-state diffusion literature. In addition to lectures in class, this course also strengthens the learning of relevant knowledge by reading relevant literature and giving oral reports.",
    "pre_subname": "MSE1000材料科學導論(一)、MSE1010材料科學導論(二)",
    "pre_sub_id3": "MSE1000",
    "pre_sub_ename": "MSE1000 INTRODUCTION TO MATERIALS SCIENCE(1)、MSE1010 INTRODUCTION TO MATERIALS SCIENCE(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解固體中在不同溫度下之擴散行為及發生的相改變，學習原子在固體中如何移動並清楚了解擴散在所有結晶固體中的物理意義",
      "describe_en": "Understand the diffusion behavior and the phase changes that occur in solids at different temperatures. Learn how atoms move in solids and make clear the physical meaning of diffusion in all crystalline solids."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明固體擴散在材料科學與工程的重要性及影響，能應用固體擴散的原理，評估一材料或系統，並提出可行驗證方法",
      "describe_en": "Understand and be able to explain the importance and effects of diffusion in solids to materials science and engineering. Apply principles of diffusion in solids to evaluate a material or system and propose a feasible method for validation."
    },
    {
      "seq": 3,
      "describe_ch": "知道如何收集固體擴散的相關資訊、研究結果，並可評估所獲資訊的適用性能，針對一特定有關固態擴散的議題，加以驗證，並適切歸納出結論能以書面方式將所獲結果與同儕、助教及教師溝通",
      "describe_en": "Know how to collect and access related diffusion in solids information, research and be able to evaluate the appropriateness of the obtained information. Aim at diffusion in solids issue and draw appropriate conclusions. Communicate results in written for"
    }
  ],
