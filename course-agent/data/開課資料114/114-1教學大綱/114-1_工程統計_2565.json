  "description": {
    "sub_id3": null,
    "sub_name": "工程統計",
    "sub_ename": "ENGINEERING STATISTICS",
    "describe_ch": "本課程乃是針對工程統計與材料可靠度相關基礎知識進行說明，並熟悉數據統計與失效分析數學模型技巧。內容包括統計學基礎知識、敘述性統計、隨機變數與分布、材料可靠度物理、材料可靠度的統計分析法、分布模式、適合度檢定以及相關迴歸分析。分布模式適合度則利用卡方檢定，變異數分析的問題也會於課程中討論。主要以Microsoft Excel為工具，學習如何應用統計方法驗證過去所學之相關材料力學問題，及進一步分析產品所遭遇之可靠性設計問題。",
    "describe_eh": "This course explains fundamental knowledge of engineering statistics and materials reliability physics. Data analysis and failure analysis are covered. This course contains: fundamental concepts, descriptive statistics, random variables and distributions, materials reliability physics & statistical analysis, goodness-of-fit test of distribution function and regressive analysis. Goodness of fit test adopts Chi-square test, and analysis of variance (ANOVA) is taught. Using Microsoft Excel as the major learning tool, students will learn practical statistical analysis involving problems addressed in the Mechanics of Materials, furthermore, the estimation and analysis of product reliability design.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "描述工程統計的重要性。",
      "describe_en": "Describe the application of engineering statistics and its importance."
    },
    {
      "seq": 2,
      "describe_ch": "說明機率的基本概念及原理。",
      "describe_en": "Explain the probability concept and the basics."
    },
    {
      "seq": 3,
      "describe_ch": "描述機率分佈、隨機變數函數的理論知識。",
      "describe_en": "Describe the knowledge of probability distribution and random variable functions."
    },
    {
      "seq": 4,
      "describe_ch": "運用工程應用的基本能力，包括觀測資料之參數推估、機率分佈檢定以及迴歸與相關係數分析。",
      "describe_en": "Perform the applied skill for engineering, including parameter estimation, probability distribution test and regressive analysis."
    }
  ],
