  "description": {
    "sub_id3": null,
    "sub_name": "全球行銷管理",
    "sub_ename": "GLOBAL MARKETING MANAGEMENT",
    "describe_ch": "此科目的設計主要是讓學生熟悉有關全球市場背景下的策略行銷與行銷管理決策。混淆的兩股趨勢，全球化與本土化很容易讓學生無法了解其所面臨的全球村的處境。此科目提供學生有關全球行銷之主要的概念、理論架構與實務性之探討，尤其是如何協助學生提高全球行銷管理的興趣。",
    "describe_eh": "This course provides knowledge of strategic marketing and marketing management under global market. The challenge for business to operate marketing in global context is greater than international context. Competence of clear concepts and analytical skills would assist young students to grasp the evolving trend of global village. Both theoretical frameworks and practical cases will be discussed in the class in a purpose to raise interests for global marketing management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "綜合影響全球行銷管理的主要因素，及瞭解在施行全球行銷時所面臨的挑戰。 　\t",
      "describe_en": "Synthesize knowledge of the major factors in global marketing management, and realize the challenge of global marketing.　"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解文化因素在全球行銷的重要性，並分析國外與國內文化環境的不同處。　\t",
      "describe_en": "Recognize the importance of the cultural factor in global marketing, and analyze the difference cultural environment between foreign countries and Taiwan.　"
    }
  ],
