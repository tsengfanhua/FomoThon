  "description": {
    "sub_id3": null,
    "sub_name": "智慧能源科技導論",
    "sub_ename": "THE INTRODUCTION OF INTELLIGENT ENERGY TECHNOLOGY",
    "describe_ch": "本課程大綱其內容主要包括電磁能源、光電及電波三大領域在智慧能源科技中的基礎元件、相關應用及系統整合。藉由修習本課程可以使學生認識三大領域之基本元件並且熟稔其相互間之原理與應用，達到其於電機三大領域中之智慧能源科技系統整合能力之目標，並進一步將其應用於物聯網及工業4.0之系統整合。",
    "describe_eh": "The aim of this course is to introduce an intelligent energy system which covers electromagnetic, electro-optics and electro-wave optoelectronics programs in electrical engineering. Through the acknowledgment and comprehension of these three basic fields, students can obtain the ability of the applications and system integration for an electrical engineering system. Furthermore, they can employ the technology to the internet of thing and the application of industry 4.0.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的專業詞彙定義何謂智慧能源科技系統，並描述其特性。",
      "describe_en": "Define and describe the characteristics of an intelligent energy technology system."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明智慧能源科技在電機領域的應用。",
      "describe_en": "Understand and be able to explain the applications of intelligent energy system in the field of electrical engineering."
    },
    {
      "seq": 3,
      "describe_ch": "對電波及光電工程領域的熱門主題具備基本的知識",
      "describe_en": "To possess the fundamental knowledge in the popular topics of electro-wave and electro-optics engineering domain."
    },
    {
      "seq": 4,
      "describe_ch": "對智慧能源科技、環境及我彼此之間關係的理解",
      "describe_en": "Understanding the relationship between intelligent energy system technology, the environment and me."
    }
  ],
