  "description": {
    "sub_id3": null,
    "sub_name": "品質管理",
    "sub_ename": "MANAGEMENT IN QUALITY",
    "describe_ch": "本課程目的在訓練學生如何正確應用統計和統計品管手法於實務上之產品或服務品質之關鍵問題以改善或解決實務之品質問題或設計創意品質以提昇產業競爭力和附加價值,並降低生產成本和顧客抱怨以增進公司競爭力及利潤進而能永續經營。",
    "describe_eh": "The purpose of this course is to train students how to correctly apply statistics and statistical quality control techniques to key issues of product or service quality in practice to improve or solve practical quality problems or to design creative quality to enhance industrial competitiveness and added value, and reduce production costs and customer complaints to enhance the company's competitiveness and profits so that it can operate sustainably.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使修課學生對品質觀念與管制方法之發展有基本認識",
      "describe_en": "To enable students taking the course to have a basic understanding of the development of quality concepts and control methods"
    },
    {
      "seq": 2,
      "describe_ch": "讓學生了解如何利用品質分析方法",
      "describe_en": "Let students understand how to use quality analysis methods"
    },
    {
      "seq": 3,
      "describe_ch": "讓學生了解統計技術以進行工程之品質管制",
      "describe_en": "To enable students to understand statistical techniques for quality control in projects"
    },
    {
      "seq": 4,
      "describe_ch": "讓學生了解工程品質改善之程序。",
      "describe_en": "Let students understand the process of project quality improvement."
    }
  ],
