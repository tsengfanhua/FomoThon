  "description": {
    "sub_id3": null,
    "sub_name": "無人機",
    "sub_ename": "UNMANNED AERIAL VEHICLE",
    "describe_ch": "無人機在軍事與民生的應用非常廣，因此學/研單位及產業競相投入此領域的研發，其負載需求也從數公斤發展到數百公斤，並從跑道起降轉換為垂直起降。然而高負載的無人機之起降、飛控系統…等整合相對困難，因此開設此課程教授學生相關的飛行原理與設計分析技術。",
    "describe_eh": "Unmanned aerial vehicles (UAVs) have been found wide application in the military and civilian usage. Therefore, many academic/research units and industries have invested in the research and development of UAVs capable of carrying payloads up to hundreds of kilograms, and transition from runway take-off and landing to vertical take-off and landing (VTOL). However, the integration of take-off and landing task, flight control system…etc. is relatively difficult for high payload. Hence, this course is offered to teach students relevant flight principles and techniques of design and analysis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識各種UAV之設計理念及功能",
      "describe_en": "To have knowledge of the design ideals and functions of UAVs"
    },
    {
      "seq": 2,
      "describe_ch": "熟悉中大型UAV的初步原理及方法",
      "describe_en": "To get familiar with the preliminary theory and methodology of medium and large UAVs design"
    },
    {
      "seq": 3,
      "describe_ch": "能將所學之CAD/CAE電腦輔助工程軟體應用於UAV設計",
      "describe_en": "To be able to apply the CAD/CAE software to UAVs design"
    },
    {
      "seq": 4,
      "describe_ch": "具團隊合作精神以進行UAV工程設計之能力",
      "describe_en": "To be able to work as a team member and pursue UAVs design of engineering applications"
    },
    {
      "seq": 5,
      "describe_ch": "訓練口頭報告及UAV設計作品之能力",
      "describe_en": "To be capable of making a fine presentation of UAVs design works to their classmates and instructor"
    }
  ],
