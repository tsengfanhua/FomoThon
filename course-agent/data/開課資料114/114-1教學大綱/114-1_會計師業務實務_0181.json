  "description": {
    "sub_id3": null,
    "sub_name": "會計師業務實務",
    "sub_ename": "PRACTICE OF CERTIFIED PUBLIC ACCOUNTANTS",
    "describe_ch": "將會計師業務分成三大部分：工商登記、管理顧問及審計工作。本課程對工商登記及管理顧問只作簡介。著重會計學、審計學與稅務法規於審計查核工作的運用及審計報告之介紹。",
    "describe_eh": "The course divided into three categories: registration of profit seeking organization; management consultant ; auditing. The first two categories will introducing briefly, the auditing work will emphasis on audit methodology, the preparing the working paper of auditing and the audit/review report. The introduction of income tax law.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "資產負債表查核實務",
      "describe_en": "Audit practices of balance sheet."
    },
    {
      "seq": 2,
      "describe_ch": "損益表科目查核-營利事業所得稅之結算申報與查核",
      "describe_en": "Audit practices of income statement & the introduction of income tax law."
    },
    {
      "seq": 3,
      "describe_ch": "深入理解查核/核閱報告書用詞遣字的精神",
      "describe_en": "Deep understanding the detail spirits of auditing /review report."
    }
  ],
