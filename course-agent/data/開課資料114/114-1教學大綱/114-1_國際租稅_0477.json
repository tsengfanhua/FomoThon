  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB05142",
    "sub_id": "41640",
    "scr_dup": "001",
    "sub_title": "探究主題包含國際租稅規範介紹、對內、對外投資議題、移轉訂價議題、BEPS1.0、BEPS2.0、氣候變遷與永續趨勢以及稅務管理議題。",
    "sub_title_en": null,
    "sub_describe": "1. 理解國際租稅的基本原則：包括稅收管轄權、雙重徵稅問題、稅收協定等。\n2. 掌握跨國企業稅務規劃的核心概念：如移轉訂價、受控外國公司（CFC）、稅基侵蝕與利潤移轉（BEPS）等。\n3. 分析實際案例：透過案例研究，培養學生解決實際國際稅務問題的能力。\n4. 跟上全球稅務發展趨勢：例如全球最低稅負制（GLoBE）與數位經濟稅務挑戰。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "國際租稅",
    "sub_ename": "INTERNATIONAL TAXATION",
    "describe_ch": " 闡述國際租稅基本概述，租稅管轄權，國際重複課稅及其避免，國際避稅及逃稅，防杜國際避稅方法與措施，國際租稅協定國際稅務協調，國際租?新課題，我國涉外課稅制度及國際租稅規劃為內容；期使學生瞭解跨境交易之國際租稅規範的運作及處理跨境交易涉稅事宜。　",
    "describe_eh": "This course is designed to introduce tax jurisdiction , international double taxation and its elimination, international tax avoidance and evasion, anti-international tax avoidance measures, international tax convention, new subjects of international tax ,foreign-related tax law of R.O.C. , international tax planning. In order to help the students understand Application international taxation rule of the Cross-border transactions and handling taxation matters of the Cross-border transactions.",
    "pre_subname": "PF2040租稅法(一)、PF2041租稅法(二)",
    "pre_sub_id3": "PF2040",
    "pre_sub_ename": "PF2040 TAX LAW(1)、PF2041 TAX LAW(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解國際租稅的基本概念",
      "describe_en": "Comprehend the basic concepts of international taxation"
    },
    {
      "seq": 2,
      "describe_ch": "說明跨境交易之國際租稅規範的運作",
      "describe_en": "Knowing the Application on international taxation rule of the Cross-border transactions and handling taxation matters of the Cross-border transactions"
    },
    {
      "seq": 3,
      "describe_ch": "理解未來國際租稅的發展趨勢",
      "describe_en": "Comprehend the future trend of international taxation　"
    }
  ],
