  "description": {
    "sub_id3": null,
    "sub_name": "會計學(一)",
    "sub_ename": "ACCOUNTING(1)",
    "describe_ch": "本課程介紹基本會計學原則及觀念，主要包括：會計恆等式、交易分析、會計分錄、調整分錄、結帳分錄、會計循環、財務報表、買賣業會計、存貨、現金與內部控制。 \r\n\r\n",
    "describe_eh": "This course introduces basic accounting principle and concepts. The main topics include accounting equation, transaction analysis, journal entry, adjustment entry, closing entry, accounting cycle, financial statements, merchandising accounting, Inventory, cash and internal control 。",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 29,
      "describe_ch": "1.1.能知道會計學(一)涵蓋的主要內容及現代企業的財務報表和其限制。",
      "describe_en": "1.1.Knowledge for the content of Accounting I and modern business financial statements and their limitations."
    },
    {
      "seq": 30,
      "describe_ch": "2.2 能理解可應用會計學原理的情況。",
      "describe_en": "2.2. Comprehension for the application accounting principle situation."
    }
