  "description": {
    "sub_id3": null,
    "sub_name": "智慧財產權",
    "sub_ename": "INTELLECTUAL PROPERTY",
    "describe_ch": "探討智慧財產權相關法制，內容包含智慧財產權概論、商標法、著作權法及專利法，並論及營業秘密保護、不正競爭防止及國際智慧財產權相關問題之探討。",
    "describe_eh": "This course aims to discuss the law of intellectual property, including the general principles on intellectual property, trademark, copyright, and patent law. Moreover, topics such as the protection of trade secrets, unfair competition and international intellectual property will also be covered.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解智慧財產權之基本法制",
      "describe_en": "understanding the general principles of intellectual property"
    },
    {
      "seq": 2,
      "describe_ch": "熟悉並了解智慧財產權之行使議題",
      "describe_en": "Understanding the issue of intellectual property right enforcement."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉並了解智慧財產權侵害救濟議題",
      "describe_en": "Understanding the issue of intellectual property dispute remedy"
    }
  ],
