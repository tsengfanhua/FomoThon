  "description": {
    "sub_id3": null,
    "sub_name": "微處理機系統",
    "sub_ename": "MICROPROCESSOR SYSTEMS",
    "describe_ch": "理解微處理機或微控制器之基本原理與架構，包含CPU軟體模式與程式設計、CPU硬體模式與系統設計、記憶體定址模式、計時器/計數器、串列埠通訊、中斷控制、與I/O介面電路設計與應用。",
    "describe_eh": "Understand the basic principles and architecture of microprocessor or microcontroller, including CPU software mode and programming, CPU hardware mode and system design, memory addressing mode, timer/counter, serial communication, interrupts control, and I/ O interface circuit design and  its application.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.運用電子學基礎與程式以瞭解為處理機系統基本知識",
      "describe_en": "1.Apply electronic foundation and program to understand the basic knowledge about microprocessor systems."
    },
    {
      "seq": 2,
      "describe_ch": "2.理解為處理機系統各項性能的定義與定理",
      "describe_en": "2.Comprehension for the definitions or theories of microprocessor system performance."
    }
