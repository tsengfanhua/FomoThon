  "description": {
    "sub_id3": null,
    "sub_name": "國際企業管理",
    "sub_ename": "INTERNATIONAL BUSINESS MANAGEMENT",
    "describe_ch": "本課程之目的在於教導學生學習海外直接投資及國際企業相關的相關實務與理論知識，透過認識全球各國之間的政治、文化及社會的相關差異性，學生得以了解海外直接投資與多國籍企業在面臨全球經營時所面臨的相關挑戰與企業社會責任。經由了解相關的理論過去發展與未來趨勢，學生亦得以培養相關的分析技巧與架構。",
    "describe_eh": "This course is designed to study the managerial and practical knowledge of foreign direct investment and multinational enterprises. By increasing the awareness of political, social, and cultural differences that businesses encounter, it also develops students the ability to develop frameworks for anticipating, analyzing, and reconciling these differences. By reviewing the current patterns, trends, and behaviors of foreign direct investment and multinational enterprises, students can understand the main challenges and social responsibility in the international contexts. Through this course, students can learn frameworks and develop analytic skills by incorporating the present and future trends of cross-border value-added activities into theories of international business.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解跨國企業管理和企業國際化動機的知識，並能綜合運用到母子公司控管機制與知識管理之專業管理能力。",
      "describe_en": "Understand the knowledge of MNEs and motivations of internationalization in order to enhance the managerial capabilities in control mechanisms and knowledge management among headquarter and subsidiaries."
    },
    {
      "seq": 2,
      "describe_ch": "透過個案分析，運用國際企業管理理論解決實際跨國企業面臨之問題。",
      "describe_en": "Apply the theories of international business management to resolve the real MNE problems throughout the case analysis."
    }
  ],
