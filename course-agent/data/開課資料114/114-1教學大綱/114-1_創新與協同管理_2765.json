  "description": {
    "sub_id3": null,
    "sub_name": "創新與協同管理",
    "sub_ename": "INNOVATION AND COLLABORATION MANAGEMENT",
    "describe_ch": "本課程將透過對於最新之數位創新科技發展個案討論，引導不同背景領域的管理者認識並了解與「創新與協同管理」(Innovation and Collaboration Management, ICM)之相關理論與應用，以培養其相關專業修養及宏觀，並能融會貫通應用於各種經營與管理環境。",
    "describe_eh": "This course is designed, by introducing the contemporary case studies, to develop a substantial understanding on Innovation and Collaboration Management (ICM) for EMBA students. Generally, the main purpose of this course is to provide the students with insight into special topics of dealing with problems of innovation and collaboration design in an enterprise.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "分析及確認ICM之相關議題，並應用相關觀念與技術\t",
      "describe_en": "Analyze and confirm ICM related issues and applications of the concepts and techniques covered."
    },
    {
      "seq": 2,
      "describe_ch": "定義及綜合創新與協同管理之範圍及訴求",
      "describe_en": "Define and synthesize the scope and issues of Innovation and Collaboration Management (ICM)."
    }
  ],
