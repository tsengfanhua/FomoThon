  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CH00101",
    "sub_id": "67168",
    "scr_dup": "001",
    "tpa_score_new": "<div>綜合說明</div>\n\n<div>一、能遵守實習工作倫理。</div>\n\n<div>二、能應用實習經驗於個人職涯管理及規劃中。</div>\n\n<div>三、能秉持良好職場實習態度，融入未來工作環境。</div>\n",
    "tpa_score_new_en": null,
    "course_pol": "能秉持良好職場實習態度，積極配合職場主管之指導主動學習。秉持不辱校譽之使命，將良好職場態度，融入未來工作環境。",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<div>能應用職涯發展理論於實務工作中，認真完成指定閱讀，配合職場主管之指導主動學習。對生涯輔導方面指定須完成之書面報告、口頭報告、個人訪談、各主題之簡報資料研讀、線上輔導課程，皆能秉持誠信原則確實參與。</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": "N"
  },
