  "description": {
    "sub_id3": null,
    "sub_name": "電磁波傳播",
    "sub_ename": "ELECTROMAGNETIC WAVE PROPAGATION",
    "describe_ch": "課程目的是提供電波學程學生深入探討電磁波的數學模式及物理現象，課程基植於基本電磁學及工程數學，繼續探討波的形成，傳播模式，在不同材料形成的特性與現象，以及電磁理論在工程上的實際應用等。",
    "describe_eh": "The objective of this course is to further research the mathematic model and physical phenomenon of EM wave for student study in EM field. This course base on basic EM theory and engineering math, and continue to research wave to form, propagation mode，characteristic and phenomenon in different material. Last, study the EM theory in practice engineering applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解電磁領域各種各種物理現象及物理量、馬克斯威爾方程式及電磁波的產生",
      "describe_en": "Be able to understand basic phenomenon and quantity of EM field. And be able to define and describe EM jargon in right words. And understand Maxwell equation, the relationship with EM wave."
    },
    {
      "seq": 2,
      "describe_ch": "能了解傳輸線理論及模型，推導輸入阻抗、特性組抗、反射係數、傳輸係數、電壓駐波比及材料與波速關係。",
      "describe_en": "Understand theory and modeling of transmission line. Be able to derive the Zin, Zo, Γ,Τ,VSWR and velocity with different materials."
    },
    {
      "seq": 3,
      "describe_ch": "能使用相關數學及物理技術分析各種波傳導模態，並完成相關計算程序，歸納出適當結論。",
      "describe_en": "Be able to use related physical and math techniques to analysis the property of wave mode in different waveguide or materials, and to complete computational algorithm. Draw appropriate conclusions from solution results."
    }
  ],
