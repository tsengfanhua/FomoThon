  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB03119",
    "sub_id": "27400",
    "scr_dup": "001",
    "sub_title": "計算機技術與數位轉型、人工智慧與機器學習、金融科技創新、AI 行銷與電子商務、未來科技趨勢對財務金融的影響。",
    "sub_title_en": null,
    "sub_describe": "本課程探討計算機技術與數位轉型如何影響金融產業，涵蓋人工智慧、機器學習與大數據在風險管理、信用評估與投資決策的應用介紹。課程將說明自然語言處理、推薦系統與智慧客服如何提升金融服務體驗，並分析區塊鏈在支付、智能合約及去中心化金融的影響。此外，AI 在行銷與電子商務的應用，以及如何透過數據驅動行銷策略也將是重點。學生將理解 AI 技術在金融監管與風險管理中的挑戰，如數據隱私、演算法偏見與法規遵循，並探討未來金融科技的發展趨勢，包括自動化交易、智慧投資顧問與 AI 金融監理，全面掌握科技驅動的金融創新模式。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "計算機概論",
    "sub_ename": "INTRODUCTION TO  COMPUTER AND COMPUTING",
    "describe_ch": "本課程在教授學生網路基本知識與基本網路架設、網頁設計與網路建置、網路應用與電子商務、以及網路的陷阱與省思。",
    "describe_eh": "The goal of this course is to give an introduction to basic concepts concerning computing network. The construction of a network, its application, electronic commerce, as well as security issues will also be discussed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
