  "description": {
    "sub_id3": null,
    "sub_name": "植生工程",
    "sub_ename": "VEGETATION ENGINEERING",
    "describe_ch": "植生工程為針對植生施工場所，選取適生之植物材料，配合基礎與養護工程，以達到植生設計目的之科學。藉由本課程之教授，讓學生瞭解植生工程的內涵、重要性及其應用。",
    "describe_eh": "Vegetation engineering is an applied science, which is to choose the suitable plant materials according to the site condition and the fulfilled structure of foundation and slopeland protection, and to achieve the purpose of vegetation design. Through this course, students could understand the planning, design, application and main contents of vegetation engineering.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解植生材料之特性與應用。 \t",
      "describe_en": "Understand the properties and applications of the plants materials."
    },
    {
      "seq": 2,
      "describe_ch": "理解水土保育內涵及植生工程規劃設計。\t",
      "describe_en": "Understand soil and water conservation,the planning and design of vegetation."
    },
    {
      "seq": 3,
      "describe_ch": "學習植生工法及植生調查\t",
      "describe_en": "To learn vegetation methods and investigation."
    },
    {
      "seq": 4,
      "describe_ch": "水保植物與植生工法的應用",
      "describe_en": "The applications of plant and vegetation methods"
    }
  ],
