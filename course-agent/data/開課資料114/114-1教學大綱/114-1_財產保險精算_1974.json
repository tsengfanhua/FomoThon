  "readings": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CF03140",
    "sub_id": "38052",
    "scr_dup": "001",
    "tpc_seq": 1,
    "tpc_book": "<ol>\n\t<li>Foundations of Casualty Actuarial Science, Casualty Society</li>\n\t<li>產險精算科學 (顏忠義、陳貴霞、曾慶泓、吳明洋、賴曜賢、韋淑美、簡仲明、陳振桐、萬文禎合譯) 保險事業發展中心</li>\n\t<li>實用財產及責任保險費訂定原理 (賴曜賢著)</li>\n\t<li>財產保險費率釐訂理論與實際之研究(廖述源撰)</li>\n\t<li>高等產險精算理論與實務(林進田、陳強、顏忠義、凌氤寶、陳貴霞、曾慶泓、梁正德合著) 保險事業發展中心</li>\n</ol>\n",
    "tpc_book_en": null
  },
