  "description": {
    "sub_id3": null,
    "sub_name": "財產保險精算",
    "sub_ename": "ACTUARIAL MATHEMATICS FOR P & C INSURANCE",
    "describe_ch": "介紹產險精算的範疇、產險精算重要觀念、費率釐訂的方法：如純保險費法、損失率法、分類費率、個別費率以及準備金提存的基本方法：如損失發展法、剩餘準備金法。",
    "describe_eh": "This course introduces scopes of casualty actuarial science, important actuarial concepts, basic ratemaking methods such as pure premium method, loss ratio method, class rate as well as individual rate and reserving methods such as loss development method and Bornhuetter-Ferguson Method.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識產險精算的主要範疇",
      "describe_en": "Knowledge of scopes of casualty actuarial science."
    },
    {
      "seq": 2,
      "describe_ch": "了解產險精算重要觀念",
      "describe_en": "Comprehension of important actuarial concepts."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉產險費率定價的基本方法",
      "describe_en": "Familiarity with basic ratemaking methods."
    },
    {
      "seq": 4,
      "describe_ch": "理解準備金提存的基本方法",
      "describe_en": "Understanding basic reserving techniques."
    }
  ],
