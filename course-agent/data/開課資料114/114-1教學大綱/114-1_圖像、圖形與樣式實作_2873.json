  "targets": [
    {
      "seq": 1,
      "describe_ch": "Students gain the ability to recognise relationships between images, graphics and typography; reproduce graphic production techniques, and recall foundational knowledge of graphic design principles, history and theory.",
      "describe_en": "Students gain the ability to recognise relationships between images, graphics and typography; reproduce graphic production techniques, and recall foundational knowledge of graphic design principles, history and theory."
    },
    {
      "seq": 2,
      "describe_ch": "Students understand how design frameworks and methodologies function in practice.",
      "describe_en": "Students understand how design frameworks and methodologies function in practice."
    },
    {
      "seq": 3,
      "describe_ch": "Students can apply verbal and visual communication skills to illustrate concepts and relate graphic imagery projects in collaborative and individual contexts",
      "describe_en": "Students can apply verbal and visual communication skills to illustrate concepts and relate graphic imagery projects in collaborative and individual contexts"
    },
    {
      "seq": 4,
      "describe_ch": "Students learn to evaluate and integrate diverse sources of information into design solutions by interpreting research, examining ethical considerations and critically assessing visual material.",
      "describe_en": "Students learn to evaluate and integrate diverse sources of information into design solutions by interpreting research, examining ethical considerations and critically assessing visual material."
    }
  ],
