  "description": {
    "sub_id3": null,
    "sub_name": "使用者經驗設計",
    "sub_ename": "USER EXPERIENCE DESIGN",
    "describe_ch": "使用者經驗設計這門課將介紹在企業界使用的人機界面設計之工具、技術與方法，發展出以使用者為中心的人機界面。此課程有4-5個小型專案(團隊作業)，各專案將著重於如何將使用者經驗融入人機界面的設計之中，每組交專案書面報告之前須要做口頭報告並接受同儕間的評論。",
    "describe_eh": "The User Experience Design course will introduce the tools, techniques and methodologies used by enterprises to develop user-centered human-computer interfaces. There are 4-5 mini-sized team work projects, these projects will focus on how to consider the user experience during user interface design. Before submit the final report of each project, each group need give an oral presentation and take peer-critique.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
