  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE09149",
    "sub_id": "60389",
    "scr_dup": "001",
    "sub_title": "微創手術技術的發展與臨床應用趨勢",
    "sub_title_en": null,
    "sub_describe": "本主題將探討微創手術（Minimally Invasive Surgery, MIS）技術的演進歷程，涵蓋內視鏡手術、達文西機器手臂輔助系統、單孔手術（SILS）及自然腔道內視鏡手術（NOTES）等關鍵技術，並分析其在各種臨床科別（如一般外科、婦科、泌尿科、骨科）中的應用現況與挑戰。課程將透過案例討論與實作模擬，引導學生理解微創技術如何提升手術安全性、病患恢復速度與醫療品質，同時探討醫療器材創新與跨領域合作在手術科技發展中的角色。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "微創手術科技實務",
    "sub_ename": "ADVANCED TECHNOLOGY AND PRACTICE OF MINIMALLY INVASIVE SURGERY",
    "describe_ch": "外科手術目前最新的趨勢是微創手術，微創手術能夠持續發展是由於現代科技的成熟以及醫療的創新。不同於一般的開刀手術，微創手術是以內視鏡及手術器械經過身體的幾個小孔進行手術的治療。它的優點是傷口小、復原快，減少住院期間以及整體醫療成本。手術技術的未來與科技發展息息相關，本課程將結合臨床實務，並輔以先進微創科技應用的範例，期能讓學生吸取新知，並獲得啟發。",
    "describe_eh": "Nowadays surgical techniques are progressing into less and less invasive due to the innovation and integration of modern technology. Minimally Invasive Surgery (MIS) uses special instruments and laparoscope to operate through small holes. It gradually replaces the open surgery and has multifold benefits including faster recovery, less hospital stay and decrease the total healthcare cost. There is a pressing need for advanced technology to continue the evolution of future surgery. This course will invite surgeons and researchers to address on the real life MIS procedures and the state of the art technology to learn and inspire students in this area.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解各種微創手術器械與手術程序",
      "describe_en": "Understand the MIS devices, instruments and surgical procedures"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解未來手術發展的趨勢",
      "describe_en": "Understand the trend of surgery of the future"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解應用資訊科技以訓練醫師進行微創手術",
      "describe_en": "Understand the application of information technology to train surgeons in learning MIS"
    },
    {
      "seq": 4,
      "describe_ch": "習知生醫科技應用到微創手術之過程",
      "describe_en": "Learn the implementation process of advance technology in MIS"
    }
  ],
