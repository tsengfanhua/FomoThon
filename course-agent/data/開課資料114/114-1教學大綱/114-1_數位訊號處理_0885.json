  "description": {
    "sub_id3": null,
    "sub_name": "數位訊號處理",
    "sub_ename": "DIGITAL SIGNAL PROCESSING",
    "describe_ch": "訊號充斥在現實生活中，其中包含重要與不重要的訊息，訊號處理則可將混雜的訊號取出或強化重要的訊息，藉由萃取、強化、儲存與傳輸重要的訊息，將重要與不重要的訊息進行區分。訊號又分成類比與數位訊號，由於類比訊號處理系統設計上較為複雜及不具彈性，因此數位訊號處理系統的設計上更為容易及實踐。本課程的教學目標是介紹數位訊號處理的理論基礎、相關技術與實際應用等課題。",
    "describe_eh": "By extracting, strengthening, storing and transmitting important information, the important and unimportant information from the daily life or industries can be separated. Since the design of analog signal processing systems is more complex and inflexible, the design of digital signal processing systems is easier and more practical. The teaching goal of this course is to introduce topics such as the theoretical basis, related technologies and practical applications of digital signal processing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "教導學生連續信號的取樣與混疊。",
      "describe_en": "Teach students the sampling and aliasing of continuous signals."
    },
    {
      "seq": 2,
      "describe_ch": "教導學生理解離散信號與系統的基本概念",
      "describe_en": "Teach students to understand the basic concepts of discrete signals and systems"
    },
    {
      "seq": 3,
      "describe_ch": "理解DSP的數學分析方法，如離散時間傅立葉轉換、Z-轉換、與FIR / IIR濾波器的設計。",
      "describe_en": "Understand the mathematical analysis methods of DSP, such as discrete-time Fourier transform, Z-transform, and FIR/IIR filter design."
    },
    {
      "seq": 4,
      "describe_ch": "理解DSP系統的應用",
      "describe_en": "Understand the application of DSP system"
    }
  ],
