  "description": {
    "sub_id3": null,
    "sub_name": "企業分析與系統思考",
    "sub_ename": "ENTERPRISE ANALYSIS AND SYSTEM THINKING",
    "describe_ch": "本課程將引導學生認識產業發展趨勢以及了解人工智慧人才未來之發展潛力。並藉由產業發展的歷程，了解既有的企業組織結構型態與未來的演進趨勢。除此之外，如何以破壞性創新與用途理論，探索新的商業契機。",
    "describe_eh": "This course will guide students to understand the development trend of the industry and understand the future development potential of artificial intelligence talents. And through the course of industrial development, understand the existing corporate organizational structure and future evolution trends. In addition, how to explore new business opportunities with disruptive innovation and use theory.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "討論與分析企業組織結構與企業流程轉型升級\r\r\n",
      "describe_en": "Discuss and analyze corporate organizational structure and corporate process transformation and upgrading"
    },
    {
      "seq": 2,
      "describe_ch": "應用破壞性創新與用途理論，設計創新商業模式",
      "describe_en": "Apply disruptive innovation and usage theory to design innovative business models"
    },
    {
      "seq": 3,
      "describe_ch": "透過分析與思考企業結構，建立終生學習與持續改進的精神",
      "describe_en": "To establish the spirit of lifelong learning and continuous improvement by analyzing and thinking about the corporate structure"
    },
    {
      "seq": 4,
      "describe_ch": "認識企業的發展以及與社會責任、尊重的平衡",
      "describe_en": "Understand the development of the company and its balance with social responsibility and respect"
    }
  ],
