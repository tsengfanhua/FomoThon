    {
      "seq": 14,
      "describe_ch": "能以程式語言工具解決應用問題\t",
      "describe_en": "To solve problem with i-tool\t"
    },
    {
      "seq": 15,
      "describe_ch": "透過AI工具培養自主學習與問題導向提問能力\t",
      "describe_en": "To develop Self-Regulated Learning and Problem based learning skills through AI tools"
    }
