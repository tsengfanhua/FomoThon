  "description": {
    "sub_id3": null,
    "sub_name": "物質文化研究專題",
    "sub_ename": "MATERIAL CULTURE STUDIES",
    "describe_ch": "物質文化現象是我們得以理解現生或過去文化的重要媒介。本課程從人類學的研究方法討論物質文化的相關議題，並輔以實務習作培養學生從歷史與文化的視角理解物件，習得詮釋和策展之能力。",
    "describe_eh": "Material culture, which encompasses the world of objects and offer evidence to further our understanding of culture in both living and historical contexts. This course will investigate the cultural meanings of objects based on anthropological methods. Students will acquire the ability to use material culture as a means of understanding everyday life historically, as well as contexts for the exhibition and interpretation of material objects in contemporary public contexts.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "掌握理解物質文化的理論與方法",
      "describe_en": "Comprehend the theories and methods of material studies"
    },
    {
      "seq": 2,
      "describe_ch": "將物件詮釋能力應用於收藏展示等工作",
      "describe_en": "Reflect on the interpretation of objects in museum and other collecting contexts."
    }
  ],
