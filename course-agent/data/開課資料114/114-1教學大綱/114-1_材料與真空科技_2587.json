  "description": {
    "sub_id3": null,
    "sub_name": "材料與真空科技",
    "sub_ename": "MATERIALS AND VACUUM SCIENCE & TECHNOLOGY",
    "describe_ch": "本課程涵蓋三大面向：(一)全系列的真空技術實務，包含基礎概論與真空系統工程、表面釋氣行為、材料與真空元件。(二)鍍膜與應用。(三)綠色工程、材料與真空。除了授課以外，亦將進行臨場實作與說明，俾使學生能具備材料、真空及綠能三者兼備之知識與能力。",
    "describe_eh": "This course covers three main themes: (a) the whole topics of practical vacuum technology, including vacuum fundamental, surface outgassing behavior, materials and vacuum components, (b) coatings and applications, and (c) green engineering, materials and vacuum. The aim of this course is for the students to gain multidiscipline experiences of materials, vacuum and green engineering.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解真空的基礎學理\t",
      "describe_en": "To understand fundamental vacuum theories"
    },
    {
      "seq": 2,
      "describe_ch": "理解各種真空幫浦分類、選用及操作\t",
      "describe_en": "To understand classification, choice and operation of various vacuum pumps"
    },
    {
      "seq": 3,
      "describe_ch": "了解各種真空計的種類與選用時機\t",
      "describe_en": " To understand the types and choice conditions of various gauges"
    },
    {
      "seq": 4,
      "describe_ch": "建構出真空鍍膜系統架構與分類\t",
      "describe_en": "To establish and to classify the vacuum system"
    }
  ],
