    "sub_name": "土木深度實習",
    "sub_ename": "IN-DEPTH INTERNSHIP FOR CIVIL ENGINEERING",
    "describe_ch": "本課程提供學生整個學期在業界實習達成實務接軌的目的，整合理論與實務，強化學生專業技能，提升未來就業競爭力。",
    "describe_eh": "This course offers students an opportunity to work off-campus from beginning to the end of a semester. The purpose of this course is multifold in order to integrate the theory and practice, strengthen the professional skills, and improve the competitiveness of students.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 9.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備整合理論與實務的能力。",
      "describe_en": "Possess ability to integrate the theory and practice."
    },
    {
      "seq": 2,
      "describe_ch": "具備協調溝通與團隊合作之能力。",
      "describe_en": "Possess ability to engage in effective communication and strategies of teamwork."
    },
    {
      "seq": 3,
      "describe_ch": "具備終身學習、專業倫理及社會責任的基本素養。",
      "describe_en": "Possess the basic literacy of life-long learning, industry ethics and social responsibilities."
    }
