  "description": {
    "sub_id3": null,
    "sub_name": "水文分析與模式應用",
    "sub_ename": "HYDROLOGIC ANALYSIS AND MODEL APPLICATION",
    "describe_ch": "本課程主要目標，係利用各式計算方法量化水文現象發生後之影響。課程內容主要分三個部分：(1).降雨特性分析，並推估集水區降雨之總量與時間分佈；(2).漫地流運動機制，及其水理變量之推估；(3).降雨逕流系統關聯分析，及其各式數學模式之建構與應用模擬。",
    "describe_eh": " Hydrologic analysis is treated in three parts, which emphasize computational method in hydrology for specific tasks such as precipitation estimating, overland flow modeling, and rainfall-runoff modeling.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.      能描述降雨－逕流物理機制\t",
      "describe_en": "1. Describe rainfall-runoff relationship and mechanism\r\n"
    },
    {
      "seq": 2,
      "describe_ch": "2.      學習水文分析之設計方法與流程",
      "describe_en": "\t2. Learn various methods and the procedure for hydrologic analysis\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "3.      推估與分析降雨在集水區形成的漫地流及集水區之出流量\t",
      "describe_en": "3. Analyze and infer the overland flow and runoff from rainfall event \r\n"
    },
    {
      "seq": 4,
      "describe_ch": " 4.      運用小組分工合作進行渠道洪水流量實例演算\t\r\n\t",
      "describe_en": "4. Perform design flood analysis and flow routing for field case by team work \r\n\t\r\n"
    }
  ],
