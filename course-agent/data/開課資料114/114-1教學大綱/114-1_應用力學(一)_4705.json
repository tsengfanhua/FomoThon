  "description": {
    "sub_id3": null,
    "sub_name": "應用力學(一)",
    "sub_ename": "APPLIED MECHANICS(1)",
    "describe_ch": "應用力學是描述及預測力作用於剛體的現象或結果，分為靜力學與動力學。應用力學(一)為靜力學，是分析剛體受外力作用時能達到力平衡而維持靜止的條件。本課程為材料(彈性體)力學的預備課程，並為設計承載結構等工程應用之基礎。\r\n",
    "describe_eh": "Applied Mechanics is a physical science which describes and predicts the results of rigid bodies under action of forces. It is divided into statics and dynamics. Applied Mechanics (1) deals with statics which analyzes the conditions of equilibrium or rest of rigid bodies under action of forces. This course is a pre-work of mechanics of deformable bodies, and provides as a foundation in structural engineering design. Engineering Mechanics is that physical science which deals with the state of rest or motion of bodies under the action of forces.  It plays the greatest role in engineering analysis and is an absolute prerequisite for work in most engineering fields.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解並說明力學的基本觀念，包括空間、時間、質量、力。",
      "describe_en": "Understand and be able to explain the basic concepts used in mechanics, including space, time, mass, and force."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明質點與剛體在應用力學上的定義與它們在工程應用上的差異。",
      "describe_en": "Understand and be able to explain the definition of particles and rigid bodies. Also, be able to explain the difference between particle and rigid body in engineering application."
    },
    {
      "seq": 3,
      "describe_ch": "逐步建立將應用力學(包括靜力學與動力學)基本觀念應用於工程分析的基礎能力。",
      "describe_en": "Develop the ability of employing the basic concepts of mechanics, including statics and dynamics, in engineering analysis."
    },
    {
      "seq": 4,
      "describe_ch": "逐步建立將工程分析，利用數學工具，如座標系、向量、代數、微積分，轉變為可解析的數學模型的能力。",
      "describe_en": "Develop the ability of adopting mathematics (e.g. coordinates, vectors, algebra, calculus, etc.) to transfer engineering problem into solvable mathematical model."
    }
  ],
