  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CI02129",
    "sub_id": "13600",
    "scr_dup": "001",
    "tpa_score_new": null,
    "tpa_score_new_en": null,
    "course_pol": "請同學準時到教室上課，切勿遲到早退。\n上課期間禁止使用手機於課堂學習以外用途，如：通訊軟體聊天、看影片、玩遊戲等。\n上課期間保持安靜，專心聽講，勿相互交談、聊天，影響上課秩序。\n請注意教室環境整潔，下課離開教室請勿留下個人物品。",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<ol>\n\t<li>嚴禁作業抄襲與考試舞弊。</li>\n\t<li>作業不可抄襲其他同學作業、或網路解答，違者視為作業抄襲，該次作業以0分計算。發生三次作業抄襲者，本學期作業成績以0分計算。</li>\n\t<li>考試不可參閱未允許之資料，或其他人的解答，違者視為舞弊，該次考試以0分計算，情節嚴重者送校規處分。</li>\n</ol>\n",
    "ais_meno_en": null,
    "ilearn_mk": null
  },
