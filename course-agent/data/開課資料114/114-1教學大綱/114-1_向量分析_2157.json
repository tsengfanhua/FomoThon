  "description": {
    "sub_id3": null,
    "sub_name": "向量分析",
    "sub_ename": "VECTOR ANALYSIS",
    "describe_ch": "使學生瞭解向量分析的相關技巧，含基本運算、不同座標系統及各類向量分析衍伸定理，使學生對向量系統具備分析能力，熟悉各類向量運算及定理並對未來電磁學及微波奠定基礎。",
    "describe_eh": "The objective of this course is to demonstrate the related analysis technology of vector. The course includes the introduction vector theorems. This course makes students to have the analysis ability of vector function. In addition, the theory of vector function helps students go into the world of electromagnetism and microwave.",
    "pre_subname": "CEM1006微積分",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道向量、向量場、純量場與各類空間座標系統",
      "describe_en": "Knowledge for vector, vector field, scalar field, and different coordinated system."
    },
    {
      "seq": 2,
      "describe_ch": "理解並說明各類向量運算",
      "describe_en": "To comprehend all kinds of vectors calculations."
    },
    {
      "seq": 3,
      "describe_ch": "應用向量運算求標度、散度及效度",
      "describe_en": "To apply the vector calculation in gradient, divergence and cure."
    }
  ],
