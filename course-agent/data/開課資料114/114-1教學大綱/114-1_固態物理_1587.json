  "description": {
    "sub_id3": null,
    "sub_name": "固態物理",
    "sub_ename": "SOLID STATE PHYSICS",
    "describe_ch": "介紹晶體的結構, X-光反射與倒晶格的關係,晶體的結合能, 聲子的色散關係、熱容量與熱傳導,自由電子熱容量與電傳導,晶體電子能帶的來源。",
    "describe_eh": "The materials covered are the crystal structures, the relation between X-ray diffraction and the reciprocal lattice vectors, the crystal binding energy, phonon's dispersion relation, heat capacity and thermal conductivity, free electron's heat capacity and electrical conductivity, the origin of energy bands in the crystal.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解晶體結構及晶體內聲子和電子的性質，以加強學生對半導體物理的了解。",
      "describe_en": "To comprehend the crystal structures and the properties of phonons and electrons in the crystal in order to enhance students’ understanding of semiconductor physics."
    },
    {
      "seq": 2,
      "describe_ch": "綜合並加強學生用數學分析來解決物理問題的能力。",
      "describe_en": "To synthesize and strengthen using mathematical analysis to solve physical problems."
    }
  ],
