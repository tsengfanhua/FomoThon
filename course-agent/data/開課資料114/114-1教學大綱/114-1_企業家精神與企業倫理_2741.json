  "description": {
    "sub_id3": null,
    "sub_name": "企業家精神與企業倫理",
    "sub_ename": "ENTREPRENEURSHIP AND BUSINESS ETHICS",
    "describe_ch": "本課程讓學生熟悉並探討創業家精神之內涵及其對產業發展之影響與重要性，同時，瞭解企業倫理的意義、法則，以及企業內有那些應遵守的倫理規範，使學生在各個相關產業能成為有效的管理者，並促使企業經營者能瞭解企業永續經營的原則，以增進未來從事產業經營管理之能力。",
    "describe_eh": "This course allows students to be familiar with and explore entrepreneurship and its influence and importance on industrial development. At the same time, understand the meaning and rules of corporate ethics, and the ethical norms that should be followed in the company, so that students can become effective managers in industries, and encourage corporate operators to understand the principles of sustainability, so as to enhance the ability to engage in industrial management in the future.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "分析創業家精神之內涵及其對產業發展之影響與重要性　\t",
      "describe_en": "Analyze the concept of entrepreneurship and the influence on industry develop."
    },
    {
      "seq": 2,
      "describe_ch": "分析企業倫理的意義、法則，並應用於不同產業中\t",
      "describe_en": "Analyze the meaning the rule of enterprise ethics and utilize in different industries."
    }
  ],
