  "description": {
    "sub_id3": null,
    "sub_name": "決策支援系統與企業智慧專題",
    "sub_ename": "SPECIAL TOPICS ON DECISION SUPPORT SYSTEMS AND BUSINESS INTELLIGENCE",
    "describe_ch": "本課程將介紹各種決策支援系統與企業智慧工具如Excel Solver、Power BI與Weka等的使用，讓學生以實務案例建構各種相關應用。",
    "describe_eh": "This course will introduce the utilization of various decision support systems and business intelligence tools such as Excel Solver, Power BI, and Weka. Students will construct various relevant applications through practical case studies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂決策支援系統與企業智慧",
      "describe_en": "A.\tEnabling students to articulate their own interpretations of decision support systems and business intelligence."
    },
    {
      "seq": 2,
      "describe_ch": "能夠選擇、應用適當的決策支援工具解決實務問題並有效解釋結果。",
      "describe_en": "B.\tEnabling students to select, apply appropriate decision support tools to solve practical problems, and effectively interpret the results."
    },
    {
      "seq": 3,
      "describe_ch": "能以書面或口頭方式將所學與同儕及教師溝通、說明提呈結果",
      "describe_en": "C.\tEmpowering students to communicate, explain, and present their learning outcomes to peers and instructors in written or oral form."
    }
  ],
