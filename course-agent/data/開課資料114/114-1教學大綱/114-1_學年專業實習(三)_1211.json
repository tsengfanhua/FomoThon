  "description": {
    "sub_id3": null,
    "sub_name": "學年專業實習(三)",
    "sub_ename": "YEAR-LONG INTERNSHIP(3)",
    "describe_ch": "本課程為遴選學生提供至產業進行實務訓練的機會。旨在加強理論與實務的整合，以強化學生專業技能，提升未來就業競爭力。",
    "describe_eh": "The course is designed to offer students who are recommended a value-added opportunity to include work training as part of their study. It aims to integrate the theory and practice in order to strengthen the professional skills and the competitiveness of students.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生基礎理論與實務的整合。",
      "describe_en": "To integrate the theory and practice for students."
    },
    {
      "seq": 2,
      "describe_ch": "強化學生專業技能，具備協調溝通與團隊合作之能力。",
      "describe_en": "To strengthen students' professional skills and engage in effective communication and strategies of teamwork."
    },
    {
      "seq": 3,
      "describe_ch": "具備終身學習、專業倫理及社會責任的基本素養。",
      "describe_en": "To possess the cultivation of life-long learning, industry ethics and social responsibilities"
    }
  ],
