  "description": {
    "sub_id3": null,
    "sub_name": "數位系統設計",
    "sub_ename": "DIGITAL SYSTEM DESIGN",
    "describe_ch": "學習使用硬體描述語言(HDL) – Verilog，並承襲邏輯設計之基礎，更深入探討組合網路及次序網路模組之設計，包括：系統功能、擴充能力、介接轉換、速度/面積之改善；快速運算單元原理與設計，複雜數位系統的RTL層級的演算狀態機(ASM)設計法，為數位電路設計奠定基礎。",
    "describe_eh": "Learn to use the hardware description language (HDL)-Verilog, and inherit the basis of logic design, and explore the design of the combined network and sequential network modules, including system functions, expansion capabilities, interface conversion, speed/area Improvement, the principle and design of fast arithmetic units, and the RTL-level arithmetic state machine (ASM) design method of complex digital systems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道數位系統的各式設計方法。",
      "describe_en": "Know the different design methods of the digital system."
    },
    {
      "seq": 2,
      "describe_ch": "理解數位系統的設計藉助狀態圖或狀態機圖。",
      "describe_en": "Comprehend the design of the digital system using the state graph or the state machine (SM) chart."
    }
  ],
