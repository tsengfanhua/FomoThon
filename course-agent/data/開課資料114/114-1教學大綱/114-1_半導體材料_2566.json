  "description": {
    "sub_id3": null,
    "sub_name": "半導體材料",
    "sub_ename": "SEMICONDUCTOR MATERIALS",
    "describe_ch": "以半導體材料為核心的電子材料已成為發展資訊工業與科技產業的重要基盤。課程中將介紹半導體材料的特性、類別、發展沿革、物理基礎、製備方法和技術、引導學生了解奈米尺寸半導體材料的性質以及新穎性半導體材料(如量子點、2維半導體、寬能隙半導體)的發展現況與趨勢，提供為涉及固態電子元件學習必要且完整的半導體材料知識。",
    "describe_eh": "Semiconductor materials have become an important foundation for the development of the information and technology industries. This course will explain the characteristics, categories, development history, physical basis, preparation methods and technology of semiconductor materials, and guide students to understand the properties of nano-size semiconductor materials and novel semiconductor materials (such as quantum dots, 2-dimensional semiconductors, wide band-gap semiconductors), development status and trends. It will provide complete knowledge of semiconductor materials for studying the solid-state electronic devices.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "啟發對半導體材料物理性質及在固態元件應用的興趣",
      "describe_en": "Interest in the physical properties of semiconductor materials and their applications in solid-state components."
    },
    {
      "seq": 2,
      "describe_ch": "理解半導體的能帶結構、載子傳輸特性與雜質雜對電性的影響",
      "describe_en": "Understand the energy band structure of semiconductors, carrier transport characteristics, and influence of impurities on electrical properties."
    },
    {
      "seq": 3,
      "describe_ch": "理解半導體接面特性及學習二極體與場效電晶體基本原理",
      "describe_en": "Understanding the characteristics of semiconductor junctions and learning the basic principles of diodes and field-effect transistors."
    }
  ],
