  "description": {
    "sub_id3": null,
    "sub_name": "土地開發法制與實務",
    "sub_ename": "PRACTICES OF LAND DEVELOPMENT AND LAWS",
    "describe_ch": "本課程主要在協助學生了解土地資源之利用與管理法制，包括環境資源的合理利用、國土計畫、區域計畫、都市計畫等法制、都市更新、土地重劃、土地徵收等，就土地開發之個案與土地開發法制做討論與分析。",
    "describe_eh": "This course is mainly to help students understand the use and management of land resources legal system, for rational use environmental resource, land planning, regional planning, urban planning and other legal systems. Besides, also including urban renewal, land redraw and land acquisition, etc. This course also discuss and analysis the land development cases and land development legal system.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解及適用土地開發法規之能力",
      "describe_en": "Understand and apply the land development regulations"
    },
    {
      "seq": 2,
      "describe_ch": "可得出解決土地開發專業問題方案之能力",
      "describe_en": "The ability to address the program on land development expertise"
    },
    {
      "seq": 3,
      "describe_ch": "具備土地規劃、技術整合與應用能力",
      "describe_en": "To provided with land planning, technology integration and application capacity"
    },
    {
      "seq": 4,
      "describe_ch": "具備邏輯思考及推理之能力",
      "describe_en": "To provided with thinking and reasoning"
    }
  ],
