  "description": {
    "sub_id3": null,
    "sub_name": "高等半導體物理",
    "sub_ename": "ADVANCED SEMICONDUCTOR PHYSICS",
    "describe_ch": "對半導體及其元件的相關物理特性做進一步的探討，提供對日益縮小的元件及電路提供預測及研究的方法。內容包括半導體基本特性、半導體接面、P-N 接面的特性、雙載子接面電晶體、金氧半電容及金氧半場效電晶體、及超大型積體電路中的場效電晶體。",
    "describe_eh": "To make a further study on the related physical characteristics of semiconductor and its devices and provide the way of study and broadcast for the miniature devices and circuits. The content is a survey of basic properties of semiconductors, semiconductor contacts, properties of P-N junctions, bipolar junction transistors, MOS capacitor and MOSFETs, and MOSFETs in VLSI.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能深入理解半導體物理特性，及其應用於電子工程(包括製程與電?設計)之知識\t",
      "describe_en": "To further comprehend the physical characteristics of semiconductors, and the application of semiconductor on electronic engineering (including processing and circuit design)"
    },
    {
      "seq": 2,
      "describe_ch": "能綜合相關輔助工具、獨立思考、或團隊合作方式完成指派作業。",
      "describe_en": "To synthesize the aided tool, thinking by oneself, or by team work to solve the homework assignment."
    },
    {
      "seq": 3,
      "describe_ch": "能理解半導體元件在縮小化過程中所碰到的問題及思考解決方法的知識。",
      "describe_en": "To comprehend the problems existing in the miniature semiconductor devices and comprehend how to collect information for figuring out the solution.\r\n"
    },
    {
      "seq": 4,
      "describe_ch": "能分析半導體物理知識內容進而提出專題報告。",
      "describe_en": "To analyze the physics of semiconductor and to propose the special-topic report."
    }
  ],
