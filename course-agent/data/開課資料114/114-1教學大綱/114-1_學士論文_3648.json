  "description": {
    "sub_id3": null,
    "sub_name": "學士論文",
    "sub_ename": "THESIS",
    "describe_ch": "學生選定一位指導教授進行專題研究，專題研究的工作內容如下：(1)蒐集文獻並回顧與研究方向相關之議題後提出研究題目；(2)深化討論研究題目之目的及可行性；(3)擬定可行之實驗步驟及相關分析法並進行實驗；(4)彙整分析實驗結果並討論；(5)撰寫畢業論文;(6)口試。",
    "describe_eh": "Students select an adviser for studying a specific topic.  They need to complete a thesis and pass an oral examination before graduation.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "執行實驗、蒐集研究數據與總結論文成果的能力\t\r\n",
      "describe_en": "Specify the capability of conducting experiment, obtain data and summarize results"
    },
    {
      "seq": 2,
      "describe_ch": "培養學生明辨、構思及解決問題的能力\t",
      "describe_en": "Train the capability of distinguishing, conceiving, and solving problems."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生認識學術倫理及自我管理之能力\t",
      "describe_en": "Understand the academic ethics and train the capability of self-management"
    }
  ],
