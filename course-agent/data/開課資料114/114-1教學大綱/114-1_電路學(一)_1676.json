  "description": {
    "sub_id3": null,
    "sub_name": "電路學(一)",
    "sub_ename": "CIRCUIT THEORY(1)",
    "describe_ch": "電路是現代科技基本架構中不可或缺的一環。因此，本課程主要的內容在於介紹電路上的基本線性元件：電壓源、電流源、電阻、電容器、電感器、運算放大器等，以及電路定理與分析技巧。本課程電路分析的重點著重在直流電路分析上。",
    "describe_eh": "Electronic circuits are part of the basic fabric of modern technology. The main contents of this course are on the introduction of basic linear elements of the electronic circuits: voltage sources, current sources, resistors, capacitors, inductors and operational amplifiers. Circuit theorems and the technics of circuit analysis are also introduced. The circuit analysis is focused on the dc circuits in this course.",
    "pre_subname": "IEE1010普通物理-電、磁、光",
    "pre_sub_id3": "IEE1010",
    "pre_sub_ename": "IEE1010 GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
