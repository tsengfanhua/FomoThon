  "description": {
    "sub_id3": null,
    "sub_name": "都市防災規劃",
    "sub_ename": "SPECIFIC SEMINAR ON URBAN DISASTER MITIGATION PLANNING",
    "describe_ch": "防災規劃和設計程序可以減少災難的脆弱性，進而提高環境中各個階段適應能力(例如：減災，整備，應變和復原)。因此，在這個學期，我們將介紹自然災害，人為災害，人類居住模式，土地利用決策，立法等方面的知識",
    "describe_eh": "Disaster-prevention planning and design processes can help reduce disaster vulnerabilities and increase resilience in the environments (such as: Disaster mitigation, preparation, response, and recovery). Therefore, in this semester, we will introduce the knowledge of natural disasters, human-made disasters, human settlement patterns, land-use decisions, and legislation etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解災害管理與可實際落實的技術",
      "describe_en": "Comprehend the right concept and technology skill of disaster management"
    },
    {
      "seq": 2,
      "describe_ch": "能應用減少災害分析工具在防災規劃和設計程序當中",
      "describe_en": "Apply the reduce disaster analysis tools in disaster-prevention planning and design processes"
    },
    {
      "seq": 3,
      "describe_ch": "能綜合災害管理所需的專業技術",
      "describe_en": "Synthesize the technology of construction planning and disaster management"
    }
  ],
