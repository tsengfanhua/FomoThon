  "description": {
    "sub_id3": null,
    "sub_name": "分析化學實驗",
    "sub_ename": "ANALYTICAL CHEMISTRY LAB.",
    "describe_ch": "本課程是針對環境工程和科學學系的學生所設計，特別是針對重要的化學分析原理中提供環工背景學生正確及嚴謹的化學理論觀念。這課程包含分析化學基礎的介紹、數據統計分析、各種化學分析法，沉澱滴定法、水溶液化學、活性係數、中和反應原理、錯化合物反應、電化學、氧化還原理論、分析實驗化學藥品、器材英文名稱熟記及操作。",
    "describe_eh": "A major objective of this curriculum is to provide a rigorous background in those chemical principles that are particularly important to the students of environmental engineering and science department.  The course is designed for analytical lab and the curriculum contents are (1) Introduction to analytical chemistry (2) Statistical evaluation of analytical data (3) Gravimetric methods of analysis (4) Titration methods of analysis (5) Aqueous solution chemistry (6) Activity and activity coefficient (7) Precipitation titration (8) Theory of neutralization titration (9) Titration curves for complex acid/base systems (10) Application of neutralization titration (11) Complex-formation titration (12) Theory of oxidation/reduction titration (13) Complex-formation titration (14) Electrochemistry (15) The chemicals, apparatus, and unit experimental performance in analytical lab.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠按照步驟進行實驗、分析實驗數據、並從數據中歸納出合理的結論。\t",
      "describe_en": "know how to conduct experiments, analyze the experimental data, and draw the conclusions based on the results."
    },
    {
      "seq": 2,
      "describe_ch": "能夠正確執行實驗器材和儀器的操作維護\t",
      "describe_en": "know how to perform and maintain the experimental equipment and instruments"
    },
    {
      "seq": 3,
      "describe_ch": "能夠透過分組實驗培養團隊溝通合作能力\t",
      "describe_en": "Develop communication and cooperation skills through group teamwork"
    },
    {
      "seq": 4,
      "describe_ch": "應用分析化學實驗所學之實驗技巧解決環境問題\t",
      "describe_en": "Solve environmental problems by applying the experimental skills learned in analytical chemistry experiments"
    },
    {
      "seq": 5,
      "describe_ch": "學習現行的環境檢測方法以及其查詢方法和適用範圍\t",
      "describe_en": "Learn the current environmental analytical methods, how to search the methods, and the scope of applications"
    },
    {
      "seq": 6,
      "describe_ch": "理解學術倫理以及不當研究行為的嚴重性\t",
      "describe_en": "Understand academic ethics and the seriousness of research misconduct"
    }
  ],
