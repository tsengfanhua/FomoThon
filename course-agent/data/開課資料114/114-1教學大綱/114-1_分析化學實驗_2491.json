  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CS02121",
    "sub_id": "08150",
    "scr_dup": "001",
    "tpa_score_new": "<div>1. 平時成績 : 15% 2. 實驗小考 : 10% 3. 實驗報告 : 30% 4. 操作考試 : 20% 5. 期末考試 : 25%</div>\n",
    "tpa_score_new_en": " ",
    "course_pol": "•實驗課不得無故遲到以及曠課。\n•實驗課必須依照規定穿著個人防護裝備。\n•實驗室嚴禁飲食，所有食物禁止帶入實驗室。\n•實驗進行中禁止擅自離開實驗室。\n•實驗室化學藥品和器材嚴禁擅自攜出實驗室。",
    "course_pol_en": null,
    "course_rem": "•請務必按照實驗室安全規範進行實驗。\n•請自備個人用實驗衣和護目鏡。",
    "course_rem_en": null,
    "ais_meno": "<div>\n<div>\n<div>\n<div>\n<div>實踐學術誠信是老師和學生的共同責任，作弊、抄襲、造假、代簽到、代寫等違反學術誠信的行為是不被允許的，修課同學應該了解並遵守學術誠信原則。</div>\n</div>\n</div>\n</div>\n</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": "N"
  },
