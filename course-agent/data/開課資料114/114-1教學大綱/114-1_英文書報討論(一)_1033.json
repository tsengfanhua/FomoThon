  "description": {
    "sub_id3": null,
    "sub_name": "英文書報討論(一)",
    "sub_ename": "REVIEW ON TECHNICAL WRITINGS(1)",
    "describe_ch": "本課程使學生熟悉查詢英文科技論文之方法，如何從關鍵字句閱讀科技論文、如何標示出文章之綱要重點及結構，以提升學生之英文科技論文閱讀能力。",
    "describe_eh": "The class teaches students the skills of technical writing and reading. From the sentence structure, grammar, to context layout, the students will learn the fundamental skills of completing a technical article. The goal of class is to enhance student’s ability of English reading and writing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠經由關鍵字詞找出重要之英文參考文獻。",
      "describe_en": "Using keywords to find useful references."
    },
    {
      "seq": 2,
      "describe_ch": "能夠歸納所閱讀英文文章中之關鍵字詞",
      "describe_en": "Learning to summarize the keywords of an article."
    },
    {
      "seq": 3,
      "describe_ch": "能以英文整理任一科技論文之重點並製作文章架構圖",
      "describe_en": "Highlighting the key points of a technical article."
    }
  ],
