  "description": {
    "sub_id3": null,
    "sub_name": "博士論文(一)",
    "sub_ename": "DOCTORAL THESIS (1)",
    "describe_ch": "本課程以產學實務應用為主軸。透過本課程訓練，學生可以整合及驗證所學之專業知識、技能、相關校內實作經驗；以及培養團隊合作及溝通等軟技能，減少理論與實務之差距。產學應用成果可以延伸為博士論文。",
    "describe_eh": "This course is designed to help students apply professional knowledge of related business and management theories in real business problem application with industry partners. Students decide their topics based on their own ideas or suggestions from the industry. Through this course, students are able to integrate knowledge learned in the study of topic selected and provide applicable business solution. The results of the course can be extended to part of doctoral thesis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解論文研究主題的能力",
      "describe_en": "Recognize the issue of study."
    },
    {
      "seq": 2,
      "describe_ch": "綜合及應用所學的知識與分析工具進行研究分析",
      "describe_en": "Utilize the knowledge and the analytical tools that students have learned in conducting a research."
    },
    {
      "seq": 3,
      "describe_ch": "論文的參考文獻展現相關研究議題的國際理解",
      "describe_en": "The literature review of the thesis demonstrates the international awareness on the topic of research"
    },
    {
      "seq": 4,
      "describe_ch": "適切應用資訊科技的相關軟體輔助研究",
      "describe_en": "Appropriately apply the soft-wares of information technology to facilitate the research."
    }
  ],
