    "tpc_seq": 1,
    "tpc_book": "<table cellspacing=\"0\" style=\"border-collapse:collapse\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"border-bottom:2px; border-left:5px; border-right:5px; border-top:2px; width:693px\">\n\t\t\t<div><strong>教學網頁或數位教材</strong></div>\n\n\t\t\t<ol>\n\t\t\t\t<li><strong>iLearn</strong><strong>教學網站</strong></li>\n\t\t\t\t<li><strong>作曲家及作品網路資訊</strong></li>\n\t\t\t</ol>\n\n\t\t\t<table align=\"center\" cellspacing=\"0\" style=\"border-collapse:collapse\">\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"border-bottom:1px solid black; border-left:none; border-right:1px solid black; border-top:none; height:22px; vertical-align:top\">&nbsp;</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\n\t\t\t<div><strong>天河神水(逢甲原創音樂劇)</strong></div>\n\n\t\t\t<div><strong>音樂劇源起</strong></div>\n\n\t\t\t<div>\n\t\t\t<div><strong>The King and I 國王與我</strong></div>\n\n\t\t\t<div><strong>Cinderella</strong></div>\n\t\t\t</div>\n\n\t\t\t<div><strong>1960年代&nbsp;West Side Story 西城故事</strong></div>\n\n\t\t\t<div><strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; The Sound of Music 真善美</strong></div>\n\n\t\t\t<div><strong>1980年代&nbsp; The Phantom of the Opera 歌劇魅影</strong></div>\n\n\t\t\t<div><strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;The Little Mermaid 小美人魚</strong></div>\n\n\t\t\t<div><strong>1990年代&nbsp;&nbsp;Beauty and the beast 美女與野獸</strong></div>\n\n\t\t\t<div><strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;The Lion King</strong></div>\n\n\t\t\t<div><strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;Mamma mia 1-2</strong></div>\n\n\t\t\t<div><strong>2000年代&nbsp;&nbsp;</strong><strong>Notre Dame 鐘樓怪人</strong></div>\n\n\t\t\t<div><strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp; High School musical 1 2 3</strong></div>\n\n\t\t\t<div><strong>2010年代至今&nbsp;</strong></div>\n\n\t\t\t<div><strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;Frozen