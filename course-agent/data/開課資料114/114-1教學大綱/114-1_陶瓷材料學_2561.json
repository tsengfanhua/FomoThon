  "description": {
    "sub_id3": null,
    "sub_name": "陶瓷材料學",
    "sub_ename": "CERAMIC MATERIALS",
    "describe_ch": "探討陶瓷材料的組成、晶體結構、特性及應用。介紹化學鍵與化學鍵結機理、晶體與非晶性質、基本陶瓷晶體結構與分類、傳統與先進陶瓷材料種類與應用。幫助學生了解氧化物、碳化物、氮化物性與製程基本原理以燒結與檢測方法為例、陶瓷機械性質與韌化機理以高溫陶瓷與陶瓷引擎為例。讓學生熟悉陶瓷材料發展趨勢、市場與工業應用。",
    "describe_eh": "The composition, crystal structures, properties and application of traditional and advanced ceramics are given. Students will learn the concepts of chemical bonding, types of crystal structures, basic ceramic processing and characterization methods. The sintering, analytic methods of oxides, nitrides, carbides, and silicides will be discussed. Students will gain concepts on phase transformation toughening mechanism as well as novel developments of ceramic materials and their market trends.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解陶瓷材料之基礎原理，並熟悉常用之相關術語與定義或分野。",
      "describe_en": "To understand the fundamental aspects and theories of ceramic materials and to be familiar with the frequently used terminological terms and their definitions in this subject."
    },
    {
      "seq": 2,
      "describe_ch": "了解陶瓷材料之發展沿革及最新動態，並能實際體驗陶瓷材料之應用向面。",
      "describe_en": "To understand historical developments and technical frontiers for the ceramic materials as well as key concepts of the applications of ceramic materials in our daily life and industrial activities."
    },
    {
      "seq": 3,
      "describe_ch": "建立陶瓷材料領域之相關應用技術文獻及資料之解讀及研判能力。",
      "describe_en": "To apply the literature survey and review capability by accessing databases on ceramic materials with professional judgments."
    },
    {
      "seq": 4,
      "describe_ch": "了解如何使用各種陶瓷材料軟硬體資源所需之可行性概念或解決方案，以解決陶瓷材料技術性或學理之問題時。",
      "describe_en": "To understand available hardware and software resources to find the feasible options or solutions as facing the technical problems on ceramic materials."
    }
  ],
