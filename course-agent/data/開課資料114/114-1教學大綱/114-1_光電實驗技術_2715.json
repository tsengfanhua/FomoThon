  "description": {
    "sub_id3": null,
    "sub_name": "光電實驗技術",
    "sub_ename": "LASER OPTICS EXPERIMENTS AND TECHNIQUES",
    "describe_ch": "本課程宗旨為使學生認識與熟悉光電元件，並學習近代光電技術。內容包括實驗介紹講解、光電技術報告，小組實作專案與光學及光電元件進階實驗。",
    "describe_eh": "The teaching goal of this course intends to introduce the laser and optics elements and modern photonics techniques. In addition to the laboratory introduction, it also contains a photonics technology study, a team practice project and optics and photonics advanced experiments.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解光電元件及系統的原理及使用。",
      "describe_en": "Be able to understand the theory and operation of the optical and photonic elements and systems."
    },
    {
      "seq": 2,
      "describe_ch": "能使用並熟悉光電相關設備與元件及解決困難，而完成指定實驗及操作，且由實驗中歸納出適當結論。",
      "describe_en": "Be able to use the laboratory equipments and solve the difficulties to complete the experiment and draw the proper conclusions and systems."
    },
    {
      "seq": 3,
      "describe_ch": "能透過小組的實驗實作，展現團隊合作能力。",
      "describe_en": "Be able to perform team work through laboratory training."
    }
  ],
