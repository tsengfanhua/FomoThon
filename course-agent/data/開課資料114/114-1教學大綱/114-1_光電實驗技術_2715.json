    "scr_dup": "001",
    "tpb_seq": 1,
    "tpb_book": "<div>自編講義/內容含：&bull; 基礎光學 (1) The Michelson Interferometer (2) Fourier Optics 附錄實驗：(3) Aberration (4) Diffraction &amp; Interference &bull; 雷射基礎 (5) Resonance of Laser and Transverse Modes (6) Longitudinal Modes and Polarization Properties of Laser (7) Properties of Gaussian Beam &bull; 光電元件 (8) Acoustooptic Modulator (9) Electrooptic Modulator 2022/&bull; 全像術 (10) Holography &bull; 光纖基礎 (11) Numerical Aperture &amp; Attenuation of Fiber &bull; 半導體雷射特性 (12) Characteristics of Diode Laser &bull; 非線性光學 (13) Second Harmonic Generation &bull; 訊號處理 (14) Signal recovery with Lock-in Amplifier</div>\n",
    "tpb_book_en": " "
  },
  "readings": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CS06310",
    "sub_id": "13574",
    "scr_dup": "001",
    "tpc_seq": 1,
    "tpc_book": "<div>\n<div>1.F. A. Jenkins and H. E. White, Fundamentals of Optics, McGrawl-Hill</div>\n\n<div>2.E. Hecht, Optics, 4th ed., Addison Wesley, 2002</div>\n\n<div>3.M. Born &amp; E. Wolf, Principles of Optics, Pergamon, 6th ed.</div>\n\n<div>4.G. Fowles, Introduction to Modern Optics, Holt, Rinehart &amp; Winston (Now: Dover) 1968</div>\n\n<div>5.R. S. Longhurst, Geometric and Physical Optics, Wiley, 1967</div>\n\n<div>6.A. Yariv, Quantum Electronics, 3rd ed. , Wiley</div>\n\n<div>7.J. T. Verdeyen, Laser Electronics, 3rd ed., Prentics Hall</div>\n\n<div>8.J. W. Goodman, Introduction to Fourier Optics, McGrawl-Hill</div>\n\n<div>&nbsp;</div>\n\n<div>9.J. Hecht, Understanding Fiber Optics, 4th ed., Pretice Hall</div>\n</div>\n",
    "tpc_book_en": null
  },
