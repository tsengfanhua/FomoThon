  "description": {
    "sub_id3": null,
    "sub_name": "材料力學",
    "sub_ename": "MECHANICS OF MATERIALS",
    "describe_ch": "本課程旨在探討結構物受外力作用，在構件內產生之應力、應變的大小變化及構件的變位、破壞等現象。主要內容包括構件的應力、應變，材料的力學性質，扭轉、彎矩及剪力的外力作用，應力及應變轉換，以及梁的撓曲變位、柱之挫曲等。",
    "describe_eh": "This course investigates the stress, strain, deflection and rupture in the member of structure as external force acted on. The content includes stress and strain, mechanical properties of materials, external force action as torsion, bending moment and shear force, stress and strain transformation, beam deflection, and column buckling etc.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)、ENGS1006應用力學",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)、ENGS1006 APPLIED MECHANICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識材料的力學性質。",
      "describe_en": "1.\t1.To recognize the mechanical properties of materials."
    },
    {
      "seq": 2,
      "describe_ch": "建構應力應變、剪應力剪應變之理論。\n",
      "describe_en": "2. To construct the relation between stress and strain, shear stress and shear strain, and derive the stress of member exerted by bending moment, torsion and shear force."
    },
    {
      "seq": 3,
      "describe_ch": "理解應力及應變之轉換。 \t",
      "describe_en": "3.To understand the stress strain transformation."
    },
    {
      "seq": 4,
      "describe_ch": "熟悉梁之撓曲現象及計算。 \t",
      "describe_en": "4.4. To learn the concept and computing skill regarding beam deflection."
    }
  ],
