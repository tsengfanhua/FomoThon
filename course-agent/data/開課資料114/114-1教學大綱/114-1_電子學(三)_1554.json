  "description": {
    "sub_id3": null,
    "sub_name": "電子學(三)",
    "sub_ename": "ELECTRONICS(3)",
    "describe_ch": "本課程以含電子學(一)和電子學(二)為理論基礎，介紹基礎類比積體電路分析與應用，內容含：頻率響應、負回授放大器、功率放大器、運算放大器基本應用與多諧振盪器原理，讓學生對電子學和應用電子電路具有完整且較專業的知識與實務經驗。",
    "describe_eh": "This course is based on the theory of electronics (1) and electronics (2) and introduces basic analog integrated circuit analysis and applications. The content includes frequency response, negative feedback amplifier, power amplifier, operation amplifier, basic application, and multi-harmonics. The principle of oscillators allows students to have complete and professional knowledge and practical experience in electronics and applied electronic circuits.",
    "pre_subname": "ELEN2002電子學(一)、ELEN2003電子學(二)",
    "pre_sub_id3": "ELEN2002",
    "pre_sub_ename": "ELEN2002 ELECTRONICS(1)、ELEN2003 ELECTRONICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的語詞說明何謂負回授放大器、功率放大器，能夠描述負回授放大器結構與重要結構基本觀念、特性、相關原理與名詞定義。",
      "describe_en": "To know the basic structure and concepts about the fundamental circuit modules, such ad : negative feedback amplifier, frequency stability and output power amplifier, with their words."
    },
    {
      "seq": 2,
      "describe_ch": "能整合所學之電子學相關能力，描述、分析BJT/CMOS OPA線性積體電路結構與重要結構基本觀念、特性、相關原理與名詞定義。",
      "describe_en": "To synthesize all the basic ability learned before and can describe and analyze the structurecharacteristics and terms about BJT and MOS operation amplifiers."
    },
    {
      "seq": 3,
      "describe_ch": "對課程中相關議題的資訊，評估其適用性與分析其差異性。",
      "describe_en": "To evaluate the feasility for the information of related topics learned in the class and to analyze their differences."
    },
    {
      "seq": 4,
      "describe_ch": "能應用電路模擬軟體，利用電腦工具，執行所學電路功能與特性之模擬、驗證與偵錯。",
      "describe_en": "To apply the CAD-tools and professional S/W skillfully, to execute the process of simulation, verification and debugging."
    }
  ],
