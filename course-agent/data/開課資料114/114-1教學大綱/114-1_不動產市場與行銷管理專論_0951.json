  "description": {
    "sub_id3": null,
    "sub_name": "不動產市場與行銷管理專論",
    "sub_ename": "SPECIAL TOPIC OF REAL ESTATE MARKET RESEARCH AND MARKETING MANAGEMENT",
    "describe_ch": "該課程主要結合不動產市場研究與行銷管理，讓修課同學得以瞭解不動產市場研究之方法外，更結合行銷管理理論與策略行銷架構，將其應用在不動產開發的實務的課程。學習內容包含整體不動產市場分析、個別參與者的產業分析、趨勢定位、目標族群定位與市場區隔等。",
    "describe_eh": "The course is to combine real estate market research with market management. The purpose is to help students understand the market analysis of the method and its application and realize the theories of marketing management and strategic marketing in real estate industry. The contents will include the whole real estate market analysis, firm level of competitive analysis, trend positioning, identification of  target market, and sub-market segmentation, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
