  "description": {
    "sub_id3": null,
    "sub_name": "微處理機系統實習",
    "sub_ename": "THE EXPERIMENT OF MICRO-PROCESSOR SYSTEM",
    "describe_ch": "透過每週主題式的上機實習，使學生具備使用8051微處理器開發板與C語言程式設計的能力，並介紹其周邊支援的裝置與感測元件，了解微處理器的理論及實際應用。配合期末專題製作與發表，培養團隊合作、軟硬體系統整合、邏輯思考、發現問題與解決問題之能力。",
    "describe_eh": "The thematic hands-on practice will equip students with the ability to use 8051 microprocessor development boards and C language programming, introduce peripheral supporting devices and sensing components, and understand the theory and practical applications of microprocessors. Cooperate with the production and publication of final topics to cultivate teamwork, software and hardware system integration, logical thinking, problem discovery and problem solving skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.瞭解微處理機實驗設備之基本功能與知識",
      "describe_en": "1.Understanding the bsic function and knowledge of microprocessor instruments."
    },
    {
      "seq": 2,
      "describe_ch": "2.應用各種處理機實驗設備完成微處理機的測試與設計",
      "describe_en": "2.Application for the electronic instruments to microprocessor testing and design.."
    }
  ],
