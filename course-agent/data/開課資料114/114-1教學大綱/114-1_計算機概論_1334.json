  "description": {
    "sub_id3": null,
    "sub_name": "計算機概論",
    "sub_ename": "INTRODUCTION TO  COMPUTER AND COMPUTING",
    "describe_ch": "本課程的目標在於讓學生廣泛地認識電腦科學相關的主題，概述計算機中軟體與硬體相關的基本知識。",
    "describe_eh": "The objective of this class is to help students understand the topics related to the computer science, including the hardware issues and software issues.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "暸解作業系統、電腦網路、軟體工程與其軟硬體系統整合的基本概念",
      "describe_en": "Understand the basic concept of the operating system, the computer networks, software engineering, and the integration of software and hardware."
    },
    {
      "seq": 2,
      "describe_ch": "理解資料結構與資料處理之應用",
      "describe_en": "Realize the basic concept of the data structure and data processing."
    },
    {
      "seq": 3,
      "describe_ch": "了解其他計算機科學相關議題的知識，包含網路與資安",
      "describe_en": "Realize other issues of computers science, including network and security."
    }
  ],
