  "description": {
    "sub_id3": null,
    "sub_name": "雲端運算基礎",
    "sub_ename": "CLOUD FOUNDATION",
    "describe_ch": "本課程主要以實務應用的角度切入介紹雲端運算的基礎概念，並以Amazon Web Service為課程內容與學習平台，介紹基本雲端服務原理及架構、應用案例、與實務操作，包括AWS基礎系統架構、雲端資料庫服務、與資料查詢與分析工具等。",
    "describe_eh": "This course aims to provide a comprehensive overview of cloud computing and services with practical and business perspective. It mainly introduces the concepts of cloud computing/service, principles and architecture, use cases, and applications, which including AWS basic system architecture, cloud database services, data query and analysis tools and etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解雲端計算基本概念",
      "describe_en": "Understanding the concepts about cloud computing and services"
    },
    {
      "seq": 2,
      "describe_ch": "學習雲端運算與服務的基本操作能力",
      "describe_en": "Learning the essentials and basic skills of cloud services on AWS"
    },
    {
      "seq": 3,
      "describe_ch": "實現以雲端服務為基礎的實務應用",
      "describe_en": "Applying cloud service to the practical projects"
    }
  ],
