  "description": {
    "sub_id3": null,
    "sub_name": "專題研究(二)",
    "sub_ename": "SPECIAL TOPICS STUDY (2)",
    "describe_ch": "為訓練學生運用所學電子專業知識，應用於學術研究。體驗專案計畫之規劃程序，並學習論文之寫作技巧與要領。",
    "describe_eh": "This course is designed to encourage the students to organize the knowledge they have learned in the field of electronic engineering, to practice the key items in writing a scientific report, and to gain experience in executing a research program.",
    "pre_subname": "ELEN4926專題研究(一)",
    "pre_sub_id3": "ELEN4926",
    "pre_sub_ename": "ELEN4926 SPECIAL TOPICS STUDY (1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "基礎數理能力",
      "describe_en": "Basic mathematical theory"
    },
    {
      "seq": 2,
      "describe_ch": "實驗數據詮釋",
      "describe_en": "Interpretation of the experimental data"
    },
    {
      "seq": 3,
      "describe_ch": "基本電路、元件或半導體設計",
      "describe_en": "Basic circuit, device or semiconductor design"
    },
    {
      "seq": 4,
      "describe_ch": "瞭解計畫管理與技術論文及研發結果。",
      "describe_en": "To comprehend the project management, technical context and R&D results for electronic engineering projects."
    },
    {
      "seq": 5,
      "describe_ch": "問題分析與獨立思考能力",
      "describe_en": "Problem analysis and independent thinking ability"
    },
    {
      "seq": 6,
      "describe_ch": "專業道德認知",
      "describe_en": "Principles for professional ethics"
    },
    {
      "seq": 7,
      "describe_ch": "瞭解並應用課程內容並培養資料蒐尋能力，以整理勾勒出個人發展規劃。",
      "describe_en": "To comprehend, apply the course content and develop data collection ability in electronic engineering in order to outline personal development plan (PDP)."
    },
    {
      "seq": 8,
      "describe_ch": "瞭解軟硬體資源所需之可行性，以應用電子工程之相關技術文獻。",
      "describe_en": "To comprehend the feasibility of software and hardware resources in order to apply the relevant technical literature on electronic engineering."
    },
    {
      "seq": 9,
      "describe_ch": "理論與實務結合",
      "describe_en": "Combination of theory and practice"
    },
    {
      "seq": 10,
      "describe_ch": "知道如何撰寫與口語報告成果。",
      "describe_en": "To develop technical report writing  and oral presentation skills."
    }
  ],
