  "description": {
    "sub_id3": null,
    "sub_name": "工程材料試驗",
    "sub_ename": "ENGINEERING MATERIALS LABORATORY",
    "describe_ch": "本試驗課程係針對鋼筋混凝土之組成材料，做一系列的檢驗與測試。試驗內容包括混凝土配比設計所需之試驗資料、物理性質及力學行為。期許學生能經由各項試驗的進行，了解試驗目的、原理、儀器構造規格，並能依CNS試驗規範(或ASTM、AASHTO)之標準試驗步驟進行。",
    "describe_eh": "A series of tests on constitutive components of reinforced concrete will be performed in this class。Material tests on physical properties and mechanical behaviors will first be performed。Then a concrete mixture design will be verified via a simple compressive test on the cylindrical specimen。This course can make students understand the goal of material tests and know how to use test equipments appropriately。Also, this course can make students know how to follow CNS（or ASTM, AASHTO）standard procedure to accomplish material tests.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解工程材料基本的力學、物理及化學性質。",
      "describe_en": "Be able to understand the fundamental properties of mechanics, physics and chemistry of civil materials."
    },
    {
      "seq": 2,
      "describe_ch": "使用CNS或ASTM的方法，來應用混凝土材料試驗。",
      "describe_en": "Application to concrete material test by using CNS or ASTM standard procedure."
    },
    {
      "seq": 3,
      "describe_ch": "獲得測量、試驗、分析與詮釋數據之能力。",
      "describe_en": "To obtain the ability of survey, test, analysis，and the ability to explain test data."
    }
  ],
