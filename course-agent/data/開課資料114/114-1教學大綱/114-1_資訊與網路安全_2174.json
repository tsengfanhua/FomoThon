  "description": {
    "sub_id3": null,
    "sub_name": "資訊與網路安全",
    "sub_ename": "INFORMATION AND NETWORK SECURITY",
    "describe_ch": "資訊安全之議題，以環境觀點、使用者觀點、系統觀點、資料觀點、管理者觀點，以及法律觀點等六個不同層次觀點來考慮資訊安全架構。範圍包括實體安全、使用者辨識、存取控制、密碼學、管理控制，以及法律制裁等六大主題。",
    "describe_eh": "The issue of information security considers the information security framework from six different levels of viewpoints: environmental viewpoint, user viewpoint, system viewpoint, data viewpoint, manager viewpoint, and legal viewpoint. The scope includes six topics including physical security, user identification, access control, cryptography, management control, and legal sanctions.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉一些有效的安全工具並能辨識應用這些工具的時機與場合",
      "describe_en": " Knowledge of some powerful security tools and be able to distinguish when and where they can be applied"
    },
    {
      "seq": 2,
      "describe_ch": "能夠了解計算機系統與網路安全的重要性與影響. 能夠了解並描述常見的計算機系統與網路的弱點與安全威脅.",
      "describe_en": "Comprehension for the importance and effects of computer systems and network security. Be able to describe some common vulnerabilities and security threats of computer systems and network."
    }
  ],
