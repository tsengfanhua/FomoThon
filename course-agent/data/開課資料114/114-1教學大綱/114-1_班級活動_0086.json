  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB01111",
    "sub_id": "00001",
    "scr_dup": "001",
    "tpa_score_new": null,
    "tpa_score_new_en": null,
    "course_pol": "本課程以實體上課為主，教師期望學生能遵守以下課堂禮儀和行為規範：準時到達上課、尊重教師和同學、積極參與討論、遵守設定的課堂規則等。這些規範有助於營造良好的學習環境，促進有效的知識傳遞和互動。",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<div>期望學生在學習評量中展現誠信，遵守考試規則和作業要求。在班上互動時，尊重他人觀點，避免抄襲、偽造資料等不誠信行為。課程結束後，學生應尊重學術道德，避免未經授權使用他人作品。若發現學術不誠信，可能面臨處分，包括警告、扣分、退課或學術處分等，以維護學術公正和學習環境的健康。</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": "N"
  },
