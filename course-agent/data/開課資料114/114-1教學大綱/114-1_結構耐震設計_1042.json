  "description": {
    "sub_id3": null,
    "sub_name": "結構耐震設計",
    "sub_ename": "STRUCTURAL SEISMIC DESIGN",
    "describe_ch": "台灣位處環太平洋地震帶，地震活動頻繁，因此，座落在台灣之結構物，其設計必須足以承受地震之考驗。本課程闡述結構耐震設計之理論與實務，內容涵蓋地震之成原及其災害、強地動之特性、結構之耐震設計。",
    "describe_eh": "Taiwan is located in the Pacific Rim Seismic Belt, and seismic activity is frequent. Therefore, structures located in Taiwan must be designed to withstand earthquakes. This course expounds the theory and practice of seismic design of structures, covering the causes of earthquakes and their disasters, the characteristics of strong earthquakes, and the seismic design of structures.",
    "pre_subname": "CE2070結構學(一)",
    "pre_sub_id3": "CE2070",
    "pre_sub_ename": "CE2070 STRUCTURAL THEORY(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備運用與研發土木工程相關領域的專業知識及科技。",
