  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE01149",
    "sub_id": "37560",
    "scr_dup": "001",
    "sub_title": "最新趨勢的工程管理實務",
    "sub_title_en": null,
    "sub_describe": "透過學理與市場創新管理實務的結合，以案例式的引導教學或演練，盡可能地涵蓋營建管理全生命週期的議題，讓學生得以在校時就接觸與學成未來產業可接軌的專業技術基礎。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "創新工程管理實務",
    "sub_ename": "INNOVATIVE CONSTRUCTION MANAGEMENT PRACTICES",
    "describe_ch": "本課程主要針對現代營造管理的創新方法，並結合實務案例邀請相關業界專家學者們授課，課程內容涵蓋工程管理、品質與安全管理、創新技術應用、營造合約與風險控管等核心議題，藉由實地參訪與案例分析提升學生對工程管理的理解與應用能力。",
    "describe_eh": "This course focuses on innovative approaches to modern construction management, integrating practical case studies and lectures from industry experts. Key topics include project management, quality and safety management, innovative technology applications, construction contracts, and risk control. Site visits and case studies will enhance students’ understanding and application of construction management principles.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
