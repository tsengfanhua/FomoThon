  "description": {
    "sub_id3": null,
    "sub_name": "街區活化與聚落生態系",
    "sub_ename": "NEIGHBORHOOD REVITALIZATION AND ECOLOGICAL VILLAGES",
    "describe_ch": "本課程以「街區活化與聚落發展」作為課程主軸，期盼學生能夠瞭解傳統街區的文化、經濟與社會網絡的互動，學習調查街區獨特的地方文化記憶。透過社會設計的概念做為振興街區的基礎，環視街區的商店特色、交通、社會網絡的連結特徵，學生將透過創意行動規劃如何保存舊有的文化聚落，又將傳統的生活品味與新生活聚落結合，打造一個街區文化的聚落生態系。",
    "describe_eh": "Based on Neighborhood Revitalization and Village Development, the course encourages students to approach the culture of traditional neighborhoods and the interaction between the economy and social networks. It also facilitates them to learn to investigate the unique cultural memory of the local neighborhood. This course uses social design as the foundation of neighborhood revitalization to lead students to examine the characteristics of shops, transportation, and social network. Furthermore, students will plan to preserve old cultural villages through creative actions and combine traditional lifestyles with new living villages to create an ecological village of the cultural neighborhood.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "從人文、歷史、社會與經營的角度，學習不同面向的議題與社會設計。",
      "describe_en": "From the perspectives of humanity, history, society, and operation, they obtain the issues of different dimensions and social design."
    },
    {
      "seq": 2,
      "describe_ch": "學習思考、規劃與設計，並從社會設計過程中提出問題解決的策略。",
      "describe_en": "Students learn the thinking, planning, and designing and propose the strategy of problem-solving in the process of social design."
    }
  ],
