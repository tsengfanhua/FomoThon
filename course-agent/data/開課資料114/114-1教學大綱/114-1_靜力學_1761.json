  "description": {
    "sub_id3": null,
    "sub_name": "靜力學",
    "sub_ename": "STATICS",
    "describe_ch": "講授工程力學中靜力學部分之基本觀念及求解方式與技巧，以作為同學爾後修習動力學、材料力學等課程之基礎。課程內容包括－力與向量、質點平衡、力系合成、剛體平衡、結構分析，摩擦與慣性矩。",
    "describe_eh": "The goal of this course is to provide the students with working knowledge of particle and rigid-body mechanics to analyze forces on structures and machines . The main topics include force vectors, equilibrium of a particle, force system resultants, equilibrium of a rigid body, structural analysis, friction and moments of inertia.",
    "pre_subname": "IEE1010普通物理-電、磁、光",
    "pre_sub_id3": "IEE1010",
    "pre_sub_ename": "IEE1010 GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用數學基礎以瞭解靜力學基本知識",
      "describe_en": "Apply mathematic foundation to understand the basic knowledge about statics."
    },
    {
      "seq": 2,
      "describe_ch": "理解質點與剛體靜力平衡分析能力",
      "describe_en": "Understand and be able to analyze the equilibrium of particals and rigid bodies."
    },
    {
      "seq": 3,
      "describe_ch": "以自由體分析方法建立結構系統模型",
      "describe_en": "Construct model of structure system by free body analytic method."
    },
    {
      "seq": 4,
      "describe_ch": "應用虛功原理分析靜力平衡",
      "describe_en": "Apply virtual work principal analyze the static equilibrium."
    }
  ],
