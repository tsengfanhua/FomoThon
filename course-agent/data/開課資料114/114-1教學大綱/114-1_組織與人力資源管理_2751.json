  "description": {
    "sub_id3": null,
    "sub_name": "組織與人力資源管理",
    "sub_ename": "ORGANIZATION AND HUMAN RESOURCES MANAGEMENT",
    "describe_ch": "本課程提供組織理論與人力資源管理相關背景知識與理論。以幫助管理者設計他們的組織，在全球競爭環境中更具效率。理解人力資源管理中，選、育、用、留的各種功能。本課程介紹的組織理論的主題，包括：組織效能、企業道德、全球環境、設計組織結構、管理組織文化、組織變革、組織轉型、決策與學習、創新、及管理衝突。",
    "describe_eh": "This course provides concepts and ideas about human resource management, including the functions of selection, nurturing, employment, and retention. This course introduces the major topics in organizational theory, including: organizational effectiveness, ethics, global environment, designing organizational structure, managing organizational culture, organizational change, organizational transformations, decision making and learning, innovation, and managing conflict.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解人力資源管理中，選、育、用、留的功能",
      "describe_en": "Application the functions of selection, nurturing, employment, and retention in human resource management."
    },
    {
      "seq": 2,
      "describe_ch": "分析組織的結構設計以及其所處的環境",
      "describe_en": "Analysis of the structural design and external environment of an organization."
    },
    {
      "seq": 3,
      "describe_ch": "綜合組織文化、變革與行為的理論，說明跨文化在組織管理上的意義\t",
      "describe_en": "Synthesis of theories of organizational culture, change and behavior for discussing the cross-cultural meaning by organizational management."
    }
  ],
