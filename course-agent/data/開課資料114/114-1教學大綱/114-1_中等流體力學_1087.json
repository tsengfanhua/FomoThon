  "description": {
    "sub_id3": null,
    "sub_name": "中等流體力學",
    "sub_ename": "INTERMEDIATE FLUID MECHANICS",
    "describe_ch": "本課程講授流體力學之進階原理與工程實務應用。內容涵蓋國考及研究所入學考試之試題。課程內容包括牛頓粘性定律，表面張力，流體靜力學，柏努力方程式，流體運動學，積分分析，微分分析等。",
    "describe_eh": "This class presents the advanced principles and engineering application of fluid dynamics.  The contents cover the problems of the exams of the nation and the entrance exams of graduated schools.  This course contents include Newton’s law of viscosity, surface tension, staics, Bernoulli equation, kinematics, control volume analysis, and differential analysis.",
    "pre_subname": "MATH1001微積分(一)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用牛頓粘性定律，表面張力，流體靜力學，柏努力方程式。",
      "describe_en": "Can apply Newton’s law of viscosity, surface tension, staics, Bernoulli equation. .\t"
    },
    {
      "seq": 2,
      "describe_ch": "能應用流體運動學，積分分析，微分分析。",
      "describe_en": "Can apply kinematics, control volume analysis, and differential analysis."
    }
  ],
