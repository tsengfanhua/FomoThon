  "description": {
    "sub_id3": null,
    "sub_name": "實用職場英文",
    "sub_ename": "WORKPLACE ENGLISH",
    "describe_ch": "「實用職場英文」以提升學生職場英語能力為主軸，採取互動及務實的教學方式，著重培養學生在職場所須之溝通技巧。課程架構涵蓋口說與寫作訓練，除了求職所需之英語能力外，亦針對進入職場後所需之英語溝通技巧。",
    "describe_eh": "“Workplace English” aims to develop students’ English ability for the workplace. The course takes a communicative and practical approach towards language education with a focus on developing students’ communication and interaction skills in professional settings. Course content includes training in both the written and spoken communication skills necessary to workplace entry and survival.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
