  "description": {
    "sub_id3": null,
    "sub_name": "空氣污染控制工程設計",
    "sub_ename": "AIR POLLUTION CONTROL ENGINEERING AND DESIGN",
    "describe_ch": "空氣污染防治設施之設計興建為國內外空氣污染防治方法的主流。為提升本系學生畢業就業之競爭能力，先從國內空氣污染防治設施介紹說明、再深入就單元設計、流量設計、污染物處理、與成本效益等，分組進行空氣污染防治設施設計，並輔以營運操作管理方式說明，以加強本系學生實務觀念，期末且有成果發表。",
    "describe_eh": "The design and building of air pollution control facilities for air pollution control purpose is a main stream of air pollution prevention methods worldwide nowadays. This course is designed to promote the competitive ability of graduated students, and includes the topics of development air pollution control facilities, control unit design, flow design and treatment, and cost benefit evaluation. Students will learn the details through group works. The operation and management of air pollution control facilities are also included in the class to give students more practical concepts and views. Final oral presentation of the design works will be held at the end of the semester.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解不同污染物之處理技術原理及應用\t",
      "describe_en": "To understand the principle and applications of different pollutants and treatment technologies.\t"
    },
    {
      "seq": 2,
      "describe_ch": "綜合資料收集、數據整理解析與歸納設計的專業能力，構成專題研究報告\t",
      "describe_en": "To compose a technical report."
    },
    {
      "seq": 3,
      "describe_ch": "應用工圖及各項環境工程之知識進行處理單元之設計\t.　",
      "describe_en": "To apply various techniques of engineering drawing and environmental engineering principles on the designs of treatment processes"
    },
    {
      "seq": 4,
      "describe_ch": "理解各處理設備之工程設計與操控策略　\t",
      "describe_en": "To understand various treatment plant design and their P&ID strategies.　"
    },
    {
      "seq": 5,
      "describe_ch": "應用專案管理、團隊合作與溝通協調能力\t",
      "describe_en": "To apply the abilities of project management, effective communication and persuasion."
    },
    {
      "seq": 6,
      "describe_ch": "分析環境問題並構思解決問題的方法\t",
      "describe_en": "To analyze the environmental problems and considering the possible solutions."
    },
    {
      "seq": 7,
      "describe_ch": "關心環境問題並能持續學習與謀求解決方案\t",
      "describe_en": "To care about the environmental problems and seek for solutions by persistent learning."
    },
    {
      "seq": 8,
      "describe_ch": "認知專業倫理與社會道德責任，培養自我管理能力\t",
      "describe_en": "To recognize the professional ethics and society moral responsibility, develop the ability of self-management."
    }
  ],
