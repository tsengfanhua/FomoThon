  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE10131",
    "sub_id": "74036",
    "scr_dup": "001",
    "sub_title": "本課程介紹環境規劃與都市設計的內涵、理論、案例與實務應用。",
    "sub_title_en": null,
    "sub_describe": "環境規劃與都市設計是一門跨學門科目，內容包含國土規劃、都市設計、景觀規劃、生態規劃、自然保育、社區營造、與地方創生等面向，以建構良好的城鄉實質環境並提升環境品質。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "環境規劃與都市設計",
    "sub_ename": "ENVIRONMENTAL PLANNING AND URBAN DESIGN",
    "describe_ch": "環境規劃與都市設計探討人的空間意義與活動經驗議題，強調整體永續發展的「城鎮的生成」。本課程介紹環境規劃與都市設計的內涵與理論，處理三度空間之規劃設計以及其所涵括的社會、經濟與人文的問題。",
    "describe_eh": "Environmental planning and urban design deal with the human experience that built environment evokes across private properties or in the public realm. In other words, environmental planning and urban design focuses on integrative, sustainable “town-making.” This course introduces the essential and theory of environmental planning and urban design. It is also a technique dealing with three-dimensional design regarding social, economic and cultural aspects within cities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解環境規劃與都市設計的分析技術與實質內涵",
      "describe_en": "Comprehension for analytical techniques and contents of environmental planning and urban design."
    },
    {
      "seq": 2,
      "describe_ch": "能應用永續思維於環境規劃與都市設計的實踐",
      "describe_en": "Application of sustainable thinking to professional practice on environmental planning and urban design."
    }
  ],
