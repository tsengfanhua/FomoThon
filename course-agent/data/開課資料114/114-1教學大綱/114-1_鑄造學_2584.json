  "description": {
    "sub_id3": null,
    "sub_name": "鑄造學",
    "sub_ename": "FOUNDRY",
    "describe_ch": "本課程目標建立在金屬鑄造的基礎上，主題包含鑄造學概論、鑄造熱力學、固化原理、成核與生長、鑄造方法概述、爐前分析及鑄件檢驗、特殊鑄造法、工業應用。",
    "describe_eh": "The goal of this course is to build on metal casting. The topics include: fundamentals of metal casting, the thermodynamics of solidification, the principles of solidification, the nucleation and growth mechanism, the casting processes, inspection, special casting methods, and industrial application.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "說明鑄造的原理",
      "describe_en": "Illustrate the casting principle"
    },
    {
      "seq": 2,
      "describe_ch": "分類不同的鑄造方法及解釋鑄造設計的原則",
      "describe_en": "Classify the different casting methods and explain design principles of casting"
    },
    {
      "seq": 3,
      "describe_ch": "說明鑄造工廠的安全管理",
      "describe_en": "Describe the safety management in factory"
    },
    {
      "seq": 4,
      "describe_ch": "表達鑄造在產業上的應用",
      "describe_en": "Interpret the application in industry"
    }
  ],
