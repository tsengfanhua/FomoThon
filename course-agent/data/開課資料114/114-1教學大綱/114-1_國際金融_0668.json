  "description": {
    "sub_id3": null,
    "sub_name": "國際金融",
    "sub_ename": "INTERNATIONAL FINANCE",
    "describe_ch": "本課程係專為研究生所設計，主題包括1.各種匯率制度的簡介；2.開放經濟體系模型的建立；3.遠期外匯市場；4.宣告效果與匯率的動態調整；5.匯率體制變遷；6.匯率體制崩潰；7.資產組合平衡分析；8.匯率目標區。",
    "describe_eh": "This is a graduate course on the international finance.  Topics include: 1.introduction to alternative exchanges rates regimes; 2. how to construct an open economy macroeconomic model; 3. forward foreign exchange market; 4. announcement effect and the dynamic adjustment of exchanges rates 5. exchange regime switch; 6. exchange regime collapse ; 7.portfolio balance model; 8.target zones of exchanges rates",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解(1)各種匯率制度的運作方式、(2)匯率是如何決定的、(3)匯率的各種動態調整型態、(4)匯率制度變革對的成因、影響",
      "describe_en": "Comprehension for  the (1) operation  pattern of alternative exchanges rates regimes, (2) how to determine of exchanges rates, (3) the pattern of exchanges rates dynamic adjustment, (4) the causes and influences of exchanges rates reform"
    },
    {
      "seq": 2,
      "describe_ch": "能初步分析(1)重大國際金融事件的成因與對國內總體經濟環境的影響、(2)各種干擾對本國國幣幣值的影響方向與動態調整路徑",
      "describe_en": "Analyze for the (1) cause of large international finance events and its influences with respect to domestic macroeconomic environment, (2) alternative disturbances how to affect the exchanges rates and dynamic adjustment path"
    },
    {
      "seq": 3,
      "describe_ch": "能從開放或國際經濟體系的視野來理解各項國際金融問題的成因、影響與限制",
      "describe_en": "Comprehension for international or open economy vision to understand the\r\nthe causes, influences and limitation of alternative international finance problem\r\n"
    }
  ],
