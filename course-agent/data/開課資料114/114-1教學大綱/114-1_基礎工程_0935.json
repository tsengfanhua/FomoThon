  "description": {
    "sub_id3": null,
    "sub_name": "基礎工程",
    "sub_ename": "FOUNDATION ENGINEERING",
    "describe_ch": "本課程引導研習者建立初步分析側向土壓力、擋土牆、邊坡穩定、淺基礎、開挖支撐、樁基礎、與土壤夯實及改良的能力。",
    "describe_eh": "The aim of this course attempts to give learners the capabilities in preliminary analysis of earth lateral pressure, retaining wall, slope stability, shallow foundation, shoring of excavation, deep foundation as well as soil compaction and improvement.",
    "pre_subname": "CE2071土壤力學",
    "pre_sub_id3": "CE2071",
    "pre_sub_ename": "CE2071 SOIL MECHANICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得營建工程構造物基礎的相關知識。",
      "describe_en": "Obtain the knowledge of structure foundation."
    },
    {
      "seq": 2,
      "describe_ch": "能初步設計營建工程構造物的基礎。",
      "describe_en": "Be able to perform preliminary design of foundation for structures."
    }
  ],
