  "description": {
    "sub_id3": null,
    "sub_name": "研究方法與論文寫作",
    "sub_ename": "RESEARCH METHODOLOGY AND THESIS WRITI NG",
    "describe_ch": "本課程教授包括撰寫論文所使用的研究方法及論文寫作的方法與技巧二部份。研究方法的內容包括多變量分析、時間序列分析與EViews、SPSS、Stata等軟體應用等，論文寫作的內容包括學術論文的格式與架構、文獻管理軟體、論文原創性比對系統與寫作技巧等。",
    "describe_eh": "The teaching of this course includes two parts: The research methods used in writing the thesis and the methods and skills of thesis writing. Research methods include multivariate analysis, time series analysis and software applications such as EViews, SPSS, Stata, etc. The content of paper writing includes the format and structure of academic papers, document management software, paper originality comparison system, and writing skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解學術研究的基本概念與架構",
      "describe_en": "Understand the basic concepts and structure of academic research"
    },
    {
      "seq": 2,
      "describe_ch": "具備學術研究能力並熟悉適用研究方法",
      "describe_en": "Possess academic research capabilities and be familiar with applicable research methods"
    },
    {
      "seq": 3,
      "describe_ch": "養成將研究結果撰寫為學術論文的寫作能力",
      "describe_en": "Develop the writing ability to write research results into academic papers"
    }
  ],
