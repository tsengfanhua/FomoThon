  "description": {
    "sub_id3": null,
    "sub_name": "國際貿易實務(一)",
    "sub_ename": "PRACTICES OF INTERNATIONAL TRADE(1)",
    "describe_ch": "國際貿易實務（一）課程包括進出口貿易流程，國際貿易組織與管理，國際市場開發策略，Incoterms 2000, Quotation, P/I, P/O, S/C及Contract & Agreement，目標在建構正確的國際貿易實務基本概念，以達到理論與實務結合之教學成效。",
    "describe_eh": "To develop an understanding of the major issues in the International Trade Practice. To identify Organization Model, transactions, trial run markets, trade terms, sign up contracts, letters of credit, exporting and importing procedures, disputes, and mix strategies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能清楚地確認國際貿易相關之『專業術語』及『貿易條件』，並描述國際貿易進出口流程。",
      "describe_en": "Knowledge for related \"specialized terminology\"and \"trade terms\" in the field of international trade and the procedures of exporting and importing."
    },
    {
      "seq": 2,
      "describe_ch": "能熟悉進出口相關單據之操作。",
      "describe_en": "Knowledge for the operation of related exporting and importing documents."
    },
    {
      "seq": 3,
      "describe_ch": "具備國貿實務流程相關專業術語之英文詞彙。",
      "describe_en": "Knowledge for related \"specialized terminology\" in the field of international trade practices in English."
    }
  ],
