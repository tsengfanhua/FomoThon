  "description": {
    "sub_id3": null,
    "sub_name": "電腦輔助繪圖",
    "sub_ename": "COMPUTER-AIDED DRAWING",
    "describe_ch": "電腦輔助工程製圖課程講授利用電腦輔助繪圖軟體繪製一般工程圖形之方法及技巧，本課程目前採用ActoCAD商用繪圖軟體以繪製一般工程圖形。由於ActoCAD軟體為一開放性軟體，本身提供可程式發展工具，例如：AutoLISP、Visual Basic Application (VBA)、Advanced Development System (ADS)、Object-oriented AutoCAD Runtime Extension(ObjectARX)等發展工具，使用者可以用參數式設計技巧撰寫各種標準零件之自動繪圖系統，以達繪圖自動化之目標。上課學生除了學習繪製2D和3D工程圖形之方法，也將學習利用AutoLISP語言發展常用工程標準零件之自動繪圖軟體。",
    "describe_eh": "Equipped with basic knowledge of information security management. The computer-aided engineering drawing course teaches the methods and techniques of using computer-aided drawing software to draw general engineering graphics. This course currently uses ActoCAD commercial drawing software to draw general engineering graphics. Since ActoCAD software is an open software, it provides several programmable development tools, such as: AutoLISP, Visual Basic Application (VBA), Advanced Development System (ADS), Object-oriented AutoCAD Runtime Extension (ObjectARX) and other development tools. Use Researchers can use parametric design techniques to write automatic drawing systems for various standard parts to achieve the goal of drawing automation. In addition to learning how to draw 2D and 3D engineering graphics, students in this class will also learn to use the AutoLISP language to develop automatic drawing software for commonly used engineering standard parts.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生瞭解電腦輔助設計中最基本之繪圖技巧，更正一般大學生討厭徒手製圖之印象。",
      "describe_en": "It enables students to understand the most basic drawing skills in computer-aided design and corrects the impression that ordinary college students hate freehand drawing."
    },
    {
      "seq": 2,
      "describe_ch": "訓練學生使用最廣之Auto CAD商用電腦輔助繪圖軟體，培養工程人員必須具有之電腦繪圖能力。",
      "describe_en": "Train students to use Auto CAD, the most widely used commercial computer-aided drawing software, and develop the computer drawing skills that engineers must possess."
    },
    {
      "seq": 3,
      "describe_ch": "訓練學生利用電腦繪製二維及三維工程圖形之能力。",
      "describe_en": "Train students to use computers to draw two-dimensional and three-dimensional engineering graphics."
    },
    {
      "seq": 4,
      "describe_ch": "訓練學生撰寫自動繪製標準零件之程式設計方法。",
      "describe_en": "Train students to write programming methods for automatically drawing standard parts."
    }
  ],
