  "description": {
    "sub_id3": null,
    "sub_name": "電磁波",
    "sub_ename": "ELECTROMAGNETIC WAVE",
    "describe_ch": "介紹電磁波的相關原理及應用為主，包含馬克斯威爾方程式，輻射系統，電磁波在介質中及平面邊界上的傳播，傳輸線原理，波導，共振腔及天線等應用。",
    "describe_eh": "In this lecture, we will discussion on the theory and applications of electromagnetic waves, including: Maxwell's equations, radiation of current and charges, propagation of electromagnetic waves in media and planar boundaries, and applications of transmission lines, waveguides, resonators and antennas.",
    "pre_subname": "PHYS2001電磁學(一)、PHYS2002電磁學(二)、ENGS2011工程數學(一)、ENGS2013工程數學(二)",
    "pre_sub_id3": "PHYS2001",
    "pre_sub_ename": "PHYS2001 ELECTROMAGNETICS(1)、PHYS2002 ELECTROMAGNETICS(2)、ENGS2011 ENGINEERING MATHEMATICS(1)、ENGS2013 ENGINEERING MATHEMATICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解並能應用電磁波的基本原理。",
      "describe_en": "Understand and be capable to use the basic principle of electromagnetic (EM) waves."
    },
    {
      "seq": 2,
      "describe_ch": "理解並能分析電磁波基本元件的特性。",
      "describe_en": "Understand the characteristics of basic EM wave elements and be able to analyze them."
    },
    {
      "seq": 3,
      "describe_ch": "知道如何找到電磁波相關技術的資訊，並理解電磁波技術對社會的影響與衝擊。",
      "describe_en": "Know where and how to find the information about EM waves technology, and understand the influence and impact of EM wave technology on our society."
    }
  ],
