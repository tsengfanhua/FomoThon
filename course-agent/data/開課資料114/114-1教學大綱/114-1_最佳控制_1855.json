  "description": {
    "sub_id3": null,
    "sub_name": "最佳控制",
    "sub_ename": "OPTIMAL CONTROL",
    "describe_ch": "本課程旨在介紹最佳控制之核心－變分法(Calculus of Variations)。課程中將強調最佳控制問題之公式化與求解於航太與機械工程上之應用。此外，典型問題如time-optimal and LQR等設計上之問題亦納入課程內討論。",
    "describe_eh": "The objective of this course is to introduce graduate students to the concepts of Calculus of Variations. This course will emphasize the formulation and solution of optimal control problems associated with Aerospace and Mechanical engineering applications. Some classic problems such as time-optimal and LQR design problem will be discussed in details.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建構最佳控制之基本概念與應用。",
      "describe_en": "To have a basic knowledge of Optimal Control methods and their applications."
    },
    {
      "seq": 2,
      "describe_ch": "了解Lagrange multipliers及  Optimization等之理論。",
      "describe_en": "To understand the feature and basic framework of Lagrange multipliers and Optimization."
    },
    {
      "seq": 3,
      "describe_ch": "認識變分法(Calculus of Variations)。",
      "describe_en": "To be aware of Calculus of Variations."
    },
    {
      "seq": 4,
      "describe_ch": "了解Conditions of optimality及Pontryagins Maximum Principle理論。",
      "describe_en": "To understand the Conditions of optimality and Pontryagins Maximum Principle."
    },
    {
      "seq": 5,
      "describe_ch": "認識Optimal control problems - LQR, Time Optimal, Fuel/Time Optimal及Computational methods - Steepest descent, Shooting method之重要性與應用。",
      "describe_en": "To get familiar with Optimal control problems - LQR, Time Optimal, Fuel/Time Optimal and Computational methods - Steepest descent, Shooting method and know their importance and applications."
    },
    {
      "seq": 6,
      "describe_ch": "藉由期末報告以書面及口頭報告並行之方式執行以培養獨立思考、從事研究與溝通能力。",
      "describe_en": "To be able to conduct self-research, and gain the communication skills by practicing the project writing and presentation."
    }
  ],
