  "description": {
    "sub_id3": null,
    "sub_name": "電路學(一)",
    "sub_ename": "CIRCUIT THEORY(1)",
    "describe_ch": "學生將藉由課程講授、電路分析演練與隨堂考/會考等方式，學習並建立電路學基本學理。學期課程內容包含：基本電路構成元件、訊號表示、各式直流網路分析、磁路分析及正弦波形基本表示等單元。",
    "describe_eh": "Students will learn and establish fundamental concepts of circuitry through lecture teaching, practice and quiz, including basic circuit elements, signal expressions, static circuit analysis and introductory of magnetic circuits and sinusoidal waveforms.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備被動元件特性與直流功率分析之基本知識。\t",
      "describe_en": "Knowledge of fundamental characteristics of passive elements and dc power analyses."
    },
    {
      "seq": 2,
      "describe_ch": "理解直流網路及一階/二階電路之基本分析。\t",
      "describe_en": "Comprehension of fundamental analyses of dc networks and 1st/2nd circuits."
    }
  ],
