      "seq": 1,
      "describe_ch": "理解生態學之基本概念 \t",
      "describe_en": "Comprehension the basic concept of ecology."
    },
    {
      "seq": 2,
      "describe_ch": "理解河川生態系與坡地生態系之主要特徵\t",
      "describe_en": "Comprehension the main characteristics of river ecosystems and hillslope ecosystems"
    },
    {
      "seq": 3,
      "describe_ch": "分析近年漸受關注之生態單元\t",
      "describe_en": "Analyze the developing ecological topics."
    },
    {
      "seq": 4,
      "describe_ch": "能夠在分組討論與分享中表現有效溝通及團隊合作的能力。\t",
      "describe_en": "Perform the effective communication and teamwork in group discussions and presentation."
    }
  ],
