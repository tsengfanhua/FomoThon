  "description": {
    "sub_id3": null,
    "sub_name": "資料分析軟體應用",
    "sub_ename": "DATA ANALYSIS SOFTWARE APPLICATION FOR IE",
    "describe_ch": "對於IE領域，Excel在數據應用中可進行資料處理、統計，藉由格式設定、走勢圖和表格，讓資料淺顯易懂，另結合VBA，更可快速完成重複繁雜的工作，故藉由軟體工具使用和專案實作，使學生學會運用軟體工具以解決IE實務問題。",
    "describe_eh": "For the IE field, Excel can perform data processing and statistics in data applications. With format settings, trend charts and tables, the data can be easily understood. In addition, combined with VBA, it can quickly complete repetitive and complicated tasks. Through the use of software tools and project implementation, students will learn to use software tools to solve IE practical problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生瞭解工工領域資料分析軟體基本概念",
      "describe_en": "To understand the basic concepts and software of data analysis in IE field."
    },
    {
      "seq": 2,
      "describe_ch": "使學生瞭解工工領域各階段資料分析軟體過程並懂得應用",
      "describe_en": "To understand and apply different phases of data analysis process in IE field."
    },
    {
      "seq": 3,
      "describe_ch": "提升學生善用工工領域中資料分析軟體工具、評估及整合應用資訊技術的能力",
      "describe_en": "To improve students' ability to use data analysis software and assess the integrated applications of information technology in IE field."
    },
    {
      "seq": 4,
      "describe_ch": "培養學生具備解決工工實務問題之軟體應用能力",
      "describe_en": " To have the ability to apply data analysis software to solve practical problem in IE field.\r\n"
    }
  ],
