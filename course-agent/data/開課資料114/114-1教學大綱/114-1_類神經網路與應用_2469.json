  "description": {
    "sub_id3": null,
    "sub_name": "類神經網路與應用",
    "sub_ename": "NEURAL NETWORKS AND APPLICATIONS",
    "describe_ch": "本課程介紹神經網路的基本原理及其現今在深度學習中的應用。內容包含線性模型、前饋神經網路、反向傳播算法、隨機梯度下降方法、正則化和典型的深度學習模型，如捲積神經網路和遞迴神經網路。學生將通過實際編寫程式語言來學習。",
    "describe_eh": "This course introduces the basic principles of neural networks and their applications in deep learning. Course topic includes linear models, feedforward neural networks, back-propagation algorithms, stochastic gradient descent methods, regularization, and typical deep learning models such as convolutional neural networks and recurrent neural networks. Students will learn about neural networks and deep learning through hands-on computer programming.",
    "pre_subname": "MATH2012統計學、MATH2011機率論、MATH1053計算機程式",
    "pre_sub_id3": "MATH2012",
    "pre_sub_ename": "MATH2012 STATISTICS、MATH2011 PROBABILITY、MATH1053 COMPUTER PROGRAMMING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解類神經網路模型基本架構",
      "describe_en": "Comprehension for the basic structures of artificial neural network models"
    },
    {
      "seq": 2,
      "describe_ch": "能運用相關工具建構類神經網路模型",
      "describe_en": "Ability to build artificial neural network models by using related tools"
    }
