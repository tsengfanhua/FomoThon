  "description": {
    "sub_id3": null,
    "sub_name": "財稅專題",
    "sub_ename": "LECTURES ON FINANCE AND TAX",
    "describe_ch": "本課程要求學生選定財稅領域特定議題撰寫深入的研究報告，同學必須結合前三年所學，以小組合作方式採用適當的量化研究方法深入研討，培養團隊工作能力、以及正式口頭報告的方式。",
    "describe_eh": "This course asks students to finish a professional report of selected issues about taxation or public expenditure. Students should integrate the knowledge learned last three years, form research teams, adopt appropriate quantitative research methods and research thoroughly; learn the ability to foster team work and the way of formal oral presentation.",
    "pre_subname": "PF3001財政學(一)、PF3002財政學(二)",
    "pre_sub_id3": "PF3001",
    "pre_sub_ename": "PF3001 PUBLIC FINANCE(1)、PF3002 PUBLIC FINANCE(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能分析研究專題的數據資料並歸納出結論",
      "describe_en": "Can analysis data about research issues and draw conclusions"
    },
    {
      "seq": 2,
      "describe_ch": "綜合組員討論並向同學及老師口頭報告結果",
      "describe_en": "Synthesize the discussion between team members and formally oral present the results to classmates and instructors"
    },
    {
      "seq": 3,
      "describe_ch": "說明專題相關專業知識",
      "describe_en": "Explain project relevant professional knowledge"
    },
    {
      "seq": 4,
      "describe_ch": "說明專題涉及之專業倫理",
      "describe_en": "Explain project related professional ethics"
    },
    {
      "seq": 5,
      "describe_ch": "分析專題問題並找出解決方案",
      "describe_en": "Analyze the problem of project and find the possible solutions"
    }
  ],
