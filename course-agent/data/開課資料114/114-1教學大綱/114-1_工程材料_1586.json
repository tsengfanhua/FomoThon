  "description": {
    "sub_id3": null,
    "sub_name": "工程材料",
    "sub_ename": "ENGINEERING MATERIALS",
    "describe_ch": "工程材料是一門發展快速之科學，它不僅具有極大之市場開發潛力，並且在學術上亦具有重要研究價值，也是科學發展實現最終理想的關鍵。本課程主要內容：1.晶體結構 2.各種材料之物理特性。",
    "describe_eh": "Engineering Material is a rapidly-developed science, which not only has large market development potential, but also has important academic research value and is also the key point to realize the ultimate ideal in scientific development. Main contents of this course: 1. crystal structure; 2. physical characteristics of all materials.\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解材料晶體結構之知識。",
      "describe_en": "Understand the knowledge about the crystal structure of materials."
    },
    {
      "seq": 2,
      "describe_ch": "具備材料光、電、磁之基本與進階原理與分析應用之能力。",
      "describe_en": "Understand and be able to apply the basic and advanced optical, electric and magnetic principles of materials."
    }
