  "description": {
    "sub_id3": null,
    "sub_name": "電腦輔助工程-SolidWorks",
    "sub_ename": "COMPUTER AIDED ENGINEERING-SolidWorks",
    "describe_ch": "由於電腦科技及軟體工程之發達，電腦輔助工程技術已經應用於國內電子及航太產業。 有效運用這些先進電腦輔助工程技術以輔助其產品設計，可大量縮短產品開發及上市之時間，進而提升產品之競爭性。 針對此一需求，本系規劃了『電腦輔助工程-SolidWorks』 期望學生藉由本課程之上課講解及互動學習，搭配實際上機操作、作業、期末專題計畫、考試等方式以熟悉：1電腦輔助工程軟體-SolidWorks的基本建模步驟：28olidWorks的基本組裝與機構模擬方法; 3.SolidWorks的基本熱流與結構模擬方法。",
    "describe_eh": "The CAD/CAM/CAE software has been adopted to improve the competition ability of the products in the electrical and aerospace industries. According to this issue, we plan a course named \"Computer Aided Engineering - Solid Works\". In this course, we start to draw 2-D cross-sections by the sketching functions, and extend them into 3-D solid parts. Secondly, we assemble these parts as a product and try to analyze the kinematical behaviors of the products. Finally, we transfer the products into CAE module to simulate their structural and thermo-fluid performances.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉SolidWorks草圖繪製指令以建構二維草圖",
      "describe_en": "To get familiar with the methodology of 2-D sketch using SolidWorks drafting commands."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉以SolidWorks實體指令以建構三維實體模型的方法",
      "describe_en": "To get familiar with the methodology of 3-D modeling using SolidWorks solid feature commands."
    },
    {
      "seq": 3,
      "describe_ch": "能運用SolidWorks組裝及機構模組以模擬組合件之結合與運動能運用SolidWorks組裝及機構模組以模擬組合件之結合與運動",
      "describe_en": "To be able to simulate the product assembling and kinematic behaviors using SolidWorks assembling commands."
    },
    {
      "seq": 4,
      "describe_ch": "熟悉SolidWorks的基本熱流與結構模擬方法",
      "describe_en": "To be able to transfer the product into CAE module and simulate their structural and thermo-fluid performances."
    },
    {
      "seq": 5,
      "describe_ch": "具團隊合作精神以進行工程設計之能力",
      "describe_en": "To be able to work as a team member and pursue design of engineering applications"
    },
    {
      "seq": 6,
      "describe_ch": "訓練口頭報告其設計作品之能力",
      "describe_en": "To be capable of making a fine presentation of their design works to their classmates and instructor."
    }
  ],
