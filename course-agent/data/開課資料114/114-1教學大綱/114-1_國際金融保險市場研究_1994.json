  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CF1331A",
    "sub_id": "41432",
    "scr_dup": "001",
    "sub_title": "國際金融保險市場研究",
    "sub_title_en": null,
    "sub_describe": "1. 透過海外參訪比較各國金融機構之實務運作差異與優劣。\n2. 經由實地的跨國與跨界互動，深入了解各國金融服務的創新與發展。\n3. 參訪各國文化與經貿差異，接軌普惠金融之全球趨勢。\n4. 參訪中透過分組討論、現場觀察與同儕間跨業經驗交流等過程，提升協作與國際個 \n   案研究分析能力。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "國際金融保險市場研究",
    "sub_ename": "RESEARCH OF INTERNATIONAL FINANCE AND INSURANCE INDUSTRY",
    "describe_ch": "本課程旨在透過國外參訪企業或金融機構等，並與同學們討論參訪心得、撰寫參訪報告的方式，使學生了解國際金融與保險業的發展概況。",
    "describe_eh": "The purpose of this course is to provide students opportunities to visit international financial institutions and enable them to understand the development and prospects of international banking and insurance market.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解國際金融與保險業的發展概況、觀察參訪企業的經營優勢與面對的挑戰",
      "describe_en": "Know the market prospects of international banking and insurance market, and identify the SWOT of the visited companies."
    },
    {
      "seq": 2,
      "describe_ch": "學生能夠在團隊中分工合作，參與討論、共同撰寫學期報告",
      "describe_en": "Students could cooperate and share thoughts to finish term project."
    }
  ],
