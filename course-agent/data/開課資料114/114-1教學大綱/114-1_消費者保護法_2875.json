  "description": {
    "sub_id3": null,
    "sub_name": "消費者保護法",
    "sub_ename": "CONSUMER PROTECTION LAW",
    "describe_ch": "介紹消費者保護法及其他相關消費者保護之法律規定與制度，輔以國內外法院實務與案例分析，並兼及公平交易法、營業秘密法及智慧財產法律中消費者應備之生活法律常識。俾益學生對消費權益與相關法律能有所認識。",
    "describe_eh": "This course is an introduction to the protection of consumers and other related laws and systems. The course is supplemented with practical work and analysis of cases from within and outside Taiwan. We will look at the Fair Trade Bill, secrets of business and intellectual property. The course aims to teach students about the laws and rights of consumers.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識消費者保護法及其他相關消費者保護之法律規定與制度",
      "describe_en": "realize consumers and protect the law and legal provisions and system which other relevant consumers protect."
    },
    {
      "seq": 2,
      "describe_ch": "了解企業經營者對消費者所負責任與消費爭議處理程序",
      "describe_en": "understands enterprise's operator is responsible with consume and dispute and deal with the procedure for consumers."
    },
    {
      "seq": 3,
      "describe_ch": "說明國內外著名法院實務與案例分析，辨識產品瑕疵、不實廣告、定型化契約等效力與責任，並熟悉如何主張消費者權利。",
      "describe_en": "explains famous court's practice and case analysis both at home and abroad,distinguish rendering a service and responsibility ,such as flaw of product ,unureal advertisement ,finalizing the design agreement,etc.,how and is familiar with to advocate"
    },
    {
      "seq": 4,
      "describe_ch": "懂得消費者保護法保護消費者權益之規定，並能實際應用在日常生活與電子商務處理上",
      "describe_en": "understand that consumers protect the regulation that the law protected consumer's rights and interests, and can apply to daily life and electronic business processing actually ."
    },
    {
      "seq": 5,
      "describe_ch": "具備其他相關消費者保護之知識，能了解並說明消費者保護與民法、刑法、公平交易法、智慧財產權法等之關係，而有助於增進多元視野與社會化技能。",
      "describe_en": "understand that consumers protect the regulation that the law protected consumer's rights and interests, and can apply to daily life and electronic business processing actually ."
    },
    {
      "seq": 6,
      "describe_ch": "養成正確合理之消費習慣，致力充實消費資訊，提升自我消費生活品質，實踐現代人文素養與社會關懷理念。",
      "describe_en": "forms the correct and rational consumption habit, is devoted to substantiating consumption information , improve the quality of the life of self- consumption, the modern humane accomplishment of practice and society show loving care for the idea."
    }
  ],
