  "description": {
    "sub_id3": null,
    "sub_name": "智慧辨識檢測與應用",
    "sub_ename": "APPLICATIONS OF INTELLIGENT RECOGNITION AND OBJECTS DETECTION",
    "describe_ch": "本課程的目標在於讓學生了解智慧辨識、物件偵測軟硬體原理，完成小型專題實作。本課程主要軟體工具為 Matlab 及 Python。從運算思維開始，培養學生的邏輯思考的能力、自我學習及實作能力。",
    "describe_eh": "This course aims to help students understand the basic concepts of intelligent recognition and objects detection, including the hardware implementations and software applications, and that enable students to complete the final project at the end of the semester. The main software tools of this course are Matlab and Python. This course will cultivate students' computational thinking, logical thinking ability, self-learning, and hands-on ability.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "暸解影像處理、人工智慧、物件偵測與其軟硬體系統整合的基本概念。",
      "describe_en": "Understand the basic concept of image processing, the artificial intelligence, objects detection, and the integration."
    },
    {
      "seq": 2,
      "describe_ch": "理解智慧辨識、物件偵測之應用。",
      "describe_en": "Realize the applications of intelligent recognition and objects detection."
    },
    {
      "seq": 3,
      "describe_ch": "了解實作相關議題，包含軟硬體架設",
      "describe_en": "Realize other issues of implementations, including software and hardware."
    }
  ],
