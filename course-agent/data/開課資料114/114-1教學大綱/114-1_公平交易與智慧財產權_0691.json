  "description": {
    "sub_id3": null,
    "sub_name": "公平交易與智慧財產權",
    "sub_ename": "ANTITRUST AND INTELLECTUAL PROPERTY",
    "describe_ch": "反托拉斯法與智慧財產權法都是鼓勵創新，促進消費者福祉的法規範。惟二者間之競合關係亦不可忽視，反托拉斯法主要的目的是保障競爭自由及公平，而智慧財產權法則是為保護智慧創作之人，給其一定的獨占時間及範圍，如何在兩個不同的規範間，尋得一個合理的平衡，遂成為本課程之重點。",
    "describe_eh": "Antitrust law and intellectual property are both laws that encourage innovation and customers' welfare. Only that the co-opetition relationship between these two shall not to be neglected. The common view is that intellectual property rights regimes created monopolies to spur innovation, while the antitrust laws sought to eliminate monopolies. Issues at the intersection of antitrust and intellectual property laws have attracted a significant amount of attention.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生能描述反托拉斯法與智慧財產權法之特色。",
      "describe_en": "Students would be able to describe the characteristics of antitrust law & intellectual property right."
    },
    {
      "seq": 2,
      "describe_ch": "學生能針對反托拉斯法與智慧財產權法律制度之競合關係，說明並能清楚表達。",
      "describe_en": "Students would be able to express clearly and to illustrate the co-opetition of antitrust law & IPR."
    },
    {
      "seq": 3,
      "describe_ch": "能辨識現代智慧財產法與反托拉斯法所面臨之法律問題，並能提供自己的意見與看法。",
      "describe_en": "Students would be able to identify related antitrust law & IPR issues and to furnish their own opinions."
    },
    {
      "seq": 4,
      "describe_ch": "能運用智慧財產法與反托拉斯法規範於實際法律問題，並得到適當結論。",
      "describe_en": "Students would be able to apply antitrust law & IPR to business reality and obtain appropriate and pertinent results."
    }
  ],
