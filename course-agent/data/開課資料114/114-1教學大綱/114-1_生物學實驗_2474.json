  "description": {
    "sub_id3": null,
    "sub_name": "生物學實驗",
    "sub_ename": "BIOLOGY LAB.",
    "describe_ch": "生物學是一門探討生命現象的科學，必須藉實驗課程將正課介紹的觀念具體化，使學生由親自動手操作的過程中，學習科學的實驗技術、印證生命科學的基本理論，更重要的是從中體會科學研究的方法與精神。",
    "describe_eh": "Biology is a study the phenomenon of life sciences, the laboratory course encourages students to observe, to ask questions and allows students hands-on in the process, learning science experimental techniques, confirms life science basic theory. The laboratory exercises incorporate a combination of experimental and observational exercises.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "正確的操作顯微鏡。描述各種類型的植物及動物細胞。　\t",
      "describe_en": "Operate microscope in correct way. Describe the fine structures of various types of plant and animal cells."
    },
    {
      "seq": 2,
      "describe_ch": "分析細胞的重要生理現象: 酵素反應、細胞分裂、滲透作用、細胞呼吸作用和光合作用。",
      "describe_en": "Analyze some important physiological phenomenon of cells: enzyme reactions, cell division, osmosis, cellular respiration and photosynthesis."
    },
    {
      "seq": 3,
      "describe_ch": "辨識植物界的多樣性。描述被子植物不同型態的根、莖、葉、花、果實、種子及其功能\t",
      "describe_en": "Distinguish the diversity of plant kingdom. Describe various types of organs in angiosperm plants, and comprehend their functions."
    },
    {
      "seq": 4,
      "describe_ch": "認識並描述各類生物其形態與多樣性\t",
      "describe_en": "Describe the morphology and diversity of various organisms."
    }
  ],
