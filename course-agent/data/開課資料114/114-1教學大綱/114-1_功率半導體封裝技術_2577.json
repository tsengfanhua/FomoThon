      "seq": 2,
      "describe_ch": "了解功率半導體封裝技術之原理\t",
      "describe_en": "Understand the principle of power semiconductor packaging technology."
    },
    {
      "seq": 3,
      "describe_ch": "學習功率半導體封裝之材料選用原理\t",
      "describe_en": "Learn the material selection principle of power semiconductor packaging\t"
    }
  ],
