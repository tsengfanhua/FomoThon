  "description": {
    "sub_id3": null,
    "sub_name": "功率半導體封裝技術",
    "sub_ename": "THE PACKAGING OF POWER SEMICONDUCTOR DEVICES",
    "describe_ch": "能源危機帶動第三代半導體功率元件(SiC/GaN)受到關注。本堂課除了介紹功率半導體元件原理及應用外，將結合材料科學來探討其封裝之設計、材料選用及技術發展。",
    "describe_eh": "The energy crisis is drawing attention to the third-generation semiconductor power devices. In addition to introducing the principle and application of power semiconductor devices, this class will discuss packaging design, material selection, and technology development of the power semiconductor in combination with material science.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
