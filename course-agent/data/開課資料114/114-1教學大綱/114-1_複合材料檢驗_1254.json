      "seq": 2,
      "describe_ch": "檢測項目與製成變數的關係及對產品物性的影響",
      "describe_en": "Relationships between inspection items and processing variables of curing composites as well as the related physical properties of cured parts."
    },
    {
      "seq": 3,
      "describe_ch": "檢測項目與破壞模式的關係及產品破壞行為探討",
      "describe_en": "Estimating fracture mechanics and modes related to inspection items."
    }
