  "description": {
    "sub_id3": null,
    "sub_name": "複合材料檢驗",
    "sub_ename": "INSPECTION OF COMPOSITES",
    "describe_ch": "此課程主要是在介紹纖維高分子複合材料的基本檢測方法(破壞及非破壞檢驗), 並探討製程三大變數(時溫度、時間及壓力)的相互關係與選取, 以及複材成品實體破獲模式的分析與探討。",
    "describe_eh": "This class aims at introducing the fundamental methods on destructive and non destructive inspection. Three major processing variables (temperature, time and pressure) are discussed and the optimum process condition is then decided. Fracture modes of composite products are also demonstrated and analysed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
