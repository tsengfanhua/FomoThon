  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CH06310",
    "sub_id": "97511",
    "scr_dup": "001",
    "tpa_score_new": "<div>In-class participation to account for 20% of final grade;</div>\n\n<div>Theme-based presentation to account for 30% of final grade;</div>\n\n<div>Final Presentation to account for 50% of final grade.</div>\n",
    "tpa_score_new_en": " ",
    "course_pol": "No eating while the seminar is in session please.\nDrinking water will always be fine.\nNo attendance will be taken; however, in-class participation will be expected and appreciated.\nStrict leave policy applies for a session in which a test or a presentation has been scheduled.\nLet's keep each other updated in our class LINE group.",
    "course_pol_en": null,
    "course_rem": "1. Please try to keep your mobile phone use to a minimum.\n2. No eating or drinking.\n3. If you need to leave the room early or if you happen to arrive late, please do so and be seated in a discreet way.\n4. Please show respect for your fellow students.\n5. Zero tolerance for plagiarism.\n6. Report all difficulty and hardship you may be experiencing to the instructor!",
    "course_rem_en": null,
    "ais_meno": "<div>Academic integrity is everything.</div>\n\n<div>Zero tolerance for plagiarism.</div>\n\n<div>Violation of this policy will lead to serious consequences...up to and including suspension from this seminar.</div>\n\n<div>Moreover, assignments (this includes reading assignments) to be completed beforehand.</div>\n\n<div>Advice and assistance will always be available to students, and they will&nbsp;always be welcome to speak&nbsp;to the instructor.&nbsp;</div>\n\n<div>Details will be given in the first two weeks of the semester.</div>\n\n<div>&nbsp;</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": "N"
  },
