  "description": {
    "sub_id3": null,
    "sub_name": "單元操作實驗(一)",
    "sub_ename": "UNIT OPERATION LAB.(1)",
    "describe_ch": "單元操作實驗讓學生可以在學習化學工程的基本原理和實際的應用時獲得實踐的經驗。這操作設備都是化工廠實際量產時所需的設備。實驗中，學生將分組進行各項機械設備的操作，並學習機械運作的原理以及如何解決實際的工程問題。",
    "describe_eh": "The Unit Operation Laboratory allows students to gain hands-on experience while studying both the fundamental principles and practical applications of chemical engineering. This facility is specifically designed to introduce students to larger scale industrial processes commonly encountered by chemical engineers. In this laboratory, students work in teams to apply principles learned in the classroom to solve practical engineering problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習各項單操設備的運作原理與操作方法，並學習如何應用實際的工程問題。",
      "describe_en": ".Study the operation principles of every mechanical equipment and working technique."
    },
    {
      "seq": 2,
      "describe_ch": "能與實驗夥伴一同溝通並完成化學實驗",
      "describe_en": "Be able to realize and illustrate the chemical experimental techniques"
    },
    {
      "seq": 3,
      "describe_ch": "能自行撰寫實驗報告並口頭報告實驗內容與結果。",
      "describe_en": "Be able to analyze the data from experimental."
    },
    {
      "seq": 4,
      "describe_ch": "具備作業安全與專業倫理觀念。",
      "describe_en": "Possess awareness of operational safety, professional ethics"
    }
  ],
