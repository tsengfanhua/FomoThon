  "description": {
    "sub_id3": null,
    "sub_name": "世界經濟—地緣政治與區域經濟",
    "sub_ename": "WORLD ECONOMIES - GEOPOLITICS AND REGIONAL ECONOMIES",
    "describe_ch": "本課程將從社會學的角度，介紹全球各大經濟體的發展路徑與特質，並剖析當前關鍵的政治、經濟與社會議題。結合循序漸進的講授、討論與學期報告，本課程希望培養學生參與世界經濟的基本素養與能力。",
    "describe_eh": "This course will introduce the development paths and characteristics of the world's major economies from the perspective of sociology, and analyze the current key political, economic and social issues. Combining step-by-step lectures, discussions and term reports, this course hopes to rich students' basic literacy and ability to participate in the world economies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "掌握世界經濟與地緣政治變化趨勢",
      "describe_en": "Understand the changing trends of the world economy and geopolitics."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解全球與區域經濟發展重要議題",
      "describe_en": "Understand important issues of global and regional economic development"
    },
    {
      "seq": 3,
      "describe_ch": "具備分析產業變遷的能力",
      "describe_en": "Possess the ability to analyze industry changes"
    }
  ],
