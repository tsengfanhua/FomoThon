  "description": {
    "sub_id3": null,
    "sub_name": "機器學習與應用",
    "sub_ename": "INTRODUCTION TO MACHINE LEARNING AND APPLICATIONS",
    "describe_ch": "機器學習是人工智慧背後的基礎技術，而透過機器學習，電腦可以自動分析數據並進行預測。本課程介紹各種機器學習方法及其應用，修課同學需具備數學、統計與程式撰寫等基礎知識及能力以進行跨領域整合學習。課程目標為建立同學在機器學習的基礎技術，以便於進行各自專業領域的研究。",
    "describe_eh": "Machine learning is a basic technology behind AI. Computer can automatically analyze data and make predictions. This course introduces a series of related topics to the machine learning and its applications. Students should have fundamental knowledge of mathematics, statistics and programming for interdisciplinary studies. The course target is to construct required skills of machine learning, and subsequently students can conduct individual studies in professional fields.",
    "pre_subname": "MATH2012統計學、MATH2011機率論、MATH1053計算機程式",
    "pre_sub_id3": "MATH2012",
    "pre_sub_ename": "MATH2012 STATISTICS、MATH2011 PROBABILITY、MATH1053 COMPUTER PROGRAMMING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能整合數學、機率統計及資訊技術實作機器學習方法並詮釋結果",
      "describe_en": "One can integrate Mathematics, Probability and Statistics as well as Information Technology to implement machine learning method and explain the result."
    },
    {
      "seq": 2,
      "describe_ch": "能透過團隊合作，應用跨領域學習與知識，合作處理實際問題",
      "describe_en": "By the teamwork, one can cooperatively solve practical problems with interdisciplinary learning and knowledge."
    }
  ],
