  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CS02112",
    "sub_id": "48401",
    "scr_dup": "001",
    "sub_title": "學習普通化學知識",
    "sub_title_en": null,
    "sub_describe": "普通化學課程的安排包含化學原理、化學量測與計量、化學命名、物質化學特性與狀態、化學反應、分析方法與相關的應用。對進一步的相關學科的學習有極重要的先備知識，化學本身也是一種實驗的科學，也可奠定對其他學科研究能力。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "普通化學(一)",
    "sub_ename": "GENERAL CHEMISTRY(1)",
    "describe_ch": "課程以原子、分子、離子的構造來說明化學計量，化學反應平衡的相互關係，並介紹原子組成氣體與固體液體的物理化學原理，最終介紹化學鏈結的生成與軌域。",
    "describe_eh": "Optical include Chemical Foundations, Atoms, Molecules, and Ions Stoichiometry, Type of Chemical Reactions and Solution Chemical Gases,Thermochemistry, Atomic Structure and Periodicity, Bonding : General Concepts, Covalent Bonding : Orbitals, Liquids and Solids",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能銜接及應用高中時期的化學課程作為環工專業課程之基礎　",
      "describe_en": "Be able to connect with senior high school chemistry and be applied as a basic knowledge in environmental courses"
    },
    {
      "seq": 2,
      "describe_ch": "能說明化學在工業應用層面的重要性及影響",
      "describe_en": "state the importance and effects of chemistry to industrial application.　"
    },
    {
      "seq": 3,
      "describe_ch": "具備化學的基礎知識",
      "describe_en": "Obtain the fundamental chemistry knowledge　"
    },
    {
      "seq": 4,
      "describe_ch": "讓學生有學習化學相關領域的能力　",
      "describe_en": " Let students to obtain ability to study chemistry-related fields."
    }
  ],
