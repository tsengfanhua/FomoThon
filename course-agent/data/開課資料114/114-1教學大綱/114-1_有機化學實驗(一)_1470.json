  "description": {
    "sub_id3": null,
    "sub_name": "有機化學實驗(一)",
    "sub_ename": "ORGANIC CHEMISTRY LAB.(1)",
    "describe_ch": "學生由有機實驗的基本技術訓練開始：如簡單蒸餾、精餾、水蒸氣蒸餾、真空蒸餾、化學活性萃取、熔點測定、再結晶、昇華等技術。接著進行簡單的有機化學反應。有機實驗室的安全規則會確實地執行。實驗廢棄物的正確處置在整個課程中也會被強調。",
    "describe_eh": "Introduction to the laboratory techniques used in an organic laboratory-simple distillation, fractional distillation, steam distillation, vacuum distillation, chemically active extraction, melting point measurement, crystallization, and sublimation.  Simple organic reactions are performed afterwards. Safety rules for working in an organic laboratory are stressed.  Proper disposal of all experimental wastes is also instructed",
    "pre_subname": "ENGS1016普通化學實驗(一)",
    "pre_sub_id3": "ENGS1016",
    "pre_sub_ename": "ENGS1016 GENERAL CHEMISTRY LAB.(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能與實驗夥伴一同溝通並完成化學實驗　",
      "describe_en": "Be able to realize and illustrate the chemical experimental techniques."
    },
    {
      "seq": 2,
      "describe_ch": "能自行撰寫實驗報告。",
      "describe_en": "Be able to analyze the data from experimental."
    }
