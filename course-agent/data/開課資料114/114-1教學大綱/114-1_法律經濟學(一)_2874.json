  "description": {
    "sub_id3": null,
    "sub_name": "法律經濟學(一)",
    "sub_ename": "LAW AND ECONOMICS(1)",
    "describe_ch": "從經濟學的角度看法律的原則，也就是以經濟模型對法律原則作經濟分析，探討是否有效率。上學期主要的內容有：歐美法律簡介、財產經濟學、契約經濟學等。",
    "describe_eh": "This course uses Economics to help us to view laws as incentives for changing behavior, and as instruments for policy objectives, efficiency and distribution. Several topics will be covered in the first semester, such as introduction to law and legal institution, economic theory of property, and economic theory of contract.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道法律與經濟的差別",
      "describe_en": "Knowledge for the difference between  Law and Economics."
    },
    {
      "seq": 2,
      "describe_ch": "理解外部性需要法律的介入",
      "describe_en": "Comprehension for reasons why externalities need government intervention."
    },
    {
      "seq": 3,
      "describe_ch": "應用公共財理論在法律上",
      "describe_en": "To Apply public goods theory to law."
    }
  ],
