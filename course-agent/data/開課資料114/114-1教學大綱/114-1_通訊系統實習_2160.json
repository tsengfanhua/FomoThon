  "description": {
    "sub_id3": null,
    "sub_name": "通訊系統實習",
    "sub_ename": "COMMUNICATION SYSTEM LAB.",
    "describe_ch": "本實習課程以軟體來模擬類比通訊系統中各種調變與解調變的方式。實習內容除了可以和通訊理論相互映證，並可以從實習的過程中藉著觀察時頻、域的波形來瞭解各個重要元件的功能再而學習如何建構一個調變與解調變的系統。另且，實習中也以音訊信號為例，藉由聽覺來感受系統的運作過程。",
    "describe_eh": "The Lab. adopts software to simulate various modulation and demodulation formula in analog communication systems. By observing waveforms in both time and frequency domains during simulations, contents can be used not only to verify communications theory but also to recognize functions of important devices and learn how a modulation/demodulation system being established. Besides, audio signals are applied as examples so that the processing of a system can be feel by hearing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能藉由實習來驗證通訊原理並瞭解如何應用各個基本元件來建構一個調變與解調變系統。",
      "describe_en": "Be able to verify the communication principles and understand how to establish a modulation/demodulation system using basic elements."
    },
    {
      "seq": 2,
      "describe_ch": "能就實習結果的時、頻域波形與相關數據進行分析與詮釋。",
      "describe_en": "Be able to analyze and interpret experiments’ results from waveforms observed and related data."
    }
  ],
