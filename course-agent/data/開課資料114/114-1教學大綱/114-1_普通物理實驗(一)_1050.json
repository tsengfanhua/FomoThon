  "description": {
    "sub_id3": null,
    "sub_name": "普通物理實驗(一)",
    "sub_ename": "GENERAL PHYSICS LAB.(1)",
    "describe_ch": "普通物理實驗(一)共安排12項實驗，除了力學與熱力學之外，還有基礎測量工具的使用。學生於普通物理課程中所學的理論知識，在此課程中將以實驗方式證明；並訓練學生動手操作儀器，及整理數據、分析數據的能力。實施創新教學的實驗設計。",
    "describe_eh": "In General Physics Experiment (1), a total of 12 experiments are arranged. In addition to mechanics and thermodynamics, there are also the use of basic measurement tools. The theoretical knowledge that students have learned in the general physics course will be proved by experiments in this course; and the students will be trained to operate the instrument, and the ability to organize and analyze the data. The experimental design of innovative teaching is implemented.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉科學探究方法，並體會科學精神。\t",
      "describe_en": "1.Be familiar with scientific enquiry methods, and comprehend the culture of scientific society."
    },
    {
      "seq": 2,
      "describe_ch": "配合普通物理(一)課程，親身體驗所學之力學與熱力學原理。",
      "describe_en": "\t2.Experience the phenomena of mechanics and thermodynamics discussed in general physics course"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解基礎測量工具之原理，並能正確使用基礎測量工具。\t",
      "describe_en": "3.Undersatnd the principle of basic instruments and be able to operate them correctly."
    },
    {
      "seq": 4,
      "describe_ch": "能夠應用電腦處理實驗數據。\t",
      "describe_en": "4.Be able to use computer to organize and to analysis the experimental data"
    }
  ],
