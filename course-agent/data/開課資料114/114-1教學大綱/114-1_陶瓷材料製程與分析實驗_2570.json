  "description": {
    "sub_id3": null,
    "sub_name": "陶瓷材料製程與分析實驗",
    "sub_ename": "EXPERIMENTS OF CERAMIC PROCESSING AND ANALYSIS",
    "describe_ch": "針對精密陶瓷與陶瓷材料的基本製程技術及常用之材料分析量測方法，設計幾項相關的實驗課題如溶膠凝膠法製作高純度奈米陶瓷粉體、陶瓷燒結及檢測、靜電紡絲製程、陶瓷複合材料的FTIR分析，幫助學生加深動手操作材料實驗的經驗，並瞭解相關之陶瓷材料製程與分析之實務。",
    "describe_eh": "Students are guided to explore a few fundamental processing techniques and analytic methods regarding to advanced ceramics. They will practically acquire many hand-on experiences regarding to aspects of high purity ceramic powder fabrication via sol-gel process, ceramic sintering and post-sintering analysis, ceramic and polymer composite nanofibers by electrospinning process, and use of FTIR technique to measure the functional groups of ceramic composites.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解陶瓷材料之實驗與計畫管理技巧，並能實際評價陶瓷材料之應用向面。",
      "describe_en": "To synthesize developments and technical frontiers for the ceramic materials and key concepts of the applications in our daily life and industrial activities."
    },
    {
      "seq": 2,
      "describe_ch": "以書面或口頭報告方式，對於所獲之技術論文及研發結果與同學及教師陳述溝通。\t",
      "describe_en": "To synthesize verbal and written capability as discussing or explaining the technical context and R&D results of the subject of electronic ceramics to the peers and the instruc"
    },
    {
      "seq": 3,
      "describe_ch": "針對陶瓷材料的基本製程技術及常用之材料分析量測方法，設計實驗課題。\t",
      "describe_en": "To understand the basic measurement, analysis, and design experiments of ceramic materials."
    },
    {
      "seq": 4,
      "describe_ch": "了解各種實驗所需安全注意事項與專業責任感。",
      "describe_en": "To understands experimental safety issues and professional responsibility."
    }
  ],
