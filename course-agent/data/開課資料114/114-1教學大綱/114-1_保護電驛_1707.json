  "description": {
    "sub_id3": null,
    "sub_name": "保護電驛",
    "sub_ename": "PROTECTION RELAY",
    "describe_ch": "本課程提供實用保護電驛內容，含各式保護電驛基本原理、設定計算等等，為加強學習效果，本課程另用補充技術資料教授高壓電力系統設計藉以配合保護電驛之實際運用，本課程含相關實驗教學與實作專題以加強學習成效。",
    "describe_eh": "This course provides a practical account of protective relaying, such as: principles, setting calculations, etc. In addition, technical data are also supplemented to incorporate the feasible applications of the relays. Experiments and project are also included in the course to aid comprehension.",
    "pre_subname": "PHYS1003普通物理(一)、PHYS1004普通物理(二)",
    "pre_sub_id3": "PHYS1003",
    "pre_sub_ename": "PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建立能力應用保護電驛中後衛保護、差動電驛、匹配變壓器、反時間曲線、保護協調等等",
      "describe_en": "Be able to apply back-up protection, differential relays, matching transformer, inverse-time curve, protection coordination, etc."
    },
    {
      "seq": 2,
      "describe_ch": "理解保護電驛的電路，並能清楚表達。",
      "describe_en": "Comprehend the circuits of the protective relays."
    },
    {
      "seq": 3,
      "describe_ch": "知道於何處可找到保護電驛壓系統的相關資訊、研究結果及標準，並可評估所獲資訊的適。",
      "describe_en": "Know where to locate and access protective relays information, research, as well as standards, and be able to evaluate the appropriateness of the obtained information."
    },
    {
      "seq": 4,
      "describe_ch": "能針對一特定型式保護電驛議題，設計合理的分析，並適切歸納出結論。",
      "describe_en": "Design reasonable analysis for a specific protective relay topic, and draw appropriate conclusions."
    }
  ],
