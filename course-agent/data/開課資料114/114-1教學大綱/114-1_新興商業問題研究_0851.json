  "description": {
    "sub_id3": null,
    "sub_name": "新興商業問題研究",
    "sub_ename": "STUDIES ON EMERGING BUSINESS ISSUES",
    "describe_ch": "本課程旨在讓學生探索並瞭解當代商業問題與新興商業模式的趨勢及發展，在變動的產業環境下，對於商業未來的創新變革，能有更多的想像與規劃，同時界定經營管理層面可能面臨的問題，並進而思考如何透過科技導入、數據分析等，創造價值、解決問題。",
    "describe_eh": "This course is designed to help students explore and understand emerging business issues. Students are expected to be able to foster the capability of identifying core issues in business and planning business innovations under the changing industrial environment, and in turn to create value as well as provide potential business solutions by introducing new technologies and data science.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "蒐集進階商管專業問題的解決方法",
      "describe_en": "Gather possible solutions to the advanced business and management problems."
    },
    {
      "seq": 2,
      "describe_ch": "提供合適的進階商管專業解決問題方法",
      "describe_en": "Provide proper solutions to the advanced business and management problems based on a well-reasoned rationale."
    }
