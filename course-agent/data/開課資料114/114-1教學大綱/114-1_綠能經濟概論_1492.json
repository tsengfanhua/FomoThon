  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE08139",
    "sub_id": "65205",
    "scr_dup": "001",
    "sub_title": "關於未來綠色能源的發展趨勢",
    "sub_title_en": null,
    "sub_describe": "就不同能源開發的角度予以深度探討",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "綠能經濟概論",
    "sub_ename": "INTRODUCTION TO GREEN ENERGY ECONOMY",
    "describe_ch": "講述未來50年內人類可能遇到的能源危機以及目前氣候變遷可能的成因，使學生了解到能源、環境與自身息息相關，進而關心環境保護的議題及節約能源的重要性。本課程亦簡介現階段科學家為解決能源危機而發展的綠色能源科技如：1. 太陽能，2. 風能，3. 生質能，4. 氫能與燃料電池，5. 其他再生能源等，培養學生對綠色能源科技基礎與寬廣的知識。另外，本課程將選定指定閱讀書籍並透過「課堂上分組討論」方式，使同學能進行閱讀心得與觀點的交流，進行同儕的學習。",
    "describe_eh": "The energy crisis that might happen to human beings in the future and the possible reasons for global climate change will be discussed in this course. It can lead students to be more concerned about issues of environmental protection and the importance of energy saving. This course will also present the basic principles of green energy technology and its applications, including solar energy, wind power, biomass energy, hydrogen and fuel cell, and renewable energy etc. There will be a final report to hand in as well as a group presentation in class.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.\t學生能瞭解能源危機的急迫性及使用化石燃料造成氣候變化的影響。",
      "describe_en": "1.\tThe student can understand the importance of energy crisis and the climate change by the effect of using fossil fuel"
    },
    {
      "seq": 2,
      "describe_ch": "2.\t理解國際能源科技趨勢與台灣科技發展重點與問題",
      "describe_en": "2.\tUnderstanding the trend of international energy technology and the important point and problem of Taiwan."
    }
  ],
