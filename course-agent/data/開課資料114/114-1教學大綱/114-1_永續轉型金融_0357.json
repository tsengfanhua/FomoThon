  "description": {
    "sub_id3": null,
    "sub_name": "永續轉型金融",
    "sub_ename": "SUSTAINABLE TRANSITION FINANCE",
    "describe_ch": "根據COP28發布之《公正轉型金融：銀行和保險業之路徑》，設計課程讓學生學習如何整合金融業資源引導企業做永續轉型，內容從永續基本概念、永續資訊揭露、永續風險管理與治理、永續金融到公正轉型等未來金融業的新業務。",
    "describe_eh": "According to the publication of COP28 titled 'Just Transition Finance: Pathways for Banking and Insurance,' design a curriculum to enable students to learn how to integrate financial industry resources to guide businesses in sustainable transformation. The content covers sustainable basic concepts, sustainable information disclosure, sustainable risk management and governance, sustainable finance, and just transition, which are new business areas in the future financial industry.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解永續金融與淨零金融的概念",
      "describe_en": "Knowledge of the concept of sustainable finance and net-zero finance"
    },
    {
      "seq": 2,
      "describe_ch": "分析永續金融評鑑",
      "describe_en": "Understanding sustainable finance assessment"
    },
    {
      "seq": 3,
      "describe_ch": "應用金融協助企業淨零轉型",
      "describe_en": "Capable of applying financial assistance to facilitate corporate net zero transition"
    }
  ],
