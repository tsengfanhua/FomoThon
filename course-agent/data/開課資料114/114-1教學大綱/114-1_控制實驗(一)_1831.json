  "description": {
    "sub_id3": null,
    "sub_name": "控制實驗(一)",
    "sub_ename": "AUTOMATIC CONTROL LAB.(1)",
    "describe_ch": "本課程為「線性控制系統 (1)」之伴隨課程，主要透過實驗印證機電系統之控制效能及線性控制系統理論，並藉此培植學生具備控制系統工程師之養成智識。此外，目前在工業界控制領域中最為廣泛使用之電腦程式輔助設計語言- MATLAB/Simulink，以及圖控式程式語言- LabVIEW，亦納入本課程內容中，使學生熟悉控制工程常用之軟體工具。",
    "describe_eh": "This course deals with practical aspects of control engineering and serves as a companion course to AERO 356 and AERO 357. It offers students a more profound understanding about control theory and the practical real-world applications. The experiments on response of mechanical-electrical servo systems are conducted to verify the correctness and effectiveness about the theory of linear control systems. In addition, the well-known computer-aided control system design software, MATLAB/Simulink, and the graphical programming language from National Instruments, LabVIEW, are also introduced to help students get acquaintance with the software package in control engineering.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建構線性控制系統工程科技之基本概念。",
      "describe_en": "To have a basic knowledge about fundamental concepts in linear control systems."
    },
    {
      "seq": 2,
      "describe_ch": "了解MATLAB/Simulink、 LabVIEW/DAQ及ELVIS+QNET實驗平台的特性與基本架構。",
      "describe_en": "To understand the feature and basic framework of MATLAB/Simulink, ELVIS+QNET experiment platform , and the LabVIEW/DAQ."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉Stability of Linear Control System及Time Domain Response 實驗操作與結果。",
      "describe_en": "To get familiar with the experimental procedures and be able to analyze the experimental results about the stability and the time domain response of linear control systems."
    },
    {
      "seq": 4,
      "describe_ch": "藉由從事實驗與製作報告中了解團隊合作之重要性。",
      "describe_en": "To understand the importance of teamwork and coordination through conducting experiments and finishing group reports."
    }
  ],
