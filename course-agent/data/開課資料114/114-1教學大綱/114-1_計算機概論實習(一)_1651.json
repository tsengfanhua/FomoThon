  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE11111",
    "sub_id": "27441",
    "scr_dup": "001",
    "sub_title": "Office 軟體操作, C語言程式設計",
    "sub_title_en": null,
    "sub_describe": "電腦基本應用操作及應用程式設計",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "計算機概論實習(一)",
    "sub_ename": "THE  PROGRAMMING LABORATORY(1)",
    "describe_ch": "實際上機講解並指派作業演練，訓練電腦的各項基本應用技能以及解決問題的技巧，同時配合計算機概論課程之進度及內容，以上機實做的方式演練各項程式設計的觀念及技術。",
    "describe_eh": "By examining the operations of various applications on computer step by step to accumulate the actual experience about computer usage. Training the techniques of various applications and the methods for resolving problems. Furthermore, the course is scheduled to cooperate with the progress of the course, \"Introduction to Computer Science(1)\", for establishing various techniques of programming.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生能瞭解軟體在計算機系統運作所扮演的角色，以及相關的操作理念。",
      "describe_en": "Comprehension for the techniques about the usage of various applications."
    },
    {
      "seq": 2,
      "describe_ch": "使學生瞭解各種計算機的基本運用技能。",
      "describe_en": "Application for computer software to make students to understand the related issues about computer applications."
    }
  ],
