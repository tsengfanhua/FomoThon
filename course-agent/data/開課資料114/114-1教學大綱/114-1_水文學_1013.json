  "description": {
    "sub_id3": null,
    "sub_name": "水文學",
    "sub_ename": "HYDROLOGY",
    "describe_ch": "本課程探討水文學簡介、氣象，與循環中之降水、流域、蒸發、截留、窪蓄、入滲，以及流量歷線分析、水文統計、水文設計。\r\n",
    "describe_eh": "It addresses principles and practical aspects of hydrology. Topics include introduction to hydrology, meteorology, and precipitation, river basin, evaporation, interception, depression, and infiltration of hydrologic cycle,and hydrograph analysis, statistics, hydrological design, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解水文循環-水在大自然之存在、分佈、運動現象，如降水、蒸發、截留、窪蓄、入滲。",
      "describe_en": "To understand the hydrologic cycle - the existence, distribution, movement  phenomena of water in natural environment. It includes precipitation, evaporation, interception, depression, and infiltration."
    },
    {
      "seq": 2,
      "describe_ch": "認識水文與工程、環境之關係。",
      "describe_en": "To learn the relationship of water/hydrology with engineering design and environment protection"
    },
    {
      "seq": 3,
      "describe_ch": "學習水文分析-雨量資料之校正與補遺、降雨頻率分析、地文因子、入滲曲線分析及設計。",
      "describe_en": "To acquire hydrologic analysis skill, such as precipitation data collection and correction, precipitation distribution and probability analysis, physiographic factors, infiltration curve analysis and design."
    }
  ],
