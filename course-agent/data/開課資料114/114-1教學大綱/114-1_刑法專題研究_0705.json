  "description": {
    "sub_id3": null,
    "sub_name": "刑法專題研究",
    "sub_ename": "SELECTED TOPICS ON CRIMINAL LAW",
    "describe_ch": "介紹刑法理論、故意與過失、因果關係、錯誤、違法性、罪責、既遂與未遂犯理論、共犯責任、競合、認識各個犯罪的構成要件內容、檢察官起訴、審判、上訴與刑之宣判等程序之法律規定",
    "describe_eh": "This course will cover a wide range of mens rea, actus reus, causation, mistake, attempt, inchoate crimes, conspiracy, accomplice liability, a detailed study of specific criminal offenses in the special part of the Taiwan Penal Code, criminal procedure law relating to  the prosecutor's decision to charge, the trial, retrials, and sentencing procedure",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉並了解刑法基本概念",
      "describe_en": "Understand the basic structure of substantive criminal law."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉並了解行為理論、故意與過失、解錯誤、違法性、罪責、既遂與未遂犯理論、共犯責任、競合",
      "describe_en": "Understand the topics of mens rea, actus reus, causation, mistake, attempt, inchoate crimes, conspiracy, accomplice liabilit"
    },
    {
      "seq": 3,
      "describe_ch": "針對刑法內各種犯罪之構成要件進行詳細研究",
      "describe_en": "Detailed study of specific criminal offenses in the special part of the Taiwan Penal Code"
    },
    {
      "seq": 4,
      "describe_ch": "熟悉並了解有關逮捕、搜索、扣押、警察訊問、傳喚訊問、檢察官起訴、審判、上訴與刑之宣判等程序之法律規定與案例",
      "describe_en": "Understand the issue of arrest, search and seizure, police interrogation, investigation by subpoena, the prosecutor's decision."
    }
  ],
