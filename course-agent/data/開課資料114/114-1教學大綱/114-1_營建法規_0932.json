  "description": {
    "sub_id3": null,
    "sub_name": "營建法規",
    "sub_ename": "CONSTRUCTION REGULATIONS",
    "describe_ch": "課程主要內容包含土地利用、營建、採購發包、促進民間參與公共建設、規劃設計監造、環境影響評估、營造安全等法規。引導學生建立以下的能力：(1)了解相關法規的立法背景、目的等相關知識；(2)能在法、理、情的基礎上引用營建法規。",
    "describe_eh": "This is a basic class of construction act and regulation . Including Treaties and Agreements on Government Procurement、Act for urban planning、Act for construction and building、Act for Promotion of Private Participation in Infrastructure Projects。Have learners the following capabilities: (1) the background and aims of  Acts; (2) be able to analyze and utilize Acts.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "對營建法令與規定有完整與清楚的認知。",
      "describe_en": "To know the infrastructure and content of Construction and Building Act."
    },
    {
      "seq": 2,
      "describe_ch": "營建法令與規定的條文解說與案例分析。",
      "describe_en": "Comprehensive instruction the background of Construction and Building Act through case study."
    }
  ],
