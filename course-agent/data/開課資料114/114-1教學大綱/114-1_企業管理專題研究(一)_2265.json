  "description": {
    "sub_id3": null,
    "sub_name": "企業管理專題研究(一)",
    "sub_ename": "THE RESEARCH ON THE ISSUES OF BUSINESS MANAGEMENT(1)",
    "describe_ch": "本課程旨在使同學們如何利用企業研究方法之概念去撰寫論文計劃書。內容包括：研究背景、研究動機、研究目的、文獻探討、研究架構、研究流程、研究設計、資料蒐集、及基本統計方法之介紹。",
    "describe_eh": "The objective of this course is designed to introduce students how to write a thesis by using business research method. The main topics include: research background、motivation、objectives，literature review，research structure, research flowchart, research design ，data collection and basic statistical methods.",
    "pre_subname": "MGT1001管理學、MGT1002企業概論",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT、MGT1002 INTRODUCTION TO BUSINESS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 2,
      "describe_ch": "能以書面及口頭方式將研究結果進行口試並通過。",
      "describe_en": "The synthesis of business and management knowledge to finish writing proposal and pass oral test."
    },
    {
      "seq": 3,
      "describe_ch": "能指出企業經營之相關問題並提出解決計劃。",
      "describe_en": "To be able to point out issues in business and management and propose resolution plan."
    }
  ],
