  "description": {
    "sub_id3": null,
    "sub_name": "倫理思維與永續發展目標",
    "sub_ename": "MORAL THINKING AND SDGS",
    "describe_ch": "本課程以「永續發展目標」（SDGs）為主要課程內容，透過引導對相關議題的倫理思維與道德判斷，協助學習者了解在面對相關問題時如何進行合理的道德判斷，以及促進學習者培養達成永續發展目標幾項關鍵能力。主要將以永續發展目標3、8、11等三項目標為核心，透過模組進行專題式學習，在課程中，教師將以議題融入的方式進行引導，並透過小組討論以及個人的反思回饋，進行學習觀察，並透過專題引導，增進學習者對議題的理解。最後透過學習歷程的製作，引導學習者反思自我累積知識的脈絡，確認在課程中所得，並於期末成果分享，以增進對問題多元的理解。",
    "describe_eh": "This course focuses on the Sustainable Development Goals (SDGs) as the main content. It aims to guide learners in ethical thinking and moral judgment related to relevant issues, helping them understand how to make reasonable moral decisions when facing such challenges. The course also fosters the development of key competencies necessary for achieving the SDGs. The course will primarily focus on SDGs 3, 8, and 11, via modules for thematic learning. Throughout the course, the teacher will guide the students by integrating the issues, and learners will engage in group discussions and personal reflections to observe their learning progress. Through project-based guidance, learners' understanding of the issues will be enhanced. Finally, by creating a learning portfolio, students will be encouraged to reflect on the context of the knowledge they have accumulated, reassure students what they have learned in the course, and share their final results to deepen their understanding of the issues from multiple perspectives.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "引導學習者將生活經驗與永續發展目標連結，以進行道德判斷。",
      "describe_en": "To guide learners to connect their life experiences with the Sustainable Development Goals to make moral judgments."
    },
    {
      "seq": 2,
      "describe_ch": "促進學習者習慣性反思自我判斷的歷程。",
      "describe_en": "To encourage learners to habitually reflect on their process of self-judgment."
    }
  ],
