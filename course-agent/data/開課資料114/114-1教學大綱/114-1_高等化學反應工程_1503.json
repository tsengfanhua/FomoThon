  "description": {
    "sub_id3": null,
    "sub_name": "高等化學反應工程",
    "sub_ename": "ADVANCED CHEMICAL REACTION ENGINEERING",
    "describe_ch": "高等化學反應工程是一門結合質能均衡計算，物理化學，化工熱力學，化工動力學與單元操作等領域的統整性學科。其目的在於訓練學生活用化工基礎課程，以達到實用目的。",
    "describe_eh": "The lecture provides a comprehensive study of chemical reaction engineering, beginning with the basic definitions and fundamental principles, which related in material end energy balances, physical chemistry, chemical thermodynamics, kinetics and transport phenomenon. It emphasizes the real-work aspects of chemical reactor design in industries practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "加強化工動力學之基礎，能讓學生聊解化工動力學之定義及在化學反應中之基本物理意義。　",
      "describe_en": "To intensify the ability of engineering kinetics and to understand the definition of special term and its physical meaning."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生反應器分析與設計能力",
      "describe_en": "To intensify the ability of reactor analysis and design."
    },
    {
      "seq": 4,
      "describe_ch": "培養化學反應工程專業能力，可應用於反應器設計與化學工業製造程序規劃　",
      "describe_en": "To intensify the skills and knowledge of chemical reaction engineering for chemical processes design.　"
    }
  ],
