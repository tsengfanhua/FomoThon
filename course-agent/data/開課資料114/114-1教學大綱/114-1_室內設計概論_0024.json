  "description": {
    "sub_id3": null,
    "sub_name": "室內設計概論",
    "sub_ename": "INTRODUCTION TO INTERIOR DESIGN",
    "describe_ch": "本課程介紹室內設計的內容範圍、基礎理論與基本認知，包含空間與設計語彙、室內設計元素、人體工學、室內物環與材料等，引導學生對室內設計的學習興趣，打開學生的視野，與國際的設計脈動銜接。以主題性的方式來進行，每一主題內容皆包括講授、演講、小組報告，並有一實地參訪，以達成融入課程之主動學習模式。",
    "describe_eh": "This course introduces the content, range, basic theory and knowledge of the interior design, such as space design、interior design elements、ergonomics、internal environment and material etc. This will lead students to have more learning interesting and expand their versions in order to link the international trend. There are several topics to operate during the course. Each topic has one lecture, one speech and team reports. Besides there is a field trip for this course. The aim of this course arrangement is to make students involve in this course as more as possible for developing an active learning mode.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識空間與設計語彙、室內設計元素、人體工學、室內物環與材料。",
      "describe_en": "Understand space design、interior design elements、ergonomics、internal environment and material etc."
    },
    {
      "seq": 2,
      "describe_ch": "知道何處可找到室內設計的相關資訊，並可評估所獲資訊的適用性。",
      "describe_en": "Know where to locate and access related interior design information, and be able to evaluate the appropriateness of the obtained information."
    }
  ],
