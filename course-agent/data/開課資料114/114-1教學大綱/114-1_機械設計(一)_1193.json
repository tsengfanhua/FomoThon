  "description": {
    "sub_id3": null,
    "sub_name": "機械設計(一)",
    "sub_ename": "MACHINE DESIGN(1)",
    "describe_ch": "本課程旨在訓練學生學習選擇適當機械元件的尺寸、形狀、材質，俾能設計出安全無虞的機械。要達到此目的，學生需俱有計算及預估各機械元件破壞的模式及條件，所以負載、應力、變形量計算等基本力學觀念亦會涵蓋在課程中。",
    "describe_eh": "In this course, students will learn to size and shape the parts and choose appropriate materials so that the resulting machine can be expected to perform its intended function without failure.  This requires that students be able to calculate and predict the mode and conditions of failure for each element and then design it to prevent that failure.  This requires that a stress and deflection analysis can be done for each part.  Since stresses are a function of the applied loads, and of the part's geometry, an analysis of the forces, moments, torques, and the dynamics of the system must be done before the stress and deflections can be completed calculated.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解機械設計基本觀念、設計步驟、資料分析及判斷，並應用此知識於常見的機械設備元件。",
      "describe_en": "Provide the concepts, procedures, data and decision analysis techniques necessary to design elements commonly found in mechanical devices and systems."
    },
    {
      "seq": 2,
      "describe_ch": "能俱有應力、變形量、挫曲等力學基礎，同時亦有統計方法做為可靠度及品管分析。",
      "describe_en": "Establish basic techniques of mechanics including stress analysis, deflection , buckling. Also the statistical tools are needed for reliability and quality-control analysis."
    },
    {
      "seq": 3,
      "describe_ch": "能理解破壞理論並與基礎力學整合，俾可設計安全、有品質、可靠的機械元件。",
      "describe_en": "Understand the theory of failure, and integrate the fundamentals of mechanics toward the goal of analyzing and designing mechanical elements to achieve satisfactory levels of safety, quality, reliability, and life."
    },
    {
      "seq": 4,
      "describe_ch": "能設計及分析常見機械元件包括螺絲、彈簧、焊接、齒輪、軸承等。",
      "describe_en": "Be able to deal with the design and analysis of specific mechanical elements such as screws, springs, welded joints, gears, bearings, and the like."
    }
  ],
