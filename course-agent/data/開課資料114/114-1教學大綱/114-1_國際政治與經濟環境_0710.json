  "description": {
    "sub_id3": null,
    "sub_name": "國際政治與經濟環境",
    "sub_ename": " INTERNATIONAL POLITICAL AND ECONOMIC ENVIRONMENT",
    "describe_ch": "該課程國際政治經濟學的目的是要讓學生能普遍涉獵國際政治經濟學。對國際政治經濟學的了解，非常有助於學生對戰略及國際事務的研究，學生亦可透過閱讀與討論中可進一步研擬自己未來研究的方向和主題。",
    "describe_eh": "The course aims to introduce an advance knowledge to the field of international politics and economics. A basic understanding of international politics and economics is essential to cultivate PhD students’ research on strategies and increase their global perspectives. PhD students in this class learn the materials from their reading assignments, discuss and exchange their ideas, and study the topics to design the research proposals which are interesting to them.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養學生對國際政治經濟發展分析的能力",
      "describe_en": "To cultivate students' ability to analyses international political economy."
    },
    {
      "seq": 2,
      "describe_ch": "了解全球政治與經濟趨勢並掌握國際貿易、金融和投資的相關知識",
      "describe_en": "Understand global political and economic trends, and master knowledge of international trade, finance, and investment."
    }
  ],
