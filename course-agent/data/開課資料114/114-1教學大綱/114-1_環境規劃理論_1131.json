  "description": {
    "sub_id3": null,
    "sub_name": "環境規劃理論",
    "sub_ename": "THEORY  OF ENVIRONMENTAL PLANNING",
    "describe_ch": "本課程目的在使同學瞭解環境規劃的基本理論、生態環境規劃理論與環境規劃流程與內容，並能將其應用於環境規劃上。藉由主題規劃操作練習、案例解析與多媒體應用，培養學生實際操作環境規劃案之能力。",
    "describe_eh": "The aim of this course is to let students understand the basic and ecological planning theory, planning scheme and capable to apply the theories to environmental planning practices. Through thematic planning practice, project review and multi-media presentation make students have abilities to implement environmental planning project.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
