  "description": {
    "sub_id3": null,
    "sub_name": "電漿永續應用",
    "sub_ename": "PLASMA FOR SUSTAINABILITY APPLICATIONS",
    "describe_ch": "本課程探討電漿技術如何應用於促進永續發展，其涵蓋電漿基礎知識、電漿產生、電漿應用案例分析，以及電漿技術的永續性評估。課程主題包括：電漿在環境保護、能源生產、材料合成與改性與電漿農業等方面的應用。",
    "describe_eh": "This course explores how plasma technology can be applied to promote sustainable development. It covers fundamental plasma knowledge, plasma generation, case studies of plasma applications, and sustainability assessment of plasma technologies. Topics include the use of plasma in environmental protection, energy production, materials synthesis and modification, and plasma agriculture.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解電漿的基本特性和產生方法。\t",
      "describe_en": "Understand the basic properties of plasma and methods of plasma generation."
    },
    {
      "seq": 2,
      "describe_ch": "了解電漿技術在不同應用的原理。\t",
      "describe_en": "Understand the principles of plasma technology in various applications."
    },
    {
      "seq": 3,
      "describe_ch": "結合電漿技術和其他技術，開發新的永續發展解決方案\t",
      "describe_en": "Combine plasma technology with other technologies to develop new sustainable development solutions."
    },
    {
      "seq": 4,
      "describe_ch": "能夠運用電漿技術解決實際的環境問題。\t",
      "describe_en": "Be able to use plasma technology to solve practical environmental problems."
    }
  ],
