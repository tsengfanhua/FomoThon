  "description": {
    "sub_id3": null,
    "sub_name": "人身保險專題研究",
    "sub_ename": "TOPICS ON PERSONAL INSURANCE",
    "describe_ch": "本課程檢視並討論各種人身保險商品的架構、運作方式以及商品間的差異，這些商品包括人壽保險、萬能壽險、健康保險等，除了傳統的人身保險外，也將涵蓋人身商品革新、外溢保單、實物給付等新型態的保單。",
    "describe_eh": "This course investigates and discusses a variety of personal insurance products, including life insurance, universal life insurance and health insurance. This course will elaborate the structures and the differences of these products. In addition, this course will also cover the innovation of personal insurance products and some other new types of personal insurance products.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能獲悉各種人身保險商品的結構與差異",
      "describe_en": "To understand the structures and differences among personal insurance products."
    },
    {
      "seq": 2,
      "describe_ch": "能理解家庭與個人面對的人身風險",
      "describe_en": "To comprehend personal risk facing the family and the individuals."
    },
    {
      "seq": 3,
      "describe_ch": "能應用人壽保險商品在人身風險管理中",
      "describe_en": "To apply life insurance products in personal risk management."
    }
  ],
