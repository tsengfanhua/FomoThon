  "description": {
    "sub_id3": null,
    "sub_name": "化工永續與工安概論",
    "sub_ename": "SUSTAINABLE CHEMICAL ENGINEERING AND INTRODUCTION TO INDUSTRIAL SAFETY",
    "describe_ch": "本課程之目的在於提供學生基礎化學工程知識，並建立與環境、社會與企業管理的永續發展連結。 與此同時，也欲培養學生的批判性思考、終生學習能力，藉由團隊合作發展學生的創造力和問題解決能力。 另一方面，本課程也教育學生基本毒理學觀念、化學工業?容、有害廢棄物管理、以及實驗寶安全守則與規範。",
    "describe_eh": "The aim of this course is to learn the science of green energy formation, development, and conversion. This course also provides the information of green energy utilization and technology development, including wind energy, thermal solar and PV energy, geothermal, ocean, hydro energy, and biomass energy. The global and Taiwan green energy strategies and climate change related to energy utilization and its solutions are also introduced.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得生活中的化學工程知識，並建立與環境、社會與企業管理的永續發展的連結。",
      "describe_en": "Obtain fundamental knowledge in chemical engineering related to the sustainable development of environmental, social, and corporate governance."
    },
    {
      "seq": 2,
      "describe_ch": "使學生培養思辨能力、終生學習能力與創造力。",
      "describe_en": "Acquire the ability of critical thinking, lifelong learning, and creativity."
    },
    {
      "seq": 3,
      "describe_ch": "教育學生基本毒理學觀念、化學工業內容、有害廢棄物管理、以及實驗室安全守則與規範。",
      "describe_en": "Educate students with basic knowledge in　toxicology, chemical industry, hazardous waste management, and safety regulations in laboratory."
    },
    {
      "seq": 4,
      "describe_ch": "藉由團隊合作培養學生問題解決的技巧",
      "describe_en": "Acquire problem-solving skills through team-work projects."
    }
  ],
