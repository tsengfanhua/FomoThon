  "description": {
    "sub_id3": null,
    "sub_name": "統計學",
    "sub_ename": "STATISTICS",
    "describe_ch": "課程主要內容為：機率理論，常用機率分配介紹，抽樣分配（常態分配、標準常態分配、t分配、卡方分配、F分配、），估計(點估計、區間估計)，假設檢定。\r\n",
    "describe_eh": "Major topics in: probability theory, introduction of probability distribution, sampling distribution (normal distribution, standardized distribution, student-t distribution, chi-square distribution, F distribution), estimate (point, interval), and hypothe test.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 4,
      "describe_ch": "能認識基本統計學概念",
      "describe_en": "To knowing the basis concepts of Statistics.\r\n"
    },
    {
      "seq": 5,
      "describe_ch": "能應用統計的基本分配的內涵與應用",
      "describe_en": "To applied the basic statistic distribution concepts an application.\r\n"
    },
    {
      "seq": 6,
      "describe_ch": "能判斷統計的方法來做基本的估計與檢定工作是否合宜",
      "describe_en": "To evaluate the statistic methods for estimation and hypothesis test."
    }
  ],
