  "description": {
    "sub_id3": null,
    "sub_name": "線性控制系統(一)",
    "sub_ename": "LINEAR CONTROL SYSTEM(1)",
    "describe_ch": "介紹可應用於各種工程系統的回授控制器的設計。涵蓋線性系統、轉移函數、拉氏轉換、動態系統的建模和解、方塊圖、信號流程圖、控制系統的穩定度和時域性能。包括 MATLAB 範例，用於練習使用電腦輔助工具解決控制系統問題。",
    "describe_eh": "This course introduces the design of feedback controller as applied to a variety of engineering systems. Topics covers linear systems, transfer functions, Laplace transforms, modeling and solution of dynamic systems, block diagrams, signal-flow graphs, stability and time-domain performance of control systems. It also includes MATLAB examples to practice the use of computer-aided tools for solving control system problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用數學基礎以瞭解控制系統基本知識",
      "describe_en": "Apply mathematic foundation to understand the basic knowledge about control systems."
    },
    {
      "seq": 2,
      "describe_ch": "理解控制系統各項性能的定義與定理",
      "describe_en": "Comprehension for the definitions or theories of control system performance."
    },
    {
      "seq": 3,
      "describe_ch": "應用模擬分析工具對控制系統完成分析與設計",
      "describe_en": "Application for the simulation tool box to control system analysis and design."
    },
    {
      "seq": 4,
      "describe_ch": "對控制系統具備描述問題、訂定規格、建構模型之各項分析能力",
      "describe_en": "With analysis capability on describe problems, define specifications and construct model for control systems."
    }
  ],
