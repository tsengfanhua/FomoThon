  "description": {
    "sub_id3": null,
    "sub_name": "個人財務規劃",
    "sub_ename": "PERSONAL FINANCIAL PLANNING",
    "describe_ch": "將個人相關的理財工具及觀念做整體性的介紹，包括金錢管理、生涯規劃、保險、證券投資、不動產、跟會、稅務等主題。透過課程的介紹與實務探討，將這些日常生活很容易接觸到的理財工具，了解它們的優缺點，讓學習者具備基本理財分析能力。透過課堂參與及小組討論增進學習效果",
    "describe_eh": "Integrate the concepts of related financial planning into personal financial management. Through the academic rationale and practical cases about each area, students are expected to capture the fundamental skills in managing personal finance. Class participation and case discussion are highly encouraged in the classroom.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能獲得個人財務規劃方面的知識",
      "describe_en": "To understand the overall concepts and theory of personal financial planning."
    },
    {
      "seq": 2,
      "describe_ch": "能理解個人財務規劃相關專業，並引導其具有正確觀念與涵養",
      "describe_en": "Comprehension in personal financial planning profession, and guide it possess right idea and ability to control oneself"
    }
  ],
