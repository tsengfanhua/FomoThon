  "description": {
    "sub_id3": null,
    "sub_name": "財務報表分析與投資決策",
    "sub_ename": " FINANCIAL STATEMENT ANALYSIS AND INVESTMENT DECISION",
    "describe_ch": "本課程引導學生由財務報表分析中了解企業之價值及未來性，說明企業價值評估之要素與方法及企業未來獲利與成長機會之評估。其次探討投資過程中應考慮之要素及如何做出成功的投資決策，冀使學生了解資金配置與運用之道。",
    "describe_eh": "The purpose of this course is enhancing students capture business value and development potential through financial information analysis, identify key factor of business valuation and evaluate future profit and growth opportunities. The course also explore key factors in investment and how to make a successful investment decision, and helping student understand capital allocation and investment.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
