  "description": {
    "sub_id3": null,
    "sub_name": "廢棄物熱處理技術原理與設計",
    "sub_ename": "PRINCIPLE AND DESIGN OF WASTE THERMAL TREATMENT TECHNOLOGY",
    "describe_ch": "熱處理技術為廢棄物處理與再利用之技術主流，廣泛應用於各種廢棄物之處理、循環再利用、或轉化再生能源，本課程主要內容包括廢棄物熱處理技術之原理介紹、質能平衡計算、熱處理單元設計、污染防治單元設計、以及系統整合與成本效益分析等，且為培育本系學生之工程設計與團隊合作能力，提升學生畢業就業競爭能力，本課程將參考實務案例，分組進行熱處理系統之設計實作訓練，並輔以營運操作與管理方式說明，加強本系學生實作能力與實務觀念。",
    "describe_eh": "Thermal technology is the mainstream of waste treatment and reuse technology, it is wildly applied in the treatment and recycling of various waste as well as the conversion of renewable energy. The main contents of this course include the principles of waste thermal treatment technology, mass and energy balance calculation, thermal treatment units design, pollution control units design, system integration and cost-benefit analysis. In order to enhance students’ ability in engineering design, teamwork, and employment competitiveness, this course will take the practical cases as reference and group the students to conduct the design and practice training of thermal treatment system. The operation and management methods and practices will be supplemented to strengthen students' practical ability and practical concepts.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解不同污染物之處理技術原理及應用\t",
      "describe_en": "To understand the principle and applications of different pollutants and treatment technologies."
    },
    {
      "seq": 2,
      "describe_ch": "綜合資料收集、數據整理解析與歸納設計的專業能力，構成專題研究報告\t",
      "describe_en": "To compose a technical report."
    },
    {
      "seq": 3,
      "describe_ch": "應用工圖及各項環境工程之知識進行處理單元之設計\t　",
      "describe_en": "To apply various techniques of engineering drawing and environmental engineering principles on the designs of treatment processes."
    },
    {
      "seq": 4,
      "describe_ch": "理解各處理廠之工程設計與操控策略　　",
      "describe_en": "To understand various treatment plant design and their P&ID strategies."
    },
    {
      "seq": 5,
      "describe_ch": "應用專案管理、團隊合作與溝通協調能力\t",
      "describe_en": "To apply the abilities of project management, effective communication and persuasion."
    },
    {
      "seq": 6,
      "describe_ch": "分析環境問題並構思解決問題的方法\t",
      "describe_en": "To analyze the environmental problems and considering the possible solutions."
    },
    {
      "seq": 7,
      "describe_ch": "關心環境問題並能持續學習與謀求解決方案\t",
      "describe_en": "To care about the environmental problems and seek for solutions by persistent learning."
    },
    {
      "seq": 8,
      "describe_ch": "認知專業倫理與社會道德責任，培養自我管理能力\t",
      "describe_en": "To recognize the professional ethics and society moral responsibility, develop the ability of self-management."
    }
  ],
