  "description": {
    "sub_id3": null,
    "sub_name": "壽險核保與理賠",
    "sub_ename": "LIFE INSURANCE UNDERWRITING AND CLAIM",
    "describe_ch": "依壽險之原理、原則探討壽險經營本質之危險控管的軸心－核保與理賠作業，以期將理論印証於實務，並培養學生未來在產業的競爭力。",
    "describe_eh": "With the principles of life, discussion the nature of the risk control - underwriting and claims, to prove the theory in practice and students in the industry's competitiveness.",
    "pre_subname": "INSU1001保險學、INSU2002保險法",
    "pre_sub_id3": "INSU1001",
    "pre_sub_ename": "INSU1001 INSURANCE、INSU2002 INSURANCE LAW",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能說明與解釋風險管理與保險、金融與法律等專業知識。",
      "describe_en": "Ability to demonstrate professional knowledge of risk management, finance and the laws"
    },
    {
      "seq": 2,
      "describe_ch": "能應用專業知識來解決家庭風險管理與保險的問題。",
      "describe_en": "Ability to make use of the professional knowledge to solve the problems related to the risk management and insurance in household"
    }
  ],
