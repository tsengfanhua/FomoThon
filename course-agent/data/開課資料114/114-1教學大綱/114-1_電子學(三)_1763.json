  "description": {
    "sub_id3": null,
    "sub_name": "電子學(三)",
    "sub_ename": "ELECTRONICS(3)",
    "describe_ch": "以含電子學(一)和電子學(二)為理論基礎，介紹高階電子電路分析與應用，內容包含運算放大器與數位電子二個主題。第一個主題涵蓋了運算放大器的原理與特性、運算放大器在數學運算電路、信號處理、振盪電路、波形產生器、濾波器等之應用。課程第二部分則包括數位系統之簡介、基本邏輯閘電子電路、及各種數位積體電路族群的原理、特性分析與應用，讓學生對電子學和應用電子電路具有完整且較專業的知識與實務經驗。",
    "describe_eh": "Based on the theoretical basis of signal, electronic devices, and analog circuits of Electronics (1) & (2), this course is intended for introducing the advanced electronic circuit analysis and its applications. The course is divided into two parts, the OP Amplifiers and Digital Electronics. In the first half, the theory and practice of OP Amp will be introduced. Further applications, including mathematical operations, converters, comparators, triggers, limiters, Oscillators, waveform generators, and other signal processing circuits, will be covered. In the second half, the topic of Digital Electronics includes binary system, logic gates, and the detailed analysis of logic gate family in digital IC circuits. The student who fulfills the course requirements will have an ability to design, build and test instrumentation circuits.",
    "pre_subname": "AUTO2002電子學(一)、AUTO2003電子學(二)",
    "pre_sub_id3": "AUTO2002",
    "pre_sub_ename": "AUTO2002 ELECTRONICS(1)、AUTO2003 ELECTRONICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用數學基礎以瞭解運算放大器與數位電子學之基本知識。",
      "describe_en": "Apply mathematic foundation to understand the basic knowledge about OP Amps and Digital Electronics."
    },
    {
      "seq": 2,
      "describe_ch": "理解運算放大器與數位電子學各項性能的定義與定理。",
      "describe_en": "Comprehension for the definitions or theories of OP Amps and Digital Electronics performance."
    },
    {
      "seq": 3,
      "describe_ch": "應用模擬分析工具對運算放大器與數位電子學完成分析與設計。",
      "describe_en": "Application for the simulation tools to OP Amps and Digital Electronics analysis and design."
    },
    {
      "seq": 4,
      "describe_ch": "對運算放大器與數位電子學具備描述問題、訂定規格、建構模型之各項分析能力。",
      "describe_en": "With analysis capability on describing problems, defining specifications and constructing model for OP Amps and Digital Electronics."
    }
  ],
