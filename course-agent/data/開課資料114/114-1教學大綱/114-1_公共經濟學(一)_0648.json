  "description": {
    "sub_id3": null,
    "sub_name": "公共經濟學(一)",
    "sub_ename": "PUBLIC ECONOMICS(1)",
    "describe_ch": "公共經濟學是經濟學的一支，主要討論政府(公部門)如何利用政府支出與政府收入政策，來達成它應該扮演的角色；使社會的資源作有效的利用，以及人民的福利達最大。第一學期主要討論政府的支出理論，包括下列主題：如公共財、外部性、公共選擇、成本效益分析、社會保險與福利支出等。",
    "describe_eh": "Public Economics (I) is a field of economics that studies government activities and the alternative means of financing government expenditures. This course develops principles for understanding the role of government in the economy and its impact on resource use and the well-being of citizens. The first semester focuses on the topics of expenditures, such as public good, externalities, public choice, cost benefit analysis, social insurance and expenditure programs.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解私人企業與政府部門所追求的目標不同，亦即市場失靈，及政府的角色與功能。",
      "describe_en": "Understand the difference of objective functions between private and public sector, or understand the reasons of market failure, and the roles of government."
    },
    {
      "seq": 2,
      "describe_ch": "知道政府主要財政支出項目。",
      "describe_en": "Know components of government expenditures"
    },
    {
      "seq": 3,
      "describe_ch": "分析不同支出政策的效果。",
      "describe_en": "Analyze the effect of government expenditure programs."
    }
  ],
