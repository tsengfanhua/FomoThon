  "description": {
    "sub_id3": null,
    "sub_name": "數位信號處理",
    "sub_ename": "DIGITAL SIGNAL PROCESSING",
    "describe_ch": "介紹數位信號處理的基本原理，為後續生醫信號處理的前置課程，因此本課程著重理論基礎，配合電腦習作輔助學習。本課程將先回顧基本數學，和連續信號的時間域和頻率域概念；然後逐章介紹數位信號簡介(包含其優點、應用和限制)，取樣定理和Aliasing觀念、Z Transform、Fourier Transform和頻譜、以及濾波器FIR filter和IIR filter基本原理、頻譜分析觀念介紹。",
    "describe_eh": "The course will introduce the principles of digital signal processing, and it is a preliminary course for biomedical signal processing. In this course we explain DSP including its advantages, applications and limitations. We offer real understanding of the practice and limitations of converting analogue to digital signals; principles and applications of correlation and convolution; the Z Transform, the Fourier Transform and frequency spectrum analysis; basics of digital filters and their application; and an initial introduction to digital filters and their design.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用數學基礎瞭解數位信號處理之基礎時域和頻域相關知識",
      "describe_en": "Apply mathematic foundation to understand the basic knowledge about digital signal processing."
    },
    {
      "seq": 2,
      "describe_ch": "理解類比與離散時間觀念及取樣定理",
      "describe_en": "Comprehension for the definitions or theories of continuous-time and discrete-time concepts and sampling theorem."
    },
    {
      "seq": 3,
      "describe_ch": "理解各類數位系統及信號轉換及分析",
      "describe_en": "Comprehension of all kinds of transforms and analyses for digital systems and signals."
    },
    {
      "seq": 4,
      "describe_ch": " 學習數位濾波器設計原理與應用",
      "describe_en": "Study of design principles and applications for digital filters."
    }
  ],
