  "description": {
    "sub_id3": null,
    "sub_name": "國際財務管理",
    "sub_ename": "INTERNATIONAL FINANCIAL MANAGEMENT",
    "describe_ch": "本課程介紹國際財務管理中的重要理論與市場，並協助學生理解這些成份間的關聯。主要議題包括：多國籍企業、匯率制度與國際貨幣制度、國際收支與經濟變數間之聯結、國際平價條件與匯率預測、外匯衍生性市場、匯率風險管理、國際籌資、國際投資。",
    "describe_eh": "The course introduces knowledge of important theories and markets in the field of International Financial Management, and helps students comprehend connections among them. Main topics include: multinational corporations, foreign exchange and international monetary systems, balance of payments and economic variables, parity theories and forecasts of foreign exchange, foreign exchange derivative markets, foreign exchange exposure management, international financing, and international investing.",
    "pre_subname": "FINA2030財務管理(一)",
    "pre_sub_id3": "FINA2030",
    "pre_sub_ename": "FINA2030 FINANCIAL MANAGEMENT(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
