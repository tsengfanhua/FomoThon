    "sub_ename": "MATHEMATICAL ANALYSIS (1)",
    "describe_ch": "學習高維度空間的座標、變數變換及多重積分、多變數的泰勒展開式、極值、有限制的極值。學習向量微積分及相關應用。",
    "describe_eh": "Study the coordinates, change variables, multiple integrals , Taylor’s series, extreme values, extreme values with constrains and related applications in high-dimensional spaces. Study the vector calculus and related applications",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
