  "description": {
    "sub_id3": null,
    "sub_name": "電子學(一)",
    "sub_ename": "ELECTRONICS(1)",
    "describe_ch": "介紹基礎電子學原理、電子元件特性和分析基本電子電路。課程包括電子學發展史、基礎放大器觀念、二極體和雙極接面電晶體之直流與交流模型分析。",
    "describe_eh": "The course is to introduce the fundamental principles of electronics, electronic devices' characteristics, and electronic circuit analysis. Students will study the history of microelectronics, the basic concepts of semiconductor physics, diodes and bipolar junction transistors. Students who fulfill the course requirements will have the ability to analyze diode circuits and transistor circuits.　",
    "pre_subname": "CEM1006微積分",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解半導體電子元件特性。",
      "describe_en": "Understand the characteristics of semiconductor electronic components. 　"
    },
    {
      "seq": 2,
      "describe_ch": "二極體、雙載子接面電晶體及金氧半場效電晶體之直流分析。",
      "describe_en": "Be able to use the models to analyze the circuits of diodes, bipolar junction transistors and metal-oxide-semiconductor field-effect transistors in DC.　"
    },
    {
      "seq": 3,
      "describe_ch": "訓練學生分析電子電路的能力。",
      "describe_en": "To train students to gain the ability to analyze the electronic circuits."
    }
  ],
