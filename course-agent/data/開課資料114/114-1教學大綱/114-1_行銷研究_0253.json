    "sub_title": "行銷議題研究",
    "sub_title_en": null,
    "sub_describe": "輔導上課學生有能力運用行銷理論與方法，寫出一份讓自己驕傲的行銷研究報告",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "行銷研究",
    "sub_ename": "MARKETING RESEARCH",
    "describe_ch": "運用科學的方法，收集和分析有關行銷研究的資訊，以解決行銷管理決策的問題。其內容包含行銷研究的程序、次級資料、訪問法、觀察法、問卷設計、抽樣方法、個案資料分析、撰寫研究報告等。",
    "describe_eh": "This course teaches how to use scientific methods to systematically collect and analyze marketing related information in order to solve marketing management decisions.",
    "pre_subname": "MGT2020行銷管理、STAT6005多變量分析",
    "pre_sub_id3": "MGT2020",
    "pre_sub_ename": "MGT2020 MARKETING MANAGEMENT、STAT6005 MULTIVARIATE ANALYSIS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用學習到的研究方法進行資料蒐集。",
      "describe_en": "Apply research method learned from the class to collect data."
    },
    {
      "seq": 2,
      "describe_ch": "應用學習到的研究方法撰寫行銷研究計畫。",
      "describe_en": "Apply research method learned from the class to write a marketing research plan."
    }
  ],
