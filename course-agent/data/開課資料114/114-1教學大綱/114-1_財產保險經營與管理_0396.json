  "description": {
    "sub_id3": null,
    "sub_name": "財產保險經營與管理",
    "sub_ename": "PROPERTY & LIABILITY INSURANCE OPERATIONS AND MANAGEMENT",
    "describe_ch": "本課程講授產物保險經營的風險，並介紹各類風險之現行管理工具與最新各種可能的財務工具。主要內容含經營風險分析、產險行銷、核保、理賠、再保安排、巨災風險管理、經營績效分析、承保能力及流動性分析等。",
    "describe_eh": "To satisfy the diverse needs of students, the course achieves flexibility as follows:\r\n1.Interpreting the theory of Property Insurance operation and management at the first 10 weeks.\r\n2.Insurance Company Revenues & Expenses and Financial analysis are introduced for the following 8 weeks.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解保險作業流程、商品間關連性、市場、核保、理賠、投資、精算與風險管理.",
      "describe_en": "Comprehension for the process of insurance operations, the relationship among product, marketing, underwriting, claims, investment, actuarial and risk management."
    },
    {
      "seq": 2,
      "describe_ch": "能應用專題報告，理解溝通能力與團隊合作的重要",
      "describe_en": "To apply the report to understand the importance of communication and team corporation"
    }
  ],
