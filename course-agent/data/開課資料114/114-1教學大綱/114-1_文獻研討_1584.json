    {
      "seq": 1,
      "describe_ch": "分析演講內容的關鍵並培養資料蒐尋、獨立思考的能力。",
      "describe_en": "To analyze the key points in talk and establish the capability of information collection and independent thinking."
    },
    {
      "seq": 2,
      "describe_ch": "理解學術倫理知識與道德責任。",
      "describe_en": "Understand the knowledge of academic ethics and moral responsibility."
    },
    {
      "seq": 3,
      "describe_ch": "藉由碩士論文提案審查培養理論與實務整合的能力。",
      "describe_en": "With the dissertation proposal, establish the capability of synthesizing theory and practical implementation."
    },
    {
      "seq": 4,
      "describe_ch": "知道中外文技術報告之撰寫技巧與口說表達的經驗。",
      "describe_en": "To know the writing skill of technical report and experience of oral presentation."
    }
