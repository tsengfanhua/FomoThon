  "description": {
    "sub_id3": null,
    "sub_name": "產險精算數學(一)",
    "sub_ename": "SHORT-TERM ACTUARIAL MATHEMATICS (1)",
    "describe_ch": "課程包含保險損失資料之精算模型的建立與其應用的理論知識介紹，主要內容有損失過程、保險相關資料的模型建構、模型參數的估計與比較、最適模型的選取等。",
    "describe_eh": "The material develops the knowledge of the theoretical basis of actuarial models and the applications of those models to insurance. This course includes introduction of model process, construction data-dependent distributions, estimation and valuation for parametric models, optimal model selection, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用損失模型方法到保險實務",
      "describe_en": "To utilize the methodologies of loss model to analyze data from an application in an insurance context."
    },
    {
      "seq": 2,
      "describe_ch": "理解適當的模型及進行參數估計",
      "describe_en": "Comprehension for the appropriate model and estimate the parameters."
    }
  ],
