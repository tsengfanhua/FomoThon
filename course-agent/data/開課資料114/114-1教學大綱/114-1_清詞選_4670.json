  "description": {
    "sub_id3": null,
    "sub_name": "清詞選",
    "sub_ename": "SELECTED CI OF THE QING DYNASTY",
    "describe_ch": "本課程聚焦清代詞壇的復興與發展，從清初詞的尊體運動談起，探討詞人在清代如何透過作品大量創作，以及編纂詞選所代表的地域性詞派形成與詞學集團的興起，讓詞重新成為抒情與學術的重鎮。我們將深入清詞的風格特色，包括個人情志的抒發、社會時代的映照、崇古復古的審美取向，以及學人治詞的學術風貌。課程後半將選讀陳子龍、納蘭性德、吳藻、王國維等十三位清詞名家的代表作品，從中領略清詞的多元風貌與詞學演變的深度脈絡。",
    "describe_eh": "This course focuses on the revival and development of Ci during the Qing Dynasty (Qing Ci), beginning with the Zunti Movement (Movement to Reverence the Ci Form) of the early Qing period. Students will examine how Qing poets contributed to the revival of Ci through their extensive writing and by compiling regional Ci anthologies, which led to the formation of regional poetic schools and scholarly groups, ultimately reestablishing Ci as a significant form for both emotional expression and academic study. The course explores in depth the stylistic features of Qing Ci, including the expression of personal sentiments, reflections of social and historical conditions, aesthetic orientations toward revering and reviving classical traditions, and the scholarly approach to Ci composition. The latter half of the course will focus on selected readings from thirteen prominent Qing Ci poets, including Chen Zilong, Nalan Xingde, Wu Zao, and Wang Guowei, through which students will appreciate the diverse expressions of Qing Ci and the profound evolutionary trajectory of Ci.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解清詞復興的歷史背景與詞學發展脈絡，掌握清代詞風與名家風格特色。",
      "describe_en": "To understand the historical background of the Qing Ci revival and the developmental trajectory of Ci, and to master the stylistic characteristics of Qing Ci and the distinctive features of notable poets' works."
    },
    {
      "seq": 2,
      "describe_ch": "培養分析詞作風格與主題的能力，能運用詞學觀念進行閱讀、賞析與簡要評論。",
      "describe_en": "To develop the ability to analyze the style and themes of Ci, and to apply concepts from Ci in reading, appreciation, and concise critical commentary."
    }
  ],
