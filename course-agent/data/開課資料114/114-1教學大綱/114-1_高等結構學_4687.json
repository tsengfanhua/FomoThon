  "description": {
    "sub_id3": null,
    "sub_name": "高等結構學",
    "sub_ename": "ADVANCED STRUCTURAL THEORY",
    "describe_ch": "讓學生有系統地掌握結構分析的理論基礎，課程內容包括矩陣的直接勁度法、柔度法與能量法，並與結構分析程式結合，達到理論與實作並重的學習成果。",
    "describe_eh": "This course provides students with a systematic foundation in structural analysis theories—covering the matrix stiffness method, flexibility method, and energy method—and integrates theoretical learning with structural analysis programming to foster a comprehensive understanding that bridges theory and practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備使用物理學、數學、力學與土木工程知識之相關能力。",
      "describe_en": "Possess the relevant capability to use physics, mathematics, mechanics, and civil engineering knowledge"
    },
    {
      "seq": 2,
      "describe_ch": "應用管理技術、測量、量測、資訊處理等工具，分析方法與軟體，及土木工程材料的能力。",
      "describe_en": "Possess the relevant capability to apply management techniques, survey, measurement, information processing tools, analysis methods and software, as well as civil engineering materials"
    },
    {
      "seq": 3,
      "describe_ch": "具備結構、大地、運輸工程構造物的相關基本設計能力。",
      "describe_en": "Possess the relevant basic design capability for structure, geotechnics and transportation engineering structures"
    }
  ],
