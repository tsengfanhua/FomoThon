  "description": {
    "sub_id3": null,
    "sub_name": "會計學",
    "sub_ename": "ACCOUNTING",
    "describe_ch": "本課程介紹基本會計學原則及觀念，主要包括：會計循環, 現金,應收帳款\r\n、存貨、長期性資產取得及折舊、公司會計、投資、負債及財務報表分析。\r\n",
    "describe_eh": "This course introduces basic accounting principle and concepts. The main topics include accounting cycle, cash, receivable, inventory, plant assets acquisition and depreciation, corporate accounting, investment, liabilities and financial statements analysis。",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂會計學：能描述會計學涵蓋的主要內容，描述現代企業的財務報表及其限制，企業財務狀況的分析。",
      "describe_en": "Students can use their own vocabulary to make a definition of Accounting.  They also are able to describe the content of Accounting.  They can portray modern business financial statements and their limitations.  They have enough capability to analysis"
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明會計在社會及經濟層面的重要性及影響。",
      "describe_en": "Students are able to realize and portray the importance and influence of accounting in society and economic aspects."
    },
    {
      "seq": 3,
      "describe_ch": "能辯識出可應用會計學原理的場合，並能清楚表達。",
      "describe_en": "They can identify and clearly express the application accounting principle situation."
    },
    {
      "seq": 4,
      "describe_ch": "知道在何處可找到會計的相關資訊，研究結果及標準，並可評估所獲資訊的適用性。",
      "describe_en": "Students know where can find accounting related information, standards and research results.  Students also can appraise the accounting information they get which is suitable for use or not."
    }
  ],
