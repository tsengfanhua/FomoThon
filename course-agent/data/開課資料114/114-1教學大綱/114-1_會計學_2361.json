  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CM03111",
    "sub_id": "51800",
    "scr_dup": "001",
    "tpa_score_new": "<div>1.出席情況</div>\n\n<div>2.上下課問答</div>\n\n<div>3.小考</div>\n\n<div>*1-3項占比40%</div>\n\n<div>4.期中考30%</div>\n\n<div>5.期末考30%</div>\n",
    "tpa_score_new_en": null,
    "course_pol": "本班級授課為一般教室之實體上課，力求同學準時上課並攜帶計算機以利題目練習作答，請勿上課時進食，有問題時可進行討論求，另鼓勵同學上台解題作答，營造課堂認真求學環境與態度。",
    "course_pol_en": null,
    "course_rem": "準時上課認真學習",
    "course_rem_en": null,
    "ais_meno": "<div>期望學生在學習評量公正公開務實、提供更佳教學建言</div>\n\n<div>在班上互動積極認真、教學相長、甚至可產生學習互助團隊，為未來高年級之畢業專題做準備</div>\n\n<div>在課程結束後的表現能與高年級之專業課程接軌等</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": "N"
  },
