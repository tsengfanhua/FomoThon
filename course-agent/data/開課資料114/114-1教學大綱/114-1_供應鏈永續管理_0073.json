  "description": {
    "sub_id3": null,
    "sub_name": "供應鏈永續管理",
    "sub_ename": "SUPPLY CHAIN SUSTAINABILITY MANAGEMENT",
    "describe_ch": "ESG為當前全球企業最關注的趨勢，未來企業供應鏈將走向ESG永續議題為目標，透過本課程介紹與實務演練，從上下游供應鏈管理下手，建立可串連的企業管理模式，了解碳盤查與永續供應鏈執行與實務，成功邁向永續轉型及低碳經濟新模式。",
    "describe_eh": "ESG is the current trend that global companies are most concerned about. In the future, corporate supply chains will move toward ESG sustainability issues. Through the introduction and practical exercises of this course, we will start from upstream and downstream supply chain management to establish a connected corporate management model and understand Carbon inventory and sustainable supply chain execution and practice have successfully moved towards sustainable transformation and a new low-carbon economic model.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認知全球永續供應鏈管理的發展重點與內涵",
      "describe_en": "Understand the development focus and connotation of global sustainable supply chain management"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解當前永續供應鏈管理發展趨勢與重點",
      "describe_en": "Understand the current development trends and priorities of sustainable supply chain management"
    },
    {
      "seq": 3,
      "describe_ch": "企業導入供應鏈實務面面觀，包含：供應商行為準則、管理執行架構、淨零挑戰等",
      "describe_en": "Practical aspects of corporate ESG introduction, including: supplier code of conduct, management execution structure, net zero challenge, etc."
    }
  ],
