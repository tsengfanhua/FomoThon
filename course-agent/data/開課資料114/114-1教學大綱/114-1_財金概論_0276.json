  "description": {
    "sub_id3": null,
    "sub_name": "財金概論",
    "sub_ename": "INTRODUCTION TO FINANCE",
    "describe_ch": "本課程希望協助同學對財務金融概念與財金相關行業（銀行業、證券業與保險業）能有基本的認知；同時，也希望透過本課程將財金相關證照與投資模擬競賽的資訊介紹給同學。",
    "describe_eh": "The objective of this course is to help students to learn about basic concepts of finance and introduction of banks and other financial institutions. Moreover, this course also introduces important information regarding financial related licenses and simulated investment competitions to students.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知道財金基本概念與財金相關行業",
      "describe_en": "Knowledge for basic concepts of finance and introduction of banks and other financial institutions"
    },
    {
      "seq": 2,
      "describe_ch": "能理解財金相關證照與投資模擬競賽",
      "describe_en": "Comprehension for financial related licenses and simulated investment competitions"
    }
