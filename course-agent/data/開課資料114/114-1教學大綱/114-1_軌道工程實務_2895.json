  "description": {
    "sub_id3": null,
    "sub_name": "軌道工程實務",
    "sub_ename": "RAILWAY ENGINEERING PRACTICES",
    "describe_ch": "此課程主要講授軌道於工程階段的專業知識，有助於學生於軌道專業學習之初，先了解軌道建設之路網規劃，並針對軌道發展的工程階段所需的程序進行說明，讓學生清楚了解軌道推動所需的程序以及各項專業，故本課程可讓學生初步認知軌道工程的各項專業，並了解各項專業間的先後關係，將有助於學生後續的軌道專業學習。",
    "describe_eh": "This course aims at teaching railway fundamental knowledge on the engineering in order to understand the network planning of railway engineering in the first stage as well as clearer cognition of railway for students. Then, the course aims at presenting the application process and profession of railway engineering. Therefore, this course would integrate the different professional knowledge of railway engineering in order to promote railway talent training.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備運輸與物流知識、解析時事議題及運用專業知識解決問題之能力",
      "describe_en": "Knowledge of transportation and logistics, ability to resolve current issues and apply professional knowledge to solve problems."
    },
    {
      "seq": 2,
      "describe_ch": "具備透過多元觀點發現、解析或評估運輸與物流問題之認知能力。",
      "describe_en": "The ability to identify, analyze, or evaluate transportation and logistics problems from multiple perspectives."
    }
  ],
