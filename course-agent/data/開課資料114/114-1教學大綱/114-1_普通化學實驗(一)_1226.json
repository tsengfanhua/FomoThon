  "description": {
    "sub_id3": null,
    "sub_name": "普通化學實驗(一)",
    "sub_ename": "GENERAL CHEMISTRY LAB.(1)",
    "describe_ch": "普化實驗課程內容之安排，以闡明基要之化學原理、實驗技巧、儀器操作、數據分析、結果討論為目的。化學藥品採用毒性低且實驗室常用者。實驗題材乃選取能激發學生求知興趣、磨練學生實驗精神及增進學生對周遭事物適當關切者為主。",
    "describe_eh": "The topics of general chemistry lab are arranged for the purpose on illustrating chemical principles, experimental technique, instrument operation, data analysis, results and discussions. Chemicals chosen for the class are based on the consideration of the low toxicity and the commonly used in the lab. Materials chosen for the class are mainly considered to encourage students to be interested in the knowledge of the class, the spiritual attitude on exercises and to care about the surrounding affairs.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解並說明化學實驗技巧。",
      "describe_en": "Be able to realize and illustrate the chemical experimental techniques."
    },
    {
      "seq": 2,
      "describe_ch": "能自行分析化學實驗數據。",
      "describe_en": "Be able to analyze the data from chemical experimental."
    },
    {
      "seq": 3,
      "describe_ch": "能自行撰寫化學實驗報告。",
      "describe_en": "Be able to write the report of chemical experimental."
    },
    {
      "seq": 4,
      "describe_ch": "能與實驗夥伴一同溝通並完成化學實驗。",
      "describe_en": "Be able to discuss with partner and finish the chemical experimental."
    }
  ],
