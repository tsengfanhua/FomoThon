  "description": {
    "sub_id3": null,
    "sub_name": "全球環境危害",
    "sub_ename": "GLOBAL ENVIRONMENTAL HAZARDS",
    "describe_ch": "災害地理學針對各種自然環境的災害類型及區域進行探討，同時納入自然及人文之交互影響及相對應之風險與脆弱模式，並分析社群如何感知風險暴露之危險性。本課程從地理學的角度出發，研究環境危害的特徵與分佈、風險及脆弱度指標，並建立災害應變、災害調適之觀念。",
    "describe_eh": "Hazard geography studies places and regions where people live in potentially hazardous situations. It describes how interacting natural and human factors influence and change patterns of risk and vulnerability and seeks to analyse how communities perceive and manage their exposure to hazards. Analyses of landuse, settlement and demographic patterns in these contexts are featured. The unit develops a practical understanding of hazard geography using solid conceptual and skills frameworks. Emphasis is on natural hazards and technological hazards. The development and application of geographical skills will be important. A detailed program and unit outline will be available at the beginning of the semester.\r\nThis course takes a geographical perspective to investigate the characteristics and distribution of environmental hazards, patterns of risk and vulnerability, and how people perceive, manage and adjust to hazardous environments.\r\nTo successfully complete this unit, students need to demonstrate satisfactory competencies in: 1) Gaining knowledge of the geography of hazardous landscapes, including how the interacting elements of risk, vulnerability, hazard/risk perception and hazard management create distinctive landscapes; 2) Researching, interpreting and synthesizing information relevant to hazard identification and management from a variety of sources; 3) Analysing hazardous landscapes and hazard management from a geographical perspective using applicable information and methods; and applying outcomes to decision-making; 4) Communicating knowledge, interpretations and analyses in written and graphical forms.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解災害地理的相關知識，包括風險、脆弱度、風險感知及風險管理",
      "describe_en": "Gaining knowledge of the geography of hazardous landscapes, including how the interacting elements of risk, vulnerability, hazard/risk perception and hazard management create distinctive landscapes."
    },
    {
      "seq": 2,
      "describe_ch": "研究、應用、解釋並歸納各種來源提供災害辨識及管理的相關資訊",
      "describe_en": "Researching, Applying, interpreting and synthesizing information relevant to hazard identification and management from a variety of sources."
    },
    {
      "seq": 3,
      "describe_ch": "應用適當的資訊及方法從地理學角度分析地形及災害管理，並應用於調適決策制定",
      "describe_en": "Analysing hazardous landscapes and hazard management from a geographical perspective using applicable information and methods; and applying outcomes to adaptive decision-making."
    },
    {
      "seq": 4,
      "describe_ch": "知識的交流、解釋、評估及分析",
      "describe_en": "Communicating knowledge, interpretations, evaluation and analyses in written and graphical forms."
    }
  ],
