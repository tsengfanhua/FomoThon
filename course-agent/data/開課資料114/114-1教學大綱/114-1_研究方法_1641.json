  "description": {
    "sub_id3": null,
    "sub_name": "研究方法",
    "sub_ename": "RESEARCH METHODS",
    "describe_ch": "此課程乃建設學院碩士班碩一上的共同必修課，內容分兩部分：第一部分乃大班制，由院長帶領，聘請大師級專家到校演講，並不定期實地觀摩，以激發碩士生學習熱情，並指引可行的學習目標及方向。第二部分分至各系專業，由各系主任，根據各系研究工具及內涵之不同而以專題討論方式帶領。",
    "describe_eh": "This is a common required course for first-year master students in Collage of Construction and Development. There are two parts in the course: the first is a large class led by the dean, where experts will be invited to give speeches, and occasional field observations will also be arranged. This stimulates the students’ passion to learn and guides them towards feasible learning goals. The second part will be distributed to all departments based on their profession, where directors from each department will lead by seminar discussions based on different research tools and connotation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "提升學生視野，始能勇於創新與獨立思考",
      "describe_en": "To broaden student’s view and embolden them to be innovative and think independently."
    },
    {
      "seq": 2,
      "describe_ch": "能以環境永續觀點評視所有的建設規則。",
      "describe_en": "To be able to observe and judge all construction rules with views of environmental sustainability."
    },
    {
      "seq": 3,
      "describe_ch": "對不同尺度之國土建設有基本的專業知識。",
      "describe_en": "To have fundamental expertise in different scales of national land constructions."
    }
  ],
