  "description": {
    "sub_id3": null,
    "sub_name": "系統動力學",
    "sub_ename": " SYSTEM DYNAMICS",
    "describe_ch": "本課程內容在使學生理解系統動力學的理論基礎與建模方法，獲得系統動態概念、發展適當的模擬模型以及使用模型進行決策分析所需的知識和技能。本課程的核心是了解資訊回饋和循環因果關係，建立學生對生產策略與系統反饋之間因果關係的整體理解能力。",
    "describe_eh": "This course aims to guide students to acquire knowledge and skills required to build system dynamics concepts, develop appropriate simulation models, and use models for decision making and policy analysis. The core of this course is to understand the significance and usefulness of information feedback and circular causality in comprehending the intelligent manufacturing and engineering management systems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解系統動力學的理論基礎與建模方法",
      "describe_en": "Understand the theoretical basis and modeling methods of system dynamics"
    },
    {
      "seq": 2,
      "describe_ch": "建立學生對生產策略與系統反饋之間因果關係的整體理解能力",
      "describe_en": "Build students' overall understanding of the cause-and-effect relationship between production strategies and system feedback"
    },
    {
      "seq": 3,
      "describe_ch": "能運用系統思考方法分析問題與對策",
      "describe_en": "Ability to use systems thinking methods to analyze problems and identify solutions"
    },
    {
      "seq": 4,
      "describe_ch": "能使用系統動力學模擬工具建立生產系統的動態模型",
      "describe_en": "Ability to use system dynamics simulation tools to build dynamic models of production systems"
    }
  ],
