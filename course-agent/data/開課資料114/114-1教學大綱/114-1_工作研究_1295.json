  "description": {
    "sub_id3": null,
    "sub_name": "工作研究",
    "sub_ename": "WORK STUDY",
    "describe_ch": "使學生了解工作研究的原則、實施的步驟，而得到最經濟有效的方法，經制定而為標準工作方法，並賦予標準時間而實施績效管理。包括下列內容：工作研究導論，創造性思考法，價值工程，5 S 改善活動，工作研究實施步驟，程序分析 / 動作分析，時間研究，寬放 / 評比，預定時間系統，工作抽查，製程分析改善技術，工作設計，績效管理。\r\n",
    "describe_eh": "To give the student a fundamental understanding of the principles of work study, the steps of implementation and obtain the most efficient way, then set up the standard method and standard time and implement performance management. The following topics are included: introduction to work study, the methods of creative thinking, value engineering, 5S, the steps of work study, process analysis, operation analysis, time study, rating and allowance, predetermined time system, work sampling, the technology of process improvement, work design, performance management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 2,
      "describe_ch": "能有計畫的使用相關方法分析技術，分析完成一案例並提出其新的方法，且能比較其效率。",
      "describe_en": "Be able to the plan use related method analysis techniques to finish a case study and draw another new improving method and compare the efficiency each other."
    },
    {
      "seq": 3,
      "describe_ch": "能使用相關標準時間衡量技術，測定完成一案例及具有國際觀。",
      "describe_en": "Be able to use related standard time measurement techniques to measure and finish a case study and has the international view."
    },
    {
      "seq": 4,
      "describe_ch": "能以書面及口頭方式將所獲結果與同學及教師溝通。",
      "describe_en": "Communicate results in written and oral form to classmates and the instructor."
    },
    {
      "seq": 5,
      "describe_ch": "以小組討論方式深入探討方法研究與時間研究。",
      "describe_en": "Research and time to study in depth through group discussions to explore ways."
    }
  ],
