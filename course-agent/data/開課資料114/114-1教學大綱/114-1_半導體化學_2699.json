  "description": {
    "sub_id3": null,
    "sub_name": "半導體化學",
    "sub_ename": "SEMICONDUCTOR CHEMISTRY",
    "describe_ch": "本課程是一門介紹半導體化學基本知識和原理的課程，以基礎化學為主要。學生將從課程內容學習半導體化合物的相關知識，包括：化合物命名、原子結構、化學鍵結、分子結構、化學反應和化學平衡等基礎半導體化學原理。",
    "describe_eh": "This course is an introduction to the basic knowledge and principles of semiconductor chemistry with an emphasis on fundamental chemistry. Students will learn the associated knowledge of semiconductor compounds, including basic semiconductor chemistry principles such as compound naming, atomic structure, chemical bonding, molecular structure, chemical reactions, and chemical equilibrium through course content.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解組成半導體物質的基礎概念",
      "describe_en": "To understand the basic concepts of the composition of semiconductor materials."
    },
    {
      "seq": 2,
      "describe_ch": "描述半導體化合物的組成概念",
      "describe_en": "To describe the concept of semiconductor compounds."
    },
    {
      "seq": 3,
      "describe_ch": "應用化學鍵結和分子結構建構半導體化合物",
      "describe_en": "To apply chemical bonding and molecular structure to the construction of semiconductor compounds."
    }
  ],
