  "description": {
    "sub_id3": null,
    "sub_name": "工程最佳設計",
    "sub_ename": "OPTIMAL DESIGN IN ENGINEERING",
    "describe_ch": "本課程內容主要為教授學生瞭解最佳設計理論、數學模型建立、無限制/有限制最佳化方法等，並能夠撰寫計算機程式和搭配MatlabOptimizationToolbox，來解決最佳化設計問題。培養學生運用最佳化方法解決工程設計問題與研究。",
    "describe_eh": "The content of this course is mainly optimal design theories, mathematical model building, unconstrainted/constrainted optimization methods, etc., and to be able to develop computer programs and use Matlab Optimization Toolbox to solve optimization design problems. The students can use optimization methods to solve engineering design problems and research.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解最佳化設計理論",
      "describe_en": "Understand optimal design theories"
    },
    {
      "seq": 2,
      "describe_ch": "工程問題轉化成最佳化問題",
      "describe_en": "Convert engineering problems into optimization problems"
    },
    {
      "seq": 3,
      "describe_ch": "發掘問題關鍵，設計最佳化模型",
      "describe_en": "Dicover the key of problem and design the optimal model"
    },
    {
      "seq": 4,
      "describe_ch": "發展計算機程式解決最佳化問題",
      "describe_en": "Develop computer programs to solve optimization design problems"
    }
