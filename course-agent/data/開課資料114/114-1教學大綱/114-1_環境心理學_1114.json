  "description": {
    "sub_id3": null,
    "sub_name": "環境心理學",
    "sub_ename": "ENVIRONMENTAL PSYCHOLOGY",
    "describe_ch": " 本課程從個人心理逐步探討人與環的關係: 人與空間的關係，人與都市、人與社會、人與文化的關係。",
    "describe_eh": "This course investigates the relationship between people and the environment which include the relationship between people and the built environment, people and city, people and society as well as people and culture.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養學生具備基本環境心理學知識",
      "describe_en": "Equip e students with the basic knowledge of environmental psychology"
    },
    {
      "seq": 2,
      "describe_ch": "讓學生了解人與環境的關係",
      "describe_en": "Increase students’ understanding of the relationship of human beings and the environment"
    },
    {
      "seq": 3,
      "describe_ch": "強化學生環境社會與文化認知",
      "describe_en": "To enhance students’ environmental cognition"
    }
