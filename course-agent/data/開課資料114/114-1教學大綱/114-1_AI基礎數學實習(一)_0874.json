  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生理解以及應用線性方程式系統、矩陣與行列式。",
      "describe_en": "Enable students to understand and apply linear equation systems, matrices and determinants."
    },
    {
      "seq": 2,
      "describe_ch": "使學生理解向量空間、內積空間、線性轉換、特徵值和特徵向量。",
      "describe_en": "Enable students to understand vector space, inner product space, linear transformation, eigenvalues and eigenvectors."
    }
