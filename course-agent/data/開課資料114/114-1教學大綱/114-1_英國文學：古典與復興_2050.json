      "seq": 1,
      "describe_ch": "具備歐美文學的基礎知識。",
      "describe_en": "To be equipped with basic knowledge of European and American literature"
    },
    {
      "seq": 2,
      "describe_ch": "理解西洋文化的主要內涵。",
      "describe_en": "To understand the main content of western culture"
    }
