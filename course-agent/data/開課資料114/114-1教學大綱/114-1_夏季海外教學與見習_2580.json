  "description": {
    "sub_id3": null,
    "sub_name": "夏季海外教學與見習",
    "sub_ename": "SUMMER OVERSEAS LEARNING AND EXPLORATION",
    "describe_ch": "本課程會依照不同國家、不同院校之特色，安排材料科學相關專業知識教育與實習，舉例來說，位於福岡的九州大學將提供完善的電漿鍍膜儀器設施供學生實際操作且具備書香氣息濃厚的學習氛圍，除了預期學生將會習得更多、更深、更廣的專業知識外，也必定贏得兩校與兩系之間的友誼。\n",
    "describe_eh": "This course will arrange material science-related professional knowledge education and internships according to different countries' characteristics and institutions. For example, Kyushu University in Fukuoka will provide complete plasma coating equipment for students to operate and have a strong academic flavor. In addition to the expectation that students will acquire more, deeper and broader professional knowledge, the learning atmosphere of the school can win the friendship between the two schools and the two departments.\n",
    "pre_subname": "MSE2002材料基礎實驗(一)、MSE2012材料基礎實驗(二)、MSE1000材料科學導論(一)、MSE1010材料科學導論(二)",
    "pre_sub_id3": "MSE2002",
    "pre_sub_ename": "MSE2002 BASIC MATERIALS EXPERIMENT(1)、MSE2012 BASIC MATERIALS EXPERIMENT(2)、MSE1000 INTRODUCTION TO MATERIALS SCIENCE(1)、MSE1010 INTRODUCTION TO MATERIALS SCIENCE(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備綜合所學專業知識能力並強化國際連結力\t",
      "describe_en": "Synthesis of the acquired professional skills to improve international connection."
    },
    {
      "seq": 2,
      "describe_ch": "具備分析兩校研究方向差異能力並擴展學生視野\t",
      "describe_en": "Analysis of the differential research directions among departments to enlarge student’s perspective."
    },
    {
      "seq": 3,
      "describe_ch": "強化學生溝通協調與團隊合作能力\t",
      "describe_en": "To enhance the ability of communication, negotiation and team work."
    }
  ],
