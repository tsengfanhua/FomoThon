      "seq": 1,
      "describe_ch": "理解人工智慧的基本概念與技術。",
      "describe_en": "Understand the basic concepts and technologies of artificial intelligence."
    },
    {
      "seq": 2,
      "describe_ch": "探索AI在產業與商業領域的應用。",
      "describe_en": "Explore the applications of AI in various industries, especially in business."
    },
    {
      "seq": 3,
      "describe_ch": "分析AI帶來的創新機會和挑戰。",
      "describe_en": "Analyze the innovation opportunities and challenges brought by AI."
    }
