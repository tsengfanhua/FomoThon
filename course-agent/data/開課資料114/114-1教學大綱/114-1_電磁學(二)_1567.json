  "description": {
    "sub_id3": null,
    "sub_name": "電磁學(二)",
    "sub_ename": "ELECTROMAGNETICS(2)",
    "describe_ch": "本課程主要是接續電磁學(I) 的內容，每一章都有方程式作為基本模型，根據這組模型配合向量分析與微積分的技巧，解決實際上電磁學的問題。在此課程針對磁學與電磁波基本觀念做簡要的介紹。",
    "describe_eh": "This course follows electromagnetics (I). In each chapter, there are some equations as basic models, then according to these models, vector analysis and calculus skills to solve some problems in electromagnetics. In this course, there are simple introduction to magnetics and electromagnetic wave.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解並說明模型的數學意義。\t",
      "describe_en": "Understand comprehensively and be able to explain the physical meaning about electromagnetic."
    },
    {
      "seq": 2,
      "describe_ch": "能使用相關模型，去應用解決實際問題。",
      "describe_en": "Be able to apply models to practical problems."
    }
