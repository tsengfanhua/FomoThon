  "description": {
    "sub_id3": null,
    "sub_name": "交通法規與政策",
    "sub_ename": "TRAFFIC LAW AND POLICY",
    "describe_ch": "本課程之教學目標為使學生正確地認識交通運輸法規立法旨意與國家運輸發展之政策與策略；課程主題為國家運輸政策，公路法、道路交通管理處罰條例，停車場法、鐵路法、捷運法、航業法、民用航空法、獎勵民間參與交通建設條例等。",
    "describe_eh": "Let the students understand the basic national transportation policies , transportation trend , Highway Acts. Railroad Acts. Merchemt Marine Acts & Civil Aviation Acts.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "4.教授運輸或物流相關政策與法規內涵及時事之評析能力",
      "describe_en": "4.Ability to teach transportation and logistics related policies, regulations and issues"
    },
    {
      "seq": 2,
      "describe_ch": "8.培養學生運用資料調查、數據分析或數學模型分析運輸或物流問題之能力",
      "describe_en": "8.To develop  students' ability to analyze transportation and logistics problem using data investigation, data analysis or mathematical models."
    },
    {
      "seq": 3,
      "describe_ch": "9.培養學生探討運輸與物流於環境永續與觀光發展關聯性之能力",
      "describe_en": "9.To develop  students' ability to explore the relevance or transporation and logistics to environment sustaniability an dtoursim development."
    }
  ],
