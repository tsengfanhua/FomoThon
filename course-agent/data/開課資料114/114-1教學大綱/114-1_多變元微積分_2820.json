  "targets": [
    {
      "seq": 1,
      "describe_ch": "To understand the limits of functions and be able to verify the existence of limits",
      "describe_en": "To understand the limits of functions and be able to verify the existence of limits"
    },
    {
      "seq": 2,
      "describe_ch": "To understand and calculate partial derivative of functions with two or more variables, also the gradients.",
      "describe_en": "To understand and calculate partial derivative of functions with two or more variables, also the gradients."
    },
    {
      "seq": 3,
      "describe_ch": "To apply partial derivatives to find the extrema of a function.",
      "describe_en": "To apply partial derivatives to find the extrema of a function."
    },
    {
      "seq": 4,
      "describe_ch": "To understand the double integral and the iterated integral.",
      "describe_en": "To understand the double integral and the iterated integral."
    },
    {
      "seq": 5,
      "describe_ch": "To understand the higher dimensional spaces.",
      "describe_en": "To understand the higher dimensional spaces."
    }
