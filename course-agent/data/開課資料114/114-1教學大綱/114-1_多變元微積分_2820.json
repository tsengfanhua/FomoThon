    "scr_dup": "001",
    "tpa_score_new": "<div>Midterm Exam (30%), Final Exam (30%), Homework, Attendance and Quizzes (40%)</div>\n",
    "tpa_score_new_en": null,
    "course_pol": "1) Be on time for the lecture, if 20 minutes late for the lecture will be marked as absence for one hour. \n2) To concentrate in class and follow the lecture to finish the exercises in class and due on time in the assigned deadline. \n3) Do the homework regularly after class.  \n4) Do your own homework ask questions in class or time break or in the consultation hours.",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
