  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB01149",
    "sub_id": "08801",
    "scr_dup": "001",
    "sub_title": "內部控制與鑑識會計",
    "sub_title_en": null,
    "sub_describe": "一、內部控制\n1. 學生可以了解內部控制的定義與發展 \n2. 學生可以了解環境、社會與公司治理(ESG)的最新發展 \n3. 學生可以了解內部控制與國際財務報導準則的連結 \n4. 學生可以了解其他國家內部控制制度之發展與現況 \n5. 學生可以了解最新的法規修改趨勢\n二、鑑識會計\n1.鑑識會計案件類型與承接實務\n2.鑑識會計實務指引導讀與常見報告缺失\n3.會計師如何擔任專家證人\n4.鑑識會計報告評析",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "內部控制與鑑識會計",
    "sub_ename": "INTERNAL CONTROL AND FORENSIC ACCOUNTING",
    "describe_ch": "本課程介紹內部控制與鑑識會計兩大特點，協助學生瞭解內部控制的執行與舞弊的偵測，以及鑑識會計之涵蓋範疇與實務運用。",
    "describe_eh": "This course includes: internal control and forensic accounting. The purpose of this course is to build a basic understanding of internal control processes and fraud detection. Moreover, this course aims to understand the definition of forensic accounting and corruption investigation.",
    "pre_subname": "ACCT1011會計學(一)、ACCT1012會計學(二)",
    "pre_sub_id3": "ACCT1011",
    "pre_sub_ename": "ACCT1011 ACCOUNTING(1)、ACCT1012 ACCOUNTING(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解內部控制及鑑識會計之基本觀念及方法。",
      "describe_en": "Students understand the basic introduction of internal control and forensic accounting."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解從事鑑識會計應具備基本法令之能力。",
      "describe_en": "Students understand the extensive views of legal issues and concerns about forensic accounting."
    },
    {
      "seq": 3,
      "describe_ch": "能解釋內部控制與鑑識會計在社會及經濟層面的重要性及影響。",
      "describe_en": "Students can explain the importance and influence of internal control and forensic accounting on society and economic aspects."
    },
    {
      "seq": 4,
      "describe_ch": "應用舞弊個案教學培養學生之分析能力及敏感度。",
      "describe_en": "Students can develop the sensibility of fraud detection and investigation through case study."
    }
  ],
