  "description": {
    "sub_id3": null,
    "sub_name": "日語語法",
    "sub_ename": "JAPANESE SYNTAX",
    "describe_ch": "日語語法是一切課程的基礎，對於已過語言形成期的日語學習者而言，文法規則是學習過程中不可避免的一環，本課程是利用最短的時間，學好日語的基礎文法。",
    "describe_eh": "Japanese Syntax is the foundation of all courses. For learners of Japanese that have passed the language formation period, learning the grammar rules is an unavoidable step. This course allows the students to acquire basic grammar in the shortest amount of time.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.學會基礎的日語語法，除了閱讀文章具理解力對分析語法追求新知更有能力。",
      "describe_en": "1.Acquire basic Japanese syntax, which in turn not only improve reading comprehension ability, but also enhance one’s ability to perform syntax analysis and acquire knowledge."
    },
    {
      "seq": 2,
      "describe_ch": "2.具較優的語言表達能力，有益日後專業能力的提昇。",
      "describe_en": "2.Enhance communication skills, which in turn will assist the development of professional abilities in the future."
    }
  ],
