  "description": {
    "sub_id3": null,
    "sub_name": "新能源監控與智慧分析",
    "sub_ename": "INTELLIGENT NEW ENERGY MONITORING AND ANALYSIS",
    "describe_ch": "本課程主要說明電力系統之安全分析與穩定控制，建構學生智慧電網分析理論基礎。藉由巨量資料探討大數據分析、廣域監測元件、控制理論與物聯網於能源管理系統之應用，使學生於能源管理理論基礎與系統設計能力更邁進一步。",
    "describe_eh": "This course aims to introduce the safe margin analysis and power system stability to construct a theoretical foundation in smart grids. Due to the applications in energy management system (ESS) including big data analysis, perceptron and control methods, low-carbon energy and internet of things techniques, it has taken a step for students with a theoretical foundation and design capability in energy management engineering technology.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習能源轉換原理、方法與應用數值演算法及機器感知學習，建構智慧電網控制知識基礎。",
      "describe_en": "Possess the  knowledge of energy conversion theory derivation, applied numerical methods and machine learning in fundamental mathematics to construct a knowledge stone of smart grid control."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解能源管理系統應用技術:電力大數據、電力感測與控制方法、能源低碳化、電力互聯網技術",
      "describe_en": "Ability to understand the applications of energy management system including big data analysis, perceptron and control methods, low-carbon energy and internet of things techniques."
    },
    {
      "seq": 3,
      "describe_ch": "使學生具備能源管理系統設計能力",
      "describe_en": "Enable students with the ability to design an intelligent control system."
    },
    {
      "seq": 4,
      "describe_ch": "透過書面及口頭方式進行期末報告",
      "describe_en": "Final report in written and oral form."
    }
  ],
