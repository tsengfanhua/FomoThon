  "description": {
    "sub_id3": null,
    "sub_name": "健康及傷害保險",
    "sub_ename": "HEALTH AND ACCIDENT INSURANCE",
    "describe_ch": "健康保險與國民日常生活息息相關，本課程主要目的乃介紹如何運用民營之健康保險及政府舉辦的社會醫療保險來規劃個人健康與傷害之危險管理，以解決其醫療費用之問題，保障國民所得之安全。",
    "describe_eh": "Health insurance has a close tie to daily life of the people. The main purpose of this course is to introduce how to make use of health insurance provided by private units and social medical insurance held by the government for personal risk management on health programming. Therefore, this programming on health insurance will solve the problem on medical expenses to secure the safely on income for the people.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能學習健康與傷害保險的專業知識",
      "describe_en": "To study the professional knowledge of life and health insurance."
    },
    {
      "seq": 2,
      "describe_ch": "能理解我國全民健康保險之內容",
      "describe_en": "Comprehension for the content of National Health Insurance in Taiwan."
    },
    {
      "seq": 3,
      "describe_ch": "能應用專業知識於個人與家庭之風險管理",
      "describe_en": "Application for the professional knowledge to Risk management in household."
    }
  ],
