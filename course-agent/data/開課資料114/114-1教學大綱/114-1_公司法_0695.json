  "description": {
    "sub_id3": null,
    "sub_name": "公司法",
    "sub_ename": "CORPORATION LAW",
    "describe_ch": "公司法於2001.10修正200多條條文，修正幅度之大為歷年來罕見，因此本學期之公司法專題主要鎖定在修正部分之相關議題的探討，期使修課學生能對修正後之公司法有更深入的了解。本課程將會探討一人公司、股票面額制度、交叉持股規範、合併分割法制等主題。",
    "describe_eh": "Over 200 articles of Company Law were modified in October 2001. Such an enormous amendment is rare. Therefore, the course in this semester will focus on topics relating to those amended articles. Those who participate in the course are expected more familiar with Company Law. This course includes the following: single-member company, par value of stock, cross-shareholding, merger, acquisition, split-up, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "針對傳統與現代商業組織，學生能說明商業組織與法律之相互關係，並能清楚表達。",
      "describe_en": "Students would be able to express clearly and to illustrate the correlations of modern business organizations, payment systems and related laws."
    },
    {
      "seq": 2,
      "describe_ch": "學生能利用公司法、票據法的知識，評估企業經營在現有法制下的可行方法。",
      "describe_en": "Students would be able to evaluate the feasibilities of corporate management and measures taken under existing law and regulation."
    },
    {
      "seq": 3,
      "describe_ch": "能辨識現代企業經營所面臨之法律問題，並能清楚表達。",
      "describe_en": "Students would be able to express clearly and to identify possible legal issues may incurred owing to corporate management and corporate measures taken."
    },
    {
      "seq": 4,
      "describe_ch": "能運用公司法規範於實際法律問題，並得到適當結論。",
      "describe_en": "Students would be able to apply corporate law and related regulation against corporate reality and to obtain pertinent result."
    }
  ],
