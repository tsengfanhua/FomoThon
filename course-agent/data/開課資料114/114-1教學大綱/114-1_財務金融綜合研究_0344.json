  "description": {
    "sub_id3": null,
    "sub_name": "財務金融綜合研究",
    "sub_ename": "COMPREHENSIVE RESEARCH IN FINANCE",
    "describe_ch": "利用學生在大四之前所學的專業金融知識，解決金融市場的問題。通過介紹不同的投資工具和資產配置的概念，為虛擬客戶設計全面的財務計劃。提供現金流、信貸、保險、流動性等方面的建議，滿足他們不同人生階段的理財需求，降低財務風險，最終達到理財的目的。",
    "describe_eh": "Using professionally financial knowledge learned by students before senior to solve the problems from the financial markets. By introducing different investment vehicles and the concept of asset allocation to design the comprehensive financial plans for the virtual customers. To provide the suggestions of cash flow, credit, insurance and liquidity to satisfy their financial demand under different life stages, reduce financial risk and finally achieve the purpose of wealth management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解投資的基本概念和傳統的投資工具",
      "describe_en": "understand basic concept of investment and traditional investment types, i.e. equity, fixed income, real estate"
    },
    {
      "seq": 2,
      "describe_ch": "能應用所學做資產配置績效的歷史研究",
      "describe_en": "understand traditional valuation model for equity investments"
    },
    {
      "seq": 3,
      "describe_ch": "能綜合所學為客戶設計出一套全面的財務規劃",
      "describe_en": " understand basic duration model for fixed income investments"
    }
  ],
