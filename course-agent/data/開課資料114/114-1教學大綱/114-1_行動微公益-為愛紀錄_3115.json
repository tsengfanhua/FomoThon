  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "XC04111",
    "sub_id": "GM781",
    "scr_dup": "001",
    "tpa_score_new": "<div>\n<ul>\n\t<li>會進行課堂互動與參與討論、作業報告繳交、學期預警、或加分及補救措施等。</li>\n\t<li>&nbsp;讓學員透過不同台灣經典紀錄片的深入探討，認識了解台灣社會到處存在公益議題，訓練社會公益議題的關注、思考與實踐，透過分組製作投入微公益各主題活動，相關內容如社群服務、環境保護、知識傳播、公共福利、幫助弱勢、社會援助、青年服務、社團活動、慈善服務、文化藝術活動等，訓練善用手機紀錄內容並完成影音紀錄，於期末完成公益主題之專案報告與社群數位推播行銷擴大公益效益，並結合成果展出，達到實務與理論配合之目的。</li>\n</ul>\n</div>\n\n<div>&nbsp;</div>\n",
    "tpa_score_new_en": " ",
    "course_pol": "哈佛式個案教學，影片觀賞與議題研討，上課型態活潑互動研討，提升學子用手機製片的專業能力，以及培養關注身邊公益議題能力。",
    "course_pol_en": null,
    "course_rem": "課程提醒\n上課互動輕鬆愉快，會成立Line社群，嚴禁同學上課時趴睡。",
    "course_rem_en": null,
    "ais_meno": "<div>1.這是一個訓練思考、討論、原創為公益影片等的教學過程，嚴禁同學們侵犯他人的著作，作業報告或是教材分享皆須謹守尊重著作財產權之規範。</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": "N"
  },
