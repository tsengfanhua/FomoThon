  "description": {
    "sub_id3": null,
    "sub_name": "數位科技與地方創新永續",
    "sub_ename": "DIGITAL TECHNOLOGY AND THE SUSTAINABLE DEVELOPMENT OF LOCAL AREAS",
    "describe_ch": "本課程主要企圖帶引學生探索數位科技對於地方的永續發展之各種可能關係，透過數位科技如運用區塊鏈技術的運用，使地方創生有關的經驗與成果，可以經由資訊工具的協助，而具有更多的價值創造的可能，進而使台灣地方的創生與永續獲得更有利的協助。",
    "describe_eh": "This course aims to lead students to explore the possible relationships between digital technology and sustainable development of local area. Through the digital technology, for example, using block chain to save the experiences and achievements and to create values for the revitalization of local areas. Therefore, give more help for the revitalization and sustainable development of local areas in Taiwan.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "提升學生對地方創新和永續發展的意識",
      "describe_en": "Raise students' awareness of the importance of local innovation and sustainable development"
    },
    {
      "seq": 2,
      "describe_ch": "培養學生了解和運用數位科技促進創新與永續的能力",
      "describe_en": "Develop students' skills and knowledge in using digital technology to promote innovation and sustainable development"
    }
  ],
