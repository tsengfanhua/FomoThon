  "description": {
    "sub_id3": null,
    "sub_name": "商業實務選讀",
    "sub_ename": "PRACTICAL BUSINESS READING",
    "describe_ch": "本課程旨在透過國際新聞的商管題材，全面提升學生的聽、讀英語技能，同時拓展學生的國際視野與專業競爭力。課程內容將聚焦於真實且實用的商業情境，透過多元素材如國際趨勢新聞、商業報告、會議錄音及簡報，讓學生能夠在理解專業知識的同時，提升英語應用能力，特別是在商務溝通和資訊分析方面。",
    "describe_eh": "This course focuses on enhancing students' English listening and reading skills through international news business topics. By using real-world materials like trend reports, business articles, and presentations, students will improve their English proficiency, expand global perspectives, and strengthen business communication and analytical skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能熟悉商業用語，增加詞彙量，進而理解報導文意。\r\n",
      "describe_en": "Be able to familiarize yourself with business terms, increase your vocabulary, and understand the meaning of reports."
    },
    {
      "seq": 2,
      "describe_ch": "具有商業文章報導重點歸納分析能力。",
      "describe_en": "Ability to summarize and analyze key points of business article reporting."
    },
    {
      "seq": 3,
      "describe_ch": "聽力訓練：商業情境理解\r\n目標：訓練學生在真實商業情境中聽懂會議、簡報、商務通話等內容。\r\n",
      "describe_en": " Listening Training: Understanding Business Contexts\r\nObjective: Train students to understand meetings, presentations, and business calls in real-world business contexts.\r\n"
    },
    {
      "seq": 4,
      "describe_ch": "閱讀訓練：商業文件解析\r\n目標：提高學生閱讀理解能力，能有效閱讀報告、電郵及商業文章。\r\n",
      "describe_en": "Reading Training: Analysis of Business Documents\r\nObjective: Improve students' reading comprehension skills to effectively understand reports, emails, and business articles.\r\n"
    }
  ],
