  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CI02149",
    "sub_id": "14667",
    "scr_dup": "001",
    "sub_title": "無線通訊於通道上的傳輸特性",
    "sub_title_en": null,
    "sub_describe": "主要探討無線電的訊號於物理通道中傳輸時其通道型式與訊號傳輸時的特性，並且進行通道的估測與模型的建立。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "行動通訊",
    "sub_ename": "MOBILE  COMMUNICATIONS",
    "describe_ch": "本課程為大四程度行動無線領域入門課程。學生修習此課程後應具備行動無線通訊方面的基礎知識，以及暸解第二代、第三代與第四代蜂巢系統、無線區域網路、與大都會網路的系統架構與技術原理。",
    "describe_eh": "This course is intended to provide an introduction to mobile communications for students at the senior level. A student of the course should learn the fundamental aspects of mobile wireless communication, as well as understand the principles of system architecture and technique of second- , third- and fourth-generation cellular systems, wireless LANs and MANs.",
    "pre_subname": "COME3003數位通訊系統、COME3019消息理論與編碼",
    "pre_sub_id3": "COME3003",
    "pre_sub_ename": "COME3003   DIGITAL COMMUNICATIONS、COME3019 INFORMATION THEORY AND CODING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂行動通訊工程：能夠描述重要的行動通訊工程能力種類及其限制。　",
      "describe_en": " Be able to define mobile communication engineering with their own words: Be able to describe important mobile communication capabilities and limitations."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明行動通訊工程在社會及經濟層面的重要性及影響。",
      "describe_en": "Understand and be able to explain the importance and effects of mobile communication engineering to society and economy."
    }
  ],
