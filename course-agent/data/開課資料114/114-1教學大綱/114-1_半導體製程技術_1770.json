  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "半導體製程技術",
    "sub_ename": "SEMICONDUCTOR MANUFACTURING TECHNOLOGY",
    "describe_ch": "本課程以最簡單的數學、化學以及物理學來完整的描述一座半導體生產工廠中複雜的積體電路晶片製造過程。課程內容主要集中在最新的積體電路製程技術，同時也兼顧較舊的技術以便讓學生對於積體電路製程技術的歷史發展有更好的了解。",
    "describe_eh": "This subject introduces the typical manufacturing process of a complex integrated circuit in a semiconductor factory by using simple mathematic、chemical and physical principles. The main content focuses on the advanced integrated circuit fabrication process and well-known technology, which allows the students to understand more knowledge on the history of the integrated circuit fabrication technique.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解半導體製程的每段步驟的製程，並且能夠敘述出每個步驟的用處及用意。",
      "describe_en": "Understand each step in integrated circuit fabrication and can describe the meaning and application."
    },
    {
      "seq": 2,
      "describe_ch": "能夠以既有的半導體製程概念，去分析以後半導體製程可能的發展並評估出其中的特性。",
      "describe_en": "Be able to analyze the possible development and estimate the characteristic of the CMOS fabrication\r\ntechnique by using the existing concept of the CMOS fabrication.\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "能夠自行推演出CMOS的製程，並且能以簡單的敘述說明每個步驟的用意。",
      "describe_en": "Be able to deduce the CMOS fabrication technique by oneself, also we can simply state and explain the meaning of each step."
    },
    {
      "seq": 4,
      "describe_ch": " 可以運用既有的半導體製程概念，設計一個簡單的微結構。",
      "describe_en": "Be able to design a simple microstructure by using the existing concept of the semiconductor manufacturing process."
    }
  ],
