  "description": {
    "sub_id3": null,
    "sub_name": "菁英英語演講",
    "sub_ename": "PUBLIC SPEAKING",
    "describe_ch": "本課程旨在培養英語演講技巧，此為課堂上與工作中都會用到的重要能力。課程將著重於個人的溝通技巧，提升組織、邏輯推理及聽講能力。每位學生須練習不同目的之演講，並參與同儕互評且提供建議。",
    "describe_eh": "This course is designed to develop public speaking skills. Public speaking is a vital soft skill- be it used in the classroom or for a presentation at work. Attention will also be given to individual communication activities designed to improve the ability to organize, reason critically, and to listen effectively. Each student will develop and deliver several speeches and participate in peer evaluations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能辨認並評估具有社會重要性的主題，並針對這些主題做口頭報告。",
      "describe_en": "Identify and assess socially significant topics, and then deliver oral presentations on these topics."
    },
    {
      "seq": 3,
      "describe_ch": "能在口語溝通時，分析談話內容。",
      "describe_en": "Engage in critical listening and speaking."
    }
  ],
