  "description": {
    "sub_id3": null,
    "sub_name": "室內裝修工程估價與防火安全",
    "sub_ename": "INTERIOR CONSTRUCTION APPRAISED AND FIRE SAFETY",
    "describe_ch": "從工程案例切入對設計圖與實際工程施作的理解及掌握；包含施工工程項目與估價作業兩部分1.施工工程項目包含各類工程材料使用、施工技術、施工程序、施工圖說判讀及繪製等實務2.估價項目包含市場計價、估算作業、工料分析、預算書與標單編制等作業實務。此外在課程的最後也將介紹建築物的消防安全與設備，其內容包括最新公佈的消防法規、警報設備、滅火設備、排煙與煙控設備、避難逃生設備、防火避難設施等。讓同學在學習裝修工程及價格的認識之餘也瞭解消防安全與設備對建築物防火安全的重要性。",
    "describe_eh": "This course mainly teaches students to understanding of design drawings and practical engineering from project cases. This course includes both construction and appraised. Construction practical training comprehend how to use any kind of construction materials、technology、procedure and working drawing. An appraised practical training include market valuation 、appraised 、materials analyze 、budget and production planning. At the end of the course will introduce of fire protection equipment on building which are included the latest fire safety laws, fire alarm equipment, fire fighting equipment, fire smoke and control equipment, escape of equipment, fire safety refuge's measure. Make sure that student can know the interior construction and importance of fire safety.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "對工程施工及設計圖的對照銜接",
      "describe_en": "Control connection of engineering construction and design drawings"
    },
    {
      "seq": 2,
      "describe_ch": "使能熟知設計工程項目之作業實務",
      "describe_en": "To know construction design very well."
    },
    {
      "seq": 3,
      "describe_ch": "使能理解建築裝修工程材料與構造及施工作業配合",
      "describe_en": "To understand construction materials with architectonic"
    },
    {
      "seq": 4,
      "describe_ch": "增加消防安全的相關知識，使修課同學瞭解其重要性。",
      "describe_en": "Increase the relevant knowledge of the fire safety, enable majoring in to lesson classmates and finding out about its importance."
    }
  ],
