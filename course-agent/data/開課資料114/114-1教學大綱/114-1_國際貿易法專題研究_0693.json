  "description": {
    "sub_id3": null,
    "sub_name": "國際貿易法專題研究",
    "sub_ename": "SEMINAR ON LEGAL ISSUES OF WTO",
    "describe_ch": "針對國際貿易法（WTO）下各協定所涉及之各類議題，例如食品安全、補貼、傾銷、智慧財產權、投資保障、環保等重要問題，進一步深入研究。",
    "describe_eh": "he seminar will focus on the major issues under the WTO framework, inter alia food safety, subsidies, dumping, IPR, investment, as well as trade-linked issues, in particular the environmental protection.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生能描述國際經濟法理論，並解釋國際經濟法發展趨勢的意義與實用蘊涵。　\t",
      "describe_en": "Students would be able to describe the principles of international economic laws, and identify important essence and practical use of its development.　"
    },
    {
      "seq": 2,
      "describe_ch": "學生能描述WTO下重要議題之原則理論及基礎架構。　\t",
      "describe_en": "Students would be able to describe the principle and structure of the major issues under the WTO.　"
    },
    {
      "seq": 3,
      "describe_ch": "學生能辨識WTO的重要議題，並了解實務上之調和方案。　\t",
      "describe_en": "Students would be able to describe the major issues under the WTO, and identify practical resolution.　"
    },
    {
      "seq": 4,
      "describe_ch": "學生能描述國際經濟法理論，並解釋國際經濟法發展趨勢的意義與實用蘊涵。　\t",
      "describe_en": "Students would be able to describe the principles of international economic laws, and identify important essence and practical use of its development.　"
    }
  ],
