  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CS01129",
    "sub_id": "62711",
    "scr_dup": "001",
    "sub_title": "學習GeoGebra數學軟體",
    "sub_title_en": null,
    "sub_describe": "課程將介紹如何利用GeoGebra數學軟體來學習動態圖形模擬及數據分析，除了基本的數學軟體語言介紹外，將結合數學並利用數學軟體內建功能建構使用者介面，輕鬆建立如按鈕、下拉式選單、滑動軸等控制項。透過完成的使用者介面，只需利用滑鼠或鍵盤，即可呈現一個互動的圖形模擬或數據分析環境。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "數學軟體",
    "sub_ename": "MATHEMATICAL SOFTARE",
    "describe_ch": "課程將介紹如何利用數學軟體來學習動態圖形模擬及數據分析，除了基本的數學軟體語言介紹外，將結合數學並利用數學軟體內建功能建構使用者介面，輕鬆建立如按鈕、下拉式選單、滑動軸等控制項。透過完成的使用者介面，只需利用滑鼠或鍵盤，即可呈現一個互動的圖形模擬或數據分析環境。",
    "describe_eh": "This course will introduce the usage of mathematical softwares in dynamic graphics simulation and data analysis. In additional to the basic introduction of mathematical softwares, the course will incorporate mathematics into mathematical softwares to construct the user interface: easily creating control items, such as push button, pop-up menu, slider, and so on. Through the finished interface, just using the mouse or keyboard, you can present an interactive environment.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解數學軟體如何協助數據分析",
      "describe_en": "Understand how to assist in analyzing data with mathematical softwares"
    },
    {
      "seq": 2,
      "describe_ch": "應用數學軟體輔助數學學習",
      "describe_en": "Application of mathematical softwares in aiding Mathematics learning"
    }
  ],
