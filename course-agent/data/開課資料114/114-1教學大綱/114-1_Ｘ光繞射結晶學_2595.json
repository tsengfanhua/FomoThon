  "description": {
    "sub_id3": null,
    "sub_name": "Ｘ光繞射結晶學",
    "sub_ename": "ELEMENTS OF  X-RAY DIFFRACTION",
    "describe_ch": "探討X光繞射的原理與分析理論，主要內容包括X光的產生方式、X光之基本特性、偵測模式、材料之晶體結構分析、繞射理論以及結晶學的基本原理、各種X光分析技術例如X光的繞射、吸收及勞厄等技術結晶學簡介、X光繞射分析儀原理、X光於材料科技之應用。此課程為以課堂講授搭配hands-on作業的應用學科，課程實施將側重於學理原理與方法論。",
    "describe_eh": "Study the fundamentals and the analysis theories of X-ray diffraction. The contents include the generation of x-ray, detection modes, crystallography (crystal lattices, symmetry, space group), the fundamental theory of x-ray diffraction (brief history, generation, detection, and safety), various x-ray techniques such as x-ray diffraction, absorption, Laue techniques (geometry, intensities of diffracted beams, real samples). This course combines theoretical lecturing and hands-on homework, emphasizing the principles and methodologies.",
    "pre_subname": "MSE1000材料科學導論(一)",
    "pre_sub_id3": "MSE1000",
    "pre_sub_ename": "MSE1000 INTRODUCTION TO MATERIALS SCIENCE(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "X光的歷史演進與文獻回顧。",
      "describe_en": "X-rays historical gradual progress and document retrospect."
    },
    {
      "seq": 2,
      "describe_ch": "說明X光的基本性質、特性，描述X光如何產生。",
      "describe_en": "Explain the properties of X-ray, and  investigate the characteristic of X-ray."
    },
    {
      "seq": 3,
      "describe_ch": "描述X光的偵測方式以及X光訊號的收集。",
      "describe_en": "Describe the detection and the collection of X-rays signals."
    },
    {
      "seq": 4,
      "describe_ch": "歸納出晶體的幾何結構，並解釋其構造。",
      "describe_en": "Generalize the geometry of crystals, and interpret the conformation."
    }
  ],
