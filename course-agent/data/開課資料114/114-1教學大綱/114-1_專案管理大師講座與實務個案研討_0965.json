    {
      "seq": 2,
      "describe_ch": "瞭解專案落實與社會責任的關係",
      "describe_en": "To realize the relationship between project implement and social responsibility"
    },
    {
      "seq": 3,
      "describe_ch": "增進分析實務專案的能力",
      "describe_en": "To enhance an ability for analyzing real projects case study"
    }
