  "description": {
    "sub_id3": null,
    "sub_name": "資料探勘",
    "sub_ename": "DATA MINING",
    "describe_ch": "本課程介紹資料探勘的基本概念、方法、應用與相關的軟體或工具。內容包含資料探勘的功能、探勘資料的型態、探勘結果呈現與評估。此外，也會介紹相關的工具、軟體與網站等，讓學生可以學習如何進行資料探勘。",
    "describe_eh": "This course introduces the basic concepts, methods, applications and related software or tools of data mining. The content includes the function of data exploration, the type of exploration data, the presentation and evaluation of exploration results. In addition, related tools, software and websites will be introduced so that students can learn how to conduct data exploration.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
