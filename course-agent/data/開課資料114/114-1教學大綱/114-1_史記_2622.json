  "description": {
    "sub_id3": null,
    "sub_name": "史記",
    "sub_ename": "THE SHIH-CHI",
    "describe_ch": "《史記》一書，鎔文史哲於一爐．本課程之講授，旨在從太史公司馬遷以簡樸之文字敘寫且敘事客觀之史實中，說明其對人生的看法，撮取生命的真諦，尋出歷史「成敗興壞」之軌跡，以為吾人殷鑑。",
    "describe_eh": "The Book of Shihi contents elements of literature, history and philosophy. This course aims at getting the truth of life through explaining the life view of the Grand Historian, Sima Qian, from his simple narrative writings and the historical facts shown in his objective narration. It also serves the purpose of providing lessons for us by examining rise and fall in history.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": ".能研讀、理解授課內容。",
      "describe_en": "to study and to understand the contents of lecture."
    },
    {
      "seq": 2,
      "describe_ch": "能具備欣賞授課內容的能力。",
      "describe_en": "to have the ability to appreciate the contents of lecture."
    },
    {
      "seq": 3,
      "describe_ch": "能理解司馬遷創作《史記》之精神及其風格。",
      "describe_en": "to understand the esprit and the style why Sima Qian had written  Shi-hi."
    },
    {
      "seq": 4,
      "describe_ch": "能理解歷史傳記給予後人之啟示。",
      "describe_en": "to understand the apocalypse which given by the historical biography."
    }
  ],
