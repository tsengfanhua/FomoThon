  "description": {
    "sub_id3": null,
    "sub_name": "財務報表分析",
    "sub_ename": "FINANCIAL STATEMENT ANALYSIS",
    "describe_ch": "財務報表分析是投資的必修工具。本課程由產業分析著手，強調以財務報表分析為主軸的公司分析。說明財務比率的經濟意義並透過財務報表各項資訊掌握架構、經營績效、財務體質與風險。",
    "describe_eh": "Financial statements are the basis for a wide range of business analysis. This course provides a framework for using financial statement data in a variety of business analysis and valuation contexts. Business strategy analysis, accounting analysis, financial analysis and prospective analysis are key components of effective financial statement analysis.",
    "pre_subname": "ACCT1011會計學(一)、ACCT1012會計學(二)",
    "pre_sub_id3": "ACCT1011",
    "pre_sub_ename": "ACCT1011 ACCOUNTING(1)、ACCT1012 ACCOUNTING(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解財報表的各項分析工具。",
      "describe_en": "Comprehension for the tools of financial statements analysis."
    },
    {
      "seq": 2,
      "describe_ch": "能分析企業財務報表資訊。",
      "describe_en": "Analysis for the information of corporate financial statements"
    }
  ],
