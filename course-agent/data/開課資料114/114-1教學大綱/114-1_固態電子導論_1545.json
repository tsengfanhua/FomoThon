  "description": {
    "sub_id3": null,
    "sub_name": "固態電子導論",
    "sub_ename": "INTRODUCTION TO SOLID STATE ELECTRONICS",
    "describe_ch": "陳述固態半導體與電子元件特性，能概述固態晶體、製作方法、能帶、載子傳導、固態電子元件基本特性(如PN接面、場效電晶體、雙載子接面電晶體)。實施案例說明與問題討論。",
    "describe_eh": "Present the characteristics of the solid-state semiconductor and the electronic device, including the growth of semiconductor, fabrication, and device application. The property of the atomic and electron in semiconductor, the transport behavior of the excess carriers (electron and hole), PN junction, FET, and BJT device are also introduced. Case studies will be explained and discussed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知道固態半導體的基本物理特性及製作成電子元件的操作原理。",
      "describe_en": "To know the fundamental physics and operation principle of electronic devices fabricated by solid states semiconductor."
    },
    {
      "seq": 2,
      "describe_ch": "能理解固態半導體應用於積體電路的情形。",
      "describe_en": "To comprehend the solid state/semiconductor how to fabricate the integrated circuits (IC)."
    }
  ],
