  "description": {
    "sub_id3": null,
    "sub_name": "智慧製造與預測維護系統應用",
    "sub_ename": "INTELLIGENT MANUFACTURING AND APPLICATION OF PREDICTIVE MAINTENANCE SYSTEMS",
    "describe_ch": "介紹預測維護系統應用於製造系統的基本觀念與實作，並且敘述和工業4.0、虛實融合系統(CPS)的關係。學生可從其中學會如何實作智慧製造系統與提升生產力與品質。本課程以實作資料前處理、特徵工程、模型建置、以及資料可視化，讓學生進一步理解、分析並進而應用所學於實際智慧製造系統。",
    "describe_eh": "This course delves into how predictive maintenance systems (PDMS) are revolutionizing the manufacturing sector, tying these advancements directly to the core principles of Industry 4.0 and the integration within Cyber-Physical Systems (CPS). It offers insight into how students can harness these technologies to craft smart manufacturing setups, aiming to boost efficiency and elevate the standard of the products. This course is designed around hands-on experiences in data preprocessing, feature engineering, model development, and visualization. It aims to deepen students' comprehension and analytical skills, encouraging them to apply their knowledge practically in intelligent manufacturing systems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備數學、統計、資訊、工程與管理基本學理與應用能力。",
      "describe_en": "Be able to underhand the fundamental principles of mathematics, statistical, engineering and management information and application abilities."
    },
    {
      "seq": 2,
      "describe_ch": "具備智能系統分析、設計、整合、製造與管理專業能力。",
      "describe_en": "Be able to have intelligent system analysis, design, integration, manufacturing and management professional abilities."
    },
    {
      "seq": 3,
      "describe_ch": "具備資料蒐集、分析、驗證與推論研究能力。",
      "describe_en": "Be able to have data collection, analysis, verification, and implication abilities."
    },
    {
      "seq": 4,
      "describe_ch": "具備邏輯思維、創新設計與持續改善能力。",
      "describe_en": "Be able to have logical thinking, innovative design and continuous improvement abilities."
    }
  ],
