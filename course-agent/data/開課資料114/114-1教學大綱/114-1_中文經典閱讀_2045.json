  "description": {
    "sub_id3": null,
    "sub_name": "中文經典閱讀",
    "sub_ename": "READING CHINESE CLASSICS",
    "describe_ch": "以中文古典、現代經典為閱讀材料，透過主題式的選材，古今呼應，了解歷代對經典元素的詮釋，從而導入現代的再創造，一者了解精神內涵的傳承與新解，一者從形式上，刺激藝術的多元表達。",
    "describe_eh": "This course aims to enable students to understand how various kinds of philosophical themes are woven into Chinese classics and modern works. Through reading these works, students will also find different ways to demonstrate the chosen themes.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過主題性閱讀，掌握文化意涵的傳衍",
      "describe_en": "Understand the heritage of Chinese culture through theme-based reading"
    },
    {
      "seq": 2,
      "describe_ch": "以現代的改寫，賦予傳統主題新面貌",
      "describe_en": "Use a modern approach to understand a traditional theme"
    }
  ],
