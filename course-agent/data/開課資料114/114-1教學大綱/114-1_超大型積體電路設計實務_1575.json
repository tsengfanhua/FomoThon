  "description": {
    "sub_id3": null,
    "sub_name": "超大型積體電路設計實務",
    "sub_ename": "DESIGN AND IMPLEMENTATION OF VLSI CIRCUITS",
    "describe_ch": "介紹半導體產業中之數位積體電路設計相關知識以及電腦輔助設計工具之操作，如：ncVerilog, Synopsys Design Compiler, Candence SOC Encounter, PrimTime 等。讓學生透過標準元件庫積體電路設計流程，實作出一套電路。",
    "describe_eh": "In this course, the students will learn the fundamental knowledge of digital integration circuits design and the opertation skills of CAD tools, including ncVerilog, Synopsys Design Compiler, Cadence SOC Encounter, PrimeTime etc. Based on the cell-based design flow, the students can design and implement a digital circuit.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "以Amplifier線路為基礎，處理較複雜的類比積體電路的設計與應用",
      "describe_en": "Based on the Amplifier circuit, we can design and apply more complex analog integrated circuits"
    },
    {
      "seq": 2,
      "describe_ch": "學習基本的的半導體製程與元件知識，作為類比積體電路設計的根基",
      "describe_en": "Learn basic semiconductor process and component knowledge as the foundation for analog integrated circuit design"
    },
    {
      "seq": 3,
      "describe_ch": "學習類比積體電路設計的基本電路單元，Current Source & Current Mirror等Bias線路的工作原理，以及設計模擬的分析方法",
      "describe_en": "Learn the basic circuit units of analog integrated circuit design, the working principles of Bias circuits such as Current Source & Current Mirror, and the analysis methods of design simulation"
    }
  ],
