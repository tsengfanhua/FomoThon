    "scr_dup": "001",
    "sub_title": null,
    "sub_title_en": "GLOCAL-globalization and localization, Strategy and positioning, Cost and finance, Organizational theories, Process management, Aesthetics, and Branding.",
    "sub_describe": null,
    "sub_describe_en": "This course is a learning journey to understand the theoretical framework of Strategy and positioning, Cost and finance, Organizational theories, Process management, Aesthetics, and Branding. Marketing literature of top journal will be pick by student as  a stepping stone to cultivate academic research quality."
  },
  "description": {
    "sub_id3": null,
    "sub_name": "全球行銷與品牌美學",
    "sub_ename": "GLOBAL MARKETING AND BRAND AESTHETICS",
    "describe_ch": "以全球在地化的行銷價值探討品牌推廣的有效美學策略。內容包括行銷學門思想體系，以及探討交換價值為市場經濟最小分析單位、策略成本、組織作業流程、美學品牌等學習單元。",
    "describe_eh": "The learning goal is discussing the effective aesthetic strategy of brand promotion with the marketing value of global localization. The content includes the school of thoughts of marketing, and the exchange value is the basic analysis unit of the market and economy, the strategy, cost organization, operation process aesthetics, and branding.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
