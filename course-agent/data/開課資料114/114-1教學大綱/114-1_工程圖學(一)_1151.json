  "description": {
    "sub_id3": null,
    "sub_name": "工程圖學(一)",
    "sub_ename": "ENGINEERING GRAPHICS(1)",
    "describe_ch": "本課程以課堂解說及習作來介紹關於AutoCAD 2004電腦繪圖軟體之基本操作。以及工程圖學的基本知識，並將工程圖學的圖例以AutoCAD 2004為工具將其繪製出圖。",
    "describe_eh": "This course is an introduction to and overview of AutoCAD 2004 software in lecture and exercise form. Students learn the basic knowledge of the Graphic Science. The AutoCAD 2004 is a tool to draw the example of the Graphic Science.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 5,
      "describe_ch": "學習者能正確描述Auto-CAD的每一種工具列的每一個圖示的功用",
      "describe_en": " "
    },
    {
      "seq": 6,
      "describe_ch": "能應用Auto-CAD繪出工程圖",
      "describe_en": null
    },
    {
      "seq": 7,
      "describe_ch": "學習者除繪圖之外，能清楚的標示尺寸",
      "describe_en": null
    },
    {
      "seq": 8,
      "describe_ch": "學習者的作業及上機考試兩項來評估學習成果",
      "describe_en": null
    }
  ],
