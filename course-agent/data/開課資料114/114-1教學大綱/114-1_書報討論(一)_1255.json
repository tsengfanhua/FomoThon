  "description": {
    "sub_id3": null,
    "sub_name": "書報討論(一)",
    "sub_ename": "LITERATURE SURVEY (1)",
    "describe_ch": "以口頭發表之方式訓練學生能夠於台上報告專業論文研究，並互相討論。帶領研究生了解各種儀器分析設備之原理與測試方法，進而能夠應用於紡織工程之領域，提昇學生之研究水準。",
    "describe_eh": "Training students with an oral presentation for reporting a professional research and discuss it thereafter. Lead the graduate students to understand the principle and the test method of various analysis instruments, and further applied in the field of textile engineering for improving the quality of research.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
