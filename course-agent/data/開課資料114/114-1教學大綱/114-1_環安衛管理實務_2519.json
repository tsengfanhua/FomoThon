  "description": {
    "sub_id3": null,
    "sub_name": "環安衛管理實務",
    "sub_ename": "SEMINAR FOR ENVIRONMENT, SAFETY, AND HEALTH",
    "describe_ch": "本課程提供學生未來就業之準備，藉由邀請環境、安全與衛生領域之專業人士針對各行業之職場倫理、經營管理與溝通協調等面向提供實務經驗。",
    "describe_eh": "This course provides students an experience for their job preparation.  Speakers specialized in environment, safety and health professional will be invited to address the working ethics, management strategy and communication skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "廣泛認識環境工程與科學工業安全與衛生的新知。　\t　",
      "describe_en": "Obtain new concepts of various topics in the fields of environmental engineering and science and industrial safety and hygiene."
    },
    {
      "seq": 2,
      "describe_ch": "分辨環工專業人員的專業道德與責任的重要性。　\t",
      "describe_en": "Distinguish the importance of morality and responsibility　"
    },
    {
      "seq": 3,
      "describe_ch": "為未來就業的須求，具備綜合環境議題與技術的能力。　\t",
      "describe_en": "Synthesize environmental issues and techniques for the needs of future career.　"
    }
  ],
