  "description": {
    "sub_id3": null,
    "sub_name": "個人理財規劃",
    "sub_ename": "PERSONAL FINANCE PLANNING",
    "describe_ch": "本課程旨在介紹個人理財規劃的基礎知識，包括理財工具應用與短、中、長期的理財規劃，並透過儲蓄、投資和保險等實現理財目標。本課程藉由個案分析和理財軟體的實作，協助同學瞭解理財規劃重要，以達到財務目標。",
    "describe_eh": "This course is designed to provide an overview of the basics of individual financial planning, covering the use of financial tools and short, medium, and long-term financial planning, and achieve financial goals through saving, investing, and insurance. With the aid of case analysis and the implementation of financial software, this course assists students in understanding the importance of financial planning to achieve financial goals.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具有理財規劃的基本概念",
      "describe_en": "The basic concepts of financial planning."
    },
    {
      "seq": 2,
      "describe_ch": "應用各種理財工具，達到理財規劃的目標",
      "describe_en": "Employ variety financial instruments to reach financial planning objectives."
    }
