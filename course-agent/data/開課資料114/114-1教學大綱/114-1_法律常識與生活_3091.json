  "description": {
    "sub_id3": null,
    "sub_name": "法律常識與生活",
    "sub_ename": "COMMON KNOWLEDGE AND LIFE FOR LAWS",
    "describe_ch": "幫助同學們理解法律規定如何與日常生活產生連結，講述內容包括民事、刑事、訴訟、行政、智慧財產、勞動法規、公寓大廈等，以及實務上的相關法律文書如契約書狀、支付命令、存證信函等。引導同學們經由生活化的有趣案例及課堂討論分享，激發同學們的學習興趣，從而進一步訓練其如何找出生活事件的法律爭點，並培養其一定程度的思考判斷能力，以至於日後碰到生活上的任何法律問題，都可以有辦法去找尋答案，知道怎麼處理。",
    "describe_eh": "The laws and regulations of civil, criminal, litigation, administration, intellectual property, labor regulations, apartment buildings, etc., as well as practical related legal documents such as contracts, payment orders, depository Letters of Attestation, etc. shall be taught to students for their comprehension of the relationship with common life. The students will be guided to share interesting cases and classroom discussions to stimulate their interest in learning, so as to further train them to find out the legal issues of life events, and to cultivate their ability to think and judge to a certain extent, so that when the students encounter any legal problems in their life in the future, they may have a way to find the answer and know how to deal with it.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能熟悉現代生活常用法律的知識探索。",
      "describe_en": "Able to be familiar with knowledge of laws and to explore for knowledge of laws commonly used in modern life."
    },
    {
      "seq": 2,
      "describe_ch": "能啓發並引導學生跨領域學習潛能，追求樂活的智慧人生。",
      "describe_en": "Able to inspire and guide students to develop potential ability for different fields and pursue a happy and intelligent life."
    }
  ],
