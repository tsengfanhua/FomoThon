  "description": {
    "sub_id3": null,
    "sub_name": "城鄉生態與規劃",
    "sub_ename": "BIODIVERSITY PLANNING OF CITY AND COUNTRY",
    "describe_ch": "從人類居住環境如何與生態大環境共生,進而探討生態性的規劃設計理念與實務。導引學生具備正確生態性之規劃設計觀念",
    "describe_eh": "Further to approaches for the achievement of harmony between human residence and ecological environment, we would also touch upon design principles and practices of ecological planning. We would also introduce basic concepts of ecological planning and design.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解「生態」與「環境」的基礎知識、意義與內涵。\r\n",
      "describe_en": "Understanding of fundamental knowledge, significance, and essence of “ecology” and “environment”."
    },
    {
      "seq": 2,
      "describe_ch": "理解現階段生態環境現況與面臨的困境。\r\n\r\n",
      "describe_en": "Comprehension of current status of ecological environment and dilemmas confronted."
    },
    {
      "seq": 3,
      "describe_ch": "運用吸取的環境生態原理進一步能應用於環境規劃與建築設計中。\r\n\r\n",
      "describe_en": "Application of environmental and ecological principles in environment planning and architecture design."
    }
  ],
