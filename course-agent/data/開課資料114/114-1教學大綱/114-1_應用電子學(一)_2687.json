  "description": {
    "sub_id3": null,
    "sub_name": "應用電子學(一)",
    "sub_ename": "APPLIED ELECTRONICS(1)",
    "describe_ch": "本課程的目的是提供對類比及數位電路之分析及設計的基本能力，包含銜接實際應用的一些進階示範。上學期介紹主要元件的物理性質、工作特性和基本的應用電子電路分析。",
    "describe_eh": "The purpose of this course is to provide a basic foundation for analyzing and designing both analog and digital electronic circuits. More advanced material about practical applications are included. In the first part of this course,we introduce the physical characteristics and operation of the major semiconductor dvices and the basic circuits in which they are used.",
    "pre_subname": "PHYS1003普通物理(一)、PHYS1004普通物理(二)",
    "pre_sub_id3": "PHYS1003",
    "pre_sub_ename": "PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠描述及推演diode及BJT元件的基本原理。　",
      "describe_en": "Be able to describe and derive the basic theory of diode and BJT devices.　"
    },
    {
      "seq": 2,
      "describe_ch": "能閱讀廠商發表的元件資料手冊，理解真實元件與理想模型之間的差異，並了解其運用上的限制及好處。",
      "describe_en": "Be able to read and study the device datasheet from their manufacturers. Understand the difference between real devices and ideal models，and realize the application limit and advantage of them."
    },
    {
      "seq": 3,
      "describe_ch": "透過分組作業培養團隊合作精神及有效溝通能力。",
      "describe_en": "To develop team spirit and the ability of efficient communication through teamwork."
    }
  ],
