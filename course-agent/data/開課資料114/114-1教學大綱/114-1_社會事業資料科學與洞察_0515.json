  "description": {
    "sub_id3": null,
    "sub_name": "社會事業資料科學與洞察",
    "sub_ename": "DATA SCIENCE AND INSIGHTS FOR SOCIAL ENTERPRISES",
    "describe_ch": "本課程將透過實作模式帶領同學對社會議題進行探究與分析。學生除了可以學習到資料科學的方法與分析過程之外，也能夠建立社會事業所需之決策管理思維與資訊解釋能力。",
    "describe_eh": "This course uses practice activities to explore and analyze social issues. Students will not only learn methods and processes of data science but also develop decision-making and information interpretation skills essential for the management of social enterprises.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
