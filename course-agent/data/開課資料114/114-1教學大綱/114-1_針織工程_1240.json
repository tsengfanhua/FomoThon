  "description": {
    "sub_id3": null,
    "sub_name": "針織工程",
    "sub_ename": "KNITTING TECHNOLOGY",
    "describe_ch": "使學習者充分瞭解針織工程之基本原理、理論及其各種針織物製品應用。以培養學習者具備針織工程的研究及開發基本能力。",
    "describe_eh": "To describe the production of knitting fabrics. It covers all important aspects of the conversion of fiber into fabrics, including winding and preparation; shedding, picking, beating up, letting off, and taking up of shuttle loom; and fabric propertes.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
