  "description": {
    "sub_id3": null,
    "sub_name": "電化學",
    "sub_ename": "ELECTROCHEMISTRY",
    "describe_ch": "由於電化學技術應用於日常生活與日遽增，此課程的目的在介紹電化學反應的基本原理與構成要素。課程中涵蓋基礎電化學分析方法之學習以及電化學理論於各種產業或研究上之最新方法。有助於提升學生對了解電化學相關產業與研究上之能力。",
    "describe_eh": "Since the application of electrochemical technology has recently rapid increasing, the purpose of this course is to introduce the basic principles and constituent elements of electrochemical reactions. The course covers the learning of basic electrochemical analysis methods and the latest developments corresponding to the electrochemical applications in various industries or academic research. It is helpful to enhance students' ability to understand electrochemical-related industries and academic research.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解電化學中的基本組成：電流與電極電位",
      "describe_en": "To understand the basic components including electric currents and electrode potentials in electrochemistry."
    },
    {
      "seq": 2,
      "describe_ch": "分辨電解質的種類並瞭解質量於電解質中如何傳導",
      "describe_en": "To distinguish the types of electrolytes and realize the mass transfer in electrolytes."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解各種電化學分析技術",
      "describe_en": "To comprehend the analytic techniques in electrochemistry."
    }
  ],
