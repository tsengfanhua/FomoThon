  "description": {
    "sub_id3": null,
    "sub_name": "地方創生-目標管理與行銷組織",
    "sub_ename": "COMMUNITY DEVELOPMENT AND DEPOWERMENT - DESTINATION",
    "describe_ch": "為面對我國總人口減少、高齡化、人口過度集中大都市，以至城鄉發展失衡，透過地方創生計畫，以人為本，打造地方特色產業經濟發展，創造就業機會，發展城鄉新風貌。 本課程大綱：透過農村再生計畫，介紹區域亮點，以工作坊研討機制，透過課程講解、影片分享、個案研討、實地參訪，調研地方特色，了解農村發展優劣勢，激發學生的學習興趣，以分組專案研討，成果報告。",
    "describe_eh": "Population aging and outflow cause continuous challenges in the agricultural communities. A lack of young labor deteriorates the rural development, and the imbalanced development between urban and rural areas is a major concern in Taiwan. This course investigates crucial interconnections between empowerment and community development. Various approaches including community participation, in-class lecture and presentation, case study, workshop and field trip will be used in this class. The goal is to train students how to analyze the weakness and strength of rural communities from different perspectives, and more importantly, to provide possible solutions to rejuvenate the communities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "幫助學生對地方創生的了解。",
      "describe_en": "Help students understand place revitalization."
    },
    {
      "seq": 2,
      "describe_ch": "提升其對地方創生的計畫創意力與計畫力。",
      "describe_en": "To help enhance students' creativity and planning for local creation"
    }
  ],
