  "description": {
    "sub_id3": null,
    "sub_name": "會計學(一)實習",
    "sub_ename": "RECITATION OF ACCOUNTING(1)",
    "describe_ch": "本課程介紹基本會計學原則及觀念，主要包括：會計循環, 現金,應收帳款、存貨、長期性資產取得及折舊、公司會計、投資、負債及財務報表分析。\r\n",
    "describe_eh": "This course introduces basic accounting principle and concepts. The main topics include accounting cycle, cash, receivable, inventory, plant assets acquisition and depreciation, corporate accounting, investment, liabilities and financial statements analysis。",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 18,
      "describe_ch": "能知道會計學(一)涵蓋的主要內容及現代企業的財務報表和其限制。",
      "describe_en": "Knowledge for the content of Accounting I and modern business financial statements and their limitations."
    },
    {
      "seq": 19,
      "describe_ch": "能理解可應用會計學原理的情況。",
      "describe_en": "Comprehension for the application accounting principle situation. \r\n"
    }
  ],
