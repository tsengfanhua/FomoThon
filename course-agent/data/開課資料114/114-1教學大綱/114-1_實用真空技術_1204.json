    },
    {
      "seq": 3,
      "describe_ch": "真空計工作原理與特性",
      "describe_en": "Working Principles and Characteristics of Vacuum Gauges"
    },
    {
      "seq": 4,
      "describe_ch": "流量計工作原理與特性",
      "describe_en": "Working Principles and Vharacteristics of Flow Meters"
    },
    {
      "seq": 5,
      "describe_ch": "氦測儀之工作原理與實作",
      "describe_en": "Working Principles and Practical Implementation of Helium Leak Detectors."
    }
