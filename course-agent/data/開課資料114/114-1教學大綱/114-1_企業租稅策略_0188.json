    {
      "seq": 1,
      "describe_ch": "綜合各種企業租稅規劃觀念及基本架構",
      "describe_en": "Synthesis for the conceptual framework for corporate tax planning"
    },
    {
      "seq": 2,
      "describe_ch": "評估各種議題下的企業租稅規劃方案",
      "describe_en": "To evaluate various subjects for corporate tax planning"
    }
