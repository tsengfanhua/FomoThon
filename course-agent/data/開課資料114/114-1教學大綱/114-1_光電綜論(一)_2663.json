  "description": {
    "sub_id3": null,
    "sub_name": "光電綜論(一)",
    "sub_ename": "OVERVIEW OF PHOTONICS(1)",
    "describe_ch": "本課程目的為簡介光電領域的主要課題及其發展。本課程會安排演講分享多元學習與光電產業介紹，以引導學生思考未來出路與生涯規劃。此外本課程也將以Arduino搭配程式語言為基礎進行新鮮人專題。本課程將採用多元教學和評量方式。",
    "describe_eh": "The goal of this course is to introduce the main fields and their evolutions in Optics and Photonics. Seminars on diverse learning and photonic industries will be included to promote students’ prospect and career planning in the field. A freshman project based on Arduino and a programming language will be implemented in this course. Diversified teaching and evaluation methods will be employed in this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "描述光電領域的基礎概念。",
      "describe_en": "To describe the basic principles of Optics and Photonics."
    },
    {
      "seq": 2,
      "describe_ch": "透過演講認識多元學習、光電科技新興技術之趨勢與永續發展。　",
      "describe_en": "To understand diverse learning, the trends of emerging photonics technologies, and sustainable development through seminars"
    },
    {
      "seq": 3,
      "describe_ch": "使用程式語言。",
      "describe_en": "To apply a programming language."
    },
    {
      "seq": 4,
      "describe_ch": "透過團隊合作完成課程分組活動，理解團隊合作重要性。",
      "describe_en": " To complete the small group activities through teamwork and to understand the importance of teamwork"
    }
  ],
