  "description": {
    "sub_id3": null,
    "sub_name": "纖維檢驗實習",
    "sub_ename": "FIBER TESTING PRACTICE",
    "describe_ch": "規劃使學生學習如何檢驗不同織物之各種性質，並學習如何操作使用其檢驗儀器，如：水平燃燒試驗儀、爆破試驗儀、挺硬試驗儀、耐水壓試驗儀等。以培養學生具備樣品檢測之基本能力，更進一步了解各種織物的相關特性。",
    "describe_eh": "Let students study to examine various properties of fabrics, and then learn to operate various testing apparatuses, such as a horizontal burning tester, a bursting testing machine, a stiffness tester, a water resistant tester, etc. Students can have the fundamental ability to measure various properties of samples, and then know the properties of different fabrics.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養瞭解及學習纖維製品的種類、特性、功能的能力",
      "describe_en": "To train the abilities of learning classification, characteristic and function of textiles."
    },
    {
      "seq": 2,
      "describe_ch": "培養瞭解及學習纖維製品檢驗之機器及儀器操作的能力",
      "describe_en": "Training how to operate machine of textile testing and inspection."
    },
    {
      "seq": 3,
      "describe_ch": "培養瞭解及學習纖維製品檢驗實驗應用領域及其發展前景的能力",
      "describe_en": "To train the abilities of learning application field and development vision of textile testing and inspection."
    },
    {
      "seq": 4,
      "describe_ch": "理解纖維製品檢驗在工業上之應用",
      "describe_en": "Comprehension for textile testing in industrial applications."
    }
  ],
