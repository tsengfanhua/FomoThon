  "description": {
    "sub_id3": null,
    "sub_name": "坡地穩定與崩坍治理工程",
    "sub_ename": "SLOPE STABILITY AND LANDSLIDE TREATMENT WORKS",
    "describe_ch": "邊坡土體崩坍係造成坡地土砂災害之主要原因，包括土石流、山崩及落石等均與土體崩坍直接相關。因此，本課程先從土體崩坍的基本理論?坡地穩定出發，以土體穩定之力學原理，說明坡地土體穩定及其破壞之基本原因和分析模式，接著依土體崩坍原因及規模，說明相關治理工程及其適用性，以協助修課學生深入瞭解崩坍問題及相關的治理工程。",
    "describe_eh": "Slope mass failure is the main cause for slope disaster, including debris flow, landslide and rock fall has direct relationship for mass failure. Therefore, this course starts from the basic theory of mass failure, and from mechanism theory of slope stability, we explain the basic reason and analysis model between slope mass stability and failure. Later on, according to the cause and scale of mass failure, this course explain the relative treatment construction and suit age in order to help the students who take the course to understand well  the problem of landslide and it's relative treatment methods.",
    "pre_subname": "HY3015水土保持工程",
    "pre_sub_id3": "HY3015",
    "pre_sub_ename": "HY3015 SOIL AND WATER CONSERVATION ENGINEERING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.理解坡地穩定與崩坍地防治之基本觀念與意義\t",
      "describe_en": "1.Understand the concept and significance of slope stability and landslide treatment"
    },
    {
      "seq": 2,
      "describe_ch": "2.學習坡地穩定之基本原理\t",
      "describe_en": "2. Learn the basic theorem of slope stability."
    },
    {
      "seq": 3,
      "describe_ch": "3.理解坡地穩定與崩坍地防治之內容及方法\t",
      "describe_en": "3. Understand the contents and control methods for slope stability and landslide treatment"
    },
    {
      "seq": 4,
      "describe_ch": "4.理解崩坍地防治設計之基本原理",
      "describe_en": "\t4. Understand the basic theorem of design for landslide treatment"
    }
  ],
