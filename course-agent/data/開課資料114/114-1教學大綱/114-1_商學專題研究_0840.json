  "description": {
    "sub_id3": null,
    "sub_name": "商學專題研究",
    "sub_ename": "BUSINESS TOPICS",
    "describe_ch": "本課程旨在使大四同學能利用先前所學的知識與分析工具進行商學問題研究。由學生委請一位指導老師擔任指導教授指導，以協助學生完成一個專題，必須在時限內完成，並公開發表，做為學習成果的展現。",
    "describe_eh": "This course aims to use the knowledge and analysis tools students have learned to conduct business research. An instructor is appointed by the students to serve as the instructor to assist students in completing a business topic, which must be completed within the time limit and published publicly as a display of learning results.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 4.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用溝通技巧有效的表達研究議 題的思辯邏輯",
      "describe_en": "Apply communication skills to effectively express the dialectical logic underlying the issue of study."
    },
    {
      "seq": 2,
      "describe_ch": "理解研究議題中相關的外部性與 道德分際",
      "describe_en": "Recognize the externalities and ethics on the related issue of study"
    },
    {
      "seq": 3,
      "describe_ch": "理解研究議題之相關參考文獻",
      "describe_en": "Recognize the related literature of study."
    },
    {
      "seq": 4,
      "describe_ch": "應用所學專業知識理解研究議題 的問題能力",
      "describe_en": "Apply the professional knowledge learned in classes on the issue of study."
    },
    {
      "seq": 5,
      "describe_ch": "瞭解當代議題對企業環境、社會 及全球的影響，並能持續學習的能力",
      "describe_en": "To understand the impact of contemporary issues on the corporate environment, society and the global."
    }
  ],
