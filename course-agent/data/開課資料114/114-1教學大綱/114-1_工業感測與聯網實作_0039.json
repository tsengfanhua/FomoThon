  "description": {
    "sub_id3": null,
    "sub_name": "工業感測與聯網實作",
    "sub_ename": "INDUSTRIAL SENSING AND NETWORKING IMPLEMENTATION",
    "describe_ch": "本課程旨在教導學員透過環境感測訊號的偵測，以及雲端聯網技術，即時監控工廠運作狀況，並能使用Arduino微控制器進行各種不同類型的信號感測。",
    "describe_eh": "This course aims to teach students to monitor the operation of the factory in real time through the detection of environmental sensing signals and cloud networking technology, and to use Arduino microcontrollers for various types of signal sensing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠瞭解進行研究工作之方法及所需之邏輯概念，而能有效率且正確地進行各種不同類型的研究。",
      "describe_en": "The objective is to aid students in understanding the required logistical concepts for conducting research works."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解進行研究工作前所需之準備工作，如文獻蒐集，及研究進行時所需之方法及邏輯概念。",
      "describe_en": "The objective is to help students know how to prepare the thesis works such as literature survey research method and logics before starting research."
    }
  ],
