  "description": {
    "sub_id3": null,
    "sub_name": "日語會話",
    "sub_ename": "JAPANESE CONVERSATION",
    "describe_ch": "培養學生的日語會話能力，目的是希望學生們在日常生活中能因時、因地、因人自然的說出合宜的日語會話，建立自信。",
    "describe_eh": "In this course, you will learn how to confidently and correctly converse in Japanese.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.學習日語自然會話有助於與日本人間的溝通、合作，強化自我表達能力。",
      "describe_en": "1. To successfully and confidently communicate and collaborate in Japanese and learn how to speak Japanese in a natural way"
    },
    {
      "seq": 2,
      "describe_ch": "2.藉由會話熟習日本人與人的應對文化，並藉此區別國與國的文化差異。",
      "describe_en": "2. To become familiar with the way Japanese is used in conversational situations and understand cultural differences between Taiwan and Japan"
    }
  ],
