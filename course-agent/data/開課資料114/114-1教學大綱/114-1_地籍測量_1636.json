  "description": {
    "sub_id3": null,
    "sub_name": "地籍測量",
    "sub_ename": "CADASTRAL SURVEYING",
    "describe_ch": "地籍測量是應用規定的方法與程序，測量每筆土地的四至界址、形狀、計算面積、編定地號，繪製成地籍圖，以供作土地標示登記之依據。課程含括地籍調查、控制測量、戶地測量、面積計算、土地複丈及建物測量等內容。",
    "describe_eh": "Cadastral surveying is the use of specified methods and procedures, measuring the land boundary, shape, area, plotted as the cadastral map, and description of the land registration. Courses including cadastral survey, control survey, parcel survey and area calculations, land resurveying and building surveying etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 5,
      "describe_ch": "能認識地籍測量基本法規。",
      "describe_en": "To recognize cadastral regulations.\r\n"
    },
    {
      "seq": 6,
      "describe_ch": "能理解地籍調查與控制測量之方法與精度需求。",
      "describe_en": "Understanding cadastral survey method and accuracy of measurement and control requirements\r\n"
    }
