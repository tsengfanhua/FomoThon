  "description": {
    "sub_id3": null,
    "sub_name": "工程風險管理",
    "sub_ename": "PROJECT RISK MANAGEMENT",
    "describe_ch": "本課程主要內容為介紹風險管理與決策分析之基礎理論，及其在工程管理上之應用。透過各種風險決策模式之比較與分析，使學生具有工程風險管理應有之知識與技術，進而能夠發展系統化之風險管理程序，以最佳策略進行工程生命週期中不確定情況下之決策。",
    "describe_eh": "This course introduces the fundamental theories and techniques of decision-making under uncertainty and the applications for construction management. Through the systematic strategy for risk management, students are expected to learn to make the optimal decisions in life cycle of the whole project.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解風險管理之基本概念與程序。",
      "describe_en": "Comprehension for the concept and whole procedure of risk management."
    },
    {
      "seq": 2,
      "describe_ch": "理解常用之不確定分析與相關決策方法。",
      "describe_en": "Comprehension for the common methods of decision-making under uncertainty."
    },
    {
      "seq": 3,
      "describe_ch": "分析國際工程風險管理應用實務與研究方法",
      "describe_en": "Analysis of international project risk management practice and research methodology"
    }
  ],
