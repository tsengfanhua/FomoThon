  "description": {
    "sub_id3": null,
    "sub_name": "薄膜技術",
    "sub_ename": "THIN-FILM TECHNOLOGY",
    "describe_ch": "了解真空薄膜技術之學理與應用，課程包含真空氣相薄膜沉積之基本原理、生長機制、製造技術、分析檢驗及其相關應用進行介紹。此外，真空系統之基本原理、硬體設備及實務操作等亦將進一步的進行探討。課程將著重學理及實務，以期可使學生銜接產業所需。",
    "describe_eh": "The aim of this course is to introduce the theory and application of vacuum thin film deposition. The course mainly contains vapor deposition technique and vacuum system technology. The former includes fundamentals, thin film growth mechanism, thin film growth techniques, characteristics/analysis of thin film, and applications; the later include principle, equipment, and practical operation. By linking the theoretical and practice, the course expects that student can meet the needs of the industry.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解真空系統中之氣體行為。理解各式常用真空氣壓計、真空幫浦、真空艙體之工作原理及使用時機。",
      "describe_en": "To understand the pressure and basic gas behaviors. To understand the basic working principle and selection of common vacuum gauge, vacuum pump and vacuum chamber."
    },
    {
      "seq": 2,
      "describe_ch": "認識薄膜成長機制，瞭解薄膜生長起始條件、成長理論及生長過程。能理解並分辨各種液相沉積、物理氣相沈積及化學氣相沈積等薄膜製作技術。",
      "describe_en": "To understand the film growth steps of surface adsorption, diffusion, nucleation and structure development.  To understand all kinds of thin film deposition principles and technology, PVD and CVD especially."
    },
    {
      "seq": 3,
      "describe_ch": "能熟知各項薄膜的基本性質，如薄膜之力學性質、光學性質、電學性質、磁學性質，並能對薄膜之各項特性進行檢測與應用評估。",
      "describe_en": "To measure and estimate thin film mechanical, electrical, optical, and magnetic properties. To understand the applications of thin film technology."
    }
  ],
