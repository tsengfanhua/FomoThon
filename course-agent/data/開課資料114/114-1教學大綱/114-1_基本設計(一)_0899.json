  "description": {
    "sub_id3": null,
    "sub_name": "基本設計(一)",
    "sub_ename": "BASIC DESIGN(1)",
    "describe_ch": "本課程為基本設計入門。課程目標為介紹設計的基本元素與組合原理，尤其著重光、影、造型、空間與材料的呈現和設計概念的操作技巧。模型製作的製造與過程亦是設計概念訓練項目重點之一，必須能夠將其設計概念完整呈現於2-D版面與立體模型，課程核心希望成果能綜合理性、知性與感性於思考及創作的過程中。",
    "describe_eh": "This is the introduction course in architectural design. The aim of the course is to introduce fundamental knowledge of design elements and principles, particular emphasis on light and shadow, form and space, and materials. Modeling making is also part of the design training, because the conceptual approach might be discovered through the making and creating process. The result of the course is the ability to represent the design concept and idea graphically in 2-dimension and translate into a quality 3-dimensional model at the end of first semester. It is also the central core of the course to think and create rationally, intellectually, and sensationally.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解基本元素操作",
      "describe_en": "Be able to understand the fundamental elements of architecture and its application"
    },
    {
      "seq": 2,
      "describe_ch": "能理解基本設計原則",
      "describe_en": "Be able to understand the fundamental design principles of architecture."
    },
    {
      "seq": 3,
      "describe_ch": "能應用圖面與模型表現於設計創作",
      "describe_en": "Be able to present the design concepts and ideas in 2-D architectural drawing and 3-D model."
    },
    {
      "seq": 4,
      "describe_ch": "能綜合理性、知性與感性於創作思考上",
      "describe_en": "Be able to think and create rationally, intellectually, and sensationally in design process."
    }
  ],
