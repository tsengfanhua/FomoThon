  "description": {
    "sub_id3": null,
    "sub_name": "光電材料分析",
    "sub_ename": "ANALYSIS OF PHOTONICS MATERIALS",
    "describe_ch": "本課程會介紹光電材料性質與應用的基本知識，及各種量測儀器基本原理與分析方法，使學生能正確選擇適當的光電材料分析工具及判斷分析數據與結果。本課程著重學理及實際案例解析。",
    "describe_eh": "This course will introduce the fundamental knowledge of the properties and applications of photonics materials, as well as the basic principle and analysis method of different measurement instruments. Students will be able to correctly select appropriate photonics material measurement tools and to analyze the data and results. The course emphasizes both theoretical learning and practical case studies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解材料分析的儀器原理。",
      "describe_en": "To know the principle of instruments for material analysis."
    },
    {
      "seq": 2,
      "describe_ch": "能應用材料分析的結果。",
      "describe_en": "To apply the data of material analysis."
    },
    {
      "seq": 3,
      "describe_ch": "能討論材料分析相關論文中的議題。",
      "describe_en": "To address the issues presented in papers of material analysis."
    }
  ],
