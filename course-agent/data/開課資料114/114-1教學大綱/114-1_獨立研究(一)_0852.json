  "description": {
    "sub_id3": null,
    "sub_name": "獨立研究(一)",
    "sub_ename": "INDEPENDENT STUDY(1)",
    "describe_ch": "為本學位學程必修課程。學生就其研究議題由該相關研究領域之教師擔任指導教授，經由研究動機、文獻探討與假說發展等訓練，將研究發現撰寫成研究計畫書，並且經由學科考之程序，完成該學分。",
    "describe_eh": "This is a required class for Master students. They should invite the adviser to teach them writing the research proposal according to business theory. Through the training of how to collect and analyze the research data, they could write the research proposal. Finally, students can complete the whole process after making an oral presentation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能批判性地檢視學術文獻，並找出商管進階議題中的研究缺口。",
      "describe_en": "Critically review academic literature and identify research gaps in advanced business and management topics."
    },
    {
      "seq": 2,
      "describe_ch": "能在學術研討場合中清晰且具說服力地發表研究計畫與成果。能撰寫結構完整、論述清晰、方法嚴謹且引用正確的碩士論文。",
      "describe_en": "Present research proposals and findings clearly and persuasively in academic seminars. Write a well-structured thesis with clear arguments, rigorous methodology, and accurate academic citation."
    },
    {
      "seq": 3,
      "describe_ch": "能在研究設計與結論建議中納入倫理與社會責任的考量。",
      "describe_en": "Integrate ethical considerations and social responsibility into research design and recommendations."
    },
    {
      "seq": 4,
      "describe_ch": "能運用適切的研究工具與資料分析軟體，解決跨領域的商業研究問題。",
      "describe_en": "Utilize appropriate research tools and data analysis software to solve interdisciplinary business problems."
    },
    {
      "seq": 5,
      "describe_ch": "能比較全球研究趨勢，並將國際觀融入碩士論文研究中。",
      "describe_en": "Compare global research trends and incorporate international perspectives into thesis work."
    }
  ],
