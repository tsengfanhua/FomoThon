  "description": {
    "sub_id3": null,
    "sub_name": "分析化學",
    "sub_ename": "ANALYTICAL CHEMISTRY",
    "describe_ch": "本課程是針對環境工程和科學學系的學生所設計，提供環工背景學生完整且嚴密的分析化學原理訓練。課程內容包含 (1)分析化學的介紹 (2) 統計分析 (3)各種化學分析法，如沉澱滴定法(4) 水化學 (5) 活性係數 (6) 電化學 (7) 分析實驗中化學藥品裝備及單元",
    "describe_eh": "A major objective of this curriculum is to provide a rigorous background in those chemical principles that are particularly important to the students of environmental engineering and science department.  The curriculum contents are (1) Introduction to analytical chemistry (2) Statistical evaluation of analytical data (3) Gravimetric methods of analysis (4) Titration methods of analysis\r\n(5) Aqueous solution chemistry (6) Activity and activity coefficient\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "說明什麼是分析化學及做分析的目的",
      "describe_en": "To state the analytical chemistry and understand its purpose."
    },
    {
      "seq": 2,
      "describe_ch": "理解做分析需要用到的基本方法、原理、工具及化學物質",
      "describe_en": "To comprehend the basic methods, principles, tools and chemicals in analytical chemistry.　"
    },
    {
      "seq": 3,
      "describe_ch": "理解在整個分析過程中會牽涉到的基本化學反應及其原理",
      "describe_en": "To comprehend the basic chemical reactions and principles will involve in all analytical processes."
    },
    {
      "seq": 4,
      "describe_ch": "理解分析化學於環境工程實務的應用及其原理\t",
      "describe_en": "Understand the application and principles of analytical chemistry to environmental engineering practice"
    }
  ],
