  "description": {
    "sub_id3": null,
    "sub_name": "校外實習導論",
    "sub_ename": "INTRODUCTION TO OFF-CAMPUS INTERNSHIP",
    "describe_ch": "為拓展學生在校外實習場域之職場基本知識，落實本校推動校外實習之特色與精神，本課程將引導學生提早認識職場環境，讓學生在投入職場之初步階段，可以順利融入工作環境，做好實習前的準備。",
    "describe_eh": "To enhance the students' knowledge regarding to internship program outside the campus, and in response to the features and objectives of the internship program, the course would cultivate the students with the advance knowledge of the workplace environment. This can help the students integrate into the work environment successfully and to be ready to practice in the early stage of their career.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識校外實習目的及修課規範。",
      "describe_en": "Students possess the knowledge relating to purpose of internship program and course content."
    },
    {
      "seq": 2,
      "describe_ch": "認知企業之文化及職安衛法規，能關注當代文化議題的能力。",
      "describe_en": "Students possess the knowledge relating to organizational culture and occupational safety regulations, the ability to focus on contemporary cultural issues."
    },
    {
      "seq": 3,
      "describe_ch": "理解工作倫理與實習職場態度。",
      "describe_en": "Students possess the awareness of workplace ethics and positive attitudes in internship program."
    }
  ],
