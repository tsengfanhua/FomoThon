  "description": {
    "sub_id3": null,
    "sub_name": "競爭法與智慧財產權",
    "sub_ename": "COMPETITION LAW AND INTELLECTUAL PROPERTY",
    "describe_ch": "競爭法和智慧財產權目的都是促進經濟發展與保護消費者。但二者間的競合關係也不可忽視，競爭法在於保障競爭自由及公平，避免獨佔，而智慧財產權則往往賦與獨佔權利。如何在兩者間取得平衡，是本課程討論之重點。",
    "describe_eh": "Competition law and intellectual property are both laws that Promote economic development and protect customers' welfare. Only that the co-opetition relationship between these two shall not to be neglected. The common view is that the competition law sought to eliminate monopolies, while the intellectual property law tends to create monopolies. Issues at the intersection of competition law and intellectual property laws have attracted a significant amount of attention.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生能描述競爭法與智慧財產權法之特色。",
      "describe_en": "Students would be able to describe the characteristics of competition law and intellectual property right."
    },
    {
      "seq": 2,
      "describe_ch": "學生能對各種類的智慧財產保護態樣可加以描述，且了解常見之相關問題。",
      "describe_en": "Students would be able to describe a variety of IP protections, and understand the common issues derived from within."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉並了解智慧財產權與競爭法之行使議題。",
      "describe_en": "Understand the issue of intellectual property right and the characteristics of competition law enforcement."
    }
  ],
