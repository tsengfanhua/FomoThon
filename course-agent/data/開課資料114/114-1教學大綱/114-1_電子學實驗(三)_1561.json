  "description": {
    "sub_id3": null,
    "sub_name": "電子學實驗(三)",
    "sub_ename": "ELECTRONICS LAB.(3)",
    "describe_ch": "學習過本課程後，瞭解運算放大器(OPA)在放大器與比較器的兩大應用領域；電路結構的特色，與針對應用功能需求的設計上之推演，以及DC不理想性的補償等實務電路的技術。",
    "describe_eh": "After the process of this course , We can understand the keystructure of OPA-based amplifier and Comparator applications .n addition , be able to implement a design circuit for experiments and make some basic design capability . Especially make some practical circuit design to compensate the DC nonideal characteristics",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備實驗管理、團隊解決問題與有效溝通的能力。",
      "describe_en": "Be able to manage experimental project and cooperate with team members."
    },
    {
      "seq": 2,
      "describe_ch": "能使用模擬軟體模擬並且應用於實驗結果的對照。",
      "describe_en": "Be able to apply the circuit simulator to verify their measured results."
    },
    {
      "seq": 3,
      "describe_ch": "能應用OPA設計理論設計一些特定基本應用電路，並使用實驗方式驗證之。",
      "describe_en": "Be able to apply the OPA to design a specified basic application and measure the results."
    },
    {
      "seq": 4,
      "describe_ch": "能具體整理資料撰寫實驗報告。",
      "describe_en": "Have the knowledge of writing a complete experimental report."
    }
  ],
