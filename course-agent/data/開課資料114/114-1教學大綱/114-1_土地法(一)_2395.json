  "description": {
    "sub_id3": null,
    "sub_name": "土地法(一)",
    "sub_ename": "LAND LAW(1)",
    "describe_ch": "土地法乃於1920年代所立，屬於我國最早存在之法典之一。其內容包含兩大部分，分別是不動產交易（分配）的調節與土地利用的管制機制。由於過去七十餘年間社會政經結構劇變，土地法本身已歷經多次修改，甚至在特定領域中有不少部分已為其他法規所取代，故今日觀之，實則土地法已是一個極為龐大的法規集合體。為能有效導引學生理解土地法規，本課程依其內容分成三部份，關於不動產交易部份涉及民法，故將適度複習民法相關課程，並採用案例方式以增進學習成效。",
    "describe_eh": "Land laws play the key role as control mechanism for rational spatial developments (inclusive land use) and healthy real estate market. Part 1 of this course begins from the point where the land laws relevant to theories of civil law und will provide deep, inside examination about land policy and problems in real estate market.",
    "pre_subname": "LAND1005中華民國憲法、LAND1006民法概要(一)、LAND1007民法概要(二)",
    "pre_sub_id3": "LAND1005",
    "pre_sub_ename": "LAND1005 CONSTITUTION OF THE R.O.C.、LAND1006 INTRODUCTION TO CIVIL LAW(1)、LAND1007 INTRODUCTION TO CIVIL LAW(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "協助學生瞭解空間法制之基本原理",
      "describe_en": "Help the students to build up their theoretical knowledge basis about spatial (land) laws."
    },
    {
      "seq": 2,
      "describe_ch": "協助學生瞭解現行土地相關法制",
      "describe_en": "To assist students in understanding the contents of current land laws in Taiwan."
    },
    {
      "seq": 3,
      "describe_ch": "協助學生建立實務土地法問題之解決能力",
      "describe_en": "Build up the capability of students by solving the land law problems und conflicts."
    }
  ],
