  "description": {
    "sub_id3": null,
    "sub_name": "職涯發展磨課師",
    "sub_ename": "MOOCS FOR CAREER DEVELOPMENT",
    "describe_ch": "本課程首先教授學生磨課師自主學習的相關平台、課程與有效學習方法，接著透過Coursera??成功 專項課程及相關中文平台課程，讓同學學會透過磨課師平台進行自主與分享學習，最後輔導學生有效完成相關課程學習，取得通過成績完成相關平台認證。",
    "describe_eh": "This course first teaches the knowledge and methodology of self-directed learning for courses at MOOCs, then, through the Coursera the Career Success Specialization courses and related Chinese platform courses, students can learn to use MOOCs platform to conduct self-directed and group shared learning, and finally tutor students Effectively complete the relevant course study and obtain the relevant platform certification.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解磨課師線上課程與學習基本知識與能力，深化國際交流體驗能力。",
      "describe_en": "Understand the basic knowledge of MOOCs platform learning"
    },
    {
      "seq": 2,
      "describe_ch": "能夠分組團隊完成線上課程學習與分享探索科技知識原理，增進科普應用能力。",
      "describe_en": "Form course group project learning and application capabilities of MOOCs platform learning"
    }
  ],
