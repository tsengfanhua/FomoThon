  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CI2331A",
    "sub_id": "04240",
    "scr_dup": "001",
    "sub_title": "超大型積體電路半導體製程介紹",
    "sub_title_en": null,
    "sub_describe": "介紹超大型積體電路半導體製程原理與技術介紹，相關主題為熱製程, 擴散製程, 薄膜沉積, 蝕刻與金屬化製程介紹",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "超大型積體電路製程",
    "sub_ename": "VLSI TECHNOLOGY",
    "describe_ch": "陳述超大型積體電路製程技術，能概述半導體晶圓製造之晶圓清洗、加熱處理、微影技術、薄膜沉積、電漿製程、離子佈植及金屬連線等製程。實施案例說明與問題討論。",
    "describe_eh": "Present the semiconductor process of the VLSI technology, including the wafer manufacture process and device fabrication. Wafer cleaning, thermal process, lithography, thin film deposition, plasma process, ion implantation and metallization will be introduced. Case studies are also explained and discussed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知道積體電路製程的基本觀念。",
      "describe_en": "To know the basic knowledge of VLSI technology."
    },
    {
      "seq": 2,
      "describe_ch": "能知道積體電路製程的步驟與原理。",
      "describe_en": "To know the process steps and principle of VLSI technology."
    },
    {
      "seq": 3,
      "describe_ch": "能理解積體電路製程的製作方法與技術原理。",
      "describe_en": "To comprehend the fabrication and technology principles of VLSI technology."
    },
    {
      "seq": 4,
      "describe_ch": "能應用積體電路製程的製程技術於積體電路元件。",
      "describe_en": "To apply the VLSI technology in semiconductor devices of integrated circuits."
    }
  ],
