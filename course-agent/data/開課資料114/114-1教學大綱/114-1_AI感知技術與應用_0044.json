  "description": {
    "sub_id3": null,
    "sub_name": "AI感知技術與應用",
    "sub_ename": "AI PERCEPTION TECHNOLOGY AND APPLICATION",
    "describe_ch": "本課程使用樹莓派 ( Raspberry Pi )從零開始學習建構人工智慧應用。將介紹機器學習的基本概念，分享Google機器學習框架Tensorflow、Keras，並使用OpenCV和Python進行智慧影像處理，針對機器視覺基本原理進行影像分類專案(Image Project)、物件辨識專案(Image Project)。在實作中，讓學生可透過使用樹莓派（Raspberry Pi）和機器學習完成一個AI感知技術的應用。",
    "describe_eh": "This course uses Raspberry Pi to learn to build artificial intelligence applications from scratch. We will introduce the basic concepts of machine learning and share Google's machine learning frameworks Tensorflow and keras Then, using OpenCV and Python to carry out image processing, image classification and object recognition projects based on the basic principles of machine vision. In the implementation, we let students can complete an application of AI perception technology by using Raspberry Pi and machine learning.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠瞭解進行研究工作之方法及所需之邏輯概念，而能有效率且正確地進行各種不同類型的研究。",
      "describe_en": "The objective is to aid students in understanding the required logistical concepts for conducting research works."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解進行研究工作前所需之準備工作，如文獻蒐集，及研究進行時所需之方法及邏輯概念。",
      "describe_en": "The objective is to help students know how to prepare the thesis works such as literature survey research method and logics before starting research."
    }
  ],
