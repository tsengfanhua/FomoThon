  "description": {
    "sub_id3": null,
    "sub_name": "流體力學",
    "sub_ename": "FLUID MECHANICS",
    "describe_ch": "本課程提供機械與電腦輔助工程科系學生流體力學之基本知識。課程內容將包括流體力學之基本觀念、流體靜力學以及流體運動質、動量、能量守恆分析。此一課程有助於學習流體動力學和熱傳學等課程。",
    "describe_eh": "This course provides the basic knowledge of fluid mechanics for the mechanical engineering students. It contains an introduction to the basic concepts, fluid statics, the conservation of mass, momentum and energy in fluid motion. The course is in aid for learning the fluid dynamics and heat transfer.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)、ENGS1009應用力學(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)、ENGS1009 APPLIED MECHANICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解流體特性及流體力學基本理論",
      "describe_en": "Understand the fluid properties and the basic theories of fluid mechanics."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解流體力學理論於日常生活及實際工程之應用",
      "describe_en": "Understand the applications of fluid mechanics theories on daily life and on engineering practices."
    },
    {
      "seq": 3,
      "describe_ch": "培養建立流體力學系統分析模型之能力",
      "describe_en": "Develop the ability of creating analysis models of fluid mechanics systems."
    },
    {
      "seq": 4,
      "describe_ch": "培養利用數值分析方法或套裝軟體進行流體力學系統設計及分析之能力",
      "describe_en": "Develop the abilities of fluid mechanics system design and analysis by using numerical method and/or commercial software."
    }
  ],
