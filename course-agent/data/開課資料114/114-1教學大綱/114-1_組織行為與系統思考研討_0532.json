  "description": {
    "sub_id3": null,
    "sub_name": "組織行為與系統思考研討",
    "sub_ename": "SEMINAR ON ORGANIZATIONAL BEHAVIOR AND SYSTEM THINKING",
    "describe_ch": "此課程的主要目的在於傳授人類組織行為在個人及團體上應用之相關知識，包括和組織行為相關之架構及模型如何設計，以表達人們在各個情況下相關之應對進退之策略之介紹。主要是希望學生能藉此課程來達到對組織行為的了解。",
    "describe_eh": "The purpose of this course is to study human behavior in organization at the individual and group level , including the effects of organization structure on behavior; and to practice behavioral skills to improve your interpersonal effectiveness.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生理解員工行為與其認知、態度間的關係",
      "describe_en": "To understand the relations between recognition, attitude and behavior of organization members"
    }
