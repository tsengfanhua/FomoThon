  "description": {
    "sub_id3": null,
    "sub_name": "鋼結構檢測",
    "sub_ename": "INSPECTION OF STEEL STRUCTURE",
    "describe_ch": "本課程將鋼結構工程中常用的檢測方法作完整性的介紹，課程包括非破壞檢測應用範圍、目視檢測法、液滲檢測法、超音波檢測法及磁粒檢測法等。",
    "describe_eh": "This course has a complete coverage of common testing methods of steel structure, including nondestructive testing and its applications, visual testing, liquid penetrate testing, ultrasonic testing and Magnetic testing methods.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "針對鋼結構可能產生安全危害有完整認知。",
      "describe_en": "To know and concern with steel structure safety from users' viewpoint."
    },
    {
      "seq": 2,
      "describe_ch": "能用檢測儀器得知鋼結構潛在的安全性危害，並能夠描述主要發生原因。",
      "describe_en": "To discover steel structure potentially crisis of safety by measuring equipments, also describe major reason how crisis occurred."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉鋼結構檢測的原理與技術。",
      "describe_en": "To understand the principles and operation techniques of inspection of steel structure methods .　"
    }
  ],
