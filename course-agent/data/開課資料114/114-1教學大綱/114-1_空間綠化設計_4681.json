  "description": {
    "sub_id3": null,
    "sub_name": "空間綠化設計",
    "sub_ename": "INTERIOR SPACE GREENERY DESIGN",
    "describe_ch": "空間綠化對提升空間適意性、調節微氣候、淨化空氣與抒壓有著重要的效果。本課程目的在訓練學生認識常用景觀與室內植物及植栽設計原則，透過植栽設計練習與實務操作，使同學了解如何利用植物來營造戶外與室內空間。",
    "describe_eh": "Spatial greenery could increase spatial amenity, mitigate micro-climate, purify air and relieve tension effectively. The aim of this course is to train students to recognize landscape and interior plants and planting design criteria and through planting design and practical operation to let student understand how to use plants to create outdoor and interior spaces.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
