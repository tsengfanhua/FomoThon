  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用土木工程相關知識於實務工作。",
      "describe_en": "Be able to apply knowledge of Civil engineering in practical work."
    },
    {
      "seq": 2,
      "describe_ch": "能應用計畫管理及團隊合作完成實務工作。",
      "describe_en": "Be able to use project management and teamwork to complete practical work."
    },
    {
      "seq": 3,
      "describe_ch": "能應用文字或圖或成品及口頭報告的方式陳現實務工作或專題的成果。",
      "describe_en": "Be able to employ text, diagram, end product as well as oral report to show the outcome of practical work or project."
    }
