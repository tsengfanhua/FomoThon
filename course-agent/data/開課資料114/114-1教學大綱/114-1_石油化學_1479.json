  "description": {
    "sub_id3": null,
    "sub_name": "石油化學",
    "sub_ename": "PETROCHEMISTRY",
    "describe_ch": "石油化學是一門對石化工業之技術、製程加工用途及各類石油化學品等領域的學科，其目的在訓練學生並培養國內石化工業人才。此課程以介紹各項石化產品技術與種類為主的實用科學。",
    "describe_eh": "Petrochemistry is a lecture introducing the oil refining, oil processing and petroleum chemicals producing that range from C1-C4 chemistry and the BTX. The course provides the discipline of oil process and chemicals manufacturing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "訓練學生能夠認識各種石油化學產品與生產技術",
      "describe_en": "To be able to understand the oil processes and petrochemicals　"
    },
    {
      "seq": 2,
      "describe_ch": "能了解並說明石油化學產品在化學工業的重要性及影響性",
      "describe_en": "To realize the petrochemicals play an important role in industries applications"
    },
    {
      "seq": 3,
      "describe_ch": "能辨識出石油化學產品之種類及特性，並能清楚其使用之生產技術",
      "describe_en": "To be able to distinguish the various petrochemicals, and well known its manufacturing process."
    },
    {
      "seq": 4,
      "describe_ch": "以書面與口頭方式將所學習之結果呈現，並能與相關專長工程師溝通",
      "describe_en": "To be able to present the results by oral or writing report and the ability of communication with the related expertise engineer."
    }
  ],
