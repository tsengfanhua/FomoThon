  "description": {
    "sub_id3": null,
    "sub_name": "高等複合材料學",
    "sub_ename": "ADVANCED COMPOSITE MATERIALS",
    "describe_ch": "本課程除了建立學生對複合材料的基本的認識外，並對樹脂基材和補強材的結構,種類與合成，複合材料的基本設計觀念、加工方法與應用以及機械性質、破損機構和測試方法、機械性質做一深入探討.",
    "describe_eh": "The aims of this course are to establish the basic concepts of composite materials, and also to investigate the structure/function, kinds and polymerization of matrix resin. In addition, the design concept, manufacturing processes, fracture mechanism, reinforcement - matrix interface, testing methods and mechanical properties of composite materials also has been studied.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解複合材料之組成與應用",
      "describe_en": "Understand what the composition and applications of composite materials are."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解複合材料之加工技術及其原理",
      "describe_en": "Understand the technology and principles of composite processes."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解複合材料之機械性質測試與評估方法",
      "describe_en": "Understand the test methods and evaluation of mechanical properties of composite materials."
    },
    {
      "seq": 4,
      "describe_ch": "訓練學生能和同儕、及教師討論相關作業問題之解答",
      "describe_en": "Training the students can to discuss the solution procedures for homework problems with classmates, and the instructor."
    }
  ],
