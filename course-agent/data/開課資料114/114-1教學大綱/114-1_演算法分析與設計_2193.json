  "description": {
    "sub_id3": null,
    "sub_name": "演算法分析與設計",
    "sub_ename": "ANALYSIS AND DESIGN OF ALGORITHMS",
    "describe_ch": "演算法是利用計算機來解決問題的程序。唯有良好的演算法才能讓計算機發揮良好的效益。本課程將介紹如何有效的使用計算機來解決問題的技巧，包括如何設計與描述演算法、如何證明其正確性、以及如何分析其時間與空間的效益性。",
    "describe_eh": "An algorithm is a procedure for solving problems. Only efficient algorithms can use computers efficiently. The goal of this class is to introduce fundamental techniques of using computers efficiently. It includes how to design and express an algorithm, how to validate an algorithm, and how to analyze the performance of an algorithm.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠了解演算法對計算機的使用效益之重要性與影響",
      "describe_en": "Be able to comprehend the importance and effects of algorithms to the efficient use of computers."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉問題的困難度分類以及評估一個問題的困難度的方法。",
      "describe_en": "Learn the classification of difficulties of problems and techniques to evaluate the difficulty of a given problem."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉如何評估一個演算法的好壞的方法。",
      "describe_en": "Learn the techniques of evaluating the goodness of an algorithm."
    },
    {
      "seq": 4,
      "describe_ch": "熟悉演算法設計的一般策略並能針對較簡單的問題設計適合的演算法。",
      "describe_en": "Learn the strategies of designing algorithms and be able to design algorithms for solving some simple problems."
    }
  ],
