  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "PC29100",
    "sub_id": "43553",
    "scr_dup": "001",
    "sub_title": "本課程主要培育華語教學師資，尤其針對華人社會與文化中，偏屬於文化思想的部分，設計相關教學、討論和報告活動。",
    "sub_title_en": null,
    "sub_describe": "華人社會與文化，是個相當廣泛的領域，故本課程會分幾項子題，再融合歷史演變的脈絡，而讓學生具備分門別類且具時間縱軸的眼光，來把握整體的文化思想。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "華人社會與文化",
    "sub_ename": "THE SOCIAL AND CULTURAL OF OVERSEAS CHINESE",
    "describe_ch": "透過討論與分享，介紹並引導學生認知和外籍學生互動時的宏觀和微觀文化概念；幫助學生在廣義的華人社會概念下，培養文化觀，並了解文化習俗、文化產物和文化視野的關聯。",
    "describe_eh": "From the perspectives of TCSL, this course introduces Chinese society and culture, including Chinese history, geography, life style and technology, systems and customs, ideas and concepts.  It provides useful information to help students understand the relationship between the practices and perspectives, the products and perspectives of the cultures of the Chinese-speaking world, and appreciate Chinese culture while learning the language.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "辨別及列舉文化習俗與文化產物",
      "describe_en": null
    },
    {
      "seq": 2,
      "describe_ch": "文 化 視 野: 具 備 對 華 人 文 化 的 綜 合 性 了解",
      "describe_en": null
    },
    {
      "seq": 3,
      "describe_ch": "比較文化:比較華人文化和其他文化的差異",
      "describe_en": null
    }
  ],
