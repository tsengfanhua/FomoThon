  "description": {
    "sub_id3": null,
    "sub_name": "中級會計學(一)實習",
    "sub_ename": "RECITATION OF INTERMEDIATE ACCOUNTING(1)",
    "describe_ch": "本課程深入討論財務會計，主要內容包括：會計觀念及程序、資產評價、負債、業主權益、損益衡量、一般公認會計原則及程序、財務報告及分析。\r\n",
    "describe_eh": "This course discusses in depth the financial accounting. Topics covered include the review of accounting concepts and procedures, valuation of assets, liabilities, owners' equity, measurement of business income, generally accepted accounting principles and procedures, financial report and analysis.",
    "pre_subname": "ACCT1011會計學(一)、ACCT1012會計學(二)",
    "pre_sub_id3": "ACCT1011",
    "pre_sub_ename": "ACCT1011 ACCOUNTING(1)、ACCT1012 ACCOUNTING(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識財務報導所處之環境。",
      "describe_en": "To understand the financial reporting environment."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解資產之會計處理。",
      "describe_en": "To understand the accounting for assets."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解負債之會計處理。",
      "describe_en": "To understand the accounting for liabilities."
    },
    {
      "seq": 4,
      "describe_ch": "應用財務報表資訊",
      "describe_en": "To apply financial statement information"
    },
    {
      "seq": 5,
      "describe_ch": "理解國際會計準則，因應國際情勢",
      "describe_en": "To aware and apply International Financial Reporting Standards(IFRS)."
    }
  ],
