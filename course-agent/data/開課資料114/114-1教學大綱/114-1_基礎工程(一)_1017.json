  "description": {
    "sub_id3": null,
    "sub_name": "基礎工程(一)",
    "sub_ename": "FOUNDATION ENGINEERING(1)",
    "describe_ch": "基於土壤力學講授各種基礎工程相關之分析，包括基礎型式介紹、基礎型式之選擇、基礎承載力之計算與修正、土壤夯實、改良與穩定、邊坡穩定分析、側向土壓力之計算及擋土牆穩定分析。",
    "describe_eh": "Based on soil mechanics, this course covers corresponding analysis of foundations for a\nvariety of structures. Topics include ntroduction of types of foundations, selection of\nfoundation type, bearing capacity calculations and their modifications, soil\ncompaction, improvement and stabilization, slope stability analysis, computation for\nlateral earth pressure and stability analysis for retaining structures.",
    "pre_subname": "CE2071土壤力學、CE1001應用力學、CE2078材料力學",
    "pre_sub_id3": "CE2071",
    "pre_sub_ename": "CE2071 SOIL MECHANICS、CE1001 APPLIED MECHANICS、CE2078 MECHANICS OF MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用承載力計算方法至不同型式之基礎",
      "describe_en": "Application of the bearing capacity determining methods to different types of foundations"
    },
    {
      "seq": 2,
      "describe_ch": "能理解各種土壤穩定與改良的方法",
      "describe_en": "Comprehension for the soil stabilizations and the improving methods"
    },
    {
      "seq": 3,
      "describe_ch": "能進行邊坡穩定與擋土牆之分析",
      "describe_en": "Capable of performing stability analysis for slopes and retaining walls"
    }
  ],
