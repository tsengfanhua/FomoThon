  "description": {
    "sub_id3": null,
    "sub_name": "建築物理",
    "sub_ename": "PHYSICS OF ARCHITECTURE",
    "describe_ch": "「建築物理」涵蓋建築物理環境中有關音、光、熱、氣、水等各面向的建築環境理論，為建築環境控制的基礎。本課程以定量且科學的方法解析居住環境之物理現象，並提供設計規劃應用之依據，打造舒適、健康、節能之建築環境。",
    "describe_eh": "\"PHYSICS of ARCHITECTURE\" encompasses the theoretical aspects of the physical environment within buildings, including sound, light, heat, air, water, and other dimensions. It serves as the foundation for building environmental control. This course employs quantitative and scientific methods to analyze the physical phenomena in residential environments. It provides a basis for design and planning applications, aiming to create comfortable, healthy, and energy-efficient architectural environments.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解建築物理學的意義，並瞭解其對都市環境的影響。",
      "describe_en": " Be able to know the meaning of architectural physics and to know that how influence to city environment."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解建築物理的各項環境要素對於人生活於室內空間的舒適性之影響。",
      "describe_en": " Be able know every environment element of architectural physics and that how to influence the comfort for living indoor space."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解各項物理環境要素的原理及計算方法。",
      "describe_en": " Be able to know the theory of every physical environment element and it's method of calculation."
    },
    {
      "seq": 4,
      "describe_ch": "能瞭解如何應用各項物理環境要素於建築設計上。",
      "describe_en": " Be able to know how to apply every element of physical environment on the Architectural Design."
    },
    {
      "seq": 5,
      "describe_ch": "能以書面或口頭方式將所獲結果與教師溝通。",
      "describe_en": "Communicate results in written or oral form to the instructor."
    }
  ],
