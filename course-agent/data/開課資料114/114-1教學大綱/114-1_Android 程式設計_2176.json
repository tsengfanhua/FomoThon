      "seq": 2,
      "describe_ch": "能具備Android介面設計基礎概念",
      "describe_en": "Be able to obtain basic design concept of Android UI."
    },
    {
      "seq": 3,
      "describe_ch": "能具備Android程式設計能力",
      "describe_en": "Be able to obtain Android programing technology."
    }
