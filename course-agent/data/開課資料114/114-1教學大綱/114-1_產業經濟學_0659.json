  "description": {
    "sub_id3": null,
    "sub_name": "產業經濟學",
    "sub_ename": "INDUSTRIAL ECONOMICS",
    "describe_ch": "這課程除了為學生提供傳統工業組織理論外，更強調市場過程概念及交易費用之重要性。內容包括不同的市場及競爭理論、企業家、公司理論、市場結構及力量、價格及競爭手段、科技之研究及研發、公司合併及結盟、商業秘密及發明專利、廣告效用及工業政策等項目。",
    "describe_eh": "This course intends to provide students with, in addition to traditional price theories, concepts of the market process and transaction costs to understand firm behaviors and industries. Topics cover alternative views of market and competition, entrepreneurship, firms, market structure and power, pricing and competitive strategies, technology, R&D, mergers and cartels, vertical restraints, business franchising, trade secret and patent, advertising and industrial policies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備主流及新制度經濟學方式的思考能力及邏輯推理之能力",
      "describe_en": "Understand traditional price theories, markets and new institutional economics"
    },
    {
      "seq": 2,
      "describe_ch": "具備使用主流及新制度經濟學方法瞭解現實世界之能力",
      "describe_en": "Capable of applying traditional price theories and new institutional economics to the real world"
    },
    {
      "seq": 3,
      "describe_ch": "具備分析經濟世界之能力及有效的溝通能力",
      "describe_en": "Ability to analyze economic issues & write economic essays"
    }
  ],
