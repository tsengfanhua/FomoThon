  "description": {
    "sub_id3": null,
    "sub_name": "應用數理統計學(一)",
    "sub_ename": "APPLIED MATHEMATICAL STATISTICS(1)",
    "describe_ch": "本課程研討統計理論，以建立其他統計課程基礎，使學生在統計之理論上有較深一層之瞭解，使期能更正確的運用統計方法。主題包括：機率論、機率空間、隨機變數分配與函數、離散型機率分配、連續型機率分配和特徵函數。",
    "describe_eh": "This course provides  a solid and well-balanced introduction to probability theory and mathematical statistics. Topics covered include probability theory, probability spaces, distribution of random variables, distribution function of random variables, discrete probability distributions, continuous probability distributions, and characteristic functions.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解機率基本觀念與於其他專業領域的應用",
      "describe_en": "Comprehension  of  the fundamental theory of probability and its applications in various academic fields. \n"
    },
    {
      "seq": 2,
      "describe_ch": "應用大數法則、中央極限定理於統計與其他專業領域",
      "describe_en": "Ability to  apply  Law of Large Numbers, Central Limit Theorem and some modes of convergence of random variables and their applications in various academic fields."
    }
  ],
