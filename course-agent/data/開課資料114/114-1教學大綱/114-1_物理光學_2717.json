  "description": {
    "sub_id3": null,
    "sub_name": "物理光學",
    "sub_ename": "PHYSICAL OPTICS",
    "describe_ch": "本課程提供基本物理光學專業知識的介紹，課程內容主要包含七個部分：波的運動、電磁理論、光的傳播、波的疊加、偏極、干涉和繞射。",
    "describe_eh": "This course provides an introduction to the fundamentals of physical optics. The course mainly consists seven parts: Wave Motion, Electromagnetic Theory, Propagation of Light, Superposition of Waves, Polarization, Interference, and Diffraction.",
    "pre_subname": "OPT2001光學(一)、OPT2002光學(二)、ENGS2011工程數學(一)、ENGS2013工程數學(二)、OPT1005基礎光電工程數學",
    "pre_sub_id3": "OPT2001",
    "pre_sub_ename": "OPT2001 OPTICS (1)、OPT2002 OPTICS (2)、ENGS2011 ENGINEERING MATHEMATICS(1)、ENGS2013 ENGINEERING MATHEMATICS(2)、OPT1005 BASIC MATHEMATICS FOR PHOTONIC ENGINEERING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1. 能理解物理光學的基本相關原理。",
      "describe_en": "1. To comprehend the basic theories of Physical optics."
    },
    {
      "seq": 2,
      "describe_ch": "2.能分析實際光學系統中的物理光學問題。",
      "describe_en": "2. Be able to analyze physical optics problems in actual optics systems"
    }
  ],
