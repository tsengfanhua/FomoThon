  "description": {
    "sub_id3": null,
    "sub_name": "專題研究(一)",
    "sub_ename": "SPECIAL TOPICS STUDY (1)",
    "describe_ch": "修習本課程同學在專題指導教授督導下，運用所學知識進行專題研究，從中學習研究方法、培養實作能力及開拓視野。",
    "describe_eh": "The course provides students with an opportunity to investigate problems or issues in greater depth. Students must discuss the topic they wish to explore with the faculty. Upon completion of the approved topic, students will accumulate professional experience and broaden their view.　",
    "pre_subname": "OPT2001光學(一)、OPT2002光學(二)",
    "pre_sub_id3": "OPT2001",
    "pre_sub_ename": "OPT2001 OPTICS (1)、OPT2002 OPTICS (2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能設計與建立實驗及分析數據。",
      "describe_en": "Be able to design and set up experiments, as well as analyze data."
    },
    {
      "seq": 2,
      "describe_ch": ".能閱讀與分析專業期刊論文。",
      "describe_en": "Be able to read and evaluate journal papers.　"
    },
    {
      "seq": 3,
      "describe_ch": "能分析與解決專題研究中的光電問題。",
      "describe_en": "To analyze and solve the photonics-related problems in experiments.　"
    },
    {
      "seq": 4,
      "describe_ch": "能制訂專題研究工作計畫表以進行專題研究。",
      "describe_en": "Be able to make a schedule for project."
    },
    {
      "seq": 5,
      "describe_ch": "能以口頭或書面與同儕討論專題研究進度與結果。",
      "describe_en": "To discuss the progress or result of project with peers by oral or paper presentation."
    },
    {
      "seq": 6,
      "describe_ch": "理解工程與科技倫理議題並能於專題研究中遵行。",
      "describe_en": "To comprehend and apply the etic issues of technology and engineering."
    },
    {
      "seq": 7,
      "describe_ch": "能根據專題研究的需求設計光電元件、系統或是製程。",
      "describe_en": "Be able to design the opto-electrical elements, systems, or fabricating process according to the requirements of the researches."
    }
  ],
