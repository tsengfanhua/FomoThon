  "description": {
    "sub_id3": null,
    "sub_name": "數理統計",
    "sub_ename": "MATHEMATICAL STATISTICS",
    "describe_ch": "本課程將介紹隨機抽樣，統計推斷和抽樣分佈的概念，並介紹和使用基本抽樣分佈。此外，本課程還將介紹估計的主要方法，估?量的主要性質，未知參數的信賴區間和假設檢定。",
    "describe_eh": "This course will introduce the concepts of random sampling, statistical inference and sampling distribution, and state and use basic sampling distributions. Besides, the main methods of estimation, the main properties of estimators, confidence intervals for unknown parameters and test hypotheses will also be introduced.",
    "pre_subname": "FEAS2011機率論(一)",
    "pre_sub_id3": "FEAS2011",
    "pre_sub_ename": "FEAS2011 PROBABILITY (1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
