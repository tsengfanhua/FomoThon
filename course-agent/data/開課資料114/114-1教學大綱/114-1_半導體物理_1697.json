  "description": {
    "sub_id3": null,
    "sub_name": "半導體物理",
    "sub_ename": "SEMICONDUCTOR PHYSICS",
    "describe_ch": "半導體物理目的是讓學生了解半導體元件特性及操作基礎認識。?達此目的，必須對半導體材料物理有一深入學習，因此本課程由結合固態物理及量子力學，進而進入固態量子理論，最後達到了解半導體物理及半導體元件。",
    "describe_eh": "This course is to provide a basis for understanding the characteristic, operation and limitations of semiconductor devices. The goal of this course is to bring together quantum mechanics, the quantum theory of solids, semiconductor material physics, and semiconductor device physics. All of these components are vital to the understanding of both of the operation of present day devices and any future development in the field.",
    "pre_subname": "PHYS2005近代物理、PHYS1003普通物理(一)、PHYS1004普通物理(二)",
    "pre_sub_id3": "PHYS2005",
    "pre_sub_ename": "PHYS2005 MODERN PHYSICS、PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 9,
      "describe_ch": "能用自己的專業詞彙半導體物理中許多專有名詞。\t\t",
      "describe_en": "Describe and derive the basic related theories of semiconductor physics."
