  "description": {
    "sub_id3": null,
    "sub_name": "人因工程",
    "sub_ename": "HUMAN FACTORS ENGINEERING",
    "describe_ch": "課程分兩方面，（一）從生理學、心理學、電腦、工業設計、工業安全等領域探討使用者的各項生理及心理之限制及需要,以及認識正確的產品設計與正確尺寸的應用；（二）建築空間的基本人體尺寸、空間尺寸與生活基本機能的認識。課程重點置於室內設計時之符合人體工學之尺度的應用。",
    "describe_eh": "Ergonomics is an interdisciplinary course that involving physiology, psychology, computer, industrial design, industrial safety, etc. The purpose of this course is toward: (1) To use the human factors principles during design process of a product or a system to maximize the usability and avoid any possible human errors; (2) The acknowledge and applying of human dimension, space dimension and functions of human life while designing an Interior space.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知識重點在於同時理解掌握設計者與使用者之空間尺度行為與人體工學之相關尺寸",
      "describe_en": "The knowledge focus while understanding between designers and users of spatial scale and ergonomic dimensions."
    },
    {
      "seq": 2,
      "describe_ch": "理解人體工學之基本尺寸與空間尺度及使用行為模式之對話準確性",
      "describe_en": "Understanding basic dimension of the ergonomic and the dialog between spatial scale and accuracy using the behavior patterns."
    },
    {
      "seq": 3,
      "describe_ch": "有效應用人因工程之空間行為概念及人因尺寸於室內及建築之規劃設計中。",
      "describe_en": "Spatial behavior of the effective application of human factors engineering concepts and human dimensions for Interior and architectural design."
    }
  ],
