    {
      "seq": 1,
      "describe_ch": "能理解溝通與 談判中的資訊蒐集與運用",
      "describe_en": "Able to understand the data collection and use of information in communication and negotiation."
    },
    {
      "seq": 2,
      "describe_ch": "能理解談判之基本架構與概念",
      "describe_en": "Able to understand the basic structure and concepts of negotiation."
    }
