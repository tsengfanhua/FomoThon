  "description": {
    "sub_id3": null,
    "sub_name": "系統思考與破壞型創新商業分析",
    "sub_ename": "SYSTEMS THINKING AND BUSINESS ANALYSIS OF DISRUPTIVE INNOVATION",
    "describe_ch": "破壞型創新時代，誰能改變消費者的習慣誰就是贏家。唯有跳出既有領域框架，發揮系統思考看清問題全貌，並進行商業分析，才能在破壞型創新時代擬定有效的專案協助組織成長。本課程主要為教授系統思考與商業分析的方法和步驟以及如何將系統思考與商業分析整合應用在商業營運企劃案的撰寫，並藉由相關設計案例的互動學習與討論來有效率地提升學生的專案提案能力。",
    "describe_eh": "The work of business analysis is to determine the business needs, current capabilities, and define the business case before the project charter is created. The aim of this course is to teach students how to implement the work of business analysis of disruptive innovation by systems thinking method efficiently through case study and interactive discussion.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解系統思考與商業分析基本知識",
      "describe_en": "To know the basic knowledge of systems thinking and business analysis.\t"
    },
    {
      "seq": 2,
      "describe_ch": "學習運用系統思考進行商業分析\t",
      "describe_en": "Learning how to implement the work of business analysis by systems thinking.\t"
    },
    {
      "seq": 3,
      "describe_ch": "增進撰寫商業營運企劃案的能力。",
      "describe_en": "To enhance an ability for creating business case.\t"
    }
  ],
