  "description": {
    "sub_id3": null,
    "sub_name": "大學精進英文(一)中高級",
    "sub_ename": "Advanced English(1) High-Intermediate",
    "describe_ch": "本課程分四級授課，採用多元教學活動，協助學生運用語言學習策略，討論教材之議題，以深化英語閱讀、口說、與聽力的技能，並學習理解他人觀點及感受。",
    "describe_eh": "The course is divided into four levels and uses a variety of teaching activities to help students apply language learning strategies, discuss topics from their course materials, deepen their English reading, speaking, and listening skills, and learn to understand the different viewpoints and feelings of others.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用所學之學習策略，針對教材內容，有效地以外語表達自我想法，與他人進行溝通。",
      "describe_en": "Students can apply learning strategies to effectively convey their opinions regarding the themes presented in learning materials and communicate with others effectively."
    },
    {
      "seq": 2,
      "describe_ch": "藉由合作式學習，了解、尊重多元觀點。",
      "describe_en": "Through collaborative learning, students can understand and respect diverse perspectives."
    }
  ],
