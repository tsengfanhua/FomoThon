  "description": {
    "sub_id3": null,
    "sub_name": "機率論",
    "sub_ename": "PROBABILITY",
    "describe_ch": "將對進階線性控制理論作一簡介，其內容包含線性空間分析、狀態方程式及暫態響應，並對系統可控制性及可觀測性以及其穩定性做一分析。最後在說明狀態回授及估測及控制器設計及其應用。",
    "describe_eh": "Introduction of advance linear control theory, linear space analysis, state equation and response, controllability and observability, stability analysis, state feedback and estimation, controller design and applications, observer design and applications, nonlinear systems, time varying systems, applications of modern control theory.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1. 具備機率學的基礎理論推導以及問題解決之知識能力。",
      "describe_en": "1. Possess the knowledge of theory derivation and problem solving in fundamentals of probability."
    },
    {
      "seq": 2,
      "describe_ch": "2. 理解基本定理以及熟悉其應用。",
      "describe_en": "2. Comprehend fundamental principles and be familiar with their applications."
    }
  ],
