  "targets": [
    {
      "seq": 1,
      "describe_ch": "Understand the limits of functions and be able to compute the limits by applying basic formulas",
      "describe_en": "Understand the limits of functions and be able to compute the limits by applying basic formulas"
    },
    {
      "seq": 2,
      "describe_ch": "Understand the definition of the derivatives and be able to compute the derivatives via basic properties",
      "describe_en": "Understand the definition of the derivatives and be able to compute the derivatives via basic properties"
    },
    {
      "seq": 3,
      "describe_ch": "Be able to apply the derivatives to analyze the monotonicity and concavity of functions",
      "describe_en": "Be able to apply the derivatives to analyze the monotonicity and concavity of functions"
    },
    {
      "seq": 4,
      "describe_ch": "Be able to apply the derivatives to solve the maximum and minimum problems",
      "describe_en": "Be able to apply the derivatives to solve the maximum and minimum problems"
    },
    {
      "seq": 5,
      "describe_ch": "Realize the concept of the integrals and be able to apply fundamental theorem of calculus to compute the integrals",
      "describe_en": "Realize the concept of the integrals and be able to apply fundamental theorem of calculus to compute the integrals"
    },
    {
      "seq": 6,
      "describe_ch": "Be able to use a definite integral to obtain the area of the region between curves",
      "describe_en": "Be able to use a definite integral to obtain the area of the region between curves"
    },
    {
      "seq": 7,
      "describe_ch": "Be able to find the derivatives of logarithmic, exponential and inverse trigonometric functions",
      "describe_en": "Be able to find the derivatives of logarithmic, exponential and inverse trigonometric functions"
    }
  ],
