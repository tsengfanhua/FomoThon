  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "XC06111",
    "sub_id": "GM796",
    "scr_dup": "002",
    "tpa_score_new": null,
    "tpa_score_new_en": null,
    "course_pol": "【課程學習單】利用單元課程設計方式利用學習單請同學在課堂上經由課堂討論後進行筆記整理。每個單元都會有一個課程延伸小單元，如延伸閱讀，相關時事查詢，影片欣賞等方式的homework，讓學生可以學習更完整。\n【課程活動】透過課程活動的實踐，讓同學從親手動手做的過程中學習，如逢甲電影院。評分採用多元評量，如老師與同學一同互評，作品或搶答成績等方式。",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<div>要來上課，沒事不要缺席。課程學期單筆記要自己做，才是學習。</div>\n\n<div>測驗不要作弊，這是價值。</div>\n\n<div>課程作業要反思，這是求學問態度。</div>\n\n<div>不要說謊，誠實最重要。</div>\n\n<div>坐得住，才是學習之道。</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": null
  },
