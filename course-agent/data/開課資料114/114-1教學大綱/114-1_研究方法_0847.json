  "description": {
    "sub_id3": null,
    "sub_name": "研究方法",
    "sub_ename": "RESEARCH METHODS",
    "describe_ch": "本課程主要在協助研習者了解如何進行專業性之研究，包括：科學研究的意義、類別、功能、如何界定研究問題、文獻回顧之功能與方式、研究設計之原則、如何蒐集與分析資料、如何撰寫研究結論、建議等，以使本研習本課程之研習者，未來能擁有進行專業研究之基本能力。",
    "describe_eh": "This course provides students with fundamental knowledge of the research process, including measurement issues, research instruments, and analytical techniques. Writing a research proposal is required.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解研究方法之理論基礎",
      "describe_en": "To understand the theoretic foundation of the research methods."
