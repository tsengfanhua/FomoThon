  "description": {
    "sub_id3": null,
    "sub_name": "總體經濟學(一)",
    "sub_ename": "MACROECONOMICS(1)",
    "describe_ch": "本課程涵蓋的總體經濟問題包括總體所得、就業、利率及通貨膨脹率的決定，貨幣與財政政策的操作原理，及公共債務及國際經濟問題。課程中介詔基本的總體經濟理論與模型，並輔以美國、台灣及世界各國的實例說明。本課程目標在於期使學生認知當代總體經濟理論，並能分析種種總體經濟事件。",
    "describe_eh": "This course will provide an overview of macroeconomic issues: the determination of output, employment, unemployment, interest rates, and inflation.  Monetary and fiscal policies are discussed, as are the public debt and international economic issues. It introduces basic models of macroeconomics and illustrates principles with the experience of the United States ,Taiwan and other economies.  The purpose of the course is to give the students a sound understanding of macroeconomic theory that would enable them to understand and analyze macroeconomic events.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解總體經濟基本概念、邏輯與限制",
      "describe_en": "Comprehension for the basic concepts, logics and constraints of Macroeconomics."
    },
    {
      "seq": 2,
      "describe_ch": "能認知總體經濟問題的錯綜複雜性",
      "describe_en": "Recognize the complexities of Macroeconomic issues."
    },
    {
      "seq": 3,
      "describe_ch": "能應用總體經濟分析的基本模型",
      "describe_en": " Apply the fundamental models of Macroeconomics for a special purpose analysis."
    }
  ],
