  "description": {
    "sub_id3": null,
    "sub_name": "管理學",
    "sub_ename": "MANAGEMENT",
    "describe_ch": "本課程介紹了管理商業組織的基本原則，包括關鍵管理概念、模型和環境。 該課程涵蓋管理職能、戰略框架和負責任的管理。",
    "describe_eh": "This course provides an introduction to the fundamental principles of managing business organisations including key management concepts, models and contexts. The course covers the functions of management, strategic frameworks and responsible management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1 解釋代表管理理論的基本概念、模型和方法；\r\n2 使用基於案例的方法將管理的理論和研究證據應用於實際情況；\r\n3 在組織道德和社會責任的背景下評估管理決策的有效性\r\n4 了解並考慮組織環境對道德和社會責任管理決策的影響。\r\n5 在團隊工作中運用人際交往和溝通技巧",
      "describe_en": "1Explain fundamental concepts, models and approaches that represent the theory of management;\r\n2Apply theory and research evidence of management to practical situations using a case-based approach;\r\n3Evaluate the effectiveness of managerial decisions in the context of organizations ethical and social responsibilities\r\n4Understand and consider the impact of an organisation's context in ethical and socially responsible managerial decisions.\r\n5Employ interpersonal and communication skills when"
    }
