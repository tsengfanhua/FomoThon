  "description": {
    "sub_id3": null,
    "sub_name": "化工熱力學",
    "sub_ename": "CHEMICAL ENGINEERING THERMODYNAMICS",
    "describe_ch": "化工熱力學是從平衡系統觀察得到的實驗數據來做化工程序計算、評估及擴充應用。  本課程的教學目標是詳述熱力學的原理並強調其在化工程序之應用。 為了配合利用電腦做工程計算的趨勢，介紹教材附加的電腦光碟軟體幫助學生學習熱力學原理和應用計算。",
    "describe_eh": "Chemical thermodynamics is an approach to processing, evaluating, and extending experimentally obtained information about chemical systems that are capable of existing in equilibrium states.  The main object of this course is to expose and explain the rationale of thermodynamics. And to meet the increasing emphasis on engineering computing we introduce the software package accompanying CD in the text book to help study the principles and the application calculations.",
    "pre_subname": "CHE3001物理化學(一)、CHE2020質能均衡",
    "pre_sub_id3": "CHE3001",
    "pre_sub_ename": "CHE3001 PHYSICAL CHEMISTRY(1)、CHE2020 MATERIAL AND ENERGY BALANCES",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識熱力學定律的緣起，各定律的基本定義；能夠說明個別定律的要點。",
      "describe_en": "The origin of thermodynamics principles and describe the main  ideas of each law."
    },
    {
      "seq": 2,
      "describe_ch": "能應用質能均衡、化學原理及相關的熱力學定律，分析程序有關的能量需求。",
      "describe_en": " The ability to apply mass and energy balance, chemical principles and related thermodynamics to analyze the energy requirement of the process.."
    },
    {
      "seq": 3,
      "describe_ch": "能以書面或口頭方式與教師、同學及專業人士討論。",
      "describe_en": "Capable in written or oral  to discuss the subject with teacher, friends and experts."
    },
    {
      "seq": 4,
      "describe_ch": "能參與規劃專題討論的能力。",
      "describe_en": "The ability in the joint planning of special topics in thermodynamics assignment."
    }
  ],
