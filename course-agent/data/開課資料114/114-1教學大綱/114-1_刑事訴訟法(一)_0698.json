  "description": {
    "sub_id3": null,
    "sub_name": "刑事訴訟法(一)",
    "sub_ename": " CRIMINAL PROCEDURE LAW(I)",
    "describe_ch": "介紹刑事訴訟法上有關逮捕、搜索、扣押、警察訊問、傳喚訊問、檢察官起訴、審判、上訴與刑之宣判等程序之法律規定與案例。",
    "describe_eh": "This course will cover a wide range of provisions and cases in the criminal procedure law relating to arrest, search and seizure, police interrogation, investigation by subpoena, the prosecutor's decision to charge, the trial, retrials, and sentencing procedure.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉並了解刑事訴訟法基本概念。",
      "describe_en": "Understand the basic structure of criminal procedure law.\n"
    },
    {
      "seq": 2,
      "describe_ch": "熟悉並了解有關逮捕、搜索、扣押、警察訊問、傳喚訊問、檢察官起訴、審判、上訴與刑之宣判等程序之法律規定與案例。",
      "describe_en": "Understand the issue of arrest, search and seizure, police interrogation, investigation by subpoena, the prosecutor's decision to charge, the trial, retrials, and sentencing procedure."
    }
  ],
