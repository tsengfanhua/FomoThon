  "description": {
    "sub_id3": null,
    "sub_name": "顯示科技",
    "sub_ename": "DISPLAY TECHNOLOGY",
    "describe_ch": "顯示技術目的是讓學生了解顯示元件及技術基礎認識。?達此目的，必須對系統影像產生機制、驅動方法、光電特性及色彩產生等有一深入學習，此外本課程結合人眼辨別視覺系統及色彩學等作廣泛討論，最後，本課程以顯示器及光二極體顯示為例作介紹。包括液晶及半導體基礎物理、光學、系統及驅動等。",
    "describe_eh": "Display technology provide an understanding of display components and technical fundamentals. We must have a study of the system image generation mechanism, driving method, photoelectric characteristics and color generation. In addition, this course is widely discussed in conjunction with the human eye to distinguish visual systems and color science. Finally, displays are discussed including liquid crystal and semiconductor basic physics, optics, systems and drives.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的專業詞彙定義液晶光學中許多專有名詞，如顯示器、色品圖、雙折射、液晶顯示器、光度學、輻射度量學……等。\t",
      "describe_en": "Define display technology with their own words: be able to describe display devices, chromaticity; birefringence; liquid crystal displays; photometry; radiometry;……;"
    },
    {
      "seq": 2,
      "describe_ch": "知道於何處可找到LCDs議題的相關資訊、研究結果及標準，並可評估所獲資訊的適用性。\t",
      "describe_en": "Know where to locate and access related LCDs issue information, research, as well as standards, and be able to evaluate the appropriateness of the obtained information."
    },
    {
      "seq": 3,
      "describe_ch": "能利用液晶光學的原理，評估一個LED的光電特性，並提出操作程序。\t",
      "describe_en": "Use principles of optics of LEDs to evaluate ideal optical properties of LEDs systems and propose a feasible method for computational algorithms."
    },
    {
      "seq": 4,
      "describe_ch": "能以書面或口頭方式將所獲結果與同儕、助教及教師溝通。\t",
      "describe_en": "Communicate results in written or oral form to classmates, teaching assistants, and the instructor."
    }
  ],
