  "description": {
    "sub_id3": null,
    "sub_name": "區域經貿專題",
    "sub_ename": "SEMINAR ON REGIONAL TRADE ISSUES",
    "describe_ch": "隨著全球化與自由貿易的趨勢，不同區域已各自形成版塊經濟之運作方式，主要表現在自由貿易協定，並與直接對外投資產生連動，此對於貿易、投資及跨國企業之操作，皆有許多議題值得進一步探討。",
    "describe_eh": "Under the trend of globalization and free trade, many regions are proceeding to join the Free Trade Agreement (FTA). It has been formulating \"block economies\" and effecting on foreign direct investment strategies. There will generate many issues to analyze for the operation of multi-enterprises in the future.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "分析區域經濟整合之影響。",
      "describe_en": "Analysis of regional economic integration."
    },
    {
      "seq": 2,
      "describe_ch": "分析對外直接投資與貿易之關係。",
      "describe_en": "Analysis of interaction between foreign direct investment and trade."
    }
  ],
