  "description": {
    "sub_id3": null,
    "sub_name": "資訊隱私與法律知能",
    "sub_ename": "INFORMATION PRIVACY AND RELATED LAWS KNOWLEDGE",
    "describe_ch": "本課程除了介紹與隱私權保護相關的社會文化運動、法律規範與制度外，也兼及個人資料資訊隱私權的法律保護體制，希望透過社會大眾所關切的詐騙、個資外洩及資訊安全等議題，經由師生共同討論與腦力激盪方式，讓同學們學會如何找出案件的法律爭點，同時也提高同學們的法學視野，以及對於隱私權益與個資受害等社會問題的關注，並養成同學們在人文與科技對話的資訊化社會中，所應具有的網路道德與資訊倫理素養。",
    "describe_eh": "In addition to introducing social and cultural movements, legal norms and systems related to privacy protection, this course also covers the legal protection system of personal data privacy rights. Through the discussion and brainstorming methods of teachers and students, students can learn how to find out the legal issues of the case, and at the same time, they can also improve the legal vision, pay attention to social issues such as privacy rights and personal information victimization, and develop, in the information society with humanities and technology dialogue, the literacy of network morality and information ethics.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能熟悉隱私權相關法律體制並實踐其資訊倫理素養。",
      "describe_en": " To be able to familiar with the relevant legal systems for privacy right laws and develop the ability to practice for the related information ethics."
    },
    {
      "seq": 2,
      "describe_ch": "針對資訊隱私法律議題能有思考判斷能力。",
      "describe_en": "To be able to identify and judge the systems related to privacy laws and practice."
    }
  ],
