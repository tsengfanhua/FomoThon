  "description": {
    "sub_id3": null,
    "sub_name": "多領域設計優化",
    "sub_ename": "MULTIDISCIPLINARY DESIGN OPTIMIZATION",
    "describe_ch": "本課程旨在培養學生在多領域設計優化領域的知識和技能。學生將學習各種優化方法和工具，以解決複雜的多學科設計問題，包括結構、流體力學、熱力學等領域。課程內容涵蓋數學優化方法、多目標優化、約束優化等主題，並通過實際案例和模擬分析來強化學生的實踐能力。透過本課程的學習，學生將能夠在跨學科的設計領域中提出創新解決方案，並在產業和研究領域中具有競爭力。",
    "describe_eh": "This course aims to develop students' knowledge and skills in the field of multidisciplinary design optimization. Students will learn various optimization methods and tools to solve complex multidisciplinary design problems in areas such as structures, fluid mechanics, thermodynamics, and more. The course covers topics such as mathematical optimization methods, multi-objective optimization, constrained optimization, and reinforces practical skills through case studies and simulation analyses. Through this course, students will be able to propose innovative solutions in interdisciplinary design and be competitive in industry and research fields.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生瞭解多領域設計優化的基本概念和原則。",
      "describe_en": "Enable students to understand the fundamental concepts and principles of multidisciplinary design optimization."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生運用數學優化方法解決多學科設計問題的能力。",
      "describe_en": "Develop students' ability to apply mathematical optimization methods to solve multidisciplinary design problems."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生運用多目標優化技術平衡不同設計目標的能力。",
      "describe_en": "Cultivate students' capability to employ multi-objective optimization techniques to balance different design objectives."
    },
    {
      "seq": 4,
      "describe_ch": ".使學生熟悉約束優化方法以解決多領域設計限制條件的挑戰。",
      "describe_en": "Familiarize students with constrained optimization methods to address the challenges of multidisciplinary design constraints."
    },
    {
      "seq": 5,
      "describe_ch": "強化學生在實際案例中應用多領域設計優化方法的能力。",
      "describe_en": "Strengthen students' ability to apply multidisciplinary design optimization methods in practical case studies."
    },
    {
      "seq": 6,
      "describe_ch": "培養學生跨學科合作和團隊工作的能力，並應用於多領域設計優化項目。",
      "describe_en": "Foster students' interdisciplinary collaboration and teamwork skills to be applied in multidisciplinary design optimization projects."
    }
  ],
