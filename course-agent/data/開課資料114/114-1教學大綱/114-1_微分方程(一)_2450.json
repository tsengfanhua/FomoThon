  "description": {
    "sub_id3": null,
    "sub_name": "微分方程(一)",
    "sub_ename": "DIFFERENTIAL EQUATION(1)",
    "describe_ch": "課程目的為熟悉常微分方程式的基本理論及其應用，學習關鍵內容包含一階微分方程、變數分離方程、恰當方程式、二階線性微分方程、高階線性微分方程、拉普拉斯轉換，主要學習活動為課堂講述?作業練習?考試評量以達成學習成效。",
    "describe_eh": "The purpose of the course is to be familiar with the basic theories and applications of ordinary differential equations (ODEs). The key content of learning is first-order ODEs, separation of variables, exact equations, second-order linear ODEs, higher-order linear ODEs and Laplace transform. The main learning activities are class lectures, homework exercises, and examination in order to achieve effective learning.",
    "pre_subname": "CEM1006微積分",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解一階常微分方程的解法",
      "describe_en": "Comprehension for how to  solve the first order differential equations"
    },
    {
      "seq": 2,
      "describe_ch": "理解二階常微分方程的解法",
      "describe_en": "Comprehension for how to  solve the second order differential equations"
    },
    {
      "seq": 3,
      "describe_ch": "理解Laplace轉換",
      "describe_en": "Comprehension for Laplace transform"
    }
  ],
