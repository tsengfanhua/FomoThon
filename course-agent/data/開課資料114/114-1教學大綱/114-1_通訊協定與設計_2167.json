  },
  "description": {
    "sub_id3": null,
    "sub_name": "通訊協定與設計",
    "sub_ename": "DESIGN AND IMPLEMENTATION OF COMMUNICATION PROTOCOLS",
    "describe_ch": "本課程宗旨提供完整地數據/計算機通訊暨其協定的概觀與陳述。本課程著重於該領域中相關技術與架構的基礎觀念和重點要旨。此外，本課程也會對於該領域中某些特定主題進行深入描述及探討，如IPv6暨TCP等技術。",
    "describe_eh": "This course attempts to provide a unified overview of the broad field of data/computer communications as well as protocols. It emphasizes basic principles and the topics of fundamental importance concerning the technology and architecture of this field. Plus, it also provides an in-depth description and discussion of some certain topics of this field, e.g., IPv6, TCP, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "讓學生能具備兼具廣度與深度之通訊網路系統、協定、技術專業素養",
      "describe_en": "Provide students in-depth knowledge and commonly used technologies in data and computer networks."
    },
    {
      "seq": 2,
      "describe_ch": "讓學生能設計、分析通訊網路系統、協定、技術所需之能力",
      "describe_en": "Have students be capable of designing and developing data and computer networks' components, systems, and protocols."
    }
  ],
