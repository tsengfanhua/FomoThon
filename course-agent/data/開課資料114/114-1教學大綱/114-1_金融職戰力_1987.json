  "textBooks": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CF04110",
    "sub_id": "22817",
    "scr_dup": "001",
    "tpb_seq": 1,
    "tpb_book": "<div><strong>模組一：金融職場認識與職涯規劃（探索導向）</strong></div>\n\n<div>\n<div>\n<ul>\n\t<li>\n\t<div>《The Personal MBA》（Josh Kaufman）</div>\n\t</li>\n\t<li>\n\t<div>金管會「金融職涯探索資源」、CFA職涯指南</div>\n\t</li>\n\t<li>\n\t<div>職涯中心測評工具與校內諮詢活動搭配</div>\n\t</li>\n</ul>\n<strong>模組二：職場通用技能與實戰練習（實務導向）</strong></div>\n\n<ul>\n\t<li>\n\t<div>《商業簡報力》（Nancy Duarte）</div>\n\t</li>\n\t<li>\n\t<div>《HBR Guide to Making Every Meeting Matter》</div>\n\t</li>\n\t<li>\n\t<div>線上課程搭配（Coursera：Excel Skills for Business）</div>\n\t</li>\n</ul>\n\n<div><strong>模組三：實作與業界互動（應用導向）</strong></div>\n\n<ul>\n\t<li>\n\t<div>《Case in Point》（Marc Cosentino）</div>\n\t</li>\n\t<li>\n\t<div>模擬工具：StockTrak、CAPSIM、Kaggle金融競賽題目</div>\n\t</li>\n\t<li>\n\t<div>CFA Institute Career Resources &amp; Mock Interview Kits</div>\n\t</li>\n</ul>\n</div>\n",
    "tpb_book_en": " "
  },
