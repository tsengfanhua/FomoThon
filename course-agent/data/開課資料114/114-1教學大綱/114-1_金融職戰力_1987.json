  "description": {
    "sub_id3": null,
    "sub_name": "金融職戰力",
    "sub_ename": "FINANCIAL CAREER COMPETENCY",
    "describe_ch": "本課程旨在培養學生進入金融職場所需的專業技能與實務應用能力，涵蓋金融文書處理、商業簡報製作、職場溝通技巧、專案管理與數據分析，並透過模擬實戰與案例分析，提升學生的職場競爭力。此外，課程將導入企業參訪與業界專家分享，幫助學生了解職場文化與金融產業的最新趨勢，為未來就業與實習奠定基礎。",
    "describe_eh": "The goal of this course is to help students develop the professional skills and real-world application abilities needed to enter the financial workforce. It covers data analysis, project management, workplace communication skills, financial document processing, and corporate presentation design. The course increases students' workplace competitiveness through case studies and simulated real-world events. In order to prepare students for future jobs and internships, the course will also involve corporate visits and meetings with industry experts to help them understand workplace culture and the most recent developments in the financial industry.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過實務練習與模擬，提高學生在金融產業中的溝通與談判技巧",
      "describe_en": "Enhance communication and negotiation skills in the financial industry through practical exercises and simulations."
    },
    {
      "seq": 2,
      "describe_ch": "提升學生對金融產業的職場適應能力，強化職場倫理與專業形象",
      "describe_en": "Strengthen students' adaptability to the financial industry, reinforcing professional ethics and workplace image."
    }
  ],
