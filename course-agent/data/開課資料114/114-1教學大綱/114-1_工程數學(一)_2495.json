  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CS02122",
    "sub_id": "02270",
    "scr_dup": "001",
    "tpa_score_new": "<div>&nbsp;</div>\n\n<div>&nbsp;</div>\n",
    "tpa_score_new_en": null,
    "course_pol": "上課應有寫作紙筆或ipad練習解題\n上課前教室黑板保持乾淨\n學生應準時出席上課\n所有學生在課堂上都應尊重每個人\n上課時請勿講話、閱讀、睡覺或做其他非本課程相關作業\n穿著整潔，不要暴露。",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<div>1. 練習題小組作業彼此分工合作，不抄襲別組作品</div>\n\n<div>2. 提交評分作業時，要確認合作、或協助的程序，故每次作業有主筆人，為主要負責本次作業撰寫者</div>\n\n<div>2. 考試不作弊</div>\n\n<div>3. 不曠課</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": null
  },
