  "description": {
    "sub_id3": null,
    "sub_name": "日文(一)",
    "sub_ename": "JAPANESE(1)",
    "describe_ch": "從日語的五十音教起，配合選定教材，讓同學逐步地認識日語之語音、句型及簡單文法，從而活用於日常會話之中。",
    "describe_eh": "Starting with the 50 phonetic symbols, students will  learn the basic speech sounds, patterns and grammar of Japanese from the textbooks chosen by the instructors and apply what they have learned to their daily life conversation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.基礎文字、句型及簡單問候語、日常生活用語",
      "describe_en": "Basic words, sentences and easy greetings, everyday key words."
    },
    {
      "seq": 2,
      "describe_ch": "2.將基礎日文運用在生活之中",
      "describe_en": "Use basic Japanese in everyday speech."
