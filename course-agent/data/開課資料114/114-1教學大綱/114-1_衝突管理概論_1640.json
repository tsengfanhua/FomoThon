  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE10149",
    "sub_id": "67960",
    "scr_dup": "001",
    "sub_title": "21世紀城鄉發展中的衝突認識與調解。",
    "sub_title_en": null,
    "sub_describe": "21世紀城鄉發展是一種全新的脈動與結構，其內涵與未來的發展趨勢，是被一連串的社會變遷帶來的衝突所結構起來。這種衝突的認識與化解，成為都市發展最重要的任務與挑戰。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "衝突管理概論",
    "sub_ename": "CONFLICT MANAGEMENT",
    "describe_ch": "本課程是從社會心理學的觀點來詮釋衝突及管理的都市計畫行為，其內容包括：(一)社會心理學的理論觀點；(二)都市計畫衝突；(三)都市計畫衝突管理。",
    "describe_eh": "This class focus on three topics of urban conflict issues：(1) The theories of social psychology；(2) Conflict of urban planning；(3) Conflict management of urban planning.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 3,
      "describe_ch": "能認識社會心理學的理論觀點。",
      "describe_en": "Knowledge for the theories of social psychology."
    },
    {
      "seq": 4,
      "describe_ch": "能應用社會心理學的知識去處理都市計畫衝突管理。",
      "describe_en": "Application for the skills of mamagement to urban planning conflict."
    }
  ],
