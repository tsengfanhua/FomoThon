  "description": {
    "sub_id3": null,
    "sub_name": "環境專題(一)",
    "sub_ename": "TOPICS IN ENVIRONMENT(1)",
    "describe_ch": "環境專題(一)為專題導向學習的課程，在授課教師的引領下，各小組學生自行構思或由教師推薦決定環境特定的議題。學生會學習到如何到搜尋文獻以及如何應用所學的知識來分析並解決環境問題。\t\r\n\t\r\n\t\r\n",
    "describe_eh": "Topics in Environment (1) is a project-based study. Students in each team work on environmental-related topics which are proposed by themselves or suggested by the team teacher. Students will learn how to search literature and apply their knowledge for analyzing and solving the environmental problems.\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習如何蒐集以及研讀環境工程與科學相關的學術文獻資料",
      "describe_en": "Learn how to find, read, and understand academic articles."
    },
    {
      "seq": 2,
      "describe_ch": "能夠根據學術文獻進行文獻回顧和研究實驗",
      "describe_en": "Know how to conduct academic literature review research experiments"
    },
    {
      "seq": 3,
      "describe_ch": "能夠正確操作研究所需使用的軟體工具、實驗器材和儀器",
      "describe_en": "Know how to perform the professional software, experimental equipment, and instruments"
    },
    {
      "seq": 4,
      "describe_ch": "暸解現代環境工程的實務問題",
      "describe_en": "Understand the environmental engineering related practical problems and issues"
    },
    {
      "seq": 5,
      "describe_ch": "培養團隊合作與溝通協調之能力",
      "describe_en": "Develop cooperation and communication skills through teamwork"
    },
    {
      "seq": 6,
      "describe_ch": "分析環境問題並構思解決問題方法之能力",
      "describe_en": "Develop environmental problem-solving skills through problem analysis process"
    },
    {
      "seq": 7,
      "describe_ch": "探索現代環境議題並提出可能的解決方案",
      "describe_en": "Explore modern environmental issues and propose possible solutions"
    },
    {
      "seq": 8,
      "describe_ch": "理解學術倫理以及不當研究行為的嚴重性",
      "describe_en": "Understand academic ethics and the seriousness of research misconduct"
    }
  ],
