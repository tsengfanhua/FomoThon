  "description": {
    "sub_id3": null,
    "sub_name": "高等數理統計學(一)",
    "sub_ename": "ADVANCED MATHEMATICAL STATISTICS (1)",
    "describe_ch": "研討統計理論，以建立其他統計課程基礎，使學生在統計之理論上有較深一層之瞭解，使期能更正確的運用統計方法。本課程著重於機率理論的部份。",
    "describe_eh": "To provide a solid and well-balanced introduction to probability theory and mathematical statistics. Topics covered include probability theory, probability spaces, distribution of random variables, distribution function of random variables, discrete probability distribution, continuous probability distribution, and characteristic function.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道機率分佈函數與隨機變數的數學架構。",
      "describe_en": "To know the mathematical framework of the probability distribution and random variable."
    },
    {
      "seq": 2,
      "describe_ch": "理解各種不同的收斂型態。",
      "describe_en": "Comprehension for various modes of convergence of random variables."
    },
    {
      "seq": 3,
      "describe_ch": "應用各類極限定理。",
      "describe_en": "To apply the limit theorems."
    },
    {
      "seq": 4,
      "describe_ch": "綜合統計推論基本觀念及其應用",
      "describe_en": "Synthesis of the basic concept of statistical inference and its application"
    }
  ],
