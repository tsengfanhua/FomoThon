  "description": {
    "sub_id3": null,
    "sub_name": "經濟書報導讀",
    "sub_ename": "INTRODUCTION TO NEWS AND ECONOMIC IDEAS",
    "describe_ch": "本課程成為經濟系大ㄧ定錨課程，主要目的為協助同學接觸各種經濟書報資訊，並認識現階段經濟發展趨勢及熱門課題。透過閱讀相關經濟報刊及雜誌，教師引導同學認識並討論各項經濟議題，培養學生觀察及分析問題能力，以作為將來經濟系其他課程的基礎。",
    "describe_eh": "This course serves as the anchor course in the first year of the college. The instructor will lead students to read and discuss current economic issues from news and magazines with an aim to enhance student’s ability to comprehend and analyze current issues.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能有效蒐集及閱讀相關經濟書報",
      "describe_en": "Able to efficiently collect information and read news/magazines"
    },
    {
      "seq": 2,
      "describe_ch": "能清楚表達並陳述觀點",
      "describe_en": "Able to clearly express and state options"
    },
    {
      "seq": 3,
      "describe_ch": "具備觀察時事與分析時事的能力",
      "describe_en": "Able to observe and analyze current issues"
    }
  ],
