  "description": {
    "sub_id3": null,
    "sub_name": "科技與研發管理",
    "sub_ename": "TECHNOLOGY AND RESEARCH & DEVELOPMENT MANAGEMENT",
    "describe_ch": "本課程是整合科技創新、研發流程和智慧財產權管理等知識領域，讓學生掌握企業如何運用科技資源以創新商務模式及強化研發管理績效與競爭力。課程兼重理論及實務應用，使學生能由所學應用於理論探討與企業問題的解決。",
    "describe_eh": "This course integrates cross-disciplinary components from technology innovation, research and development process and intellectual property rights management, which aims to educate students how to apply business technology resources on strengthening managerial performance and competitive advantages. This course emphasizes both theoretical background and practical application in which students will obtain experience by solving business problems involving real world cases based on theoretical direction.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
