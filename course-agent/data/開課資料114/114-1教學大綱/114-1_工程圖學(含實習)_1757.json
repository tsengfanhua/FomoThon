  "description": {
    "sub_id3": null,
    "sub_name": "工程圖學(含實習)",
    "sub_ename": "ENGINEERING GRAPHICS AND PRACTICE",
    "describe_ch": "訓練學生識圖和電腦製圖之基本能力，訓練學生識圖?電腦製圖的熟練度，並培養其對空間的豐富思考力與觀察力，使與自動化設計等課程相互結合﹐而應用到實際的工程設計上。進一步培養學生具有AUTOLISP程式設計之基本能力，廣泛涉獵相關之電腦圖學知識，如統計圖、流程圖等，並使其能靈活使用電腦製圖工具如Flash、VISIO、PHOTOSHOP，可與自控系其他專業課程相互結合﹐而應用到實際的工程設計上，以奠定成為一位優良工程師的基礎，俾對實際繪圖自動化有所助益。",
    "describe_eh": "This course creates a solid learning foundation for engineering graphics; there will not be sufficient in-depth material for students to design the advanced automatic control equipment or material. The course also features problems as the course progresses and will offer solutions. Students can use computer-aided drafting techniques with Autocad software and sketching to generate two and three dimensional drawings based on the conventions of engineering graphical. We also introduce the need for analysis, working drawings, and consideration of drawing methods with Flash,Visio, Photoshop software.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解工程圖的基本理論與繪製技術。",
      "describe_en": "Comprehension for the basic concepts of engineering drawing and graphic technology."
    },
    {
      "seq": 2,
      "describe_ch": "具備使用AutoCAD電腦輔助繪圖軟體的能力。",
      "describe_en": "Possess the ability to use AutoCAD."
    },
    {
      "seq": 3,
      "describe_ch": "能運用電腦繪圖功能輔助工程分析、設計與測試。",
      "describe_en": " Can use the function of computer graphic to aided engineering analysis, design and testing."
    },
    {
      "seq": 4,
      "describe_ch": "經由實習訓練使學生具備將設計構想轉化實際圖面並符合標準規範之工程語言能力。",
      "describe_en": "Through practical training enable students with the design ideas into actual drawing and comply with standards of engineering language skills."
    }
  ],
