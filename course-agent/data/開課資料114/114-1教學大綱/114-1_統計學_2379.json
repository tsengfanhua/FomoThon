  "description": {
    "sub_id3": null,
    "sub_name": "統計學",
    "sub_ename": "STATISTICS",
    "describe_ch": "本課程為計量分析之基礎課程，介紹敘述性統計應用、基本機率理論、與隨機變數的機率分配、點估計與區間估計、假設檢定等推論性統計分析。讓同學可以順利銜接後續計量分析課程。",
    "describe_eh": "This is the introductory course of the quantitative analysis. This main purpose of this course are to teach students how to apply the description statistic realize the probability theory and the referential statistic, including the probability distribution of random variables, point and interval estimate, and hypothesis test. Based on the course, the students can successful to connect with the following course of quantitative analysis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用基礎敘述性統計進行相關土地管理資料描述與說明。",
      "describe_en": "Be able to apply description statistics to describe relevant to land management database."
    },
    {
      "seq": 2,
      "describe_ch": "能理解機率理論與統計推論的概念，並應用到土地管理相關資料處理與分析。",
      "describe_en": "Be able to realize probability theory and the referential statistic, and apply them to analyze relevant to land management database.\tA2"
    },
    {
      "seq": 3,
      "describe_ch": "能應用相關統計軟體進行統計資料描述、處理與分析。",
      "describe_en": "Be able to apply statistic software to describe and analyze data."
    }
  ],
