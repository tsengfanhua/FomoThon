  "description": {
    "sub_id3": null,
    "sub_name": "矽光子元件設計",
    "sub_ename": "DESIGN OF ELEMENTS IN SILICON PHOTONICS",
    "describe_ch": "本課程將介紹矽光子之光學元件及半導體元件的工作原理，並利用多物理量有限元素分析軟體進行矽光子元件的設計與模擬。",
    "describe_eh": "This course provides an in-depth introduction to the operating principles of optical and semiconductor devices in silicon photonics and employs multiphysics finite element analysis software for the design and simulation of silicon photonic components.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用光學原理設計元件。",
      "describe_en": "To apply optical principles in element design."
    },
    {
      "seq": 2,
      "describe_ch": "以軟體模擬進行光學元件與半導體元件的分析。",
      "describe_en": "To analyze optical elements and semiconductor elements by using software simulation."
    },
    {
      "seq": 3,
      "describe_ch": "分析國際期刊上最新的光學元件設計趨勢。",
      "describe_en": "To analyze the latest trends in optical element design as reported in leading international journals."
    }
  ],
