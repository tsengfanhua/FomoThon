  "description": {
    "sub_id3": null,
    "sub_name": "精算定價模型(一)",
    "sub_ename": "THE ACTUARIAL PRICING MODELS (I)",
    "describe_ch": "介紹財務數學基本理論，為上下兩學期課程。課程內容含括:貨幣時間價值、息力、基本年金、連續年金、算數序列型支付年金、幾何序列行支付年金、股票評價、貸款攤提、債券評價等。理論搭配教材範例練習，以加深對理論與相關議題的瞭解。",
    "describe_eh": "This course provides an introduction of financial mathematics. The topics include time value of money, forces of interest, basic annuities, continuous annuities, annuities with payments in arithmetic progression, annuities with payments in geometric progression, stock pricing, loan amortization, and bond pricing. More examples will be illustrated to help students understand the theories and issues of financial mathematics.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
