  "description": {
    "sub_id3": null,
    "sub_name": "保險學",
    "sub_ename": "INSURANCE",
    "describe_ch": "本課程講授風險與保險學的基本理論與實務運用。首先介紹風險性質、傳統風險管理與整合型風險管理之發展；再介紹保險制度的基本運作原則及保險監理，最後個別介紹人身保險與非人身保險概論及其個案例證",
    "describe_eh": "Risk and Insurance theory as well as practical are introduced in this course. In the first section including: risk, integrated risk management and its development. In the 2nd section including insurance contract, basic principles and government regulation. Lastly, Life insurane and Non-life insurance are Introduced respectively and comprehensive cases are also illustrated.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解風險管理與保險、金融、管理、經濟與法律等專業知識",
      "describe_en": " Comprehending risk management and insurance, finance, management, economic and law expertise"
    },
    {
      "seq": 2,
      "describe_ch": "應用保險學專業知識解決企業與家庭風險管理與保險的問題 \r\n \r\n",
      "describe_en": "Application professional knowledge to solve the problems related to the risk management and insurance in enterprise and household B3 \r\n \r\n"
    }
  ],
