  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CH00101",
    "sub_id": "00241",
    "scr_dup": "003",
    "sub_title": "「人本AI設計思維」融合 Design Thinking + CDIO 方法，以引導學生構思（Conceive）、設計（Design）、實施（Implement）與運作（Operate），培養跨領域專業與人本AI應用實作能力。",
    "sub_title_en": null,
    "sub_describe": "1. 人本與永續、AI的社會影響力：探討人工智慧如何透過人本設計提升社會福祉與永續發展。CDIO對應：定義社會需求與問題（Conceive）、構思以人為本的AI應用（Design）。\n2. 人本AI的學習與推理、預訓練與深度學習：分析 AI 如何學習人類經驗、做出決策，並思考其潛在偏見與挑戰。CDIO對應：辨識 AI 模型的學習特徵與侷限（Conceive）、實作簡單的 AI 訓練與應用測試（Implement）。\n3. 解決問題專題導向、用戶體驗與測試、人機互動最佳化：透過使用者測試，評估 AI 產品的可用性，確保技術符合人本需求。CDIO 對應：測試並迭代改進設計方案（Operate）。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "人本AI設計思維",
    "sub_ename": "HUMAN-CENTERED AI DESIGN THINKING",
    "describe_ch": "設計思維（Design Thinking）是一種用於解決問題和創新的方法論，從使用者的角度出發，通過同理心理需求，從而創造出有益的解決方案。本課結合人本中心設計思維（Human-Centered Design Thinking）和人工智慧等新興科技的運用，案例分析，學習如何實踐人本AI設計（Human-Centered AI Design Thinking），提出能夠解決社會問題，以人為本的AI設計新提案。",
    "describe_eh": "Design Thinking emphasizes empathy to solve problems. This course merges Human-Centered Design with AI technologies, and case study, aiming to address societal challenges. Students learn to apply Human-Centered AI Design Thinking, crafting solutions prioritizing human needs. The goal is innovative, socially responsible human-centric AI designs.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養人文與科技之跨域融合的STEAM能力",
      "describe_en": "Cultivating the STEAM capabilities of interdisciplinary integration between humanities and technology."
    },
    {
      "seq": 2,
      "describe_ch": "能產生具有社會影響力之以人為本的AI創新應用方案",
      "describe_en": "Able to generate human-centered AI innovation application schemes with social impact."
    }
  ],
