  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE13132",
    "sub_id": "66302",
    "scr_dup": "001",
    "tpa_score_new": "<div>1. 學期成績計算項目及權重標準如下： \u000b A. 點名&nbsp;30% \u000b B. 期中專題報告&nbsp;30% \u000b C. 期末專題報告&nbsp;(40%) &nbsp;&nbsp;點名確認出席至少四次&nbsp;&nbsp;</div>\n",
    "tpa_score_new_en": null,
    "course_pol": "1. 上課時請將手機關機或調為靜音。\n2. 上課時請勿聊天干擾上課。\n3. 上課時針對教學內容不清楚處，請主動發問。",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<ul>\n\t<li>期中/期末專題報告抄襲作弊，該次成績以零分計算，並依逢甲大學學生獎懲辦法提報學校進行懲處。</li>\n\t<li>期末專題報告若有引用他人著作資料，請務必於報告中清楚標示引用資料來源。</li>\n</ul>\n\n<div>&nbsp;</div>\n\n<div>\n<hr />教育部學術倫理電子報 (第5期 2021年8月號)</div>\n\n<div>專欄短文 : <a href=\"https://ethics.moe.edu.tw/resource/epaper/redirect/?pid=58\">在高等教育課堂中實踐學術誠信（學生篇)</a></div>\n\n<div>請閱讀完此篇專欄短文 ，了解何謂學術誠信及其核心基本價值。</div>\n\n<div>https://ethics.moe.edu.tw/files/resource/epaper/epaper_moe_202108.pdf&nbsp;</div>\n\n<div>&nbsp;</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": null
  },
