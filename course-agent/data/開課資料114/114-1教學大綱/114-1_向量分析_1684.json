  "description": {
    "sub_id3": null,
    "sub_name": "向量分析",
    "sub_ename": "VECTOR ANALYSIS",
    "describe_ch": "本課程的主旨在於提供大學部學生了解向量場的幾何意義與物理觀念，對於主修物理與工程的學生，此課程是提供向量理論知識的基礎課程。課程內容包括向量代數、曲線與曲面參數方程式、純量與向量場、向量分析之積分概念與理論。",
    "describe_eh": "The objective of this course is to provide undergraduate students an understanding of geometry and some physical concepts of vector fields. It is primarily a fundamental course for students who major in physics and engineering. The topics include vector algebra, parametric equations of curves and surfaces, scalar and vector fields, integral concepts and theorems of vector analysis.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、IEE1005線性代數",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、IEE1005 LINEAR ALGEBRA",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備基礎工程數學的理論推導以及問題解決之知識能力。",
      "describe_en": "Possess the knowledge of theory derivation and problem solving in fundamental engineering mathematics."
    },
    {
      "seq": 2,
      "describe_ch": "理解基本定理以及熟悉其應用。",
      "describe_en": "Comprehend fundamental principles and be familiar with their applications."
    }
  ],
