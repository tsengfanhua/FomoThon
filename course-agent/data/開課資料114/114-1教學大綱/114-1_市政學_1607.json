    {
      "seq": 1,
      "describe_ch": "行政組織運作和行政理論之探究。",
      "describe_en": "Explores the theory of administration, the concept of organization"
    },
    {
      "seq": 2,
      "describe_ch": "統御領導、協調溝通理念和方法之瞭解。",
      "describe_en": "Understands the concept of methods of directing and coordinating."
    }
