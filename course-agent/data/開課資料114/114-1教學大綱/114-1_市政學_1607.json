    "sub_name": "市政學",
    "sub_ename": "URBAN ADMINISTRATION",
    "describe_ch": "本課程是研究公務推行之政府運作與管理的學問，研究主題包含POSDCORB等七大內容，即P（計畫）、O（組織）、S（人事）、D（領導）、CO（協調）、R（報告）和B（預算）。",
    "describe_eh": "This is a course that interest in the static and dynamic of public administration, it is involving POSDCORB.\r\nP：Planning              O：Organizing\r\nS：Staffing               D：Directing\r\nCO：Coordinating         R：Reporting\r\nB：Budgeting\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
