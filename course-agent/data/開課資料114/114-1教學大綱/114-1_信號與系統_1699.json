  "description": {
    "sub_id3": null,
    "sub_name": "信號與系統",
    "sub_ename": "SIGNALS AND SYSTEMS",
    "describe_ch": "本課程旨在介紹數位的信號與系統基本概念與實作。 解釋如何以正弦函數及頻譜表示時域的訊號，連續訊號如何取樣, 並介紹數位訊號處理中會使用的Z轉換數學工具。",
    "describe_eh": "Introduction to basic concept and practice of signals and systems engineering in discrete time. We will explain how to represent a time-domain signal with sinusoids and spectrum, how to sample continuous signals, and introduce the Z-transform mathematical tool which will be used in digital signal processing.",
    "pre_subname": "IEE1005線性代數、EEEN2000工程數學(一)",
    "pre_sub_id3": "IEE1005",
    "pre_sub_ename": "IEE1005 LINEAR ALGEBRA、EEEN2000 ENGINEERING MATHEMATICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 3,
      "describe_ch": "教導學生理解離散信號與系統的基本概念。\t",
      "describe_en": "Instruct students with the basic concept and practice of discrete-time signals and systems."
    },
    {
      "seq": 4,
      "describe_ch": "教導學生頻譜分析與Z-轉換的基本概念。\t",
      "describe_en": "Teach students the basic concept and continuous and discrete-time signals."
    }
  ],
