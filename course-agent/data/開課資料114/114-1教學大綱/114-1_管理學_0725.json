    "tpb_book": null,
    "tpb_book_en": "<div>\n<div>Work Psychology: Understanding Human Behaviour In The Workplace,&nbsp;7th edition</div>\n\n<div>Published by Pearson&nbsp;(February 20, 2020)&nbsp;&copy; 2020</div>\n\n<div>John Arnold; Iain Coyne; Ray Randall; Fiona Patterson.&nbsp;</div>\n\n<div>&nbsp;</div>\n\n<div><strong>Other texts (in Feng Chia University Library):&nbsp;</strong></div>\n</div>\n\n<div>&nbsp;</div>\n\n<table cellpadding=\"0\" cellspacing=\"3\" style=\"width:100%\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top\">Title</td>\n\t\t\t<td><strong>Business psychology and organisational behaviour : a student&#39;s handbook / Eugene McKenna.</strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top\">Author</td>\n\t\t\t<td><a href=\"https://innopac.lib.fcu.edu.tw/search~S9*eng?/aMcKenna%2C+Eugene+F./amckenna+eugene+f/-3,-1,0,B/browse\">McKenna, Eugene F.</a></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top\">Imprint</td>\n\t\t\t<td>East Sussex, England : Psychology Press, 2000.</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top\">Edition</td>\n\t\t\t<td>3rd ed.</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div><strong>Feng Chia Library: </strong>158.7 M155 2000 ;&nbsp;Course Reference Books(3F).&nbsp;&nbsp;</div>\n\n<div>&nbsp;</div>\n\n<div>\n<table cellpadding=\"0\" cellspacing=\"3\" style=\"width:100%\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top\">Title</td>\n\t\t\t<td><strong>Business psychology in practice / edited by Pauline Grant ; assisted by Sarah Lewis and David Thompson.</strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top\">Imprint</td>\n\t\t\t<td>London, England ; Philadelphia, PA : Whurr Publishers, 2005.</td>\n\t\t</tr>\n\t</tbody>\n</table>\n</div>\n\n<div>&nbsp;<strong>Feng Chia Library: </strong>158.7 B979;&nbsp;Western Collection(2F).</div>\n\n<div>&nbsp;</div>\n\n<div>\n<div>\n<table border=\"0\" cellspacing=\"1\" style=\"width:100%\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td>\n\t\t\t<table cellpadding=\"0\" cellspacing=\"3\" style=\"width:100%\">\n\t\t\t\t<tbody>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"vertical-align:top\">Title</td>\n\t\t\t\t\t\t<td><strong>Organizational behavior / Stephen P. Robbins, Timothy A. Judge.</strong></td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"vertical-align:top\">Author</td>\n\t\t\t\t\t\t<td><a href=\"https://innopac.lib.fcu.edu.tw/search~S9*eng?/aRobbins%2C+Stephen+P./arobbins+stephen+p/-3,-1,0,B/browse\">Robbins, Stephen P.</a></td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"vertical-align:top\">Imprint</td>\n\t\t\t\t\t\t<td>Essex, England ; Boston : Pearson, c2013.</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td style=\"vertical-align:top\">Edition</td>\n\t\t\t\t\t\t<td>15th ed., global ed.</td>\n\t\t\t\t\t</tr>\n\t\t\t\t</tbody>\n\t\t\t</table>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n</div>\n\n<div>&nbsp;<strong>Feng Chia Library:&nbsp;</strong>Course Reference Books(3F)&nbsp;/&nbsp;Call No.: 658.3 R636 2013.</div>\n\n<div>&nbsp;</div>\n\n<div>\n<table cellpadding=\"0\" cellspacing=\"3\" style=\"width:100%\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top\">Title</td>\n\t\t\t<td><strong>Organizational behavior : managing people and organizations / Ricky W. Griffin, Gregory Moorhead.</strong></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top\">Author</td>\n\t\t\t<td><a href=\"https://innopac.lib.fcu.edu.tw/search~S9*eng?/aGriffin%2C+Ricky+W./agriffin+ricky+w/-3,-1,0,B/browse\">Griffin, Ricky W.</a></td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top\">Imprint</td>\n\t\t\t<td>Mason, OH : South-Western/Cengage Learning, c2012.</td>\n\t\t</tr>\n\t\t<tr>\n\t\t\t<td style=\"vertical-align:top\">Edition</td>\n\t\t\t<td>10th ed.</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<div><strong>Feng Chia Library:&nbsp;</strong>Western Collection(2F)&nbsp;/&nbsp;Call No.: 658.3 G852 2012.</div>\n</div>\n</div>\n"
