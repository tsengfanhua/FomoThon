  "description": {
    "sub_id3": null,
    "sub_name": "國際交流體驗",
    "sub_ename": "INTERNATIONAL EXCHANGE EXPERIENCE",
    "describe_ch": "藉由國際交流提供學生接軌世界的機會，共有提升國際視野，建立交流網路，親身體驗國際交流，分享擴大效果四面向，擬定蘊涵國際視野，建置接軌的途徑，達成國際交流目標。",
    "describe_eh": "International exchanges provide students with opportunities to connect with the world, enhance their international perspectives, establish communication networks, experience international exchanges first-hand, share the four aspects of expanding effects, draw up international perspectives, establish ways to connect, and achieve international exchange goals.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
