  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE07139",
    "sub_id": "59472",
    "scr_dup": "002",
    "sub_title": "培養學生以實務導向學習資料科學，從資料蒐集、清理、探索性分析 (EDA)、統計檢定到機器學習模型的建立與評估，體驗資料科學基礎流程。",
    "sub_title_en": null,
    "sub_describe": "課程內容結合理論講授與實作練習，學生將透過 Python 與相關工具進行資料處理、視覺化與分析，並以真實資料集進行專題實作，訓練團隊合作、問題解決與報告能力。課程適合想要進入資料科學領域、提升資料分析與應用能力的同學。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "資料科學實務",
    "sub_ename": "DATA SCIENCE PRACTICES",
    "describe_ch": "本課程主要目的是教導學生開發社群媒體Bot的知識與能力。本課程將介紹現有社群媒體Bot的狀況並進行分析、指導學生進行社群媒體Bot的創意發想，並進行實作、上架與維運。在完成此一課程後，學生將能夠獨立開發社群媒體Bot，並了解Bot的維運方式。",
    "describe_eh": "The purpose of this course is to let students understand the development of social media BOTs. The instructor will introduce some of existing social media BOTs to the students and help them design, implement, deploy and operate new BOTs. Upon completion of this course, students will be able to develop, maintain and operate their own social media BOTs.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉並能運用一項資料科學工具",
      "describe_en": "Familiar with and able to use a data science tool"
    },
    {
      "seq": 2,
      "describe_ch": "理解並能活用各種資料科學相關理論與技術",
      "describe_en": "Understand and be able to utilize various theories and techniques related to data science"
    },
    {
      "seq": 3,
      "describe_ch": "運用資料科學技術解決實際問題",
      "describe_en": "Use data science related techniques to solve practical problems"
    }
  ],
