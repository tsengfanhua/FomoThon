  "description": {
    "sub_id3": null,
    "sub_name": "財產保險(一)",
    "sub_ename": "PROPERTY & LIABILITY INSURANCE(1)",
    "describe_ch": "介紹財產保險之內容範圍及性質,分析其基本原則與經營實務,並進而對各險種契約內容作分析探討,包括火災保險.海上保險.汽車保險.責任保險.保證保險及其他財產保險等,俾使學生了解其原理與原則,以便為將來就業或參加證照及國家考試做好充分之準備,增強實力與信心.",
    "describe_eh": "To introduce the contents and characteristics of Property Insurance, and to analyze the fundamental principles and operation practices. Furthermore, to discuss the various kinds of Property Insurance contracts including fire insurance, marine and inland marine insurance, automobile insurance, liability insurance, bonding insurance and others. Students can understand its principles and practices; therefore, they can prepare for getting a job and attending licensing or national examination.",
    "pre_subname": "INSU1001保險學",
    "pre_sub_id3": "INSU1001",
    "pre_sub_ename": "INSU1001 INSURANCE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能獲悉危險與保險之關係,正確定義保險之意義,原理,進而能描述其功能與重要性,而成為危險管理之最佳運用工具.",
      "describe_en": "To know the Insurance and to understand the relationship between Risk and Insurance. Furthermore, to explain its function and importance in Risk Management."
    },
    {
      "seq": 2,
      "describe_ch": "能理解財產保險在保險分類中之地位,並說明其分類與範圍,以及其市場概況.",
      "describe_en": "Comprehension for the position of Property Insurance in insurance classification, and to explain its kinds, scope and status in insurance market."
    }
  ],
