  "description": {
    "sub_id3": null,
    "sub_name": "都市計畫",
    "sub_ename": "URBAN PLANNING",
    "describe_ch": "介紹分析都市計畫的功能、內涵、體制及其對人與都市環境互動課題的預防與合理管理，以提供兼生活、生產、生態，三生一體的都市環境。",
    "describe_eh": "An introduction to the analysis of urban planning functions, contents, systems, and the prevention and rational management of issues related to human interaction with urban environment, aiming to provide a holistic urban environment that integrates living, production, and ecology.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解並辨識出台灣國土及都市資源現況與重要發展課題。",
      "describe_en": "Understand and identify the current status of Taiwan's national land and urban resources, as well as important development issues."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解並運用國土及都市資源調查的方法與工具。",
      "describe_en": "Understand and apply methods and tools for investigating national land and urban resources."
    },
    {
      "seq": 3,
      "describe_ch": "從多方角度分析人與國土及都市環境資源間的互動關係。",
      "describe_en": "Analyze the interaction between humans and national land and urban environmental resources from various perspectives."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解規劃的理念、流程、方法。",
      "describe_en": "Understand the concepts, processes, and methods of planning."
    }
  ],
