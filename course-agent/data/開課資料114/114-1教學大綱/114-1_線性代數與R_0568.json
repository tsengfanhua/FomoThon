  "description": {
    "sub_id3": null,
    "sub_name": "線性代數與R",
    "sub_ename": "LINEAR ALGEBAR IN R",
    "describe_ch": "線性代數與R介紹線性方程組與矩陣間的關係。以線性向量空間為主軸，學習使用矩陣來表示空間轉換時所呈現之結構。本課程結合統計軟體R並透過電腦實驗來驗證向量空間之相關理論，增進學生分析與解決數理問題能力。",
    "describe_eh": "Linear Algebra in R studies relationship between a system of linear equations and matrices. Students will learn how to use matrix to represent the structure of the transformation between two linear vector spaces. This course combines statistical software R with computer experiment to validate the relevant theories in linear vector space. The goal is to improve students’ ability in the data analytic courses.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解線性方程組與矩陣相關運算的概念及其應用",
      "describe_en": "Comprehension for  the concepts and applications of  the  linear equations and matrix."
    },
    {
      "seq": 2,
      "describe_ch": "理解向量空間與線性變換",
      "describe_en": "Comprehension for  the vector space and linear transformations."
    },
    {
      "seq": 3,
      "describe_ch": "使用R軟體驗證相關理論",
      "describe_en": "Use R to validate the theory in linear algebra"
    }
  ],
