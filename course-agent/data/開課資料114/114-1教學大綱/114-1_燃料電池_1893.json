  "description": {
    "sub_id3": null,
    "sub_name": "燃料電池",
    "sub_ename": "FUEL CELLS: THEORY AND PRACTICE",
    "describe_ch": "燃料電池為高效率之發電系統，可將氫氣等優質能量載體轉換為電力，因此燃料電池將有助於解決能源短缺及環境污染等重大議題。本課程主要探討燃料電池之科學基礎與應用實務，內容包含：理論基礎、材料工程、性能鑑定、分類、與系統等章節。",
    "describe_eh": "Hydrogen is an excellent energy carrier. Through electrochemical processes in fuel cells, hydrogen can be converted into electricity with a very higher efficiency. Fuel cell development thus could help to resolve the deficient supply of traditional energy. Contents of this course are related to science and technology of fuel cells, including theory, materials, characterization, classification and system, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解燃料電池之原理，包含:熱力學、動力學、觸媒原理、系統、及次系統…等。",
      "describe_en": "Knowledge of the theory of fuel cell, including thermodynamics, kinetics、catalysts, system, and subsystem., etc."
    },
    {
      "seq": 2,
      "describe_ch": "區別不同類型之燃料電池，以及其工作原理。瞭解質子傳導膜燃料電池之電催化劑、電極、質子交換膜、電極膜組之組裝、以及其數學模型。",
      "describe_en": "To distinguish various types of fuel cell, and their working principles. To understand the electrocatalyst, electrodes, photon exchange membrane, MEA, and modeling of PEMFC."
    },
    {
      "seq": 3,
      "describe_ch": "應用燃料電池性能之鑑定與分析技術。",
      "describe_en": "To apply the characterization and analytic methods for fuel cell."
    }
  ],
