    {
      "seq": 1,
      "describe_ch": "了解人工智慧在不同產業應用",
      "describe_en": "Understand the application of artificial intelligence in different industries."
    },
    {
      "seq": 2,
      "describe_ch": "培養自我學習與團隊合作能力",
      "describe_en": "Training self-learning and teamwork skills."
    },
    {
      "seq": 3,
      "describe_ch": "培養對工程技術資料整理報告文件能力",
      "describe_en": "Training the ability to report engineering technical information."
    }
