  "description": {
    "sub_id3": null,
    "sub_name": "經典戲劇閱讀與社會劇場實踐",
    "sub_ename": "READING CLASSIC DRAMA AND PRACTICING SOCIAL THEATRE",
    "describe_ch": "本課程以現代與當代經典劇本為核心，結合社會劇場方法，帶領學生理解戲劇文本中所反映社會改革的意涵，並培養學生的批判思維、集體創作，公共表達能力與社會參與意識。分為三大模組：文本閱讀與分析、社會議題導入、劇場實踐與創作，經由轉化文本閱讀為行動與對話的可能。劇本聚焦與大學生切身議題:夢想與現實的壓力、人性多樣性、資本主義與消費市場連動、和全球戰爭等。",
    "describe_eh": "This course centers on modern and contemporary classic plays, integrating methods from social theatre to guide students in understanding how dramatic texts reflect and call for social change. It aims to cultivate students' critical thinking, expressive abilities, and awareness of social engagement. The course is divided into three main modules: text reading and analysis, introduction to social issues, and theatrical practice and creation—transforming textual interpretation into opportunities for action and dialogue. Also will focus on several pressing social issues relevant to university students, including the tension between dreams and reality, the complexity of human nature, the relationship between capitalism and consumer culture, and global warfare.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解現代戲劇中反映的社會議題與歷史脈絡。",
      "describe_en": "Understand the social issues and historical contexts reflected in modern drama."
    },
    {
      "seq": 2,
      "describe_ch": "練習將文本轉化為行動與表演，並與當代社會議題連結，培養批判性閱讀與文本詮釋能力",
      "describe_en": "Practice transforming texts into action and performance, connecting them to contemporary social issues. Develop critical reading skills and the ability to interpret dramatic texts."
    },
    {
      "seq": 3,
      "describe_ch": "實作社會劇場創作，探索劇場作為公共對話與社會介入的可能性",
      "describe_en": "Engage in social theatre creation to explore the potential of theatre as a medium for public dialogue and social intervention."
    }
  ],
