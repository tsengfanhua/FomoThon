  "description": {
    "sub_id3": null,
    "sub_name": "資料探勘導論",
    "sub_ename": "INTRODUCTION TO DATA MINING",
    "describe_ch": "介紹資料探勘的基本概念、方法與技術，以及如何建構和運用工具來進行資料探勘的應用。包含資料前處理的技術與工具應用。",
    "describe_eh": "An introduction to data mining. The topics include basic concepts, methhods, and techniques. The construction and the applications of data mining will be described. Techniques and tools for data processing are to be covered.",
    "pre_subname": "IECS3022資料庫系統",
    "pre_sub_id3": "IECS3022",
    "pre_sub_ename": "IECS3022 DATABASE SYSTEMS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
