  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "PC44100",
    "sub_id": "01761",
    "scr_dup": "001",
    "sub_title": "我國職業安全衛生法規之介紹",
    "sub_title_en": null,
    "sub_describe": "讓學生了解職安衛體系相關法令, 具備報考職業安全衛生管理員乙級技術士的知識學能",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "工業安全衛生法規",
    "sub_ename": "LABOR SAFETY AND HEALTH ACT",
    "describe_ch": "研習有關勞工安全衛生法、高壓氣體勞工安全規則、鍋爐及壓力容器安全規則、起重升降機具安全規則、危險物及有害物通識規則、營造安全衛生設施標準等工業安全衛生法規。",
    "describe_eh": "Study about  Labor Safety and Health Act, Regulations for high pressure gas labor safety, Regulations for boiler and pressure container safety , Regulations for derrick and elevator safety , Literacy regulations for hazard and hazardous materials , Standard for construction safety and health installations etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解並說明工業安全衛生法規在社會及經濟層面的重要性及影響",
      "describe_en": "Understand and be able to explain the importance and effects of Labor Safety and Health Act to society and economy."
    },
    {
      "seq": 2,
      "describe_ch": "知道於何處可找到工業安全衛生法規的相關資訊、研究結果及標準，並可評估所獲資訊的適用性",
      "describe_en": "Know where to locate and access related Labor Safety and Health Act information, research, as well as standards, and be able to evaluate the appropriateness of the obtained information."
    },
    {
      "seq": 3,
      "describe_ch": "能針對一特定有關工業安全衛生法規的議題或情境，設計一合理實驗，加以驗證，並適切歸納出結論",
      "describe_en": "Design a reasonable experiment for a specific Labor Safety and Health Act issue or scenario, conduct the experiment, and draw appropriate conclusions."
    },
    {
      "seq": 4,
      "describe_ch": "能以書面或口頭方式將所獲結果與同儕、助教及教師溝通",
      "describe_en": "Communicate results in written or oral form to classmates, teaching assistants, and the instructor."
    },
    {
      "seq": 5,
      "describe_ch": "能透過小組展現團隊合作能力",
      "describe_en": "Demonstrate esprit de corps (team spirit) through teamwork."
    }
  ],
