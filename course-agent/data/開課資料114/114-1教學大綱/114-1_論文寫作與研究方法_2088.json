  "description": {
    "sub_id3": null,
    "sub_name": "論文寫作與研究方法",
    "sub_ename": "PROPOSAL WRITING AND RESEARCH DESIGN",
    "describe_ch": "本課程讓學生認識論文寫作程序與概念。方法上能理解質性與量化研究取向，透過個案的練習，使其可以了解論文實際操作方式。經由研究方法的認識，再導引學生透過已有研究文獻的閱讀與討論，開始進行自己論文的緣起、動機與目的及問題的撰寫。",
    "describe_eh": "This course introduces students to the procedures and concepts of essay writing. Methodologically, students can understand qualitative and quantitative research orientations, and through the practice of individual cases, they can understand the practical operation of the thesis. And then, to lead students learn how to search and process data in order to finalize their some parts of thesis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生理解並應用質化與量化研究方法",
      "describe_en": "To learn the  qualitative and quantitative methods for social science"
    },
    {
      "seq": 2,
      "describe_ch": "使學生理解資料整理方式並可以完成碩士論文的一部分",
      "describe_en": "To learn how to process research data and can finalize some parts of thesis"
    }
  ],
