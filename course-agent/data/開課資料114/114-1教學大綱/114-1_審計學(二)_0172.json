  "description": {
    "sub_id3": null,
    "sub_name": "審計學(二)",
    "sub_ename": "AUDITING(2)",
    "describe_ch": "本課程主要在探討審計理論與觀念包括審計方法與實務。除此之外，強調在財務報表查核簽證過程中會計正直性、客觀性與超然獨立之專業責任。",
    "describe_eh": "This course is designed primary for modern auditing theory and concepts with methodology and practice. In addition, emphasis is given to professional responsibilities of auditors in upholding the integrity, objective and independence of the financial reporting process.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解審計程序與審計目標。",
      "describe_en": "Understand the auditing process and audit objectives"
    },
    {
      "seq": 2,
      "describe_ch": "應用審計程序到財務報表循環",
      "describe_en": "Application of the audit process to the financial statement cycles"
    }
