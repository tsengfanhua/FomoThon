  "description": {
    "sub_id3": null,
    "sub_name": "醫學影像設備",
    "sub_ename": "MEDICAL IMAGING EQUIPMENT",
    "describe_ch": "此課程將介紹目前在醫院常用的醫學影像診斷儀器，和這些影像成像原理的概念。課程內容將淺介數種醫學影像掃描儀器，包含X光機、電腦斷層攝影，超音波掃描、磁振造影和核子醫學影像。藉由課程內容的介紹，將使學生瞭解多種不同醫學影像的基本系統架構與基本成像原理，和其影像特性與應用。",
    "describe_eh": "A comprehensive introduction to all major aspects of standard medical imaging systems used today. Topics include ultrasound imaging system, magnetic resonance imaging system, physics of projection radiography, radiographic imaging system, x-ray computed tomography system, and nuclear medicine system & nuclear imaging.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解各種醫學影像的基本顯像原理。",
      "describe_en": "To understand the basic imaging principles in various kinds of medical images."
    },
    {
      "seq": 2,
      "describe_ch": "能理解並說明各種醫學影像系統的基本構造。",
      "describe_en": "Comprehension and explanation for the basic structure in various kinds of medical images system."
    },
    {
      "seq": 3,
      "describe_ch": "能以書面或口頭方式表達所研讀的醫學影像相關資料。",
      "describe_en": "Communicate the reading data about medical image system by written or oral form."
    }
  ],
