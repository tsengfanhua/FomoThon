  "description": {
    "sub_id3": null,
    "sub_name": "雅思寫作",
    "sub_ename": "IELTS WRITING PREPARATION",
    "describe_ch": "本堂課主要為幫助學生理解雅思寫作測驗兩大題型的重點以及需求 (第一部分為解析說明圖表; 第二部分為根據主題論述)並且熟悉上述兩部分寫作類型常用的基本單字與文法句型。此課程最終目標為讓學生能夠針對雅思測驗的要求以及情境順利完成兩大寫作題型",
    "describe_eh": "This course aims at helping students understand the two academic writing types (Task 1 interpreting data, Task 2 making arguments) in IELTS and become familiar with essential vocabulary and sentence patterns to accomplish the two writing types which in the end will enable them to produce writings effectively in response to IELTS Task 1 and Task 2.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.使學生了解雅思寫作測驗考試重點",
      "describe_en": "1 Help students understand the construct of the IELTS writing section."
    },
    {
      "seq": 2,
      "describe_ch": "2.幫助學生有效率的運用所學並完成雅思寫作測驗",
      "describe_en": "2 Help students use the knowledge learned in class and prepare students for the IELTS writing section."
    }
  ],
