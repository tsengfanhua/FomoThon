  "description": {
    "sub_id3": null,
    "sub_name": "國際人力資源管理",
    "sub_ename": "INTERNATIONAL HUMAN RESOURCE MANAGEMENT",
    "describe_ch": "本課程旨在探討有效運用人力資源實務(甄選、招募、訓練、獎酬)達成國際企業的各種跨國管理活動與管理實務，以增進人力資源實務對國際企業的經營貢獻，使學生能瞭解人力資源管理之理論、原則與實務，並將其運用的特殊的跨文化及跨國界情境。",
    "describe_eh": "This course aims at the process of effective management of human resource to pursuit MNE's goals and an analysis of those elements essential such as selection, recruitment, training and reward. Principles and practices of the international human resource management are included. The cross-cultural contextual discussions will be covered to enable the students' abilities to effectively manage the human resource around the world.",
    "pre_subname": "MGT2010人力資源管理",
    "pre_sub_id3": "MGT2010",
    "pre_sub_ename": "MGT2010 HUMAN RESOURCES MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 10,
      "describe_ch": "瞭解跨文化管理、培訓與發展和勞資關係",
      "describe_en": "Understand cross cultural management, training, development and labor-capital relations"
    },
    {
      "seq": 11,
      "describe_ch": "瞭解國際人力資源策略及薪資管理",
      "describe_en": "Understand global IHRM strategies & salary management"
    },
    {
      "seq": 12,
      "describe_ch": "瞭解外派人員之招募與甄選",
      "describe_en": "Understand the recruitment of dispatched personnel"
    }
  ],
