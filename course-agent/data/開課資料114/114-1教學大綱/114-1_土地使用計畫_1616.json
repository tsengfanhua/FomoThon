  "description": {
    "sub_id3": null,
    "sub_name": "土地使用計畫",
    "sub_ename": "LAND USE PLANNING",
    "describe_ch": "此課程的目標在提供基礎的土地使用規劃知識。主要內容包含人口、產業、經濟、環境、公共設施、交通運輸、規劃價值觀系統、理性全盤式規劃方法、規劃資訊系統等。",
    "describe_eh": "The objective of this course is to offer a very fundamental set of knowledge in land use planning. Major topics will be covered population, industry, economy, environment, public facilities, transportation, planning-value systems, rational comprehensive planning approach and planning information system.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解土地使用規劃觀念與理論的變遷與趨勢。",
      "describe_en": "Be able to comprehend the change and trend of land use planning concepts."
    },
    {
      "seq": 2,
      "describe_ch": "能理解土地使用規劃的過程與架構。",
      "describe_en": "Be able to comprehend the process and framework of land use planning."
    },
    {
      "seq": 3,
      "describe_ch": "能應用土地使用規劃模型於都市計",
      "describe_en": "畫。Be able to apply land use models in urban planning."
    }
  ],
