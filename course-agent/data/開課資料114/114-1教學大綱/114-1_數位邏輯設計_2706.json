  "description": {
    "sub_id3": null,
    "sub_name": "數位邏輯設計",
    "sub_ename": "DIGITAL DESIGN",
    "describe_ch": "本課程介紹基本數位系統包含之CMOS電子元件、CPLD/FPGA IC、布林代數邏輯、組合邏輯及序向邏輯電路的設計應用。",
    "describe_eh": "This course is intended as an introduction to the fundamentals of digital systems. Contents include CMOS devices, CPLD/FPGA IC, Boolean logic function, combinational logic, and sequential logic for the purpose of being capable of designing digital circuits.",
    "pre_subname": "OPT2006應用電子學(一)",
    "pre_sub_id3": "OPT2006",
    "pre_sub_ename": "OPT2006 APPLIED ELECTRONICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解布林代數並且能簡化及加以運算布林函數。",
      "describe_en": "Understand Boolean algebra; be able to simplify and implement Boolean functions."
    },
    {
      "seq": 2,
      "describe_ch": "能了解廠商提供的數位IC元件資料並且能運用邏輯閘IC和CPLD/FPGA IC。　",
      "describe_en": "Understand digital IC datasheets and be able to implement logic gate IC and CPLD/FPGA IC.　"
    },
    {
      "seq": 3,
      "describe_ch": "能分析並設計組合邏輯電路和同步序向邏輯電路。",
      "describe_en": "Be able to analyze and design combinational logic circuits and clocked sequential logic circuits."
    }
  ],
