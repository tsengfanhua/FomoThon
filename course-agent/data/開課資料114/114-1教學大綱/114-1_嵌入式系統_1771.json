  "description": {
    "sub_id3": null,
    "sub_name": "嵌入式系統",
    "sub_ename": "EMBEDDED SYSTEMS",
    "describe_ch": "嵌入式系統是一種針對特殊應用目的,包含微處理機以及軟體、硬體結合的電子系統。本課程的主要目的在於介紹(1)嵌入式系統基本觀念。(2)ARM-based 嵌入式系統基本硬體架構、軟體指令與程式設計同學將可以籍此學習到嵌入式系統的定義、應用範圍、設計流程、背景知識以及軟硬體設計技術。3)嵌入式系統的即時作業系統架與應用。",
    "describe_eh": "The object of embedded system's course is to introduce the following topics. (1)Introducing the basic concept of embeddedsystem. (2)Introducing the hardware structure, software instruction, and programming for ARM-based embedded\nsystem. (3)The structure and applications of real-time operating system (RTOS) for embedded systems. Students will learn from this class the following knowledge and techniques: the definition and application range of embedded systems, the design flow, the background knowledge and the hardware/software design technologies of embedded system.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解嵌入式系統概念",
      "describe_en": "Understand the concepts of embedded system."
    },
    {
      "seq": 2,
      "describe_ch": "具備嵌入式系統程式設計之能力",
      "describe_en": "Establish the ability of program coding in an embedded system."
    },
    {
      "seq": 3,
      "describe_ch": "具備即時作業系統的基礎",
      "describe_en": "Establish the fundamentals of real-time operating system (RTOS)."
    }
  ],
