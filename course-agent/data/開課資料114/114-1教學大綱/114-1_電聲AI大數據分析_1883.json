  "description": {
    "sub_id3": null,
    "sub_name": "電聲AI大數據分析",
    "sub_ename": "ARTIFICIAL INTELLIGENCE FOR ELECTRO-ACOUSTICS BIG DATA ANALYTICS",
    "describe_ch": "本課程旨在教導學生如何利用人工智慧的基礎理論與演算法，並建構出一個簡單的深度學習軟硬體系統，用於電聲學的大數據分析。課程學習內容涵蓋音頻訊號特徵轉換、大數據分析與處理工具、分類模型、多任務回歸預測方法、以及電聲領域的相關應用研究實例。",
    "describe_eh": "This course aims to teach students how to use the fundamental theories and algorithms of artificial intelligence, and develop a simple type of deep learning software and hardware system for electro-acoustics’ Big Data analysis. The content of this course includes the audio signal feature conversion, big data analysis/processing tools, classification models, multi-task regression prediction methods, and detailed application examples in the electro-acoustics field.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識人工智慧基礎理論與演算法於電聲領域的應用",
      "describe_en": "To understand the fundamental theory and algorithm of artificial intelligence in the electro-acoustics field."
    },
    {
      "seq": 2,
      "describe_ch": "了解大數據分析於電聲領域之應用",
      "describe_en": "To realize the application of big data analysis in the electro-acoustics field."
    },
    {
      "seq": 3,
      "describe_ch": "建構人工智慧的軟硬體系統與機器學習模型",
      "describe_en": "To develop software, hardware systems, and machine learning models for artificial intelligence."
    }
  ],
