  "description": {
    "sub_id3": null,
    "sub_name": "半導體物理",
    "sub_ename": "SEMICONDUCTOR PHYSICS",
    "describe_ch": "本課程的目標在於讓學生認識晶體的結構,電子在晶體結構下其波的行為，能帶產生及狀態密度與機率分怖，探討決定半導體導電之因素及狀況，及PN接合之靜電特性。\n",
    "describe_eh": "The purpose of this course is to let the students know the crystal structures, the behaviors of electronic wave under the crystal structures, energy-band creation , and the state-density and probability distributions , Inquiring into and decide the factors and conditions of electrical conduction in the semiconductor , and The static electricity characteristic of the PN junction.\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備半導體晶格結構與量子力學之基本知識。\t",
      "describe_en": "Knowledge of crystal structure of solids and introductory concepts of the quantum theory of solids."
    },
    {
      "seq": 2,
      "describe_ch": "理解半導體能帶理論與電子/電洞之分佈統計、濃度計算與傳導機制等基本分析",
      "describe_en": "Comprehension of semiconductor band theories, carrier distribution statistics, carrier concentration calculation, and conduction mechanisms."
    },
    {
      "seq": 3,
      "describe_ch": "理解熱平衡/穩態機制、剩餘載子產生/復合機制與PN接面理論等基本分析",
      "describe_en": "Comprehension of thermal equilibrium/steady-state phenomena, generation/recombination mechanisms of excess carriers, and PN junction theory."
    }
  ],
