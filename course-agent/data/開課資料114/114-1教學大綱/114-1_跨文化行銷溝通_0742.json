  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB25130",
    "sub_id": "51988",
    "scr_dup": "001",
    "tpa_score_new": null,
    "tpa_score_new_en": "<div><u>Description of scoring rules</u><br />\nAssessments are calculated from student participation, attendance, oral<br />\nreports, short written reports, group assignments and midterm/final<br />\nexams.</div>\n\n<div>Students are expected to finish all assignments on time and<br />\ncontribute to any group discussions and article generation.</div>\n\n<div>Group work is subject to group evaluations.</div>\n\n<div>Bonus assignments are also available<br />\nfor students wishing to explore a topic in more depth and/or bolster their<br />\ngrades.</div>\n",
    "course_pol": null,
    "course_pol_en": "1. Be present and on-time for each class hour. This accounts for one-quarter of your final grade\n2. Participate actively in class. This is also a substantial part of the final grade.\n3. Do not be late (over 10 minutes) or leave early (without permission), otherwise it will be counted as absence.\n4. No foul or inappropriate language allowed. You are going to be asked to leave.\n5. Be considerate and polite to all. Help us create a positive classroom atmosphere.\n6. Treat everyone with respect. Discrimination or harassment will be dealt with according to the university guidelines.",
    "course_rem": null,
    "course_rem_en": "1. Each student must fulfill all parts of the class assessment.\n2. We are here to share and learn from each other.\n3. Do not hesitate to ask questions or seek clarification at any point during the class, afterwards or via email.\n4. Please try to maintain a positive mood and learning attitude.\n5. If you do not like the course you may drop at any time.",
    "ais_meno": null,
    "ais_meno_en": "<div>The primary purpose of this course is for students to actively learn and develop their own idenpendent critical thinking skills.&nbsp;What is valued most are students&#39; own<br />\nanalysis of discussed phenomenon and then putting forward their viewpoint. In other words developing and articulating&nbsp;a solid argument. It is discouraged to simply<br />\nassume the ideas of others without giving them a proper thought.</div>\n\n<div>A secondary aim is to encourage students to work collaboratively in groups in order to generate cohesive and comprehensive written reports and presentations.</div>\n\n<div>Cheating, copying or using AI for generating answers is absolutely forbidden.<br />\nThis will result in immediate failure&nbsp;from the course and will&nbsp;be reported to the university.</div>\n",
    "ilearn_mk": "N"
  },
