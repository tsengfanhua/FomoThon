  "description": {
    "sub_id3": null,
    "sub_name": "教育數據分析專題",
    "sub_ename": "SPECIAL TOPICS ON EDUCATIONAL DATA ANALYTICS",
    "describe_ch": "本課程目標在於帶領學生透過台灣教育資料庫，認識相關教育議題，並運用數據分析方法，具備分析教育問題之能力。課程中會經由實例研析教育議題，期望在課程訓練後能完成一教育主題報告，能針對教育問題提出看法與對策。",
    "describe_eh": "In this course, students will first realize the important educational issues and learn how to use the Taiwan Education Panel Survey dataset to investigate these issues with statistical tools. The goal of this course is to equip students with the ability to complete a final report proposing possible solutions to educational problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解教育大數據之基礎概念與在數位學習上的應用。",
      "describe_en": "Understanding the fundamental concept of big data for education and its applications in e-learning."
    },
    {
      "seq": 2,
      "describe_ch": "能撰寫程式語言或應用軟體進行教育大數據分析。",
      "describe_en": "Applying the statistical tools to analyze educational big data."
    },
    {
      "seq": 3,
      "describe_ch": "能使用適當的大數據分析方法模型解決教育相關問題。",
      "describe_en": "Proposing the possible solutions to current educational problems"
    }
  ],
