  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CF00100",
    "sub_id": "80981",
    "scr_dup": "001",
    "sub_title": "探討創新科技在金融服務業的運用",
    "sub_title_en": null,
    "sub_describe": "以服務科學理論與服務創新管理概念為核心觀點",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "金融服務與科技創新管理",
    "sub_ename": "STRATEGIC MANAGEMENT OF FINANCIAL SERVICES AND TECHNOLOGICAL INNOVATION",
    "describe_ch": "以服務科學精神及服務創新管理為核心，結合金融產業在科技運用與服務創新的環境探討，引導學生能結合趨勢觀察、使用者思維、設計方法以及創新模式等內容，透過與金融業企業合作，讓學生可以實際演練設計導向之服務創新的作法。特別著重在發現服務需求與創新機會，並欲透過與業者共同舉行之設計工作坊，發展金融業的服務創新與科技連結概念。",
    "describe_eh": "This is a course in management of service innovation with technological innovation for financial service industry. The objective is to help students become familiar with industrial analysis and management through service theories and design thinking through discussion, co-creation, and videos. The key concepts include theories of service design, service marketing and technology management in financial service industry.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "以理論為基礎，理解金融業在服務創新與服務設計的運作機制",
      "describe_en": "To understand the mechanism of service innovation and service design in the finance system through solid theoretical foundation."
    },
    {
      "seq": 2,
      "describe_ch": "價值共創之學習，結合新領域的能力",
      "describe_en": "To acquire the ability to co-creation, integrate, and develop new research areas"
    },
    {
      "seq": 3,
      "describe_ch": "具備團隊合作的精神，有效溝通的能力",
      "describe_en": "To develop teamwork spirit, to acquire the ability to communicate effectively"
    }
  ],
