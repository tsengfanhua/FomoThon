  "description": {
    "sub_id3": null,
    "sub_name": "光學設計概論實習",
    "sub_ename": "PRACTICE OF OPTICAL DESIGN",
    "describe_ch": "使學生能使用光學軟體設計簡單光學系統及分析成像品質。",
    "describe_eh": "Students can employ the knowledge learned in OPI344 course with computer software to design simple optical systems and analyze their image quality.",
    "pre_subname": "OPT2001光學(一)、OPT3003光學設計概論",
    "pre_sub_id3": "OPT2001",
    "pre_sub_ename": "OPT2001 OPTICS (1)、OPT3003 INTRODUCTION TO OPTICAL DESIGN",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能利用實例來學習光學設計的技巧。",
      "describe_en": "Be able to utilize the examples to study the skills of optical design."
    },
    {
      "seq": 2,
      "describe_ch": "能使用光學軟體計算光線行進之行為。",
      "describe_en": "Be able to use optical simulation software to calculate the behaviors of ray tracing."
    },
    {
      "seq": 3,
      "describe_ch": "能熟悉光學系統設計之應用與分析成像之品質。",
      "describe_en": "Be able to familiar with the applications of optical system design and analyze the image quality of an optical system."
    },
    {
      "seq": 4,
      "describe_ch": "能利用學習到的知識評估並解決所遭遇的光電問題。",
      "describe_en": "Be able to evaluate and solve the optoelectric problems by learning knowledge."
    }
  ],
