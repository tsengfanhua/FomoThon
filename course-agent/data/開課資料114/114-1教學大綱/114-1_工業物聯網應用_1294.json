  "description": {
    "sub_id3": null,
    "sub_name": "工業物聯網應用",
    "sub_ename": "INDUSTRIAL IOT APPLICATIONS",
    "describe_ch": "本課程內容主要探討物聯網技術應用在生產管理上，成為發展智慧製造重要條件。能瞭解工業物聯網於智慧工廠、智慧生產、智慧物流、智慧服務等方面的應用，並從中學習工業4.0系統觀，讓生產管理有更高的效率和可靠度。",
    "describe_eh": "This course explores the application of Internet of Things (IoT) in production management. Industrial Internet of Things (IIoT) is the key foundation of intelligent manufacturing. IIoT can further apply aspects such as intelligent factory, intelligent production, intelligent logistics, and intelligent service. In addition, students can also understand the overview of Industry 4.0 with IIoT, and it can help achieve higher efficiency and reliability in production management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解物聯網技術應用在生產管理上。",
      "describe_en": "Understand the application of Internet of Things technology in production management."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解工業物聯網的系統整合與應用。",
      "describe_en": "Understand the system integration and application of Industrial Internet of Things."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解工業物聯網與智慧製造的關係。",
      "describe_en": "Understand the relationship between Industrial Internet of Things and smart manufacturing."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解工業物聯網和工業4.0系統觀。",
      "describe_en": "Understand the industrial Internet of Things and Industry 4.0 system concepts."
    }
  ],
