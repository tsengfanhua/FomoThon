  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解甘梯圖、箭線網狀圖及關鍵路線\t",
      "describe_en": "Understand gantt chart arrow diagram  and CPM"
    },
    {
      "seq": 2,
      "describe_ch": "詳述營建法規及專案管理\t",
      "describe_en": "Specify the law of construction and project management"
    },
    {
      "seq": 3,
      "describe_ch": "具備工程應用之數學、力學及統計能力\t",
      "describe_en": "Apply the mathmatics and statistic analysis of engineering"
    },
    {
      "seq": 4,
      "describe_ch": "了解不同工程項目互相配合技術\t",
      "describe_en": "Understand the match skill between different items\r\n"
    }
