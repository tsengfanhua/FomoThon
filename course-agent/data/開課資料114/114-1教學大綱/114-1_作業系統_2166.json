  "description": {
    "sub_id3": null,
    "sub_name": "作業系統",
    "sub_ename": "OPERATING SYSTEMS",
    "describe_ch": "能了解、獲得作業系統重要的基本知識、運作原理、與結構組成; 例如Process、Multithreaded Programming, Process Scheduling, Synchronization, Memory Management, File System, Inter-Process Communication等. 透過導入Linux作業系統的實務操作暨系統程設, 並籍由翻轉教育的施行, 實踐更有效的學習成果.",
    "describe_eh": "Students enrolling in this class are able to understand and acquire the important knowledge, operating principles, and structural components of operating systems; they include Process, Multithreaded Programming, Process Scheduling, Synchronization, Memory Management, File System, Inter-Process Communication, etc. By importing the manipulation and programming of the Linux operating system, plus the systematic introduction of flipped classrooms, more effective learning effects can be obtained.",
    "pre_subname": "IEE1000計算機概論(一)、IEE1001計算機概論(二)",
    "pre_sub_id3": "IEE1000",
    "pre_sub_ename": "IEE1000 INTRODUCTION TO COMPUTER(1)、IEE1001 INTRODUCTION TO COMPUTER(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "讓學生能具備兼具廣度與深度之作業系統專業素養",
      "describe_en": "To have a broad and in-depth professional on operation systems"
    },
    {
      "seq": 2,
      "describe_ch": "讓學生能實作與作業系統相關之運作程式碼",
      "describe_en": "To be able to code system programs what can manipulate Linux operations"
    }
  ],
