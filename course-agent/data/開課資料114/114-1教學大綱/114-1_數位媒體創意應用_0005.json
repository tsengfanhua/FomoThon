  "description": {
    "sub_id3": null,
    "sub_name": "數位媒體創意應用",
    "sub_ename": "MULTIMEDIA CREATIVITY AND INNOVATIVE APPLICATIONS",
    "describe_ch": "本課程將介紹互動設計、藝術設計和機器學習技術的應用。課程中將探討如何利用TouchDesigner實現虛實互動，並投影出具有藝術設計感的互動作品。學生將學習如何使用不同的媒體元素、控制界面、交互技術和機器學習算法，創作出獨特的互動設計作品。通過本課程的學習，學生可以獲得多媒體創意應用的基本理解和能力。",
    "describe_eh": "This course introduces the applications of interactive design, art design, and machine learning technology. Students will explore how to realize virtual and real interaction using TouchDesigner, and project interactive works with artistic design. They will learn to use different media elements, control interfaces, interaction techniques, and machine learning algorithms to create unique interactive design works. Through this course, students will gain a fundamental understanding and skills in innovative applications of multimedia creativity.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備互動設計、藝術設計和機器學習的基本知識與技能，並能運用於多媒體創意應用",
      "describe_en": "To obtain fundamental knowledge and skills of interactive design, artistic design and machine learning, and apply them to multimedia creative applications"
    },
    {
      "seq": 2,
      "describe_ch": "具備使用TouchDesigner實現虛實互動和藝術投影的實作能力，並能展示和評估自己的作品",
      "describe_en": "To obtain practical ability to use TouchDesigner to create virtual-real interaction and artistic projection, and demonstrate and evaluate their own works"
    },
    {
      "seq": 3,
      "describe_ch": "具備使用不同的媒體元素、控制界面、交互技術和機器學習算法，創作出具有個人風格和創意的互動設計作品的能力",
      "describe_en": "To obtain ability to use different media elements, control interfaces, interaction techniques and machine learning algorithms, to create interactive design works with personal style and creativity."
    }
  ],
