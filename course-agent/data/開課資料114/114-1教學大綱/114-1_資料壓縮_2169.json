  "description": {
    "sub_id3": null,
    "sub_name": "資料壓縮",
    "sub_ename": "DATA COMPRESSION",
    "describe_ch": "此課程介紹數位訊號壓縮之方法與執行架構。 \n 內容包括統計式無損資料壓縮法、字典式基礎之無損壓縮法、預測式編碼法、非累贅式取樣點之編碼法、轉換編碼法、向量量化編碼法。以及如何整合這些方法在現今之壓縮標準中。",
    "describe_eh": "This class provide an introduction to the algorithm and architecture of digital signal compression, which include statistical-based lossless data compression, dictionary-based lossless data compression, predictive coding, non-redundancy sample coding, transform-based compression algorithm, vector quantization, as well as how they are applied in the compression standard.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解熵的觀念及資料累贅的基本理論。",
      "describe_en": "了解熵的觀念及資料累贅的基本理論。"
    },
    {
      "seq": 2,
      "describe_ch": "具備對於包括文字資料、心電圖資料影像、視訊等的資料格式進行壓縮的能力。",
      "describe_en": "具備對於包括文字資料、心電圖資料影像、視訊等的資料格式進行壓縮的能力。"
    },
    {
      "seq": 3,
      "describe_ch": " 能夠分析各種縮法之效能及其重建品質之評估。",
      "describe_en": " 能夠分析各種縮法之效能及其重建品質之評估。"
    }
  ],
