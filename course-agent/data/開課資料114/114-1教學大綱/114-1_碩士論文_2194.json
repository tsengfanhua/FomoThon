  "description": {
    "sub_id3": null,
    "sub_name": "碩士論文",
    "sub_ename": "MASTER THESIS",
    "describe_ch": "通過學科考試之研究生在指導教授之專業指導下進行碩士論文之研究及撰寫?碩士論文是碩士學位的基本要求之一。",
    "describe_eh": "Formal record of student commitment to master's thesis research under the guidance of a faculty advisor. Registration may be repeated as necessary.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能針對研究方向的範籌，進行相關資訊的蒐集、研讀、分析與整理歸納，並藉以確立論文研究題目。",
      "describe_en": " "
    },
    {
      "seq": 2,
      "describe_ch": "經由參與團隊的研討，培養比較分析不同見解與解決方案的能力，並帶領學弟妹們參與研究之執行與管理。",
      "describe_en": " "
    },
    {
      "seq": 3,
      "describe_ch": "能於論文的研究過程中，能與不同領域的研究人員溝通、協調及整合。",
      "describe_en": " "
    },
    {
      "seq": 4,
      "describe_ch": "提出研究問題的解決方法或開發新的應用，應用專業理論與軟硬體設備等，以鑑別研究方法的可行性、效能與未來可持續進行的研究方向。",
      "describe_en": " "
    },
    {
      "seq": 5,
      "describe_ch": "能適當的歸納出研究結論及遵守專業倫理，並以書面及口頭報告呈現研究成果。\r\n",
      "describe_en": " "
    }
  ],
