  "description": {
    "sub_id3": null,
    "sub_name": "憲法",
    "sub_ename": "THE CONSTITUTION OF THE REPUBLIC OF CHINA",
    "describe_ch": "從政治哲學及憲政理論的角度，探討憲法在保障個人基本權利上所能發揮的功能及在民主制度中所能扮演的角色。民主本身並不是一種價值；它是一種為了追求人權價值和人性尊嚴而衍生出來的程序工具或制度。所以，民主不是天生的或自然存在的，而是必須經過人為的確認和努力；它必須經過價值認知和引導，並透過程序管理，才有可能達到。本課程將從政治哲學切入，探尋出近代民主政治所追求的價值，以作為憲法體制的引導；其次再以社會進化的原理分析歸納出憲政運作的架構；最後落實到憲法制度。本課程的終結果還要檢視憲法制度與人權保障的關係。",
    "describe_eh": "This course aims to investigate the constitutional function of protecting individual's human rights and its role in a democratic political system from the perspectives of political philosophy and constitutionalism. Democracy per se is not a value; it is a process means or an institution to get at values of human rights and human dignity. So to reach the status of democracy needs human's identification of its values and efforts. The course will discuss values, theories and institutions on democracy. Finally it will also research on correlation between constitutional institutions and protection of human rights.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "從政治哲學及憲政理論的角度，探討憲法在保障個人基本權利上所能發揮的功能及在民主制度中所能扮演的角色。",
      "describe_en": "To investigate the constitutional function of protecting individual's human rights and its role in a democratic political system from the perspectives of political philosophy and constitutionalism."
    },
    {
      "seq": 2,
      "describe_ch": "從政治哲學切入，探尋出近代民主政治所追求的價值，以作為憲法體制的引導；其次再以社會進化的原理分析歸納出憲政運作的架構；最後落實到憲法制度。",
      "describe_en": "Discuss values, theories and institutions on democracy."
    },
    {
      "seq": 3,
      "describe_ch": "能使用相關設備，研究、分析資料，並歸納出適當的結論。",
      "describe_en": "Be able to use equipment to finish an analyses about the dispute of Business Law, and draw appropriate conclusions from there."
    }
  ],
