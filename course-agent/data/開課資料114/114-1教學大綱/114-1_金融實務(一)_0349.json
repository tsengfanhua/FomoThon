      "sub_id": "22752",
      "scr_dup": "001",
      "tpd_seq": 0,
      "tpd_week": "15",
      "tpd_reading": "<div><strong>第十三主題:&nbsp;大陸不動產斷供危機</strong></div>\n",
      "tpd_reading_en": null,
      "tpd_learn": null,
      "tpd_learn_en": null,
      "tpd_duedate": null,
      "tpd_duedate_en": null,
      "tpd_in": null,
      "tpd_in_en": null,
      "tpd_rtime": null,
      "tpd_rtime_en": null,
      "tpd_sync": null,
      "tpd_sync_en": null,
      "tpd_ass": "主要重點:\n\n房地產企業資金鏈斷裂導致購房者停止還款（斷供）的金融與社會連鎖反應\n\n房地產泡沫破裂對銀行不良貸款、地方政府財政和整體經濟的影響\n\n政策介入與市場調控：債務重組、金融支持、預售制度改革\n\n對投資人、購房者及境外資金的風險啟示\n\n案例:\n\n恆大集團（Evergrande）債務危機：2021 起引發大量斷供事件，牽動中國房地產與銀行業\n\n其他房企如碧桂園、花樣年在資金緊張下出現斷供或延期交房\n\n社交媒體與「斷供維權潮」對房地產金融市場情緒的影響",
      "tpd_ass_en": null,
      "tpd_online_asy": null,
      "tpd_online_syn": null,
      "tpd_online_face": null,
      "tpd_week_en": null,
      "mode": 0
    },
