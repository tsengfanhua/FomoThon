      "tpd_seq": 0,
      "tpd_week": "16",
      "tpd_reading": "<div><strong>第十四: </strong><strong>移工資金流動 -&nbsp;跨境匯款與加密支付</strong></div>\n",
      "tpd_reading_en": null,
      "tpd_learn": null,
