  "description": {
    "sub_id3": null,
    "sub_name": "精算實務(一)",
    "sub_ename": "PRACTICE OF ACTUARIAL SCIENCE (1)",
    "describe_ch": "針對產險公司保險成本實務及經營績效進行個案分析討論。包含：資產負債表估價方法、真實價值與市場價值、股利折現模式。介紹人壽保險實務：包含人壽保險經營管理、相關壽險產品精算。壽險風險包含：風險基礎資本額之組成、資產違約風險及跌價對壽險業者之影響。",
    "describe_eh": "Students will learn the operation performance issues in Property and Casualty Insurance. Content includes: balance sheet valuation methods, Intrinsic value versus market price, dividend discount models, life insurance management, related actuarial product valuation. Risk-based capital for life insurer including the following topic: the components of risk-based capital, asset default, and depreciation, and impact of RBC on life insurer.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
