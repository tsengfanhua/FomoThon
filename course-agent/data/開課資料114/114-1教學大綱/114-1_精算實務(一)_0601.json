    {
      "seq": 1,
      "describe_ch": "理解估計權益價值的模式與產物保險公司各種風險分析之過程",
      "describe_en": "Understanding the Equity valuation models and Understand the process of analyses adopted by the P&C Insurance Company for different risks."
    },
    {
      "seq": 2,
      "describe_ch": "理解風險基礎資本額對壽險業者之影響",
      "describe_en": "Understanding the impact of RBC on life insurer."
    }
