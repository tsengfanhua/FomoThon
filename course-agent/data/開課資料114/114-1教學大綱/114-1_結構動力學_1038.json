  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "結構動力學",
    "sub_ename": "STRUCTURAL DYNAMICS",
    "describe_ch": "結構動力學是一門訓練課程，教導學生如何分析結構受外力或地震，結構動力學將專注於單自由度結構與多自由度結構，包含運動方程式的建立，方程式之解法，如振動歷時分析法，反應譜法，模態分析法，數值分析法等。此課程亦介紹結構動力學於地震工程之應用並培養學生研究地震工程之基本知識與興趣。",
    "describe_eh": "Structural Dynamics is a training course, which leads students to have the ability to analyze structures subjected to external or earthquake loads. This course will focus on the methods to establish the equations of motion for single-degree-of-freedom and multiple-degree-of-freedom systems as well as the methods to solve these differential equations, such as the response time history analysis, response spectra method, the modal analysis method, and the numerical integration method etc. To enhance the students' interest and knowledge for research in the earthquake engineering, the implementation of structural dynamics in earthquake engineering will be introduced.",
    "pre_subname": "CE2070結構學(一)、CE3071結構學(二)",
    "pre_sub_id3": "CE2070",
    "pre_sub_ename": "CE2070 STRUCTURAL THEORY(1)、CE3071 STRUCTURAL THEORY (2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "以學生所具備之物理學、微積分、工程數學、應用力學、材料力學、結構學為基礎，培養其分析結構動力之能力，以備結構設計之需。",
      "describe_en": "Teach students to do dynamic structural analysis and design, based on their acquired knowledge in physics, calculus, engineering math., engineering mechanics, and strength of materials."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生閱讀中、英文之結構書籍，吸收國內外結構力學之新知識，以適應時代潮流與社會需求。",
      "describe_en": "Help students to read structural books in Chinese or English, to absorb more modern knowledge of structural theory, such that they can have full capability in doing a work in the future."
    },
    {
      "seq": 3,
      "describe_ch": "講解分析結構動力之原理、假設、定理、及公式之誘導，使同學對結構動力理論能通盤瞭解。",
      "describe_en": "Help students to fully understand the structural theory by explaining assumptions, proving theorems, and deriving equations in the class."
    },
    {
      "seq": 4,
      "describe_ch": "講解實際例題，增進學生解題技巧。",
      "describe_en": "Help students to learn the technique of solving problems by giving examples in the class."
    },
    {
      "seq": 5,
      "describe_ch": "培養學生研究地震工程之基本知識與興趣。",
      "describe_en": "Enhance the students' interest and knowledge for research in earthquake engineering."
    }
  ],
