  "description": {
    "sub_id3": null,
    "sub_name": "微積分(一)",
    "sub_ename": "CALCULUS(1)",
    "describe_ch": "內容包含函數極限，導數，導函數，微分公式，鏈鎖律，隱微分，高階導數，線性近似與微分量，極大和極小值，導數與函數圖形之關係，無窮極限，水平漸近線，反導數，定積分，微積分基本定理，不定積分，代換法，曲線所圍之區域面積，自然對數函數，自然指數函數，一般對數與指數函數，反三角函數，並探討相關應用。",
    "describe_eh": "Topics include the Limit of a Function, Derivatives, Differentiation Formula, the Chain Rule, Implicit Differentiation, Higher Derivatives, Linear Approximation, Maximum and Minimum Values, the Definite Integral, the Fundamental Theorem of Calculus, Indefinite Integrals, the Substitution Rule, Logarithmic and Exponential Functions, Inverse Trigonometric Functions and their applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解函數在有限值與在正、負無限大的極限意義和極限不存在時的可能現象。",
      "describe_en": "Understand the limits of functions at a finite value, the limits of functions at infinity, horizontal asymptotes and vertical asymptotes."
    },
    {
      "seq": 2,
      "describe_ch": "能應用極限的四則運算定理、夾擠定理、合成運算定理、計算函數的極限值。",
      "describe_en": "Be able to compute the limit of a function by applying properties of the limit such as the basic properties, the squeeze theorem and the composite function theorem"
    },
    {
      "seq": 3,
      "describe_ch": "了解函數的連續性意義和連續性與極限概念的關係。",
      "describe_en": "Comprehend the concept of a continuous function and its relationship with the limit"
    },
    {
      "seq": 4,
      "describe_ch": "了解連續函數的中間值定理以及用數值方法求方程式根之應用。",
      "describe_en": "Understand the intermediate value theorem and its application for solving equations by numerical method"
    }
  ],
