  "description": {
    "sub_id3": null,
    "sub_name": "智慧城市發展導論",
    "sub_ename": "INTRODUCTION ON SMART CITY DEVELOPMENT",
    "describe_ch": "本課程為智慧城市碩士學位學程之先導課程，藉由介紹本校實際參與智慧城市應用的相關研究成果及主要師資，並配合學生背景及興趣，協助學生確認其論文方向及合適指導教授以利後續研究。",
    "describe_eh": "This course is the guiding course for this master program by introducing the relevant project outcomes and main participation faculty of the smart cities applications in our university. It also assists students to confirm their thesis direction and the appropriate guidance professors for follow-up research based on the background and interests of students.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生學習智慧城市建構方法",
      "describe_en": "Students will learn about smart city modelling."
    },
    {
      "seq": 2,
      "describe_ch": "利用智慧城市技術進行城市分析",
      "describe_en": "Students will learn urban analysis using IoT and smart city models."
    },
    {
      "seq": 3,
      "describe_ch": "使學生學習智慧城市之綜合研究",
      "describe_en": "A comprehensive study that enable student to learn from smart cities."
    }
  ],
