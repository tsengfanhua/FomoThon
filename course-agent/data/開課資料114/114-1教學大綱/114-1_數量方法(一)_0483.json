  "description": {
    "sub_id3": null,
    "sub_name": "數量方法(一)",
    "sub_ename": "QUANTITATIVE METHOD(1)",
    "describe_ch": "本課程旨在引介與闡述進行研究的數量方法。課程內容著重在資料分析方法的說明與應用及常用統計軟體（Excel, SPSS, Eviews）的操演，以建立研究方法論的理論基礎與其運用。",
    "describe_eh": "This course is designed to give students an understanding of how we can use theory and data from economics, business, and social sciences along with tools from statistics and Excel, SPSS software packages to answer \"how much\" type questions.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解基本統計、假設檢定與複迴歸　",
      "describe_en": "To understand the basic statistics, hypothesis test and multiple regression and its applications　"
    },
    {
      "seq": 2,
      "describe_ch": "能應用多變量與時間序列方法至管理與經濟研究領域　",
      "describe_en": "To apply the multivariate analysis and time series in the area of management and economics　"
    },
    {
      "seq": 3,
      "describe_ch": "能運用Excel, SPSS和Eviews等統計套裝軟體進行實證分析，並歸納結論 。",
      "describe_en": "to analysis the empirical data by using Excell, SPSS and Eviews　"
    }
  ],
