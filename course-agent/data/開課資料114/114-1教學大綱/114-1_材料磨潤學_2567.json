  "description": {
    "sub_id3": null,
    "sub_name": "材料磨潤學",
    "sub_ename": "TRIBOLOGY OF MATERIALS",
    "describe_ch": "磨耗造成金錢的浪費，如何減少這些浪費是本課程目標，並將有計劃的先定義磨耗、磨潤理論、介紹磨耗的型態，對已知及未知的磨耗機構加以說明，然後提出降低磨耗率的技術選擇方法和規範，這些技術包括金屬溼鍍法、置換被覆法、擴散法、可淬火硬化鋼的表面處理、真空被覆法、高能表面改質及一些無法歸類在以上技術的其它方法，如硬面銲補。",
    "describe_eh": "Wear costs a lot of money, and reduction of these costs is the goal of this book. The plan of the book is to first define wear, to discuss modes of wear, to comment on what is known and what is not known about wear mechanisms, and then to present selection and specification information on the processes that can be used to reduce the damaging effects of wear: metallic plating, conversion coating, diffusion treatments, surfacing hardening of quench-hardenable steels, thin film coatings, high-energy surface modifications, as well as some processes that do not fit into any of these categories.",
    "pre_subname": "MSE2042金屬加工與熱處理",
    "pre_sub_id3": "MSE2042",
    "pre_sub_ename": "MSE2042 MANUFACTUREING PROCESSES AND HEAT TREATMENT OF METALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能定義磨耗，並能瞭解磨耗的型態與機制。",
      "describe_en": "Define the wear and understand the wear modes and wear mechanism."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解與正確地選用降低磨耗損壞率的方法，如金屬溼鍍法、置換被覆法、擴散法、可淬火硬化鋼的表面處理、真空被覆法、高能表面改質。",
      "describe_en": "Understand and properly select the methods to reduce the damaging effects of wear: metallic plating, conversion coating, diffusion treatments, surfacing hardening of quench-hardenable steels, thin film coatings, high-energy surface modifications."
    }
  ],
