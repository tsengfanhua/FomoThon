  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CS06139",
    "sub_id": "48812",
    "scr_dup": "001",
    "sub_title": "了解量子電腦科技計算及應用的相關知識",
    "sub_title_en": null,
    "sub_describe": "量子電腦科技在未在是非常重要的前言科技, 相關知識包含物理, 數學, 電子, 電機,資工...等領域, 學習此課程會跟上時代腳步外, 也可獲得重要的理工能力.對未來的學習或工作都有重要影響.",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "量子電腦科技與應用",
    "sub_ename": "QUANTUM COMPUTING TECHNOLOGY AND APPLICATIONS",
    "describe_ch": "本課程主要是帶領同學獲得量子電腦科技領域與應用的知識，包括重要物理現象、數學理論、量子電腦及軟體開發工具包(Qiskit)。",
    "describe_eh": "This course is mainly to lead students to acquire the knowledge of quantum computing technology and applications, including important physical phenomena, mathematical theories, quantum computers and the software development kit (Qiskit).",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解量子物理的重要的基本知識及數學方法。",
      "describe_en": "To understand the important basic knowledge and mathematical methods of quantum physics."
    },
    {
      "seq": 2,
      "describe_ch": "增加量子電腦科技知識的理解。",
      "describe_en": "To increase understanding of quantum computer technology knowledge."
    },
    {
      "seq": 3,
      "describe_ch": "學習應用量子科技知識。",
      "describe_en": "To learn and apply quantum technology knowledge."
    },
    {
      "seq": 4,
      "describe_ch": "綜合量子電腦科技與應用(Qiskit軟體的學習)。",
      "describe_en": "To integrate quantum computer technology and applications (learning of Qiskit software)."
    }
  ],
