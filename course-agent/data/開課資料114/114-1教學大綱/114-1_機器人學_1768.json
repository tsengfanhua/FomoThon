  "description": {
    "sub_id3": null,
    "sub_name": "機器人學",
    "sub_ename": "ROBOTICS",
    "describe_ch": "本課程的目的不僅是讓學生了解機器人學的基本原理，而且還提供對機器人學的系統學習，主要由用於建模和規劃機器人運動、分析其運動學和動力學以及設計控制策略的數學工具組成。學生必須完成硬體和軟體的課程項目，以獲得親身體驗。",
    "describe_eh": "The objective of this course is not only to expose students to fundamental principles but also to provides a systematic study of robotics, consisting primarily of mathematical tools to model and plan the motion of a robot, analyze its kinematics and dynamics, and design control strategies. Students are required to accomplish course projects involving both hardware and software in order to gain hands-on experience.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的辭彙定義出機器人工學之原理與其使用方法。",
      "describe_en": "Define the theorem and using method of robotics engineering with their own words."
    },
    {
      "seq": 2,
      "describe_ch": "能辨識出可應用定理與模型的場合，並能清楚表達。",
      "describe_en": "Distinguish and make clear statement where theory and modeling of robotics can be applied."
    },
    {
      "seq": 3,
      "describe_ch": "知道何處可找到機器人工學的相關資訊、研究結果及軟體，並可評估所獲資訊的適用性。",
      "describe_en": "Know where to locate and access related robotics engineering issue information, research, as well as software, and be able evaluate the appropriateness of the obtained information."
    },
    {
      "seq": 4,
      "describe_ch": "能利用機器人工學的原理，評估一真實系統，並提出計算程序。同時能夠應用於相關多軸非標準型自動化機器動態運動及校正的課題。",
      "describe_en": "Use principles of robotics engineering to evaluate a true system and propose a feasible method for computational algorithms. Can also apply what to learn in this class applying to related multi-axes non-standard automated machine dynamic motion and calibration topics."
    }
  ],
