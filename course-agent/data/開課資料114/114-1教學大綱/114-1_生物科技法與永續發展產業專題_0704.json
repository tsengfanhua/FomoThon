  "description": {
    "sub_id3": null,
    "sub_name": "生物科技法與永續發展產業專題",
    "sub_ename": "BIOTECHNOLOGICAL LAW AND BUSINESS DEVELOPMENTS",
    "describe_ch": "針對生物科技發展給予基礎全面性的介紹，內容主題涵蓋基因檢測與資訊、生物科技智慧財產權保護、生物科技國際公約等相關生物科技法律問題，並由學理論述配合案例探討，使學生對相關法制政策得以融會貫通。",
    "describe_eh": "This course covers various major legal issues regarding biotechnology facing today. The course is aimed to encourage students to study legal and ethical issues of biotechnology so that the students are able to learn how to manage biotechnology business and also to critically evaluate existing regulation and legislations of biotechnology. The course will introduce current and likely future developments in biotechnology and also provide students with updated information regarding significant issues of biotechnological law and ethics.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生能應用生物科技之現代化技術知識與產業政策，進而歸納出產業競爭力。",
      "describe_en": "Students could understand biotechnological law and apply modern technology knowledge and industrial policy of biotechnology, so that they could own competiveness of industry."
    },
    {
      "seq": 2,
      "describe_ch": "學生能綜合應用科技管理之方法，評估生物科技管理與創新並深入了解其法制規範，並提出可施行之方法。",
      "describe_en": "Students could combine and apply the methods of management of technology to evaluate the management of biotechnology so that they could realize its regulations and provide feasible approaches for company, their own definition to apply and use intellectual"
    }
  ],
