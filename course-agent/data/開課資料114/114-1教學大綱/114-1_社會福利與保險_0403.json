  "description": {
    "sub_id3": null,
    "sub_name": "社會福利與保險",
    "sub_ename": "SOCIAL WELFARE AND INSURANCE",
    "describe_ch": "本課程為進階的專業保課程，旨在使學生了解福利國家發展的理論與模式，進一步探討社會保險的原理及現行我國各項社會保險的內涵。最後透析我國社福制度的全盤架構、現行方案與未來的發展，有助於學生開拓非商業保險領域的視野。",
    "describe_eh": "Students can be able to :\r\n1.\tUnderstand the basic theory of welfare state and social insurance.\r\n2.\tUnderstand the type of welfare state, the scope of social insurance and it's development process.\r\n3.\tAnalyze the macroeconomic effect of social insurance.\r\n4.\tAnalyze the general construction and the scheme of social welfare system of R.O.C\r\n5.\tAnalyze the relationship between social insurance and commercial insurance.\r\n",
    "pre_subname": "INSU1001保險學",
    "pre_sub_id3": "INSU1001",
    "pre_sub_ename": "INSU1001 INSURANCE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解社會福利與保險方面的基本知識。",
      "describe_en": "Comprehending basic knowledge of welfare state and social insurance."
    },
    {
      "seq": 2,
      "describe_ch": "藉由期末報告撰寫培養學生具備溝通技巧",
      "describe_en": "By means of the final paper enhancing the students' ability of communication"
    },
    {
      "seq": 3,
      "describe_ch": "應用社會保險的知識來分析福利國家之類型。",
      "describe_en": "To apply the social insurance to analyze the type of welfare state."
    }
  ],
