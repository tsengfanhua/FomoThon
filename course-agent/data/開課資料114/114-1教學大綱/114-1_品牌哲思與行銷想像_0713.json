  "description": {
    "sub_id3": null,
    "sub_name": "品牌哲思與行銷想像",
    "sub_ename": "BRAND PHILOSOPHY AND MARKETING",
    "describe_ch": "此課程以宏觀及哲思的角度，深度探討品牌與行銷在思辨、模式、典範移轉上的想像與創造。課程融合哲學、美學、心理學、社會學等學科，讓博士班學生能運用課程所學之精髓於生活、工作、課程，甚至於生命的美好。",
    "describe_eh": "This course adopts the perspectives of macro and philosophical thinking on discussing the imagination and creation of critical thinking, model, and paradigm shift for the brand and marketing in this digital era. The course integrates philosophy, aesthetics, psychology, sociology, and behavioral economics into the course discussion which can help doctoral students understand and practice the essence of brand philosophy and marketing imagination to life, work, course study, and even developing a better life.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能深度理解品牌哲思與行銷想像",
      "describe_en": "Fully understanding the essence of brand philosophy and marketing imagination"
    },
    {
      "seq": 2,
      "describe_ch": "能在實務上發展品牌與行銷之模式與典範移轉",
      "describe_en": "The ability to develop the model and paradigm shift for brand and marketing"
    }
  ],
