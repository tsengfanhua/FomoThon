  "description": {
    "sub_id3": null,
    "sub_name": "機器人導論",
    "sub_ename": "INTRODUCTION OF ROBOTICS",
    "describe_ch": "介紹機械人學基本原理與應用範圍，並強調於並聯式與串聯式機械臂的運動學、逆運動學、動力學及控制等課題的方程式建立與求解方法。",
    "describe_eh": "This course is intended to provide the student with a clear and thorough presentation of both the theory and application of the fundamental principles of robots. Emphasis is placed on the establishment of the equations on kinematics, dynamics, and control of robot manipulators. Both serial and parallel manipulators are covered in depth.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解機器人應用在工程製造與設計的重要性。",
      "describe_en": "Understand the importance of robotics on the applications of engineering design and manufacturing."
    },
    {
      "seq": 2,
      "describe_ch": "建立機器人技術應用的基礎認知",
      "describe_en": "Establish basic awareness of robotics technology applications"
    },
    {
      "seq": 3,
      "describe_ch": "了解機器人學的基本概念與原理",
      "describe_en": "Understand the basic concepts and principles of robotics"
    },
    {
      "seq": 4,
      "describe_ch": "學會使用程式工具進行基礎機器人模擬",
      "describe_en": "Learn to use programming tools for basic robot simulation"
    }
  ],
