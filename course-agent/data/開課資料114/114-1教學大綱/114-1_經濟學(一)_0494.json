  "description": {
    "sub_id3": null,
    "sub_name": "經濟學(一)",
    "sub_ename": "ECONOMICS(1)",
    "describe_ch": "讓學生從經濟學的課程中瞭解經濟體系中的消費者、生產者、及政府單位如何在有限制的條件下做選擇。將理論的邏輯推理運用在日常生活當中。",
    "describe_eh": "Economics explains how consumers, producers, and the government make their best decisions based on the different constraints. Students can apply the theory of Economics to deal with their problems in real life.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解基本的經濟問題，供需原理，價格機能的運作及相關實例之應用。",
      "describe_en": "Comprehending fundamental economic problems, principles of supply and demand, operations of price mechanism and applications."
    },
    {
      "seq": 2,
      "describe_ch": "理解理性的消費者如何在預算限制下從事選擇。",
      "describe_en": "Comprehending how rational consumers make choices under budget constraints."
    },
    {
      "seq": 3,
      "describe_ch": "理解廠商的生產理論，及短期與長期成本理論。",
      "describe_en": "Comprehending firm's production theory and the short-run and long-run cost theories."
    },
    {
      "seq": 4,
      "describe_ch": "理解不同的市場結構，及廠商的訂價行為。",
      "describe_en": "Comprehending alternative market structures, and firm's pricing behavior."
    }
  ],
