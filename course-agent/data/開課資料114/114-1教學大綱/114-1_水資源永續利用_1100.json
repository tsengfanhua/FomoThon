  "description": {
    "sub_id3": null,
    "sub_name": "水資源永續利用",
    "sub_ename": "SUSTAINABLE UTILIZATION OF WATER RESOURCES",
    "describe_ch": "水資源對於人類發展扮演了重要角色，為兼顧社會發展及環境永續，有必要以多元化方式開發新水源因應，本課程將從水源(氣候變遷之影響)、需求(用水需求估計)、操作(水資源調配)及管理(智慧水資源管理及專案管理)等多面向進行探討，並透過多元化水資源工程參觀及實務案例分享，掌握目前水資源永續利用推動情形，期使同學瞭解水資源相關理論、模擬與應用方式，廣收研習效果。",
    "describe_eh": "Water resources play an important role for human social development. In order to take into account social development and environmental sustainability, it is necessary to develop new water sources in a diversified way. This course will discuss various aspects such as water source (impact of climate change), demand (estimation of water demand), operation (water resource allocation) and management (smart water resource management and project management). Through diversified water resources engineering visits and practical case sharing, we can grasp the current promotion of sustainable water resources utilization, and hope that students can understand water resources related theories, simulations and application methods, and gain a wide range of study results.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解標的用水需求如何估算\t",
      "describe_en": "Understanding how to estimate the water demand."
    },
    {
      "seq": 2,
      "describe_ch": "掌握水資源調配模式操作與分析\t",
      "describe_en": "Realizing the operation and analysis of water resources allocation model."
    },
    {
      "seq": 3,
      "describe_ch": "了解氣候變遷下水資源衝擊分析步驟與多元化水資源開發工程",
      "describe_en": "\tUnderstanding the steps of water resource impact analysis and diversified water resource development projects under climate change"
    },
    {
      "seq": 4,
      "describe_ch": "理解水資源系統思考與專案管理\t",
      "describe_en": "Realizing water resources systems thinking and project management"
    }
  ],
