  "description": {
    "sub_id3": null,
    "sub_name": "運輸學",
    "sub_ename": "TRANSPORTATION",
    "describe_ch": "海空運、公路、鐵路以及都市大眾運輸之介紹，主要授課內容為：交通運輸基本概念、交通運輸系統及公路交通行政組織、公路運輸之經營與管理、鐵路運輸系統、鐵路運輸事業經營與管理、都市大眾運輸系統、航空運輸系統之經營與管理。",
    "describe_eh": "This course provides an introduction to the highway, railway, and urban public transportation. The main topics covered in this course include the basic concepts of transportation, the operations and management of highway transportation, railway transportation, urban public transportation, marine transportation, and air transportation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.\t教授各運輸或物流系統之特性與相關基本概念",
      "describe_en": "1.Introduce the characteristics and basic concepts of transportation or logistics systems."
    },
    {
      "seq": 2,
      "describe_ch": "2.\t教授各運輸或物流系統之規劃、設計理論與實務概念",
      "describe_en": "2.Teaches the theoretical and practical concepts of planning and design for various transportation or logistics systems."
    },
    {
      "seq": 3,
      "describe_ch": "11.\t培養學生獨立或透過團隊合作解決專業問題之能力",
      "describe_en": "11.To develop students' ability to solve professional problems independently or through teamwork."
    }
  ],
