  "description": {
    "sub_id3": null,
    "sub_name": "明渠水力學",
    "sub_ename": "OPEN CHANNEL HYDRAULICS",
    "describe_ch": " 明渠流發生在一般常見的排水渠道中，本課程將分四個部分分析明渠流之運動機制，並特別強調其計量方法。四個部分包括：利用比能概念定義臨界水深，並解析渠道突變段之影響；均勻流之水理特性，及其阻力方程式之建構與應用；定量緩變流理論，及其水面線之推算(HEC-RAS模式演算)；水躍之控制方程式及其應用。",
    "describe_eh": "The course contains four parts, which emphasize computational method in open channelflow for specific tasks such as critical flow condition, resistance equations,\r\ngradually-varied flow profiles(HEC-RAS model routing), and hydraulic jumps\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 4.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1 描述明渠流特性 \t",
      "describe_en": "1. Describe the characteristics of open channelsflow"
    },
    {
      "seq": 2,
      "describe_ch": "2 理解均勻流特性並能模擬應用\t",
      "describe_en": "2.Apply the theorm of Uniform Flow (Manning'sformula) to infer discharge of open channels flow"
    },
    {
      "seq": 3,
      "describe_ch": "3 分析與推估定量緩變流明渠流水面線\t",
      "describe_en": "3. Analyze and infer the flow profile for Steady Gradually-varied Flows\r\n"
    },
    {
      "seq": 4,
      "describe_ch": "4 理解水躍之定義與模擬",
      "describe_en": "4. State the characteristics of Hydraulic Jump\t"
    }
  ],
