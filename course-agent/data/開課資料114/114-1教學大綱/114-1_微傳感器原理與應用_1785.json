  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "微傳感器原理與應用",
    "sub_ename": "PRINCIPLES AND APPLICATIONS OF MICROTRANSDUCERS",
    "describe_ch": "介紹如何利用微機電技術製作各種不同類型之微傳感器，如微感測器以及微致動器。透過工程上的設計教學以及介紹目前傳感器的應用範例，比較不同製作方式之微傳感器的性能與規範，使學生了解學習並了解工業上微傳感器的元件設計及製作方式。",
    "describe_eh": "This course teaches an overview of the field, beginning with MEMS techniques approaches and including all major categories of microtransducers such as microsensor and microactuator. It examines the fabrication of individual devices through the study of design issues and provides examples of key transducers, or structures, for comparison of performances obtainable through different approaches.",
    "pre_subname": "IECS2002電子學",
    "pre_sub_id3": "IECS2002",
    "pre_sub_ename": "IECS2002 ELECTRONICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1. 瞭解微傳感器之感測與致動原理的基本知識",
      "describe_en": "1. Understand the knowledge about the sensing and actuating principles of microtransducer."
    },
    {
      "seq": 2,
      "describe_ch": "2. 理解各式微傳感器的設計概念及其應用",
      "describe_en": "2. Comprehension for the design concept of microtransducer and its applications."
    }
  ],
