  "description": {
    "sub_id3": null,
    "sub_name": "保險監理制度",
    "sub_ename": "INSURANCE SUPERVISION SYSTEM",
    "describe_ch": "本課程討論保險監理的各項議題，這些議題包括保險業的清償能力、資訊揭露、費率監管、保單監管、消費者保護、法定資本、風險資本、我國保險業資本適足標準、國際會計準則17號、保險業自我清償能力評估、國際保險標準資本之訂定等相關議題，俾使學生能獲得實用之知識。",
    "describe_eh": "This course discusses a variety of functions related Insurance Supervision System. These function include Insolvency of Insurers, Information Disclosure, Rate Regulation, The regulation of policy forms, Protection of Consumers, Regulatory Capital, Capital at Risk, RBC, IFRS 17, Own Risk Solvency Assessment (ORSA), Insurance Capital Standard (ICS). The above topics hope to gain practical knowledge for students through teaching and discussion.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能獲悉保險監理理論、監理歷史",
      "describe_en": "To know the theories and history of insurance regulation."
    },
    {
      "seq": 2,
      "describe_ch": "能理解保險監理之範圍：清償能力、議價能力、費率管制、執照核發、公司經營、資金運用、準備金管制、保險費率等",
      "describe_en": "To comprehend the areas that are regulated: insurer insolvencies, insured bargaining, licensing of insurer, examination of insurer, regulation of investments, regulation of reserves, credit rating, corporate governance, taxation of insurer."
    },
    {
      "seq": 3,
      "describe_ch": "能獲悉保險監理機制：立法管制、司法管制、行政管制",
      "describe_en": "To know the mechanisms of regulation: legislative, justice, executive."
    }
  ],
