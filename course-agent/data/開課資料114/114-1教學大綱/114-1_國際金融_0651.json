  "description": {
    "sub_id3": null,
    "sub_name": "國際金融",
    "sub_ename": "INTERNATIONAL FINANCE",
    "describe_ch": "國際金融在探討國際收支、匯率的決定、經濟政策、匯率制度、通貨危機、最適通貨區域及匯率目標區域等開放經濟議題；課程目的在瞭解本國與世界其他國家維繫經濟活動的金融管道與政策效果。當今世界沒有任何一個國家能獨立於其他國家而生存，國際金融為當代基本的開放經濟學科。",
    "describe_eh": "International Finance explores the balance of payments, exchange rate determination, economic policies, international monetary system, currency crisis, optimal currency areas and exchange rate target zones etc. The aim of this course is to understand the financial channels and policy effects to fulfill economic activities between home country and the rest of the world. No country can survive independently to other countries in the current world, International Finance is the fundamental of open economics.",
    "pre_subname": "ECON3015貨幣銀行學、ECON8011總體經濟理論(二)、ECON7023國際金融專題研究",
    "pre_sub_id3": "ECON3015",
    "pre_sub_ename": "ECON3015 MONEY AND BANKING、ECON8011 MACROECONOMIC THEORY(2)、ECON7023 SPECIAL TOPICS ON INTERNATIONAL FINANCE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備開放經濟國際收支與外匯市場運作的基本知識",
      "describe_en": "Understanding the basic knowledge of the balance of payments and the operation of foreign exchange market in an open economy."
    },
    {
      "seq": 2,
      "describe_ch": "理解浮動匯率決定的基本原理",
      "describe_en": "Comprehending the basic principles of exchange rate determination."
    },
    {
      "seq": 3,
      "describe_ch": "應用開放經濟總體模型分析經濟政策效果",
      "describe_en": "Using the open macroeconomic model to analyze the effects of economic policies."
    },
    {
      "seq": 4,
      "describe_ch": "理解不同的匯率制度、通貨危機與通貨聯盟等議題",
      "describe_en": "Comprehending issues on alternatives of exchange rate system, currency crisis, and currency union etc."
    }
  ],
