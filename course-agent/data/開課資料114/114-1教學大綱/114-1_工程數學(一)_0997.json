  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(一)",
    "sub_ename": "ENGINEERING MATHEMATICS(1)",
    "describe_ch": "本課程之目的在於使學生熟悉各種常微分方程之解法及其物理與工程上之應用。課程內容主要包括一階常微分方程式、線性常微分方程、拉普拉斯轉換、向量分析基礎、複數分析基礎及線性代數前段。",
    "describe_eh": "The purpose of this curriculum lies in making the students acquaint with various kinds of ordinary differential equations： the solution curd into physical on engineering application. The curriculum contents the ordinary differential equation of the quiet order, the linear ordinary differential equation, Laplace Transformation, basic analyses of vector and complex, and first part of linear algebra.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識線性常微分方程之應用與解法。",
      "describe_en": "Knowing the applications and the solution methods of ordinary differential equations.\r\n"
    },
    {
      "seq": 2,
      "describe_ch": "理解拉普拉斯轉換、向量分析基礎及複數分析基礎。",
      "describe_en": "Comprehend the solution methods of the Laplace transformation, basic anslyses of vectors and complex."
    },
    {
      "seq": 3,
      "describe_ch": "應用教學分組提升團隊合作精神。",
      "describe_en": "Apply group-wise education such that spirit of team cooperation can be promoted."
    }
  ],
