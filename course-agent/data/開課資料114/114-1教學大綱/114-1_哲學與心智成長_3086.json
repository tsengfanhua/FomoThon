  "description": {
    "sub_id3": null,
    "sub_name": "哲學與心智成長",
    "sub_ename": "PHILOSOPHY AND MENTAL GROWTH",
    "describe_ch": "本課程引導學生認識哲學家的偉大心靈與道德典範，啟發學生對思想與內在價值的思考與反省，經由當代重要哲學議題的介紹與討論，訓練合乎邏輯的思考能力，並透過不同的哲學命題，進而延伸至日常生活的相關課題，讓學生思考、討論與分享個人的獨特想法，分析其條理，綜合其脈絡，培養獨立思考的能力。引導學生理解正義、道德、智慧、美感等哲學真義，建立服務社群的情操與高尚的人生觀，使這些人生課題的可能答案顯現清楚的輪廓。",
    "describe_eh": "This course guides students to understand the great spiritual and moral paradigms of philosophers, inspires students to think and reflect on ideas and intrinsic values, and trains logical thinking skills through the introduction and discussion of important contemporary philosophical issues, and through different philosophical propositions. It is extended to related topics in daily life, allowing students to think, discuss and share their unique ideas, analyze their structure, synthesize their context, and cultivate the ability of independent thinking. I will also guide students to understand the true meaning of philosophy, such as justice, morality, wisdom, and beauty, and establish a sentiment of serving the community and a noble outlook on life, so that the possible answers to these life issues can be clearly outlined.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "藉由哲人典範的轉移，培養獨立思考的能力。",
      "describe_en": "Cultivate the ability of independent thinking through the transfer of philosopher's paradigm."
    },
    {
      "seq": 2,
      "describe_ch": "培養整全的人生觀與解決問題的能力。",
      "describe_en": " Develop a holistic outlook on life and problem-solving skills."
    }
  ],
