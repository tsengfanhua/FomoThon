  "description": {
    "sub_id3": null,
    "sub_name": "大陸經貿法律專題研究",
    "sub_ename": "CHINA TRADE AND ECONOMIC LAW",
    "describe_ch": "研究中國大陸市場經濟主體組織法，包括（一）內資企業法律制度全民所有制工業企業法、集體所有制企業法、私營企業法（二）外商投資企業法、中外合資經營企業法、中外合作經營企業法、外資企業法（三）公司法。",
    "describe_eh": "This course is focuses on the introduction the organization Law of market economic in mainland china, include domestic enterprise Law：all people owner industries enterprise Law, collective owner enterprise law, private enterprise law. Foreign Investment enterprise Law & coporate law.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "探討大陸經貿相關議題。",
      "describe_en": "This course is focuses on the introduction the organization Law of market economic in mainland china"
    },
    {
      "seq": 2,
      "describe_ch": " 熟悉大陸對台法規並能分析相關法律問題",
      "describe_en": " Familiar with law and regulations on Taiwanese business in PRC, capable to identify and analysis relevant legal issues."
    },
    {
      "seq": 3,
      "describe_ch": "了解大陸對外貿易管理、外商投資、銀行及智慧財產權法規",
      "describe_en": "Understand PRC's law and regulations on international trade, foreign investments, banking and finance, as well as patent and trademark law."
    }
  ],
