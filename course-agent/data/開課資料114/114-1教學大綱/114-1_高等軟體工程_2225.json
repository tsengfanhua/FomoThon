  "description": {
    "sub_id3": null,
    "sub_name": "高等軟體工程",
    "sub_ename": "ADVANCED SOFTWARE ENGINEERING",
    "describe_ch": "本課程的目的在使學生學習軟體工程的技術、方法與理論。本課程主要的內容包含軟體專案管理、需求工程、軟體架構設計、軟體設計、物件導向軟體設計、軟體測試、軟體構型管理與軟體流程模型等。透過本課程的學習，學生將會瞭解如何以工程的方式來開發一個系統。",
    "describe_eh": "The aim of this course is to leaning software engineering technologies, methodologies and theories. The course mainly contains software project management, requirement engineering, software architecture design, software design, software testing, software configuration management and process models. After this course, students can learn how to develop a software system by an engineering approach.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解需求工程、軟體設計、軟體測試等軟體工程進階的技術與方法\t",
      "describe_en": "Understand the advanced approaches of requirements engineering, software design, and software testing in the software engineering area."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解目前軟體工程相關研究議題並進行議題之分析。\t",
      "describe_en": "Understand the current research issues in software engineering."
    }
  ],
