  "description": {
    "sub_id3": null,
    "sub_name": "測量學",
    "sub_ename": "SURVEYING",
    "describe_ch": "藉由課程的講授介紹測量學的基本知識與誤差理論，說明測量工作操作方法及使用的基本儀器，各種測量內外業的實施方式，並說明實際測量作業方法及現代新儀器，使學生熟悉與瞭解土地測量的方法及應用技術。",
    "describe_eh": "Primarily for sophomore students at the college level, the course gives basic concepts and practical material in each of the areas fundamental to modern surveying practice. The contents are composed of definition of Surveying, theory of errors in observations, leveling, distance measurement, traversing and computation, Global Positioning System, construction surveys (horizontal and vertical curves), photogrammetry, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解測量原理、作業技術及誤差傳播定律",
      "describe_en": "To know the principles, operation techniques, and law of error propagation of the surveying"
    },
    {
      "seq": 2,
      "describe_ch": "熟練各種測量儀器之操作",
      "describe_en": "To understand how to operate the surveying instruments"
    },
    {
      "seq": 3,
      "describe_ch": "能利用測量數據計算座標成果",
      "describe_en": "To utilize the surveying of field work data to calculate the coordinates of point"
    }
  ],
