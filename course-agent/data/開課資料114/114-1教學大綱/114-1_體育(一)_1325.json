  "description": {
    "sub_id3": null,
    "sub_name": "體育(一)",
    "sub_ename": "PHYSICAL EDUCATION(1)",
    "describe_ch": " 落實「以強化學生基本體能並建立基礎運動知識」之體育教學宗旨，授課內容如下：（一）游泳課程─同時段依學生游泳能力進行分級分組協同教學。（二）陸上運動課程─依教師專長項目教學，每專項單元授課兩週，循序轉換。",
    "describe_eh": "In order to implement the goal of physical education, enhance students' basic strength condition and help them build up the fundamental knowledge of exercise. (1) Swimming course - Divide into groups in grades in coordination with teaching in a section of ability of swimming in accordance with students at the same time. (2) Field course - Base on teacher's specialty project in teaching, every project unit gives lessons for two weeks, change in a proper order.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "廣植基礎健康體適能，厚實游泳基本能力，養成規律運動習慣。",
      "describe_en": "To promote basic physical health and fitness, to enhance students basic swimming skills, make it a habit to exercise regularly"
    }
