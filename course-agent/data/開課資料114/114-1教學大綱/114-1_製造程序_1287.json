  "description": {
    "sub_id3": null,
    "sub_name": "製造程序",
    "sub_ename": "MANUFACTURING PROCESSES",
    "describe_ch": "本課程含蓋產品設計考量、基本材料性質、基本製造原理、與電腦輔助製造等技術，對提升工業技術水準具有密切的關係。",
    "describe_eh": "The objectives of this course focus on manufacturing processes, interrelationship of product design, material properties, and processing methods, robotics and CAM systems; key factors in material, process, and equipment selection.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解材料基本特性。",
      "describe_en": "Understand the properties of materials."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解材料去除加工法與相關機器。",
      "describe_en": "Understand the material removal processes and machines."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解金屬鑄造加工與設備。",
      "describe_en": "Understand the metal-casting processes and equipments."
    }
  ],
