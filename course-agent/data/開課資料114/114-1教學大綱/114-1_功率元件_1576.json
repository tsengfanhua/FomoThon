  "description": {
    "sub_id3": null,
    "sub_name": "功率元件",
    "sub_ename": "POWER DEVICES",
    "describe_ch": "這課程的目的是使學生了解功率元件的特性及應用電路,一般電子學所學的元件均使用在較低電流低耐壓的範圍,此課程讓學生了解元件操作在高功率的原理,課程中除會對目前常見的功率元件做一介紹,亦將元件的設計做一個初步的介紹。",
    "describe_eh": "The objective of this course is to demonstrate the power devices performances and their application to students. Most devices students studied are low current, low voltage device before. This course make students know the high power devices, which use at high power area. We will introduce the several power devices as well as their design to students.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道高功率半導體元件中，何謂保護環設計與高壓、高電流元件特性。",
      "describe_en": "Knowledge for High Power Semiconductor devices with guard ring design and high voltage and high current characteristics."
    },
    {
      "seq": 2,
      "describe_ch": "理解各種高壓元件的參數特性及相對應設計。",
      "describe_en": "To comprehend all kinds of high voltage devices characteristics and their designs."
    },
    {
      "seq": 3,
      "describe_ch": "理解各種高壓元件的製作",
      "describe_en": "To comprehend the fabrication of all kinds of high voltage devices."
    }
  ],
