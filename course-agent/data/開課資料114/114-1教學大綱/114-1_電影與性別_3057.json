  "description": {
    "sub_id3": null,
    "sub_name": "電影與性別",
    "sub_ename": "MOVIES AND GENDERS",
    "describe_ch": "本課程旨在透過電影的觀賞與討論去認識與討論不同的性別議題。本課程的進行方式將由授課教師針對每週主題進行講解, 輔以影片觀賞。透過引導學生討論的方式, 讓學生能培養影視作品解讀能力, 並從中理解不同的性別議題, 諸如：性別角色的媒體建構與再現, 跨性別的自我認同等等。此外, 本課程希望能訓練學生透過影視作品的製作形式, 提出對不同性別議題的自我觀點。",
    "describe_eh": "This course offers students to approach and discuss different gender issues through film appreciation and discussions. The instructor will give the explanations after watching a movie and cultivate students’ interpretation abilities to movies, and understand different gender issues, e.g., the media construction and reappear of the gender roles and transgender self-identity. Besides, hope to train the students to have their own point of views on different gender issues through a movie production.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "協助學生了解電影敘事風格、文本分析方法與影片製作技巧。",
      "describe_en": "To assist students in understanding film narrative style, text analysis methods and video production skills."
    },
    {
      "seq": 2,
      "describe_ch": "透過電影賞析與影片製作，協助學生分析不同性別議題。",
      "describe_en": "To assist students in analyzing different gender issues through film appreciation and video production."
    }
  ],
