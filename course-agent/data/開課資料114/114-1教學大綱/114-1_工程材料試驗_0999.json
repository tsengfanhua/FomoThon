  "description": {
    "sub_id3": null,
    "sub_name": "工程材料試驗",
    "sub_ename": "ENGINEERING MATERIALS LABORATORY",
    "describe_ch": "由於土木建築對於混凝土使用頻率非常高，因此本課程著重於混凝土材料品質控制，再配合試驗，期讓同學了解期物理、力學性質及標準試驗過程，達到理論與實際相配合。",
    "describe_eh": "Focus on the quality control of concrete materials and test. To make the students familiar with their chemical, physical and mechanical characters, we expect experiments which go with the theories.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解工程材料基本的力學、物理及化學性質。",
      "describe_en": "Comprehension for the properties of fundamental mechanics, physics and chemistry of civil materials."
    },
    {
      "seq": 2,
      "describe_ch": "能理解混凝土材料之品質控制。",
      "describe_en": "Comprehension for the quality control of concrete materials."
    },
    {
      "seq": 3,
      "describe_ch": "能設計及計算混凝土之配比。",
      "describe_en": "Be able to design and calculate concrete mixture."
    }
  ],
