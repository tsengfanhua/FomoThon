  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(一)",
    "sub_ename": "ENGINEERING MATHEMATICS(1)",
    "describe_ch": "本課程主要在教導學生如何將科學或工程上的問題用數學方法來表示，提升學生數學思考與分析的能力。課程的內容主要包含常微分方程式求解、拉普拉斯轉換與常微分方程式之冪級數解等主題。",
    "describe_eh": "The main objective of this course is to teach students how to describe scientific and engineering problems using mathematical methods and to promote students' mathematical thinking and analysis abilities. The course contents include solution of ordinary differential equations, Laplace transform and series solution of ordinary differential equations.",
    "pre_subname": "MATH1005微積分(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
