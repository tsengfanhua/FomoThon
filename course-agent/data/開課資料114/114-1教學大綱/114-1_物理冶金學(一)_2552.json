  "description": {
    "sub_id3": null,
    "sub_name": "物理冶金學(一)",
    "sub_ename": "PHYSICAL METALLURGY(1)",
    "describe_ch": "解釋基本的冶金現象、確定商用合金的成份和性質學習金屬製造的原理是本課程的學習目標。課程中將介紹金屬材料晶體結構、差排理論、空位，以及差排與塑性變型之間的關係有完整的說明，並針對金屬材料中各種活化能的物理意義與成長動力學的行為作系統性的論述。",
    "describe_eh": "Explaining basic metallurgical phenomena, identifying the compositions and properties of commercial alloys, and learning the principles of metal manufacturing are the goals of this course. This course will explain the crystal structure of metal materials, dislocation theory, vacancy, and the relationship between dislocations and plastic deformation. There will be a complete description and explanation for the physical meaning of various activation energies and the behavior of growth dynamics in metal materials.",
    "pre_subname": "MSE1000材料科學導論(一)",
    "pre_sub_id3": "MSE1000",
    "pre_sub_ename": "MSE1000 INTRODUCTION TO MATERIALS SCIENCE(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "定義與講解金屬的構造及分析各種晶體的方法與內部結構。",
      "describe_en": "Define and explain the structure of metals, and to analyze all kinds method of crystals the structure in the material."
    },
    {
      "seq": 2,
      "describe_ch": "理解差排導論及其原理，並更進一步在塑性變形方面運用差排原理。",
      "describe_en": "Understand for the introduction of dislocations and its principle and further to use the principle of dislocation in the respect of plasticity out of shape."
    },
    {
      "seq": 3,
      "describe_ch": "比較晶界的特性和形成之原理，瞭解晶界的重要性，並分辨各種不同的晶界。",
      "describe_en": "Compare the characteristic of the brilliant circle and principle formed, the importance to understand brilliant circle, and distinguish all kinds of grain boundary."
    },
    {
      "seq": 4,
      "describe_ch": "了解並評量材料內部的空孔行為、影響、能量，以及對材料的重要性。",
      "describe_en": "Understand and evaluation empty hole behavior, influencing, energy within materials, and the importance to the material."
    }
  ],
