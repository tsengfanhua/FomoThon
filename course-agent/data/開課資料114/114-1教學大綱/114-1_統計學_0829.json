    "scr_dup": "001",
    "sub_title": "統計學在商業上的運用",
    "sub_title_en": null,
    "sub_describe": "本課程設計適合統計初學者，用電腦工具取代了繁雜的數學公式，直接從範例來介紹敘述統計與推論統計的基本工具，強化「解讀資料的價值」，希望這本書能改變大家對統計的刻板印象，達到數字教育的目標。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "統計學",
    "sub_ename": "STATISTICS",
    "describe_ch": "統計學為統計入門課程，從機率概念由淺入深導引學生進入基本統計概念，了解抽樣分配與估計的演算與運用，主題包括資料整理、機率概念、常用之機率分配、抽樣分配、與點估計。",
    "describe_eh": "Statistics is the first introductory course in which this course starts from the concepts of probability to elementary statistics in order to understand the computation of sampling distribution as well as estimation methods. The topics that include data management, probability concept, some common probability distributions, sampling distribution, and poit estimations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道何謂統計學之應用與敘述統計學",
      "describe_en": "To know statistical applications, and descriptive statistics."
    },
    {
      "seq": 2,
      "describe_ch": "知道機率分配函數及其用法",
      "describe_en": "To know some probability distribution functions and its applications."
    },
    {
      "seq": 3,
      "describe_ch": "知道抽樣、抽樣分配及點估計",
      "describe_en": "To know the sampling process, sanpling distribultions and point estimation."
    }
  ],
