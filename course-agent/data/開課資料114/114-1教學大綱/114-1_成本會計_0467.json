  "description": {
    "sub_id3": null,
    "sub_name": "成本會計",
    "sub_ename": "COST ACCOUNTING",
    "describe_ch": "本課程介紹成本觀念，成本程序與會計原則，成本彙整、計算與綜合報表，藉此建立成本管理決策的基本資訊。主要內容包括：成本流程及報表；分批成本法；分步成本法；損壞品、聯產品、副產品的會計處理；以及材料、人工、製造費用的分配與控制的方法。",
    "describe_eh": "The course deals with cost concepts, cost accounting principles, process, and integrated accounts, which provides key data to managers for planning and controlling, as well as data on costing products, services, and customers. Topics include introduction to cost accounting, cost concepts, cost accounting for materials, labor and overhead, job costing, process costing, spoilages, joint products, and by-products, additionally, methods of cost allocating and controlling for three cost elements: materials, labor and factory overhead",
    "pre_subname": "ACCT1011會計學(一)、ACCT1012會計學(二)",
    "pre_sub_id3": "ACCT1011",
    "pre_sub_ename": "ACCT1011 ACCOUNTING(1)、ACCT1012 ACCOUNTING(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解成本會計概念與成本會計制度　",
      "describe_en": "Comprehension for concepts of cost accounting and systems."
    },
    {
      "seq": 2,
      "describe_ch": "能應用成本累積方法去計算產品成本",
      "describe_en": "Application for methods of cost accumulation for cost objects."
    },
    {
      "seq": 3,
      "describe_ch": "能應用會計處理原則與程序完成製造業會計。",
      "describe_en": "Application for accounting polices and procedures in a manufacturing business."
    }
  ],
