  "description": {
    "sub_id3": null,
    "sub_name": "嵌入式系統設計與實務",
    "sub_ename": "EMBEDDED SYSTEM DESIGN AND PRACTICE",
    "describe_ch": "本課程目的在於訓練研究生整合計算機系統軟硬體整體觀念，培養學生對於嵌入式系統與即時系統的瞭解認識，進而訓練學生實際應用與設計嵌入式系統。課程介紹將由系統硬體與系統軟體兩方面著手，並適時介紹即時作業系統觀念與排程技術。本課程將要求學生分組實際規劃與完成一個嵌入式系統應用專案。",
    "describe_eh": "This course is aimed to give a practical training on the integrated design of computer system hardware and software. And, also in this course, the concepts regarding embedded systems and real time operating systems, especially on real time scheduling are introduced. Finally, the students should finish a practical term project for each project group.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "教導學生嵌入式系統設計的基本概念、硬體平台、即時作業系統、和嵌入式程式設計的相關技術，以及案例的學習和實作。",
      "describe_en": "The content of this course consists of the technologies and applications of embedded systems concepts, hardware platform, real time operating systems and embedded programming with case studies for teaching students."
    },
    {
      "seq": 2,
      "describe_ch": "訓練學生歸納所學嵌入式系統知識，自行設計一個嵌入式系統。",
      "describe_en": "Train students to conclude their knowledge and then design their own embedded system applications."
    },
    {
      "seq": 3,
      "describe_ch": "以書面及口頭方式將各自設計的嵌入式系統結果與同儕、助教及教師共同討論，並評定其優缺點。",
      "describe_en": "Discuss the embedded system applications proposed by each groups in paper work and oral presentation with classmates, teaching assistants, and the instructor. And then judge their advantages and drawbacks."
    }
  ],
