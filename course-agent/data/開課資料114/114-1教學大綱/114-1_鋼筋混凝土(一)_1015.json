  "description": {
    "sub_id3": null,
    "sub_name": "鋼筋混凝土(一)",
    "sub_ename": "REINFORCED CONCRETE(1)",
    "describe_ch": "本課程教導學生如何去設計鋼筋混凝土構材。課程內容包含 (1) 基本材料行為的認識，(2) 設計規範與設計方法的介紹，(3) 樑之撓曲與剪力的設計，(4) 樑之使用性能的探討，(5) 鋼筋之握裹力，伸展長及續接。\r\n",
    "describe_eh": "This course introduces students how to design reinforced concrete members. The contents of the course are: (1) fundamental material behaviors of concrete and steel reinforcement; (2) introductions to the ultimate strength design method and the ACI Building Codes; (3) flexural and shear designs of reinforced concrete beam; (4) serviceability of reinforced concrete beam; (5) bond stresses，development length and splices of reinforcing bars.\r\n",
    "pre_subname": "CE2078材料力學",
    "pre_sub_id3": "CE2078",
    "pre_sub_ename": "CE2078 MECHANICS OF MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉鋼筋混凝土樑的撓曲分析與設計。",
      "describe_en": "To be familiar with flexural design of a reinforced concrete beam"
    },
    {
      "seq": 2,
      "describe_ch": "探討樑構材使用性能。",
      "describe_en": "To investigate the serviceability of reinforced concrete beams"
    },
    {
      "seq": 3,
      "describe_ch": "熟悉鋼筋混凝土樑的剪力設計。",
      "describe_en": "To be familiar with shear design of a reinforced concrete beam"
    },
    {
      "seq": 4,
      "describe_ch": "認識鋼筋之握裹力、伸展長，續接的應用及單向版的設計。",
      "describe_en": "To understand the bond stresses， development length of reinforcing bars，applications to bar splices and design of one-way slab\n"
    }
  ],
