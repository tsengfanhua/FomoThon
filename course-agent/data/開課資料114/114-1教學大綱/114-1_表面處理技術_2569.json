  "description": {
    "sub_id3": null,
    "sub_name": "表面處理技術",
    "sub_ename": "SURFACE TREATMENT & TECHNIQUE",
    "describe_ch": "表面處理技術為傳統金屬工業與半導體產業中的關鍵技術。經由學習此技術背後之理論，了解真空系統、表面科學之物理與化學性質、電鍍技術、物理蒸鍍與化學蒸鍍以及表面分析技術等技術。此課程以學習表面處理技術之內容與理論為主，並可連結至未來就業面中。",
    "describe_eh": "Surface treatment technology is a key technology in both traditional industry and the semiconductor industry. Through learning the theory behind this technology, students will understand the vacuum system, the physical and chemical properties of surface science, electroplating technology, physical vapor deposition (PVD) and chemical vapor deposition (CVD), as well as surface analysis technology. This course focuses on teaching the content and theory of surface treatment technology and is aimed to increase the connection between the students and their future employment.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解各種不同材料特性，選擇適當的表面處理技術。",
      "describe_en": "Understand the properties of various materials and choose appropriate surface treatment technologies."
    },
    {
      "seq": 2,
      "describe_ch": "由表面處理技術反應機構，相關物理化學基礎，思考解決問題方法。",
      "describe_en": "Think about ways to solve problems based on surface treatment technology reaction mechanisms and related physical and chemical foundations."
    },
    {
      "seq": 3,
      "describe_ch": "認識鍍層為結構分析，性質檢驗、膜厚量測及藥液管理。",
      "describe_en": "Understand that coating includes structural analysis, property inspection, film thickness measurement and chemical solution management."
    },
    {
      "seq": 4,
      "describe_ch": "注重現塲操作安全與廢液處理。",
      "describe_en": "Pay attention to local operation safety and waste liquid disposal."
    }
  ],
