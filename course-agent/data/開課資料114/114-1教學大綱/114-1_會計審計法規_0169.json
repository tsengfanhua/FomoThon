  "description": {
    "sub_id3": null,
    "sub_name": "會計審計法規",
    "sub_ename": "ACCOUNTING AND AUDITING LAW",
    "describe_ch": "1.瞭解政府預算、會計、決算、審計之相關法令。\r\n2.奠定政府會計實務之基礎。\r\n3.讓學子具備公務人員應具備之會計與審計法律知識。\r\n",
    "describe_eh": "1. Understood government budget, accounting, final accounts and audited.\r\n2. Establish a foundation of the government  accounting practice.\r\n3. Let the student have the accounting whom the government functionary should have and audit law knowledge.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能描述會計審計法令之觀念性架構。",
      "describe_en": "Describe the use of the idea structure  the law of accounting and auditing"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解並能用自己的詞彙定義會計審計法令之基本要素及假設",
      "describe_en": "Understand and define the basic element and assumption of the law of accounting and auditing with one's own vocabulary"
    },
    {
      "seq": 3,
      "describe_ch": "能辨認會計審計法令之內涵及特性。",
      "describe_en": "Recognize the intension and characteristic of the law of accounting and auditing"
    }
  ],
