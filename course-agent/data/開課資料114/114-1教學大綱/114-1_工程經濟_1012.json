  "description": {
    "sub_id3": null,
    "sub_name": "工程經濟",
    "sub_ename": "ENGINEERING ECONOMICS",
    "describe_ch": "本課程之主要目的乃提供工程背景學生，對於工程經濟之基本原則、觀念與方法論有明確之認知。課程內容則根基於完整的貨幣時間價值之概念，介紹投資方案的經濟規劃與各式評估分析方法，及一般決策分析的原則與流程，以建立系統化之計量決策模式，建立大型工程專案之評估能力。",
    "describe_eh": "Modern engineers in their career development are often involved in various management roles or decisions. Technical knowledge alone is not enough for engineers in today's complex and dynamic environment. Engineers need to know how to analyze the industry and economy, and how to quantitatively evaluate an engineering project and select a best alternative.  This course introduces the basic concepts of Economics and Accounting suitable for engineering economic analysis, and to familiarize students with fundamental quantitative analytical techniques for evaluating large engineering projects.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解貨幣時間價值與等值觀念",
      "describe_en": "Comprehension for the Money-Time Relationships and Equivalence"
    },
    {
      "seq": 2,
      "describe_ch": "理解如何評估工程專案並選擇最佳候選方案",
      "describe_en": "Comprehension for evaluation of an engineering project and selection of the best alternative"
    },
    {
      "seq": 3,
      "describe_ch": "應用一般之決策方法與技術進行工程財務決策",
      "describe_en": "Application of common decision-making methods and techniques to the financial decision task"
    }
  ],
