  "description": {
    "sub_id3": null,
    "sub_name": "環境流行病學",
    "sub_ename": "ENVIRONMENTAL EPIDEMIOLOGY",
    "describe_ch": "流行病學是公共衛生與臨床醫學的基礎。本課程第一部分先建立學生對環境流行病學的基本術語、觀念與方法之理解，第二部分透過研讀文獻來認識環境職業流行病學的研究設計觀念與實際案例, 並以小組學習方式，提升學生主動學習與團隊合作之能力。",
    "describe_eh": "Epidemiology is the foundation of public health and clinical medicine. The first part of the course establishes students' understanding of basic terminology, concepts and methods of environmental epidemiology. The second part is to provide the research design concepts and practical cases of environmental and occupational epidemiology through research literature. And team-based learning (TBL) will be adopted to enhance students' ability in learning actively, as well as teamwork and group discussion.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的辭彙解釋環境流行病學的基本觀念",
      "describe_en": "Describe and explain basic concepts regarding environmental epidemiologic methods and study design"
    },
    {
      "seq": 2,
      "describe_ch": "能理解並說明疾病發生的自然史",
      "describe_en": "Comprehend and explain the natural history of disease"
    },
    {
      "seq": 3,
      "describe_ch": "使用環境流行病學方法計算疾病的可能因子及評估可能的高危險群\t",
      "describe_en": "Understand how environmental epidemiology is used for calculating the causes of disease and identifying populations at high risk for particular diseases"
    }
  ],
