  "description": {
    "sub_id3": null,
    "sub_name": "微積分",
    "sub_ename": "CALCULUS",
    "describe_ch": "本課程介紹微積分與管理數學的觀念，課程內容極限、微分、積分、泰勒級數，向量與矩陣、線性規劃等。",
    "describe_eh": "This course introduces the concepts of calculus and managerial mathematics, including finding limits, performing differentiation and integration, finding Taylor series of a function, the operation of vectors and matrices, and solving linear systems and linear programming problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解單變數實數值函數之極限、導數、積分及級數定義，並建立相關定理，從中訓練學生數學分析能力。",
      "describe_en": "Comprehend the limit of a function, the definitions of derivative and integration, and establish relative theory.  Students are trained for the abilities of mathematical analysis."
    },
    {
      "seq": 2,
      "describe_ch": "理解基本函數極限、連續、導數及積分之運算規則，並使學生熟練運算技巧。",
      "describe_en": "Comprehend the laws of limit , continuity and differentiation, and help students to master relative skills."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解矩陣運算及線性方程系統之解法。",
      "describe_en": "Comprehend the operation of vectors and matrices and the solution of a linear system."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解線性規劃之解法。應用線性規劃求解處理相關最佳化問題等。",
      "describe_en": "Comprehend the solution of linear programming problems. Be able to formulate optimization problems by linear programming techniques and solve the linear programming problems."
    }
  ],
