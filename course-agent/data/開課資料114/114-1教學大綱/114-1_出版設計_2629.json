  "description": {
    "sub_id3": null,
    "sub_name": "出版設計",
    "sub_ename": "PUBLISHING DESIGN",
    "describe_ch": "傳統出版工作已逐漸由數位流程取代，從平面印刷轉型為電子報、電子書或其他以網路為主要流通管道之媒體。以此背景為基礎，本課程著重設計理念及出版技巧之發展與創新。",
    "describe_eh": "Traditional graphic publishing operations have changed to digital publishing, from graphic printing to electronic newspapers or e-books. This course aims to let students understand the workflow and basic skills of digital graphic publishing operations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
