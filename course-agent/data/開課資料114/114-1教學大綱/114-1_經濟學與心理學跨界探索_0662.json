  "description": {
    "sub_id3": null,
    "sub_name": "經濟學與心理學跨界探索",
    "sub_ename": "AN INTERDISCIPLINARY EXPLORATION OF ECONOMICS AND PSYCHOLOGY",
    "describe_ch": "本課程應用經濟學與心理學理論來解析人的行為，包括人的理性、經濟人與心理人、快樂與主觀的福祉、上癮行為、犯罪行為、人力資本投資、個人與家庭、工作與休閒、經濟發展與心理健康等面向。",
    "describe_eh": "The course applies concepts and theories from economics and psychology in understanding a broader aspects of human behavior, which covers topics of human rationality, “economic man” and “psychological man,” happiness and subjective well-being, addictive behavior, crime, investment in human capital, individual and family, work and leisure, and economic development and mental health.",
    "pre_subname": "ECON1001經濟學(一)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "提昇應用經濟學理解人的多面向行為的能力",
      "describe_en": "To enhance the capability of applying economics in understanding many dimensions of human behavior."
    },
    {
      "seq": 2,
      "describe_ch": "從經濟學的角度理解人的心理層面",
      "describe_en": "To understand psychological aspects of human being from economics perspective."
    },
    {
      "seq": 3,
      "describe_ch": "提昇人際互動與人際能力",
      "describe_en": "To enhance interpersonal skill."
    }
  ],
