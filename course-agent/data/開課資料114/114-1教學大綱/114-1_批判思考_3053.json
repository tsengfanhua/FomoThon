  "description": {
    "sub_id3": null,
    "sub_name": "批判思考",
    "sub_ename": "CRITICAL THINKING",
    "describe_ch": "批判思考通常是大學生的基本能力之一。本課程將著重在理論與日常生活運用的結合，除了訓練基本論證推理，批判性思考的技能之外，將密集要求學生蒐集報告雜誌，新聞事件中相關的邏輯推理或批判思考的案例，課堂間練習運用理論自行分析，師生間相互討論、學思並進，以達到靈活運用的目的。",
    "describe_eh": "The critical thinking is the one of basic capacities for university students. This course focuses the connection between theory and ordinary life. We discipline students with logical reasoning, critical thinking, and expect students to glean cases from newspaper or any media. In case-analysis, we discuss each other to promote critical thinking.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "明白什麼是當前的議題, 並豐富多元思考的能力",
      "describe_en": "Understand what the current topic is and enrich the ability to think diversely"
    },
    {
      "seq": 2,
      "describe_ch": "辨別什麼是合理的論證, 並增進清晰論述的能力",
      "describe_en": "Discern what constitutes a reasonable argument and improve the ability to make a clear discourse"
    }
