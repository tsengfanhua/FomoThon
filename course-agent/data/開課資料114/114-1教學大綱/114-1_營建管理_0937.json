  "description": {
    "sub_id3": null,
    "sub_name": "營建管理",
    "sub_ename": "CONSTRUCTION MANAGEMENT",
    "describe_ch": "集合管理中質的概念與量的技術應用在土木工程教育中併合管理與技術系統，並考慮社會與經濟對土木工程人員的需求訓練出負責任的專業經理人。",
    "describe_eh": "Combine the concept of quality in the management and quantity in the application of technology applying to the civil engineering education to form a unified management and technology system. Furthermore, considering the social and economics influence to the requirement of civil engineer it is our aim to train a high responsible expert manager for a construction project.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識土木工程涵概之範疇",
      "describe_en": "To know overall the fields of civil engineering."
    },
    {
      "seq": 2,
      "describe_ch": "認識土木工程各領域相關知識",
      "describe_en": "To know the fundamental concepts of the structural, geotechnical, architectural, hydraulic engineering."
    },
    {
      "seq": 3,
      "describe_ch": "認識土木工程相關應用",
      "describe_en": "To know the applications in civil engineering."
    },
    {
      "seq": 4,
      "describe_ch": "培養土木工程的學習與研究興趣",
      "describe_en": "To develop the interests in civil engineering."
    }
