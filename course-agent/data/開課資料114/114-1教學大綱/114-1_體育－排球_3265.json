  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "XD01111",
    "sub_id": "99140",
    "scr_dup": "002",
    "tpa_score_new": "<div>一期中術科肩上發球測驗30% 二、期末術科分組比賽測驗40% 三、平時表現及點名40%</div>\n",
    "tpa_score_new_en": " ",
    "course_pol": "上課服裝規定\n服裝穿著運動服裝、運動鞋，勿穿休閒衣服、牛仔褲、休閒鞋。\n方便排球課程可穿著短褲，流汗可攜帶衣服替換。",
    "course_pol_en": null,
    "course_rem": "課堂可帶礦泉水，勿帶食物/飲料等。\n使用上課器材完畢請歸位\n課程結束請幫忙清理場地",
    "course_rem_en": null,
    "ais_meno": "<div>\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; font-family: Arial, 微軟正黑體, sans-serif; font-size: medium; background-color: rgb(245, 245, 245);\">學術誠信</p>\n\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; font-family: Arial, 微軟正黑體, sans-serif; font-size: medium; background-color: rgb(245, 245, 245);\">本課程教授學生以誠實、信任、公平、尊重、責任和勇氣為原則。</p>\n\n<p style=\"box-sizing: border-box; margin: 0px 0px 10px; font-family: Arial, 微軟正黑體, sans-serif; font-size: medium; background-color: rgb(245, 245, 245);\">在本課程中，秉持學術誠信的基本概念；包括抄襲、作弊、捏造及不當協同合作等重要議題，避免學生有不當的學術誠信行為。</p>\n</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": null
  },
