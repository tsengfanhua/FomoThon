  "description": {
    "sub_id3": null,
    "sub_name": "當代建築思辨與實踐",
    "sub_ename": "CONTEMPORARY ARCHITECTUAL THOUGHT AND PRACTICE",
    "describe_ch": "本課程的重點主要是以專題方式探討與解析當代建築的設計潮流、主要理論、建築大師和他們在世界各地的知名作品。另外，透過建築作品與理論的分析，去討論建築發展過程上的原則與方法。本課程不僅探討建築設計之背景涵構與地域文化的差異，更幫助同學瞭解背後的創意思考與理論方法。其有助於同學:\r\n(一) 建立能分析本土與國際性的案例之知識與原則。\r\n(二) 學習如何轉化原則並應用在建築設計、創意發展與建築研究上。\r\n",
    "describe_eh": "This course is devoted to study and analyze architectural design trends, major theories,\r\nArchitectural masters and their well-known buildings by certain topics. It is emphasized on discussions of the\r\nprinciples of architectural design throughout the analyses and theories. This course not only explores the differences between the background context and regional culture of architectural design, but also helps students understand the creative thinking and theoretical methods behind it. It\r\nwill enlighten students:\r\n1. to build up a foundation of knowledge and principles to analyze the characteristics of vernacular\r\nand international projects;\r\n2. to learn how to transform the principles and apply into architectural design, innovative development, and architectural research.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能以當代建築之案例進行討論、論述與分析其設計背後的方法與原則。",
      "describe_en": "To be able to carry out the discussion, commentary and analysis the methods and principles behind the architectural design of contemporary architectural projects."
    },
    {
      "seq": 2,
      "describe_ch": "透過國外相關文獻與分析案例，增進對於當代建築相關研究之國際觀。",
      "describe_en": "To build up a global view on the research of contemporary architecture through the international architectural literatures and case studies."
    }
  ],
