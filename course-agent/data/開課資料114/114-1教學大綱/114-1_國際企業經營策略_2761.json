  "description": {
    "sub_id3": null,
    "sub_name": "國際企業經營策略",
    "sub_ename": "INTERNATIONAL BUSINESS STRATEGY",
    "describe_ch": "本課程透過專書導讀、演講和個案研究的方式協助學生瞭解策略與組織績效的相關性、認識策略管理的核心觀念和架構，終而能熟悉策略管理的分析工具和技術以做出較高品質的決策。",
    "describe_eh": "This course helps students in understanding the relevance of strategy and organizational performance, understanding the core concepts and structure of strategic management through readings, lectures, and case studies, and will be familiar with the analytical tools and techniques of strategic management to achieve higher quality decision-making.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識策略管理的核心觀念與架構，並分析策略與組織績效的相關性　\t",
      "describe_en": "To learn the core concepts and framework of strategy and analysis the correlation of strategy and organizational performance."
    },
    {
      "seq": 2,
      "describe_ch": "協助學習者分析產業趨勢、國家文化、歷史特性與策略發展的關係　\t\t",
      "describe_en": "To assist manager and student to analyze the relationships among industry trend, national and historic culture, and strategy development."
    }
  ],
