  "description": {
    "sub_id3": null,
    "sub_name": "保險判例分析",
    "sub_ename": "CASE STUDY IN INSURANCE LAW SUIT",
    "describe_ch": "本課程完全以全國各地方法院、高等法院及最高法院實際的案例判決，作為教學之教材，由同學研析全案之判決全文、兩造之法律爭點、保險法之理論與法院之判決結果，分析其判決是否合理或另有其他不同之意見，完全以實務為導向之教學。",
    "describe_eh": "1.\tTo teach the case of party insuring, insured, beneficiary, broker, public adjustor, collective insurance, utmost good faith, insurance contract, aleatory contract, Law of large numbers, double insurance, reinsurance, moral hazard, travel accident, health, personal insurance, premium, disclosure and representation.\r\n2.\tTo understand the District Court, High court, Supreme Court's decision. \r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能獲悉保險判例分析的基本概念",
      "describe_en": "To know the basic concept in case study of insurance."
    },
    {
      "seq": 2,
      "describe_ch": "能應用保險專業概念來解決保險所遇到的問題",
      "describe_en": "To apply the professional knowledge to solve the problems of insurance."
    }
