  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "SX02100",
    "sub_id": "38469",
    "scr_dup": "001",
    "sub_title": "了解氣候變遷對環境的影響，透過各種調適減緩作為深入討論，建立整體生態共存韌性的全球觀和價值信念，進而創\n造出具氣候變遷因應韌性的環境",
    "sub_title_en": null,
    "sub_describe": "介紹各種氣候調適減緩作為及案例",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "氣候韌性",
    "sub_ename": "CLIMATE RESILIENCE",
    "describe_ch": "氣候韌性係指社會生態系統(包括群體或個人)面對氣候災害的接受及復原能力，其影響因素包括社會經濟條件、政府的治理能力、個人家庭互動情形等。韌性高低將影響其調適、學習與轉變的能力。本課程將透過大師講座，了解如何透過氣候減緩(mitigation)與氣候調適(adaptation)來解決「氣候變遷」問題。前者是指藉由行動以「減緩」(mitigation)氣候變遷發生的速度與規模；後者則藉由政策或方案，儘可能地提高組織的氣候「韌性」(resilience)以「調適」(adaptation)氣候變遷之衝擊。",
    "describe_eh": "Climate resilience refers to the ability of social-ecological systems (including groups or individuals) to accept and recover from climate disasters. Its influencing factors include socio-economic conditions, government governance capabilities, and personal family interactions. The level of resilience will affect their ability to adapt, learn and change. Through master lectures, this course will help you understand how to solve the problem of climate change through climate mitigation and climate adaptation. The former refers to taking actions to \"mitigate\" the speed and scale of climate change, the latter refers to improving the organization's climate \"resilience\" as much as possible through policies or programs to \"adapt\" to the impact of climate change.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
