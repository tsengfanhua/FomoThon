  "description": {
    "sub_id3": null,
    "sub_name": "觸媒工程",
    "sub_ename": "CATALYTIC PROCESS ENGINEERING",
    "describe_ch": "學生於本課程將學習非勻相催化中，觸媒材料之設計與特性分析所需基礎知識，以及催化程序相關工程理論。將由酸鹼觸媒、金屬氧化物觸媒、光觸媒、多孔性觸媒等實例來介紹以下主題：吸附、催化反應動力學、觸媒製備方法、特性分析技術、失活機制；另外也將探討觸媒反應器設計及工業催化程序實務。",
    "describe_eh": "Students will learn the fundamentals of designing and characterizing catalysts applied in heterogeneous catalysis as well as the related theory in catalytic process engineering. Based on the examples in acid-base, metal oxide, photocatalytic and porous catalysts, the following concepts, including adsorption, reaction kinetics, preparation methods, characterization technique, and deactivation mechanism will be introduced. The design of catalytic reactors and practices of industrial catalytic process will also be discussed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備探討非均相催化反應的基礎知識，概念和實驗方法",
      "describe_en": ".Have knowledge, fundamental concept and experimental techniques used to study heterogeneous catalysis"
    },
    {
      "seq": 2,
      "describe_ch": "解釋催化劑表面物理化學性質如何影響反應的活性和選擇性",
      "describe_en": "Account for how the catalytic activity and selectivity is influenced by the surface properties of the catalyst"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解表徵催化劑的分析方法所隱含的物理和化學現象及解讀其分析資訊",
      "describe_en": "Account for the physical and/or chemical phenomena behind techniques for catalyst characterization and the information offered by these techniques"
    }
  ],
