  "description": {
    "sub_id3": null,
    "sub_name": "智慧機器人概論與實作",
    "sub_ename": "INTRODUCTION AND IMPLEMENTATION OF INTELLIGENT ROBOTS",
    "describe_ch": "本課程之目的在於訓練學生了解機器人之建構原理並實作。其主要內容包括: 機體架構設計、無線通訊概論、基礎機器視覺處理、智慧型馬達控制、嵌入式系統與開發板介紹等。本課程亦會有多種基礎實作讓學生從做中學。",
    "describe_eh": "The purpose of this course is to train students to understand the construction principles of robots and to implement them. Its main contents include: robot structure design, introduction to wireless communication, basic machine vision processing, intelligent motor control, embedded system and development board introduction. This course will also have a variety of basic implementations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解機器人的軟、硬體基本知識。",
      "describe_en": "Understand the basic knowledge of the robot's software and hardware."
    },
    {
      "seq": 2,
      "describe_ch": "基礎機器人實作。",
      "describe_en": "Basic robot implementation."
    },
    {
      "seq": 3,
      "describe_ch": "跨領域整合經驗。",
      "describe_en": "Cross-domain integration experience."
    }
  ],
