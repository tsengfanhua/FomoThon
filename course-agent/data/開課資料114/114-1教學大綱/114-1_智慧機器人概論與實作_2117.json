    "yms_smester": 1.0,
    "cls_id": "CI00101",
    "sub_id": "48899",
    "scr_dup": "001",
    "sub_title": "第1-6週 硬體控制概念與影像辨識初探",
    "sub_title_en": null,
    "sub_describe": "第1-6週 學習硬體控制的技術與使用卷積神經網路進行物件辨識",
    "sub_describe_en": null
