  "description": {
    "sub_id3": null,
    "sub_name": "天線工程",
    "sub_ename": "ANTENNA ENGINEERING",
    "describe_ch": "該課程主要是介紹基本天線原理以及常見天線之特性與設計概念，以做為電機工程所學生未來修習天線設計相關課程之基礎。",
    "describe_eh": "This course's main objective is to introduce antenna fundamentals, the characteristics and design of popular antennas. It is designed to meet the needs of electrical engineering students at the beginning graduated level for learning advanced antenna courses.",
    "pre_subname": "EEEN3005電磁波",
    "pre_sub_id3": "EEEN3005",
    "pre_sub_ename": "EEEN3005 ELECTROMAGNETIC WAVE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解基本天線功能及其工作原理。",
      "describe_en": "Clearly understand the functions and operational principle of the basic antenna."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解天線之基本參數及其定義。",
      "describe_en": "Clearly understand the fundamental parameters of antenna and their definitions."
    }
  ],
