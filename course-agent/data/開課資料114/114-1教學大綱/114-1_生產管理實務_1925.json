  "description": {
    "sub_id3": null,
    "sub_name": "生產管理實務",
    "sub_ename": "PRODUCTION MANAGEMENT PRACTICES",
    "describe_ch": "本課程旨在探討生產及服務系統之營運作業管理，以協助公司在工業4.0的環境中取得競爭優勢，並引領其邁向企業經營管理的成功目標。學生將學習運用生產與營運相關的工具與方法，解決產品開發、供應鏈、生產排程、專案管理與系統整合等挑戰。",
    "describe_eh": "This course aims to explore the operational management of production and service systems, assisting companies in gaining a competitive advantage in the Industry 4.0 environment and guiding them towards achieving success in enterprise management. Students will learn to apply tools and methods related to production and operations to address challenges such as product development, supply chain management, production scheduling, project management, and system integration.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備數學、統計、資訊、工程與管理基本學理與應用能力。",
      "describe_en": "Be able to underhand the fundamental principles of mathematics, statistical, engineering and management information and application abilities."
    },
    {
      "seq": 2,
      "describe_ch": "具備有效溝通、團隊合作、發掘問題，以及解決問題之能力。",
      "describe_en": "Be able to have effective communication, teamwork, problems exploration, and problems solving abilities."
    },
    {
      "seq": 3,
      "describe_ch": "具備邏輯思維、創新設計與持續改善能力。",
      "describe_en": "Be able to have logical thinking, innovative design and continuous improvement abilities."
    },
    {
      "seq": 4,
      "describe_ch": "具備專業倫理、社會責任、全球關懷與持續學習能力。",
      "describe_en": "Be able to have professional ethics, social responsibility, global care and continuous learning abilities."
    }
  ],
