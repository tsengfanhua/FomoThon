  "description": {
    "sub_id3": null,
    "sub_name": "文獻研討",
    "sub_ename": "LITERATURE DISCUSSION",
    "describe_ch": "課堂講述 、邀請專家演講，學生輪流上台作專題報告，研究方法相關技巧之講述，以及論文計畫書之撰寫原則，比照本系碩士論文製作格式規定，內容包含中英文摘要、緒論（包括背景、目的、重要性以及國內外有關本研究情況）、研究方法、預期成果，以及至少十篇以上與研究主題相關之國際期刊論文參考文獻。",
    "describe_eh": "The classroom is given lessons, invites the expert to lecture, students appear on the stage and make specialist paper in turn, the telling of relevant skill of the research approach.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解特定專業研究論文，驗證各項專業定理，其中包括資料的蒐集、維護、整理與分析。",
      "describe_en": "Comprehend the specific research paper and verify its related theorem including the collection, maintenance, management and analysis."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並分析說明已發表文章之內容與核心關念。",
      "describe_en": "Understand and describe that the content and key concept of a published paper."
    },
    {
      "seq": 3,
      "describe_ch": "能以講英文的口頭報告清楚說明專業研究論文。",
      "describe_en": "Clearly describe the specific research paper by the oral presentation in English."
    }
  ],
