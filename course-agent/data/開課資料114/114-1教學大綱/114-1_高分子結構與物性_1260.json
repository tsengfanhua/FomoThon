  "description": {
    "sub_id3": null,
    "sub_name": "高分子結構與物性",
    "sub_ename": "STRUCTURE AND PROPERTIES OF POLYMERS",
    "describe_ch": "講解探討高分子型態、結構之基本研究理論及高分子熱力學、黏彈及其他基本物性原理，進而推導結構與物性間之關係",
    "describe_eh": "To describe and explain the thermodynamics and kinetics of morphology and structure of polymers. Introduce the rubber elasticity and viscoelasticity of polymers. The relationship of structure and mechanical properties of polymers will also be introduced.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "旨在了解高分子型態、結構之基本理論及高分子熱力學、黏彈及其他基本物性",
      "describe_en": "The aim to understand the thermodynamics and kinetics of morphology and structure of polymers.. Besides, the rubber elasticity and viscoelasticity of polymers are also Introduced."
    },
    {
      "seq": 2,
      "describe_ch": "旨在了解各高分子結構與物性間之關係，使理論和實際運用相互結合。",
      "describe_en": "The aim to understand the relationship of structure and mechanical properties of polymers for combining the theory and practical application together."
    }
  ],
