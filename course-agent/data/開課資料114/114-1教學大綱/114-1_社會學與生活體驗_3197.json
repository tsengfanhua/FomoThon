  "description": {
    "sub_id3": null,
    "sub_name": "社會學與生活體驗",
    "sub_ename": "SOCIOLOGY AND LIFE EXPERIENCE",
    "describe_ch": "此課程主要是以介紹社會學的源起及其主要的概念與理論為主，並輔以社會現況的解讀與書籍的討論，使學生得以瞭解社會的組成與運作原理，且可對社會現象與發展的可能性提出自己的看法，同時經由各種現實資料或個案的討論，可以獲得對所處社會的瞭解與產生社會各種事務的好奇與關懷。",
    "describe_eh": "This lecture focuses on introducing the origin of sociology and its main concept and theory. Secondary discussions on social situations and related books will be carried. Students may get an understanding of the formation and function concept of a society and suggest their own point of view of social phenomenon. At the same time, be aware of the society which we live in and inspire curiosity and care for the society through facts and case discussions.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解社會學原理及自我成長過程中社會的影響.",
      "describe_en": "Understand the principles of sociology and the social influence during the process of self-growth."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解當前社會大議題,培養全球性的視野,提昇社會關懷的興趣.",
      "describe_en": "Understand the current social issues and Cultivating a global perspective, raise interesting in social care."
    }
  ],
