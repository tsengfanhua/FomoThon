  "description": {
    "sub_id3": null,
    "sub_name": "數量方法實習",
    "sub_ename": "PRACTICE OF QUANTITATIVE METHODS",
    "describe_ch": "本課程旨在教授學生運輸與物流系統的規劃、設計理論與實務概念，並培養他們運用數據調查、數據分析或數學模型解決相關問題的能力。透過實習演練方式，以提升學生運用數量方法解決運輸與物流問題的能力。",
    "describe_eh": "This course aims to provide students with an understanding of the planning, design theory, and practical concepts associated with transportation and logistics systems, while fostering their capacity to employ data investigation, data analysis, or mathematical models to tackle relevant challenges. Through hands-on exercises, the course endeavors to improve students' proficiency in applying quantitative methods to solve transportation and logistics issues.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "教授各運輸或物流系統之規劃、設計理論與實務概念",
      "describe_en": "Instructing on the planning, design theory, and practical concepts pertaining to diverse transportation or logistics systems."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生運用資料調查、數據分析或數學模型分析運輸或物流問題之能力",
      "describe_en": "Nurturing students' proficiency in employing data investigation, data analysis, or mathematical models to analyze transportation or logistics issues."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生獨立或透過團隊合作解決專業問題之能力",
      "describe_en": "Fostering students' capability to autonomously or collaboratively address professional challenges through teamwork."
    }
  ],
