  "description": {
    "sub_id3": null,
    "sub_name": "機率論(一)",
    "sub_ename": "PROBABILITY (1)",
    "describe_ch": "介紹機率之基本概念及其運算，常用的離散型及連續型隨機變數、隨機變數的期望值、動差生成函數，並探討多個變數之隨機變數及其聯合機率分配。",
    "describe_eh": "This course introduces probability space, random variable, probability distribution, some discrete random variables and continuous random variables, expectation of random variables, moment generating function, multiple random variables, and multivariate probability distribution.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用機率的概念",
      "describe_en": "Apply the concept of probabilities."
    },
    {
      "seq": 2,
      "describe_ch": "應用隨機變數的概念與認識一些常見的機率分配函數",
      "describe_en": "Apply the definition of random variable and recognize some well-known probability distribution functions."
    }
  ],
