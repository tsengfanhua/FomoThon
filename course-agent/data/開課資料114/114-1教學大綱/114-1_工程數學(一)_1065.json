  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(一)",
    "sub_ename": "ENGINEERING MATHEMATICS(1)",
    "describe_ch": "本課程介紹常微分方程式的求解及應用，內容包含四大部分：(1)一階微分方程式，(2)高階微分方程式，(3)拉普拉斯轉換。期使學生能了解常微分方程式的重要觀念和知識，並學習常微分方程的標準解法和其在水利工程及資源保育的應用。",
    "describe_eh": "This course introduces the ordinary differential equation. Course chapters includes: (1) first-order differential equations, (2) higher-order differential equations, and (3) Laplace transform. The course objective is to teach students to learn the important concepts and methods of solving the ordinary differential equations.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "\t理解常微分方程式的基本觀念\t",
      "describe_en": "1.\tComprehension of basic concepts of the ordinary differential equation"
    },
    {
      "seq": 2,
      "describe_ch": "學習常微分方程式的求解方法\t",
      "describe_en": "2.\tTo learn the methods of solving ordinary differential equations"
    },
    {
      "seq": 3,
      "describe_ch": "\t應用常微分方程式的求解方法處理工程相關問題\t",
      "describe_en": "3.\tTo apply the methods of solving ordinary differential equations to deal with engineering problems"
    }
  ],
