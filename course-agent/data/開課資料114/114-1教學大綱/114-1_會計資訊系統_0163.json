  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB01133",
    "sub_id": "52500",
    "scr_dup": "001",
    "sub_title": "ERP系統─財務模組的應用",
    "sub_title_en": null,
    "sub_describe": "ERP系統─財務模組的應用，包含收款循環、付款循環、總帳、固定資產等流程的說明及系統操作。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "會計資訊系統",
    "sub_ename": "ACCOUNTING INFORMATION SYSTEM",
    "describe_ch": "本課程介紹使學生了解資訊化環境對會計之衝擊，進而從系統設計之觀點討論會計資訊系統之分析與設計，並針對證期局規範之八大交易循環，討論因應資訊環境之企業程序、內部控制、應用軟體。",
    "describe_eh": "This course helps student to understand the information environment to impact accounting. Then from the system design analysis viewpoint to discuss the accounting information system design and analysis.  In addition, follow the SFB's eight transactions cycle regulations, discussion the enterprise procedure, internal control, application software in accordance to information environment.",
    "pre_subname": "ACCT1011會計學(一)、ACCT1012會計學(二)",
    "pre_sub_id3": "ACCT1011",
    "pre_sub_ename": "ACCT1011 ACCOUNTING(1)、ACCT1012 ACCOUNTING(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用資訊科技技術於會計之能力",
      "describe_en": "Application for the ability of the information technology in the Accounting."
    },
    {
      "seq": 2,
      "describe_ch": "使用ERP系統處理跨國企業之財務資料",
      "describe_en": "Using ERP systems to process the financial data of multinational corporations."
    }
  ],
