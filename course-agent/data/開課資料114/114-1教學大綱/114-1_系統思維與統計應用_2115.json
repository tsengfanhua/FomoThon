  "description": {
    "sub_id3": null,
    "sub_name": "系統思維與統計應用",
    "sub_ename": "SYSTEM THINKING AND APPLIED STATISTICS",
    "describe_ch": "「系統思維」比起「細節思維」是有效的學習方式。本課程傳講系統思維如何有較地落實在產學，教學，與生活案例上,特別是在應用統計的教學與學習上。統計學是任何「數據分析,包括 AI」的基礎。我們期望學生能將系統思維應用到學習統計學, 進一步學習其他學科上， 最終能增進解決真實問題的能力。",
    "describe_eh": "“System thinking’’ is  an effective learning approach compared to  “detail thinking”. This course, teaches how to implement system thinking in practical cases such as  industry, education, and daily life, especially in the teaching and learning applied statistics. Statistics is the foundation of any data analysis, including artificial intelligence(AI). We expect students to apply system thinking to learning statistics, further other subjects, and ultimately improving their ability to solve real-world problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "落實系統思維在產學, 教學, 與生活案例上",
      "describe_en": "Implement system thinking in practical cases such as  industry, education, and daily life"
    },
    {
      "seq": 2,
      "describe_ch": "以 “品管圖’’管理製程是否正常運作",
      "describe_en": "Using control charts to manage the operation of a process"
    },
    {
      "seq": 3,
      "describe_ch": "以“迴歸”找到最佳變數間的關係",
      "describe_en": "Using regression analysis to find the optimal relationship among independent and dependent variables."
    },
    {
      "seq": 4,
      "describe_ch": "以“實驗設計”找到最佳因數組合",
      "describe_en": "Using design of experiments (DOE) to find the optimal combinations of factors."
    },
    {
      "seq": 5,
      "describe_ch": "統計應用的案例分析",
      "describe_en": "Cases studies using  statistics methods"
    },
    {
      "seq": 6,
      "describe_ch": "用聽的統計應用；一葉知秋, 一生受用的數據分析, 廣播版",
      "describe_en": "Learning Statistics via podcast."
    }
  ],
