  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE3032A",
    "sub_id": "41041",
    "scr_dup": "001",
    "sub_title": "感測器原理、通訊技術與資料優化處理",
    "sub_title_en": null,
    "sub_describe": "1. 針對智慧製造常見之感測器，如溫度、震動、變位、電流、環境感測（濕度、濃度...)、影像、聲音等進行量測原理的介紹與相關的應用說明。\n2. 針對各種有線（TCP／IP、modbus）與無線傳輸（wifi、5G通訊等），說明工業用通訊技術\n3. 針對收集之資料，講接資料清洗與異常訊號之處理。\n4. 簡易介紹AI之應用",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "感測與通訊系統整合與優化",
    "sub_ename": "SENSING AND COMMUNICATION SYSTEM INTEGRATION AND OPTIMIZATION",
    "describe_ch": "本課程為智慧製造最上層進行「AI決策」時必要的「底層感測」與「中間層通訊」的技術介紹，課程內容包含：\n1. 感測器研製：包含震動、溫度、電流、空氣品質、光等感測器之硬體組建與程式撰寫\n2. 通訊：介紹各種通訊方式，並撰寫通訊程式傳輸到伺服器端的資料庫\n3. 訊號處理：包含訊號濾波、異常訊號處理等\n4. AI優化：透過智慧機械廊道各式工具機，實際進行上述3點之實作，並於雲端建置AI優化之功能\n",
    "describe_eh": "This course is an introduction to the \"bottom sensing\" and \"middle layer communication\" technologies necessary for \"AI decision-making\" at the top level of smart manufacturing. The course content includes:\n1. Sensor development: including hardware construction and programming of sensors such as vibration, temperature, current, air quality, light, etc.\n2. Communication: Introduce various communication methods, and write communication programs to transmit to the server-side database\n3. Signal processing: including signal filtering, abnormal signal processing, etc.\n4. AI optimization: Through various machine tools in the smart machinery corridor, the above three points are actually implemented, and the AI optimization function is built in the cloud.\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解感測器、通訊與訊號處理之技術",
      "describe_en": "Able to understand sensor, communication and signal processing technologies"
    },
    {
      "seq": 2,
      "describe_ch": "能透過感測及通訊完成智慧製造所須的智慧功能或AI決策",
      "describe_en": "Ability to complete smart functions or AI decisions required for smart manufacturing through sensing and communication"
    }
  ],
