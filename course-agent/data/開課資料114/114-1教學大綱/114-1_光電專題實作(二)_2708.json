  "description": {
    "sub_id3": null,
    "sub_name": "光電專題實作(二)",
    "sub_ename": "PRACTICE OF SPECIAL TOPICS ON PHOTONICS (2)",
    "describe_ch": "本課程為光電系終端課程。所有學生都必須以分組方式進行專題研究。學生將進行文獻蒐集與論文研讀、研究規劃、進行實驗，數據分析、撰寫報告等。在學期末學生將進行專題研究報告。",
    "describe_eh": "This is the capstone course for undergraduates enrolled in Photonics. All students need to conceive and carry out a research project in teams. The students will search literatures, read papers, scheme research route, conduct experiments, analyze experimental data, and write reports. Finally, the students also need to present their research results.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解光電領域技術原理及應用。",
      "describe_en": "To understand the principle and application of optics and photonics."
    },
    {
      "seq": 2,
      "describe_ch": "綜合資料收集、數據整理解析與歸納設計的專業能力，構成專題研究報告。",
      "describe_en": "To compose a technical report by utilizing professional abilities on collecting data, analyzing data, and integrating design concepts."
    },
    {
      "seq": 3,
      "describe_ch": "應用專業技術、工具和軟體進行專案。",
      "describe_en": "To apply professional techniques, tools, and software for practical projects.　"
    },
    {
      "seq": 4,
      "describe_ch": "理解實驗的設計策略。　",
      "describe_en": "To understand the strategy of experimental  design.　"
    },
    {
      "seq": 5,
      "describe_ch": "應用專案管理、團隊合作與溝通協調能力。",
      "describe_en": "To apply the abilities of project management, effective communication and persuasion."
    },
    {
      "seq": 6,
      "describe_ch": "分析光電問題並構思解決問題的方法。",
      "describe_en": "To analyze the photonics problems and considering the possible solutions."
    },
    {
      "seq": 7,
      "describe_ch": "關心光電問題並能持續學習與謀求解決方案。",
      "describe_en": "To care about the photonics problems and seek for solutions by persistent learning."
    },
    {
      "seq": 8,
      "describe_ch": "認知專業倫理與社會道德責任，培養自我管理能力。",
      "describe_en": "To recognize the professional ethics and society moral responsibility, and to develop the ability of self-management."
    }
  ],
