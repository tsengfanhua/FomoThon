  "description": {
    "sub_id3": null,
    "sub_name": "科技產業工程",
    "sub_ename": "ENGINEERING OF INDUSTRIAL TECHNOLOGY",
    "describe_ch": "此課程主要目的在於教授科技產業內容及其相關之技術，以提高產業之競爭力，包括目前高科技產業種類及相關之自動化技術: 資訊、半導体、通訊、光電、微機電、生物科技等以及其相關之製程流程控制、電腦整合製造(CIM)與機電自動化等。",
    "describe_eh": "This course is designed to teach the knowledge of the industry and the related technology for the promotion of the company competition capability, which include the current variety of high technologies and automation, include computer and information, semiconductor, communication, photoelectric industry, micro-electromechanical system, biomedical technology, and the related manufacturing process control, computer integrated manufacturing (CIM), and mechanization. This program is an effort to meet business and industry training heeds for multi-craft technology.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解 AI ( LLM、生成式 AI、AI Agent) 如何應用於無人機與機器人控制。",
      "describe_en": "Learn how AI (LLMs, Generative AI, and AI Agents) can be applied to drone and robot control."
    },
    {
      "seq": 2,
      "describe_ch": "介紹各種 AI 技術在無人機與機器人領域的 實際應用案例",
      "describe_en": "Introduction to real-world application cases of various AI technologies in the fields of drones and robotics."
    },
    {
      "seq": 3,
      "describe_ch": "體驗 AI 工具與平台 ( ROS, 模擬器)與培養學生對 AI 自動控制的興趣，並能思考 AI 如何解決實際問題。",
      "describe_en": "Experience AI tools and platforms (such as ROS and simulators), cultivate students' interest in AI-based autonomous control, and encourage them to think about how AI can solve real-world problems."
    },
    {
      "seq": 4,
      "describe_ch": "培養學生團隊合作與專案發想能力。",
      "describe_en": "Develop students' teamwork and project ideation skills."
    }
  ],
