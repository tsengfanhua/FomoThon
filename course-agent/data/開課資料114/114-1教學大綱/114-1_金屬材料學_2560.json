  "description": {
    "sub_id3": null,
    "sub_name": "金屬材料學",
    "sub_ename": "METALLIC MATERIALS",
    "describe_ch": "金屬材料學旨在教導學生學習各種金屬材料，並膫解熱機處理、顯微組織與材料機械性質三者間之關係。內容涵蓋鐵與鋼、碳鋼、合金鋼、鑄鐵與非鐵金屬材料，學生將可對材料選擇、合金設計與製程參數規劃等奠定良好之基礎。",
    "describe_eh": "The fundamentals and applications of metallic materials are introduced in this course. The relationships among the thermo-mechanical treatments, microstructures and mechanical properties are also lectured. Several topics are included in the course：iron and steel, carbon steel, alloy steel, cast iron and non-ferrous metallic materials. The fundementals of materials selection, alloy design and thermo-mechanical processing of metals can be well established.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習鐵與鋼、碳鋼及合金鋼之顯微組織與材料特性，以及製程參數對顯微組織與材料特性之影響。",
      "describe_en": "To learn the microstructures and properties of iron and steel, carbon steel and alloy steel, and the effects of various process parameters on them."
    },
    {
      "seq": 2,
      "describe_ch": "學習鑄鐵及各種非鐵金屬材料之顯微組織與材料特性，以及製程參數對顯微組織與材料特性之影響。",
      "describe_en": "To learn the microstructures and properties of cast iron and non-ferrous metallic materials, and the effects of various process parameters on them."
    },
    {
      "seq": 3,
      "describe_ch": "奠定合金設計、製程參數調控、材料選擇與應用之良好基礎。",
      "describe_en": "To establish the foundation of alloy design, choice of thermal-mechanical parameter, material selection and application."
    }
  ],
