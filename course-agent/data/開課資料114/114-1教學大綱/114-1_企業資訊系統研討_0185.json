  "description": {
    "sub_id3": null,
    "sub_name": "企業資訊系統研討",
    "sub_ename": "SEMINAR ON ENTERPRISE INFORMATION SYSTEMS",
    "describe_ch": "本課程將介紹ERP系統的概念及說明公司如何利用ERP系統使其營運更有效率及效果。本課程亦討論ERP系統應用的案例。本課程主要探討的主題為企業導入ERP系統對公司盈餘管理、會計資訊品質、內部控制、審計及企業避稅的影響。",
    "describe_eh": "The course will introduce key concepts of ERP systems and show how organizations use such systems to run their operations more efficiently and effectively The course will also provide a discussion on various business cases in which ERP concepts can be applied. The main topics of discussion include the effect of ERP system implementations on the earnings management, accounting information quality, internal control, audit, and tax avoidance.",
    "pre_subname": "ACCT3060會計資訊系統",
    "pre_sub_id3": "ACCT3060",
    "pre_sub_ename": "ACCT3060 ACCOUNTING INFORMATION SYSTEM",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解組織如何使用ERP系統以使其企業流程最佳化",
      "describe_en": "Understand how organization use Enterprise Resource Planning (ERP) systems to optimize their business processes."
    },
    {
      "seq": 2,
      "describe_ch": "說明及解釋ERP系統如何提供給管理者正確、一致與即時的資料，而有助於公司成功。",
      "describe_en": "Illustrate and explain how ERP systems can help a company prosper by providing business managers with accurate, consistent, and real time data."
    }
  ],
