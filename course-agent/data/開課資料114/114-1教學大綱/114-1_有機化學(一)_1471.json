  "description": {
    "sub_id3": null,
    "sub_name": "有機化學(一)",
    "sub_ename": "ORGANIC CHEMISTRY(1)",
    "describe_ch": "介紹烷類、烯類、炔類的命名、結構、物性、製備、化學反應及其工業上的應用，並強調這些化合物在化學反應的機轉中能量與立體結構的變化.",
    "describe_eh": "Introduction to nomenclature, structures, physical properties, preparation, chemical reactions, industrial applications of the compounds in the organic families of alkanes, alkenes, alkynes and alkyl halides.  The mechanism, energy change, and stereochemistry of their chemical reactions are thoroughly investigated.",
    "pre_subname": "ENGS1012普通化學(一)",
    "pre_sub_id3": "ENGS1012",
    "pre_sub_ename": "ENGS1012 GENERAL CHEMISTRY(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解有機化合物共價鍵的形成。",
      "describe_en": "Comprehension for the chemical bonds are formed in organic molecules."
    },
    {
      "seq": 2,
      "describe_ch": "理解有機化合物分子的構型及其內部的張力。",
      "describe_en": "Comprehension for the strains in the conformations of organic molecules and their effect on the stability of the molecule"
    },
    {
      "seq": 3,
      "describe_ch": "理解烷類、烯類、炔類的命名、結構、物性、製備、化學反應及其工業上的應用。　",
      "describe_en": "Comprehension for the nomenclature, structures, physical properties, preparations, chemical reactions, and industrial applications of alkanes, alkenes, alkynes, and alkyl halides."
    },
    {
      "seq": 4,
      "describe_ch": "理解有機化合物立體結構間的關係，以及在化學反應過程中的變化",
      "describe_en": "Comprehension for the stereochemistry of organic molecules."
    }
  ],
