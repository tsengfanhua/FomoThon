  "description": {
    "sub_id3": null,
    "sub_name": "機率與統計",
    "sub_ename": "PROBABILITY AND STATISTICS",
    "describe_ch": "從機率概念由淺入深導引學生進入基本統計觀念，瞭解抽樣分配與估計的演算與運用。本課程將介紹的主題包括資料整理、機率概念、常用之機率分配、抽樣分配、點估計與區間估計、假設檢定，再搭配統計軟體Python語言的實際演練，來帶領學生熟悉統計基本知識與分析工具的應用",
    "describe_eh": "Based on the foundation of probability concept, students will learn the basic statistical concept and know the sampling distribution and the application of estimation. Topics include data, probability concept, common probability distributions, sampling distribution, point estimation, hypothesis testing and exercise of statistical software (Python) in order to know the basic knowledge of statistics.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解資訊科學領域裡常用的機率與統計基礎觀念",
      "describe_en": "Know the basic concept of probability and statistics"
    },
    {
      "seq": 2,
      "describe_ch": "應用隨機變數的概念與認識一些常見的機率分配",
      "describe_en": "Know the concept of random variable and some common probability distribution"
    },
    {
      "seq": 3,
      "describe_ch": "熟悉統計分析的工具應用",
      "describe_en": "Familiar with the application of statistical tools"
    }
  ],
