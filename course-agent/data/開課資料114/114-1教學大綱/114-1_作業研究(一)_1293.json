  "description": {
    "sub_id3": null,
    "sub_name": "作業研究(一)",
    "sub_ename": "OPERATIONS RESEARCH(1)",
    "describe_ch": "使學生瞭解作業研究的機本理論，以便能有足夠的基礎去接受更進一步的課程，同時亦具備應用能\r\n力,以備實際解決應用問題。課程內容包括線性規劃模式建立及求解，敏感度分析及應用，運輸問題\r\n模式建立及求解。",
    "describe_eh": "The goal for this course is make the student understand the basic theory and application of operations research. To let the student bare enough ability to accept more advance related course, and to solve practical problems. The course contains model formulating solving, sensitivity analysis and application, transportation problem model\r\nformulating and solving.",
    "pre_subname": "INEN2007線性代數、INEN2006工程統計(二)",
    "pre_sub_id3": "INEN2007",
    "pre_sub_ename": "INEN2007 LINEAR ALGEBRA、INEN2006 ENGINEERING STATISTICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解作業研究之基本定義及應用範圍，並熟練線性規劃模式之建立。",
      "describe_en": "Understand the basic definitions and application of operations research and familiar the linear programming model formulating."
    },
    {
      "seq": 2,
      "describe_ch": "能夠瞭解線性規劃簡捷法之理論與計算方法，並應用簡捷法解實際應用問題。",
      "describe_en": "Be able to understand the theory and algorithm of simplex method and be able to use the simplex method to solve the practical problem."
    },
    {
      "seq": 3,
      "describe_ch": "能夠對問題作敏感度分析。",
      "describe_en": "Be able to do the sensitive analysis for the linear programming problem."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解運輸問題模式建立、解法及應用。",
      "describe_en": "Understanding the model formulating and solving algorithm of transportation problem, and applications."
    }
  ],
