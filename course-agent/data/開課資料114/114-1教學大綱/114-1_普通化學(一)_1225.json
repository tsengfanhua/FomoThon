  "description": {
    "sub_id3": null,
    "sub_name": "普通化學(一)",
    "sub_ename": "GENERAL CHEMISTRY(1)",
    "describe_ch": "課程以原子、分子、離子的構造來說明化學計量，化學反應平衡的相互關係，並介紹原子組成氣體與固體液體的物理化學原理，最終介紹化學鏈結的生成與軌域。",
    "describe_eh": "Optical include Chemical Foundations, Atoms, Molecules, and Ions Stoichiometry, Type of Chemical Reactions and Solution Chemical Gases,Thermochemistry, Atomic Structure and Periodicity, Bonding : General Concepts, Covalent Bonding : Orbitals, Liquids and Solids",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "與學生高中時期的化學相連結",
      "describe_en": "This course is designed to acquaint students with topics in chemistry by English which was learned in seminar high school by Chinese."
    },
    {
      "seq": 2,
      "describe_ch": "應用化學的能力、主要在讓學生對原文書的接受",
      "describe_en": "Let the students learn how to use and adapt textbooks and use of English."
    },
    {
      "seq": 3,
      "describe_ch": "具備資料蒐集、數據分析的能力",
      "describe_en": "To employ skills of data collection and analysis."
    },
    {
      "seq": 4,
