  "description": {
    "sub_id3": null,
    "sub_name": "微處理機系統實習",
    "sub_ename": "THE EXPERIMENT OF MICRO-PROCESSOR SYSTEM",
    "describe_ch": "此課程的目的在於練習如何使用微處理機設計微處理機應用系統：線上模擬器介紹，含驅動程式，組譯器…等。軟硬體發展工具的介紹：基本組合語言程式設計、基本I/O介面練習 \n 、軟體/硬體系統整合、專題。",
    "describe_eh": "The main objective is to introduce the microcomputer application development tool. And to design a micro-processor-based system with these tools.It includes the following topics:The micro-computer development system and its driver, compiler, debugger.Basic assemble language programming.The application of I/O interface; parallel I/O part, timer, serial part and interrupt.System integration and case study.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識8051實驗版之各部元件與功能",
      "describe_en": "Knowledge of major parts and functions of an 8051 experiment board"
    },
    {
      "seq": 2,
      "describe_ch": "以組合語言書寫8051程式完成實習作業與期末專題",
      "describe_en": "Use assembly language to write 8051 programs for experiment assignments and a final project."
    }
  ],
