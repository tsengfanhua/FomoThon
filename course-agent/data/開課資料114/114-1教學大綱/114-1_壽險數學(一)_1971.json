  "description": {
    "sub_id3": null,
    "sub_name": "壽險數學(一)",
    "sub_ename": "MATHEMATICS FOR LIFE INSURANCE(1)",
    "describe_ch": "壽險數學即精算(Actuarial Science)為必修的一門課程，它以機率、複利數學、徵積分等為基礎來估算人壽保險產品之成本。本學期課程主要介紹死亡率模型與壽險商品定價的基礎模型，本學期課程也會分享壽險商品設計。",
    "describe_eh": "Actuarial mathematics is a pre-requisite course for actuarial science. The fundamentals are probability, compound interest theory and calculus. Actuarial mathematics is used for the calculation of insurance costs. This course introduces mortality rate model, calculation fundamentals of various life\ninsurance products. In addition, this course also introduces products design of life insurance. \n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解死亡率與年金概論",
      "describe_en": "Comprehension for the mortality rate and annuity"
    },
    {
      "seq": 2,
      "describe_ch": "理解壽險產品數理計算基礎",
      "describe_en": "Comprehension for the calculation fundamentals using for various life insurance products"
    },
    {
      "seq": 3,
      "describe_ch": "理解準備金提存之意義與計算",
      "describe_en": "Comprehension for the propose of reserve and learning how to calculate it"
    }
  ],
