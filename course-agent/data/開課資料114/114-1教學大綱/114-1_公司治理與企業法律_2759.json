  "description": {
    "sub_id3": null,
    "sub_name": "公司治理與企業法律",
    "sub_ename": "CORPORATE GOVERNANCE AND BUSINESS LAW FOR EXECUTIVE",
    "describe_ch": "本課程讓學生經由公司治理理論、相關法規規範、學術研究成果與實例了解現代公司治理之治理目的、治理方法及治理過程，並思考如何發展及建構公司治理機制各不同類型及規模之企業。",
    "describe_eh": "The course helps students realize the purpose, the approach, and the process of modern corporate governance through review of theories, laws and regulations, academic research results, and real practices. The course also explores how to develop and construct corporate governance mechanisms for different kind of industries.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "分析公司治理對企業之必要性 　\t　",
      "describe_en": "Analysis the necessities of corporate governance to company."
    },
    {
      "seq": 2,
      "describe_ch": "綜合思考如何發展及建構公司治理機制於各種不同產業之公司\t",
      "describe_en": "Synthesis how to develop and construct corporate governance mechanisms for different kind of industries."
    }
