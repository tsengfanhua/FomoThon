  "description": {
    "sub_id3": null,
    "sub_name": "全球化與國家發展",
    "sub_ename": "WORLD  AND  DEVELOPING  COUNTRIES",
    "describe_ch": "本課程旨在讓學生了解全球化與國家發展過程中相關理論與學術概念，並在理論基礎上，分析實務政府重大公共政策的案例暨利弊得失。另一方面，本課程也將從全觀角度，分析當代全球化與國家發展之政治、經濟、社會、文化等各面向的內涵，並比較各國公共政策不同的發展與成效。",
    "describe_eh": "This course is designed to guide the students to learn various significant theories and academic fundamentals of globalization, liberalization and national development. It explores and analyzes some major cases of government public policies along with their advantages and disadvantages based on an integration of their theoretical foundations. In addition, this course will analyze and compare the development and effectiveness of public policies of various countries on the aspects of political, economic and social dimensions under the context of globalization, liberalization and national development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
