  "description": {
    "sub_id3": null,
    "sub_name": "社區經營與管理",
    "sub_ename": "THE OPERATION AND MANAGEMENT OF COMMUNITY",
    "describe_ch": "一、社區總體營造的意義與國家社區發展政策；二、合作事業與社區總體營造組織資源的整合；三、社區總體營造項目的規劃與流程；四、社區總體營造項目的規劃與流程；五、社區產業永續經營－合作組織化；六、觀摩示範社區與田野調查；七、造鄉運動－參與式社區的要素與機制；八、新故鄉社區營造－計畫書撰寫的方法；九、示範案例的介紹；十、學生報告成果展示",
    "describe_eh": "1.The Introduction of Community Development and Management and the Policy of our country.2.The Integration of Cooperation and Community Resources. 3.The Project and Process of Community Revitalization. 4.The Strategy and Methodology of Community Development. 5.The Everlasting Management of Community Industry- The Organization of Cooperation. 6.Field Trip to the Modal Community and Field Study. 7.The Campaign of Creating a Hometown-The Elements and Machenism of Participating in Community activities. 8.The Community Development of New Hometown-How to make a project? 9.The Introduction of Case Examples. 10.The Students' Presentation of their research results.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "配合政府政策，培育社區營造人才。",
      "describe_en": "To be adapted to governments' polity which cultivate the talent of community empowerment."
    },
    {
      "seq": 2,
      "describe_ch": "培養對社區之認識與解決問題之能力。",
      "describe_en": "Strengthen the knowledge of community and the ability to solve the problems."
    },
    {
      "seq": 3,
      "describe_ch": "增加學生多元就業，跨越商學領域。",
      "describe_en": "Increase multiple-employment and stride over the field of business by students."
    },
    {
      "seq": 4,
      "describe_ch": "應用商管知識，推動社區改造運動。",
      "describe_en": "Apply the knowledge of business to promote the movement of communities' reconstruction."
    },
    {
      "seq": 5,
      "describe_ch": "協助學生取得非營利組織經營人才認證。",
      "describe_en": "Assist students to gain the certification of NPOS' management."
    }
  ],
