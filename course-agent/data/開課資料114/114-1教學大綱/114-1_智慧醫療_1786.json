  "description": {
    "sub_id3": null,
    "sub_name": "智慧醫療",
    "sub_ename": " SMART HEALTHCARE",
    "describe_ch": "醫療資訊化與人工智慧演進帶動智慧醫療之發展，亟需跨領域人才投入。課程包含空汙、新冠肺炎，高齡長照、可信賴醫療AI與癌症醫療。本課程由醫師引導學生了解臨床醫學之需求，進而了解資訊專長如何於智慧醫療發揮最大價值。",
    "describe_eh": "Medical informatization and the evolution of artificial intelligence drive the development of intelligent medicine. This course will focus on air pollution, COVID,  geriatric, entrustable medical AI and cancer medicine. In this course, doctors will guide students to realize the unmet need of clinical medicine and then understand how information expertise can maximize the value of smart medicine",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用數理、控制與生醫工程基礎以瞭解智慧醫療之基本知識。",
      "describe_en": "Apply mathematic and control foundation to understand the basic knowledge about smart healthcare."
    },
    {
      "seq": 2,
      "describe_ch": "能理解並說明各種智慧醫療的基本概念與應用。",
      "describe_en": "Comprehension and explanation for the basic structure and operation for various smart healthcare."
    },
    {
      "seq": 3,
      "describe_ch": "應用控制與資訊工具對智慧醫療進行分析與設計。",
      "describe_en": "To understand the fundamentals of smart healthcare based on control and information tools."
    },
    {
      "seq": 4,
      "describe_ch": "能以書面或口頭方式表達所研讀的智慧醫療的相關資訊。",
      "describe_en": "Communicate the reading information about smart healthcare by written or oral reports."
    }
  ],
