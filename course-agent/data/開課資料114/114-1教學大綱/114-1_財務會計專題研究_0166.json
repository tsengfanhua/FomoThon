  "description": {
    "sub_id3": null,
    "sub_name": "財務會計專題研究",
    "sub_ename": "ISSUES IN FINANCIAL ACCOUNTING",
    "describe_ch": "本課程深入討論財務會計特殊專題，主要內容包括：(1)收入之認列(2)所得稅會計處理(3)退休金會計(4)租賃會計(5)會計變動與錯誤更正(6)長、短期投資(7)現金流量表及(8)衍生性金融商品之揭露及會計處理。",
    "describe_eh": "The course discusses in depth the special topics financial accounting. Topics include: (1) Revenue Recognition. (2) Accounting for Income Tax (3) Accounting for Pension. (4) Accounting for Leases. (5) Accounting Changes and Error Analysis. (6) Investment. (7) Statement of Cash Flow and (8) Accounting and disclosure for derivative financial instruments.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解並能運用自己的詞彙定義財務會計之基本假說以及說明其會計處理。",
      "describe_en": "Understand and be able to define the base assumption of financial accounting with their own words and can explain the accounting procedures."
    },
    {
      "seq": 2,
      "describe_ch": "能利用會計相關資訊編製財務報表並加以分析應用。",
      "describe_en": "Be able to utilize the accounting information for prepare financial statements to analyzed and applied."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解特定會計議題對公司以及整體經濟層面之影響及其重要性。",
      "describe_en": "Understand and be able to explain the importance and effects of special financial accounting issue to business and economy."
    }
  ],
