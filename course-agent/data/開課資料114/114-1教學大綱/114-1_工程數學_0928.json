  "description": {
    "sub_id3": null,
    "sub_name": "工程數學",
    "sub_ename": "ENGINEERING MATHEMATICS",
    "describe_ch": "本課程介紹常微分方程式及向量微積分的求解及應用，內容包含：(1)一階微分方程式，(2)高階微分方程式，(3)向量及矩陣，(4)向量微積分，期使學生能了解工程數學的重要觀念和知識，並能應用於處理土木工程領域相關問題。",
    "describe_eh": "This course introduces the ordinary differential equation and the vector calculus.\nCourse chapters include: (1) the first-order differential equation, (2) the\nhigher-order differential equation, (3) the vector and the matrix, and (4) the vector\ncalculus. The course objective is to teach students to learn the important concepts and\nmethods of engineering mathematics in order to deal with civil engineering problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習常微分方程式的求解方法",
      "describe_en": "To learn the methods of solving ordinary differential equations"
    },
    {
      "seq": 2,
      "describe_ch": "學習向量微積分的基本觀念與方法\r\n",
      "describe_en": "To learn the basic concepts and methods of vector calculus\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "應用工程數學方法處理工程相關問題\r\n\r\n",
      "describe_en": "To apply the engineering mathematics to deal with engineering problems"
    }
  ],
