  "description": {
    "sub_id3": null,
    "sub_name": "積體電路專案研究",
    "sub_ename": " SPECIAL TOPICS ON INTEGRATED CIRCUITS",
    "describe_ch": "陳述積體電路/半導體相關主題進行專案討論，能概述半導體晶圓廠建置、製造運作與積體電路產品代工所需之專業知識，內容包括半導體晶圓廠產能估算、設備需求、廠務系統與環安衛，生產運作，人力招募訓練，以及產品品質與成本控制等專案主題。實施案例說明與問題討論，使學生有整體晶圓廠運作的全景概念。",
    "describe_eh": "Present the special topics of the integrated circuit/semiconductor fabrication, including Fab construction, manufacturing operation, product qualification and sales. The Fab capacity estimation, equipment requirement, factory system, Environment Safety Health (ESH), human resource recruiting/training, product quality control and cost considerations are also introduced. Special topic and case study are also included to show panoramic concept of semiconductor Fab operation.",
    "pre_subname": "ELEN3008半導體元件、ELEN6011超大型積體電路設計",
    "pre_sub_id3": "ELEN3008",
    "pre_sub_ename": "ELEN3008 SEMICONDUCTOR DEVICES、ELEN6011 VLSI DESIGN",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解半導體晶圓廠建置與生產製造運作知識。",
      "describe_en": "Understand the knowledge of semiconductor Fab construction and manufacturing operation"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解積體電路產品品質所需之知識。",
      "describe_en": "Understand the knowledge required for semiconductor product quality and Sales"
    }
  ],
