  "description": {
    "sub_id3": null,
    "sub_name": "高等會計學(一)實習",
    "sub_ename": "ADVANCED ACCOUNTING(1)PRACTICE",
    "describe_ch": "本課程包含二個重要目標 : (1)了解合併報表編製的原理與程序;(2)了解如何處理關係企業間各種交易。",
    "describe_eh": "Two objectives for this course:(1)to learn the logic and procedures for preparing consolidated financial statements,(2)to learn the entries and financial statements related to intercompany transactions for an affiliated group.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習「取得法」(SFAS No. 141R與SFAS No.157)在三種不同合併方式的運用：merger,consolidation,以及acquisition；包含(a)正差異(例如「商譽」)與負差異(例如「便宜購買」)的分析，(b)合併附帶成本的辨識與處理，以及(c)或有給付的會計程序。",
      "describe_en": "To learn the implementations of the acquision method (SFAS No.141R and SFAS No.157) into the three types of statutory business combinations : merger, consolidation, and acquision; including (a) the analysis of positive(such as the recognition of goodwill"
    },
    {
      "seq": 2,
      "describe_ch": "學習合併型態下「直接控股」，一套(完整)合併報表的編製(SFAS No.94與SFAS No.160)；包含合併工作底稿上，各個沖銷分錄的製作原理與程序。",
      "describe_en": "To learn the theories and the preparations of a complete set of consolidated financial statements (SFAS No.94 and SFAS No.160) for direct holdings,　including the reasons for each elimination entry reported on the consolidation worksheet."
    },
    {
      "seq": 3,
      "describe_ch": "學習母子公司間商品交易(例如存貨、廠房設備資產、債券)的合併處理程序(APB Opinion No.18)；包含未實現損益的分析，以及各個沖銷分錄的製作原理與程序。",
      "describe_en": "To learn the consolidation procedures for intercompany transactions (APB Opinion No.18) such as merchandise inventory, plant assets, and bonds; including the analysis of unrealized gain (or loss) from intercompany transactions and the reasons for each eli"
    }
  ],
