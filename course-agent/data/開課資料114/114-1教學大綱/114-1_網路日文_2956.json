  "description": {
    "sub_id3": null,
    "sub_name": "網路日文",
    "sub_ename": "INTERNET  JAPANESE",
    "describe_ch": "網路科技發達的現代社會，很多資訊來源都來自網路，本課程在於教導學生們善用網路科技的優良資訊，便利日語及其文化的了解。",
    "describe_eh": "With the advancement of the Internet, a lot of information comes from the Web. This course aims to teach students to make good use of the Internet to search for useful information, so as to improve their Japanese ability and the understanding of Japanese culture.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.透過網路的學習除可追求新知外，對於自己專業能力的提昇大有幫助。",
      "describe_en": "1. Students will not only gain knowledge but also greatly improve their professional ability."
    },
    {
      "seq": 2,
      "describe_ch": "2.網路學習除日語能力的提昇外並可加強獨立思考，追求新知能力。",
      "describe_en": "2. Learning through the Internet can improve students' Japanese ability and cultivate their critical thinking skills."
    }
  ],
