  "description": {
    "sub_id3": null,
    "sub_name": "電磁相容設計技術",
    "sub_ename": "ELECTROMAGNETIC COMPATIBILITY (EMC) DESIGN TECHNOLOGY",
    "describe_ch": "由於電子與電機技術的迅速發展與廣泛的應用，且在EMI/EMC法規與產品本身EMC品質的要求下，產品與系統的電磁相容越來越受重視。本課程的內容包括 EMI/EMC的基本觀念與理論、法規的要求、量測的技術、設計與對策的技巧，皆為系統整合及EMC工程師所必備的理論與實務知識。",
    "describe_eh": "Following the rapid development and widespread applications of electrical and electronic technologies, EMI/EMC related regulations and product’s compliance requirements are now getting serious attention worldwide. This curriculum covers all EMI principles and practices, including Basic Theory of EMI, Regulation Requirements, EMI Measurement Techniques, EMC Design and Debugging Techniques etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂電磁干擾：能夠描述重要的電磁干擾因素及其特性；能夠描述影響電磁干擾對通訊產品及環境的重要影響因素，能瞭解並說明電磁干擾在目前的通訊科技科技產業、社會生活及經濟層面的重要性及影響。",
      "describe_en": "Define EMI with their own words: Be able to describe important EMI constitutes and their characteristics; be able to describe important environmental factors impacted by EMI phenomena. Understand and be able to explain the importance and effects of EMI to communication technology, iduustry, society life and economy."
    },
    {
      "seq": 2,
      "describe_ch": "能辨識出在通訊科技產業可應用電磁干擾原理與技術的場合，並能清楚表達、使用相關原理，規劃一評估電磁干擾技術應用及其影響的相關分析，並由分析中歸納出適當的解決能力，並提出可行驗證與改善方法。",
      "describe_en": "Distinguish and make clear statement where EMI techniques and principles can be applied on communications industry. Be able to use related principles to plan an evaluation about measuring EMI and effects, and draw appropriate conclusions from analysis and propose a feasible method for validation and improvement."
    },
    {
      "seq": 3,
      "describe_ch": "能針對一特定有關電磁干擾的議題或情境，設計一合理模擬，加以分析驗證，並適切歸納出結論，能以書面或口頭方式(論文發表)將所獲結果與同儕於國際論文發表會中交流。",
      "describe_en": "Design a reasonable simulation for a specific EMI issue or scenario, conduct the simulation, and draw appropriate conclusions and organize research paper. Communicate results in written or oral form to classmates and present on International Conference."
    },
    {
      "seq": 4,
      "describe_ch": "能針對一特定有關電磁干擾的議題或情境，設計一合理模擬，加以分析驗證，並適切歸納出結論，能以書面或口頭方式(論文發表)將所獲結果與同儕於國際論文發表會中交流。",
      "describe_en": "Design a reasonable simulation for a specific EMI issue or scenario, conduct the simulation, and draw appropriate conclusions and organize research paper. Communicate results in written or oral form to classmates and present on International Conference."
    }
  ],
