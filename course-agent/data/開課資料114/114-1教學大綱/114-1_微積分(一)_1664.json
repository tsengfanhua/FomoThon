  "description": {
    "sub_id3": null,
    "sub_name": "微積分(一)",
    "sub_ename": "CALCULUS(1)",
    "describe_ch": "內容包含函數極限，導數，導函數，微分公式，鏈鎖律，隱微分，高階導數，線性近似與微分量，極大和極小值，導數與函數圖形之關係，無窮極限，水平漸近線，反導數，定積分，微積分基本定理，不定積分，代換法，曲線所圍之區域面積，自然對數函數，自然指數函數，一般對數與指數函數，反三角函數，並探討相關應用。",
    "describe_eh": "Topics include the Limit of a Function, Derivatives, Differentiation Formula, the Chain Rule, Implicit Differentiation, Higher Derivatives, Linear Approximation, Maximum and Minimum Values, the Definite Integral, the Fundamental Theorem of Calculus, Indefinite Integrals, the Substitution Rule, Logarithmic and Exponential Functions, Inverse Trigonometric Functions and their applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 18,
      "describe_ch": "理解單變數實數值函數之極限、連續、導數及積分定義，並建立相關定理，從中訓練學生邏輯分析能力。",
      "describe_en": "Comprehend the limit and continuity of a function, the definitions of derivative and integration, and establish relative theory.  Students are trained for the abilities of logical and analysis."
    },
    {
      "seq": 19,
      "describe_ch": "理解基本函數極限、連續、導數及積分之運算規則，並使學生熟練運算技巧。",
      "describe_en": "Comprehend the laws of limit , continuity and differentiation, and help students to master relative skills."
    },
    {
      "seq": 20,
      "describe_ch": "應用微積分理論及運算技巧處理相關幾何問題及極大極小值問題等，並為經濟學與物理學等跨領域學習作準備。",
      "describe_en": "Apply the theory of calculus to evaluate geometric problem and extreme value problems. It is helpful to study economics and physics."
    }
  ],
