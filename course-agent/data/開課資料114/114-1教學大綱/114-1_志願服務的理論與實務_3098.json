  "description": {
    "sub_id3": null,
    "sub_name": "志願服務的理論與實務",
    "sub_ename": "THEORY AND PRACTICE OF VOLUNTARY SERVICE",
    "describe_ch": "參與志願服務工作已是二十一世紀全球的新風潮，所以，在大學課程中導入服務學習理念以期增廣學生服務學習的內涵，透過服務學習之課程落實理念並推動社區服務的目  標，期盼學生能更關注社會問題並參與社會活動，以收公民實踐的成效。",
    "describe_eh": "Participating in volunteer work has become a new trend in the world in the 21st century. Therefore, the concept of service-learning is introduced into university courses in order to raise the awareness of this important theme. We hope that the students can pay more attention to social issues and participate in social activities. The ultimate goal is to encourage students to take part in civic practice and make our society better in many ways.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "開展全球宏觀視野，尊重多元價值、具備反思的能力進而提出個人的價值判斷。",
      "describe_en": "While taking a worldwide perspective and highlighting multicultural values, we are to bring forth our value judgments with reflective thinking"
    },
    {
      "seq": 2,
      "describe_ch": "學習人文教育，關注社會問題、能重視人與環境之和諧並參與社會活動。",
      "describe_en": "Led by the spirit of humanistic education, we are to address social issues while involving in communal activities, seeking coherence between humans and surroundings."
    }
  ],
