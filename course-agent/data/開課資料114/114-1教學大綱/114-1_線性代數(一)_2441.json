  "description": {
    "sub_id3": null,
    "sub_name": "線性代數(一)",
    "sub_ename": "LINEAR ALGEBRA(1)",
    "describe_ch": "線性代數是一門研究向量空間之間線性變換的數學理論，廣泛應用於科學、工程、數據科學和經濟學等領域。內容包含線性方程組、矩陣運算、歐幾里得空間的性質、線性變換、特徵值和特徵向量以及向量空間。本課程將側重於面向矩陣方法的理論和計算。",
    "describe_eh": "Linear algebra is a mathematical theory that studies linear transformations between vector spaces and widely applies in science, engineering, data science, and economics. The topic includes systems of linear equations, matrix operations, properties of Euclidean space, linear transformation, eigenvalues and eigenvectors, and vector spaces. The course will focus on both theoretical and computational aspects of the matrix-oriented approach.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解向量與矩陣運算、向量空間及其相關特性",
      "describe_en": "Comprehension for vector, matrices and matrices operation, vector space and subspace, property of vector space."
    },
    {
      "seq": 2,
      "describe_ch": "理解線性映射及線性映射的矩陣表示法、基本矩陣及線性聯立方程組",
      "describe_en": "Comprehension for  linear transformation and  linear transformation in the vector space, matrices and linear system equation."
    }
  ],
