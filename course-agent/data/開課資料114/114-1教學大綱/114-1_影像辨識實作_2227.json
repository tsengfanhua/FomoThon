  "description": {
    "sub_id3": null,
    "sub_name": "影像辨識實作",
    "sub_ename": "IMAGE RECOGNITION IMPLEMENTATION",
    "describe_ch": "本課程將圍繞機器學習常見的演算法與神經網路演算法展開綜述，深入淺出地介紹和分析各類智能演算法，並以 MATLAB 或 Python的演算法指令解決影像辨識問題。",
    "describe_eh": "This course will focus on an overview of common machine learning algorithms and neural network algorithms, introduce and analyze various intelligent algorithms in a simple and easy-to-understand manner, and use MATLAB or Python algorithm instructions to solve problems in image recognition.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解機器學習的理論，並藉由應用與編輯 MATLAB 程序理解如何應用於解決影像案例",
      "describe_en": "Understand the mathematics of machine learning and understand and apply digital photo processing by writing MATLAB programs"
    },
    {
      "seq": 2,
      "describe_ch": "了解MATLAB 機器學習相關函數。",
      "describe_en": "Understand the ML related functions of MATLAB"
    },
    {
      "seq": 3,
      "describe_ch": "了解神經網路的理論，並藉由應用與編輯 MATLAB 程序理解如何應用於解決影像案例",
      "describe_en": "Understand the mathematics of neural network and understand and apply digital photo processing by writing MATLAB programs"
    },
    {
      "seq": 4,
      "describe_ch": "了解MATLAB 神經網路相關函數。",
      "describe_en": "Understand the NN related functions of MATLAB"
    }
