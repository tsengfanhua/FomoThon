  "description": {
    "sub_id3": null,
    "sub_name": "單元操作(二)",
    "sub_ename": "UNIT OPERATIONS(2)",
    "describe_ch": "單元操作(二)內容主要為熱量傳遞。利用數學模型去了解、描述及設計工程系統中牽涉到熱量傳導、對流與輻射的部分。",
    "describe_eh": "Using mathematic models to understand, describe and design engineering systems and processes that involve heat transfer such as conduction, convection and radiation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂熱量傳遞",
      "describe_en": "Define heat transfer by their own words."
    },
    {
      "seq": 2,
      "describe_ch": "能夠利用理論分析工程系統中的熱量傳遞，並就其缺點提出改善設計",
      "describe_en": "Be able to analyze the heat transfer problem in an engineering system and propose a better design."
    },
    {
      "seq": 3,
      "describe_ch": "能利用數學模型，計算溫度分布、熱通量及熱傳速率。",
      "describe_en": "Be able to use the mathematic models to calculate the temperature profile, heat flux, and heat rate.　"
    },
    {
      "seq": 4,
      "describe_ch": "能夠利用無因次分析，導出流動情形下之熱量傳遞",
      "describe_en": "Be able to use conduct the dimensional analysis for heat transfer under the flow conditions."
    }
  ],
