    {
      "seq": 1,
      "describe_ch": "能認識靜力學之基本原理及平衡概念",
      "describe_en": "Understand basic principles and concept of statics."
    },
    {
      "seq": 2,
      "describe_ch": "能判別基本力量類型與支承形式",
      "describe_en": "Be able to distinguish basic force types and support's types."
    },
    {
      "seq": 3,
      "describe_ch": "能計算梁結構基本類型的支承反力及簡單桁架的桿件內力",
      "describe_en": "Be able to calculate reactive forces of statically determinate beams and the internal forces of simple trusses."
    }
