    {
      "seq": 1,
      "describe_ch": "引導學生了解現代藝術的形式、內容與背景。",
      "describe_en": "Guide students to understand the form, content and context of modern art."
    },
    {
      "seq": 2,
      "describe_ch": "啟發學生對藝術內涵的思考。",
      "describe_en": "Inspire students to contemplate the connotation of art."
    }
