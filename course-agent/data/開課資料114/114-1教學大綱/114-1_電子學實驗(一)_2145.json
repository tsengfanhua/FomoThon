  "description": {
    "sub_id3": null,
    "sub_name": "電子學實驗(一)",
    "sub_ename": "ELECTRONICS LAB.(1)",
    "describe_ch": "以實驗教學驗證電子學(一)課程內容，學生可實際操作分析基本電子元件與應用電路，訓練學生使用電子儀表，瞭解二極體、電晶體和運算放大器等元件特性，熟練電子電路接線技術，並能應用電腦軟體模擬分析基本電子電路。",
    "describe_eh": "Students will learn how to design and layout the circuits of electronic devices, to measure the characteristics of diodes and transistors. The courses includes laboratory familiarity with electronic instrumentation, diode and transistor characterization, power supply circuits, transistor amplifiers, operational amplifiers and electronic circuit simulation using PSPICE.　electronic circuit characteristics and the training of signal transmission. Cultivate students to have the foundation of learning electronic circuit analysis and design, understand the circuit composition structure, component selection, finished product production, and system evaluation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能使用相關儀器完成相關實習課題，並從中歸納出適當結論",
      "describe_en": "Be able to use relative instruments to achieve the results. Thus, be able to address the appropriate conclusions."
    },
    {
      "seq": 2,
      "describe_ch": "能夠了解基本電子元件之操作，並善加應用於其它電子電路",
      "describe_en": "Be able to understand the basic operation theory of electronic devices, then apply these devices to other electronic circuits.　"
    },
    {
      "seq": 3,
      "describe_ch": "能以書面資料及口頭報告方式將所獲得結果與同儕、助教、老師溝通",
      "describe_en": "Be able to communicate the experimental results with classmates, teaching assistants, and the instructor by means of the written paper or the oral presentation.　"
    }
  ],
