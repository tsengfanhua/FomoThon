  "description": {
    "sub_id3": null,
    "sub_name": "薄膜光學",
    "sub_ename": "THIN-FILM OPTICS",
    "describe_ch": "本課程的目的是:1. 瞭解薄膜光學之原理。2. 瞭解光學薄膜理論及其設計方法。3. 瞭解光學薄膜製程技術。4. 瞭解薄膜在光學系統中之應用。5. 瞭解薄膜光學之特性量測。",
    "describe_eh": "This course will provide a overview of modern thin film optics, including the principle, thin-film design , deposition technology and manufacture, performance testing and applications. Optical coatings consist of assemblies of thin films of materials where interference properties combine with the intrinsic properties of the materials to yield the desired optical performance. This course emphasizes understanding and takes students from fundamentals to techniques for design and manufacture.",
    "pre_subname": "EEEN6003物理光學",
    "pre_sub_id3": "EEEN6003",
    "pre_sub_ename": "EEEN6003 PHYSICAL OPTICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 4,
      "describe_ch": "能用自己的專業詞彙定義光學薄膜中，物理氣相沉積、離子源輔助沉積、均勻性以及光學特性、能夠描述光學薄膜的特性及應用。\t",
      "describe_en": "Define optical thin films with their own words: be able to describe the physical vapor deposition and processing, ion-beam assisted deposition, uniformity and optical characteristics; be able to describe the properties and application of optical thin films."
    },
    {
      "seq": 5,
      "describe_ch": "能瞭解並解釋光學薄膜的製鍍要件及如何將薄膜應用於實際光學系統。\t",
      "describe_en": "Understand and be able to explain the key factors of thin film coatings, and apply the thin film technology to the optical system."
    },
    {
      "seq": 6,
      "describe_ch": "知道於何處可找到光學薄膜議題的相關資訊、研究結果及標準，並可評估所獲資訊的適用性\t",
      "describe_en": "Know where to locate and access related thin-film issue information, research, as well as standards, and be able to evaluate the appropriateness of the obtained information."
    },
    {
      "seq": 7,
      "describe_ch": " 能利用光學薄膜的原理，評估一個真實的光學元件，並提出可行的計算程序\t",
      "describe_en": "Use principles of optical thin films to evaluate a true optical device and propose a feasible method for computational algorithms."
    }
  ],
