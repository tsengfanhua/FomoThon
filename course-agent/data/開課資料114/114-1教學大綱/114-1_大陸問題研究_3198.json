  "description": {
    "sub_id3": null,
    "sub_name": "大陸問題研究",
    "sub_ename": "THE STUDY OF MAINLAND ISSUES",
    "describe_ch": "本課程藉著議題的講授、討論與閱讀，使同學暸解兩岸關係與政策的發展過程，協助同學認識大陸研究的知識基礎，更針對台灣的安全、大陸政策及兩岸交流狀況做評估與分析。",
    "describe_eh": "Through lectures, discussions and readings on topics, this course enables students to understand the developmental process of cross-strait relations and policies, helps students understand the knowledge base of Mainland China research, and evaluates and analyzes Taiwan's security, Mainland China policy and cross-strait exchange",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
