  "description": {
    "sub_id3": null,
    "sub_name": "研究方法",
    "sub_ename": "RESEARCH METHODS",
    "describe_ch": "此課程將引導研究生入門以瞭解英語文研究(含應用語言學)之本質及重要的研究方法，並依照APA或MLA格式完成一份研究報告以深化對本領域之瞭解及熟悉。",
    "describe_eh": "This course intends to teach graduate students how to conduct research in English studies (in particular, applied linguistics) and write a research paper of surveying an area of their interests. Students are required, on the one hand, to acquire a fundamental understanding of how this discipline conducts their research. On the other hand, they need to produce a conventional research paper by following either the APA or MLA style.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備在英文研究及應用語言學領域執行合宜且不同研究方法之知識",
      "describe_en": "To acquire the knowledge of conducting adequate research of several methods in the discipline"
    },
    {
      "seq": 2,
      "describe_ch": "具備能解讀並融合幾份研究報告能力",
      "describe_en": " To understand and synthesize the findings and research methods in several reports"
    },
    {
      "seq": 3,
      "describe_ch": "具備撰寫符合學術規範之論文的能力(含文章摘要及期末報告)",
      "describe_en": "To write article summaries and a review term paper that conform to the conventions in the discipline"
    }
  ],
