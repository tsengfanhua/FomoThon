  "description": {
    "sub_id3": null,
    "sub_name": "結構學",
    "sub_ename": "STRUCTURAL THEORY",
    "describe_ch": "本課程為結構分析之基礎課程，其目的在使學生具備分析或設計桁架、梁及構架等結構系統之能力。本課程主要討論靜定結構，除了以各種方法求解結構受外力產生的桿件內力及其穩定性，亦將介紹結構之影響線及變形。",
    "describe_eh": "This is an elementary course of structural analysis. The objective is to lead students to be capable of analyzing or designing various structures such as trusses, beams, and frames.  This course focuses on discussing the statically determinate structures.  In addition to varied procedures to solve the internal member forces and stability of structures, techniques to determine the influence lines and deformations of structures are also introduced.",
    "pre_subname": "HY1003應用力學、HY2039材料力學",
    "pre_sub_id3": "HY1003",
    "pre_sub_ename": "HY1003 APPLIED MECHANICS、HY2039 MECHANICS OF MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "\t應用物理學及數學之知識於工程結構分析。 \t",
      "describe_en": "1.\tTo apply the knowledge of physics and mathematics in engineering structural analysis."
    },
    {
      "seq": 2,
      "describe_ch": "\t運用結構分析方法求解工程結構問題。 \t",
      "describe_en": "2.\tTo employ the techniques of structural analysis to solve engineering structural problems."
    }
  ],
