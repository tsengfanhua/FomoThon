  "description": {
    "sub_id3": null,
    "sub_name": "社會事業",
    "sub_ename": "SOCIAL BUSINESS",
    "describe_ch": "透過課程講授、實務專題演講與小組合作學習，建立對合作事業及非營利社會事業之基本知識。了解其定義與特徵、存在的意義、價值、使命、願景與任務，及其服務範疇、模式與功能，作為後續進階學習與生涯發展之參考。",
    "describe_eh": "This taught course would be learned by lectures and small group cooperative learning. Such fundamental topics as cooperatives, nonprofit and other social business organizations would be core concepts. It covers the definition, scope, role, mission, vision, business, services and major function of social business in our daily life. Some further important references may lead to the individual's career development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能描述何謂社會事業、非營利組織和合作事業。",
      "describe_en": "Be able to describe what Social Business, Nonprofit Organization, Cooperative Business is."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解不同社會事業存在的價值、角色與功能。",
      "describe_en": "Understand different values, roles and social functions of social business."
    },
    {
      "seq": 3,
      "describe_ch": "能以書面或口頭方式將所做研究報告及所獲結果與同學及教師溝通。",
      "describe_en": "Be able to report or communicate his/her project with classmates and teacher orally or by paper."
    }
  ],
