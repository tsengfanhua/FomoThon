  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CI02149",
    "sub_id": "71710",
    "scr_dup": "001",
    "sub_title": "該課程探討無線通信、軌道力學、天線設計、數位調變與網路協定",
    "sub_title_en": null,
    "sub_describe": "1. 軌道力學決定衛星在哪裡飛、怎麼飛。\n2. 天線設計確保衛星和地面能精準地「看到」對方並有效收發能量。\n3. 無線通信原理（特別是鏈路預算和通道特性）確保訊號能在超長距離和嚴苛環境下傳輸。\n4. 數位調變技術將使用者資料轉換成適合在該無線通道上傳輸的射頻波形，並盡可能高效利用寶貴的頻寬和衛星功率。\n5. 網路協定管理資料如何在衛星、地面站和使用者之間正確地傳輸、路由和交換，並將衛星鏈路整合到更大的通訊網路中。\n這五個主題環環相扣，缺一不可，共同構成了衛星通訊這門複雜而有趣的工程科學。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "衛星通訊",
    "sub_ename": "SATELLITE COMMUNICATIONS",
    "describe_ch": "本課程為大四程度衛星通訊領域入門課程。學生修習此課程後應具備衛星通訊方面的基礎知識，以及暸解寬頻衛星通訊網路的系統架構與技術原理。",
    "describe_eh": "This course is intended to provide an introduction to satellite communications for students at the senior level. A student of the course should learn the fundamental aspects of satellite communications, as well as understand the principles of system architecture and technique of broadband satellite communication networks.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂衛星通訊工程：能夠描述重要的衛星通訊工程能力種類及其限制。　",
      "describe_en": "Be able to understand the importance of satellite communications and describe the necessary components and the related considerations of  satellite communication systems."
    },
    {
      "seq": 2,
      "describe_ch": "知道於何處可找到衛星通訊工程的相關資訊、研究結果及標準，並可應用所獲資訊之適用性。　",
      "describe_en": "Know where to locate and access related satellite communication engineering information, research, as well as standards, and be able to apply the appropriateness of the obtained information.　"
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解並說明衛星通訊工程在社會及經濟層面的重要性及影響。",
      "describe_en": "Understand and be able to explain the importance and effects of satellite communication engineering to society and economy."
    }
  ],
