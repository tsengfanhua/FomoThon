  "description": {
    "sub_id3": null,
    "sub_name": "研究方法論",
    "sub_ename": "METHODS OF BUSINESS RESEARCH",
    "describe_ch": "本課程旨在教導學生進行研究工作之方法及邏輯，培養學生具有正確的研究方法，並能使用所教導之研究方法進行各種不同類型的研究，而成為一位專業的研究人員或是研發工程師。",
    "describe_eh": "This course aims to teach students how to carry out a good research work based on correct research methods and logistical thinking. Having such research methods, students can become a research scientist and engineering.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠瞭解進行研究工作之方法及所需之邏輯概念，而能有效率且正確地進行各種不同類型的研究。",
      "describe_en": "The objective is to aid students in\r\nunderstanding the required logistical\r\nconcepts for conducting research works.\r\n"
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解進行研究工作前所需之準備工作，如文獻蒐集，及研究進行時所需之方法及邏輯概念。",
      "describe_en": "The objective is to help students know how to prepare the thesis works such as literature survey research method and logics before starting research.\r\n"
    }
  ],
