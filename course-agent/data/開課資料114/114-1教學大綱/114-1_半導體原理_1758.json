  "description": {
    "sub_id3": null,
    "sub_name": "半導體原理",
    "sub_ename": "SEMICONDUCTOR PRINCIPLES",
    "describe_ch": "半導體原理介紹半導體材料特性與原理，含固體晶體結構、基本固態與量子力學、半導體能階基礎、以及載子傳輸現象。本課程訓練學生瞭解半導體學理，提高半導體相關產業的學習動機與興趣。學生將具有半導體理論基礎與相關分析能力。",
    "describe_eh": "Principles of Semiconductors introduces the characteristics and principles of semiconductors, including solid crystal structure, basic solid state and quantum mechanics, semiconductor energy level basis, and carrier transport phenomena. This course trains students to understand the theory of semiconductors and enhance their learning motivation and interest in semiconductor-related industries. Students will have the theoretical foundation of semiconductors and related analytical skills.",
    "pre_subname": "PHYS1003普通物理(一)、PHYS1004普通物理(二)",
    "pre_sub_id3": "PHYS1003",
    "pre_sub_ename": "PHYS1003 GENERAL PHYSICS(1)、PHYS1004 GENERAL PHYSICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備基礎量子力學、固體量子理論、半導體材料物理、及半導體元件物理知識。",
      "describe_en": "To possess the knowledge of fundamental quantum mechanics, solid-state quantum theory, semiconductor physics, and related materials and devices."
    },
    {
      "seq": 2,
      "describe_ch": "利用量子力學與費米能量觀念，理解半導體材料載子傳輸原理，建立半導體元件的電流-電壓關係基礎",
      "describe_en": "Comprehension for the carrier transmission behavior to construct basis of semiconductor I-V characteristics based on the concepts of Fermi-level and quantum mechanics."
    },
    {
      "seq": 3,
      "describe_ch": "應用半導體材料特性及元件的電性，設計分析半導體元件物模型。",
      "describe_en": "Application for semiconductor characteristic, device operation, and design rule and applications　to design and analyze of semiconductor device."
    },
    {
      "seq": 4,
      "describe_ch": "針對特定的半導體元件物理議題或情境，綜合半導體理論設計合理的計算程序，並適切歸納出結論，以書面或口頭方式將所獲結果與同儕、助教及教師溝通討論。",
      "describe_en": "A specific semiconductor physic issue and situation can be discussed and right conclusions are provided through design of calculation procedures from Synthesis of semiconductor principles. To communicate results in written or oral form to classmates, teac"
    }
  ],
