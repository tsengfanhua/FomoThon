  "description": {
    "sub_id3": null,
    "sub_name": "系統思考與學習型組織",
    "sub_ename": "Systems Thinking and Learning Organization",
    "describe_ch": "系統思考為管理大師彼得聖吉所提出的「第五項修煉」中最重要的一項修煉，亦為學習型組織成功的重要關鍵因素。本課程主要為教授系統思考與學習型組織的核心觀念以及如何將系統思考應用在問題解決和組織學習之方法和步驟，並藉由相關設計案例的互動學習與討論來有效率地提升學生的問題解決能力。",
    "describe_eh": "The aim of this course is to teach students how to develop capabilities of problem solving and organization learning by systems thinking efficiently through case study and interactive discussion.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂系統思考與學習型組織：能夠描述系統思考的重要性",
      "describe_en": "Learning how to define the systems thinking and learning organization and realize the importance of systems thinking"
    },
    {
      "seq": 2,
      "describe_ch": "知道於何處可找到系統思考的相關資訊、研究結果及標準，並可評估所獲資訊的適用性",
      "describe_en": "Learning how to search for necessary information about systems thinking and the validity of the information gathered"
    },
    {
      "seq": 3,
      "describe_ch": "能利用系統思考的原理，針對實際複雜跨領域問題，提出可行的整合解決方法",
      "describe_en": "Learning how to solve the real complex problems by systems thinking"
    },
    {
      "seq": 4,
      "describe_ch": "瞭解學習型組織對於社會發展的關連性與重要性",
      "describe_en": " To realize the relationship between learning organization and social development\r\n"
    }
  ],
