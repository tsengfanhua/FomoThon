  "description": {
    "sub_id3": null,
    "sub_name": "碩士論文",
    "sub_ename": "MASTER THESIS",
    "describe_ch": "碩士論文為訓練學生執行研究與解決問題的能力，學生針對研究問題進行研究和設計，並撰寫研究論文。論文內容需含導論、文獻回顧、方法、研究結果、結論和參考文獻。",
    "describe_eh": "The goal of master thesis intends to achieve the training of executing the project solving problems and writing ability of thesis. The thesis must include introduction, review, method, results, conclusions and reference.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用專業定理應用於碩士論文研究中，執行與驗證各項專業定理，其中包括資料的蒐集、維護、管理與理論的測試。",
      "describe_en": "When can apply to study in master's thesis the theorem, carry out and verify every theorem, including the collection, maintenance, test of management and theory of the materials.　"
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明各項碩士論文研究方法與進行智能系統分析與整合之能力。",
      "describe_en": "Be able to understand and explain the research methods of various master's thesis and the ability to analyze and integrate intelligent systems."
    },
    {
      "seq": 3,
      "describe_ch": "透過對文獻閱讀能與不同領域的同學間有效溝通及發揮團隊合作的能力。",
      "describe_en": "Through the literature reading, I can communicate effectively with students in different fields and give play to the ability of teamwork."
    },
    {
      "seq": 4,
      "describe_ch": "閱讀最新的文獻掌握最新趨勢及研究過程恪遵專業倫理並瞭解社會責任的重要性。",
      "describe_en": "Be able to read the latest literature to grasp the latest trends and research process, abide by professional ethics and understand the importance of social responsibility."
    },
    {
      "seq": 5,
      "describe_ch": "具備專業領域蒐集資料、規範問題及分析驗證考等能力，並應用於碩士論文研究中。",
      "describe_en": "Be ability to collect data, standardize problems and analyze verification tests in the professional field, and apply them to the research of master's thesis."
    },
    {
      "seq": 6,
      "describe_ch": "知道於如何找到碩士論文主題內容的相關資訊和研究結果，並能夠運用相關的方法持續改善。",
      "describe_en": "Be be able to find relevant information and research results on the subject content of a master's thesis, and be able to use relevant methods for continuous improvement."
    }
  ],
