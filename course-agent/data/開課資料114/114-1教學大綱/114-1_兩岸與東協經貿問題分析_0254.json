  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB02139",
    "sub_id": "22152",
    "scr_dup": "001",
    "sub_title": "運用三個層次的分析來探討台灣海峽兩岸及東協的經濟與貿易相關議題 (To employ three levels of analysis to analyse the economic and trade-related issues across the Taiwan Straits and ASEAN.)",
    "sub_title_en": null,
    "sub_describe": "這是一種方法論上的啟發式工具；所有國際關係與國際企業領域的學生與學者都能從學習過程中獲益。臺灣的企業家應當依循自身的步伐，引領臺灣從亞太地區邁向超越臺灣本身的世界社會。此外，我們應當確認，跨國企業與國家同樣是國際社會的主體。國家仍然是核心行為者；與此同時，在全球政治經濟架構下，企業不僅是經濟夥伴，更是處於轉型中的世界秩序的規範共同建構者。(This is a heuristic tool in methodology; all the students and scholars in IR and International Business can benefit from the learning process. Taiwanese businesspeople should follow their own steps to lead Taiwan from Asia-Pacific towards the world society beyond Taiwan per se. In addition, we should ascertain that multinational corporations, as well as states, are the subjects of international society. The state remains a central actor. Alongside the global political economy, businesses are not merely economic partners, but also normative co-constituents of a world order in transformation.)",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "兩岸與東協經貿問題分析",
    "sub_ename": "ANALYSIS OF THE CROSS-STRAITS AND ASEAN ECONOMIC PROBLEMS",
    "describe_ch": "本課程探討兩岸與東協間總體經濟情勢與發展，內容涵蓋外國在大陸與東協國家投資的分析，從兩岸到東協國家投資發展策略與產業分工，大陸對外經貿發展策略（例如一帶一路），及人民幣(RMB)匯率自由化的評估等。",
    "describe_eh": "Macroeconomic situations and trends among Taiwan, China and ASEAN countries, The impact of the business relation between cross-strait and ASEAN on global economy. Coverages include in international trade and international investment, analysis of foreign investment in China and ASEAN countries, cross-strait investment strategies and industrial division, perspective of new development in mainland China's macroeconomic controls, assessment of the RMB exchange rate.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "兩岸及東協經貿關係對國際經濟的影響",
      "describe_en": "The impact of the business relation between cross-strait and ASEAN on global economy."
    }
  ],
