  "description": {
    "sub_id3": null,
    "sub_name": "科技英文",
    "sub_ename": "ENGLISH FOR TECHNOLOGY",
    "describe_ch": "本課程的目的是要介紹學生認識科技英文的各種形式、寫作格式及專業名詞，並藉由大量實作訓練，使學生具備閱覽、朗讀科技英文並正確翻譯成中文之能力。",
    "describe_eh": "This course is designed to promote graduate students' ability to peruse, read and translate the scientific articles written in English. In addition to analyzing the grammar, various styles and formats of scientific documents as well as the related terminology will be introduced to the students. It is hoped that through intensive practice, the students will be rendered the capability of reading and translating scientific English.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.熟悉光電相關之英文詞彙",
      "describe_en": "1.Be familiar with the photonics-related terminology in English."
    },
    {
      "seq": 2,
      "describe_ch": "2.熟悉各種不同類型的科技英文文獻格式",
      "describe_en": "2. Be familiar with various formats and styles of scientific documents in English."
    },
    {
      "seq": 3,
      "describe_ch": "3.知道如何撰寫符合國際期刊格式",
      "describe_en": "3.Know how to write scientific documents for international journal paper."
    },
    {
      "seq": 4,
      "describe_ch": "4.具備正確翻譯光電相關英文文獻之能力",
      "describe_en": "4. know how to correctly translate English photonics-related documents into Chinese."
    }
  ],
