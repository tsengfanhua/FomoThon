  "description": {
    "sub_id3": null,
    "sub_name": "非營利組織與管理",
    "sub_ename": "NON-PROFIT ORGANIZATION AND MANAGEMENT",
    "describe_ch": "透過互動式學習模式，讓學習者認識非營利或政府組織及其經營管理之理論與實務。主要內容包括：非營利部門組織與運作模式、非營利組織的經營管理、及國內外非營利組織個案專題研討。",
    "describe_eh": "Students have knowledge and application ability about nonprofit organization and nonprofit management. Course Topics: 1.Understanding Nonprofit Organizations, 2.The Board, 3.Assembling the Workforce, 4.Personnel Policy, 5.Marketing, 6.Financial Management, 7.Financial Statements and Fiscal Procedures, 8.Fund Raising, 9.Planning, 10.Sustainability and Leadership, 11.Making Things Better.",
    "pre_subname": "MGT1001管理學、COOP1011社會事業",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT、COOP1011 SOCIAL BUSINESS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
