  "description": {
    "sub_id3": null,
    "sub_name": "程式設計與應用",
    "sub_ename": "PROGRAMMING DESIGN AND APPLICATION",
    "describe_ch": "介紹結構性之程式語言，課程內容包括了語言本身之語法、各運算子、資料型式、及各設計應用之用法。內容亦包含宣告、運算敘述、程式區段結構、函數、陣列、及指標。強調應用程式語言解決工程問題之能力。",
    "describe_eh": "The course targets at introducing the programming language, which is structured portable and exists on all types of computer systems. This course covers the syntax，the set of operators, and the variety of data types and usage of the language in design applications. Courses cover the topics of all declarations, expressions, control flow statements, functions, array, and pointer. Emphases are placed upon the capability of using the programming language for engineering problem solving.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "建構基礎之電腦語言邏輯。",
      "describe_en": "To establish the basic logic in computer programming languages."
    },
    {
      "seq": 2,
      "describe_ch": "能以程式語言執行數學運算及邏輯概念。",
      "describe_en": "Be capable of executing mathematic operations and logistic concepts by programming languages"
    },
    {
      "seq": 3,
      "describe_ch": "有能力以程式語言設計程式以解決基礎課程之工程問題。",
      "describe_en": "To use programming language to write a program that can do simple problem solving for basic engineering courses."
    },
    {
      "seq": 4,
      "describe_ch": "理解程式語言在解決工程問題所扮演之重要性與其不足處。",
      "describe_en": "To comprehend the importance of the programming languages in solving engineering problem and its insufficiency."
    }
  ],
