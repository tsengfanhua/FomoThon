  "iSoftwares": [
    {
      "yms_year": 114.0,
      "yms_smester": 1.0,
      "cls_id": "CE3031A",
      "sub_id": "08961",
      "scr_dup": "001",
      "seq_no": 1,
      "soft_kind": "2",
      "soft_name": "R-語言",
      "soft_memo": "<div><strong>R語言是</strong>一種<a href=\"https://zh.wikipedia.org/wiki/%E8%87%AA%E7%94%B1%E8%BB%9F%E9%AB%94\">自由軟體</a><a href=\"https://zh.wikipedia.org/wiki/%E7%A8%8B%E5%BC%8F%E8%AA%9E%E8%A8%80\">程式語言</a>與操作環境，主要用於<a href=\"https://zh.wikipedia.org/wiki/%E7%BB%9F%E8%AE%A1\">統計</a>分析、繪圖以及<a href=\"https://zh.wikipedia.org/wiki/%E6%95%B0%E6%8D%AE%E6%8C%96%E6%8E%98\">資料探勘</a>。R由<a href=\"https://zh.wikipedia.org/wiki/%E6%96%B0%E8%A5%BF%E8%98%AD\">紐西蘭</a><a href=\"https://zh.wikipedia.org/wiki/%E5%A5%A7%E5%85%8B%E8%98%AD%E5%A4%A7%E5%AD%B8\">奧克蘭大學</a>的統計學家<a href=\"https://zh.wikipedia.org/wiki/%E7%BD%97%E6%96%AF%C2%B7%E4%BC%8A%E5%93%88%E5%8D%A1\">羅斯&middot;伊哈卡</a>和<a href=\"https://zh.wikipedia.org/wiki/%E7%BD%97%E4%BC%AF%E7%89%B9%C2%B7%E6%9D%B0%E7%89%B9%E6%9B%BC\">羅伯特&middot;傑特曼</a>開發，現在由R核心小組負責開發，同時也有其他使用者編寫了諸多外掛的<a href=\"https://zh.wikipedia.org/wiki/%E8%BD%AF%E4%BB%B6%E5%8C%85\">軟體套件</a>。R以<a href=\"https://zh.wikipedia.org/wiki/S%E8%AA%9E%E8%A8%80\">S語言</a>為基礎，其詞法作用域語意來自<a href=\"https://zh.wikipedia.org/wiki/Scheme\">Scheme</a>。R的後台程式大多由<a href=\"https://zh.wikipedia.org/wiki/C%E8%AF%AD%E8%A8%80\">C語言</a>、<a href=\"https://zh.wikipedia.org/wiki/Fortran\">FORTRAN語言</a>和R自己寫成。</div>\n\n<div>R語言是<a href=\"https://zh.wikipedia.org/wiki/GNU%E8%A8%88%E5%8A%83\">GNU計劃</a>的一個專案，所以其<a href=\"https://zh.wikipedia.org/wiki/%E5%8E%9F%E5%A7%8B%E7%A2%BC\">原始碼</a>可自由下載使用。R也有已編譯的<a href=\"https://zh.wikipedia.org/wiki/%E5%9F%B7%E8%A1%8C%E6%AA%94\">執行檔</a>版本可以下載，可在多種平台下執行，包括<a href=\"https://zh.wikipedia.org/wiki/UNIX\">UNIX</a>（也包括<a href=\"https://zh.wikipedia.org/wiki/FreeBSD\">FreeBSD</a>和<a href=\"https://zh.wikipedia.org/wiki/Linux\">Linux</a>）、<a href=\"https://zh.wikipedia.org/wiki/Microsoft_Windows\">Windows</a>和<a href=\"https://zh.wikipedia.org/wiki/MacOS\">MacOS</a>。<a href=\"https://zh.wikipedia.org/zh-tw/R%E8%AF%AD%E8%A8%80#cite_note-:02-8\">[8]</a>R可以以<a href=\"https://zh.wikipedia.org/wiki/%E5%91%BD%E4%BB%A4%E8%A1%8C%E7%95%8C%E9%9D%A2\">命令列</a>操作，<a href=\"https://zh.wikipedia.org/zh-tw/R%E8%AF%AD%E8%A8%80#cite_note-:02-8\">[8]</a>同時有人開發了幾種<a href=\"https://zh.wikipedia.org/wiki/%E5%9C%96%E5%BD%A2%E7%94%A8%E6%88%B6%E7%95%8C%E9%9D%A2\">圖形使用者介面</a>，其中包括<a href=\"https://zh.wikipedia.org/wiki/RStudio\">RStudio</a><a href=\"https://zh.wikipedia.org/zh-tw/R%E8%AF%AD%E8%A8%80#cite_note-:02-8\">[8]</a>與<a href=\"https://zh.wikipedia.org/wiki/Jupyter\">Jupyter</a>。</div>\n\n<div>&nbsp;</div>\n\n<div>擷取自維基百科:&nbsp;https://zh.wikipedia.org/zh-tw/R%E8%AF%AD%E8%A8%80</div>\n",
      "soft_name_en": null,
      "soft_memo_en": null
    }
  ],
