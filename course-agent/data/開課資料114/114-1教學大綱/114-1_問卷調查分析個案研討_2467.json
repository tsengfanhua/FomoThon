  "description": {
    "sub_id3": null,
    "sub_name": "問卷調查分析個案研討",
    "sub_ename": "CASE STUDY OF QUESTIONNAIRE INVESTIGATION",
    "describe_ch": "本課程內容包含問卷之設計、量表之建構、個案資料之分析與解讀。本課程透過相關統計軟體之實作練習，帶領學生完成個案資料之分析，學生一方面可認識相關統計軟體之分析功能，另一方面熟悉統計方法在問卷分析上之應用。",
    "describe_eh": "This course contains the design of questionnaire, the construction of scale measurement, as well as the analysis and interpretation of case data. Practical data analyses are conducted by popular statistical software. Students are expected to perform statistical analyses of questionnaire using softwares.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解問卷調查綱要步驟及其相關統計分析方法",
      "describe_en": "Comprehension of survey key line, procedure, and favored statistical techniques."
    },
    {
      "seq": 2,
      "describe_ch": "能應用相關統計軟體進行問卷資料分析",
      "describe_en": "Application of statistical software in the analysis of survey data."
    }
  ],
