  "description": {
    "sub_id3": null,
    "sub_name": "測量學",
    "sub_ename": "SURVEYING",
    "describe_ch": "測量學為工程建設之基礎科學，例如土木工程、建築工程、交通工程等等皆需藉由測量學理論與實務操作得到工程設計與施工所需之基本資料。本課程旨在使學生瞭解測量原理、作業技術與製圖方法，熟練測量儀器操作及維護，使理論與實際結合。",
    "describe_eh": "Surveying is a fundamental subject in engineering construction topics in order to collect the geo-spatial data and information for supporting such as civil engineering, architectural engineering, and traffic engineering, etc. The objective of this course is to present the principles, operations, and mapping methods in the Surveying. In addition, the students can learn the skills of operating and maintaining the instruments to further connect with the surveying theory and practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解測量原理、作業技術及誤差傳播定律",
      "describe_en": "Students can understand the principles, operations, and concept of error propagation of the Surveying."
    },
    {
      "seq": 2,
      "describe_ch": "熟練各種測量儀器之操作",
      "describe_en": "Students can learn the operations of instruments."
    },
    {
      "seq": 3,
      "describe_ch": "利用測量數據計算成果",
      "describe_en": "Students can collect and calculate the field data."
    }
  ],
