  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CH00101",
    "sub_id": "00089",
    "scr_dup": "001",
    "sub_title": "生成式AI與人文創新、AI賦能的社會議題分析、跨領域AI內容生成與應用設計。",
    "sub_title_en": null,
    "sub_describe": "1. 探討生成式AI如何應用於文學、歷史、藝術與文化領域，並提升人文內容創作與研究的價值。\n2. 運用生成式AI進行社會議題（如環境永續、文化保存、數位公平等）的文本分析與內容生成，提出創新解決方案。\n3. 透過設計思考（Design Thinking）與CDIO（Conceive-Design-Implement-Operate）方法，規劃並開發具應用價值的AI數位內容。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "人文與科技：生成式AI跨域應用",
    "sub_ename": "HUMANITIES AND TECHNOLOGY : CROSS-DISCIPLINARY",
    "describe_ch": "人文學科和AI科技的交融已成為新趨勢，掌握基本的人工智慧與數位技能是必備的新資訊科技素養。課程將介紹「生成式人工智慧」（Generative AI）的基本原理、創新技術和應用發展；接續介紹生成式AI在人文議題的多方應用，包括：文本創作、知識深度研究、語音生成、圖文創作、藝術創作，以及倫理與偏誤等問題，開闊以人為本的生成式AI技術在人文領域應用的創新思維。",
    "describe_eh": "The fusion of humanities and AI technology marks a new trend, making basic AI and digital skills essential IT literacy. This course introduces Generative AI's principles, innovations, and applications, then delves into its use in humanities, covering text creation, deep knowledge research, voice generation, image-text creation, artistic creation, and issues ethics and bias. It aims to broaden innovative thinking in applying human-centric Generative AI in the humanities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養人文與科技之跨域融合的STEAM能力",
      "describe_en": "Cultivating the STEAM capabilities of interdisciplinary integration between humanities and technology."
    },
    {
      "seq": 2,
      "describe_ch": "開闊以人工智慧技術在人文領域應用的創新思維",
      "describe_en": "Generating AI innovation applications with value in the humanities."
    }
  ],
