  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "NM09110",
    "sub_id": "31257",
    "scr_dup": "001",
    "tpa_score_new": "<div>A. Midterm Exam (25%), Final Exam (25%), Attendance (10%), &nbsp;Homework&nbsp; assignments (10%), Impression score (2%), In-class performance (10%)</div>\n\n<div>B. Teaching Assistant (12%), Quizzes (6%）</div>\n",
    "tpa_score_new_en": " ",
    "course_pol": "1) Be on time for the class; if you are 20 minutes late, you will be marked as absent for one hour.\n2) Be sure to hand in any assignment on time. We do not accept any delayed assignments.\n3) Regularly do homework after class. Do your own homework! You may discuss your homework problems with your classmates, but copying homework is prohibited.\n4) You must visit and ask questions of your TA at least four times for this class.\n5) Anyone who violates the test regulations will be subject to the FCU test regulations.",
    "course_pol_en": null,
    "course_rem": "1) Be honest during tests.  Anyone who violates the test regulations will be subject to the FCU test regulations. \n2)You may contact me via email : jlyu@gm.pu.edu.tw.",
    "course_rem_en": null,
    "ais_meno": "<div>1) Be on time for the class; if you are 20 minutes late, you will be marked as absent for one hour.</div>\n\n<div>2) Be sure to hand in any assignment on time. We do not accept any delayed assignments.</div>\n\n<div>3) Regularly do homework after class.&nbsp;Do your own homework! You may discuss your homework problems with your classmates, but copying homework is prohibited.</div>\n\n<div>4) You must visit and ask questions of your TA at least four times for this class.&nbsp; &nbsp;</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": "N"
  },
