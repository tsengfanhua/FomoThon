    "sub_name": "商學微積分",
    "sub_ename": "CALCULUS FOR BUSINESS AND AVIATION",
    "describe_ch": "Calculus is a course provides basic training in mathematics. It involves the differentiation and the integration. These are used to solve problems via geometry and algebra. Calculus has a lot of\r\napplications in many fields, such as science, business, economics and management. The materials in Calculus for Business and Aviation include the functions and graphs, limits of functions, the derivatives, the integrals, the partial differentiation\r\n",
    "describe_eh": "Calculus is a course provides basic training in mathematics. It involves the differentiation and the integration. These are used to solve problems via geometry and algebra. Calculus has a lot of\r\napplications in many fields, such as science, business, economics and management. The materials in Calculus for Business and Aviation include the functions and graphs, limits of functions, the derivatives, the integrals, the partial differentiation\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
