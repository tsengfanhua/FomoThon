  "description": {
    "sub_id3": null,
    "sub_name": "投資管理",
    "sub_ename": "INVESTMENT MANAGEMENT",
    "describe_ch": "本課程目的在於介紹投資管理相關理論與市場的知識，議題包括金融工具、投資機構、CAPM與APT、債券投資組合的管理、總體與產業分析、財務報表分析、衍生性商品市場、以及投資組合的管理績效等等。",
    "describe_eh": "The course introduces knowledge of important theories and markets in the field of investment management. Main topics include: financial instruments, mutual funds and other investment institutions, capital asset pricing and arbitrage pricing theory, managing bond portfolios, macroeconomic and industry analysis, financial statement analysis, derivative markets, performance evaluation, and active portfolio management.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
