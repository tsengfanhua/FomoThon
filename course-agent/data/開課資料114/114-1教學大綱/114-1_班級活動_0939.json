    "scr_dup": "001",
    "tpc_seq": 1,
    "tpc_book": "<div>\n<div>\n<div>課堂的學習有其限制，同學在實際活動中加以延伸並廣泛應用。如此獲得實證知識 ，印象更為深刻。</div>\n</div>\n</div>\n",
    "tpc_book_en": " "
  },
