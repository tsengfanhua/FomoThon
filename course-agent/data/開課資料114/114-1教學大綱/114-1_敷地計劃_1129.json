  "description": {
    "sub_id3": null,
    "sub_name": "敷地計劃",
    "sub_ename": "SITE PLANNING",
    "describe_ch": "本課程教授學生學習由基地環境與使用者需求思索設計解答構想或策略，並從整體環境觀點提出建築設計方案，使新建築物能與其周圍環境和諧共處。\n",
    "describe_eh": "The course is intended to instruct students to incubate their concepts or strategies derived from both an existing site context and its users’ requirement when dealing with schematic design and to manipulate building design in the light of the whole environment. In doing so, their proposed buildings may be in harmony with their environments.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
