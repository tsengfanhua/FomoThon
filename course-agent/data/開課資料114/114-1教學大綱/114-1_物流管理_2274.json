  "description": {
    "sub_id3": null,
    "sub_name": "物流管理",
    "sub_ename": "LOGISTICS MANAGEMENT",
    "describe_ch": "物流管理是一套如何整合供應商、製造商、零售商、倉儲業者，提供在正確時間供給正確數量給顧客，期望能以最低成本，達成顧客的服務水準。",
    "describe_eh": "Logistics is a set of approaches utilized to efficiently integrate suppliers, manufacturers, warehouses, and stores, so that merchandise is produced and distributed at the right quantities, to the right locations, and at the right time, in order to minimize system-wide costs while satisfying service level requirements.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
