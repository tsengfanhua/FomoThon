  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "坡地保育規劃與設計",
    "sub_ename": "CONSERVATION PLANNING AND DESIGN ON SLOPELAND",
    "describe_ch": "瞭解坡地環境整體之規劃設計理念、方法、及內容，訓練學生在未來進行坡地保育規劃設計時，能決定適當之土地利用方式及具有保育防災所需之學理與技術。",
    "describe_eh": "This course is designed to introduce the concepts, methods, and content of conservation practices for comprehensive planning and design on slopeland conservation. The principles and technologies of sustainable land use and/or disaster prevention are the fundamental disciplines.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解坡地保育規劃設計的概念、法規及所需的基本資料\t",
      "describe_en": "Comprehension for the concepts, regulations and basic information of the conservation planning and design on slopeland"
    },
    {
      "seq": 2,
      "describe_ch": "理解山坡地土砂災害之特性、坡地保育的重要性及坡地災害防治方法\t",
      "describe_en": "Comprehension for the characteristics of hillsides sediment disasters, importance of slopeland conservation and methods of slopeland disaster prevention"
    },
    {
      "seq": 3,
      "describe_ch": "應用網路環境及相關軟體進行坡地保育規劃資料蒐集與設計分析\t",
      "describe_en": "To apply the internet and related software for the data collection, analysis and design of the slopeland conservation planning"
    },
    {
      "seq": 4,
      "describe_ch": "應用坡地保育基本知識及技術解決實務上坡地規劃設計之問題\t",
      "describe_en": "To apply the conservation basic knowledge and techniques for the practical planning and design on slopeland areas"
    }
  ],
