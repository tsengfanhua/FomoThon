  "description": {
    "sub_id3": null,
    "sub_name": "色彩工程學",
    "sub_ename": "COLOR ENGINEERING",
    "describe_ch": "在本課程中，首先介紹輻度學基本原理，再介紹視光學相關概念，進而揭露光度學之相對應原理，最後學習色度學之相關定義、原理與應用。",
    "describe_eh": "In the course, firstly, the basic principles of radiometry are introduced. Then the related concepts of optometry are introduced. Accordingly, the corresponding principles of photometry are exposed. Finally, the related definitions, principles, and applications of colorimetry are studied.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉輻度學與光度學的基本觀念。",
      "describe_en": "Be familiar with the fundamental concepts of radiometry and photometry."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉視光學的基本概念",
      "describe_en": "Be familiar with the fundamental concepts of optometry"
    },
    {
      "seq": 3,
      "describe_ch": "熟悉色度學的基本觀念",
      "describe_en": "Be familiar with the fundamental concepts of colorimetry."
    },
    {
      "seq": 4,
      "describe_ch": "具環境永續概念之色彩工程應用。",
      "describe_en": "Apply color engineering with the concept of environmental sustainability."
    }
  ],
