  "description": {
    "sub_id3": null,
    "sub_name": "英美法導論",
    "sub_ename": "INTRODUCTION TO ANGLO-AMERICAN LAW",
    "describe_ch": "本課程之目標是幫助學生學習英美法系之重要法理與概念，比如英美法系之發展、美國民事法、英美刑事訴訟法、美國司法制度等。",
    "describe_eh": "The goal of this course is to help students learn important legal theories and concepts of the Anglo-American legal system, such as the development of the Anglo-American legal system, American civil law, Anglo-American criminal procedure law, and the American judicial system.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉並了解英美法基本概念。",
      "describe_en": "Understand the basic structure of angol-american law."
    },
    {
      "seq": 2,
      "describe_ch": "熟悉並了解有關美國之法律規定、案例與司法體制。",
      "describe_en": "Understand the legal provisions, cases and judicial system of the United States."
    }
  ],
