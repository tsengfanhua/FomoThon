  "description": {
    "sub_id3": null,
    "sub_name": "刑法總則",
    "sub_ename": "CRIMINAL LAW: THE GENERAL PART",
    "describe_ch": "刑事實體法的基本課程，目的在讓學生瞭解刑事責任的基本原則。加以詳細討論的主題有：行為理論、故意與過失、因果關係、錯誤、違法性、罪責、既遂與未遂犯理論、共犯責任、競合。課程的進行除了檢討刑法典的相關條文、法院判決外，還包括目前學說的研究。本課程是刑法分則的先修課程。",
    "describe_eh": "This is the basic course in the substantive criminal law.  The course seeks to make students understand the general principles of criminal liability. Selected topics are subjected to detailed analysis, including mens rea, actus reus, causation, mistake, attempt, inchoate crimes, conspiracy, accomplice liability.  Necessary analysis is developed along with relevant provisions of the Taiwan Penal Code and court decisions.  It will also survey the current literature.  This course is a prerequisite for the Criminal Law: The Special Part.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉並了解刑事實體法基本概念。",
      "describe_en": "Understand the basic structure of substantive criminal law.\n"
    },
    {
      "seq": 2,
      "describe_ch": "熟悉並了解行為理論、故意與過失議題。",
      "describe_en": "Understand the topics of mens rea, actus reus, causation."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉並了解錯誤、違法性、罪責議題。",
      "describe_en": "Understand the topics of mistake, attempt."
    },
    {
      "seq": 4,
      "describe_ch": "熟悉並了解既遂與未遂犯理論、共犯責任、競合。",
      "describe_en": "Understand the topics of inchoate crimes, conspiracy, accomplice liability."
    }
  ],
