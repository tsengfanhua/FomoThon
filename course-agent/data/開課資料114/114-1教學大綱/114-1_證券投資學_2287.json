  "description": {
    "sub_id3": null,
    "sub_name": "證券投資學",
    "sub_ename": "SECURITIES  INVESTMENT",
    "describe_ch": "介紹證券市場的交易制度與投資人的行為。希望透過課程的介紹與習題的實作讓同學具備閱讀證券版的能力、建立基本的技術分析的能力與具備分析上市公司價值與價格的基本能力。",
    "describe_eh": "The trading system of TSE and behavior of investors in Taiwan will be introduced in the class. Learn to understand the market, to time the market by technical analysis and to estimate the Value of the firm in the market are the main targets of this class. Every student needs to present the valuation of a corporation in TSE to show their abilities either in financial statements analysis or industry analysis.",
    "pre_subname": "ECON1001經濟學(一)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能運用基本理論與實務的專業能力。",
      "describe_en": "Apply the fundamental principles of quality control and its practical application ."
    },
    {
      "seq": 2,
      "describe_ch": "能了解並說明證券投資學在社會及經濟層面的重要性及影響。",
      "describe_en": "Understand and be able to explain the importance and effect of SECURITIES    INVESTMENT to society and economy.\r\n企業管理學系教育核心能力\r\n"
    }
  ],
