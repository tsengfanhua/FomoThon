  "description": {
    "sub_id3": null,
    "sub_name": "共同基金",
    "sub_ename": "MUTUAL FUND",
    "describe_ch": "本課程著重於共同基金投資實務應用，以及國內、外共同基金市場之分析，其主要內容包括：國內、外基金型態分析與重點基金介紹；共同基金風險與報酬分析；國內、外基金投資策略；模擬國內、外共同基金資產配置；小額理財「平均成本法」實證分析與操作策略；私人信託介紹等。\r\n",
    "describe_eh": "This course focuses on the investment practice of mutual fund and analysis of the domestic and offshore fund market. Topics include the introduction of domestic and offshore fund structure and key funds; The analysis of mutual funds' risk and return; Domestic and offshore fund investment strategy and tactics; Domestic and offshore fund assets allocation and simulation ; Introduction of \"average cost investment style\" case study and investment strategy ; Introduction of private trust.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能建立正確理財觀念與投資技巧",
      "describe_en": "Build up right investment conceptual and investment skill ."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解國內、外基金類型與重點基金",
      "describe_en": "Understand the domestic and offshore fund type and key funds."
    },
    {
      "seq": 3,
      "describe_ch": "能瞭解如何判斷共同基金風險與報酬",
      "describe_en": "Understand how to evaluate risk and return of the mutual fund."
    },
    {
      "seq": 4,
      "describe_ch": "能瞭解如何判斷國內、外基金績效",
      "describe_en": "Understand how to trace the performance of the domestic and offshore fund."
    }
  ],
