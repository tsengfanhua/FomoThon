    "sub_name": "工程數學(一)",
    "sub_ename": "ENGINEERING MATHEMATICS(1)",
    "describe_ch": "目標是使學生瞭解工程數學。內容包含方程式、微分方程式及其應用等。",
    "describe_eh": "The objective is to understand engineering mathematics. The contents include equations, differential equations and their applications.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂工程數學：能夠描述重要的工程數學原理；能辨識出可使用工程數學原理的場合，並能清楚表達。",
      "describe_en": "Be able to define Engineering Mathematics with students own words: Be able to describe important principles of Engineering Mathematics. Be able to Distinguish and make clear statement where Engineering Mathematics can be used."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明工程數學在其他學科的重要性及影響",
      "describe_en": "Be able to understand and explain the importance and effects of Engineering Mathematics"
    },
    {
      "seq": 3,
      "describe_ch": "規劃系統整合之能力",
      "describe_en": "Be able to plan integrated Systems."
    },
    {
      "seq": 4,
      "describe_ch": "設計、執行實驗與數據分析，及製商整合的能力。",
      "describe_en": "Be able to analyze experimental data and integrated systems."
    }
  ],
