  "description": {
    "sub_id3": null,
    "sub_name": "營建財務概論",
    "sub_ename": "INTRODUCTION TO CONSTRUCTION FINANCE",
    "describe_ch": "本課程之主要內容乃針對營建業之產業特性，提供相關會計處理及財務理論之初步介紹，以使學生具備營建財務管理之基本知識與進階學習之能力。",
    "describe_eh": "The main contents of this course based on the construction industry characteristics introduce accounting concepts and corporate finance to equip students with basic knowledge of financial management of construction and advanced learning capabilities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解財務管理基礎與企業角色",
      "describe_en": "Comprehension for financial management and corporate roles in industry"
    },
    {
      "seq": 2,
      "describe_ch": "理解會計概念與財務報表分析",
      "describe_en": "Comprehension for accounting concepts and analysis of financial statements"
    },
    {
      "seq": 3,
      "describe_ch": "理解風險、評價與決策",
      "describe_en": "Comprehension for investment risk , evaluation and decision-making"
    }
  ],
