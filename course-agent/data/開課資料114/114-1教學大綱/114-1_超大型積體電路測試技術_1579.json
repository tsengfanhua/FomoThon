  "description": {
    "sub_id3": null,
    "sub_name": "超大型積體電路測試技術",
    "sub_ename": "VLSI TEST TECHNOLOGY",
    "describe_ch": "陳述積體電路與晶圓測試原理、系統晶片(SoC)測試技術，能概述運用電路測試與電路設計之驗證與改善，測試機台介紹與應用、未來奈米技術的測試趨勢與發展。實施案例說明與問題討論。",
    "describe_eh": "Present the VLSI, wafer, and SoC testing principle and techniques, including the correlations between testing to IC design process, tester introduction, and the evolution of testing for the ICs using the nanodevice technology. Case studies are also explained and discussed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解系統晶片之測試技術與方法。",
      "describe_en": "Understand the testing techniques and methodologies of SoC designs."
    },
    {
      "seq": 2,
      "describe_ch": "應用系統晶片測試方法建構高效能自動化測試樣本產生器。",
      "describe_en": "Construct an efficient Automated Testing Pattern Generator (ATPG) by applying the principles of VLSI testing."
    }
