  "description": {
    "sub_id3": null,
    "sub_name": "環境經濟學",
    "sub_ename": "ENVIRONMENTAL ECONOMICS",
    "describe_ch": "本課程設計的主要目標，是在呈現並清楚的瞭解當代自然資源的議題與環境政策的考量，其中最重要的經濟與生態原理。人類經濟活動與自然資源有非常密切的關係，自然環境提供人類經濟活動所需的各種資源和原料，人類利用勞力、技術以及生產設備將這些資源和原料製成消費品提供生活使用，當經濟成長與生態保育、環境保護無法兼容並蓄時，如何以環境經濟理論來解決人類所面臨最棘手的問題，是本課程規劃的宗旨，期在系統性的研討分析中，以宏觀的角度，重新詮釋環境保護活動可以推動經濟成長，經濟成長更可以支持生態保育，並以先進國家為例，說明抑制污染源與改善人類生活品質的成就，作為制定環境政策的參考。",
    "describe_eh": "This course is based on the assumption that there is close relationship between environment and economic activities. The field of study which explores this growing orientation between the natural environment and artificial goods or activities is called environmental economics. This course examines the methods used to assess economic development when the tough issues of natural resources and environmental protection come with. Students will learn the skills, knowledge, attitudes and roles of environmental economic analysis. In addition students will discuss the cases and implications relevant to the subject so as to inspire their brainpower.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認知當代自然資源的議題。",
      "describe_en": "Understand present issues of natural resource."
    },
    {
      "seq": 2,
      "describe_ch": "\n認知環境保護與經濟發展的相對價值判斷。",
      "describe_en": "Recognize the relative merits of environmental protection and the economic development."
    },
    {
      "seq": 3,
      "describe_ch": "體認生態保育是永續人類生命的不二法門,任何動作技術都應以此為導。",
      "describe_en": "Recognize that ecological protection is the only way to sustain human life. Any activities or technological applications  should take this into account."
    }
  ],
