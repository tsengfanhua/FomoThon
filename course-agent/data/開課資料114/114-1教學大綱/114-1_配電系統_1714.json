  "description": {
    "sub_id3": null,
    "sub_name": "配電系統",
    "sub_ename": "DISTRIBUTION OF POWER SYSTEM",
    "describe_ch": "本課程提供一配電系統分析的進階課程,課程內容包括配電系統規劃、負載特性介紹、配電變壓器之應用、一次系統及二次系統配電線路及變電所設計、電壓降級線路損失計算、電容器之應用、配電系統諧波分析、電壓調整率計算、配電系統保護及可靠度分析等。",
    "describe_eh": "This course is intend to serve as an advanced distribution power system analysis course, that includes distribution system planning, load characteristics, application of distribution transformers, design of subtransmission lines, distribution substations, primary system and secondary system; voltage drop and power-loss calculations; application of capacitors; harmonics on distribution systems; voltage regulation; and distribution protection and reliability.",
    "pre_subname": "EEEN2008電路學(一)、EEEN2009電路學(二)、EEEN3019電機機械 (一)、EEEN3020電機機械 (二)",
    "pre_sub_id3": "EEEN2008",
    "pre_sub_ename": "EEEN2008 CIRCUIT THEORY(1)、EEEN2009 CIRCUIT THEORY(2)、EEEN3019 ELECTRIC MACHINES (1)、EEEN3020 ELECTRIC MACHINES (2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解配電系統之架構與分析技術",
      "describe_en": "To know the structure of distribution power system and analysis technique of distribution power system."
    },
    {
      "seq": 2,
      "describe_ch": "應用電路學知識分析配電系統",
      "describe_en": "To apply the knowledge of engineering circuit to analyze distribution power system."
    },
    {
      "seq": 3,
      "describe_ch": "分析配電系統之可靠度及保護",
      "describe_en": "To analyze the reliability and protection of distribution power system."
    }
  ],
