  "description": {
    "sub_id3": null,
    "sub_name": "高階工程管理專題講座",
    "sub_ename": "SPECIAL TOPICS ON ADVANCED ENGINEERING MANAGEMENT",
    "describe_ch": "本課程旨在學習與了解高階工程管理方法與相關議題，培養學生發掘經營管理相關問題，以提升分析力、組織力、溝通力與決策力，成為全方位的領導人。",
    "describe_eh": "This course aims to learn and understand the methods and skills of advanced engineering management.  To promote students' core competencies to be able to explore issues of operation, and also to increase the power of analysis, organization, communication and decision-making, that will truly be a comprehensive leader.\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解與說明組織中有關高階工程管理之理論、原則、與實務等方面之重要知識。",
      "describe_en": "Understand and explain the important knowledge about the organizational aspects, such as high-end engineering management theory, principles, and practices of."
    },
    {
      "seq": 2,
      "describe_ch": "能認識當代生產管理議題，瞭解高階工程管理技術對環境、社會及全球的影響，及培養持續學習能力。",
      "describe_en": "To recognize the contemporary production management issues, understand the impact of technology on the high-end engineering management of environmental, social and globally, and foster continuous learning ability"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解高階工程管理方法與相關議題，蒐集相關議題資料並進行分析推論。",
      "describe_en": "Understand the high-level project management methods and related issues, collect relevant topic materials and make analysis and inferences."
    }
  ],
