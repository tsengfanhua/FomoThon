  "description": {
    "sub_id3": null,
    "sub_name": "都市設計",
    "sub_ename": "URBAN DESIGN",
    "describe_ch": "本課程結合既有之都市計畫理論基礎與基本設計，探討由各種不同觀點提出的都市設計理論，提升對於都市空間尺度的觀察、分析、論述、設計能力。針對現行制度框架、各種管制與獎勵準則的擬定，銜接學生於公部門及產業界之就業需求。",
    "describe_eh": "Combined urban planning theory and basic design operating skills, study different point of view in urban design Theories. To improve observation, analysis, argumentation and design ability in urban space.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備都市設計專業理論知識",
      "describe_en": "With professional knowledge of urban design theories"
    },
    {
      "seq": 2,
      "describe_ch": "具解決實務問題的能力",
      "describe_en": "Ability to solve problems in practice"
    },
    {
      "seq": 3,
      "describe_ch": "具備跨領域知識整合應用技能",
      "describe_en": "Ability to integrate and implement of inter-disciplinary knowledge."
    }
  ],
