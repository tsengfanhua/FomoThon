  "description": {
    "sub_id3": null,
    "sub_name": "密碼學",
    "sub_ename": "CRYPTOGRAPHY",
    "describe_ch": "本課程在於概述密碼學及其相關應用的基礎知識。課程內容含蓋了數論原理以及相關密碼學相關演算法，包括了：隱藏術、區塊/串流加密、對稱式加密、質數、亂數、因數分解、離散對數、公開金鑰加密、金鑰管理、雜湊函數、數位簽章、以及憑證與相關認證協定。",
    "describe_eh": "This course provides a foundation in cryptography, and covers principles of number theory and cryptographic algorithms. Topics include: steganography, block and stream ciphers, Symmetric encryption (DES, AES), primes, random numbers, factoring, and discrete logarithms; Public key encryption (RSA, Diffie-Hellman, Elliptic curve cryptography); Key management, Hash functions (MD5, SHA-1, HMAC), Digital signatures, Certificates and Authentication protocols.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備密碼學的基礎知識",
      "describe_en": "The basic knowledge of cryptography."
    },
    {
      "seq": 2,
      "describe_ch": "應用所學密碼學原理至新的資訊安全問題。",
      "describe_en": "Apply the principles of cryptography for solving information security problems."
    }
  ],
