    {
      "seq": 1,
      "describe_ch": "能夠理解不同模型所呈現結果的差異性",
      "describe_en": "demonstrate the difference between 3-D solid or surface modeling and parametric object-oriented modeling"
    },
    {
      "seq": 2,
      "describe_ch": "能夠應用語意資料轉化為參數模型資料",
      "describe_en": "understand how the ability to carry semantic information within models"
    },
    {
      "seq": 3,
      "describe_ch": "能更應用專業知識於參數智慧化模型中",
      "describe_en": "research and explore a specific application of intelligent use of parameters"
    }
