  "description": {
    "sub_id3": null,
    "sub_name": "跨領域專題實作",
    "sub_ename": "INTERDISCIPLINARY PROJECT",
    "describe_ch": "本課程旨讓學生對專業領域進行探索，課程由工程、商管、資電及人文領域，選擇3類進行專題實作，透過實作讓學生激發無限想像力與創意，培養具備團隊合作、問題解決及溝通等能力，更了解該專業領域在產業界的實務發展，及早確立自我專業目標與動機。",
    "describe_eh": "This course purports to help students navigate their fields of expertise, consists of engineering, business, information and electrical, and humanities, students choose three of the categories to conduct the projects, to inspire their infinite imagination and creativity through practices and projects. In addition, it aims to equip students with team cooperation, problem-solving and communication abilities. Moreover, it enables students to comprehend more about the industrial development of their professional areas and set their motives and goals for their career in advance.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
