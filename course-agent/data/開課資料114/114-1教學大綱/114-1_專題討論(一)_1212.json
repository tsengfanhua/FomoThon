  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(一)",
    "sub_ename": "SEMINAR(1)",
    "describe_ch": "訓練學生如何規劃研究之主題、文獻蒐集與探討、資料分析、思考解決問題的方法、報告及論文之撰寫，培養口頭報告之技巧與口語表達技能，除了專注學生報告內容、有效溝通、清晰表達之外，也注重發掘、研判、診斷問題，鼓勵學生提出解決方案之能力、自我學習、創新思考及持續發展之能力。",
    "describe_eh": "Train students how to plan research topics, document collection and discussion, data analysis, thinking about problem-solving methods, report and essay writing, and develop oral report skills and oral expression skills. In addition to focusing on student report content, effective communication, and clear expression, it also pays attention to problems discovering, judgment, diagnosing, and encouraging students to propose solutions, and innovative thinking abilities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "收集並閱讀機械相關領域的資料。",
      "describe_en": "Survey and read related materials of mechanical engineering."
    },
    {
      "seq": 2,
      "describe_ch": "應用電腦輔助技術分析資料，並將分析過的資料整理成報告。",
      "describe_en": "Analyze data using computer-aided technique and then coordinate a report from the analyzed data."
    },
    {
      "seq": 3,
      "describe_ch": "透過對不同領域的口頭發表，同學間能有效溝通。",
      "describe_en": "Students can communicate effectively through oral presentation in various fields."
    },
    {
      "seq": 4,
      "describe_ch": "閱讀最新的文獻掌握最新趨勢。",
      "describe_en": "Read the latest literature and catch the latest trends."
    },
    {
      "seq": 5,
      "describe_ch": "從某些與節能減碳有關之論文題目，確認節能減碳的必要性及效益。",
      "describe_en": "Understand the necessity and effectiveness of energy saving and carbon reduction from related paper."
    },
    {
      "seq": 6,
      "describe_ch": "透過討論的文獻，可以使同學理解成員的權利、義務 專業倫理及社會責任。",
      "describe_en": "Understand rights, obligations, professional ethics, and social responsibility through discussion of literature."
    }
  ],
