  "description": {
    "sub_id3": null,
    "sub_name": "天線設計",
    "sub_ename": "ANTENNA  DESIGN",
    "describe_ch": "本課程主要內容在討論天線的基本理論、分析、設計與應用，包括：電磁波基本理論、天線參數、以及各種不同形式的天線及它們於無線通訊的應用等。",
    "describe_eh": "The main objective of this course is to introduce the basic theory, analysis, design and applications of antennas. Fundamental theory of Electromagnetic Waves, antenna parameters, and various types of antennas are discussed in this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能具備天線的基本知識，理解天線的特性參數。　",
      "describe_en": "Be able to obtain basic knowledge about antenna, and explain antenna characteristic parameters."
    },
    {
      "seq": 2,
      "describe_ch": "能運用模擬軟體進行天線之設計與分析。",
      "describe_en": "Be able to use simulation tool to design and analyze antenna."
    },
    {
      "seq": 3,
      "describe_ch": "能綜合天線之知識，完成應用於無線通訊的天線專案設計。",
      "describe_en": "Be able to apply antenna knowledge to finish a project of antenna design."
    }
  ],
