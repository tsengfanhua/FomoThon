  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "XC04111",
    "sub_id": "GM780",
    "scr_dup": "001",
    "tpa_score_new": "<div>\n<ul>\n\t<li>會進行課堂互動與參與討論、作業報告繳交、學期預警、或加分及補救措施等。</li>\n\t<li>本課程透過分析社會設計理論、技術與方法，反思理論方法與相關案例問題，建立學子理解社會設計知識之外，也經由實務操作社會設計專題演練，除了培養學子關注社會問題，昇華周遭美學的概念，以及增進以設計解決社會問題的知能。&nbsp;</li>\n</ul>\n</div>\n",
    "tpa_score_new_en": " ",
    "course_pol": "依照課程實際需求，安排校外參訪教學著名之社會設計專題(如社區創生、環境設計、福利設計等社會設計議題巡禮與當地專案人員講解)。",
    "course_pol_en": null,
    "course_rem": "上課輕鬆互動愉快，會成立Line社群，嚴禁同學上課時趴睡。",
    "course_rem_en": null,
    "ais_meno": "<div>1.這是一個訓練思考、討論、原創等社會設計的教學過程，嚴禁同學們侵犯他人的著作，作業報告或是教材分享皆須謹守尊重著作財產權之規範。</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": "N"
  },
