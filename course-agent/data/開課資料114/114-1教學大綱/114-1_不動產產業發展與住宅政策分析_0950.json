  "description": {
    "sub_id3": null,
    "sub_name": "不動產產業發展與住宅政策分析",
    "sub_ename": "REAL ESTATE INDUSTRY DEVELOPMENT AND HOUSING POLICY",
    "describe_ch": "本課程之規劃主要讓學生了解政策規劃過程及政策如何被產出，以及台灣政策制定的政經結構。並利用目前以及未來對於不動產產業及住宅市場影響重大的政策進行介紹與評析。",
    "describe_eh": " This course aims to provide knowledge to students for them to understand how policy is produced and the decision making processes. Also, this course will discuss the special features of Taiwan’s political-economic structure. This curse will discuss current or coming influential policy relating real estate and housing market development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解政府政策制定邏輯與決策運作方式",
      "describe_en": "Understanding the logic of how public policy are produced and operated"
    },
    {
      "seq": 2,
      "describe_ch": "了解重大住宅與不動產政策之可能衝擊與因應之道",
      "describe_en": "Understanding the impact of recent crucial housing and real estate policy and know how to react"
    }
  ],
