  "description": {
    "sub_id3": null,
    "sub_name": "光電子學",
    "sub_ename": "FUNDAMENTAL OF PHOTONICS",
    "describe_ch": "本課程提供光電子學專業知識的介紹，課程內容主要涵蓋五個主題，包含雷射、光纖、光偵測器、電光與聲光調制器。",
    "describe_eh": "This course provides an introduction to the photonics. The course mainly consists five topics which are laser, optical fiber, semiconductor photon detectors, electro- and acousto-optic modulators.",
    "pre_subname": "OPT2001光學(一)、OPT2002光學(二)、PHYS2001電磁學(一)、ENGS2011工程數學(一)、ENGS2013工程數學(二)",
    "pre_sub_id3": "OPT2001",
    "pre_sub_ename": "OPT2001 OPTICS (1)、OPT2002 OPTICS (2)、PHYS2001 ELECTROMAGNETICS(1)、ENGS2011 ENGINEERING MATHEMATICS(1)、ENGS2013 ENGINEERING MATHEMATICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.學生能理解光電子學的基本原理。",
      "describe_en": "2.Students can To comprehend the basic theories of photonics."
    },
    {
      "seq": 2,
      "describe_ch": "2.學生能知道光電元件之原理及應用。",
      "describe_en": "2.Students can know the principles and applications of photonic devices."
    },
    {
      "seq": 3,
      "describe_ch": "3.學生能分析光電元件的使用與設計問題。",
      "describe_en": "3. Students can analyze the problems in the operation and design of photonic devices."
    },
    {
      "seq": 4,
      "describe_ch": "4.學生能閱讀相關進階書籍及論文。",
      "describe_en": "4. Students can read the related advanced books and papers"
    }
  ],
