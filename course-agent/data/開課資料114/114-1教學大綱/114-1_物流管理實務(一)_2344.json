  "description": {
    "sub_id3": null,
    "sub_name": "物流管理實務(一)",
    "sub_ename": "LOGISTICS MANAGEMENT PRACTICE (1)",
    "describe_ch": "本課程旨在以物流管理學習為基礎,輔以物流證照考試及實務分析課程包括:物流架構、運輸配送系統、個案探討、物流資訊系統、倉儲與存?、物流中心作業、電子商務與物流、設施區位規劃、物流系統規劃及全球運籌。",
    "describe_eh": "The purpose of this course is to introduce contemporary logistics management development based on the logistics management theory. The practical operations and certificates in the context of logistics sectors are proposed. The content of the course includes logistics framework, customer service, distribution systems, case study, information system of logistics, warehouse and inventory, supply chain management, distribution center and channel, E-commerce, infrastructure location planning, strategic planning of logistics and global logistics. In addition, in order to develop students' employability in the logistics industry. This course guides students to obtain logistics professional certificate in terms of studying both theoretical and practical content.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備運輸與物流知識、解析時事議題及運用專業知識解決問題之能力",
      "describe_en": "Knowledge of transportation and logistics, ability to resolve current issues and apply professional knowledge to solve problems."
    },
    {
      "seq": 2,
      "describe_ch": "具備運用資訊技術及各項專業技能，蒐集、分析與解釋數據之能力",
      "describe_en": "Ability to use information technology and various professional skills to collect, analyze and interpret data."
    }
  ],
