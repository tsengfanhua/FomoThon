  "description": {
    "sub_id3": null,
    "sub_name": "地理資訊系統開發",
    "sub_ename": "GEOGRAPHIC INFORMATION SYSTEM PROGRAMMING",
    "describe_ch": "在本課程中，同學可學習處理GIS和大數據資料的程式語言，並了解如何應用於GIS軟體客製化，以改善GIS分析能力及效率。",
    "describe_eh": "In this course, students can learn programming language to deal with GIS and big data. Besides, students can understand how to apply to GIS software customization and to improve the GIS analysis ability and efficiency.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解地理資料庫之建構方法",
      "describe_en": "Be able to comprehend the construction method of geodatabase"
    },
    {
      "seq": 2,
      "describe_ch": "能分析地理資訊大數據",
      "describe_en": "Be able to analyze geographic information big data"
    },
    {
      "seq": 3,
      "describe_ch": "能應用地理資訊系統客製化功能以改善分析能力及效率",
      "describe_en": "Be able to apply the customized functions of geographic information system to improve the analysis ability and efficiency"
    }
  ],
