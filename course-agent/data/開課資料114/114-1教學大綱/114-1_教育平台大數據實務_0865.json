  "description": {
    "sub_id3": null,
    "sub_name": "教育平台大數據實務",
    "sub_ename": "PRACTICAL BIG DATA ANALYTICS FOR EDUCATIONAL PLATFORMS",
    "describe_ch": "隨著現今教育平台執行上的多樣化，相關對應問題也陸續浮出，本實務課程規劃與學習平台合作，引導學生如何更快速地發現問題、更敏捷地的提出對應的解決方案，以提供教育平台進步與改革上的作法之一。",
    "describe_eh": "As modern educational platforms diversify, a range of corresponding challenges arise. This practical course, designed in collaboration with educational platforms, guides students in identifying educational issues and nimbly proposing appropriate solutions, thus providing one approach for advancing and reforming educational platforms.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解教育大數據之基礎概念與在數位學習上的應用。",
      "describe_en": "Understanding the fundamental concept of big data for education and its applications in e-learning."
    },
    {
      "seq": 2,
      "describe_ch": "能撰寫程式語言或應用軟體進行教育大數據分析。",
      "describe_en": "Proficient in writing programming code and using software for educational big data analysis."
    },
    {
      "seq": 3,
      "describe_ch": "能使用適當的大數據分析方法模型解決教育相關問題。",
      "describe_en": "Skilled in applying appropriate data analysis methods and models to address educational problems."
    },
    {
      "seq": 4,
      "describe_ch": "能以教育大數據分析驅動，發現新的學習洞見、智慧評量或個人化的學習扶助。",
      "describe_en": "Through educational big data analysis, able to uncover new educational insights, implement smart assessments, and provide personalized learning support."
    }
  ],
