  "description": {
    "sub_id3": null,
    "sub_name": "移地教學(二)",
    "sub_ename": "OVERSEAS STUDY ABROAD(2)",
    "describe_ch": "本課程主要目地在加強師生國際交流互動，提高學生專業能力，凸顯本學程實作的教學特色。本次規劃馬六甲、吉隆坡移地教學既是歷史與文化探索之旅，也是跨文化交流與體驗機會。課程規劃將聚焦三大主題——華人文化遺產、華人生活與教育，透過實地觀察與討論，引導學生深刻理解華人文化在東南亞的發展與影響。",
    "describe_eh": "This course promotes international interaction between faculty and students and develops students' professional skills through hands-on learning. The field study in Malacca and Kuala Lumpur offers historical and cultural immersion, as well as intercultural interaction. Students will explore three themes: Chinese cultural heritage, Chinese life, and education, to understand Chinese culture's evolution and impact in Southeast Asia.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生具備國際觀，並透過當地專業的介紹，使學生具備文化調查與研究能力。",
      "describe_en": "Students will be able to develop an international perspective and acquire the skills to investigate and research local cultural assets through the introduction of local professionals."
    },
    {
      "seq": 2,
      "describe_ch": "認識海外華人文化的發展脈絡，並具備與本土比較研究之視野，能應用文物及歷史知識的能力，從事文物詮釋與地方設計工作。",
      "describe_en": "Understand the development of overseas Chinese culture, compare it with local culture, and apply knowledge of artifacts and history to interpret cultural relics and engage in local design work."
    }
  ],
