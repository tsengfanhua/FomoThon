  "description": {
    "sub_id3": null,
    "sub_name": "國際人力資源管理",
    "sub_ename": "INTERNATIONAL HUMAN RESOURCE MANAGEMENT",
    "describe_ch": "探討有效運用人力資源實務(甄選、招募、訓練、獎酬)達成國際企業的各種跨國管理活動與管理實務，以增進人力資源實務對國際企業的經營貢獻，使學生能瞭解人力資源管理之理論、原則與實務，並將其運用的特殊的跨文化及跨國界情境。",
    "describe_eh": "This course aims at the process of effective management of human resource to pursuit MNE's goals and an analysis of those elements essential such as selection, recruitment, training and reward. Principles and practices of the international human resource management are included. The cross-cultural contextual discussions will be covered to enable the students' abilities to effectively manage the human resource around the world.",
    "pre_subname": "MGT1001管理學、ITRA2067國際企業管理",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT、ITRA2067 INTERNATIONAL BUSINESS MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解與描述國際人力資源管理之意義與內涵",
      "describe_en": "Understand and be able to describe the meaning and contents of International Human Resource Management(HRM)"
    },
    {
      "seq": 2,
      "describe_ch": "能運用人力資源管理之基本知識來思考如何從事有效之跨國管理",
      "describe_en": "Be able to apple the fundamental knowledge of Human Resource Management to think how to manage MNE effectively"
    },
    {
      "seq": 3,
      "describe_ch": "能有效分析不同國家情境之國際人力資源管理個案",
      "describe_en": "Be able to effectively analyze human resource cases in different country"
    }
  ],
