  "description": {
    "sub_id3": null,
    "sub_name": "高頻電路概論",
    "sub_ename": "INTRODUCTION TO RADIO FREQUENCY CIRCUIT",
    "describe_ch": "電子電路在高頻訊號所產生的影響，並對元件之高頻特性做探討分析。課堂上將介紹元件在高頻時的雜散效應、微帶傳輸線分析、史密斯圖表、單埠與多埠電路網路等，電路共振特性與雜訊觀念也是教學內容之一。",
    "describe_eh": "The effects of the RF signal on the electronic circuit are studied. The RF characteristics of the passive devices, such as the resistor, the inductor and the capacitor, are analyzed. The parasitic effect of the components at the high frequency, the transmission line analysis, the Smith chart, the single- and multi-port circuit networks are incorporated as part of the regular topics. The resonant and noise characteristics of the components and circuits are the content in class.",
    "pre_subname": "EEEN2008電路學(一)、EEEN2009電路學(二)、EEEN2010電磁學(一)、EEEN2011電磁學(二)",
    "pre_sub_id3": "EEEN2008",
    "pre_sub_ename": "EEEN2008 CIRCUIT THEORY(1)、EEEN2009 CIRCUIT THEORY(2)、EEEN2010 ELECTROMAGNETICS(1)、EEEN2011 ELECTROMAGNETICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 2,
      "describe_ch": "理解高頻電路分析/設計之基本工具與方法。\t",
      "describe_en": "Comprehend the basic tools and methods for the analyses/designs of the RF circuits."
    },
    {
      "seq": 3,
      "describe_ch": "對於高頻信號在電子電路/被動裝置上所產生的效應，具有基本的知識。\t",
      "describe_en": "With the fundamental knowledge of the effects of the RF signal on the electronic circuit/passive devices."
    }
  ],
