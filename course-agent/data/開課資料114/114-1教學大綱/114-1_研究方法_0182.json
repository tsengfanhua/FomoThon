  "description": {
    "sub_id3": null,
    "sub_name": "研究方法",
    "sub_ename": "RESEARCH METHODS",
    "describe_ch": "本課程概述實證社會科學研究的原理、方法和技術。 將介紹口頭和書面的溝通技巧。主要內容包括計量經濟學的基礎知識、研究中的倫理考慮、基本的定量和定性資料收集方法以及使用 SPSS、Eviews 和 Stata 等軟體的分析技術。 本課程旨在透過討論、分析和實踐，提高學生的社會科學研究能力。",
    "describe_eh": "This course offers an overview of empirical social science research principles, methods, and techniques. Communication skills of both the oral and the written types will be introduced. Topics cover the essentials of econometrics, ethical considerations in research, primary quantitative and qualitative data collection methods, and analytical techniques utilizing software such as SPSS, Eviews, and Stata. The course aims to enhance students' abilities in social science research through discussions, analysis, and hands-on practice.",
    "pre_subname": "STAT6029數量方法(一)",
    "pre_sub_id3": "STAT6029",
    "pre_sub_ename": "STAT6029 QUANTITATIVE METHOD(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "綜合研究方法相關理論之建立與發展",
      "describe_en": "Synthesis for how the research methodology is built and developed."
    },
    {
      "seq": 2,
      "describe_ch": "綜合探討研究規劃與發展之影響因素",
      "describe_en": "Synthesis for the factors that affect research planning and development."
    },
    {
      "seq": 3,
      "describe_ch": "評估研究方法攸關之實證研究",
      "describe_en": "To evaluate the empirical studies on the topics of research method"
    }
  ],
