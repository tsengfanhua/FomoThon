  "description": {
    "sub_id3": null,
    "sub_name": "機器學習應用導論",
    "sub_ename": "INTRODUCTION TO ARTIFICIAL INTELLIGENCE AND APPLICATIONS",
    "describe_ch": "本課程旨在介紹機器學習的基本概念和應用，並通過實際案例分享幫助學生理解機器學習技術的應用以及?發。課程中將介紹機器學習的基本算法和技術，包括監督式學習、非監督式學習和強化學習。透過分享最新的機器學習應用案例，讓學生了解機器學習在現實生活中的應用和能力。通過本課程的學習，學生將會學到機器學習的基本理解和應用能力。",
    "describe_eh": "This course aims to introduce the basic concepts and applications of machine learning and help students understand the practical use of machine learning technology through real-life case studies. The course will cover the basic algorithms and techniques of machine learning, including supervised learning, unsupervised learning, and reinforcement learning. By sharing the latest machine learning application cases, students will gain an understanding of the application and capabilities of machine learning in real-life situations. Through this course, students will acquire a basic understanding and application skills of machine learning.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解機器學習的基本概念和算法",
      "describe_en": "Understand the basic concepts and algorithms of machine learning"
    },
    {
      "seq": 2,
      "describe_ch": "具備機器學習的基本理論與技術概念對現實中的應用和挑戰進行議題研究提案與表達之能力",
      "describe_en": "Ability to propose and articulate research topics on the applications and challenges of basic theories and technical concepts in machine learning in real-world scenarios."
    }
  ],
