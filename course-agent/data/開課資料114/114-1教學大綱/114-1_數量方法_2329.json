  "description": {
    "sub_id3": null,
    "sub_name": "數量方法",
    "sub_ename": "QUANTITATIVE METHODS",
    "describe_ch": "本課程就管理數學及線性代數等基礎數量方法進行介紹，多評準決策內容包括多目標規劃、多評準評估及資料包絡分析，而線性代數則針對矩陣運算、線性轉換及向量空間概念進行介紹。",
    "describe_eh": "This course consists of two parts, viz. Multi-Criteria Decision Making (MCDM) and Linear Algebra (LA) methods. Multi-Objective Programming (MOP), Multi-Criteria Evaluation (MCE), and Data Envelopment Analysis (DEA) will be discussed in MCDM. Meanwhile, Matrix Arithmetic, Linear Transform, and Vector Space will be introduced.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
