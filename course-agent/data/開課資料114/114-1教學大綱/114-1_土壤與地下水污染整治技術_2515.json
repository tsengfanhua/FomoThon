  "description": {
    "sub_id3": null,
    "sub_name": "土壤與地下水污染整治技術",
    "sub_ename": "REMEDIAL TECHNOLOGIES FOR SOIL AND GROUNDWATER CONTAMINATION",
    "describe_ch": " 以實際土壤/地下水污染情境為基礎，規劃可行之應變改善策略及目標，並提出包含設計、驗證，及經費預估之計畫書。課程內容包含地下水土壤地質調查、土壤/地下水污染簡介、廠址環境評估、污染場址調查、整治方法簡介及篩選等。學生以分組方式成立團隊，教師以2-3星期為單位規劃單元進度及相關查核項目，各團隊根據教師要求提出書面報告。期末彙整各單元結果並進行口頭報告。",
    "describe_eh": "This course uses real-life cases of soil/groundwater contaminated sites for students to design a cleanup scheme. Each group writes a proposal that includes site investigation, remediation technique screening, design, and cleanup cost.  The lectures include the following topics: hydrogeology investigation methods, introduction of soil/groundwater contamination, contaminated site evaluation and investigation, introduction of remediation techniques screening, design of contaminated site cleanup. The students are divided into several 4 to 6-member groups. Each group turns in progress report every 2 weeks.  Theses progress reports will be combined into final reports of which contents will be used to prepare an oval report by each group.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識土壤/地下水種類及途徑\t",
      "describe_en": "Know soil/groundwater contamination types and routes of contamination"
    },
    {
      "seq": 2,
      "describe_ch": "理解地下水文及地質判斷程序\t",
      "describe_en": "Characterize aquifer properties using standard procedures"
    },
    {
      "seq": 3,
      "describe_ch": "應用圖學，工程經濟等相關技能，呈現處理流程並推估整治費用\t",
      "describe_en": "Using engineering graphics, engineering economics, present a remediation flowchart and estimate the cost"
    },
    {
      "seq": 4,
      "describe_ch": "根據處理流程圖，說明各單元應用原理並提供設計參數\t",
      "describe_en": "Based on the remediation flowchart, describe the reason for using each unit and provide key design parameters for each unit"
    },
    {
      "seq": 5,
      "describe_ch": "應用專案管理、團隊合作與溝通協調能力\t",
      "describe_en": "Apply the basics of project management, effective communication and persuasion to achieve project goals"
    },
    {
      "seq": 6,
      "describe_ch": "分析環境問題並構思解決問題的方法\t",
      "describe_en": "Conceptualize and analyze the problems at hand and find feasible alternative solutions"
    },
    {
      "seq": 7,
      "describe_ch": "關心環境問題並能持續學習與謀求解決方案\t",
      "describe_en": "Continue to care about the environmental problems and to learn new solutions"
    },
    {
      "seq": 8,
      "describe_ch": "認知專業倫理與社會道德責任，培養自我管理能力\t",
      "describe_en": "Recognize and be obliged to the professional ethics and society moral responsibility and develop the ability of self-management."
    }
  ],
