  "description": {
    "sub_id3": null,
    "sub_name": "人體生理解剖學",
    "sub_ename": "HUMAN ANATOMY AND PHYSIOLOGY",
    "describe_ch": "人體解剖學以人體為研習對象，並探討人體結構，可分為大體解剖學、 顯微解剖學 、發生解剖學、神經解剖學 、放射解剖學。課程特別重視基礎與臨床之連貫性，除對人體各系統做詳盡之講解外，並穿插介紹臨床病例與解剖應用，使學生能對人體有更進一步的認知與了解。",
    "describe_eh": "This course introduces the fundamental conception of human structures and their relations to physiological functions. This course provides a wide background of 3-D correlations of humeral organ systems and helps students to meet the demand of the growing medical knowledge. There are many subdivisions of human anatomy, including embryology, histology, neuro-anatomy and radiological anatomy. This course will not only help the students to recognize the intimate correlations between anatomical structure and biological function, but also help the students to better understand the fascinating and complex working mechanisms of the human body.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能運用數學基礎，以了解解剖學及生理學的基本知識。",
      "describe_en": "Apply mathematic foundation to understand the basic knowledge about human anatomy and physiology."
    },
    {
      "seq": 2,
      "describe_ch": "暸解人體結構之基本組成、功能與相互運作之原理，理解解剖學及生理學的定義與定理。",
      "describe_en": "Understand the basic components and functions of the human structures and the working principles and relationships of numerous organ systems. Comprehension for the definitions or theories of biomedical signal measurement."
    },
    {
      "seq": 3,
      "describe_ch": "應用現有工具，對解剖學及生理學完成分析，明白疾病衍生之機制與人體結構之關連。",
      "describe_en": "Application for the available tools to the analysis of human anatomy and physiology."
    },
    {
      "seq": 4,
      "describe_ch": "對解剖學及生理學具備描述問題、訂定規格、建構模型之各項分析能力。",
      "describe_en": "With analysis capability on describing problems, defining specifications, and constructing model for human anatomy and physiology."
    }
  ],
