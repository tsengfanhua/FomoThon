  "description": {
    "sub_id3": null,
    "sub_name": "專題實作(一)",
    "sub_ename": "PRACTICE OF SPECIAL TOPICS (1)",
    "describe_ch": "本課程為3門終端課程系列的第一門課，由全系所有教師共同開設，要求學生於此門課程中與執導老師討論專題實作之內容與方向，並完成一專題實作之計畫書，內容包含動機、背景說明、實行方法、時程及經費規劃等，以培育學生解決問題之整合能力。",
    "describe_eh": "Being the beginning section of the three capstone courses, the course provides guidance from all MCAE faculty members. Through discussing with advisors, students have to complete a project including motivation, background, methodology, schedule and budget, etc. It equips students with the problem-solving skill.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "訓練學生定義、瞭解問題及尋找資料之能力。",
      "describe_en": "To develop the ability of defining and understanding and finding and collecting reference documents to study a mechanical problem"
    },
    {
      "seq": 2,
      "describe_ch": "訓練學生整合不同課程作一綜合應用之能力。",
      "describe_en": "To develop the ability of integrating different courses to solve a mechanical problem"
    },
    {
      "seq": 3,
      "describe_ch": "訓練學生分工合作、互相討論、整合結果之能力。",
      "describe_en": "To develop the ability of peel cooperation, discussion and integration."
    },
    {
      "seq": 4,
      "describe_ch": "訓練學生撰寫研究報告及口頭發表之能力，並瞭解所研發之技術與綠色產品關連性。",
      "describe_en": "To develop the ability of paper writing and oral expression about a research."
    },
    {
      "seq": 5,
      "describe_ch": "從小組進行專題過程中，實踐彼此尊重、合作之專業倫理關係。",
      "describe_en": "To build the spirit of professional ethics through group discussion"
    }
  ],
