  "description": {
    "sub_id3": null,
    "sub_name": "歐洲文學",
    "sub_ename": "EUROPEAN LITERATURE",
    "describe_ch": "本課程主要以涵蓋現代歐洲文學為主（英語文學除外）。教授方式主要以演講方式挑選歐洲文學中自1300年至現代之間的重要作品，換句話說，從文藝復興時代到20世紀，比如法國古典主義等等。",
    "describe_eh": "This course is to cover European Literature from 1300 to modern times (apart from English Literature) in general; that is, from Renaissance to the beginning of the 20th century. The method of teaching is to focus on some masters' representative works by lecturing in class, for example, French Classicism,…etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備歐美文學的基礎知識。",
      "describe_en": "To be equipped with basic knowledge of European and American literature"
    },
    {
      "seq": 2,
      "describe_ch": "具備鑑賞分析歐美文學作品的基本能力。",
      "describe_en": "To be equipped with the basic ability to appreciate and analyze European and American literary works"
    }
