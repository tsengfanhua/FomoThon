  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "XD01111",
    "sub_id": "21761",
    "scr_dup": "005",
    "sub_title": "養成規律運動並認識身體肌肉動作。",
    "sub_title_en": null,
    "sub_describe": "透過課程的認識與練習，期許養成正確且規律之運動習慣，培養健康的身體狀態。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "體育－健康與塑身",
    "sub_ename": "HEALTH AND BODY BUILDING",
    "describe_ch": "近年來對高級企業主管的健康抽查(40-60歲)，20%有心血管疾病，50%健康亮紅燈。科學家也證實我們的心臟功能從20-40-，每年衰退10%，而規律的活動，運動可以讓人保有活力，使心智提高20-30%，幫助記憶。良好的身體組成，就是身體有\r(1)適當的脂肪，男12-15%，女20%。(2)適當的肌肉：肌力訓練，預防老化與受傷。(3)25歲以前強化骨質訓練和陽光，預防骨質疏鬆。",
    "describe_eh": "(1)In recent health inspection, there are 20% of 40 to 60-year-old enterprise directors having cardiovascular disease and 50% having health problems.\r\n(2)Scientists proved that human cardiopulmonary turn down 10% every year from 20 to 60-year-old.Moreover, people need regular exercise to maintain vitality, improve 20-30% mental ability, and help memory.\r\n(3)Well body composition means:\r\na.Need appropriate body fat: Male 12-15%, Female 20%.\r\nb.Need appropriate muscle: Strength training to prevent aging and injury.\r\nc.Need strengthen skeleton training and sunbathe to prevent osteoporosis before 25-year-old.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "提升肌力及肌耐力，雕琢身體曲線，提高自信心，讓學生更加健康。能強化學生骨質密度，降低運動傷害折的可能性。",
      "describe_en": "The purpose of Body Sculpting Class is improve students’ fitness, muscle strength and endurance, sculpt the body shape. Enhance students’ self-confidence, and make healthy. And also can strengthen the bone density and reduce the possibility of injury."
    }
  ],
