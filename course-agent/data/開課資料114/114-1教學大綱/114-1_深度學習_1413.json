  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE07149",
    "sub_id": "38813",
    "scr_dup": "001",
    "sub_title": "深度學習",
    "sub_title_en": null,
    "sub_describe": "深度學習課程從理論根基出發，逐步建立起強大的實作能力，並能靈活運用所學知識解決真實世界的複雜問題，最終成為具備前瞻視野與社會關懷的AI專業人才。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "深度學習",
    "sub_ename": "DEEP LEARNING",
    "describe_ch": "本課程將介紹深度學習的理論與實務。本課程將解釋深層神經網路、卷積神經網路、簡易遞歸神經網路、長短期記憶神經網路及門檻遞歸單元神經網路等的運作原理。教學目標為建立學生在深度學習必要的根基，以便將所學之技術應用在他/她們自己的問題上。",
    "describe_eh": "In this course, the fundamental principles and applications of the deep learning are introduced. We will explain the basic operational principles for deep artificial neural networks, convolutional neural networks, simple recurrent neural networks, Long Short-Term Memory (LSTM) neural networks, and Gated Recurrent Unit (GRU) neural networks. The goal is build the necessary background of the deep learning for the students in order to apply these techniques in their own problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
