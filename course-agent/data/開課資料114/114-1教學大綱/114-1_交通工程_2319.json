  "description": {
    "sub_id3": null,
    "sub_name": "交通工程",
    "sub_ename": "TRAFFIC ENGINEERING",
    "describe_ch": "本課程教授基本概念、交通調查研究、交通運作效率、安全與管理。包括：人、車、路特性分析；交通量、行駛時間、速率、延誤、停車等調查與分析；道路交通服務水準、車流、事故特性、交通管制設施、交通管制策略等。",
    "describe_eh": "The teaching content include introduction of basic concept of traffic engineering, and the study of traffic survey, traffic operational efficiency and the traffic safety and management. The basic concept of traffic engineering includes the characteristics of the road users, the vehicle, and the traffic stream. Regarding the contents of traffic survey, it incorporates the data collect and analysis to traffic volume, travel speed, travel time, delay, and parking. Traffic operational efficiency and the traffic safety and management will be introduced that are the character of traffic flow, traffic accident, level service , the facility of traffic control, the strategy of traffic management.　",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "2.各種不同運輸工程之規劃、施工、營運等概念",
      "describe_en": "2.Understand plan, construction, operation and management of various transportation systems."
    },
    {
      "seq": 2,
      "describe_ch": "8.陸路運輸系統運作與企業之理論及實務的概念",
      "describe_en": "8.Comprehend operational theory and practice of ground transportation systems and companies."
    },
    {
      "seq": 3,
      "describe_ch": "19.交通工程師與從業人員應具有專業倫理的項目",
      "describe_en": "19.Possess professional ethics for traffic engineer and practicians."
    }
  ],
