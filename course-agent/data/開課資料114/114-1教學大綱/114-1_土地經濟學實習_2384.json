  "description": {
    "sub_id3": null,
    "sub_name": "土地經濟學實習",
    "sub_ename": "EXERCISE OF LAND ECONOMICS",
    "describe_ch": "從新古典經濟學與制度經濟學之相關理論中討論土地在現代經濟體系與環境中扮演的角色，通常包含地租、地價、地用與環境資源保育等面向。",
    "describe_eh": "Discussing the role of land in modern economic systems and the environment from the perspectives of neoclassical economics and institutional economics, typically includes aspects such as land rent, land price, land use, and environmental resource conservation.\"",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解與適用土地管理專業與實務之能力。",
      "describe_en": "The ability of proper understanding and applying land management expertise into practice"
    },
    {
      "seq": 2,
      "describe_ch": "應用軟硬體蒐集、處理與分析之能力",
      "describe_en": "Ability to collect, process and analyze data using software and hardware"
    },
    {
      "seq": 3,
      "describe_ch": "培養積極創新、邏輯思考、團隊合作之能力並具備社會責任。",
      "describe_en": "The ability of managing innovation, logical thinking, teamwork and insisting social responsibility"
    }
  ],
