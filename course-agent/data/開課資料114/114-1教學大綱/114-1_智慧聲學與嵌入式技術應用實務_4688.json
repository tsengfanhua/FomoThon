  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CI00300",
    "sub_id": "48370",
    "scr_dup": "001",
    "sub_title": "1. 認識聲學產品及製造技術 2. 電聲元件與系統測試與實作 3.電聲產品資訊與管理技術",
    "sub_title_en": null,
    "sub_describe": "本課程為美律實業股份有限公司(MERRY)與本校(FCU)合作，提供聲學產品製造、整合、設備、研發、管理等知識，並利用至企業參訪與實作活動，實際瞭解美律實業公司管理開發相關職務之技術知識，使學生具聲學產品系統與元件跨域整合之能力，為科技產業培育學用合一之專業人才。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "智慧聲學與嵌入式技術應用實務",
    "sub_ename": "SMART ACOUSTICS AND EMBEDDED TECHNOLOGY APPLICATION PRACTICE",
    "describe_ch": "本課程為美律實業股份有限公司(MERRY)與本校(FCU)合作，提供聲學產品製造、整合、設備、研發、管理等知識，並利用至企業參訪與實作活動，實際瞭解美律實業公司管理開發相關職務之技術知識，使學生具聲學產品系統與元件跨域整合之能力，為科技產業培育學用合一之專業人才。",
    "describe_eh": "This course is a collaboration between Merry Electronics CO., LTD. and FCU. Provides knowledge on the manufacture, integration, equipment, R&D, and management of acoustic products. It also offers company visits and hands-on activities to help students gain a practical understanding of the technical knowledge of management and development-related positions at MERRY Corporation. It enables students to have the ability to integrate acoustic product systems and components across domains and cultivates professional talents who can integrate learning and application for the technology industry.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
