  "description": {
    "sub_id3": null,
    "sub_name": "計算機視覺",
    "sub_ename": "COMPUTER VISION",
    "describe_ch": "本課程講述內容包含下列三點1.介紹圖像處理功能的基本概念 2.預處理，特徵提取和分類技術。 3. 應用Matlab或Python軟體程式設計。",
    "describe_eh": "The contents of this course include: 1. Introduction of elementary concepts on simple image processing functions 2. The techniques of pre-processing, feature extraction and classification. 3. Programming on Matlab or Python",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解機器視覺的基本原理與技術",
      "describe_en": "To understand the basic principles and techniques of computer vision"
    },
    {
      "seq": 2,
      "describe_ch": "了解物件特徵擷取、轉換及強化技術",
      "describe_en": "To understand object’s feature extraction, transformation and enhancement techniques"
    },
    {
      "seq": 3,
      "describe_ch": "設計學習與推理演算法",
      "describe_en": "To design the supervised learning algorithms and reasoning algorithms"
    },
    {
      "seq": 4,
      "describe_ch": "應用數學模型與演算法，以解決計算機視覺的問題",
      "describe_en": "To implement machine vision architecture to computer vision tasks"
    }
  ],
