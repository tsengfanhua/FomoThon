    "scr_dup": "001",
    "sub_title": "本課程主要探討個體經濟理論中的消費需求理論、生產理論、競爭市場、獨占、寡占與獨占性競爭市場、賽局理論等。",
    "sub_title_en": null,
    "sub_describe": null,
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "個體經濟理論(一)",
    "sub_ename": "MICROECONOMIC THEORY(1)",
    "describe_ch": "本課程主要探討個體經濟理論的前半段主題，包括：消費需求理論、生產理論、競爭市場、獨占、寡占與獨占性競爭市場、賽局理論等。",
    "describe_eh": "This course is designed for graduate students with the background from intermediate Microeconomics. The purpose of this course is to build the foundation on modern microeconomic theory. The focuses of this course are consumer and production theories. We will cover some special topics such as uncertainty and welfare measure. Another important issue we will include is game theory and its application on imperfect competition.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解進階個體經濟學中主要理論",
      "describe_en": "Can have comprehensive understanding on Microeconomic theories."
    },
    {
      "seq": 2,
      "describe_ch": "能應用數理方法瞭解經濟理論",
      "describe_en": "Be able to understand and prove theories using mathematical tools."
    },
    {
      "seq": 3,
      "describe_ch": "應用經濟理論解析經濟現象，並提出自我見解",
      "describe_en": "Be able to use related Microeconomic models to analyze and explain economic activities."
    }
  ],
