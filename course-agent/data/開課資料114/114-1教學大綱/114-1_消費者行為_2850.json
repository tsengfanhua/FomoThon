  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "傳授消費者行為的概念\r\n為參與者提供運用消費者行為概念的實際操作經驗\r\n幫助理解消費者行為中的文化差異\r\n提高對人工智慧對消費者行為影響的認識\r\n提高對學術誠信實踐的認識",
      "describe_en": "Delivering consumer behavior concepts\r\nGiving attendants hands-on experience in using consumer behavior concepts\r\nHelping understand the cultural difference in consumer behavior\r\nMaking aware of AI’s impact on consumer behavior\r\nMaking aware of academic integrity practices"
    }
  ],
