  "description": {
    "sub_id3": null,
    "sub_name": "消費者行為",
    "sub_ename": "CONSUMER BEHAVIOR",
    "describe_ch": "This course offers a comprehensive foundation in understanding and influencing consumer behavior. You will learn how the psychological, social, and cultural factors influence consumer decision-making and behavior. Key concepts covered in this course include perception, motivation, learning, attitude formation, and the consumer purchase process. Through a blend of theoretical frameworks and real-world case studies, the course provides insights into how consumers process information, form preferences, and make purchasing decisions.",
    "describe_eh": "This course offers a comprehensive foundation in understanding and influencing consumer behavior. You will learn how the psychological, social, and cultural factors influence consumer decision-making and behavior. Key concepts covered in this course include perception, motivation, learning, attitude formation, and the consumer purchase process. Through a blend of theoretical frameworks and real-world case studies, the course provides insights into how consumers process information, form preferences, and make purchasing decisions.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
