  "description": {
    "sub_id3": null,
    "sub_name": "精實製造專論",
    "sub_ename": "PRINCIPLES OF LEAN MANUFACTURING",
    "describe_ch": "本課程旨在講授如何應用精實技術來改善企業營運管理，使用價值流圖分析工具來診斷企業內部之缺失，提供學生來診斷企業內部缺失，學習相關議題與知識，並指導進行個案研究與報告，以提升生產效率、降低浪費、提高品質、增強企業競爭力。",
    "describe_eh": "The course aims to teach how to apply lean techniques to improve enterprise operations management, using value stream mapping analysis tools to diagnose internal deficiencies. It provides students with an understanding of relevant issues and knowledge and guides them in conducting case studies and reports to enhance production efficiency, reduce waste, improve quality, and strengthen competitiveness.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備數學、統計、資訊、工程與管理基本學理與應用能力。",
      "describe_en": "Be able to underhand the fundamental principles of mathematics, statistical, engineering and management information and application abilities."
    },
    {
      "seq": 2,
      "describe_ch": "具備有效溝通、團隊合作、發掘問題，以及解決問題之能力。",
      "describe_en": "Be able to have effective communication, teamwork, problems exploration, and problems solving abilities."
    },
    {
      "seq": 3,
      "describe_ch": "具備邏輯思維、創新設計與持續改善能力。",
      "describe_en": "Be able to have logical thinking, innovative design and continuous improvement abilities."
    },
    {
      "seq": 4,
      "describe_ch": "具備專業倫理、社會責任、全球關懷與持續學習能力。",
      "describe_en": "Be able to have professional ethics, social responsibility, global care and continuous learning abilities."
    }
  ],
