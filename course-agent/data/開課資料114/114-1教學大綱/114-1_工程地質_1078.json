  "description": {
    "sub_id3": null,
    "sub_name": "工程地質",
    "sub_ename": "ENGINEERING GEOLOGY",
    "describe_ch": " 工程地質的課程內容探討各種構成工程地質的有關因素包括：材料因素、地質構造因素、環境因素、工程因素等。此外也使研習者熟悉綜合評估岩體力學性質的計量法及多種調查工址的方法。",
    "describe_eh": "This preliminary course of engineering geology gives an opportunity for students to realize the factors related to engineering geology. The factors include material, geological structure, environment, and engineering construction procedures. It also introduces the methods for rating rock and the methods for site investigation to students.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
