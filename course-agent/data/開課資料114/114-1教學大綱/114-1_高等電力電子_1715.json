  "description": {
    "sub_id3": null,
    "sub_name": "高等電力電子",
    "sub_ename": "ADVANCED POWER ELECTRONICS",
    "describe_ch": "這課程的目的是呈現電力電路分析的方法與應用，特別地以個人電腦的幫助，在研究所的層次中，給予學生足夠深度的基本理論。這些理論被設計成用於發展學生思考程序，促使學生達成完整的理解一個大範圍的主題係有關於電力電子學，提高對於電機領域的學習動機與興趣。除此之外，基本物理觀念的建立，將是鞏固工程教育的最有價值與永久的部分。本課程亦特別強調各種物理觀念的講述，並輔以數學技巧的說明。期使學生經由簡單理論基礎之理解，進而可以擴展延伸至到新的且複雜的電力電子電路。",
    "describe_eh": "The objective of this course is to present methods of power electronic circuit analysis and their applications. The approach is designed to develop students’ thinking process, motivating their interest in the power electronic circuit analysis and design. Both theory and modeling are developed from simple beginnings so that they can be readily extended to new and complex power electronic circuit analysis.",
    "pre_subname": "EEEN2002電子學(一)、EEEN2003電子學(二)、EEEN2008電路學(一)",
    "pre_sub_id3": "EEEN2002",
    "pre_sub_ename": "EEEN2002 ELECTRONICS(1)、EEEN2003 ELECTRONICS(2)、EEEN2008 CIRCUIT THEORY(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 9,
      "describe_ch": "能夠描述電力電子的基本概念與原理。",
      "describe_en": "Describe the basic concepts and the related theories of power electronics."
    },
    {
      "seq": 10,
      "describe_ch": "能夠描述電力電子的相關實務。",
      "describe_en": "Describe the related practical aspects of power electronics."
    },
    {
      "seq": 11,
      "describe_ch": "了解電力電子的重要應用。",
      "describe_en": "Understanding the important applications of power electronics."
    },
    {
      "seq": 12,
      "describe_ch": "能藉由分組討論與習題的實作，了解其物理意義及重要觀念。",
      "describe_en": "Understand the physical meanings and important concepts by group discussion and exercise or homework."
    }
  ],
