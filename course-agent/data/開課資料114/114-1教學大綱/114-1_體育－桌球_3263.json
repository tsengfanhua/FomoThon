  "description": {
    "sub_id3": null,
    "sub_name": "體育－桌球",
    "sub_ename": "TABLE TENNIS",
    "describe_ch": "體育是教育的一環，涵蓋運動技術之教導及體育常識、運動精神與道德傳授。\r\n桌球運動是一門爆發力強且速度快之運動，因此必須要有體力與耐力作為基礎。技術上，以切、抽、拉、扣、轉、撥、擺、推為主。",
    "describe_eh": "The physical education is one of education, which covering techniques and tactics common sense, sportsmanship and moral to teach.\r\n   The table tennis is a powerful and speedy sports, so must strength and endurance to be the foundation. In the technique, it takes lots of table tennis skills as basic.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養生涯運動技能.養成運動休閒習慣.激發群育合作精神",
      "describe_en": "Train the career of exercise.\n.Form the recreation habit of the movement.\n Excite group and cooperation."
    }
