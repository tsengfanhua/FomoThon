  "description": {
    "sub_id3": null,
    "sub_name": "智慧型控制",
    "sub_ename": "INTELLIGENT CONTROL",
    "describe_ch": "介紹智慧型控制方法與應用，其包含最佳化原理、模糊邏輯系統、類神經網路、模糊神經控制、系統識別、基因/進化論演算法及機器學習法則等等。使同學對於智慧型控制有一完整的認識，並能實際利用智慧型控制進行系統設計與應用。",
    "describe_eh": "This course is aimed to introduce intelligent control algorithms and applications, including Fuzzy logic control, neural network control, fuzzy-neural system, system identification, genetic algorithm/evolutionary algorithm and machine learning algorithms. It will enable students to understand the intelligent control and practical application of industrial system.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解何謂智慧型控制問題、最佳化、梯度演算法。",
      "describe_en": "Introduction of the intelligent control problem, optimization problems and gradient descent methods"
    },
    {
      "seq": 2,
      "describe_ch": "學習類神經網路控制、模糊邏輯控制、系統識別、基因與進化演算法，並於控制系統上應用。",
      "describe_en": "Learning the neural networks control, Fuzzy logic control, system identification, genetic algorithm/evolutionary algorithm, and practical application for control system"
    },
    {
      "seq": 3,
      "describe_ch": "透過書面及口頭方式進行期末報告",
      "describe_en": "Final report in written and oral form."
    },
    {
      "seq": 4,
      "describe_ch": "具備使用自動控制工程相關分析、設計與測試軟體以解決問題之能力。",
      "describe_en": "To acquire capabilities in conducting analysis and design, and using automatic control engineering testing software to address engineering problems."
    }
  ],
