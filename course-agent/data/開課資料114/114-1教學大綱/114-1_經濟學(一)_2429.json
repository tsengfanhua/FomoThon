  "description": {
    "sub_id3": null,
    "sub_name": "經濟學(一)",
    "sub_ename": "ECONOMICS(1)",
    "describe_ch": "探討家戶、廠商等個別經濟行為。課程內容包括經濟學的基本問題、價格機能的運作、彈性、市場均衡、消費者選擇、生產理論與成本分析、完全競爭市場、不完全競爭市場。以課本理論內容為主，輔以生活實例，透過評量測驗檢驗學習成效。",
    "describe_eh": "Discuss individual economic behaviors such as households and manufacturers. The course includes the fundamental economic issues, elasticity, market equilibrium, theory of consumers, production theory, cost analysis, perfect competition, and imperfect competition. Based on the theoretical content, the course supplemented by examples in life.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解基本的經濟問題，供需原理，價格機能的運作及相關實例之應用。",
      "describe_en": "Comprehending fundamental economic problems, principles of supply and demand, operations of price mechanism and applications."
    },
    {
      "seq": 2,
      "describe_ch": "理解理性的消費者如何在預算限制下從事選擇。",
      "describe_en": "Comprehending how rational consumers make choices under budget constraints."
    },
    {
      "seq": 3,
      "describe_ch": "理解廠商的生產理論，及短期與長期成本理論。",
      "describe_en": "Comprehending firm's production theory and the short-run and long-run cost theories."
    },
    {
      "seq": 4,
      "describe_ch": "理解不同的市場結構，及廠商的訂價行為。",
      "describe_en": "Comprehending alternative market structures, and firm's pricing behavior."
    }
  ],
