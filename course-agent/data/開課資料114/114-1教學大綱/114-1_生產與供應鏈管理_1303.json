  "description": {
    "sub_id3": null,
    "sub_name": "生產與供應鏈管理",
    "sub_ename": "PRODUCTION AND SUPPLY CHAIN MANAGEMENT",
    "describe_ch": "本課程探討生產及服務系統中之營運作業管理，及各項作業與公司其他功能部門之關係。重點在於以計量工具解決預測、存貨、物料需求、生產排程、專案管理之問題，以及瞭解各類型生產系統之差異及運用時機。",
    "describe_eh": "本課程探討生產及服務系統中之營運作業管理，及各項作業與公司其他功能部門之關係。重點在於以計量工具解決預測、存貨、物料需求、生產排程、專案管理之問題，以及瞭解各類型生產系統之差異及運用時機。",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "本課程探討生產及服務系統中之營運作業管理，及各項作業與公司其他功能部門之關係。重點在於以計量工具解決預測、存貨、物料需求、生產排程、專案管理之問題，以及瞭解各類型生產系統之差異及運用時機。",
      "describe_en": "This course explores the operation management in the production and service system, and the relationship between each operation and other functional departments of the company. The focus is to use measurement tools to solve the problems of forecasting, inventory, material requirements, production scheduling, project management, and to understand the differences and application timing of various types of production systems."
    }
  ],
