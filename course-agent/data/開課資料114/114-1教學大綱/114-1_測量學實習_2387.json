  "description": {
    "sub_id3": null,
    "sub_name": "測量學實習",
    "sub_ename": "SURVEYING PRACTICE",
    "describe_ch": "藉由課程的講授介紹測量使用的基本儀器及儀器操作方法，實際測量外業方式，使學生熟悉與瞭解土地測量的方法及應用技術。",
    "describe_eh": "A\\To get familiar with the survey instruments and how to use the instrument to measure the angel and distance, and try to compute the coordinates with the methodology. Therefore, students will understand the method of land survey and its application.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解測量原理、作業技術及誤差傳播定律",
      "describe_en": "To know the principles, operation techniques, and law of error propagation of the surveying"
    },
    {
      "seq": 2,
      "describe_ch": "熟練各種測量儀器之操作",
      "describe_en": "To understand how to operate the surveying instruments"
    },
    {
      "seq": 3,
      "describe_ch": "能利用測量數據計算座標成果",
      "describe_en": "To utilize the surveying of field work data to calculate the coordinates of point"
    }
  ],
