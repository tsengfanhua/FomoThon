  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CD01530",
    "sub_id": "49790",
    "scr_dup": "001",
    "sub_title": "景觀理論 Landscape Theory",
    "sub_title_en": null,
    "sub_describe": "本課程主要在瞭解景觀專業中，在景觀規劃與景觀設計過程所使用的方法及概念，期望透過本課程的教授，使學生認識景觀專業知識，同時重視對景觀的認知與基本理論之訓練，培養學生對景觀的了解。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "景觀理論",
    "sub_ename": "LANDSCAPE THEORY",
    "describe_ch": "本課程主要在分析景觀風格與景觀發展變遷趨勢，闡述景觀生態與環境心理與行為之相關基礎理論，藉由理論的闡述，案例介紹與實際操作練習，使理論能落實應用到景觀與環境規劃設計。",
    "describe_eh": "The aim of the course is to analyze landscape style and the change of landscape design trend and also to introduce theory of landscape ecology and environmental psychology. Through theory introduction, case study and practical operation the theory can be applied to landscape planning and design practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解景觀建築基本觀念",
      "describe_en": "Understanding basic knowledge of landscape architecture"
    },
    {
      "seq": 2,
      "describe_ch": "了解景觀建築相關理論",
      "describe_en": "Understanding theoretical knowledge of landscape architecture"
    },
    {
      "seq": 3,
      "describe_ch": "了解景觀建築與全球環境之關係",
      "describe_en": "Understanding the relationships between global environment and landscape architecture"
    }
  ],
