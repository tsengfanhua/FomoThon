  "description": {
    "sub_id3": null,
    "sub_name": "金融機構經營與管理",
    "sub_ename": "FINANCIAL INSTITUTIONS MANAGEMENT",
    "describe_ch": "本課程著重於金融機構之風險管理，主要內容包括：金融市場與金融機構、利率風險之衡量與管理、市場風險之衡量與管理、流動性風險的衡量與管理、外匯風險的衡量與管理、銀行監理與存款保險。",
    "describe_eh": "This course focuses on the risk analysis and risk management of financial institutions. Topics include the introduction of financial institution operations, measurement and management of interest rate risk, market risk, liquidity risk, and operation risk. Also include bank regulations and deposit insurance.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生瞭解金融機構經營上所面臨的各種風險，進而對風險管理方式有所認知",
      "describe_en": "To learn about the ways in which financial institutions are exposed to risk and how they manage these exposures."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解金融機構面臨的各種風險及其因應管理方式",
      "describe_en": "Understand the risks of financial institutions and the ways that FIs manage risks"
    }
  ],
