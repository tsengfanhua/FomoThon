  "description": {
    "sub_id3": null,
    "sub_name": "分析電化學",
    "sub_ename": "ANALYTICAL ELECTROCHEMISTRY",
    "describe_ch": "課程講授電化學理論與分析方法，涵蓋基本電化學、電極動力學、電解質質傳現象、控制電位分析法、控制電流分析法和交流阻抗模擬系統等，此知識可應用於感測器、燃料電池、電化學合成、電解沉積、電鍍及腐蝕等領域之研究。",
    "describe_eh": "This course provides comprehensive coverage of fundamentals for electrochemical methods. The content includes an overview of electrode processes, kinetics of electrode reactions, mass transfer of electrolyte and various electroanalytical methods. It will be helpful to the analyses and applications of electrochemical sensors, fuel cells, electrochemical syntheses, electrolytic deposition, and corrosion.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解基本的電極電化學反應和電極與溶液介面電性　",
      "describe_en": "Understanding of the fundamental principles of electrode reactions and the electrical properties of electrode -solution interface　"
    },
    {
      "seq": 2,
      "describe_ch": "了解電化學中的熱力學，電勢，電荷傳遞動力學和質傳",
      "describe_en": "To understand electrochemical thermodynamics, emf, charge transfer, and mass transport"
    },
    {
      "seq": 3,
      "describe_ch": "閱讀與報告期刊論文",
      "describe_en": "Read and Report the journal article"
    }
  ],
