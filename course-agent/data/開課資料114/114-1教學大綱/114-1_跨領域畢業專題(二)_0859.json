  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CC00100",
    "sub_id": "57890",
    "scr_dup": "001",
    "tpa_score_new": null,
    "tpa_score_new_en": null,
    "course_pol": "同學於課堂上課可用電腦 (含筆記型電腦)、平板、手機等裝置進行筆記重點整理，請勿於上課期間進行數位遊戲玩樂、練功...等形為，亦勿於課堂中觀看 Youtube ... 等影視頻道。違者依情節輕重酌扣課堂實作分數。",
    "course_pol_en": null,
    "course_rem": "請同學善用數位裝置進行學習筆記與學習重點製作。\n課程進行都會使用 Teams 進行錄製，請同學多多利用錄影進行精熟學習\n請同學勿過度依賴 GPT 等類型之智慧化文件、程式、圖像...產生工具，建議同學自我反覆進行精熟演練以提昇對課程內容之掌握。",
    "course_rem_en": null,
    "ais_meno": "<div>同學進行實作練習時應本自身學習成果進題目演練，GPT 等相關智慧自動化產生工具為輔助學習工具勿直接使用GPT之結果為成果，經查若確為自動化軟體產生之內容，該次成果、評量為 0 分。</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": null
  },
