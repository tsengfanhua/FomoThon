  "description": {
    "sub_id3": null,
    "sub_name": "掃瞄式電子顯微鏡",
    "sub_ename": "SCANNING ELECTRON MICROSCOPY",
    "describe_ch": "掃瞄式電子顯微鏡術(SEM)及能量發散光譜儀(EDS)或電子探微儀(EPMA)為材料系學生必備的材料顯微結構及成份分析工具知識。透過小組SEM/EDS實驗操作的訓練，加深學生熟悉材料顯微結構分析原理、試片準備方法、電子光學原理、電子束與試片的交互作用、成像原理與分析判讀原則、X光 EDS/WDS光譜元素分析之操作步驟。",
    "describe_eh": "Uses of scanning electron microscopy (SEM), energy dispersive spectroscopy (EDS) or electron probe for microanalysis (EPMA) are essential analytical tools of each MSE student. Students will be guided with hand-on experiences of using SEM and EDS with to be familiar with basic knowledge of microanalysis principles, electron optics, beam-matter interactions, image formation of SEM, EDS/WDS spectral measurement, and sample preparations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解掃瞄式電子顯微鏡實驗與計畫管理技巧，並能實際評價SEM之應用向面。",
      "describe_en": "To synthesize developments and technical frontiers for SEM and key concepts of SEM applications in our daily life and industrial activities."
    },
    {
      "seq": 2,
      "describe_ch": "了解SEM基本製程技術及常用之材料分析量測方法，設計實驗課題。",
      "describe_en": "To understand the basic SEM measurement, analysis, and design experiments of ceramic materials."
    },
    {
      "seq": 3,
      "describe_ch": "以書面或口頭報告方式，對於所獲之SEM論文及研發結果與同學及教師陳述溝通。",
      "describe_en": "To synthesize verbal and written capability as discussing or explaining the SEM technical context and R&D results of the subject of electronic ceramics to the peers and the inst"
    },
    {
      "seq": 4,
      "describe_ch": "了解SEM/EDS實驗所需安全注意事項與專業責任感。\t",
      "describe_en": "To understands SEM/EDS experimental safety issues and professional responsibility."
    }
  ],
