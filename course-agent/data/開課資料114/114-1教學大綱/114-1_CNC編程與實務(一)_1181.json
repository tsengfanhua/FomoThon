    },
    {
      "seq": 3,
      "describe_ch": "三軸銑床或二軸車床之加工準備動作",
      "describe_en": "Preparations for three-axis milling machine or two-axis lathe."
    },
    {
      "seq": 4,
      "describe_ch": "數控加工機實機加工",
      "describe_en": "CNC machine tool actual machining."
    },
    {
      "seq": 5,
      "describe_ch": "數控加工程式編寫與電腦模擬",
      "describe_en": "CNC machining program writing and simulation."
    }
