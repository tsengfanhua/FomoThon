  "description": {
    "sub_id3": null,
    "sub_name": "解碼未來：科學科技與生活創新",
    "sub_ename": "DECODING THE FUTURE: SCIENCE, TECHNOLOGY & EVERYDAY INNOVATION",
    "describe_ch": "本課程從日常場景出發，帶你解碼AI、永續能源、生命科學等前沿科技，剖析其科學原理與社會脈絡；並以廚房料理、醫療診斷、智慧媒體、戰爭等情境，說明科技如何重塑生活選擇與倫理想像。透過實驗體驗、案例討論與專題創作，訓練跨域思辨與創新設計能力，使任何背景的學生皆能洞見未來，主動創造改變。",
    "describe_eh": "This course begins with everyday scenarios to help students decode emerging technologies such as AI, sustainable energy, and life sciences, examining both their scientific foundations and social contexts. Through real-world settings like cooking in the kitchen, medical diagnosis, smart media, and warfare, we explore how technology reshapes life choices and ethical imagination. By engaging in hands-on experiments, case studies, and creative projects, students will develop cross-disciplinary thinking and innovative design skills---empowering learners from all backgrounds to envision the future and become agents\nof change.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "帶領同學瞭解科學技術發展背後的社會情境和生活脈絡。",
      "describe_en": "To lead students to understand the social context behind the development of science and technology."
    },
    {
      "seq": 2,
      "describe_ch": "帶領同學有能力分析科學技術對社會發展可能帶來的影響與後果。",
      "describe_en": "To empower students to analyze the potential influence and repercussions of science and technology on social development."
    }
  ],
