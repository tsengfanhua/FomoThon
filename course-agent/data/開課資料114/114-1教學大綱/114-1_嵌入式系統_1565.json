  "description": {
    "sub_id3": null,
    "sub_name": "嵌入式系統",
    "sub_ename": "EMBEDDED SYSTEMS",
    "describe_ch": "本課程的主要目的在於介紹(1)嵌入式系統基本觀念。(2)Freescale嵌入式系統基本硬體架構、軟體指令與程式設計。(3)ARM-based嵌入式系統基本硬體架構、軟體指令與程式設計。",
    "describe_eh": "The object of this course is to introduce the following topics (1)Introducing the basic concept of embedded system.(2)Introducing the hardware structure,software instruction and programming for freescal embedded system.(3) Introducing the hardware structure,software instruction,and programming for ARM-based embedded system.",
    "pre_subname": "IEE1006邏輯設計、ELEN2012微處理機系統",
    "pre_sub_id3": "IEE1006",
    "pre_sub_ename": "IEE1006 LOGIC DESIGN、ELEN2012 MICROPROCESSOR SYSTEMS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用所學觀念設計嵌入式系統的程式。",
      "describe_en": "To apply the concept learned to develop the program for embedded systems."
    },
    {
      "seq": 2,
      "describe_ch": "理解嵌入式系統的基本硬體架構與軟體指令。",
      "describe_en": "To understand the hardware structure and software instruction of embedded systems."
    }
