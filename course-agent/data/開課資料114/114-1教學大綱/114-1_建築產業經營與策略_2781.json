    {
      "seq": 1,
      "describe_ch": "能理解建築開發關聯產業之經營與策略\t",
      "describe_en": "Be able to comprehend the operation and strategy of the building development related industries."
    },
    {
      "seq": 2,
      "describe_ch": "能分析都市建築發展過程鏈結之相關領域產業別之經營與策略\t",
      "describe_en": "Be able to analyze the operation and strategy of the industry in the relevant field based on the linkage of its production process."
    }
