  "description": {
    "sub_id3": null,
    "sub_name": "電子學(三)",
    "sub_ename": "ELECTRONICS(3)",
    "describe_ch": "電子學(三)是電機電子領域中最基本的一門課程，此課程為電子學(一)與電子學(二)之延續。因此，此課程其內容主要在探討Single-Stage IC、Multistage-IC、回授以及IC之應用電路，以進一步提供學生電子學基本原理之認識與了解，以奠定其於電機電子應用領域更深層之研究。",
    "describe_eh": "The Electronics(3) is the most basic course in the area of electrical and electronic engineering. The Single-stage IC, Multistage IC, Feedback, and some application of IC circuits, will be presented in this course. The object of this course is to give the fundamentals of microelectronic circuits. Moreover, based on the completion of this course, the more deeply study can be applied to the different applications in the electrical and electronic areas.",
    "pre_subname": "EEEN2002電子學(一)、EEEN2003電子學(二)",
    "pre_sub_id3": "EEEN2002",
    "pre_sub_ename": "EEEN2002 ELECTRONICS(1)、EEEN2003 ELECTRONICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "用自己的專業詞彙定義電子學中，何謂Mutistage IC、Feedback、Data Converters以及Power Amp能夠描述IC電路 不同迴授架構，Data Converter及 Power Amp其特性。",
      "describe_en": "Knowledge for understanding and describing the characteristics of Multistage IC, Feedback, Data converters, and Power Amplifiers in Microelectronic Circuits."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明Mutistage IC、Feedback、Data Converters以及Power Amp其特性與應用。",
      "describe_en": "Applications for the characteristics and designs of Multistage IC, Feedback, Data converters, and Power Amplifiers."
    }
  ],
