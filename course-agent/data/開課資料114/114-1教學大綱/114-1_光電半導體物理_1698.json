  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE11139",
    "sub_id": "13488",
    "scr_dup": "001",
    "sub_title": "描述光電半導體的基本特性和它的傳導過程。",
    "sub_title_en": null,
    "sub_describe": "討論所有主要半導體元件的物理和特性。首先討論對大部分半導體元件而言最關鍵的p-n接面，接下來討論雙載子和MOSFET、CMOS、DRAM和光電元件。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "光電半導體物理",
    "sub_ename": "SEMICONDUCTOR PHYSICS OF OPTO-ELECTRONICS",
    "describe_ch": "描述光電半導體的半導體特性和相關光學知識。 首先討論對大部分光電半導體元件而言最關鍵的p-n接面，接下來討論場效元件(MOS)和光電元件(LED、laser diode)。",
    "describe_eh": "Describe the semiconductor characteristics of optoelectronic semiconductors and the related optical knowledge. First, discuss the p-n junction, which is the most critical component for most optoelectronic semiconductor devices. Then, proceed to discuss field-effect devices (MOS) and optoelectronic devices (LEDs and laser diodes).",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解甚麼是光電半導體物理，並能理解Si 的晶體結構、電子、電洞概念到PN設計",
      "describe_en": "Understand what is semiconductor physics about opto-electronics, and understand the crystal structure of Si, electrons, hole concepts to PN design"
    },
    {
      "seq": 2,
      "describe_ch": "了解PN、MOS到光電元件的發展流程，並認識到背後的理論與實務的搭配",
      "describe_en": "Understand the development process of PN, MOS to opto-electronics devices and recognize the combination of theory and practice behind it"
    }
  ],
