  "description": {
    "sub_id3": null,
    "sub_name": "人文學術專題",
    "sub_ename": "SPECIAL TOPICS IN HUMANITIES",
    "describe_ch": "探索歷代「文學」所形構成的知識體系與文化傳統，深化總體「人文學」的內涵。在現代專業知識分類體制中，掌握豐厚的古典學特質，關注當代人文議題，加強與其他學科對話能力，拓展人文學術研究多元視野。",
    "describe_eh": "This class will explore the knowledge systems and culture traditions that are composed of literature in the past dynasties, and deepen the meaning of Humanities. Besides, since modern professional knowledge system was classified, this class will intend to grasp the characteristics of classic literature, to pay attention to the contemporary humanities topics, to improve the abilities of dialogues with other subjects, and to develop multidisciplinary research perspectives in humanities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "掌握人文論述的形塑與發展脈絡。",
      "describe_en": "To master the shaping process and development of humanities dissertation."
    },
    {
      "seq": 2,
      "describe_ch": "拓展人文學術研究的多元視野。",
      "describe_en": "To expand the multiple perspectives of humanities academic research."
    }
  ],
