  "targets": [
    {
      "seq": 1,
      "describe_ch": "Students learn to explore, examine, and interpret spaces and places, and to apply theoretical design frameworks and practical design methodologies to enhance engagement with the built world.",
      "describe_en": "Students learn to explore, examine, and interpret spaces and places, and to apply theoretical design frameworks and practical design methodologies to enhance engagement with the built world."
    },
    {
      "seq": 2,
      "describe_ch": "Students learn to exercise communication skills in multidisciplinary design teams to collaborate effectively in various design situations.",
      "describe_en": "Students learn to exercise communication skills in multidisciplinary design teams to collaborate effectively in various design situations."
    },
    {
      "seq": 3,
      "describe_ch": "Students can effectively conduct, evaluate, interpret, and synthesise primary and secondary research to understand place-specific social, cultural, and environmental issues.",
      "describe_en": "Students can effectively conduct, evaluate, interpret, and synthesise primary and secondary research to understand place-specific social, cultural, and environmental issues."
    },
    {
      "seq": 4,
      "describe_ch": "Students can distinguish, analyse and compare how spatial, temporal and social contexts impact design for human behaviour in the physical world.",
      "describe_en": "Students can distinguish, analyse and compare how spatial, temporal and social contexts impact design for human behaviour in the physical world."
    }
  ],
