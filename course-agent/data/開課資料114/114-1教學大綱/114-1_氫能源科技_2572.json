  "description": {
    "sub_id3": null,
    "sub_name": "氫能源科技",
    "sub_ename": "HYDROGEN TECHNOLOGY",
    "describe_ch": "本課程乃是針對氫能源科技相關背景知識進行說明，並熟悉化石能源短缺及全球暖化所帶來之影響。除了參考目前相關國內外氫能源科技之現況發展外，也深入針對各種產氫方式、儲存及應用等加以闡述。本課程除了透過課堂講授外，也將透過「課堂上分組報告」方式，將所獲得氫能源科技相關資訊與同儕及教師報告，進而展現小組團隊合作之能力。",
    "describe_eh": "This course aims to explain the background knowledge of hydrogen energy technology and is familiar with the impact of fossil energy shortages and global warming. In addition to referring to the current development of hydrogen energy technology at home and abroad, it also elaborates on various hydrogen production methods, storage, and applications. In addition to lectures in class, this course will also report on the hydrogen energy technology-related information obtained with peers and teachers through the method of \"group report in class\" and then demonstrate the ability of group teamwork.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能表達並說明氫能源何以取代傳統之化石能源",
      "describe_en": "Understand and express why hydrogen fuel can replace fossil fuel."
    },
    {
      "seq": 2,
      "describe_ch": "能辨識氫能研究在材料科學與工程及學術層面的重要性",
      "describe_en": "Be able to explain the importance of hydrogen energy to materials science and engineering and academia."
    },
    {
      "seq": 3,
      "describe_ch": "能以口頭報告方式將所獲資訊與同儕及教師溝通並透過小組展現團隊合作能力",
      "describe_en": "Communicate information in oral form to classmates and the instructor. Demonstrate team spirit through teamwork."
    }
  ],
