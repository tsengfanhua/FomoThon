  "description": {
    "sub_id3": null,
    "sub_name": "應用電子學實驗(一)",
    "sub_ename": "APPLIED ELECTRONICS LAB. (1)",
    "describe_ch": "本課程的目的是提供對類比及數位電路之分析及設計的基本能力實習，包含銜接實際應用的一些進階示範。上學期介紹主要元件的物理性質、工作特性和基本的應用電子電路分析。",
    "describe_eh": "The purpose of this course is to provide a basic practice for analyzing and designing both analog and digital electronic circuits. More advanced material about practical applications are included. In the first part of this course,we introduce the physical characteristics and operation of the major semiconductor dvices and the basic circuits in which they are used.",
    "pre_subname": "PHYS1002普通物理實驗(二)",
    "pre_sub_id3": "PHYS1002",
    "pre_sub_ename": "PHYS1002 GENERAL PHYSICS LAB.(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解基礎電學測量工具之原理，並能正確使用基礎測量工具。",
      "describe_en": "Understand the theory and formal operation of basic electronic signal measurements."
    },
    {
      "seq": 2,
      "describe_ch": "2能藉由實驗課的實作及電腦軟體的模擬去了解二極體和電晶體的原理及相關電路之分析.　",
      "describe_en": "2. Understand the theory of diode and transistor and analyze the related circuit by experiments and computer simulation.　"
    },
    {
      "seq": 3,
      "describe_ch": "透過分組作業培養團隊合作精神及有效溝通能力。",
      "describe_en": "To develop team spirit and the ability of efficient communication through teamwork."
    }
  ],
