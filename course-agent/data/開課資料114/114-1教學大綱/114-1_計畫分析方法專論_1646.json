  "description": {
    "sub_id3": null,
    "sub_name": "計畫分析方法專論",
    "sub_ename": "SPECIAL TOPICS OF PLANNING ANALYSIS",
    "describe_ch": "計畫方法特論是一門結合統計、線性規劃、決策理論等領域的學科。其目的是教授如何將複雜的資料進行整合、分類並利用線性規劃的技巧來做出最佳的決策，同時並以實際案例為例進行演練。",
    "describe_eh": "Special Topics of Planning Analysis is an integrated course, that involving statistics Linear programming and decision analysis and making. The main theme is to teach how to probe into the complicated data and use the linear programming technique to solve it and make a better decision.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解並說明計畫分析與決策的組成與理論",
      "describe_en": "Understand and explain the contents of planning analysis and decision making theory.\r\n"
    },
    {
      "seq": 2,
      "describe_ch": "能辨識計畫分析方法的不同模組且能清楚的表達其意義\r\n",
      "describe_en": "Identify the planning analysis modules and express the meaning of each module.\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "能建構決策分析的模式\r\n",
      "describe_en": "Construct the decision modules \r\n"
    },
    {
      "seq": 4,
      "describe_ch": "能評估決策分析模式的優劣",
      "describe_en": "Abilities to evaluate the decision models.\r\n"
    }
  ],
