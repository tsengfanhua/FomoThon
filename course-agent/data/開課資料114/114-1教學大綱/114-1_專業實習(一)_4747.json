  "description": {
    "sub_id3": null,
    "sub_name": "專業實習(一)",
    "sub_ename": "INTERNSHIP (1)",
    "describe_ch": "本課程遴選學生至產業進行碩士論文相關之專業實習，期能整合學生的理論與實務，強化務實致用能力，及提升專業競爭力。",
    "describe_eh": "The course provides students with thesis-related internship opportunities in industry. It aims to integrate theoretical studies and actual practices to strengthen the professional skills and the competitiveness of students.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 6.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能整合光電理論與實務。",
      "describe_en": "To integrate photonics theories and practices."
    },
    {
      "seq": 2,
      "describe_ch": "能與同儕溝通協調與團隊合作。",
      "describe_en": "To communicate and work with colleagues effectively."
    },
    {
      "seq": 3,
      "describe_ch": "能具有專業倫理及社會責任素養。",
      "describe_en": "To possess the cultivation of industrial ethics and social responsibilities."
    },
    {
      "seq": 4,
      "describe_ch": "能學習領導、管理及規劃之能力。",
      "describe_en": "To learn leadership, management and planning."
    }
  ],
