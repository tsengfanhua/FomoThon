  "description": {
    "sub_id3": null,
    "sub_name": "固態物理",
    "sub_ename": "SOLID STATE PHYSICS",
    "describe_ch": "幫助學生了解並運用在固態晶體中基本的物理觀念及理論. 內容包括、晶體結構、倒置晶格、鍵結及彈性常數、聲子I. 晶格振動、聲子II. 熱性質、費米電子、能階、半導體晶體、費米表面及金屬等。",
    "describe_eh": "To help students understand and be able to apply fundamental concepts and theories of physics involved in solid state crystals. The topics to be taught includes：Crystal structure, Reciprocal lattice, Crystal Binding and elastic constants, Phonons I. Crystal vibration, Phonons II. Thermal properties, Free Electron Fermi Gas, Energy Bands, Semiconductor crystals, Fermi surfaces and metals etc..",
    "pre_subname": "ENGS2011工程數學(一)、ENGS2013工程數學(二)、PHYS3001量子力學導論",
    "pre_sub_id3": "ENGS2011",
    "pre_sub_ename": "ENGS2011 ENGINEERING MATHEMATICS(1)、ENGS2013 ENGINEERING MATHEMATICS(2)、PHYS3001 INTRODUCTION TO QUANTUM MECHANICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "區別固體的晶體結構，包括多晶、非晶以及單晶的材料",
      "describe_en": "To distinguish the crystal structures of solid including polystalline, amorphous and single crystalline materials."
    },
    {
      "seq": 2,
      "describe_ch": "能將真實晶格轉換成倒置晶格，並推斷出其相關之物理性質，包括晶體中波的繞射、散射波的振幅、布里淵區及準晶體",
      "describe_en": "To transform real lattices into reciprocal lattices, and derive the related physic properties, including diffraction waves in a crystal, scattering wave amplitude, brillouin zone and quasi-crystal."
    },
    {
      "seq": 3,
      "describe_ch": "分辨晶體鍵結的型式和彈性常數，包括離子、共價、凡得瓦而及氫鍵，推衍簡單立方晶格的彈性常數",
      "describe_en": "To understand the types of crystal binding and elastic modules, including ionic, covalent, van der waals, and hydrogen bonds. To derive the elastic modules of a simple cubic crystal."
    },
    {
      "seq": 4,
      "describe_ch": "比較晶格的振動( i.e. phonons)模式，推衍晶格的振動、彈性波的量子化與聲子的動量，以聲子理論推衍熱容量、浦朗克分佈、Debye模型以及Einstein模型",
      "describe_en": "To compare the vibration modes of crystal lattices (i.e. phonons), derive the vibration modes of a cell, quantized elastic wave, momentum of phonons, capacity, Planck distribution, Debye model, and Einstein Model by the theory of phonon."
    }
  ],
