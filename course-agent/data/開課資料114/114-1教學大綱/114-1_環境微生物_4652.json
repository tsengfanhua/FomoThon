  "description": {
    "sub_id3": null,
    "sub_name": "環境微生物",
    "sub_ename": "ENVIRONMENTAL MICROBIOLOGY",
    "describe_ch": "探討土壤、水及空氣環境中之微生物，以及其與有機或無機污染物之間相互作用之關係。同時對於人類福祉有關之新菌種之分離及其產物之應用近年來也是環境微生物涵蓋之內容。",
    "describe_eh": "To study of soil, water, and air systems, including the interaction of indigenous microbes with organic and inorganic pollutants as well as the behavior of pathogens introduced into these systems. The discovery and application of new microbes and their products to benefit human health and welfare are also introduced.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "微生物應用於污染物處理之專業知識　\t",
      "describe_en": "Understand the application of microorganisms in the environmental pollutants and its theory　"
    },
    {
      "seq": 2,
      "describe_ch": "理解微生物代謝之原理，應用於處理污染物，並能清楚表達。　\t",
      "describe_en": "Understand and distinguish the principle of microbial metabolism, and clearly describe its application to pollutants' treatment　"
    },
    {
      "seq": 3,
      "describe_ch": "以書面及口頭方式綜合所獲得之知識　\t",
      "describe_en": "Communicate results in written or oral form to classmates and instructors　"
    }
  ],
