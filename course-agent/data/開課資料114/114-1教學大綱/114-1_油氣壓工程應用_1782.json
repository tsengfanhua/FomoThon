  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "油氣壓工程應用",
    "sub_ename": "APPLICATIONS OF HYDRAULIC AND PNEUMATIC ENGINEERING",
    "describe_ch": "本課程主要使學生認識氣、油壓元件的構造、動作原理、特性與應用，進而了解氣、油壓迴路設計,並安排同學於期末參加\"氣壓乙級證照\"考試,以取得\"氣壓乙級證照\"。",
    "describe_eh": "The main purpose of this course is teaching student to familiar with the structure and operation principle of pneumatics and hydraulics and then to comprehend circuit design of pneumatic and hydraulic system, and arrange for students to participate in the \"Air Pressure Class B License\" exam at the end of the semester to obtain the \"Air Pressure Class B License\".",
    "pre_subname": "AUTO3031油氣壓控制工程",
    "pre_sub_id3": "AUTO3031",
    "pre_sub_ename": "AUTO3031 HYDRAULIC & PNEUMATIC ENGINEERING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解各種油氣壓元件之基本功能與知識",
      "describe_en": "Understanding the basic function and  knowledge of various pneumatic/ hydraulic devices."
    },
    {
      "seq": 2,
      "describe_ch": "理解各種油氣壓元件與油氣壓迴路的工程原理",
      "describe_en": "Comprehension for the engineering principle of various pneumatic/ hydraulic devices and circuits."
    },
    {
      "seq": 3,
      "describe_ch": "應用階梯圖之觀念與方法完成油氣壓迴路之電氣設計與測試",
      "describe_en": "Application for the ladder diagram concept and method to design pneumatic/ hydraulic electrical circuits."
    },
    {
      "seq": 4,
      "describe_ch": "參與專業認證，提升職場專業之競爭力",
      "describe_en": "Participate in professional certification to enhance the competitiveness of the professional workplace."
    }
  ],
