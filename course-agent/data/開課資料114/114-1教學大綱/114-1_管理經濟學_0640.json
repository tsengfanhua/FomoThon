  "description": {
    "sub_id3": null,
    "sub_name": "管理經濟學",
    "sub_ename": "MANAGERIAL ECONOMICS",
    "describe_ch": "追求效率，是本課程介紹的重點。因此，不論是組織改造、制度變更、薪資調整、人力資本、教育訓練及市場策略，均會有所分析。特別是在不同廠商規模、集團式或跨國式經營，將以交易成本的觀點，來介紹其運作的效率。",
    "describe_eh": "We emphasize on the efficiency of business management. Analyzing subjects include organization evolution, institution change, wage structure, human capital, and strategies of markets. Especially, we will apply viewpoints of transaction cost to firm scale, group or multinational enterprises.",
    "pre_subname": "ECON1001經濟學(一)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用經濟學的思考方法於企業最適決策，並理解廠家不同目標及其面對的侷限",
      "describe_en": "Apply the economic way of thinking to business optimal decisions，Comprehension for the different goals and constraints that firms face and constraints that firms face"
    },
    {
      "seq": 2,
      "describe_ch": "能理解及應用廠商的不同訂價決策或策略",
      "describe_en": "Comprehension & application for the various pricing decisions or strategies for firms"
    },
    {
      "seq": 3,
      "describe_ch": "理解賽局理論與訊息經濟學如何用於各種企業決策",
      "describe_en": "Understand how game theory & information economics can be used to explain a number of business decisions"
    },
    {
      "seq": 4,
      "describe_ch": "理解投資理論如何應用於廠商資本購買決策",
      "describe_en": "Understand how investment theory is used to examine a firm's capital purchasing decisions"
    }
  ],
