  "description": {
    "sub_id3": null,
    "sub_name": "電子商務",
    "sub_ename": "ELECTRONIC COMMERCE",
    "describe_ch": "本課程旨在裝備學生具有電子商務的知識與實務，本課程也是學生進入電子商務殿堂的入口。所涵蓋的內容包括商業模式(B2B, B2C, C2B, C2C等)、網站設計、網路行銷、網站經營與管理、個案研討等。",
    "describe_eh": "To equip the graduates with the knowledge and practice of e-commerce. This course is an entry point to the arena of e-commerce. Many basic issues will be covered, including business modes (B2B, B2C, C2B, and C2C), web design, Internet marketing, management and operation of Internet businesses, case studies, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解電子商務的發展與經營模式。",
      "describe_en": "Comprehension for the development and business model of electronic commerce."
    },
    {
      "seq": 2,
      "describe_ch": "能分析各種電子商務模式的特點。",
      "describe_en": "Analysis of the characteristics of electronic commerce."
    },
    {
      "seq": 3,
      "describe_ch": "能理解電子商務專業英文詞彙。",
      "describe_en": "Comprehension of the vocabulary of electronic commerce in English."
    }
  ],
