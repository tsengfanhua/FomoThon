  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CD06540",
    "sub_id": "10588",
    "scr_dup": "001",
    "sub_title": "自來水系統之工程設計與實務。",
    "sub_title_en": null,
    "sub_describe": "介紹自來水系統中之導水、淨水、送水、配水、給水及附屬設備等處理程序之工程實務，並透過現場參觀自來水公司淨水廠，了解實際處理流程。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "自來水工程導論",
    "sub_ename": "INTRODUCTION OF TAP WATER ENGINEERING",
    "describe_ch": "自來水工程涵蓋飲用水供應及處理之設計和施工，包括估算所需水量、取水、淨水處理、運輸及水量分配。",
    "describe_eh": "Tap water engineering covers the design and construction of drinking water supply and treatment, including estimating the required water volume, water intake, water purification treatment, transportation and water distribution.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "運用數學、科學及相關工程知識的能力",
      "describe_en": "The ability to use mathematics, science, and engineering knowledge"
    },
    {
      "seq": 2,
      "describe_ch": "具備可操作與設計實驗，以及數據分析的能力",
      "describe_en": "The ability to design and conduct experiments, as well as to analyze and interpret data"
    },
    {
      "seq": 3,
      "describe_ch": "具備工程實務所需技術、技巧及使用工具之能力",
      "describe_en": "To have practical engineering techniques and skills and the ability to operate instruments"
    },
    {
      "seq": 4,
      "describe_ch": "具設計自來水工程相關設備、系統、設施元件或製程的能力",
      "describe_en": "The ability to design tap water engineering equipment, systems, facilities, components, or processes"
    }
  ],
