  "description": {
    "sub_id3": null,
    "sub_name": "中華民國憲法",
    "sub_ename": "CONSTITUTION OF THE R.O.C.",
    "describe_ch": "憲法課程實為研修其他法律課程之必備基礎。此課程設定為一學期，內容上將著重使學生習於法規位階結構及憲法上對基本權利的保護。其中，將特別重視憲法爭訟程序及公法上一般法理的理解。",
    "describe_eh": "The knowledge about constitutional law is the fundament for advanced learning in other law system. This one-semester course will guide the student to be used to the Norm hierarchy and the protection of human right under constitutional law. A special concern will be the process of constitutional law and the elemental theories, principals of public laws.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能暸解憲法之基本原理原則",
      "describe_en": "To realize the principle and theory of constitution"
    },
    {
      "seq": 2,
      "describe_ch": "能暸解憲法在日常生活中所扮演之角色",
      "describe_en": "To realize the relationship between constitution and life"
    },
    {
      "seq": 3,
      "describe_ch": "能培養邏輯思考的能力",
      "describe_en": "To train the logical thinking"
    }
  ],
