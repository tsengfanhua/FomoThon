  "description": {
    "sub_id3": null,
    "sub_name": "財務風險管理",
    "sub_ename": "FINANCIAL RISK MANAGEMENT",
    "describe_ch": "本課程著重在銀行的風險管理，其中包括銀行風險管理的目的、銀行面臨的各種風險、如何衡量銀行所面臨的各種風險、如何透過各種風險管理技術及工具有效地管理銀行所面臨的各種風險。本課程亦將對銀行監理制度的變革及其對銀行風險管理的影響做深入的探討。",
    "describe_eh": "The course includes providing access to why and what of bank risk management, how to measure the bank risk, tools and instruments for bank risk management. The evolution of bank regulation and its effect on bank risk management are also discussed in this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
