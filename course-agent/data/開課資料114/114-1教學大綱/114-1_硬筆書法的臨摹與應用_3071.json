  "description": {
    "sub_id3": null,
    "sub_name": "硬筆書法的臨摹與應用",
    "sub_ename": "COPY PAINTING AND APPLICATION OF CHINESE HANDWRITING",
    "describe_ch": "本課程以傳統中國法帖為範本(行書及楷書為主，兼及隸書)，選用適合之硬筆，配合賞析與臨摹，引領學生了解書法字形結構與謀篇布局之美。此外，並藉由單字、字組及章法練習，將硬筆書法帶入日常書寫(例如:書信、信封、書籤與筆記等)，進而提升學生對漢字美學之認識與實際應用能力。",
    "describe_eh": "This course uses traditional Chinese calligraphy as a template (mainly running script and regular script, and also official script), using suitable hard pens, with appreciation and copying, to guide students to understand the beauty of calligraphy glyph structure and layout. In addition, through the practice of vocabulary, word group and composition, hard pen calligraphy is brought into daily writing (such as letters, envelopes, bookmarks, notes, etc.), thereby enhancing students' understanding of Chinese character aesthetics and practical application skills.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "引領學生了解漢字造型之美",
      "describe_en": "Guide students to understand the beauty of the style of calligraphy"
    },
    {
      "seq": 2,
      "describe_ch": "硬筆書法在生活上之應用",
      "describe_en": "The application of handwriting literature and beauty in life"
    }
