  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "XC04111",
    "sub_id": "GH215",
    "scr_dup": "001",
    "sub_title": "佛法與人生講座：多元學習，每位同學自行擇一場聽講，並撰寫1篇心得報告(每篇500字)場次如下說明",
    "sub_title_en": null,
    "sub_describe": "場次：講者\t日期\t               時間\t          地點\t                           主題\n1~見額法師  2025/09/15(一)18:30~20:30 人言B1第四國際聽\t研討：金剛經即非金剛經，是名金剛經\n2~見寅法師 2025/10/15(一)18:30~20:30 人言B1第四國際聽\t           未定\n3~法藏法師 2025/11/01(六) 09:10~10:30 人言B1第六國際廳\tAI時代的覺察與自由\n4~惠空法師 2025/11/01(六) 10:40~12:00 人言B1第六國際廳\t禪觀如何安淨身心\n5~見護法師 2025/11/01(六) 15:20~16:40 人言B1第六國際廳\t從安心到解脫－貫通大小乘的「四念處」\n6~見護法師 2024/11/03(一) 19:00~21:00 人言B1第四國際廳\t金剛經的生活觀行\n7~見護法師 2024/11/04(二) 13:10~14:50 人言B1第六國際廳\t了解自心~知、識、覺、照\n8~見滌法師 2024/12/01(一) 13:10~15:00 人言B1第六國際廳\t未定\n9~見達法師 2024/12/08(一) 19:00~21:00 人言B1第六國際廳\t未定",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "宗教與人生",
    "sub_ename": "RELIGION AND LIFE",
    "describe_ch": "本課程通過基督教與佛教的基本介紹，讓學生在多元文化的今天，對不同的宗教有更深的認識，也讓學生感受不同宗教對美好人性的追求，進而探索人生意義與生命價值。",
    "describe_eh": "This course gives a basic introduction to Christianity and Buddhism. It allows students to have a deeper understanding of different religions in this society of cultural diversity, and also allows students to experience the pursuit of beautiful humanity in different religions and explore the meaning and value of life.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解所介紹之宗教信仰的價值觀與人生智慧，學習尊重多元價值",
      "describe_en": "Understand the values and life wisdom of the introduced religions and learn to respect multiple values"
    },
    {
      "seq": 2,
      "describe_ch": "了解宗教對人生的影響，培養積極樂觀的生活態度",
      "describe_en": "Understand the influence of religions in lives and cultivate a positive and optimistic attitude toward life"
    }
  ],
