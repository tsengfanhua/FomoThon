  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB26119",
    "sub_id": "16404",
    "scr_dup": "001",
    "sub_title": "以Auto CAD 和3Ds Max來探討產品的製圖、設計和表現法。",
    "sub_title_en": "To explore the drawing, design and presentation of product by Auto CAD and 3Ds Max.",
    "sub_describe": "由於科技已經進入AI時代，其意味許多的產業正全面性的電腦科技化，但無論AI如何發展，學生仍然得具備基礎的產品發展知識，這其中的Auto CAD 和3Ds Max軟體被用來協助產品設計，仍然是用來探討產品的製圖、設計和表現法的重要基礎。",
    "sub_describe_en": "As technology has entered the AI ​​era, it means that many industries are being computerized in an all-round way. However, no matter how AI develops, students still need to have basic product development knowledge. Among them, Auto CAD and 3Ds Max software are used to assist in product design and are still an important foundation for exploring product drawing, design and expression."
  },
  "description": {
    "sub_id3": null,
    "sub_name": "行銷表現工法",
    "sub_ename": "MARKETING ILLUSTRATION",
    "describe_ch": "產品/服務的價值表現包涵許多非語言溝通，從版面構圖、產品色彩包裝、影音剪輯處理、茶席美感設計、舞台表演創作，以簡單線條與造型提升設計概念，以細膩的工法激發學生獨創性的表現，加強表現工法，落實行銷組合的執行。",
    "describe_eh": "Product / service value performance bear a lot of non-verbal communication from the layout composition, product color packaging, audio and video clip handle tea seats beauty of design, stage performances creation, simple lines and shapes to enhance the design concept, delicate work method to stimulate students' ingenuity ofperformance, to enhance the performance of engineering methods, the implementation of the implementation of the marketing mix.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解行銷表現的基本概念",
      "describe_en": "Understand the basic concepts of the design"
    },
    {
      "seq": 2,
      "describe_ch": "美感表現力應用於行銷企劃",
      "describe_en": "The beauty of expression used in marketing planning"
    }
  ],
