  "description": {
    "sub_id3": null,
    "sub_name": "韻文發展與流行音樂之美",
    "sub_ename": "THE DEVELOPMENT OF RHYME AND THE BEAUTY OF POP MUSIC",
    "describe_ch": "以流行音樂為核心概念，探討文學之美。透過歌曲文本分析，看見歌曲與文學連結的現象，藉由討論、賞析及表達，習得文學與音樂的美學素養。",
    "describe_eh": "With popular music as the core concept, we explore the beauty of literature. Through the analysis of song texts, we can observe the phenomenon of the connection between songs and literature; through discussion, appreciation and expression, we acquire the aesthetic quality of literature and music.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過歌曲文本閱讀、聆聽及討論，培養學生分析、思考與表達之能力。",
      "describe_en": "Through the reading, listening and discussion of song texts, students can develop the ability of analysis, thinking and expression."
    },
    {
      "seq": 2,
      "describe_ch": "結合文學及流行歌曲跨領域連結，發覺韻文之美，習得藝術欣賞之素養。由歌曲意境，洞悉作者之心，以及歌曲關注議題。",
      "describe_en": "Combine literature and popular songs to interdisciplinary link, discover the beauty of rhymes, and acquire the quality of art appreciation. From the artistic conception of the song, you can gain insight into the author's heart and the issues that the song focuses on."
    }
  ],
