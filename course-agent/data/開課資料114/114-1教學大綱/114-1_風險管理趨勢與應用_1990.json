  "description": {
    "sub_id3": null,
    "sub_name": "風險管理趨勢與應用",
    "sub_ename": "APPLICATION AND TRENDS OF RISK MANAGEMENT",
    "describe_ch": "本課程討論風險對個人及企業的影響，以及如何控制這些風險、取得風險財源，本課程將分別從理論與實務的角度探討風險管理的最新趨勢與應用。",
    "describe_eh": "The mission of the course is to educate students in the theory and practice of risk management at an advanced level. Business organizations are exposed to loss-causing events that may have significant impact on their financial position. This course also introduces new financial tools and recent trend of risk management  and developments.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解風險管理工具對個人與企業的財務效果",
      "describe_en": "Understand the effects of various risk management methodologies on individuals and corporations"
    },
    {
      "seq": 2,
      "describe_ch": "能應用財務理論以了解個人與企業管理風險的目的",
      "describe_en": "Can apply financial theories to understand the purposes for individuals and corporations to manage their risks"
    },
    {
      "seq": 3,
      "describe_ch": "能知道投資學在金融市場中的基本功能",
      "describe_en": "Knowledge of the basic functions of Investments in financial markets."
    }
  ],
