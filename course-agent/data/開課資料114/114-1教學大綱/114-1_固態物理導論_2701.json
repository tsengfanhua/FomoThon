  "description": {
    "sub_id3": null,
    "sub_name": "固態物理導論",
    "sub_ename": "INTRODUCTION TO SOLID STATE PHYSICS",
    "describe_ch": "本課程將從晶體晶格的物理描述開始，逐步引入倒晶格、晶體的結合、晶格振動與聲子等概念，接著討論電子在晶體中的行為，學習自由電子費米氣、費米能階、電子能帶結構、能隙及等重要課題，並探討它們在半導體領域的應用。\r\n",
    "describe_eh": "In this course, we start from the lattice structures of crystal, and gradually introduce the concepts of reciprocal lattice, crystal binding, lattice vibrations and phonons. Next, by studying the behavior of electrons in the crystals, students will learn important topics such as electron Fermi gas, Fermi level, band structures and energy gap, and their applications in semiconductors.\r\n",
    "pre_subname": "PHYS2005近代物理、PHYS3001量子力學導論",
    "pre_sub_id3": "PHYS2005",
    "pre_sub_ename": "PHYS2005 MODERN PHYSICS、PHYS3001 INTRODUCTION TO QUANTUM MECHANICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道如何以量子物理概念描述、分析固態晶體的相關性質和各種交互作用。",
      "describe_en": "Know how to describe and analyze various properties and interactions of solid crystals through the basic viewpoints of Quantum Physics."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解電子在晶體中的行為機制及能帶相關重要概念。",
      "describe_en": "Understand the mechanisms of electrons in crystal and the energy band related concepts."
    },
    {
      "seq": 3,
      "describe_ch": "學習從期刊文章中擷取與固態物理相關之最新文獻，並提出書面或口頭報告。",
      "describe_en": "Learn to extract the latest information from the solid state physics-related journal articles and give a written or oral report."
    }
  ],
