  "description": {
    "sub_id3": null,
    "sub_name": "地方創生與數位應用",
    "sub_ename": "REGIONAL REVITALIZATION AND DIGITAL APPLICATION",
    "describe_ch": "本課程以臺中市山城地區為實踐場域，透過地方創生、社區設計和永續發展概念和案例的學習，引領學生思考如何運用在地資源，結合合適的數位工具，提出兼具人文關懷的數位工具應用設計方案。",
    "describe_eh": "This course utilizes Taichung City's mountainous area as its practical field. Through studying the concepts and cases of regional revitalization, community design, and sustainable development, it guides students to consider how to mobilize social resources and combine appropriate digital tools to propose humanistic digital solutions.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠理解地方創生和社區設計概念，知悉如何蒐集和運用在地社會資源。",
      "describe_en": "Students can understand the concepts of regional revitalization and community design, and how to mobilize social resources."
    },
    {
      "seq": 2,
      "describe_ch": "能夠提出解決特定在地問題的數位工具應用設計構想提案。",
      "describe_en": "Students have the ability to propose design ideas for the application of digital tools to solve specific local problems."
    }
  ],
