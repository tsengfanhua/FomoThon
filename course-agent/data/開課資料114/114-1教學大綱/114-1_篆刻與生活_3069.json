  "description": {
    "sub_id3": null,
    "sub_name": "篆刻與生活",
    "sub_ename": "SEAL ENGRAVING AND LIFE",
    "describe_ch": "印章始於商代，從官印、私印、駱馬印、錢幣、兵器刻詞、建築瓦當到文房書畫收藏印或齋館印等，在在體現篆刻與日常生活之緊密關係。本課程將引領學生了解篆刻之型式美，並將其運用在生活上。",
    "describe_eh": "The seals began in the Shang Dynasty, from official seals, private seals, llama seals, coins, weapon engravings, architectural tiles, to study and calligraphy collections and seals, and Zhaiguan seals, reflecting the close relationship between seal cutting and daily life. This course will guide students to understand the beauty of cutting style and apply it to their lives.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "引導學生體會篆刻之美",
      "describe_en": " Guide students to understand the beauty of the style of seal cutting"
    },
    {
      "seq": 2,
      "describe_ch": "篆刻之型式運用在生活上",
      "describe_en": "Learn sealing type used in life beauty of the style of seal cutting"
    }
  ],
