  "description": {
    "sub_id3": null,
    "sub_name": "世界經濟與中國趨勢",
    "sub_ename": "WORLD ECONOMY AND THE MAJOR TRENDS OF CONTEMPORARY CHINA",
    "describe_ch": "本課程將從中國社會的特質、社會主義的轉型、世界經濟市場的變化三方面進行探討。透過分組討論讓學生了解世界經濟與大中華地區的發展趨勢與經營策略。",
    "describe_eh": "This course will explore the characteristics of Chinese society, the transformation of socialism, and the changes of the economic market in the world. Through group discussions, students will understand the development trends and business strategies of the world economy and the Greater China.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "從長期結構分析中國社會特質與中國特色的社會主義市場經濟　\t",
      "describe_en": "Analyze the basic structure of Chinese society from long-term perspective and socialist market economy and its transformation.　"
    },
    {
      "seq": 2,
      "describe_ch": "解讀資本主義世界經濟掌握未來趨勢\t",
      "describe_en": "Interpret the development of capitalist world-economy and catch its trends."
    }
  ],
