    "sub_name": "行銷研究",
    "sub_ename": "MARKETING RESEARCH",
    "describe_ch": "運用科學的方法，收集和分析有關行銷研究的資訊，以解決行銷管理決策的問題。其內容包含行銷研究的程序、次級資料、訪問法、觀察法、問卷設計、抽樣方法、個案資料分析、撰寫研究報告等。",
    "describe_eh": "This course teaches how to use scientific methods to systematically collect and analyze marketing related information in order to solve marketing management decisions.",
    "pre_subname": "MGT2020行銷管理、STAT6005多變量分析",
    "pre_sub_id3": "MGT2020",
    "pre_sub_ename": "MGT2020 MARKETING MANAGEMENT、STAT6005 MULTIVARIATE ANALYSIS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解行銷研究在行銷管理上的重要性。",
      "describe_en": "To understand the Important of the Marketing Research in Marketing management."
    },
    {
      "seq": 2,
      "describe_ch": "解釋各項統計方法之操作應用。",
      "describe_en": "To explain Exploration in Statistical method."
    },
    {
      "seq": 3,
      "describe_ch": "闡述行銷研究的探索性、結論性及預測性研究方法。",
      "describe_en": "To introduce the research methods exploratory, conclusive and forecasting research."
    },
    {
      "seq": 4,
      "describe_ch": "電腦評估之行銷研究應用。",
