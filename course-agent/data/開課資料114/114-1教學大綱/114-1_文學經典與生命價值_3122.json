  "description": {
    "sub_id3": null,
    "sub_name": "文學經典與生命價值",
    "sub_ename": "LITERATURE IN LIFE",
    "describe_ch": "本課程以人為本，讓學生在閱讀及理解前人的生命脈絡中，找到適合自己的生活方式。課程內容包括敘事性與批判性作品的解讀與鑑賞，將培養學生的文學鑑賞能力、邏輯思辨能力以及語文表達能力，輔以應用類文字表達能力訓練。以古今文學作品為引子，結合生命與社會議題，提高學生人文素養與文字表達能力。",
    "describe_eh": "This course focuses on a \" humanities literacy \" approach, enabling students to find a lifestyle suitable for themselves through reading and understanding the life context of their predecessors.\nThe course involves the interpretation and appreciation of narrative and critical texts, aiming to cultivate students' abilities in literary appreciation, logical reasoning, and language expression. Additionally, there is training provided on how to write applied texts.\nIn other words, the course introduces classical and modern texts, combining life and societal issues to enhance students' humanistic literacy and their proficiency in written expression.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習古典與當代文本，瞭解人文素養的重要性",
      "describe_en": "Learning classical and contemporary texts to understand the importance of humanities literacy."
    },
    {
      "seq": 2,
      "describe_ch": "找尋自我定位，規劃個體與群體得以平衡的生活",
      "describe_en": "Exploring self-identification and planning a balanced life for both individual and collective well-being."
    }
  ],
