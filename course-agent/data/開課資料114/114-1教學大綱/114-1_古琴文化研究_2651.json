  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解古琴的歷史與它在中華文化中的地位。",
      "describe_en": "Understand the history of the guqin and its place in Chinese culture."
    },
    {
      "seq": 2,
      "describe_ch": "由古琴的視角出發，重新審視中國儒釋道的哲理與詩詞歌賦等文學作品。",
      "describe_en": "From the perspective of Guqin, re-examine the philosophies of Chinese Confucianism, Buddhism, and Taoism, poetry, and other literary works."
    }
