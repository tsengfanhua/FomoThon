  "description": {
    "sub_id3": null,
    "sub_name": "古琴文化研究",
    "sub_ename": "THE RESEARCH OF GU-QIN",
    "describe_ch": "本課程分為三大主軸：古琴文化介紹、古琴音樂與工藝美學、傳統文化的創意產業包裝行銷。課程素材包括書面、圖片、影音等多媒體資料，另有「彈奏體驗」、「琴茶一味」的實務操作。",
    "describe_eh": "This course is divided into three main axes: introduction to guqin culture, guqin music and craft aesthetics, and creative industry packaging and marketing of traditional culture.\r\nThe course materials include multimedia materials such as written, pictures, audio and video, as well as practical operations of \"playing experience\" and \" guqin tea blindly\".\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
