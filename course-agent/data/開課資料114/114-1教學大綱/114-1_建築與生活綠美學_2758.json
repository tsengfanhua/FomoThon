  "description": {
    "sub_id3": null,
    "sub_name": "建築與生活綠美學",
    "sub_ename": "ARCHITECTURE AND AESTHETICS OF SUSTAINABLE LIVING",
    "describe_ch": "本課程將透過不同面向及觀點，探索建築本身及相關領域，延伸至關於美學素養及廣義永續生活的趨勢概念與實踐，課程內容包括宏觀的理念及微觀的個案研究，激發與建築範疇不同層級的影響、思維及對話。",
    "describe_eh": "This course is designed to explore architecture and related fields through different aspects and perspectives, with emphasis on aesthetics, sustainable concepts, trends and implementation.  Course material ranges from macro theories to micro case studies, the aim is to facilitate dialogue and re-thinking pertaining to architecture at various levels and scales.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "增進對於建築及美學理論及實踐的認識\t",
      "describe_en": "To improve understanding pertaining to architecture and aesthetics theory and implementation."
    },
    {
      "seq": 2,
      "describe_ch": "增進對於建築及美學在人、環境及介入因素的整合能力\t",
      "describe_en": "To improve the ability to integrate human, environmental and intervening factors pertaining to architecture and aesthetics."
    }
  ],
