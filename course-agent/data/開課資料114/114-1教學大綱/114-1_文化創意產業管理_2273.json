  "description": {
    "sub_id3": null,
    "sub_name": "文化創意產業管理",
    "sub_ename": "MANAGEMENT ON CULTURAL & CREATIVE INDUSTRIES",
    "describe_ch": "本課程旨在由較『總體』（產業整體）之角度來瞭解與探討「文化創意產業」之內涵、特性、範疇，及相關之管理議題，目的在使同學們能學習到：\r\n1. 瞭解文化創意產業之重要性及全球各國相關之發展趨勢。\r\n2. 深入探討文化創意產業之內涵、特性與範疇。\r\n3. 能分析思考文化創意產業可能之問題及相關管理議題。\r\n4. 能將所學之管理知識與技能整合運用至文化創意產業之中。\r\n",
    "describe_eh": "This course aims at understanding and exploring the contents , characteristics and scope of \"Cultural & Creative Industries\" as well as the related management issues from the macro view. The purpose is teaching students：\r\n1. To understand the importance and global trends of \"Cultural & Creative Industries\".\r\n2. To deeply explore the contents , characteristics and scope of \"Cultural & Creative Industries\".\r\n3. To analyze and think some possible questions and related management issues in Cultural & Creative Industries.\r\n4. To be able to integrate and apply management knowledge and skills into Cultural & Creative Industries.\r\n",
    "pre_subname": "MGT1001管理學",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解文化創意產業之重要性及全球之發展趨勢。",
      "describe_en": "To be able to understand the importance and global trends of \"Cultural & Creative Industries\"."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解與探討文化創意產業之內涵、特性及範疇。",
      "describe_en": "To be able to understand and explore the contents , characteristics and scope of \"Cultural & Creative Industries\"."
    },
    {
      "seq": 3,
      "describe_ch": "能思考或分析文化創意產業可能之問題及相關管理議題。",
      "describe_en": "To be able to think or analyze some possible questions and related management issues in Cultural & Creative Industries."
    }
  ],
