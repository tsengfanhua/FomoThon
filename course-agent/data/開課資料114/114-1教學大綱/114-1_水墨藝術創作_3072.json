  "description": {
    "sub_id3": null,
    "sub_name": "水墨藝術創作",
    "sub_ename": "INK-PAINTING ART CREATION",
    "describe_ch": "引導學生對傳統水墨的認識，並透過基礎筆墨練習，能欣賞古典書畫之美，再引申對當代水墨畫的理解，並?發學生的水墨涵養。",
    "describe_eh": "Introduce students' understanding of traditional ink and wash, and through basic exercises, appreciate the beauty of classical painting and calligraphy, and then extend their understanding of contemporary ink and wash painting, and inspire students to learn about ink and wash.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "考察基本筆墨的學習成果",
      "describe_en": "Review the learning outcomes of basic pen and ink"
    },
    {
      "seq": 2,
      "describe_ch": "能運用此基礎完成對自然物象的表現",
      "describe_en": "To be able to use this foundation to complete the performance of natural objects"
    }
