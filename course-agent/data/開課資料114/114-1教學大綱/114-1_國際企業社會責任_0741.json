  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB25130",
    "sub_id": "98173",
    "scr_dup": "001",
    "tpa_score_new": null,
    "tpa_score_new_en": "<div><strong>In class participation</strong> &ndash; Full attendance is expected. While being in class students are required a proactive attitude.</div>\n\n<div><strong>Students presentation</strong> &ndash; Students will be ask, in group or individually, to do exercises and presentations on assigned topics.</div>\n\n<div><strong>Assessment of students learning through the use of multiple choice tests or project report</strong> &ndash; The Midterm examination consists of the assessment test will cover the contents of the all the lessons taught until the week before the test.</div>\n\n<div><strong>Final presentation, in group or individual &ndash; </strong>The final presentation consists of a mixed test using multiple choice tests and open questions or project reports on the topics covered in class.</div>\n",
    "course_pol": null,
    "course_pol_en": "Expected classroom behavior\nStudents should attend class on time.\nDuring lessons it is not possible to use cell phones, IPads or PCs except for taking notes.\nAll students are expected to treat everyone with respect in the classroom and to behave reasonably, responsibly, and courteously at all times.\nStudents listen attentively when classmates present or ask questions. When you present, you should speak loud enough to your group or class so that they can hear you clearly.",
    "course_rem": null,
    "course_rem_en": "Diversity and Inclusion\nAll course activities will be carried out in an atmosphere of friendly participation and interaction among students, respecting and appreciating each student’s personal experience, background and perspectives, such as various school system at home and abroad, diverse enrollment and learning cultures, gender, etc.\nYou are expected to apply the highest academic standards throughout this course and to treat fellow students with dignity and respect.\nIt will be important to create moments of exchange and constructive relationships between students with the aim of improving the comparison and learning of the course contents.",
    "ais_meno": null,
    "ais_meno_en": "<div>This course is a BIBA course, students must invest the time necessary to be properly prepared for class.</div>\n\n<div>Students are required to partecipate in team discussion and team assignment.</div>\n\n<div>Copying texts without properly citing the source is not permitted. Plagiarism is a serious breach of academic trust.</div>\n\n<div>For example, it is considered cheating if you copy someone else&#39;s answers during an assessment, or if you turn in a paper or assignment that was written in whole or in part by someone else when you turned in an assignment.</div>\n",
    "ilearn_mk": "N"
  },
