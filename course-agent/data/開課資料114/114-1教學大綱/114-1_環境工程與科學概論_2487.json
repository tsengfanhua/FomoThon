  "description": {
    "sub_id3": null,
    "sub_name": "環境工程與科學概論",
    "sub_ename": "INTRODUCTION TO ENVIRONMENTAL ENGINEERING AND SCIENCE",
    "describe_ch": "本課程為環境保護之入門課程，藉由環科系專任教師們的引領，綜覽當代環境科學與環境工程所討探之諸多領域，描述其基本概念及各項理論與科技之沿革、發展與應用。",
    "describe_eh": "This course, taught by the faculty members in the department of environmental engineering and science, is an introductory one in environmental protection.  It provides an overview of the diverse areas covered by contemporary environmental science and environmental engineering, emphasizing on the basic concepts, the vital development and application of various theories and technologies for environmental protection.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得環境科學與工程各領域的基本概念",
      "describe_en": "To obtain the basic concepts on environmental science and engineering"
    },
    {
      "seq": 2,
      "describe_ch": "獲得分辨環境問題所在之基本概念與技術應用\t",
      "describe_en": "To obtain the basic concept in identifying environmental problems and technology application"
    },
    {
      "seq": 3,
      "describe_ch": "理解當代議題，融入專業領域，並能持續學習\t",
      "describe_en": "To comprehend the contemporary environmental issues with expertise by continuous learning"
    },
    {
      "seq": 4,
      "describe_ch": "認知專業倫理與社會道德責任，培養自我管理能力",
      "describe_en": "To recognize the professional ethics and society moral responsibility, develop the ability of self-management."
    }
  ],
