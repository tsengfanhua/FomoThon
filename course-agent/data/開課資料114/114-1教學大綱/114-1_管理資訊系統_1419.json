  "description": {
    "sub_id3": null,
    "sub_name": "管理資訊系統",
    "sub_ename": "MANAGEMENT INFORMATION SYSTEMS",
    "describe_ch": "本課程從經營管理的觀點，探討如何從組織內部管理、組織間合作關係及社會環境進行改革，並適切運用資訊科技，以全面改善組織溝通和資訊管理來提高經營績效。目的是讓學生學習資訊與溝通的規劃和管理，善用這些個人和組織生存、發展、競爭、協調及合作所不可或缺的工具。",
    "describe_eh": "This course discusses how to improve the efficiency of organization management, cooperation between organizations, and social environment from the management viewpoint. Students will learn the use of information technology to improve the organization communication and information management leading to better performance of enterprise management. The goal of learning is the planning and management of information and communication as the necessary tools for both individuals and organizations to live, develop, compete, coordinate, and cooperate.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "從經營管理的觀點，學習如何改善組織內部管理、組織間合作關係及社會環境的知識",
      "describe_en": "Learn the knowledge to improve the efficiency of organization management, cooperation between organizations, and social environment from the management viewpoint."
    },
    {
      "seq": 2,
      "describe_ch": "學習如何應用資訊科技進行資訊與溝通的規劃和管理",
      "describe_en": "Apply information technology to plan and manage the information and communication."
    }
  ],
