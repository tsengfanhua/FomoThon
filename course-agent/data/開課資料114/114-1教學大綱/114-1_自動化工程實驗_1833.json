  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生瞭解自動化重要之基本概念與理論",
      "describe_en": "To acquire an understanding of the basic concepts and theory of automation"
    },
    {
      "seq": 2,
      "describe_ch": "培養學生具備操作自動化等設備，並且分析實驗結果之能力",
      "describe_en": "To gain the ability to operate automation equipment and experimental methods as well as analyze mechanical problems"
    },
    {
      "seq": 3,
      "describe_ch": "訓練學生各種自動化等設備原理及量測儀器的使用能力，以及培養實驗規劃與設計基本能力與自動化之應用",
      "describe_en": "To develop the ability of fundamental in automation measurement and the application of instruments for experimenting as well as the ability of experimental planning/designing and application to solution of automation"
    },
    {
      "seq": 4,
      "describe_ch": "培養團隊合作",
      "describe_en": "Team work"
    }
