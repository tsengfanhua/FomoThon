  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "智慧化環境感測原理與應用",
    "sub_ename": "PRINCIPLE AND APPLICATION OF INTELLIGENT ENVIRONMENT SENSING",
    "describe_ch": "藉由此課程讓學生了解國內外包含智慧感測器概念及多元化應用，並衍生至空間資訊(如GPS、GIS與RS)等相關技術的應用與發展，並且透過小型UAV飛行練習，讓學生實際體驗UAV技術與操作，看見不一樣的校園景觀。",
    "describe_eh": "Through this course, students can understand the concept and diversified applications of smart sensors at domestic and foreign, and the application and development of related technologies derived from spatial information (such as GPS, GIS and RS), and through small UAV flight practice, students can practically experience UAV technology and operation, and see a different campus landscape.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生了解國內外多元化智慧感測技術的應用概況",
      "describe_en": "To enable students to understand the application of diversified smart sensing technologies at domestic and foreign."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解無人載具的應用原理與創新實作",
      "describe_en": "To understanding the UAV technology application and innovative implementation."
    }
  ],
