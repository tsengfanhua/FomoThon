  "description": {
    "sub_id3": null,
    "sub_name": "法學研究方法與寫作",
    "sub_ename": "METHODOLOGY AND WRITING OF LEGAL RESEARCH",
    "describe_ch": "引領學生閱讀相關中英文法學文獻，教授學生進行法學研究之方法、搜尋法學資料、法學論文之論述建構及引註技巧，以求培養學生具備獨立的法學研究及寫作能力。",
    "describe_eh": "This course will lead students to read Chinese and English legal papers, and teach them how to proceed legal research, how to collect materials and how to write a legal paper. With these training, students' ability of independent legal research and writing should be formed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉並了解法學研究方法與寫作的概念",
      "describe_en": "Understand the basic concept of Methodology and Writing of Legal research"
    },
    {
      "seq": 2,
      "describe_ch": "熟悉並了解如何進行法學論文之寫作",
      "describe_en": "Learn the approach of legal writing."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉並了解學術與實務對於法學研究方法、寫作之運作異同",
      "describe_en": "Understand the difference approaches of methodology and writing of legal research on theory and practice"
    },
    {
      "seq": 4,
      "describe_ch": "培養學生分析、解決實務法律問題及獨立思考之能力",
      "describe_en": "Improve students' problem solving and analysis skill, and their independent thinking."
    }
  ],
