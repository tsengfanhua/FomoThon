  "description": {
    "sub_id3": null,
    "sub_name": "法學英文(一)",
    "sub_ename": "LEGAL ENGLISH (I)",
    "describe_ch": "採取英語授課，學生必須學習不同國家之法律體系、閱讀英文法律期刊、法規及案件，並配合指定作業及課堂討論及報告，加強學生之語言能力，使其更具國際觀。",
    "describe_eh": "This course will introduce different legal systems and jurisdictions the world over lectured in English. Students will be required to read English law journals, legislation and cases, as well as write the assignments and term paper to improve their language ability along with international perspective.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "藉由法律期刊及案件的研讀與討論，提升學生統整、分析之能力，並培養其國際觀。",
      "describe_en": "Promoting the ability of analysis and integration as well as fostering the international perspective by discussing and reading law reviews and studying cases."
    },
    {
      "seq": 2,
      "describe_ch": "透過專門領域法律文件和法規之閱讀，加強學生對法律英文之閱讀能力。",
      "describe_en": "Strengthening the reading ability of legal English by studying legal texts and legislation, etc.."
    },
    {
      "seq": 3,
      "describe_ch": "利用英語授課及口頭報告的方式，培養學生於法律英文領域之表達及理解能力。",
      "describe_en": "Improving the presentation skill and the understanding of legal English by lecturing in English and oral presentation."
    },
    {
      "seq": 4,
      "describe_ch": "透過課堂的討論及報告，加強學生法律英文說的能力。",
      "describe_en": "Tostrengthen students' speaking skills and to enable studentsto engagemore effectively in range of speaking situations typical of the study of law such as client interviews or discussions with colleagues and fellow students."
    }
  ],
