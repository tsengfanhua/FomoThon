  "description": {
    "sub_id3": null,
    "sub_name": "工業衛生",
    "sub_ename": "INDUSTRIAL HYGIENE",
    "describe_ch": "結合生理學、毒物學、流行病學、物理學、化學、生物學、統計學等領域的統整性學科。其目的是教導學生：(1)認知及預期工作環境可能產生之物理因子危害、化學因子危害、生物因子危害及人因工程危害；(2)評估物理、化學、生物及人因工程危害，採取環境監測及暴露量測分析策略及方法；(3)了解工程控制方法，行政管理措施及使用個人防護具來降低作業勞工的健康危害。",
    "describe_eh": "Industrial Hygiene is an interdisciplinary course involving physiology, toxicology, epidemiology, etc. The purpose of this course is to teach the students: (1) To recognize the physical, chemical, biologic, human factors stresses and the relationship with the occupational diseases; (2) to evaluate the industrial environmental problems and hazards exposure measures; (3) to control the environmental hazards with the engineering, administrative and personal protection methods.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解工業衛生的定義；能描述工業環境中哪些重要因素可能危害到工作者的健康。\t",
      "describe_en": "To understand the definition of industrial hygiene, and understand the industrial environmental hazards which will affect worker’s health"
    },
    {
      "seq": 2,
      "describe_ch": "明瞭並認知說明工業環境不良產生職業疾病對社會、經濟的影響及重要性\t",
      "describe_en": "Understand and be able to explain the importance and adverse effects of occupational diseases to the society"
    },
    {
      "seq": 3,
      "describe_ch": "能歸納詮釋暴露風險評估之影響範圍，並構思防範危害的能力\t",
      "describe_en": "Be able to understand the scope of the exposure and risk assessment results and adopt appropriate preventative approaches\t"
    },
    {
      "seq": 4,
      "describe_ch": "能運用各種方法，評估工作環境之危害並改善工作環境及居住健康\t",
      "describe_en": "Know to use the engineering methods to control the hazards and to improve the working condition and the community\t\r\n"
    }
  ],
