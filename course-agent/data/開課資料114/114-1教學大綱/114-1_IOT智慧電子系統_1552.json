  "description": {
    "sub_id3": null,
    "sub_name": "IOT智慧電子系統",
    "sub_ename": "INTRODUCTION TO IOT ELECTRONIC SYSTEM",
    "describe_ch": "主要探討如何 運用開源程式各類型的應用程式，結合微控制器應用於不同類型IOT裝置，幫助學習同學瞭解如何通過自行開發應用程序來監視或者控制 微控制器 硬體。",
    "describe_eh": "This course focuses on how to develop various types of applications using Python, and combines Arduino electronic components for different types of IOT devices to help students learn how to monitor or control Arduino hardware by developing their own applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生具備使用電子相關軟硬體工具應用程式的基本操作與知識。",
      "describe_en": "Provide students with the ability to use electronic related software and hardware tools."
    },
    {
      "seq": 2,
      "describe_ch": "使學生具備電路設計、電子元件與開源軟體的數據融合的能力。",
      "describe_en": "Enable students to integrate data from circuit design, electronic components and open source software."
    }
  ],
