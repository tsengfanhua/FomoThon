  "description": {
    "sub_id3": null,
    "sub_name": "成本與管理會計(一)",
    "sub_ename": "COST AND MANAGERIAL ACCOUNTING (1)",
    "describe_ch": "本課程目的在介紹成本與管理會計之基本觀念、理論基礎、技術及實務上之應用，並探討如何蒐集、衡量及報導有關的成本資訊，以協助管理者執行規劃、控制、績效評估及決策制定等工作。",
    "describe_eh": "The purpose of the course is to introduce the basic concepts, theoretical foundation, techniques, and the application in practice of cost and managerial accounting. It also discusses how to collect, measure, and report the cost information for internal use by managers in planning, controlling, performance evaluation, and decision-making.",
    "pre_subname": "ACCT1011會計學(一)、ACCT1012會計學(二)",
    "pre_sub_id3": "ACCT1011",
    "pre_sub_ename": "ACCT1011 ACCOUNTING(1)、ACCT1012 ACCOUNTING(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備成本與管理會計的知識及瞭解成本（管理）會計人員在企業內所扮演的角色",
      "describe_en": "Having the knowledge of cost and managerial accounting and understanding the role of cost (management) accountants playing in the business."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解成本與管理會計資訊的收集、組織、處理及報導過程",
      "describe_en": "Comprehension for the cost and managerial accounting information collecting, organizing, processing and reporting."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解成本與管理會計資訊對企業規劃、控制、績效評估及制定決策之用途",
      "describe_en": "Comprehension for the use of cost and managerial accounting information in business planning, controlling, performance evaluation and decision making."
    }
  ],
