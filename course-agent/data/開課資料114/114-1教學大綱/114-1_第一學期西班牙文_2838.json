    {
      "seq": 2,
      "describe_ch": "Understand short, memorized sentences and phrases with contextual support.",
      "describe_en": "Understand short, memorized sentences and phrases with contextual support."
    },
    {
      "seq": 3,
      "describe_ch": "Develop reading comprehension to interpret written language for instructional and directional purposes, and standardized messages (menus, schedules, maps, signs, etc.).",
      "describe_en": "Develop reading comprehension to interpret written language for instructional and directional purposes, and standardized messages (menus, schedules, maps, signs, etc.)."
    },
    {
      "seq": 4,
      "describe_ch": "Recognize and produce basic grammatical structures and meaning.",
