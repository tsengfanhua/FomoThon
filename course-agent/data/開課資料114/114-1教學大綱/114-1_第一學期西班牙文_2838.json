  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "NM07120",
    "sub_id": "50981",
    "scr_dup": "001",
    "tpa_score_new": null,
    "tpa_score_new_en": "<div>- In this course, attendance and active particpation are essential to obtain a good level of Spanish. For this reason, the score for partitipation is the highest.&nbsp;</div>\n\n<div>- Emphasis is placed on &quot;active&quot; participation. Attendance without participation does not count for the full score.&nbsp;</div>\n\n<div>- Attendance will be grade with a 10% and active participation with up to a 40% of the score.&nbsp;</div>\n\n<div>- Students who fail to attend this course more than 4 times without justification will not be able to obtain the 10% participation score.&nbsp;</div>\n\n<div>- Students&#39; attendance and participation will be registered daily</div>\n\n<div>&nbsp;</div>\n",
    "course_pol": null,
    "course_pol_en": "Students are encouraged to express themselves freely in a respectful environment where all voices are valued. However, respect is essential, and any lack of respect or other forms of unruly behavior will not be tolerated. Additionally, the use of cellphones in class is restricted and will only be permitted when authorized by the professor.",
    "course_rem": null,
    "course_rem_en": "- Students are welcome to ask any questions they want, as long as it is related to the contents of the course. \n- Throughout the semester, different materials and resources will be provided according to the progress made in class.",
    "ais_meno": null,
    "ais_meno_en": "<div>- Students are encouraged to participate actively, without fearing giving a wrong response&nbsp;</div>\n\n<div>- If students encounter any difficulty or need assintance with the course contents, the professor will provide neccesary help&nbsp;</div>\n\n<div>- Students are encouraged to speak freely, share their thoughts and ideas using Spanish.&nbsp;</div>\n\n<div>- Students must show respect to all classmates, professors and members of the academic community. Unruly behaviour will result in deduction of the score.&nbsp;</div>\n",
    "ilearn_mk": null
  },
