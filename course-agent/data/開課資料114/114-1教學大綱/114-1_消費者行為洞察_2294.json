  "description": {
    "sub_id3": null,
    "sub_name": "消費者行為洞察",
    "sub_ename": "CONSUMER BEHAVIOR INSIGHTS",
    "describe_ch": "本課程目的在探討搜尋、評估、購買及使用產品或服務等過程中各式消費者行為及其可能影響其行為之因素等，以進行消費行為理論基礎的學習，再者，結合消費商業真實數據進行分析與判讀，融合理論進行實務應用之探討。",
    "describe_eh": "The purpose of this course is to study the theory of consumer behaviors in the process of search, evaluation, purchasing and usage. With the emphasis on consumer decision strategy, we use both a theoretical and an applications-oriented approach. An integrated framework of consumer analysis is provided to organize the understanding of consumer needs and the knowledge of using consumer behavior information in marketing strategy making.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解消費者行為的定義與理論",
      "describe_en": "Understand the definitions and theories of consumer behavior."
    },
    {
      "seq": 2,
      "describe_ch": "分析並解讀消費者數據背後的意義",
      "describe_en": "Analyze real world’s consumer data and explain it."
    }
  ],
