  "description": {
    "sub_id3": null,
    "sub_name": "創意研發專論",
    "sub_ename": "SPECIAL TOPICS ON INNOVATION AND CREATIVE RESEARCH",
    "describe_ch": "本課程是一門結合美學、應用藝術、工業設計與專利等領域的跨領域學科, 課程著重在研討與實作, 包含以下八個部分: 1.1950年後設計史( 5%) 2.當代造型藝術、創意與創新( 5%) 3.如何設計? ( 10%) 4.材料, 技術與方法( 10%) 5.創意設計草案: 想法與草圖(手稿或電腦繪圖) ( 25%) 6.製作與完成作品( 25%) 7.展示規劃( 15%) 8.專利( 5%)",
    "describe_eh": "This course is a combination of aesthetics, applied arts, industrial design and patents in the field of cross-cutting disciplines, courses focus on discussion and implementation, including the following eight parts: 1.History of Design Since 1950 ( 5%) 2.Plastic Arts , Creation and Innovation Today( 5%) 3.How to Dessin / Design?( 10%) 4.Material, Skill and Know-how ( 10%) 5.Proprosal of Creative Design: Idea and Sketch (hand-drawing or by computer) ( 25%) 6.Fabrication and Realization( 25%) 7.Show Planning ( 15%) 8.Copyright ( 5%)",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能完整定義何謂創意設計：能夠描述重要的當代設計師與其風格；能夠描述創新設計的方法與進程。",
      "describe_en": "Be able to complete the definition of what constitutes creative design: the ability to describe their style of leading contemporary designers; to describe the method and process of innovative design."
    },
    {
      "seq": 2,
      "describe_ch": "能主動作市場調查與蒐集資料並分工合作討論分析比較各創意產品之風格與創新特點, 以及可能再改進的部分。",
      "describe_en": "Be able to take the initiative and gather information for market research and analysis division of labor compared to discuss the style of the creative products and innovative features, and possibly some further improvements."
    },
    {
      "seq": 3,
      "describe_ch": "具備基礎設計素描與創意設計能力。",
      "describe_en": "Have the basic design drawings and creative design capabilities."
    },
    {
      "seq": 4,
      "describe_ch": "具備基礎設計模型製作能力及基礎設計展示規劃能力。",
      "describe_en": "Have the basic design model making capabilities andorganize a basic design exhibition."
    }
  ],
