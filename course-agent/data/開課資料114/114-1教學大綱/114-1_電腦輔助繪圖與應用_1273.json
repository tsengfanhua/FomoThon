  "description": {
    "sub_id3": null,
    "sub_name": "電腦輔助繪圖與應用",
    "sub_ename": "COMPUTER AIDED DESIGN AND APPLICATIONS",
    "describe_ch": "本課程以課堂解說及習作來介紹關於電腦繪圖軟體之基本操作，將工程圖學中2D與3D的圖例以電腦繪圖軟體繪製出圖，並3D列印所繪製之3D圖例。",
    "describe_eh": "This course introduces the basic operations of computer-aided design (CAD) software with lectures and exercises. The 2D and 3D examples of engineering graphics are drawn with CAD, and the drawn 3D objects are 3D printed out.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使用電腦輔助繪圖軟體之各項繪製功能及其介面調控",
      "describe_en": "To understand the basic drawing functions of CAD."
    },
    {
      "seq": 2,
      "describe_ch": "使用電腦輔助繪圖軟體繪製2D圖形",
      "describe_en": "To understand how to use CAD to draw 2D graphics."
    },
    {
      "seq": 3,
      "describe_ch": "使用電腦輔助繪圖軟體繪製3D圖形",
      "describe_en": " To understand how to use CAD to draw 3D graphics."
    },
    {
      "seq": 4,
      "describe_ch": "使用3D印表機列印3D圖形",
      "describe_en": " To have the ability to use 3D printers to print out the 3D objects."
    }
  ],
