  "description": {
    "sub_id3": null,
    "sub_name": "商標法",
    "sub_ename": "TRADEMARK LAW",
    "describe_ch": "本課程內容包括商標保護之客體、商標註冊要件、商標之申請與審查、商標權之效力與例外、商標之異議評定與廢止、商標侵害與視為侵害等。藉由課堂講授與案例分析方式，使學生對於我國及國際商標法制有深入之了解。",
    "describe_eh": "The main contents of this course include trademark registrable subject matter, registration requirements, trademark application and examination, the validity and exception of trademark rights, trademark opposition, invalidation and revocation, trademark direct and presumed infringement. Through class lecture and case discussions, student will have thorough understanding on Taiwan’s trademark law and international trademark treaties.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生對商標法之理論基礎及我國與國際商標法之規範有深入之瞭解。",
      "describe_en": "Eenable students to develop in-depth understanding on the regulations of domestic and international trademark law."
    },
    {
      "seq": 2,
      "describe_ch": "使學生對商標法實務與智財相關產業有所認識。",
      "describe_en": "Enable students to familiarize with trademark practice and related intellectual property industries."
    }
  ],
