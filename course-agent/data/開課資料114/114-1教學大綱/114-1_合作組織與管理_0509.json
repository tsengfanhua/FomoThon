  "description": {
    "sub_id3": null,
    "sub_name": "合作組織與管理",
    "sub_ename": "COOPERATIVE ORGANIZATION AND MANAGEMENT",
    "describe_ch": "旨在使學生瞭解合作社組織與管理應發展成一獨立的學術研究領域，探討合作組織結構、社務管理及業務經營的特色，並進行個案合作組織之經營診斷與分析。",
    "describe_eh": "To teach the difference between the organization of co-operatives and that of common enterprise. The objectives of cooperative management are guided by economic, social, and cultural responsibilities. A co-operative not only bring economic profit to its members but also dedicate itself to the benefits of the society. In order to illustrate the central value of co-operatives, the specific theory and practice of cooperative management should be emphasized.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠理解合作社與合作事業的價值、原則與特徵。",
      "describe_en": "The comprehension of the value, principles and characteristics of cooperatives and cooperative business."
    },
    {
      "seq": 2,
      "describe_ch": "能夠瞭解與分析各種合作社場與儲蓄互助社的組織運作架構與模式。",
      "describe_en": "Understanding and analyzing the organization scheme of cooperatives and credit unions."
    },
    {
      "seq": 3,
      "describe_ch": "能夠瞭解與分析各種不同合作社場的經營管理理論與實務。",
      "describe_en": "The application of cooperative business management function and their relationship."
    }
  ],
