  "description": {
    "sub_id3": null,
    "sub_name": "神話、傳說與奇幻文學",
    "sub_ename": "MYTHS, LEGENDS, AND FANTASY LITERATURE",
    "describe_ch": "在資訊爆炸，檢索便利的時代，教師身為「知識經濟人」，如何引導學生思考並表達，極其重要。\n本學期課程以神話、傳說與奇幻文學為主，旨在透過文本閱讀，了解奇幻文學發展的全貌，認識不同內容創作的情感、精神與文化內涵，擴展文化藝術視野。",
    "describe_eh": "Students are expected to understand the overall development of myths, legends, and fantasy literature and understand the emotion, spirits and cultural connotation of different styles of novel creation, and expand the cultural and artistic vision.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 3,
      "describe_ch": "人道關懷、文化涵養：了解奇幻文學本身以及背後的文化意涵。",
      "describe_en": "Understand the cultural meaning of fantasy literature."
    },
    {
      "seq": 4,
      "describe_ch": "全球視野、探索解決：透過奇幻文學，體察人生的各種情感，對人性有更深刻的同情了解。",
      "describe_en": "Have a deeper sympathetic understanding of human nature."
    }
  ],
