  "description": {
    "sub_id3": null,
    "sub_name": "結構學",
    "sub_ename": "STRUCTURAL THEORY",
    "describe_ch": "旨在說明結構學之基本原理以及介紹靜定與超靜定結構的分析方法，瞭解不同結構類型藉由不同分析方式處理，進而得知結構整體受力的分佈狀況與變位情形。",
    "describe_eh": "The course provides students with the elementary principles of structural theory, and different methods of structural analysis for determinate and indeterminate structures. Students learn to observe the behavior of load path and deflection about different structural types.",
    "pre_subname": "ENGS1006應用力學",
    "pre_sub_id3": "ENGS1006",
    "pre_sub_ename": "ENGS1006 APPLIED MECHANICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能認識靜定結構與超靜定結構的分析方法",
      "describe_en": "Understand the methods of analyzing statically determinate structures and statically indeterminate structures."
    },
    {
      "seq": 2,
      "describe_ch": "能判別剛架結構基本的穩定條件",
      "describe_en": "Distinguish basically stable conditions about the structures of rigid frame."
    },
    {
      "seq": 3,
      "describe_ch": "能使用適當的分析方法計算剛架結構的內力分佈及變形",
      "describe_en": "Be able to use suitable analysis methods to calculate the internal forces and deformation of rigid frame."
    }
