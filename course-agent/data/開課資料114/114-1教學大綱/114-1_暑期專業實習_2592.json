    "sub_name": "暑期專業實習",
    "sub_ename": "SUMMER INTERNSHIP",
    "describe_ch": "本課程為遴選學生提供至產業進行實務接軌的機會。旨在加強理論與實務的整合，以強化學生專業技能，提升未來就業競爭力。",
    "describe_eh": "The course is designed to offer students,Who are recommended, a value-added opportunity to add work experience in academic study. It aims for the integration of theoretical and pratical knowledge to further strengthen the professional skills and the competitiveness of students.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 4.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生理論與實務的整合",
      "describe_en": "To integrate theoretical and pratical knowledge  for students"
    },
    {
      "seq": 2,
      "describe_ch": "強化學生專業技能，具備協調溝通與團隊合作之能力",
      "describe_en": "To strengthen students’ professional skills"
    },
    {
      "seq": 4,
      "describe_ch": "具備終身學習的基本素養",
      "describe_en": "To possess the cultivation of life-long learning  responsibilities"
    },
    {
      "seq": 5,
      "describe_ch": "具備專業倫理及社會責任的基本素養",
      "describe_en": "To possess the cultivation of industry ethics and social responsibilities"
    }
  ],
