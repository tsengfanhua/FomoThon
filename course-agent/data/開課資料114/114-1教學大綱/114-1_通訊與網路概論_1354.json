  "description": {
    "sub_id3": null,
    "sub_name": "通訊與網路概論",
    "sub_ename": "INTRODUCTION TO NETWORK COMMUNICATION",
    "describe_ch": "本課程主要在介紹網路通訊的概念。藉由介紹數位通訊原理及技術、訊息編碼、網路協定原理、網路架構及其理論基礎使學生瞭解數位通訊、網路協定及網路技術與其架構並認識TCP/IP協定架構和網際網路的原理。",
    "describe_eh": "The aim of this course is to provide an overview in the basic principles of data communications and computer networks. Students should understand the technologies and architectures of data communication and network protocols by studying the principles and technologies of data communications, message encoding, network protocols and computer networks. And, students should understand the TCP/IP protocol and the principle of internetworking.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
