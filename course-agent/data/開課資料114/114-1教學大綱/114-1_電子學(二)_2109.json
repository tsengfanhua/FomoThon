  "description": {
    "sub_id3": null,
    "sub_name": "電子學(二)",
    "sub_ename": "ELECTRONICS(2)",
    "describe_ch": "本課程延續電子學（一）的電子元件和電路分析基礎，介紹場效電晶體原理和類比電路特性分析與應用設計，課程包含場效電晶體直流和交流模型、差動放大器、頻率響應與回授網路分析以及積體電路之電腦模擬計算，讓學生修完電子學（二）後，具有分析設計應用類比電",
    "describe_eh": "The students will engage in the study of FETs and analog circuit design, and comuter aided design calculations of integrated circuits. This course includes: field-effect transistor (FET) circuit models, differential single and multistage amplifiers analysis and design, frequency response, and feedback circuit analysis. A student who successfully fulfills the course requirements will have an ability to analyze and design dc bias circuits, single and multistage amplifiers, and to use a CAD tool in circuit simulation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備各型MOS電晶體的結構、I-V特性與相關模型知識以及如何應用到相關電子電路分析的知識。",
      "describe_en": null
    },
    {
      "seq": 2,
      "describe_ch": "瞭解由BJT與MOSFET電晶體所構建的單級以及多級放大器的結構、偏壓分析以及交流小信號分析技術。",
      "describe_en": null
    }
  ],
