  "description": {
    "sub_id3": null,
    "sub_name": "電路學(一)",
    "sub_ename": "CIRCUIT THEORY(1)",
    "describe_ch": "電路學是一門基礎學問，它是用來描述實際電機系統運作的數學工具。本課程首先由簡單的實例引導學生了解實際系統與模型的建立關係，接著進入電路的主題從基本元件、數學分析方法到網路分析方式，最後透過微分方程與拉普拉氏方法解答完整的系統響應。",
    "describe_eh": "The Electric Circuits is a basic knowledge, it be used for describing the mathematics tool of systematic operation of the real electrical machinery. At first, this course leads student to understand how to build the real system and model. Then introducing basic element, the method of mathematics analysis, and network analysis. Finally using differential equation and Laplace method to solve whole system response.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解各種電子元件之基本功能與電路知識",
      "describe_en": "Understanding the basic function and circuit knowledge of various electronic devices."
    },
    {
      "seq": 2,
      "describe_ch": "理解各種電子元件與電子電路的工程原理",
      "describe_en": "Comprehension for the engineering principle of various electronic devices and electronic circuits."
    },
    {
      "seq": 3,
      "describe_ch": "應用各種電子實驗設備完成電子電路之測試與設計",
      "describe_en": "Application for the electronic instruments to circuit testing and design."
    },
    {
      "seq": 4,
      "describe_ch": "運用電子電路分析軟體完成電子電路之特性分析",
      "describe_en": "Apply the circuits simulation tool box to circuits characteristic analysis."
    }
  ],
