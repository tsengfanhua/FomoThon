  "textBooks": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "NM07120",
    "sub_id": "39628",
    "scr_dup": "001",
    "tpb_seq": 1,
    "tpb_book": "<div>AWS Academy Cloud Foundations [54528]</div>\n\n<div><em>AWS Academy Cloud Foundations</em>&nbsp;is intended for students who seek an overall understanding of cloud computing concepts, independent of specific technical roles. It provides a detailed overview of cloud concepts, AWS core services, security, architecture, pricing, and support.</div>\n",
    "tpb_book_en": "AWS Academy Cloud Foundations [2957]"
  },
  "readings": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "NM07120",
    "sub_id": "39628",
    "scr_dup": "001",
    "tpc_seq": 1,
    "tpc_book": "<div><em>AWS Academy Learner Lab&nbsp;</em>provides a long-running sandbox environment for ad hoc exploration of AWS services. Within this class, students will have access&nbsp;<em>to&nbsp;<strong>a restricted set of AWS services</strong></em>. Not all AWS documentation walk-through or sample labs that operate in an AWS Production account will work in the Learner Lab environment. You will retain access to the AWS resources set up in this environment for the duration of this course. We limit your budget ($100USD), so you should exercise caution to prevent charges that will deplete your budget too quickly. If you exceed your budget, you will lose access to your environment and lose all of your work.</div>\n",
    "tpc_book_en": null
  },
