    "scr_dup": "001",
    "sub_title": "細部設計為空間設計執行實務裡,最直接而務實的一部份,包括從哲學理論、行為學、工程材料及構造, 基於繪圖學的基礎,教導學習者從作品及製作工場(或工地)的導覽中, 學習如何閱讀及繪製細部施工圖.",
    "sub_title_en": null,
    "sub_describe": null,
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "細部設計與構造",
    "sub_ename": "DETAIL DESIGN AND MATERIAL CONSTRUCTION",
    "describe_ch": "細部設計為空間設計執行實務裡,最直接而務實的一部份,包括從哲學理論、行為學、工程材料及構造, 基於繪圖學的基礎,教導學習者從作品及製作工場(或工地)的導覽中, 學習如何閱讀及繪製細部施工圖.",
    "describe_eh": "\" DETAIL DESIGN \" is the most direct and practical part in practice designing for the space, including the philosophy theory, Behaviouristics, material and construction knowledge, drawing study after the understanding of foundation, teach learner from wor",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習者能了解細部設計於實務執行中的位階及重要性,並了解相關知識對細部設計之影響.",
      "describe_en": "The learner can understand the importance in the practice of detail design and understanding relevant knowledge."
    },
    {
      "seq": 2,
      "describe_ch": "由施工圖之反覆套繪中,讓學習者習得閱讀及繪製細部施工圖之基本能力.",
      "describe_en": "Let learners practice the basic ability to read and draw the construction drawing of the detail."
    },
    {
      "seq": 3,
      "describe_ch": "對軟件傢俱施工細部的繪製及施作尺寸分析",
      "describe_en": "The drawing and sizing analysis of the details of  furniture construction"
    },
    {
      "seq": 4,
      "describe_ch": "室內材料認識及應用",
      "describe_en": "Understanding and application of indoor materials"
    }
  ],
