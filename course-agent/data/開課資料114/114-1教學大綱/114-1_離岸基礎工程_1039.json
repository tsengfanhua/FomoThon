  "description": {
    "sub_id3": null,
    "sub_name": "離岸基礎工程",
    "sub_ename": "OFFSHORE FOUNDATION ENGINEERING",
    "describe_ch": "在離岸風力發電的發展，離岸水下基礎工程為提供風機穩定性中最重要的因素。本課程將與鑽油平台之基礎工程知識做連結，闡述離岸基礎工程在理論與實務應用。",
    "describe_eh": "Offshore foundation engineering is the most critical issue in the stability assessment of wind turbines, in the development of offshore wind farms. The course connects the foundation engineering knowledge from offshore drilling platforms, and illustrates the theory and practical applications in offshore foundation engineering.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解離岸基礎工程在鑽油平台的應用",
      "describe_en": "Understand the application of offshore foundation engineering in offshore drilling platform"
    },
    {
      "seq": 2,
      "describe_ch": "學習離岸基礎工程在學理上的知識",
      "describe_en": "Learn the academic knowledge of offshore foundation engineering"
    },
    {
      "seq": 3,
      "describe_ch": "應用理論知識在實際工程問題的設計",
      "describe_en": "Apply the knowledge in the designs of in-situ problems"
    }
  ],
