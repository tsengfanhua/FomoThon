  "description": {
    "sub_id3": null,
    "sub_name": "機械畫",
    "sub_ename": "ENGINEERING DRAWING",
    "describe_ch": "身為21世紀的工程學生必須瞭解如何讀、寫圖形語言，在全球競爭市場中，工程團隊的每位人員都必須擁有迅速與精確的溝通能力。學生若具有此等熟練的圖形溝通能力，將有助於提升未來雇主在雇用學生時的價值性。\r\n本課程是工程圖學的延伸，旨在培養學生對於工程圖的讀圖、視圖及繪圖能力，課程內容包含基本製圖知識、正投影、機械元件、尺寸標註及公差配合。\r\n",
    "describe_eh": "The engineering student for the 21 century must understand how to read and write in the graphic language. Everyone on the engineering team must be able to communicate quickly and accurately in order to compete in the world market. The students who can become proficient in graphic communication will succeed and add value to the employer who hires them.\r\nThis course is an advanced course of \"Engineering Graphics\". Emphasizes the ability to develop, read and interpret engineering drawings, sketches and graphs. This is a course in basic drawing techniques, orthographic projection, mechanical elements, dimension, tolerance and fit.\r\n",
    "pre_subname": "ENGS1003工程圖學(一)",
    "pre_sub_id3": "ENGS1003",
    "pre_sub_ename": "ENGS1003 ENGINEERING GRAPHICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂機械畫：能夠描述重要的製圖元素及遵循CNS規範。",
      "describe_en": "Engineering drawing with their own words: Be able to describe important drawing elements and follow the Chinese National Standards."
    },
    {
      "seq": 2,
      "describe_ch": "能運用機械畫的製圖原理，並能正確清楚表達。",
      "describe_en": "Distinguish and make clear statement where engineering drawing  graphic principles can be applied."
    },
    {
      "seq": 3,
      "describe_ch": "能使用電腦設備，繪製特定機械零件與工作圖並標註。",
      "describe_en": "Be able to use computer equipment to draw machine parts and working plot and dimensioning.　"
    },
    {
      "seq": 4,
      "describe_ch": "能以圖語方式將製圖結果與同儕、助教及教師溝通。",
      "describe_en": "Communicate drafting results in graphic language form to classmates, teaching assistants, and the instructor."
    }
  ],
