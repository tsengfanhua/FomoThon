  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE12121",
    "sub_id": "52950",
    "scr_dup": "001",
    "sub_title": "微電子學原理與工程應用",
    "sub_title_en": null,
    "sub_describe": "微電子學元件原理與工程應用：二極體、雙極性接面電晶體、運算放大器和金氧半場效電晶體。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "電子學(一)",
    "sub_ename": "ELECTRONICS(1)",
    "describe_ch": "電子學(一)課程介紹電子學原理、電子元件特性和基本電子電路分析。課程內容包括電子學與半導體概念、運算放大器、二極體和電晶體之基本電子電路分析。本課程講授基本電子觀念和應用技術為主，訓練電子電路直流模型分析能力。",
    "describe_eh": "Electronics (1) course introduces the principles of electronics, the characteristics of electronic components and basic electronic circuit analysis. The course content includes electronics and semiconductor concepts, operational amplifiers, diodes and basic electronic circuit analysis of transistors. This course mainly teaches basic electronic concepts and application technology, and trains the ability of DC model analysis of electronic circuits.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解各種電子元件之基本功能與電路知識",
      "describe_en": "Understanding the basic function and circuit knowledge of various electronic devices."
    },
    {
      "seq": 2,
      "describe_ch": "理解各種電子元件與電子電路的工程原理",
      "describe_en": "Comprehension for the engineering principle of various electronic devices and electronic circuits."
    },
    {
      "seq": 3,
      "describe_ch": "應用各種電子實驗設備完成電子電路之測試與設計",
      "describe_en": "Application for the electronic instruments to circuit testing and design."
    },
    {
      "seq": 4,
      "describe_ch": "運用電子電路分析軟體完成電子電路之特性分析",
      "describe_en": "Apply the circuits simulation tool box to circuits characteristic analysis."
    }
  ],
