  "description": {
    "sub_id3": null,
    "sub_name": "空間資訊整合應用專論",
    "sub_ename": "ADVANCED DISCUSSION ON INTEGRATED APPLICATION OF SPATIAL INFORMATION TECHNLOGIES",
    "describe_ch": "此課程為進階課程，涵蓋GIS、RS、GPS技術之應用導讀，使學生能熟悉空間資訊系統應用，達到理論與實務充分配合，並運用辯證法，使參與師生能夠在數個特定空間資訊議題下，進行深度對話尋找真理。",
    "describe_eh": "This course is an advanced study of special topic on geographic information system. It includes the applications of GIS, RS, GPS technologies. The primary way is to teach students with the introduction of special topic on geographic information system and encourage participants(teacher included) to have several deep dialogs in order to seek the truth in the context of geospatial perspective.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "掌握新科技對現階段之重要性，能應用新技術。",
      "describe_en": "Application of new technology and the significance for the present."
    },
    {
      "seq": 2,
      "describe_ch": "導入辯證法進行國內外空間資訊議題之討論：能從不同角度及深度評鑑特定議題。",
      "describe_en": "Geospatial issue discussion by dialectic."
    }
  ],
