  "description": {
    "sub_id3": null,
    "sub_name": "景觀概論",
    "sub_ename": "INTRODUCTION TO LANDSCAPE ARCHITECTURE",
    "describe_ch": "本課程是介紹景觀的基本原理與觀念。其主題的安排，包括景觀美、人的感官及審美意識、景觀資源、景觀的構景元素、景觀的基礎調查、公園綠地、景觀與庭園、都市景觀、都市意象、都市設計、景觀與開放空間、都市景觀與市民參與、都市魅力的創造、都市景觀案例的探討等。",
    "describe_eh": "This course introduces the basic principles and concepts of landscape architecture. The main topics include beauty of landscape，the senses and sensuous idea，landscape resource，elements of landscape，basic survey of landscape，park and green space，land",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠利用某些方法讓我們瞭解景觀的相關理論",
      "describe_en": " Be able to understand the ways in which we have an approach to the landscape"
    },
    {
      "seq": 2,
      "describe_ch": "能夠利用某些方式讓我們瞭解我們人類的行為影響了景觀的品質",
      "describe_en": "Be able to understand the ways in which human behavior influences the quality of landscape"
    },
    {
      "seq": 3,
      "describe_ch": "能從多方角度分析人與景觀間的互動關係",
      "describe_en": "Be able to analysis various perspectives on human-landscape interrelationships"
    },
    {
      "seq": 4,
      "describe_ch": "能使用景觀的理論與知識，分析有關人與景觀間的議題，並提出專業基礎以上的想法",
      "describe_en": "Be able to use theories and knowledge of landscape specific issues and problems and to propose the basic and up-level arguments"
    },
    {
      "seq": 5,
      "describe_ch": "知道於何處可找到景觀相關的期刊、研究結果與相關資訊",
      "describe_en": "Know where to access journals, research findings, and other information regarding landscape"
    },
    {
      "seq": 6,
      "describe_ch": "能以書面或口頭方式將啟發的想法與同儕及教師溝通",
      "describe_en": "Communicate the learning ideas in the written or oral format to classmates and the instructor"
    },
    {
      "seq": 7,
      "describe_ch": "能透過小組展現團隊合作能力",
      "describe_en": "Demonstrate team spirit through teamwork"
    }
  ],
