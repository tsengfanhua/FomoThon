  "description": {
    "sub_id3": null,
    "sub_name": "產業發展專題",
    "sub_ename": "SEMINAR IN INDUSTRIAL DEVELOPMENT",
    "describe_ch": "本課程著重在探討如何解釋不同區域在產業或經濟發展上所產生之獨特的發展模式。除介紹近來有關新興工業化國家(特別是台灣)產業及區域發展的不同研究論述及取向，本課程更討論在所謂全球化及強調技術創新的知識經濟時代以下，產業發展及升級的背後驅動制度性因素及機制。",
    "describe_eh": "This course focuses on how to explain the unique development models that different regions produce in terms of industrial or economic development. In addition to introducing recent research discussions and orientations on the industrial and regional development of newly industrialized countries (especially Taiwan), this course also discusses the institutional factors behind industrial development and upgrading under the era of the so-called globalization and knowledge-based economy that emphasizes technological innovation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "整合商管專業知識與實務，並運用資訊科技分析與解決產業發展問題",
      "describe_en": "To integrate business management knowledge and practices, while leveraging information technology to analyze and solve industry development problems."
    },
    {
      "seq": 2,
      "describe_ch": "應用溝通技巧與資訊科技工具，有效表達研究議題的思辨邏輯與解決方案",
      "describe_en": "To apply communication skills and information technology tools to effectively express the dialectical logic and solutions of the research topic."
    }
  ],
