  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE04139",
    "sub_id": "31950",
    "scr_dup": "001",
    "sub_title": "材料受不同外力變形之行為與防止材料破壞與失效的方法",
    "sub_title_en": null,
    "sub_describe": "主要研究變形體受力後發生的變形(deformation)；研究由於變形而產生的附加內力；研究由此而產生的失效(failure)以及失效控制。並在此基礎上匯出工程構件靜力學設計準則與設計方法。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "高等材料力學",
    "sub_ename": "ADVANCED MECHANICS OF MATERIALS",
    "describe_ch": "為修過材料力學的大學部學生選修，訓練學生結構件之分析、設計和應用之能力。課程內容涵蓋：stress and strain, plane theory of elasticity, criteria for material failure, bending of beams, beams on elastic foundations, and bending of thin plates.",
    "describe_eh": "The course is designed for the undergraduate students who have taken the course of mechanics of materials. The topics are stress and strain, plane theory of elasticity, criteria for material failure, bending of beams, beams on elastic foundations, and bending of thin plates.",
    "pre_subname": "ENGS2001材料力學(一)、ENGS2002材料力學(二)",
    "pre_sub_id3": "ENGS2001",
    "pre_sub_ename": "ENGS2001 MECHANICS OF MATERIALS(1)、ENGS2002 MECHANICS OF MATERIALS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的辭彙定義應力、應變、彈性模數、波松比、降伏應力、極限應力。能理解並說明高等材料力學在社會及經濟層面的重要性及影響。",
      "describe_en": "能用自己的辭彙定義應力、應變、彈性模數、波松比、降伏應力、極限應力。能理解並說明高等材料力學在社會及經濟層面的重要性及影響。"
    },
    {
      "seq": 2,
      "describe_ch": "能應用二維彈性力學理論分析平面應力之問題並瞭解彈性力學與結構件分析、設計之關係。",
      "describe_en": "能應用二維彈性力學理論分析平面應力之問題並瞭解彈性力學與結構件分析、設計之關係。"
    },
    {
      "seq": 3,
      "describe_ch": "能運用合適之破壞準則探討等方性材料結構件之分析、設計與應用。",
      "describe_en": "能運用合適之破壞準則探討等方性材料結構件之分析、設計與應用。"
    },
    {
      "seq": 4,
      "describe_ch": "瞭解板殼理論的推導過程並能應用相關理論分析平板結構件。",
      "describe_en": "瞭解板殼理論的推導過程並能應用相關理論分析平板結構件。"
    }
  ],
