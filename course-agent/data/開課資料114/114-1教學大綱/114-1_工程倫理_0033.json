  "description": {
    "sub_id3": null,
    "sub_name": "工程倫理",
    "sub_ename": "ENGINEERING ETHICS",
    "describe_ch": "本課程將教授學生對了法律架構的基本了解、對雇主保守企業機密。本課程也讓學生對人民團體能有整體的認知，從而在專業性職業團體組織運作中培養敬業精神與職業倫理，並希望學生在畢業後成為知分寸、有立場、能明辨是非和能做正確抉擇、術德兼備的專業人員。",
    "describe_eh": "Studying this course may let students have integrated recognition and to cultivate the spirit of respecting work and career ethics in the organizing operation of the special professional group.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解基本法律架構、能分辨是非，並做正確的抉擇，成為術德兼備的專業人員。\r\n\r\n",
      "describe_en": "Can enable students to have a holistic understanding of the publics"
    },
    {
      "seq": 2,
      "describe_ch": "在專業性職業團體組織中能有敬業精神，並了解團隊合作及社會貢獻的重要性。\r\n\r\n",
      "describe_en": "Professionalism in organization and understand the importance of teamwork and social contribution."
    }
  ],
