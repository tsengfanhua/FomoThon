  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB05122",
    "sub_id": "38551",
    "scr_dup": "001",
    "sub_title": "探究的主題為 (1) 消費者與生產者面對經濟資源有限的限制下，如何做出有效率的資源配置行為。(2) 在各種市場結構下、市場參與者 (消費者與生產者)和政府的決策如何決定資源的配置。",
    "sub_title_en": null,
    "sub_describe": "(1) 消費者與生產者面對經濟資源有限的限制下，如何做出有效率的資源配置行為。\n(2) 在各種市場結構下、市場參與者 (消費者與生產者)和政府的決策如何決定資源的配置。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "個體經濟學(一)",
    "sub_ename": "MICROECONOMICS(1)",
    "describe_ch": "個體經濟學運用限制下的最適化、均衡分析以及比較靜態三個分析工具來研究消費者行為、生產者行為、市場結構以及要素市場。本課程的主要目標在訓練學生建立紮實之理論基礎。",
    "describe_eh": "Microeconomics uses three analytical tools: constrained optimization, equilibrium analysis and comparative statics to study consumer behavior, producer behavior, market structure and input markets. The main goal of this course is to develop students' abilities to apply these analytical tools to the ordinary economic events, enabling students to form their own viewpoints toward the economic world.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": " 能理解並說明經濟循環周流圖的概念，及消費部門與生產部門在市場上的相互關係　",
      "describe_en": "To understand the concept of circular-flow diagram and the interrelationship between the consuming sector and the producing sector in the markets."
    },
    {
      "seq": 2,
      "describe_ch": "能應用消費者理論在限制式下進行最適選擇",
      "describe_en": "To consumer theory to make optimal choices under constraints."
    },
    {
      "seq": 3,
      "describe_ch": "能分析政府政策如何影響消費者的最適選擇",
      "describe_en": "To analysis how government policies affect consumers' optimal choices."
    }
  ],
