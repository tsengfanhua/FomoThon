  "description": {
    "sub_id3": null,
    "sub_name": "都市計畫概論",
    "sub_ename": "INTRODUCTION TO URBAN PLANNING",
    "describe_ch": "都市計畫概論是針對都市計畫歷史、理論和實務等作介紹的一門跨領域統整性學科。其目的在對都市計畫初學者提供：(一)都市規劃研究演進的歷史；(二)都市規劃原則的觀點；(三)都市規劃流程和操作的技巧。",
    "describe_eh": "This is a course that involving history, theory and practice in urban planning. The purpose of this course is threefold : (1) The evolutionary history of urban planning study;(2) The theoretical methodology and principle of urban planning ; (3) The process of urban planning.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能認識都市計畫的內涵，並對都市計畫的實質內容有一初步的認識。",
      "describe_en": "Knowledge for the basic concepts of urban planning, and the contents of urban planning."
    },
    {
      "seq": 2,
      "describe_ch": "能理解都市計畫的作業流程。",
      "describe_en": "Comprehensive for the process of urban planning."
    },
    {
      "seq": 3,
      "describe_ch": "能認識都市計畫發展的歷史沿革、現況及未來發展趨勢。",
      "describe_en": "Knowledge for the urban planning development history, current situation and status, and the trends of the future."
    }
  ],
