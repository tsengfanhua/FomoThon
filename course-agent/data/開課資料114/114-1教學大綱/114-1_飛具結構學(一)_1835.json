  "description": {
    "sub_id3": null,
    "sub_name": "飛具結構學(一)",
    "sub_ename": "AIRCRAFT STRUCTURES(1)",
    "describe_ch": "此課程之教授內容乃是以基礎之材料力學應用於飛具結構之靜態分析上。學生在修習此課程後, 應具備有基本之飛機結構靜態分析之技能，能夠執行材料之應力-應變分析, 樑之受力情形, 主要飛機結構之分析, 以及一 般機身、機翼組件之分析。",
    "describe_eh": " On the completion of the course the student will be equipped with basic knowledge of aircraft structural analysis. The students are expected to be capable to analyze stress-strain of materials, beam general conditions, principal aircraft structures, and general parts of fuselage and wings.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具有基本結構力學之知識。",
      "describe_en": "To have the fundamental knowledge about structural mechanics."
    },
    {
      "seq": 2,
      "describe_ch": "具有基本結構力學分析的能力與技術。",
      "describe_en": "To be capable of conducting basic structural analysis and design using computer aided engineering tools"
    },
    {
      "seq": 3,
      "describe_ch": "應用基本材料力學理論與分析技術進行航太結構分析。",
      "describe_en": "To have the ability of applying the theory of material mechanics to the analysis of aircraft and aerospace structures"
    }
  ],
