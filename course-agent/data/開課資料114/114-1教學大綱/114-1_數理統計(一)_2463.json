  "description": {
    "sub_id3": null,
    "sub_name": "數理統計(一)",
    "sub_ename": "MATHEMATICAL STATISTICS(1)",
    "describe_ch": "本課程主要介紹統計的理論基礎,學生學習本課程除了對離散及連續分配有更進一步的探討外,對分配間的關係及抽樣分配也有更好的概念.內容包含隨機變數、分配函數之性質、期望值、多元分配、變數變換方法、順序統計量、收斂定理、中央極限定理。",
    "describe_eh": "Mathematical statistics (I) is a foundation of theorical course in statistics. Students learn this course can really know the additional properties of discrete and continuous distribution and the relationship between these distribution. We also discuss the Central Limit Throrem and its applications.",
    "pre_subname": "MATH2011機率論",
    "pre_sub_id3": "MATH2011",
    "pre_sub_ename": "MATH2011 PROBABILITY",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "介紹隨機向量、聯合分配、條件分配、及隨機變數函數之分配，並加強學生之計算能力。",
      "describe_en": "Give the definitions for random vector、joint distributions、conditional distributions、and the distributions of the function of the random vectors, and let students create their computing ability."
    },
    {
      "seq": 2,
      "describe_ch": "介紹抽樣分配的計算(累積分配函數法、變數變換法及動差法)， 並使學生了解t-分佈及F-分佈的架構及期相關性質。\r\n",
      "describe_en": "Gives the calculations for sampling distributions (c.d.f, Transformation, and m.g.f. Techniques), and let students know the structure and properties of t-and F-distributions.\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "介紹順序統計量，並讓學生了解其重要性及其應用。",
      "describe_en": "Give the definition of the order statistics, and let students know its importance and its applications."
    },
    {
      "seq": 4,
      "describe_ch": "介紹各種收斂定理並介紹中央極限定理及其應用。",
      "describe_en": "Give some convergence theorems including the important central limit theorem and its applications."
    }
  ],
