  "description": {
    "sub_id3": null,
    "sub_name": "智慧城鄉與空間資訊專論",
    "sub_ename": "SPECIAL TOPICS ON SMART CITY AND GEOSPATIAL INFORMATION PRACTICE",
    "describe_ch": "本課程著重在導入智慧城鄉及空間資訊技術領域技術，針對跨域整合技術實踐案例之介紹與評析，培養學生具有整合、實作與應用的分析能力。",
    "describe_eh": "This course focuses on the introduction of technologies in the field of smart city and geospatial information technology which includes the up-to date development of cross-domain integration technology practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過主題式案例介紹空間資訊技術運用。",
      "describe_en": "Learners can apply Geospatial Information practice by theme-based instruction."
    },
    {
      "seq": 2,
      "describe_ch": "能夠智慧城鄉實踐案例介紹可掌握時代發展趨勢與現況",
      "describe_en": "Learners can depict the tendency and condition of smart city via various case studies."
    },
    {
      "seq": 3,
      "describe_ch": "培養整合分析的應用能力",
      "describe_en": "Foster the ability of integrated analysis using practical projects."
    }
  ],
