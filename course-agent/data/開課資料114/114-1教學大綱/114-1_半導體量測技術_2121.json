  "description": {
    "sub_id3": null,
    "sub_name": "半導體量測技術",
    "sub_ename": "PROBING TECHNOLOGIES ON SEMICONDUCTORS",
    "describe_ch": "欣銓科技股份有限公司(Ardentec)與本校(FCU)攜手合作，提供先進半導體製程技術知識，並結合合本校資電學院與工學院之專業師資，針對製程、整合、設備、研發、職場應對等專業知識。透過實習和參訪活動，使學生有機會親身體驗生產作業，深化對先進半導體公司職務內容的理解，提升實作能力，培養具備無落差就業能力的高科技產業人才。",
    "describe_eh": "Ardentec Corporation collaborates with Feng Chia University to provide advanced knowledge of the semiconductor manufacturing process. We leverage our university's College of Information and Electrical Engineering and College of Engineering expertise to cover various aspects such as processes, integration, equipment, research and development, and workplace adaptation. Through internships and site visits, students can experience production operations firsthand, deepen their understanding of advanced semiconductor company job roles, enhance practical skills, and cultivate high-tech industry talents capable of seamless employment transitions.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解各種半導體製程設備組件之基本功能與知識",
      "describe_en": "Understand the fundamental knowledge of various semiconductor process equipment and components."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解半導體晶片製作流程",
      "describe_en": "Understand the manufacturing process of semiconductor wafers and chips."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解半導體產業職場屬性與倫理",
      "describe_en": "Have good notions on the workplace and the ethics in the semiconductor industry"
    }
  ],
