  "description": {
    "sub_id3": null,
    "sub_name": "環境品質與監測",
    "sub_ename": "ENVIRONMENTAL QUALITY AND MONITORING",
    "describe_ch": "本課程提供學生各種環境品質(包含水質、空氣、土壤等)之重要性與影響及其資料庫應用之介紹，並說明環檢所公告分析方法之品質要求(PA01-PA08)相關規定。課程要求學生搜尋相關的最新期刊文獻，確定主題撰寫期末報告與口頭發表，以說明環境監測過程中品保/品管計畫之要求重點。",
    "describe_eh": "This course provides students with an introduction to the importance and influence of various environmental qualities (including water quality, air, soil, etc.) and the application of their database, and explains the quality requirements (PA01-PA08) of the analytical methods announced by the Environmental Inspection Institute. The course also requires students to search for the latest relevant journal literature, determine the topic and write a final report and give an oral presentation to illustrate the key requirements of the quality assurance/quality control plan in the environmental monitoring process.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得環境品質與實驗室分析數據品質流程之專業知識\t",
      "describe_en": "To obtain the knowledge about quality assurance in various environmental analytical results and apply accessible public databases for future work."
    },
    {
      "seq": 2,
      "describe_ch": "理解傳統/新興環境議題的品質保證以及監測控制措施\t",
      "describe_en": "To comprehension the quality assurance for classical/neo environmental issues and their controls."
    },
    {
      "seq": 3,
      "describe_ch": "分析不同條件的環境品質現況發展出適切之監控方案\t",
      "describe_en": "To analysis environmental quality and cope with proper monitoring program."
    }
  ],
