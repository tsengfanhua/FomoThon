  "description": {
    "sub_id3": null,
    "sub_name": "應用力學",
    "sub_ename": "APPLIED MECHANICS",
    "describe_ch": "課程提供給學生靜力學結構工程技巧的基本原則及應用。  教該如何將力量轉成支持並且達成穩定的平衡情況。學習了解，物體任何載重經過的平衡類型情況，而且產生結構的行為。",
    "describe_eh": "The course provides students with the basic principles and application of statics structure engineering mechanics. To teach how to translate the forces to the supports and achieve stable balance condition. To learn and create the recognition of structural behavior through understanding the equilibrium of object by any loading types in the condition.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能認識靜力學之基本原理及平衡概念",
      "describe_en": "Understand basic principles and concept of statics."
    },
    {
      "seq": 2,
      "describe_ch": "能判別基本力量類型與支承形式",
      "describe_en": "Be able to distinguish basic force types and support's types."
    },
    {
      "seq": 3,
      "describe_ch": "能計算梁結構基本類型的支承反力及簡單桁架的桿件內力",
      "describe_en": "Be able to calculate reactive forces of statically determinate beams and the internal forces of simple trusses."
    }
  ],
