  "description": {
    "sub_id3": null,
    "sub_name": "民法總則",
    "sub_ename": "CIVIL CODE - GENERAL PART",
    "describe_ch": "民法總則為適用於民法各篇的一般法律原則，而民法又為民商法的母法，足見民法總則的重要性，本課程將以法律行為為主軸，分別討論法律行為的主體、各體與法律關係，以建立修課同學基本的法律概念。",
    "describe_eh": "Civil Code is the basis of the Civil Law. General Part of Civil Code regulates general legal principles. This course will be focus on legal business, legal negotiation in order to build a basic legal concept for the participants.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能認識生活中所發生之案例，何種案例會和民法發生關連。",
      "describe_en": "Be able to realize the cases occur in our life which are related to the Civil Law."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解人與人之間會發生權利和義務的關係。",
      "describe_en": "Be able to understand that the relationship between right and obligation occurs among people."
    },
    {
      "seq": 3,
      "describe_ch": "能理解民法所規範之基本概念。",
      "describe_en": "Be able to understand the basic concepts regulated from the Civil Law."
    },
    {
      "seq": 4,
      "describe_ch": "能分析民事案例的法律癥結點。",
      "describe_en": "Be able to analyze the issues regarding the civil cases."
    }
  ],
