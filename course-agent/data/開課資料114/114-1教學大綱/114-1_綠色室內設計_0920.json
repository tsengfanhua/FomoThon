  "description": {
    "sub_id3": null,
    "sub_name": "綠色室內設計",
    "sub_ename": "GREEN INTERIOR ENVIRONMENT DESIGN",
    "describe_ch": "本課程目標為培養學生對於綠色室內環境之正確觀念，以永續設計的觀點，介紹綠建築正確觀念與可實際落實的技術，啟發對於未來住居環境及永續設計之積極態度，創造生態、節能、減廢、健康的優質室內環境。",
    "describe_eh": "The purpose of this course is to develop correct concepts of green interior environment. With the viewpoint of sustainable design, it will introduce the concepts of green building and green materials, and propose adequate technologies in practice. It can enlighten students to take positive attitudes toward residential environment and sustainable in the future, and be beneficial to make more ecological, more energy-saving, more waste-reductive and healthier interior environment.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解綠建築與綠建材的定義。",
      "describe_en": "To comprehend the definitions of green building and green building material."
    },
    {
      "seq": 2,
      "describe_ch": "理解室內環境相關的綠色概念與設計手法。",
      "describe_en": "To comprehend green building concepts and design methods of interior environment."
    },
    {
      "seq": 3,
      "describe_ch": " 能應用綠色室內設計手法。",
      "describe_en": "To apply green building technology for interior environment."
    }
  ],
