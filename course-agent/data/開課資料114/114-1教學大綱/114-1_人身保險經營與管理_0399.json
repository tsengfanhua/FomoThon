  "description": {
    "sub_id3": null,
    "sub_name": "人身保險經營與管理",
    "sub_ename": "LIFE INSURER OPERATION AND MANAGEMENT",
    "describe_ch": "在進入職場前，更深入的了解壽險實務的運作，並學習一些基本的技巧，譬如學習上台報告並規定使用Microsoft Power Point作簡報，課程內容包括壽險所有的主題並在適當時間帶領同學前往台北參觀保險公司及相關的機構。",
    "describe_eh": "The purpose of this course is to Individual life and health insurance policies in insurance at the individual and group level, including the effects of The management, operation, and regulation of life insurance companies and to practice behavioral skills to improve your interpersonal effectiveness.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解壽險公司之重要經營因素",
      "describe_en": "Comprehension for the key performance indicators for a life insurance company"
    },
    {
      "seq": 2,
      "describe_ch": "能分析壽險公司之經營狀況",
      "describe_en": "Can analyze the performance of a life insurance company"
    },
    {
      "seq": 3,
      "describe_ch": "學生能理解職業倫理道德",
      "describe_en": "Understanding the business ethics"
    }
  ],
