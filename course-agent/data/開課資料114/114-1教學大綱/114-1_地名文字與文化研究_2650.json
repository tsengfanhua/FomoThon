  "description": {
    "sub_id3": null,
    "sub_name": "地名文字與文化研究",
    "sub_ename": "RESEARCH ON TOPONYMY AND CHARACTER CULTURE",
    "describe_ch": "地名承載人文活動重要的地理資訊，文字則是地名組成的重要因素，本課程除了探究文字的歷時文化及功能層面，以及地名地域的風土民情、地形地貌，再透過GIS等數位工具進科學分析，綜整出地名與文字的互動及脈絡。",
    "describe_eh": "The place name carry important geographical information about human activities, while characters is a crucial factor in their formation. Through the study of toponyms, not only can we explore the historical and functional aspects of characters, but we can also reveal the local customs, traditions, and topography of a region. By analyzing the interaction and context between toponyms and characters in a scientific manner, we can gain a comprehensive understanding of their cultural significance.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能使用GIS數位工具從地名文字中探究人文地理活動之訊息",
      "describe_en": "Enable students to explore information about human geography activities through toponymy."
    },
    {
      "seq": 2,
      "describe_ch": "能就文字文化學分析地名文字中的結構及內涵",
      "describe_en": "Enable students to analyze the structure and content of toponyms through characters cultural studies."
    }
  ],
