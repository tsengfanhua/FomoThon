  "targets": [
    {
      "seq": 1,
      "describe_ch": "Students learn to recognise the influence of major design movements from the late 19th century to the present.",
      "describe_en": "Students learn to recognise the influence of major design movements from the late 19th century to the present."
    },
    {
      "seq": 2,
      "describe_ch": "Students can distinguish the influences of designers and movements on contemporary practices.",
      "describe_en": "Students can distinguish the influences of designers and movements on contemporary practices."
    },
    {
      "seq": 3,
      "describe_ch": "Students can effectively interpret research and apply critical thinking skills to analyse the cultural significance of design practitioners and design artefacts.",
      "describe_en": "Students can effectively interpret research and apply critical thinking skills to analyse the cultural significance of design practitioners and design artefacts."
    },
    {
      "seq": 4,
      "describe_ch": "Students can distinguish, analyse and compare how design reflects and impacts cultural, social and technological changes.",
      "describe_en": "Students can distinguish, analyse and compare how design reflects and impacts cultural, social and technological changes."
    }
  ],
