  "description": {
    "sub_id3": null,
    "sub_name": "水利產業與經濟",
    "sub_ename": "WATER RESOURCES INDUSTRY AND BUSINESS",
    "describe_ch": "面臨2050年零碳排(Net Zero)的國際共識，新興的水利產業(包括小水力發電、智慧農業管理、水資源回收再利用等)因應而生。本課程主要在介紹國內外新型的水利產業的發展與應用，以及創新的商業發展與成本效益評估。",
    "describe_eh": "Facing with the global “Net Zero in 2050” issue, emerging water resources industries (including small hydropower generation, smart agricultural management, wastewater recycling, etc.) have emerged accordingly. This course mainly introduces the development and application of new water resources industries, as well as their innovative business development and cost-benefit evaluation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解與環境共好之新興水利工程與資源保育系統的設計原理。\t\t",
      "describe_en": "To understand the design principles of eco-friendly hydraulic engineering and resource conservation systems."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解國際水利工程與資源保育之跨領域綜合方案。\t\t",
      "describe_en": "To understand the cross-disciplinary comprehensive project of international hydraulic engineering and resource conservation"
    },
    {
      "seq": 3,
      "describe_ch": "\t因應氣候變遷零淨排放的社會責任。\t\t",
      "describe_en": "Social responsibility of Net Zero due to climate change."
    }
  ],
