  "description": {
    "sub_id3": null,
    "sub_name": "工程力學導論",
    "sub_ename": "INTRODUCTION TO ENGINEERING MECHANICS",
    "describe_ch": "力學為工程建設之基礎科學。本課程的目的是奠定學生的基礎力學概念與知識，以利未來修習應用力學、材料力學、結構分析與設計等專業科目。課程重點在利用向量方法求解質點與剛體之靜力平衡問題。",
    "describe_eh": "Mechanics is a fundamental subject in engineering construction topics. The objective of this course is to present the concept and knowledge in the Engineering Mechanics for connection of Applied Mechanics, Material Mechanics, and Structure Analysis and Design, etc. Using the vector method to solve the issues of particles and rigid bodies in equilibrium is the major purpose in this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解向量的計算方法與應用",
      "describe_en": "Students can understand the calculation techniques and applications of vector."
    },
    {
      "seq": 2,
      "describe_ch": "應用基本運動定律",
      "describe_en": "Students can apply the law of motion."
    },
    {
      "seq": 3,
      "describe_ch": "培養解題能力",
      "describe_en": "Students can learn the problem-solving abilities."
    }
  ],
