  "description": {
    "sub_id3": null,
    "sub_name": "人工智慧與醫學診斷",
    "sub_ename": "ARTIFICIAL INTELLIGENCE AND MEDICAL DIAGNOSIS",
    "describe_ch": "本課程探討人工智慧在醫學領域的應用。透過人工智慧技術，學生將學習如何利用大數據分析和人工智慧提升醫療準確性與效率。涵蓋醫學影像、影像判讀、病理探討、病例分析、疾病診斷及預測診斷等，並聚焦人工智慧於癌症中的臨床應用，從診斷到客製化治療等醫學應用場景。將強調AI在個人化治療與早期疾病診斷中的潛力。課程旨在培養學生掌握人工智慧工具，以應對未來衛生保健的挑戰。",
    "describe_eh": "This course explores the application of artificial intelligence in the medical field. Through artificial intelligence technology, students will learn how to use big data analysis and artificial intelligence to improve medical accuracy and efficiency in clinical diagnostics. It covers medical imaging, image interpretation, pathology discussion, case analysis, disease diagnosis, predictive diagnosis, etc., and focuses on the clinical application of artificial intelligence in cancer, from diagnosis to tailored treatment and other medical application scenarios. The potential of AI in personalized treatment and early disease early diagnosis will be emphasized. The course is designed to equip students with artificial intelligence tools to address future healthcare challenges.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解人工智慧的基本原理",
      "describe_en": "To understand the basic principles of artificial intelligence."
    },
    {
      "seq": 2,
      "describe_ch": "了解人工智慧在醫學領域的基本應用",
      "describe_en": "To understand the basic applications of artificial intelligence in medicine potential application of AI in post-COVID-19 era."
    },
    {
      "seq": 3,
      "describe_ch": "學習人工智慧技術在醫學影像與病例分析中的實際應用",
      "describe_en": "To learn the practical application of artificial intelligence technology in medical imaging and case analysis."
    },
    {
      "seq": 4,
      "describe_ch": "學習人工智慧技術在疾病診斷及預測診斷中的臨床應用",
      "describe_en": "To learn the clinical application of artificial intelligence technology in disease diagnosis and predictive diagnosis."
    }
  ],
