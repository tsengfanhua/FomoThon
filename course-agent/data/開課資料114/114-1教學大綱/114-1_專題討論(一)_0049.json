  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(一)",
    "sub_ename": "SEMINAR(1)",
    "describe_ch": "解決現實生活中的業務，工程，科學，體育和其他幾個領域的問題常常需要最佳化方法和技術。本課程的目的是發展對包括線性規劃，整數線性規劃和網絡優化在內的最佳化模型的基本理解，並且該課程側重於模型建立，求解技術以及用於求解最佳化模型的軟件的使用。",
    "describe_eh": "Optimization methods and techniques are often required for solving real-world problems in business, engineering, sciences, sports, and several other areas. The purpose of this course to develop a fundamental understanding of optimization models including linear optimization, integer linear optimization and network optimization, and this course focuses on model formulation, solution techniques, and the use of software for solving optimization models.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "利用如何蒐集資料的概述、一些數據科學方面的演講、專題演講以及相關主題的報告來幫助學生綜合在數據科學方面所應具之聽、說、讀、寫的能力",
      "describe_en": "By using an overview of the ways to collect resource, invitation Data Science talks to help students improve their synthetic abilities for listening, speaking , reading and writing."
    }
  ],
