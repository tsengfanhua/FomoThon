  "description": {
    "sub_id3": null,
    "sub_name": "合作事業",
    "sub_ename": "COOPERATIVES",
    "describe_ch": "依照合作社法規規定的合作事業，包括生產、運銷、供給、利用、勞動、運輸、消費、公用、信用及保險合作等十種合作事業，本課程偏重理論及實務應用，在非營利學程中列為重點課程。",
    "describe_eh": "Course Goals：1.Training Top-Flight Human Resources for Cooperatives Business, 2.Roots in Taiwan, Eyes on the world。Course Topics: 1.Intrinsic of Cooperatives Business, 2.Consumer Cooperatives Business, 3.Credit Cooperatives Business, 4.Agricultural Cooperatives Business, 5.Insurance Cooperatives Business.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能知道合作事業在產業界的地位。",
      "describe_en": "TThe knowledge of the place of the Cooperatives Business in the firm."
    },
    {
      "seq": 2,
      "describe_ch": "理解政府合作政策與管理議題。",
      "describe_en": "Comprehending government policy and management Issues in Cooperatives."
    },
    {
      "seq": 3,
      "describe_ch": "合作事業分業法規創制可行性之應用。",
      "describe_en": "To apply Cooperative Business laws innovation in practicable."
    }
  ],
