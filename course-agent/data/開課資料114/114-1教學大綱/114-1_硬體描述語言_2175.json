  "description": {
    "sub_id3": null,
    "sub_name": "硬體描述語言",
    "sub_ename": "HARDWARE DESCRIPTION LANGUAGE",
    "describe_ch": "硬體描述語言是一種可用來描述電子電路架構與行為的特定電腦語言，它可用於電路設計的模擬與實現。本課程將介紹硬體描述語言架構及語法，並將其應用於電子系統層級的數位電路系統設計。",
    "describe_eh": null,
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解並使用自己的辭彙說明硬體描述語言的系統架構與其達成方法。",
      "describe_en": "Define HDL with their own words: Be able to describe frameworks and code structures of HDL."
    },
    {
      "seq": 2,
      "describe_ch": "能應用硬體描述語言進行通訊系統之數位電路設計與實現。",
      "describe_en": "Be able to use HDL to design and implement the digital circuits in communication systems."
    }
  ],
