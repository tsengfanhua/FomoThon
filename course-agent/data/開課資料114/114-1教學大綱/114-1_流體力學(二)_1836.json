  "description": {
    "sub_id3": null,
    "sub_name": "流體力學(二)",
    "sub_ename": "FLUID MECHANICS(2)",
    "describe_ch": "本課程提供修習航空工程之學生關於流體動力學之學理介紹。課程內容包括1.介紹如何利用控制體積之觀念來推導牛頓流體之質量與動量守恆定律的偏微分方程式，並用來求解工程問題；2.瞭解並使用Bernoulli方程式求解不可壓縮、非黏滯流場之速度及壓力變化；3.學習因次分析來設計物理或數值實驗，並應用於類比。",
    "describe_eh": "Develop an understanding of fluid dynamics in aerospace engineering. Topics covered include: 1. Learn to use control volume analysis to derive the partial differential equations governing the conservation of mass and momentum of Newtonian fluids and to solve engineering problems; 2. Understand and use Bernoulli equation to determine pressure and velocity variations in incompressible inviscid flows; 3. Learn to use dimensional analysis to design physical or numerical experiments and to apply dynamic similarity.",
    "pre_subname": "MATH1005微積分(一)、ENGS2007流體力學(一)、ENGS1008應用力學(一)、ENGS2011工程數學(一)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、ENGS2007 FLUID MECHANICS(1)、ENGS1008 APPLIED MECHANICS(1)、ENGS2011 ENGINEERING MATHEMATICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解守恆方程式背後所隱含的基本定律以及確認方程式內各項之重要性。",
      "describe_en": "Be able to understand the fundamental principles behind the conservation equations and identify the significance of each term in the governing equations."
    },
    {
      "seq": 2,
      "describe_ch": "能決定使用理想流觀念及Bernoulli方程式之適當時機。",
      "describe_en": "Be able to decide when appropriate to use ideal flow concepts and the Bernoulli equation."
    },
    {
      "seq": 3,
      "describe_ch": "能運用Buckingham-Pi理論將一組因次變數簡化成一組無因次參數群。",
      "describe_en": "Be able to reduce a set of dimensional variables into a smaller set of dimensionless variables in accordance with the Buckingham-Pi Theorem."
    }
  ],
