  "description": {
    "sub_id3": null,
    "sub_name": "創新管理",
    "sub_ename": "INNOVATION MANAGEMENT",
    "describe_ch": "討論創新對企業經營與產業發展的重要性，以及創新的本質和類型。經由技術創新、組織創新、流程創新、產品創新、經營創新、與文化創新等模式之探討與實例分析，探究推動與管理創新的方法以及創新成功與失敗的因素。",
    "describe_eh": "This course is designed of. This course encompasses the principles, practical applications, case studies, and implementation strategies of Innovation Management, to develop a substantial understanding that innovation means change both in the organizational and the economic sense, and to develop the abilities of applying innovation concepts to real-life problem resolution.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "介紹創新管理的內涵",
      "describe_en": "To introduce the implication of implication management."
    },
    {
      "seq": 2,
      "describe_ch": "闡釋創新模型",
      "describe_en": "To explain models the of innovation ."
    },
    {
      "seq": 3,
      "describe_ch": " 說明創新資源與移轉",
      "describe_en": "To explain sources and transfer innovation."
    },
    {
      "seq": 4,
      "describe_ch": "認知創新的潛力",
      "describe_en": "To recognize the potential of an innovation."
    },
    {
      "seq": 5,
      "describe_ch": "了解如何降低創新風險",
      "describe_en": "To understand how to reduce uncertainty."
    },
    {
      "seq": 6,
      "describe_ch": "了解策略創新的過程",
      "describe_en": "To understand the process of strategic innovation."
    }
