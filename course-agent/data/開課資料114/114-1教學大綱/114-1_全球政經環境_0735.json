  "description": {
    "sub_id3": null,
    "sub_name": "全球政經環境",
    "sub_ename": "GLOBAL POLITICAL ECONOMY AND ENVIRONMENT",
    "describe_ch": "本課程培養同學對於全球及國際情勢的「觀察」、「理解」、「分析」能力，期望逐步強化同學的國際觀，學習從全球性觀點來觀察我們生活周遭的社會動態。",
    "describe_eh": "This course cultivates students' ability to \"observe\", \"understand\" and \"analyze\" global and international situations. It is hoped that students will gradually strengthen their international outlook and learn to observe the social dynamics around us from a global perspective.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解全球情勢變化，並建構相關知識基礎，培養分析國際情勢的能力",
      "describe_en": "Able to understand global situation changes, build a relevant knowledge base, and cultivate the ability to analyze international situations."
    }
  ],
