  "description": {
    "sub_id3": null,
    "sub_name": "機率論",
    "sub_ename": "PROBABILITY",
    "describe_ch": "數據的機率結構，影響使用的統計分析方法。本課程涵蓋(1) 率基本性質，隨機變量、機率分佈與累積分配函數、期望值、與變異數的定義與應用。(2)常用離散與連續型隨機變量之介紹與應用。(3)多個隨機變量之關聯、基本性質、與應用。課程搭配EXCEL、Geogebra視覺化工具輔助學習，學生分組以Python、R等程式語言，設計並模擬生活中可見的機率架構。",
    "describe_eh": "The probability structure of the data affects the statistical analysis methods used. This course covers (1) the basic properties of random variables, application of probability and cumulative distribution functions, expected values, and variances. (2) Introduction and application of commonly used discrete and continuous random variables. (3) The basic properties and applications of multiple random variables. The course is equipped with EXCEL and Geogebra visualization tools to assist learning.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識基本機率名詞； 機率基本性質；隨機變量；機率分佈函數與累積分配函數； 熟悉期望值與變異數之計算",
      "describe_en": "Knowledge of basic terminologies in probability；basic properties；  random variable； probability distribution function and cumulative distribution function； Capability of calculating expectation and variance."
    },
    {
      "seq": 2,
      "describe_ch": "了解常用離散型隨機變量，及其對應機率分佈與相關性質",
      "describe_en": "Comprehension for common discrete random variables, corresponding distributions, and properties."
    },
    {
      "seq": 3,
      "describe_ch": "了解常用連續型隨機變量，及其對應機率分佈與相關性質",
      "describe_en": "Comprehension for common continuous random variables, corresponding distributions, and properties."
    },
    {
      "seq": 4,
      "describe_ch": "了解一組隨機變量的聯合機率分佈函數，及衍生之統計量與其分佈",
      "describe_en": "Comprehension for joint probability distribution of random variables; and statistics of random variables and corresponding distributions."
    }
  ],
