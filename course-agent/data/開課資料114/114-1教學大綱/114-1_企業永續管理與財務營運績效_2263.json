  "description": {
    "sub_id3": null,
    "sub_name": "企業永續管理與財務營運績效",
    "sub_ename": "CORPORATE SUSTAINABILITY MANAGEMENT AND FINANCIAL/OPERATION PERFORMANCE\r",
    "describe_ch": "本課程介紹因極端氣候，所衍生出的企業永續管理政策，以及企業深化永續治理文化對其財務/營運績效之影響。透過了解全球面對之風險，討論產業需求、技術及趨勢，分析核心特點，並能瞭解背後的商業邏輯與營運模式。",
    "describe_eh": "This course introduces corporate sustainability management policies derived from extreme climates, and the impact of deepening corporate sustainability governance culture on their financial/operational performance. By understanding the risks faced by the world, discussing industry demand, technologies and trends. Analyzing core features, and understanding the business logic and operating model behind it.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解企業永續之主要概念與內涵",
      "describe_en": "Be able to understand the main concepts and connotations of corporate sustainability"
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並發展企業永續相關策略與模式",
      "describe_en": "Be able to understand and develop strategies and models related to corporate sustainability"
    }
  ],
