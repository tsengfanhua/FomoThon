  "description": {
    "sub_id3": null,
    "sub_name": "暑期專業實習",
    "sub_ename": "SUMMER INTERNSHIP",
    "describe_ch": "本課程為暑期遴選大學部學生提供至產業進行實務接軌的機會。旨在加強理論與實務的整合，以強化學生專業技能，提升未來就業競爭力。",
    "describe_eh": "This course provides an opportunity to select university students during the summer to get practical integration into the industry. It aims to strengthen the integration of theory and practice to strengthen students' professional skills and enhance their future employment competitiveness.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 4.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生理論與實務的整合",
      "describe_en": "To integrate theoretical and pratical knowledge  for students"
    },
    {
      "seq": 2,
      "describe_ch": "強化學生專業技能，具備協調溝通與團隊合作之能力",
      "describe_en": "To strengthen students’ professional skills and engage in effective communication and strategies of teamwork"
    },
    {
      "seq": 3,
      "describe_ch": "具備終身學習的基本素養",
      "describe_en": "To possess the cultivation of life-long learning  responsibilities"
    },
    {
      "seq": 4,
      "describe_ch": "具備專業倫理及社會責任的基本素養",
      "describe_en": "To possess the cultivation of  industry ethics and social responsibilities"
    }
  ],
