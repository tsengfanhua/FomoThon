  "description": {
    "sub_id3": null,
    "sub_name": "碩士論文",
    "sub_ename": "MASTER THESIS",
    "describe_ch": "碩士論文為訓練學生學習創新性研究，學生必須選擇一位指導教授針對研究問題進行研究發展和設計。然後撰寫研究論文和研究的結果。論文需含研究專題導論、文獻回顧、研究設計、研究結果、和結論。",
    "describe_eh": "The course will teach and conduct an original empirical research study. The student must choose a faculty member as a primary advisor to work with. The student must to develop a research project to collect and analyze data and to investigate the research question. The study results are then written up in a thesis. The thesis typically contains an introductory chapter outlining the research question, a literature review chapter, a chapter describing the research design and a chapter discussing results, and stating conclusions, and making recommendations for future research.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
