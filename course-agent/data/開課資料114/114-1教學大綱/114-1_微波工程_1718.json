  "description": {
    "sub_id3": null,
    "sub_name": "微波工程",
    "sub_ename": "MICROWAVE ENGINEERING",
    "describe_ch": "本課程將介紹微波工程所需要的設計技巧與被動元件電路，包括傳輸線理論、微波網路分析、阻抗匹配、共振腔原理、功?分配器、方向耦合器與?波器等，可以了解電磁波在電子電路的應用。",
    "describe_eh": "The design techniques and passive components/circuits in the microwave engineering are introduced in this course, including transmission line theory, microwave network analysis, impedance matching and tuning, resonators, power dividers, directional coupler and filters. The applications of the electromagnetic wave in the electronic circuits are shown.",
    "pre_subname": "MATH1005微積分(一)、MATH1006微積分(二)、IEE1005線性代數、EEEN2010電磁學(一)、EEEN2011電磁學(二)",
    "pre_sub_id3": "MATH1005",
    "pre_sub_ename": "MATH1005 CALCULUS(1)、MATH1006 CALCULUS(2)、IEE1005 LINEAR ALGEBRA、EEEN2010 ELECTROMAGNETICS(1)、EEEN2011 ELECTROMAGNETICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠瞭解微波工程應用中所需被動元件電路的功能及操作原理。",
      "describe_en": "Understand the functions and the operational principles of the required passive elements/ circuits in microwave engineering applications."
    },
    {
      "seq": 2,
      "describe_ch": "能夠運用相關的設計技術於微波工程應用中。",
      "describe_en": "Be able to apply the relative design techniques in microwave engineering applications."
    },
    {
      "seq": 3,
      "describe_ch": "能閱讀相關進階書籍/論文。",
      "describe_en": "Be able to read and study the related advanced books/papers."
    }
  ],
