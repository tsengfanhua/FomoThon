  "description": {
    "sub_id3": null,
    "sub_name": "智慧科技與管理應用",
    "sub_ename": "INTELLIGENCE TECHNOLOGY AND MANAGERIAL APPLICATIONS",
    "describe_ch": "本課程旨在讓同學了解智慧科技在服務創新產業的應用與發展，並進一步規劃未來商業模式的可能性。智慧化是服務產業發展之趨勢，其應用影響價值創造、價值傳遞溝通、顧客數位化經營等層面，帶來商業模式的變革。",
    "describe_eh": " The course is designed to help the students learn the innovative development of service industry and the application of intelligent technologies, and subsequently allow students to have further imagination as well as planning in the future business model of service industry. Generally, students of this course are expected\r\n1. To familiarize with the service innovation and relative intelligence technology application.\r\n2. To develop the skills in understanding user needs and intelligence technology, based upon which, to be able to develop innovative business model.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解進階商管專業意涵與問題",
      "describe_en": "Understand the issue and problem of advanced business and management"
    },
    {
      "seq": 2,
      "describe_ch": "討論進階商管專業知識意涵",
      "describe_en": "Discuss the issue and problem of advanced business and management"
    },
    {
      "seq": 3,
      "describe_ch": "蒐集進階商管專業問題的解決方法",
      "describe_en": "Gather possible solutions to the advanced business and management problems"
    },
    {
      "seq": 4,
      "describe_ch": "提供合適的進階商管專業解決問題方法\r\n",
      "describe_en": "Provide proper solutions to the advanced business and management problems based on a well-reasoned rationale"
    }
  ],
