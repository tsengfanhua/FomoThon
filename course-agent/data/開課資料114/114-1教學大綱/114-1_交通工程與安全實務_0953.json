  "description": {
    "sub_id3": null,
    "sub_name": "交通工程與安全實務",
    "sub_ename": "TRAFFIC ENGINEERING AND TRAFFIC SAFETY PRINCIPALS & PRACTICE",
    "describe_ch": "交通工程概分為交通調查、道路幾何設計、交通管制、停車管理、容量分析、及交通影響評估等，交通工程亦與交通安全息息相關，本課程討論交通工程及交通安全領域理論與實務應用，期使學生成為能全面考量之交通工程師。",
    "describe_eh": "Traffic Engineering can generally be divided into traffic volume survey, highway geometric design, traffic control, parking management, highway capacity analysis, and traffic impact assessment. Traffic engineering is also closely related with traffic safety issues. This course is designed to introduce both theory and general practice of traffic engineering, as well as traffic safety. Some technologies related to traffic engineering, e.g. advanced vehicle detectors, will also be introduced. Students are supposed to be familiar with traffic engineering principals & practice after taking this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解交通工程及交通安全基礎及規劃理論",
      "describe_en": "Understand basic & planning theory of traffic engineering and traffic dafety"
    },
    {
      "seq": 2,
      "describe_ch": "理解並能操作交通影響評估相關作業",
      "describe_en": "Understand and be able to perform traffic impact assessment process of real projects."
    }
  ],
