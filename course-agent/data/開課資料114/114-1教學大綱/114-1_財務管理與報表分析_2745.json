  "description": {
    "sub_id3": null,
    "sub_name": "財務管理與報表分析",
    "sub_ename": "FINANCIAL MANAGEMENT AND STATEMENT ANALYSIS",
    "describe_ch": "本課程之目的在熟悉資本結構管理、股利政策、與選擇權相關之融資策略、財務績效評估、及國際財務管理等重要課題，並使學生學習如何有效運用財務報表分析之觀念與分析技術以評估企業之獲利能力、風險、清償能力部位、投資報酬及其生產力。學期中需作研究報告，以期將財務理論與實務予以融會貫通。",
    "describe_eh": "The purpose fo the course is to introduce the capital structure management, dividend policy, option-related financing strategies, evaluation of financial performance, international financial management, and learn the concepts and analytical tools of financial statement analysis.Research projects will be assigned to students during the semester. The purpose is to familiarize students with the theories and concepts learned from the class and apply them to the real financial world.　",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "綜合瞭解資本結構管理、股利政策、與選擇權相關之融資策略、財務績效評估、以及國際財務管理　\t",
      "describe_en": "Synthesis the capital structure management, the dividend policy, the option-related financing strategies, the evaluation of financial performance, and the major topics in international financial management"
    },
    {
      "seq": 2,
      "describe_ch": "能利用財務報表之資訊以分析企業之獲利能力及風險。　\t",
      "describe_en": "Analyze the profitability and risk of the firm using information in the financial statements.　"
    },
    {
      "seq": 3,
      "describe_ch": "能利用財務報表之資訊以評鑑企業之獲利能力及風險",
      "describe_en": "Evaluate the profitability and risk of the firm using information in the financial statements."
    }
  ],
