  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "微生物學",
    "sub_ename": "MICROBIOLOGY",
    "describe_ch": "本課程主要介紹微生物之組成，細胞構造，以及微生物之代謝合成與營養。除此之外，有關傳統之細菌遺傳與分子生物現象，以及目前有關之生物技術課題均為本課程傳授之目標。",
    "describe_eh": "Introducing the composition of microorganisms, the cellular structures, the metabolism and nutrition of microorganisms. Besides, the classical bacterial genetics and the molecular technologies are also studied.",
    "pre_subname": "EES1000生物學(一)、EES1001生物學(二)",
    "pre_sub_id3": "EES1000",
    "pre_sub_ename": "EES1000 BIOLOGY(1)、EES1001 BIOLOGY(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能分析微生物與生物之差異，並了解微生物學之進展。　\t",
      "describe_en": "Be able to clearly differenciate the difference between microorganisms and organisms, and understand the development of microbiology.　"
    },
    {
      "seq": 2,
      "describe_ch": "能理解微生物應用之範圍，並能清楚表達。　\t",
      "describe_en": "Distinguish and clearly express the fields in which the microorganisms can be applied.　"
    },
    {
      "seq": 3,
      "describe_ch": "理解微生物於環境工程生物處理程序之應用及其原理\t",
      "describe_en": "Be able to understand the principle and application on the biological treatment process in the field of environmental engineering."
    }
  ],
