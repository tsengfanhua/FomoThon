    "tpa_score_new": "<div>Class participation &amp; attendance 20%; Midterm Exam（期中考）20%; Project &amp; Presentation（期末專題+口頭報告）20%; Final Exam（期末考）40%.</div>\n",
    "tpa_score_new_en": null,
