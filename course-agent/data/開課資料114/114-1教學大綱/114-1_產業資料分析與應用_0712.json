  "description": {
    "sub_id3": null,
    "sub_name": "產業資料分析與應用",
    "sub_ename": "INDUSTRY DATA ANALYSIS AND APPLICATION",
    "describe_ch": "本課程介紹產業資料分析的研究方法，並運用統計軟體作資料處理與解析。內容涵蓋迴歸分析、多變量變異數分析、主成份分析、因素分析、區別分析、群集分析與線性結構關係。學生可以運用適當的研究方法來探討產業議題。",
    "describe_eh": "This course introduce the research methods for industry data analysis and implement statistical software to manage and analyze the data. The course content includes regression analysis, multivariate analysis of variance, principal component analysis, factor analysis, discriminant variable, cluster analysis, and linear structure relation. Students can utilize appropriate research methods to explore industry issues.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生能應用適切的研究方法於所欲探討的產業問題",
      "describe_en": "Students can apply the applicable research methods in major industrial questions."
    },
    {
      "seq": 2,
      "describe_ch": "學生能分析產業資料的多變量結果",
      "describe_en": "Students are able to analyze the multivariate results of industrial data."
    }
