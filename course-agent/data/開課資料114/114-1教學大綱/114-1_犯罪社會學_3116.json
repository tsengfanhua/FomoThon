  "description": {
    "sub_id3": null,
    "sub_name": "犯罪社會學",
    "sub_ename": "SOCIOLOGY OF CRIME",
    "describe_ch": "培養同學在犯罪學社會學領域的專業知識，讓同學瞭解犯罪心理的形成、犯罪行為發生原因、犯罪動機與各種犯罪類型等議題。並從社會學觀點出發，著重從個人經驗，進而應用社會學的觀點觀察與瞭解社會，引介社會學的思考方式及重要概念，提升人文關懷。\n本課程著重議題討論，針對各種犯罪行為、社會現象加以剖析，培養同學獨立思考能力，進而建構個人犯罪社會學基礎概念，解讀社會萬象、跨領域創新，與時精進而邁向國際。",
    "describe_eh": "This course aims to cultivate students' professional knowledge in the field of criminology, so that students can understand the field of criminal psychology, including topics such as the formation of criminal psychology, the causes of criminal acts, criminal motives and criminal acts, and various types of crimes.\nThis course also introduces sociological perspectives, focusing on observing and understanding society from personal experience and applying sociological perspectives, and introducing sociological thinking and important concepts.\nThis course aims to analyze various criminal acts and social phenomena from the discussion of topics, to cultivate students' independent thinking ability, and then to establish a personal foundation in the sociology of crime, to interpret all aspects of society, to promote cross-field innovation, to keep pace with the times, and to move towards the world.\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習犯罪理論與犯罪學學派發展，啟蒙學生跨域學習潛能，瞭解國際間各國犯罪趨勢與成因",
      "describe_en": "Study crime theory and the development of criminology schools, enlighten students' potential for cross-domain learning, and understand the trends and causes of crime in various countries around the world"
    },
    {
      "seq": 2,
      "describe_ch": "社會學導論將探索抽象概念與現實生活之間的連結，藉此理解個人、群體與社會的交織關係，透視人們不以為意的日常表象，反思各類紛擾議題背後的脈絡癥結",
      "describe_en": "Introduction to Sociology to explore the connection between abstract concepts and real life in order to understand the intertwined relationship between individuals, groups and society, to see through the undesirable daily appearances, and to reflect on the crux behind various troubled issues"
    }
  ],
