  "description": {
    "sub_id3": null,
    "sub_name": "個體經濟學",
    "sub_ename": "MICROECONOMICS",
    "describe_ch": "本課程主要探討消費者與生產者行為，以及在各種市場結構下、消費者與生產者的決策合起來如何決定資源的配置。",
    "describe_eh": "This course attempts to explore the optimal consumption decision and production decision.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "讓學生能瞭解並說明經濟循環周流圖的概念，及消費部門與生產部門在市場上的相互關係",
      "describe_en": "To equip students with knowledge of  circular-flow diagram and the interrelationship between the consuming and producing sectors in the markets."
    },
    {
      "seq": 2,
      "describe_ch": "讓學生理解消費者如何在預算限制條件下，進行最適選擇。",
      "describe_en": "To equip students with knowledge of how (consumers) make optimal choices under constraints."
    },
    {
      "seq": 3,
      "describe_ch": "讓學生理解政府政策與廠商策略如何影響消費者的最適選擇。",
      "describe_en": "To realize how government policies and firms' strategies affect consumers' optimal choices."
    },
    {
      "seq": 4,
      "describe_ch": "讓學生理解如何由個別的決策推導出市場需求。",
      "describe_en": "To grasp how market demand is derived from individual decision-making."
    }
  ],
