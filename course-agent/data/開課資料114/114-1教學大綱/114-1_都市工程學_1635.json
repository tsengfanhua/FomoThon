  "description": {
    "sub_id3": null,
    "sub_name": "都市工程學",
    "sub_ename": "URBAN ENGINEERING",
    "describe_ch": "本課程介紹都市內之公共建設及其他工程詳說設計重點及施工特殊工法，諸如道路工程、給水管線工程、污水工程、垃圾處理、空氣污染及噪音管制、水再利用之二元供水、綠建築等，並就都市中建造工法與其他地區作比較，以了解都市工程之特殊性。",
    "describe_eh": "This course introduces the design and special construction methods of the public construction and general engineering in cities, such as road engineering, water supply pipelines, treatment of waste water, engineering and management of solid wastes, control of air pollution, water reuse, and green architecture.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能分析都市建設之公用設備與維生系統之配置",
      "describe_en": "Analysis of public utilities and life support system for urban construction."
    },
    {
      "seq": 2,
      "describe_ch": "能應用都市工程於永續都市規劃設計",
      "describe_en": "Application of urban engineering to sustainable urban planning and design."
    }
  ],
