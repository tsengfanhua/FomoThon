  "description": {
    "sub_id3": null,
    "sub_name": "金融倫理",
    "sub_ename": "FINANCIAL ETHICS",
    "describe_ch": "課程闡述金融倫理中之新興領域之各重要議題，從華爾街金融醜聞開篇開始，對金融倫理學的必要性、金融服務行業的倫理問題、投資倫理、金融市場倫理、公司金融倫理等相關主題有所了解。",
    "describe_eh": "Course expound finance ethic in burgeoning domain for important topic, start from Wall Street finance scandal introduction, ethics' essentiality is to finance, finance service trade's ethic problem, investment ethic, financial market ethic, and company finance ethic.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用專業知識來解決企業與家庭風險管理與保險的問題",
      "describe_en": "To apply the professional knowledge to solve the problems related to the risk management and insurance in enterprise and household"
    },
    {
      "seq": 2,
      "describe_ch": "學生能理解職業倫理與社會責任",
      "describe_en": "Comprehension for the business ethics and realizing their responsibility in society"
    }
