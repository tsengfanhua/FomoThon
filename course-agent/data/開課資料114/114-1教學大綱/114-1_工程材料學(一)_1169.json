  "description": {
    "sub_id3": null,
    "sub_name": "工程材料學(一)",
    "sub_ename": "ENGINEERING MATERIALS(1)",
    "describe_ch": " 從材料學的理論基礎開始，例如金屬的結晶構造、平衡圖、差排、強化機構等，先建立清晰的觀念；接著介紹各種材料，如碳鋼、合金鋼、鑄鐵、鎂合金、鋁合金、陶瓷、聚合體及複合材料等，以了解其各種機械性質、特徵、規範及用途。此外，並搭配各種機械性質與金相顯微組織實驗課程之進行。",
    "describe_eh": "Starting from the introduction of theory of material engineering,  for example: crystalline structure of metal, equilibrium diagram, dislocation, strengthen mechanism etc., in order to establish clear conception.  Then to introduce the mechanical  property, characteristic, specification, application of carbon steel , alloy steel , cast iron  , aluminum alloy , magnesium alloy , ceramic , polymer , composite materials. Moreover, to accompany with the experiment courses of mechanical properties and metallographic microstructure.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解機械材料在工業的重要性及影響。　",
      "describe_en": "Be able to Comprehend the importance and effects of mechanical material to industry."
    },
    {
      "seq": 2,
      "describe_ch": "能應用相關設備，完成材料性質的相關實驗，並歸納出適當結論。",
      "describe_en": "Be able to apply related equipment to finish an experiment about material property, and draw appropriate conclusions.　\r\n"
    },
    {
      "seq": 3,
      "describe_ch": "分析機械材料的相關資訊、研究及標準，並綜合所獲資訊的適用性。\r\n",
      "describe_en": "Analyze related mechanical material information, research, as well as standards and be able to synthesize the appropriateness of the obtained information.　\r\n"
    }
  ],
