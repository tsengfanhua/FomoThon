  "description": {
    "sub_id3": null,
    "sub_name": "資料分析初探與人工智慧之應用",
    "sub_ename": " FUNDAMENTALS OF DATA ANALYSIS AND APPLICATION OF ARTIFICIAL INTELLIGENCE",
    "describe_ch": "本課程共有三大目標，包含認識資料分析、運輸課題探討、以及人工智慧工具之應用。透過運輸與物流的知識認識運輸資料內容與特性，進而學習相關課題討論，最後利用新興的人工智慧工具找出解決前述問題的方法。透過課程內容可以讓學生了解運輸資料內涵與應用的能力，朝向永續發展目標的第11項邁進。",
    "describe_eh": "This course has three main objectives, which include understanding transportation data, exploring transportation issues, and applying artificial intelligence tools. Through the knowledge of transportation and logistics, students will understand the content and characteristics of transportation data, then learn to define and discuss related issues, and finally use emerging artificial intelligence tools to find solutions to these problems. Through the course content, students can understand the connotation and application ability of transportation data, and move towards the 11th of sustainable development goal.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "教授相關先進科技與技術於運輸或物流領域之應用潛力與案例",
      "describe_en": "Teach the application potential and cases of advanced technology and technology in transportation or logistics field"
    },
    {
      "seq": 2,
      "describe_ch": "培養學生運用資料調查、數據分析或數學模型分析運輸或物流問題之能力",
      "describe_en": "To develop students' ability to analyze transportation and logistics problem using data investigation, data analysis or mathematical models."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生獨立或透過團隊合作解決專業問題之能力",
      "describe_en": "To develop students' ability to solve professional problems independently or through teamwork."
    }
  ],
