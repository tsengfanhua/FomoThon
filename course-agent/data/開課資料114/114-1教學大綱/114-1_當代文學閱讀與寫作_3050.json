    "scr_dup": "001",
    "tpb_seq": 1,
    "tpb_book": "<table cellspacing=\"0\" style=\"border-collapse:collapse; width:1267px\">\n\t<tbody>\n\t\t<tr>\n\t\t\t<td style=\"border-bottom:2px; border-left:5px; border-right:5px; border-top:2px; width:693px\">\n\t\t\t<div><strong>教科書及參考書籍</strong></div>\n\n\t\t\t<div>教科書及參考書籍</div>\n\n\t\t\t<div>《耕雲的手－散文的理論與創作》林錫嘉&nbsp; 金文書局</div>\n\n\t\t\t<div>《中國現代散文史稿》 林非&nbsp; 北京新華書店</div>\n\n\t\t\t<div>《現代散文縱橫論》鄭明娳 長安書局</div>\n\n\t\t\t<div>《現代散文類型論》鄭明娳 大安書局</div>\n\n\t\t\t<div>《現代散文構成論》鄭明娳 大安書局</div>\n\n\t\t\t<div>《現代散文現象論》鄭明娳 大安書局</div>\n\n\t\t\t<div>《台灣當代散文綜論》徐學廈大出版社</div>\n\n\t\t\t<div>《中國現當代散文研究》佘樹森&nbsp; 北大出版社</div>\n\n\t\t\t<div>《中國現代散文史》范培松&nbsp; 江蘇教育</div>\n\n\t\t\t<div>《五十年來台灣女性散文．選文篇》張瑞芬 麥田</div>\n\n\t\t\t<div>《五十年來台灣女性散文．評論篇》張瑞芬 麥田</div>\n\n\t\t\t<div>《臺灣當代女性散文史論》張瑞芬 麥田</div>\n\n\t\t\t<div>《狩獵月光－當代文學與散文論評》張瑞芬 聯合文學</div>\n\n\t\t\t<div>《華文文學百年選&bull;台灣卷》鍾怡雯編&nbsp;&nbsp; 九歌</div>\n\t\t\t</td>\n\t\t</tr>\n\t</tbody>\n</table>\n",
    "tpb_book_en": null
  },
