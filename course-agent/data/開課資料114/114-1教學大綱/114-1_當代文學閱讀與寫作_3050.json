  "description": {
    "sub_id3": null,
    "sub_name": "當代文學閱讀與寫作",
    "sub_ename": "MODERN LITERATURE READING AND WRITING",
    "describe_ch": "本課程旨在幫助非人文科系學生建立閱讀、思考與寫作習慣。課程重點有五：（一）培養非人文科系學生對文學的正確概念（二）現代文學史與台灣當代文本概念（三）閱讀、創作與研究並重的讀書方法（四）大量介紹新書資訊與文學訊息（五）小組讀書會、讀書筆記與課堂討論的實務操作",
    "describe_eh": "The aim of this lessen focuses on assisting non-literal college students in setting up habits of Chinese reading, thinking and writing.?In reaching this goal, we have five steps:\r\n(1) nurturing the corrective literature concepts in non-literal college students, (2) stressing contemporary literature history and Taiwanese contemporary literature concept, (3) reading, creation and research balanced reading methodology, (4) informing new publication and literature message offering and (5) establishing reading club, reading notes and discussion workshop.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解文學資訊並增加閱讀基礎",
      "describe_en": "Understand literature information and encouraging reading"
    },
    {
      "seq": 2,
      "describe_ch": "運用寫作流暢文章的能力",
      "describe_en": "Cultivate the ability to write a fluent and quite understandable essay"
    }
  ],
