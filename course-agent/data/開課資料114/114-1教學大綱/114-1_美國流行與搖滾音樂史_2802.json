    "scr_dup": "001",
    "tpa_score_new": "<p style=\"text-align:justify\"><span style=\"text-justify:inter-ideograph\"><span style=\"layout-grid-mode:char\"><span style=\"text-autospace:none\"><b>Assessment:</b></span></span></span></p>\n\n<p style=\"text-align:justify\"><span style=\"text-justify:inter-ideograph\">Participation: 15%</span></p>\n\n<p style=\"text-align:justify\"><span style=\"text-justify:inter-ideograph\">Quizzes (x4): 20%</span></p>\n\n<p style=\"text-align:justify\"><span style=\"text-justify:inter-ideograph\">Midterm: 10%</span></p>\n\n<p style=\"text-align:justify\"><span style=\"text-justify:inter-ideograph\">Final: 15%</span></p>\n\n<p style=\"text-align:justify\"><span style=\"text-justify:inter-ideograph\">Presentation: 20%</span></p>\n\n<p style=\"text-align:justify\"><span style=\"text-justify:inter-ideograph\">Field Report: 20%</span></p>\n\n<p style=\"text-align:justify\">&nbsp;</p>\n",
    "tpa_score_new_en": null,
    "course_pol": "Students should complete all listening and reading assignments before class. Students who miss a quiz must schedule a make-up time and complete the quiz (or equivalent assignment) within 10 days. A missing midterm or final may be made up the week after providing the student had sufficient reason for missing the original date.\nField report assignment requires attending two live performances during the calendar year in which the class takes place with proof of attendance.",
    "course_pol_en": "Students should complete all listening and reading assignments before class. Students who miss a second quiz must schedule a make-up time and complete the quiz (or equivalent assignment) within 10 days. A missing midterm or final may be made up the week after providing the student had sufficient reason for missing the original date.\nField report assignment requires attending two live performances during the calendar year in which the class takes place with proof of attendance.",
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<div>Students are expected to complete their own work and provide citations as needed (no restriction on formatting). Violations of academic integrity will be judged on a case-by-case basis. A first violation will generally result in a 0 on the assignment, a second violation with a harsher penalty, and a third violation will generally result in a 0 in the course.&nbsp;</div>\n",
    "ais_meno_en": "<div>Students are expected to complete all of&nbsp;their own work and provide citations as needed (no restriction on formatting). Violations of academic integrity will be judged on a case-by-case basis. A first violation will generally result in a 0 on the assignment, a second violation with a harsher penalty, and a third violation will generally result in a 0 in the course.&nbsp;</div>\n",
    "ilearn_mk": "N"
  },
