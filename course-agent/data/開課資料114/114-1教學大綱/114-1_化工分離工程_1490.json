  "description": {
    "sub_id3": null,
    "sub_name": "化工分離工程",
    "sub_ename": "SEPARATION TECHNOLOGY IN CHEMICAL ENGINEERING",
    "describe_ch": "本課程涵蓋設計分離程序所應用的質能平衡，相平衡和流體輸送現象。各種的分離程序，特別是在製程工業，乾淨科技和生物技術的範例將被介紹給學生來闡述主要觀念和課堂討論。在修完本課程，學生將可以學得針對特定工業分離問題找出適當的程序和解答。",
    "describe_eh": "The course comprises fundamentals such as mass and energy balances, phase equilibria and transport kinetics applied in design of separation processes. A wide variety of separation processes will be introduced; in particular, examples from process industry, clean technology, biotechnology will be given to students to illustrate key concepts and broaden discussion in class. The students will get insight into the considerations that have to be balanced in finding a suitable solution to a specific separation problem.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備各種化工分離程序如蒸餾，博膜分離，吸附等的基本知識和觀念",
      "describe_en": "Understand key concepts of various separation processes including distillation, membrane separation, and adsorption, etc."
    },
    {
      "seq": 2,
      "describe_ch": "具備選擇適當分離方法及應用到特定化工程序的能力",
      "describe_en": "Ability to choose a separation process and apply to specific chemical process"
    },
    {
      "seq": 3,
      "describe_ch": "培養學生具化學工業的宏觀視野與自我要求負責的態度",
      "describe_en": "Develop students with a global perspective in chemical industry and attitude of self-responsibility"
    }
  ],
