  "description": {
    "sub_id3": null,
    "sub_name": "室內設計(三)",
    "sub_ename": "INTERIOR DESIGN (3)",
    "describe_ch": "藉由室內設計的進階課程，使學生對環境、建築、室內、景觀等場所特質、事件意義、及議題有更進階的研究、認識與運用。本課程的設計將以發掘環境設計議題為課程主軸，可以組隊與個別創作。逐步導入的設計操作包括1)議題文本，2)基地文本，3)設計文本，4)圖說文本；藉由每週的實際操作訓練與範例討論，將設計經由議題批判性延伸至基地選擇及分析，案例分析及設計理論與操作，至圖面表現、模型製作、3D模擬、至工程與實務融合為一之施工圖訓練。",
    "describe_eh": "This is a class for advanced studies of Interior Design. By way of workshop training, students will involve in a professional environment and concentrate in construction process as well. There are four main sections for the intensive training.1) Issues， 2)Site， 3)Design，4)Presentation； Students will learn to organize several teams to process a competition. During the section, students need to argue the issues，understand the project contents as well as to practice the design skills. Each student will take the project into a detail development as a modeling study and 3D animation. During the period of time, there are professional craftsmen will be introduced into this class in order to process these projects as real.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 5.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "引導學生關心社會現象、人文歷史、國際趨勢及當代議題，全方位思考空間與環境之議題。",
      "describe_en": "Discussing the issues between architecture and environment, including the social phenomenon, local culture and history, globalization and contemporary manifestation."
    },
    {
      "seq": 2,
      "describe_ch": "訓練報告書寫作、圖說表現法、模型製作、多媒體運用及實物操作等，培養完整的建築作品表達能力。",
      "describe_en": "Establish the ability of presentation, including the program, drawings, model making, multimedia, and oral explanation."
    }
  ],
