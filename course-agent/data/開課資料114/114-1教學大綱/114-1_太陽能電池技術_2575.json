  "description": {
    "sub_id3": null,
    "sub_name": "太陽能電池技術",
    "sub_ename": "SOLAR CELL TECHNOLOGY",
    "describe_ch": "本課程乃是針對太陽光與太陽能電池等相關背景知識進行說明，並熟悉能源危機與溫室效應問題。除了參考目前相關國內外太陽能電池之現況發展外，也深入針對不同類型的太陽能電池相關演進與未來展望加以闡述。本課程除了透過課堂講授外，也將透過「課堂上分組報告」方式，將所獲得太陽能相關資訊與同儕及教師報告，進而展現小組團隊合作之能力。",
    "describe_eh": "This course aims to explain the background knowledge of sunlight and solar cells and is familiar with the energy crisis and the greenhouse effect. In addition to referring to the current status and development of relevant domestic and foreign solar cells, it also elaborates on the relevant evolution and prospects of different solar cells. In addition to lectures in class, this course will also report on the solar energy-related information obtained with peers and teachers through the method of \"group report in class\" to demonstrate the ability of teamwork.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解本學科之基礎原理，並熟悉能源危機與溫室效應問題。",
      "describe_en": "Comprehension for the fundamental aspects of this subject and to be familiar with energy crisis and greenhouse effect."
    },
    {
      "seq": 2,
      "describe_ch": "說明太陽能電池之發展沿革及最新動態，並提出太陽能電池之應用層面，已密切結合於吾人生活文化與工業活動。",
      "describe_en": "Explanation for the historical developments and technological frontiers of the photovoltaic cells; and bring the applications of photovoltaic cells are associated with our daily life and industrial activities."
    },
    {
      "seq": 3,
      "describe_ch": "分析本學科領域之相關技術並比較各種太陽能電池的基本原理及其研判能力。",
      "describe_en": "Analysis for the basic technology of the course and comparison for    the principle of various photovoltaic cells and their professional judgments."
    }
  ],
