  "description": {
    "sub_id3": null,
    "sub_name": "鋰離子電池",
    "sub_ename": "LITHIUM ION BATTERIES",
    "describe_ch": "本課程目的為學習並熟悉鋰離子電池之設計原理與製程技術。課程內容注重在基本電化學儲能原理與機制、鋰離子電池設計方法、正極(陰極)材料、陽極材料、電解質材料、集流板材料、電池元件分析方法。本課程除了透過課堂講授外，也將透過輔助相關教材來加速學生學習。",
    "describe_eh": "This course aims to learn and be familiar with the design principles and process technology of lithium-ion batteries. The course content focuses on basic electrochemical energy storage principles and mechanisms, lithium-ion battery design methods, cathode (cathode) materials, anode materials, electrolyte materials, current collector materials, and battery component analysis methods. In addition to teaching in class, this course will also speed up student learning through supplementary related teaching materials.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解鋰離子電池之設計原理",
      "describe_en": "Being familiar with the design principles of lithium ion batteries."
    },
    {
      "seq": 2,
      "describe_ch": "說明現代鋰離子電池產業結構，得以熟習其材料選用與分析技術",
      "describe_en": "Understanding the industrial structure of lithium ion batteries and being familiar with its materials selection and analysis techniques."
    },
    {
      "seq": 3,
      "describe_ch": "訓練學生應用材料及數學知識分析鋰離子電池元件\t",
      "describe_en": "Training the skills of applying materials and mathematics knowledge to analyze lithium ion battery devices."
    },
    {
      "seq": 4,
      "describe_ch": "理解鋰離子電池之材料、製程與設計原理。\t",
      "describe_en": "Training the skills of literature review and survey for lithium ion battery related reports and information."
    }
  ],
