  "description": {
    "sub_id3": null,
    "sub_name": "纖維物理(一)",
    "sub_ename": "FIBER PHYSICS(1)",
    "describe_ch": "使學生瞭解纖維物理及高分子領域中相關化學與物理的基本概念，數學模型的建立、公式推導與計算以及在工業上之應用。其內容主要包括纖維型態學、結晶學、固體力學、彈性力學、粘彈力學。",
    "describe_eh": "Enable students to understand the basic concepts of the relevant chemical and physical properties, mathematic modeling and formula derivation and calculation as well as industrial applications in the field of fiber physics and polymer, including fiber morphology, crystallography, solid mechanism, elastic mechanism, viscoelastic mechanism.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解纖維物理及高分子領域中相關物理與化學的基本概念。",
      "describe_en": " Comprehension for the basic concept of physics and chemistry properties in the field of fiber physics and polymer."
    },
    {
      "seq": 2,
      "describe_ch": "理解數學模型的建立、公式推導與計算。",
      "describe_en": " Comprehension for mathematic modeling and formula derivation and calculation."
    },
    {
      "seq": 3,
      "describe_ch": "理解纖維物理領域在工業上之應用",
      "describe_en": " Comprehension for fiber physics in  industrial applications.\t"
    },
    {
      "seq": 4,
      "describe_ch": "認知專業與道德責任之能力，具備自我要求、負責之態度。",
      "describe_en": "Be able to know moral and technical Issues. Be responsible and self behaved."
    }
  ],
