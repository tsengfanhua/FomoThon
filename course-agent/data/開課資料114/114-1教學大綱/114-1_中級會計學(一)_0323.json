  "description": {
    "sub_id3": null,
    "sub_name": "中級會計學(一)",
    "sub_ename": "INTERMEDIATE ACCOUNTING(1)",
    "describe_ch": "本課程結合會計理論的發展，學習會計處理和報導過程，主要內容包括：會計觀念及程序、資產評價、負債、業主權益、損益衡量、退休金會計、租賃會計、所得稅會計、現金流量表、每股盈餘、財務報告及分析等。",
    "describe_eh": "This course is a study of the accounting process and the reporting process in conjunction with the development of accounting theory. Topics covered include the review of accounting concepts and procedures, valuation of assets, liabilities, owners' equity, income measurement, accounting for pension, leasing and income tax, statement of cash flow, EPS, financial report and analysis.",
    "pre_subname": "ACCT1011會計學(一)、ACCT1012會計學(二)",
    "pre_sub_id3": "ACCT1011",
    "pre_sub_ename": "ACCT1011 ACCOUNTING(1)、ACCT1012 ACCOUNTING(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "預期增進對財務報表之編製與運用的瞭解",
      "describe_en": "It is intended to increase your understanding of the preparation and the usefulness of financial statements."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並運用財務會計於商業會計事務及租稅申報之處理。",
      "describe_en": "Understand and be able to use the finance accounting of handling business accounting affairs and tax reporting."
    }
  ],
