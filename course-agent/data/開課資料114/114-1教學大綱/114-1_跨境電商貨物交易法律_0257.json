  "description": {
    "sub_id3": null,
    "sub_name": "跨境電商貨物交易法律",
    "sub_ename": "SALE OF GOODS ON BUSINESS LAW IN CROSS-BORDER E-COMMERCE",
    "describe_ch": "介紹跨境電商之基本概念及種類，主要就企業在跨境貨物交易型態中，所涉及之租稅法(國際稅法、關稅法、所得稅法、營業稅法)、民法及商事法等相關爭議問題進行說明，藉由實務案例分析，瞭解法律之正確適用。",
    "describe_eh": "This course will offer an introduction to the concept and types of Cross-Border E-Commerce. It focuses on electronic transactions of goods, addressing issues relating to tax law (including international tax law, the Customs Act, the Income Tax Act and the VAT Act), civil law and commercial law. Students will read relative court cases that will help them better understand legal issues in the Cross-Border E-Commerce. Students taking this course will gain skills of finding the applicable laws and regulations and of applying the laws and regulations to specific factual matters.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解跨境電子商務之基本架構，以及跨境電子勞務交易之行為態樣。",
      "describe_en": "To understand the basic structure of Cross-Border E-Commerce and the behavior of electronic transactions of goods."
    },
    {
      "seq": 2,
      "describe_ch": "能理解跨境電子貨物交易所生之各種法律爭議問題。",
      "describe_en": "To understand all the legal issues in electronic transactions of goods."
    },
    {
      "seq": 3,
      "describe_ch": "能分析跨境電子貨物交易之相關案例，並正確解釋應適用之法令於個案中。",
      "describe_en": "To analyze the related cases, to find the laws, and interpret those correctly."
    }
  ],
