  "description": {
    "sub_id3": null,
    "sub_name": "社群媒體行銷專題",
    "sub_ename": "SOCIAL MEDIA MARKETING CASE STUDY",
    "describe_ch": "因應社會行銷媒介快速變遷，生動與多樣地創造特定的訊息或內容來吸引注意，已引起國內外消費者的討論，並鼓勵消費者透過其個人的社會網路去傳播散布這些行銷內容，並進而提升與客戶的關係與滿意度及增進銷售額度的行銷策略，已成為媒體行銷的顯學。\r\n1.\t網路新經濟體系的介紹\r\n2.\t新興網路媒介的特性及行銷力的介紹\r\n3.\t數位及社群行銷個案討論\r\n4.\t既有社群行銷平台或工具的介紹\r\n5.\t數位行銷方及work shop\r\n",
    "describe_eh": "1.Introduction to the new network economy\r\n2. Introduction to the characteristics and marketing power of emerging online media\r\n3. Digital and community marketing case discussions\r\n4. Introduction to existing social marketing platforms or tools\r\n5. Digital marketing plan and work shop\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "讓學生了解能應用網路行銷的工具，增加商品銷售量。",
      "describe_en": "Let students understand the social media tools that can apply online marketing and increase the sales volume of goods."
    }
  ],
