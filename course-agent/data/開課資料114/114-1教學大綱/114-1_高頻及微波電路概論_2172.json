  "description": {
    "sub_id3": null,
    "sub_name": "高頻及微波電路概論",
    "sub_ename": "INTRODUCTION TO RADIO FREQUENCY AND MICROWAVE CIRCUIT",
    "describe_ch": "高頻及微波電路概論課程是針對高頻,超高頻,極高頻及微波通訊系統中之射頻放大器,超外差接收機,發射電路,相位鎖定迴路,傳輸線,微波震盪器,導波管及微波天線等電路加以講解及進行基本之電路分析",
    "describe_eh": "The purpose of introduction to radio frequency and microwave circuit is focused to describe and analyze the circuit of the high frequency, super high frequency, ultra high frequency and microwave communication systems, which includes radio frequency amplifier, super heterodyne receiver, transmitter circuit, phase-Locked loop, transmission line, microwave oscillator, microwave tube and microwave antenna.",
    "pre_subname": "IECS2002電子學",
    "pre_sub_id3": "IECS2002",
    "pre_sub_ename": "IECS2002 ELECTRONICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能具備高頻及微波電路的基本知識。",
      "describe_en": "Be able to obtain basic knowledge about radio frequency and microwave circuits."
    },
    {
      "seq": 2,
      "describe_ch": "能運用模擬軟體進行高頻及微波電路的分析。",
      "describe_en": "Be able to use simulation tool to analyze radio frequency and microwave circuits."
    }
  ],
