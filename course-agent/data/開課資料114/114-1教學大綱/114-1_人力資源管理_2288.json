  "description": {
    "sub_id3": null,
    "sub_name": "人力資源管理",
    "sub_ename": "HUMAN RESOURCES MANAGEMENT",
    "describe_ch": "本課程旨在探討有效運用人力資源達成組織目標的各種管理活動與管理實務，以增進人力資源對組織及企業的貢獻，使學生能瞭解人力資源管理之理論、原則與實務，並以具體的企業實例個案研討，訓練學生應用有效管理組織人力資源之能力。",
    "describe_eh": "This course aims at the process of effective management of human resource to pursuit the organizational goals and an analysis of those elements essential to such a process. Theories, principles, and practices of the human resource management are included. The practical cases discussions will be covered to enable the students' abilities to effectively manage the human resource in the organization.",
    "pre_subname": "MGT1001管理學",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠發展合於規範的判斷力及倫理道德的觀念。此外，在人事管理上能做出合於倫理道德的決定。最終能夠倡導倫理道德及公平正義的價值並履行社會責任。\r\n\r\n",
      "describe_en": "To be able to develop the normative judgments and morality.  In addition, be able to make ethical decisions in the process of managing employees.  Moreover, be able to utilize methods to promote the values of ethics and fair treatment and fulfill the soci"
    },
    {
      "seq": 2,
      "describe_ch": "能了解領導的意涵並能夠激勵他人及傳達理念，最終更能夠影響他人，進而達成目標。",
      "describe_en": "To be able to understand the concepts of leadership.  In addition, be able to motivate and communicate the vision with others and, moreover, to influence a group to achieve the goals."
    }
  ],
