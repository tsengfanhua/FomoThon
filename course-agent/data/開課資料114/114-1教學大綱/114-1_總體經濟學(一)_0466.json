  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB05131",
    "sub_id": "74151",
    "scr_dup": "001",
    "tpa_score_new": "<div>期中考 30%</div>\n\n<div>期末考 40%</div>\n\n<div>平時成績 30%&nbsp;&nbsp;</div>\n\n<div>&nbsp; &nbsp; (含, 出席20%, 作業與小考10%)</div>\n",
    "tpa_score_new_en": null,
    "course_pol": "課堂禮儀\n\n1.準時到課，不遲到、不早退。\n2.尊重授課教師與同學的發言，不隨意插話或打斷。\n3.上課過程中保持專注，不進行與課程無關的活動（如滑手機、聊天）。\n4.維持教室整潔，課後自行清理。\n5.積極參與課堂討論與活動，展現學習態度。",
    "course_pol_en": null,
    "course_rem": null,
    "course_rem_en": null,
    "ais_meno": "<ul>\n\t<li>\n\t<div><strong>在學習評量中</strong></div>\n\n\t<ul>\n\t\t<li>\n\t\t<div>獨立完成考試與作業，不作弊、不抄襲。</div>\n\t\t</li>\n\t\t<li>\n\t\t<div>引用資料時正確標註來源，避免剽竊。</div>\n\t\t</li>\n\t\t<li>\n\t\t<div>誠實呈現自己的理解與成果，不偽造數據。</div>\n\t\t</li>\n\t</ul>\n\t</li>\n\t<li>\n\t<div><strong>在班上互動中</strong></div>\n\n\t<ul>\n\t\t<li>\n\t\t<div>尊重同儕的發言與成果，不抄襲他人作品。</div>\n\t\t</li>\n\t\t<li>\n\t\t<div>小組合作時，積極貢獻，不假借他人成果。</div>\n\t\t</li>\n\t\t<li>\n\t\t<div>保持討論的誠實態度，不隱瞞、不誤導。</div>\n\t\t</li>\n\t</ul>\n\t</li>\n</ul>\n",
    "ais_meno_en": null,
    "ilearn_mk": "N"
  },
