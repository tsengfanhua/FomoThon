  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CM02139",
    "sub_id": "13019",
    "scr_dup": "001",
    "tpa_score_new": "<div>平時作業 30%</div>\n\n<div>期中測驗 30%</div>\n\n<div>期末分組報告 40%</div>\n",
    "tpa_score_new_en": null,
    "course_pol": "課堂規則\n1. 學生有事請假請事先向授課教師報告\n2. 組員應互助合作相互支援相互學習\n3. 鼓勵同學隨時提出問提共同討論\n4. 手機應靜音非必要避免使用不可發出聲響影響其他同儕學習",
    "course_pol_en": null,
    "course_rem": "課程提醒\n鼓勵個人隨時提問\n更鼓勵分組課前討論後於課堂上提問",
    "course_rem_en": null,
    "ais_meno": "<div>學生須遵守以下誠信規則，不應有違反行為：</div>\n\n<div>學生應互助合作、相互學習，</div>\n\n<div>\n<div>課堂有疑問應即提出與教師及同儕互動討論，</div>\n\n<div>期中測驗不可抄襲或其他作弊行為，</div>\n\n<div>期末分組簡報應各自盡力、相互支援，但不可替同儕代做。</div>\n</div>\n",
    "ais_meno_en": null,
    "ilearn_mk": "Y"
  },
