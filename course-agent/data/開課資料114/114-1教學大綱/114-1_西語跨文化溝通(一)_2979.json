  "description": {
    "sub_id3": null,
    "sub_name": "西語跨文化溝通(一)",
    "sub_ename": "SPANISH CULTURAL COMMUNICATION 1",
    "describe_ch": "為了增加西語學習者在日常生活中的溝通能力以及對跨文化差異的敏感度，本課程將透過不同主題性的對話內容，培養學生能善用適當的詞彙與句型於日常生活和職場溝通上;另外，透過不同主題性的文章導讀，不僅可以提升學生的閱讀能力，並能了解中西文化、習俗不同的差異。",
    "describe_eh": "In order to improve students’ communication skills of Spanish and intercultural sensitivity, this course aims to familiarize students with appropriate vocabulary and sentences to communicate in daily life and workplaces through different themes. In addition, this course provides introductions to different topics, with which students not only can improve their reading ability, but also can understand the differences between Chinese and Spanish cultures and customs.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能敢於使用西語參與實際對話的能力。",
      "describe_en": "To be able to use Spanish in a conversation"
    },
    {
      "seq": 2,
      "describe_ch": "了解中西文化、風俗習慣的差異。",
      "describe_en": "To understand the differences between Chinese and Spanish cultures and customs"
    }
  ],
