  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(三)",
    "sub_ename": "SEMINAR(3)",
    "describe_ch": "本課程中會安排校外來賓進行的專題演講，以增廣學生在光電領域方面的視野。此外學生須要進行研究規劃，最後學生須以小組討論英文期刊論文並完成報告。\r\n",
    "describe_eh": "Several professional talks will be arranged to broaden students' perspectives in the field of optics and photonics. Additionally, students are required to conduct research planning. Finally, student need to discuss English journal papers in teams and finish a report.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識當前光電技術。",
      "describe_en": "To know the state-of-the-art techniques of optics and photonics.　"
    },
    {
      "seq": 2,
      "describe_ch": "能夠進行研究規劃。",
      "describe_en": "Be able to conduct research planning.　"
    },
    {
      "seq": 3,
      "describe_ch": "以小組討論論文中的技術。",
      "describe_en": "To discuss the technique presented in papers."
    }
  ],
