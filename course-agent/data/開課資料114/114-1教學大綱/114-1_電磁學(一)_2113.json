  "description": {
    "sub_id3": null,
    "sub_name": "電磁學(一)",
    "sub_ename": "ELECTROMAGNETICS(1)",
    "describe_ch": "本課程主要是講授電磁學的基本觀念，由從向量分析入門，每一章都有方程式作為基本模型，根據這組模型配合向量分析與微積分的技巧，解決實際上電磁學的問題。\r\n",
    "describe_eh": "This course provides some concepts of electromagnetics. In the beginning, it will enter this area from vector analysis. In each chapter, there are some equations as basic models, then according to these models, vector analysis and calculus skills to solve some problems in electromagnetics.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解並說明模型的數學意義",
      "describe_en": "Understand comprehensively and be able to explain the physical meaning about electromagnetic."
    },
    {
      "seq": 2,
      "describe_ch": "能使用相關模型，去應用解決實際問題。",
      "describe_en": "Be able to apply models to practical problems."
    }
