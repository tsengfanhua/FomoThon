  "description": {
    "sub_id3": null,
    "sub_name": "電子學實驗(一)",
    "sub_ename": "ELECTRONICS LAB.(1)",
    "describe_ch": "此課程之目的主要配合電子學(一)課程，輔之以電腦模擬與麵包板實驗驗證，以提高學生學習興趣，厚植其基本概念與理論基礎。",
    "describe_eh": "This course is companioned with the Electronics (1). In addition to breadboard experiments, the computer simulation and verification for electronic circuits will also be adopted in this lab. The objective of this course is to enhance the students' principles and technique kills of microelectronic circuits.",
    "pre_subname": "IEE1006邏輯設計、IEE1000計算機概論(一)、IEE1011普通物理-電、磁、光實驗",
    "pre_sub_id3": "IEE1006",
    "pre_sub_ename": "IEE1006 LOGIC DESIGN、IEE1000 INTRODUCTION TO COMPUTER(1)、IEE1011 GENERAL PHYSICS - ELECTRIC, MAGNETIC, OPTICS LAB.",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 5,
      "describe_ch": "能用自己的專業詞彙定義電子學中，何謂二極體、BJT、MOSFET以及運算放大器能夠描述二極體、BJT、MOSFET以及運算放大器其特性。",
      "describe_en": "Knowledge for understanding and describing the characteristics of Diode, BJT, MOSFET and OP amplifier in Microelectronic Circuits."
    },
    {
      "seq": 6,
      "describe_ch": "能使用相關數學技術，完成一個係有相關於二極體、BJT、MOSFET以及運算放大器正常操作下之電子系統，並由計算中歸納出適當的結論。",
      "describe_en": "Synthesis for being able to use related mathematical techniques to achieve computational algorithms about an electronic system and making appropriate conclusions from solution results."
    }
  ],
