  "description": {
    "sub_id3": null,
    "sub_name": "國際貿易與經營導論",
    "sub_ename": "INTRODUCTION TO INTERNATIONAL TRADE AND BUSINESS",
    "describe_ch": "為導論性課程，擬系統性簡介國貿系兩大課程領域「國際貿易」與「國際經營」，使同學具備在全球經營環境下跨國際貿易與經營之宏觀知識。",
    "describe_eh": "This is an introduction course. The aim of this course is to introduce systematically the two fields of International Trade Department, including international trade and international business. It will help students to be able to have broad knowledge of international trade and international business in a globalized business environment.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
