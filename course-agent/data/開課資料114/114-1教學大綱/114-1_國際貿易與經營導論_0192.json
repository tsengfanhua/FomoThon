    {
      "seq": 1,
      "describe_ch": "具備國際貿易概論知識。",
      "describe_en": "Knowledge of introduction of international trade."
    },
    {
      "seq": 2,
      "describe_ch": "具備國際經營概論知識。",
      "describe_en": "Knowledge of introduction of international business."
