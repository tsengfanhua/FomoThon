  "description": {
    "sub_id3": null,
    "sub_name": "計算機概論(一)",
    "sub_ename": "INTRODUCTION TO COMPUTER(1)",
    "describe_ch": "廣泛地認識電腦科學相關的主題，概述計算機中軟體與硬體相關的基本知識。課程主要為電腦原理的介紹，及使用計算機解決方法論與演譯法的問題。",
    "describe_eh": "The purpose of this course is to let the students know the related topics of Computer Science, and to state the knowledge of software/hardware in Computer Science. The course mainly focuses on the introduction of the Computer Science, and the use of computer to solve the problems of methodology and algorithm.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1介紹計算機相關軟硬體基本術語及觀念，使學生能以專業的詞彙做溝通",
      "describe_en": "1. To introduce the basic technology terms of computer to help students to communicate with professional engineer."
    },
    {
      "seq": 2,
      "describe_ch": "2 使學生瞭解計算機運作原理以及各項影響計算機效能的關鍵技術",
      "describe_en": "2. To teach students to understand computer hardware processing model and know the factors that will influence the performance of computer."
    },
    {
      "seq": 3,
      "describe_ch": "3使學生能瞭解系統軟體在計算機系統運作所扮演的角色，以及相關的操作理念",
      "describe_en": "3. The knowledge about computer system software is introduced to make students to understand the related issues about system operations."
    },
    {
      "seq": 4,
      "describe_ch": "4. 以C及C++語言的介紹為主軸，介紹現代高階語言的語法與程式設計的基本理念",
      "describe_en": "4. By introducing the C and C++ language to introduce the features of modern high-level language."
    },
    {
      "seq": 5,
      "describe_ch": "5. 訓練學生程式設計的邏輯思維，建立日後專業程式撰寫的基礎",
      "describe_en": "5. Training the capability of logic reasoning and building the basics for professional programming."
    },
    {
      "seq": 6,
      "describe_ch": "6. 增進學生以專業的知識思維以解決問題，奠定優良的工程師專業素養",
      "describe_en": "6. To improve students' ability for professional thinking and to establish good features to be a good engineer."
    }
  ],
