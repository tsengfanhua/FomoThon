  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "創新永續綠色科技",
    "sub_ename": "INNOVATIVE AND SUSTAINABLE GREEN TECHNOLOGY",
    "describe_ch": "課程由氣候變遷議題帶出淨零排放、社會責任、循環經濟之概念，再從科技農業帶到友善環境；再生能源帶出能源轉型議題，接回永續循環共享及再生能源落實案例，反思創新永續綠色科技。本課程注重學生透過課堂互動與課後心得反思課堂內容，發現新價值；並於期中與期末以學生帶領教案方式翻轉教學，透過分組強化團隊合作學習模式。",
    "describe_eh": "The course brings out the concepts of net zero emissions, social responsibility, and circular economy from the issue of climate change, and then from technology agriculture to a friendly environment. Renewable energy brings out the issue of energy transition, and extends to the sustainable cycle sharing and renewable energy implementation cases, reflecting on innovation Sustainable green technology. This course focuses on students’ reflecting on classroom content and discovering new values through classroom interaction and after-class experience. In the mid-term and end-of-term, students lead lesson plans to flip the teaching, and strengthen the teamwork learning mode through grouping.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "協助學生了解綠色科技與永續循環概念",
      "describe_en": "To help students understand the concept of green technology and sustainable recycling"
    },
    {
      "seq": 2,
      "describe_ch": "帶領學生反思綠色科技與永續循環，發現新價值",
      "describe_en": "Lead students to reflect on green technology and sustainable cycles and discover new values"
    }
  ],
