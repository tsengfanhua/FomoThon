  "description": {
    "sub_id3": null,
    "sub_name": "磁性材料學",
    "sub_ename": "MAGNETIC MATERIALS",
    "describe_ch": "本課程包含基礎磁學、實用磁性材料學、及其他特殊磁性材料等三大部份，為實用材料科學。基礎磁學的內容計有：磁學名詞與單位互換、測磁技術、五大磁學及磁學現象學等。實用磁性材料則包含永磁材料學、軟磁材料學、磁記錄材料學等。其他特殊材料則包含磁光、磁阻、磁伸縮、及超導體等材料及其原理。此課程為以課堂講授搭配hands-on作業的應用學科，課程實施將側重於學理原理與方法論。",
    "describe_eh": "The course「Magnetic Materials」includes three major parts: Basic Magnetism, Practical Magnetic Materials, and Novel Magnetic Materials. This is a practical course in the Materials Science and Engineering. The first part Basic Magnetism contains various topics of magnetic units and magnetic measurements, kinds of magnetism, and magnetic phenomena. The second part Practical Magnetic Materials includes hard magnetic materials, soft magnetic materials, and magnetic recording materials. In the last part Novel Magnetic Materials, several special materials will be studied, such as magneto-optical recording, magneto-resistance, magneto-striction, and superconductivity, etc. This course combines theoretical lecturing and hands-on homework, emphasizing the principles and methodologies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂磁性材料學：使大學部同學研習常見的磁性材料、磁性元件、並研讀其磁學原理。",
      "describe_en": "To define \"magnetic materials\" with students' own words: providing   the possibility to acquire the knowledge of magnetism, magnetic materials and devices."
    },
    {
      "seq": 2,
      "describe_ch": "能使用相關設備，完成一量測材料磁性質的相關實驗，並由實驗中歸納出適當結論。",
      "describe_en": "Be able to draw reasonable conclusions from an experiment by measuring magnetic properties of materials."
    },
    {
      "seq": 3,
      "describe_ch": "知道於何處可找到磁性材料學的相關資訊、研究結果及標準，並可評估所獲資訊的適用性。",
      "describe_en": "To learning how to locate and access information－especially related to magnetic material properties & specifications, and be able to evaluate the appropriateness of the obtained information."
    }
  ],
