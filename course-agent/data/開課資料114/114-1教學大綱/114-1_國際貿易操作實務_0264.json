  "description": {
    "sub_id3": null,
    "sub_name": "國際貿易操作實務",
    "sub_ename": "OPERATION AND PRACTICE OF INTERNATIONAL TRADE",
    "describe_ch": "課程包含1. 國際貿易操作前置作業：國際貿易公司申請與成立準備2. 國際貿易操作程序與知識：相關公約、規則、慣例瞭解，國貿契約與運輸知識3.國際貿易重要單據操作實務：進出口價格計算、信用狀開立與檢核、貿易單證開立。",
    "describe_eh": "This course includes three major themes: 1. Preparation works for international trade; 2. Operational process and knowledge of international trade: understanding of related trade terms, uniform customs and practices of international trade, terms of transaction in trade contracts, knowledge of international transportation ; 3. Operation of important documents in international trade process, e.g. L/C, Invoice, bill of exchange .",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具備基礎國際貿易操作知識與能力",
      "describe_en": "The ability and knowledge of the operation of international trade practice"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解國貿易實務基本專業英文用語",
      "describe_en": "The knowledge of basic professional English terms in international trade practice."
    }
