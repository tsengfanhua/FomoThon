  "description": {
    "sub_id3": null,
    "sub_name": "航空攝影及遙感測量",
    "sub_ename": "ARIAL PHOTOGRAPHY AND REMOTE SENSING SURVEY",
    "describe_ch": "本課程並重理論與實務，透過課程介紹及操作實習，使學生瞭解攝影測量與遙感測量的優勢及限制，以及如何應用於都市計畫和國土監測等相關議題。",
    "describe_eh": "This course emphasizes both the theory and practice. Students will understand the advantage and restriction of aerial photogrammetry and remote sensing through the course introduction and computer operation. Furthermore, students will also know how to apply aerial photogrammetry and remote sensing to the issues concerning urban plan and land monitoring.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 4,
      "describe_ch": "能理解航空攝影與遙感測量的基本原理及限制",
      "describe_en": "Comprehension for the basic theory and restriction of aerial photogrammetry and remote sensing.\r\n"
    },
    {
      "seq": 5,
      "describe_ch": "能分析各種國土規劃保育的相關議題，以及了解如何利用航空攝影與遙感測量對環境資訊進行蒐集、處理、顯示、管理與應用。",
      "describe_en": "Analysis for various issues concerning land planning and conservation and know how to use aerial photogrammetry and remote sensing to collect, process, display, manage and apply the environmental information. \r\n"
    },
    {
      "seq": 6,
      "describe_ch": "能獲得小組團隊合作的能力",
      "describe_en": "Synthesis for esprit de corps (team spirit) through teamwork. \r\n"
    }
  ],
