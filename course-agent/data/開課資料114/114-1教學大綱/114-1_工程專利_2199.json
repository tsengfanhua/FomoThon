  "description": {
    "sub_id3": null,
    "sub_name": "工程專利",
    "sub_ename": "PATENT PRACTICE FOR ENGINEERS",
    "describe_ch": "本課程透過專利的意義、專利的特色、專利制度簡介、專利申請、以及專利核准要件之介紹，期望學生能夠充分理解專利對於國家科技發展之重要性，同時也期望學生能夠初步理解專利制度與申請流程外，更期望與會者能夠經由此實務課程由淺入深的講解而獲得日後科技之技術啟發。",
    "describe_eh": "This course focuses on the intellectual properties for engineers, through the meaning of patents, patent characteristics, patent system introduction, patent application, and introduction of patent approval requirements. Students are expected to fully understand the importance of patents for the development of technologies. Students will have a preliminary understanding of China's patent system and application process; in the end, it is even more hoped that participants will be able to gain future technology inspiration through explanations in this practical course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生認識專利權與專利申請之實務關係。",
      "describe_en": "To make students be aware of the relationship between patent rights and patent application."
    },
    {
      "seq": 2,
      "describe_ch": "使學生具備應用技術分析工具、專利檢索軟體、專利地圖等方法，探討科技專利佈局策略的能力。",
      "describe_en": "To educate students with the ability to apply technology analysis tools, patent search software, patent maps, etc., and explore strategies for the layout of  technology patents."
    }
  ],
