  "description": {
    "sub_id3": null,
    "sub_name": "電磁相容導論",
    "sub_ename": "INTRODUCTION TO ELECTROMAGNETIC COMPATIBILITY",
    "describe_ch": "配合當前的科技發展趨勢來介紹目前EMC最新標準發展與法規現況(如有關IC的EMC設計技術與驗證)、高速數位電路之SI與EMC基本原理、EMC測試方法、雜訊偵測與除錯技術，以及包括屏蔽技術、電路佈線原理、PCB設計技術等技術設計等，將可提供學生對產業界EMC設計技術與標準測試有一初步且系統性的了解。",
    "describe_eh": "Following the trend of technology advancement, this course intends to introduce current development of EMC regulations (eg. EMC design techniques and verification for IC, etc), SI and EMC fundamentals for high-speed digital circuit, EMI diagnosis and countermeasure, shielding techniques, PCB layout and routing. This course will provide students with fundamental and systematic coverage for EMS design and testing techniques.",
    "pre_subname": "COME4001電磁波、COME2010電磁學(一)",
    "pre_sub_id3": "COME4001",
    "pre_sub_ename": "COME4001 ELECTROMAGNETIC WAVE、COME2010 ELECTROMAGNETICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的詞彙定義何謂電磁干擾：能夠描述重要的電磁干擾因素及其特性；能夠描述影響電磁干擾對電器產品及環境的重要影響因素，能瞭解並說明電磁干擾在目前的科技產業、社會生活及經濟層面的重要性及影響",
      "describe_en": "Define EMI with their own words: Be able to describe important EMI constitutes and their characteristics; be able to describe important environmental factors impacted by EMI phenomena. Understand and be able to explain the importance and effects of EMI to"
    },
    {
      "seq": 2,
      "describe_ch": "能辨識出可應用電磁干擾原理與技術的場合，並能清楚表達，能使用模擬分析工具，規劃一評估電磁干擾應用及其影響的相關分析，並由分析中歸納出適當結論",
      "describe_en": "Distinguish and make clear statement where EMI techniques and principles can be applied. Be able to use related principles and simulation tools to plan an evaluation about measuring EMI and effects, and draw appropriate conclusions from analysis."
    }
  ],
