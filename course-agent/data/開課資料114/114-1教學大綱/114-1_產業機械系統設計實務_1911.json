  "description": {
    "sub_id3": null,
    "sub_name": "產業機械系統設計實務",
    "sub_ename": "INDUSTRIAL MECHANICAL SYSTEM DESIGN PRACTICE",
    "describe_ch": "產業機械即針對某特定產業需求而設計製造之生產設備。機械設備基本包含電路、控制、機構、動力、感測、人機介面等單元，其中整合整體機械設備運作之核心為PLC控制器，在未來工業4.0需求所發展的數位工廠中，PLC將扮演關鍵角色，故本門課將以數位平台為基礎，介紹PLC開發流程與設計，並配合數位平台操作使學生能學用合一。",
    "describe_eh": "An industrial machinery is designed for certain industry.  A mechanical system is fabricated by integrating with circuit, controller, mechanisms, power, sensors and HMI.  Programmable logic controller (PLC) is a nucleus of the system and plays a key role of the digital factory for Industry 4.0 requirement.  Design and programming of PLC is introduced in this course and students also practice by using Festo.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解數位工廠與機電整合的相關性",
      "describe_en": "To comprehend the relationship between digital factory and mechatronics."
    },
    {
      "seq": 2,
      "describe_ch": "理解程式設計的邏輯觀念",
      "describe_en": "To realize the concept of PLC design."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉數位化平台操作要領",
      "describe_en": "To know how to practice with Festo machinery."
    },
    {
      "seq": 4,
      "describe_ch": "培養系統錯誤排除能力",
      "describe_en": "To cultivate the ability for debugging."
    }
  ],
