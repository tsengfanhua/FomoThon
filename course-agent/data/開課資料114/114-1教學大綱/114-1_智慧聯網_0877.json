  "description": {
    "sub_id3": null,
    "sub_name": "智慧聯網",
    "sub_ename": "ARTIFICIAL INTELLIGENCE OF THINGS",
    "describe_ch": "本課程將以兩階段逐步引導學生認識與體驗智慧聯網架構。第一階段將探討物聯網的基本架構、核心技術、運用特性與運作方式。第二階段則以小專題的形式，引導學生依照主題目標，實作各開發板與AI程式、GPU，以及sensor 的整合應用。",
    "describe_eh": "This course will gradually guide students to understand and experience the intelligent networking architecture in two stages. The first stage will discuss the basic architecture, core technology, application characteristics and operation methods of the Internet of Things. In the second stage, in the form of small topics, students are guided to implement the integrated applications of various development boards with AI programs, GPUs, and sensors in accordance with the theme and goals..",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識智慧聯網的基本結構與未來發展形勢",
      "describe_en": "Understand the basic structure and future development of AIoT"
    },
    {
      "seq": 2,
      "describe_ch": "以Raspberry Pi 體驗物聯網結構的建立",
      "describe_en": "Experience the establishment of IoT structure with Raspberry Pi"
    },
    {
      "seq": 3,
      "describe_ch": "實作開發板、GPU與sensor 整合應用",
      "describe_en": "Implement development board, GPU and sensor integration application"
    },
    {
      "seq": 4,
      "describe_ch": "分析智慧聯網對於全球科技發展上扮演的角色與定位",
      "describe_en": "Analyze the role and positioning of smart networking in global technological development"
    }
  ],
