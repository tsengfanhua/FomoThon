  "description": {
    "sub_id3": null,
    "sub_name": "二十世紀中國現代散文專題",
    "sub_ename": "SEMINAR ON THE MODERN CHINESE PROSE DURING THE TWENTIETH CENTURY",
    "describe_ch": "現代散文自「五四」發軔，迄今已逾一世紀，典範既立、名家輩出，其中體式、類型、詞采、風格之承變，及其綜合表而出之之美感，頗有可探討、可論述者，亦具一定程度之學術研究意義，因有本課程之開設。復因晚近以來，學子涉獵多偏向於本世紀台灣秀士之作，忽略上世紀50~80年代作品，而尤忽略前此早期典型，故時間斷限於二十世紀。",
    "describe_eh": "Modern prose from the \"May 4th\" hair, so far more than a century, the model is established, famous generations, including the body, type, word choice, style of succession, and its comprehensive table out of the beauty, quite can be explored, can be discussed, but also have a certain degree of academic research significance, because of the course. Since the late presumption, students have been involved in the works of Taiwanese showman in this century, ignoring the works of the 1950s and 1980s, and especially ignoring the earlier typical, so the time break is limited to the twentieth century.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解二十世紀中國現代散文之承遞演變及其中之典型與美學表現",
      "describe_en": "Understand the evolution of modern Chinese prose in the 20th century and its typical and aesthetic expression"
    },
    {
      "seq": 2,
      "describe_ch": "能具備貫通古今的思維並提升反思能力",
      "describe_en": "Possess the skill of critical thinking and enhance the ability of introspect."
    }
  ],
