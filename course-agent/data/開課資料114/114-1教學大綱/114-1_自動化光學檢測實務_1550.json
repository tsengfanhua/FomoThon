  "description": {
    "sub_id3": null,
    "sub_name": "自動化光學檢測實務",
    "sub_ename": "AUTOMATED OPTICAL INSPECTION PRACTICE",
    "describe_ch": "本課程將以實際案例講解自動光學檢測與辨識實務，利用深度學習及機器學習演算法進行自動光學檢查瑕疵分類專題，由此訓練理論基礎與實務結合之整合技術研發人才，滿足產業發展之需求為目標。",
    "describe_eh": "This course utilizes the practical industrial example in implementing an effective and robust automatic optical inspection system. The software development involves deep learning and machine learning algorithms to classify and localize the defects of the products. This enables skill training and integration especially for the talents in technology R & D. The consolidation of the theoretical basis and practical skills meet the needs of the present and future industrial revolution.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
