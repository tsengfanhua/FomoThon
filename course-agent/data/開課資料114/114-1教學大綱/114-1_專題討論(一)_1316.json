  "description": {
    "sub_id3": null,
    "sub_name": "專題討論(一)",
    "sub_ename": "SEMINAR(1)",
    "describe_ch": "藉由文獻專題討論講授研究方法, 培養學生發掘問題及蒐集資料之能力, 進而熟悉各領域所探討的訴求及重點, 以加強對IE的應用能力。",
    "describe_eh": "This course is designed to study and discuss concept and applications of IE by literature review.  Students then should know how to collect and analyze information and how to apply IE theory and skills solve problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解研究訴求及研究方法與架構。",
      "describe_en": "Understanding issues, methodology, and architecture of research."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解文獻研析之方法，及如何確立研究議題及範圍。",
      "describe_en": "Understanding how to literature review, and how to define and confirm research topic and the scope."
    },
    {
      "seq": 3,
      "describe_ch": "透過小組討論培養團隊合作及互動與溝通能力。",
      "describe_en": "Training the abilities of cooperative team work, interaction, and communication through group discussion."
    },
    {
      "seq": 5,
      "describe_ch": "討論議題能掌握最新產業發展趨勢，並瞭解最新科技技術並與接軌。",
      "describe_en": "Be able to discussion topics about  the latest industrial development trends, and understand the latest technology and technology."
    }
  ],
