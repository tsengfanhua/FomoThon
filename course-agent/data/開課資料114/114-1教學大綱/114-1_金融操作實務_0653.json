  "description": {
    "sub_id3": null,
    "sub_name": "金融操作實務",
    "sub_ename": "FINANCE  OPERATIONAL PRACTICE",
    "describe_ch": "介紹金融操作實務與經營策略，包括金融行銷、銀行徵信與調查、外匯操作實務、信託業務、績效與授信管理、證券市場交易策略、金融投資創意實務與預測、跨國資金調度…等。",
    "describe_eh": "The goal of this course is to introduce the essences of financial management and practical operations. These include banking marketing, performance management, the practical strategies of foreign exchange trading and security operation, account management and fraud management, financial innovations, global financial management.",
    "pre_subname": "ECON3005貨幣銀行學(一)、ECON3006貨幣銀行學(二)",
    "pre_sub_id3": "ECON3005",
    "pre_sub_ename": "ECON3005 MONEY AND BANKING(1)、ECON3006 MONEY AND BANKING(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解金融操作實務與經營策略、金融行銷",
      "describe_en": "Understanding a practical overview of finance management and operational strategy , banking marketing technique."
    },
    {
      "seq": 2,
      "describe_ch": "理解銀行徵信與調查、信託業務",
      "describe_en": "Understanding trust & credibility investigation and management"
    },
    {
      "seq": 3,
      "describe_ch": "理解外匯操作實務、證券市場交易策略",
      "describe_en": "Understanding foreign exchange and security operational strategy, security operational strategy"
    },
    {
      "seq": 4,
      "describe_ch": "理解跨國資金調度、金融投資創意實務與預測。",
      "describe_en": "Understanding how business makes good exploitation and use of global financial resource, financial creativeness practice、trend and prediction"
    }
  ],
