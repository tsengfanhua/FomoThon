  "description": {
    "sub_id3": null,
    "sub_name": "智慧城市與環境模擬",
    "sub_ename": "SMART CITY AND ENVIRONMENT SIMULATION",
    "describe_ch": "介紹智慧城市資訊服務相關之理論、技術與案例，並透過 3D 建模軟體與空間資訊工具，進行\r\n環境數據的收集、分析與應用，使學生具有實作智慧城市創新應用服務的能力。",
    "describe_eh": "This course brings up the theories, technologies, and real cases of intelligent services of smart cities. The course contents will enable students to implement innovative services or applications of smart cities using 3D modeling software and spatial information tools to collect, analyze, and utilize the environmental data.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生了解多維度智慧城市的概念與發展現況",
      "describe_en": "Understanding the concept and development of multi-dimension in Smart Cities"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解並模擬智慧城市應用方向與實作",
      "describe_en": "Understanding the application and implementation of Smart Cities"
    }
