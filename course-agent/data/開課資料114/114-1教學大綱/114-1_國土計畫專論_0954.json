  "description": {
    "sub_id3": null,
    "sub_name": "國土計畫專論",
    "sub_ename": "TOPICS AND CURRENT ISSUES ON NATIONAL SPATIAL PLANNING",
    "describe_ch": "課程主要探討國土規劃理念，國土復育及保育，國土計畫相關法規，區域發展理論，都會區發展，自然資源的利用與保護，國土及區域土地使用規劃與管制，國土及區域計畫的流程，成長管理，開發及使用許可制及民眾參與。",
    "describe_eh": "Major topics in: related law and Act for National and regional spatial planning, regional development theories, metropolitan region development, natural resource development and conservation, regional environment management, national and regional land use planning, control, and management; planning process of National spatial planning (due process), public participation and public hearing.　",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識國土及區域計畫演變過程",
      "describe_en": "lecturing of the evolution of national and regional land use planning"
    },
    {
      "seq": 2,
      "describe_ch": "培養學生理解及應用國土及區域計畫於都市規劃的方法",
      "describe_en": "training of the application of national and regional plan as the guidance of urban planning　"
    },
    {
      "seq": 3,
      "describe_ch": "應用國土及區域發展政策及區域競爭力等概念",
      "describe_en": "lecturing of national and regional development policy and regional competitiveness　"
    }
  ],
