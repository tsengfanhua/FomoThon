  "description": {
    "sub_id3": null,
    "sub_name": "創意研發專論",
    "sub_ename": "SPECIAL TOPICS ON INNOVATION AND CREATIVE RESEARCH",
    "describe_ch": "培養學生解決問題能力，引發創意思考，強化溝通、協調及簡報能力，俾助提升將來升學及就業競爭力。課程採主題式研討，強調跨領域整合方式，強化學生創意研發能力，增進團隊合作及溝通協調能力。",
    "describe_eh": "This course places emphases on developing students' ability of problem solving and creative thinking. Besides, the emphases also include effective communication, efficient coordination, and skillful presentation. To substantially enhance the competitive edge in their future professional careers, this course is organized to thrash out problems on various subject matters by integrating all related fields. As the principal goals, this course is to strengthen students' capability of creative research, group work, and communication.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 9,
      "describe_ch": "本課程預期達成以下學習目標：\r\n1.理解創意、創新與創業之基本概念與關聯性\r\n2.掌握創意思考技巧與創新工具之應用方法\r\n3.具備規劃與管理研發流程的能力\r\n4.能運用使用者導向與市場導向思維進行創新發展\r\n5.理解創業流程與初創事業策略\r\n6.具備團隊合作與跨域整合能力，完成創新專題\r\n7.關注永續與社會價值，提升責任感與創業倫理意識\r\n",
      "describe_en": null
    }
  ],
