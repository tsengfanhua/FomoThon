  "description": {
    "sub_id3": null,
    "sub_name": "企業研究方法",
    "sub_ename": "BUSINESS RESEARCH METHODOLOGY",
    "describe_ch": "企業研究方法是一門應用社會行為研究方法探討企業問題的學科，其目的在於針對企業面對其內、外部問題時，能發展出研究設計與實驗方法，進行資料收集與分析並衡量理論架構等，具有足以獨立進行企業研究之能力。",
    "describe_eh": "Business research methodology is a course of application of social and behavioral research methodology to business problems. The purpose of this course is to develop the independent ability to execute a research when facing the internal or external business problems. This independent research ability involves developing the research and experimental design, collecting data, testing theory construction and an awareness of various research methods as applied to organizational and business problems.",
    "pre_subname": "MGT1001管理學、MGT1002企業概論",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT、MGT1002 INTRODUCTION TO BUSINESS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 2,
      "describe_ch": "能辨識出企業研究之觀點、程序、方法、技術與工具",
      "describe_en": "Identify and Explain the perspectives, procedural, methods, skills, and tools used in business research."
    },
    {
      "seq": 3,
      "describe_ch": "能以書面或口頭方式將企業研究計畫與同儕和教師溝通",
      "describe_en": "Communicate his/her own business research project in written and oral form to classmates and the instructors."
    }
  ],
