  "description": {
    "sub_id3": null,
    "sub_name": "書法藝術創作",
    "sub_ename": "CALLIGRAPHY ART CREATION",
    "describe_ch": "探討書法的內容與形式，及其所以成為藝術的原因，進而教導學生如何從中鑑賞書法之美；並由歷代書家作品的介紹與賞析，帶領學生進入書法藝術的核心。",
    "describe_eh": "The course examines the content and form of calligraphy and the reasons for taking calligraphy as one kind of art. It also teaches students how to appreciate the beauty of calligraphy and guides the students to the core of calligraphy from introducing and analyzing the works of various writers in different dynasties",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生能瞭解書法的藝術性與美學要素",
      "describe_en": "Enable students to understand the artistic and aesthetic elements of calligraphy"
    },
    {
      "seq": 2,
      "describe_ch": "使學生能掌握各體書法創作技巧與要領",
      "describe_en": "Enable students to master the skills and essentials of various calligraphy creations"
    }
  ],
