  "description": {
    "sub_id3": null,
    "sub_name": "教育資料科學專題",
    "sub_ename": "SPECIAL TOPICS ON EDUCATIONAL DATA SCIENCE",
    "describe_ch": "教育資料科學專題主要以教育大數據資料分析為基礎，並結合「生生用平板」情境，透過專題實作，理解教育資料科學實務上的知識，並強調落實解決教育情境問題的應用與反思。",
    "describe_eh": "The special topics on education data science mainly focuses on the analysis of big data in education, and incorporates the \"students using tablets\" scenario. Through project-based learning, students gain an understanding of practical knowledge in educational data science, while emphasizing the implementation, application, and reflection in solving educational context-related issues.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解教育大數據之基礎概念與在數位學習上的應用。",
      "describe_en": "Understanding the fundamental concept of big data for education and its applications in e-learning."
    },
    {
      "seq": 2,
      "describe_ch": "能撰寫程式語言或應用軟體進行教育大數據分析。",
      "describe_en": "Proficient in writing programming code and using software for educational big data analysis."
    },
    {
      "seq": 3,
      "describe_ch": "能使用適當的大數據分析方法模型解決教育相關問題。",
      "describe_en": "Skilled in applying appropriate data analysis methods and models to address educational problems."
    },
    {
      "seq": 4,
      "describe_ch": "能以教育大數據分析驅動，發現新的學習洞見、智慧評量或個人化的學習扶助。",
      "describe_en": "Through educational big data analysis, able to uncover new educational insights, implement smart assessments, and provide personalized learning support."
    }
  ],
