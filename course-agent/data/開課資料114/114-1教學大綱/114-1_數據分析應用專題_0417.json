  "description": {
    "sub_id3": null,
    "sub_name": "數據分析應用專題",
    "sub_ename": "SEMINAR ON DATA ANALYTICS AND APPLICATIONS",
    "describe_ch": "本課程介紹數據分析的各種方法，內容包括資料處理、模型建立、統計分析，以及相關的分析工具應用，讓學生能夠進行多樣性數據資料的分析與應用。",
    "describe_eh": "This course introduces various methods of data analysis, including data processing, model building, statistical analysis, and related analytic tool applications. The course aims to cultivate students’ capability of performing analyses and applications of diverse data.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培養學生之專業分析能力，使其滿足業界對於數據分析人才的需求。",
      "describe_en": "Cultivate students' professional analytical skills to meet the industry's demand for data analysis talents."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生應用分析工具以及實作之專業能力。",
      "describe_en": "Cultivate students' professional skills in using analytical tools and implementing them."
    }
  ],
