  "textBooks": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB05149",
    "sub_id": "37010",
    "scr_dup": "001",
    "tpb_seq": 1,
    "tpb_book": "<div>自編講義，依照我國稅法，我國與各國簽訂租稅協定、財政部稅務人員參加國際租稅有關會議、進修之出國報告、財政部新聞稿(賦稅)及國稅局、地方稅務局授課教材及企業、個人、跨國租稅案例等整理編輯，以實務案例解說演練租稅規劃操作策略、工具及技術。</div>\n",
    "tpb_book_en": null
  },
