  "description": {
    "sub_id3": null,
    "sub_name": "租稅規劃",
    "sub_ename": "TAX PLANNING",
    "describe_ch": "本課程主要闡述租稅規劃實務，使學生對租稅規劃及實務，能有一全盤而詳盡之瞭解。本課程的重點是應用租稅知識分析及處理涉稅事宜，以及瞭解可行租稅規劃方法，培養學生具有租稅規劃專業知識。",
    "describe_eh": "This course aims to introduce and interpret so that the students have a comprehensive and detailed of the understanding of tax planning practices. The focus of this course is apply taxation of knowledge to analyze and handling taxation matters, and understands feasible whys of tax planning. In order to the training of student's professional knowledge of tax planning.　",
    "pre_subname": "PF2042租稅法",
    "pre_sub_id3": "PF2042",
    "pre_sub_ename": "PF2042 TAX LAW",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": " 從經濟行為導引符合租稅課稅要件之應稅行為知悉租稅法律應用\t",
      "describe_en": "To introduce economical acts to tax"
    },
    {
      "seq": 2,
      "describe_ch": " 從杜防租稅逃漏瞭解租稅規劃途徑\t\n",
      "describe_en": "To undestand the ways of tax planning to deter tax evasion"
    },
    {
      "seq": 3,
      "describe_ch": " 透過租稅實例分析瞭解可行租稅規劃方法並提昇知法及用法\t",
      "describe_en": "to analize and understand the feasible whys of tax planning and elevate the knowledge and insage of tax"
    }
  ],
