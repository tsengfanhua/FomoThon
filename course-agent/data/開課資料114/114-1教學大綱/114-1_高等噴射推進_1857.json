  "description": {
    "sub_id3": null,
    "sub_name": "高等噴射推進",
    "sub_ename": "ADVANCED JET PROPULSION",
    "describe_ch": "本課程主要內容在介紹於大氣層內飛行載具的噴射引擎以及可在外太空航行的火箭引擎的相關物理原理(主要是熱力、流力)和動力源燃料(主要以燃燒形式產生)的綜合應用以及他們的基本架構組成，同時因應任務需求(含軌跡或軌道)來推導相關的重要設計參數。",
    "describe_eh": "The main contents of this course are the air-breathing engines and chemical rockets. The applied physics (mainly thermodynamics and fluid mechanics), power sources (thermal energy generation by combustion), and engines’ infrastructure/component are introduced respectively. Those are  based on the engine application environments, such as inner or outer space. Then, the important design parameters, including the trajectory and orbit, are deduced according to their mission requirements.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生了解吸氣式引擎及化學火箭的物理基本概念",
      "describe_en": "Let the students understand the basic physics law for air-breathing engines and chemical rockets."
    },
    {
      "seq": 2,
      "describe_ch": "使學生了解大氣層內飛行器和外太空火箭可應用的任務",
      "describe_en": "The students can have the knowledges for the applications/missions of aircraft and rockets."
    },
    {
      "seq": 3,
      "describe_ch": "從課堂知識的傳授及啟發來使學生具備掌握國際航太技術發展趨勢之能力",
      "describe_en": "Via the learning and inspiration in the class, it can make students pursue the and grasp the trend of the international cutting-edge aeronautic and aerospace technologies."
    }
  ],
