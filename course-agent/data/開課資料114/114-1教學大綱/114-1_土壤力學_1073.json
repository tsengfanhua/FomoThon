  "description": {
    "sub_id3": null,
    "sub_name": "土壤力學",
    "sub_ename": "SOIL MECHANICS",
    "describe_ch": "土壤力學探索土壤組成、土壤分類方法、土壤夯實、土壤的滲透係數及滲流量與滲流作用力、土體中的應力、土壤的壓縮性及沉陷量、及土壤的剪力強度等內容。研習的內容是大地工程如邊坡穩定、建築物基礎、及擋土構造物等相關分析與設計的必備工具。",
    "describe_eh": "Soil Mechanics explores the following subjects: the soil composition, methods of soil classification, compaction of soils, permeability of soil, seepage and seepage force of water in soils, stresses in soils, compression and settlement of soils, and shear strength of soils.  The contents provide required tools for the analysis of slope stability and the design of geotechnical related structures such as foundations of building and retaining structures.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解土壤的基本性質\t",
      "describe_en": "Understand the basic characteristics of soil \t"
    },
    {
      "seq": 2,
      "describe_ch": "知道影響土壤強度的因素\t",
      "describe_en": "Know the important factors to influence the strength of soil"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解土壤力學於實物工程的應用 \t",
      "describe_en": "3 Understand the applications of soil mechanics in practical engineering"
    },
    {
      "seq": 4,
      "describe_ch": "能計算土壤的滲透係數",
      "describe_en": "4. Be able to determine the coefficient of permeability in soils."
    }
  ],
