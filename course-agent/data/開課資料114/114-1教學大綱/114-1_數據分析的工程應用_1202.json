      "describe_ch": "學習用數據分析作工程評估與改善的能力",
      "describe_en": "Learn the ability to use data analysis for engineering evaluation and improvement."
    },
    {
      "seq": 4,
      "describe_ch": "培育數據分析的技術人才",
      "describe_en": "Cultivate technical talents for data analysis."
    },
    {
      "seq": 5,
      "describe_ch": "運用案例分析了解數據分析的應用",
      "describe_en": "Use case studies to understand the application of data analysis."
    }
