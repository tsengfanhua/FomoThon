  "description": {
    "sub_id3": null,
    "sub_name": "迴歸分析實習",
    "sub_ename": "PRACTICE OF REGRESSION ANALYSIS",
    "describe_ch": "瞭解迴歸分析的理論和方法並能應用於實際生活所遭遇的實務問題有深入的瞭解和實際資料分析，主題包括簡模型適合性之衡量、簡單線性迴歸分析、複迴歸、多項式迴歸、指示變數、非線性迴歸。",
    "describe_eh": "Regression Analysis is a crucial statistical technique to study the relationships between a response (dependent) variable and explanatory variable or variables. It is widely used today in business, economics, engineering, biological, biomedical, health, and social sciences. This course introduces the basic of regression theory, including method of least squares, inferences, diagnostics, and selected appropriate models. A statistical software package, SAS, will be used to analyze data.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解基本的迴歸模型概念和工具",
      "describe_en": "Comprehension for  basic regression concepts and tools"
    },
    {
      "seq": 2,
      "describe_ch": "應用迴歸模型概念，包括診斷檢查、數據轉換、模型選擇和確認",
      "describe_en": "To apply  regression analyses, including data transformations, diagnostic checking, model selection and validation."
    },
    {
      "seq": 3,
      "describe_ch": "應用統計套裝軟體進行迴歸分析",
      "describe_en": "To apply  one of the statistical packages to carry out regression analysis"
    },
    {
      "seq": 4,
      "describe_ch": "應用實證分析，配適合適的迴歸模型",
      "describe_en": "To apply  a regression analysis for empirical study, and to interpret the results to others."
    }
  ],
