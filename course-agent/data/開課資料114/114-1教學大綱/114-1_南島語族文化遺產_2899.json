  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "南島語族文化遺產",
    "sub_ename": "CONTEMPORARY ISSUES IN AUSTRONESIA CULTURAL HERITAGE",
    "describe_ch": "南島語族分佈在太平洋島嶼上，與台灣原住民在語言與文化上有著深刻的連結。然多數南島語族社會因經歷多重殖民歷史，而在當代面臨複雜的文化存續議題。本課程將從文化資產的角度介紹南島語族文化及其面臨之當代議題。",
    "describe_eh": "Austronesians inhabit throughout the Pacific islands and have deep connections with Taiwan indigenous people in terms of language and culture. However, most of Austronesian societies have undergone multiple colonial histories that they are facing complicated cultural survival issues in contemporary situation. This course will lead student to learn Austronesian cultures and investigate contemporary issue of Austronesian culture heritage.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉南島語族文化與社會的基本概念",
      "describe_en": "Familiar with the concepts of culture and societies of Austronesian culture."
    },
    {
      "seq": 2,
      "describe_ch": "具備足夠素養探索南島語族文化資產的當代議題",
      "describe_en": "Enable students to investigate the contemporary issues of Austronesian cultural heritage."
    }
  ],
