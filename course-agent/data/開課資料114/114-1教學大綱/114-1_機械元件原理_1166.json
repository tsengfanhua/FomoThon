  "description": {
    "sub_id3": null,
    "sub_name": "機械元件原理",
    "sub_ename": "PRINCIPLE OF MECHANICAL COMPONENTS",
    "describe_ch": "介紹常見的機械元件的原理，描述其基本構造與使用材料。並敘述其功能、目的、設計規範、動作原理、使用壽命與選用原則。",
    "describe_eh": "Introduce the principles of common mechanical parts, describe their basic structure and materials. It also describes its functions, uses, design specifications, operating principles, service life, and selection principles.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
