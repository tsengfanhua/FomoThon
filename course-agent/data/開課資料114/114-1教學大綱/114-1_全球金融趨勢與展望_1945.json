  "description": {
    "sub_id3": null,
    "sub_name": "全球金融趨勢與展望",
    "sub_ename": "GLOBAL FINANCIAL TREND AND PROSPECT",
    "describe_ch": "授課對象為金融業與金融科技業從事策略管理、風險管理、金融科技相關業務之中高階主管，旨在分析金融科技時代下，金融服務業面臨之金融科技之應用運作，協助學生謀劃因應之策。",
    "describe_eh": "Classes are taught to senior executives in the financial industry and financial technology industry engaged in strategic management, risk management, and financial technology-related businesses. The aim is to analyze the application and operation of financial technology in the financial service industry in the era of financial technology, and assist students in planning corresponding strategies.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "讓同學能掌控當下全球重要財經議題與最新財金之發展",
      "describe_en": "Let students understand key issues in the international financial markets and important developments in the world of finance."
    },
    {
      "seq": 2,
      "describe_ch": "了解國際金融與保險業的發展概況、觀察參訪企業的經營優勢與面對的挑戰",
      "describe_en": "Students could cooperate and share thoughts to finish term project."
    }
  ],
