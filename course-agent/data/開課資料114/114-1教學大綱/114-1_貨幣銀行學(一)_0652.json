  "description": {
    "sub_id3": null,
    "sub_name": "貨幣銀行學(一)",
    "sub_ename": "MONEY AND BANKING(1)",
    "describe_ch": "本課上學期目標有二：其一、期使學生能夠認知利率在金融投資行為所扮演的關鍵角色，並且能掌握決定利率的主要因素；其二、認知各種金融市場的運作及金融市場中流通的各項金融商品之內涵，同時還要進一步理解幾項常見金融商品的訂價理論。",
    "describe_eh": "The goal of course is twofold： first one is to capture the factors that determine  interest rates and realize its pivotal role played in financial  investment behavior.. Second, to understand how various financial markets run and what are various financial commodities that are traded in financial markets. and what is the pricing theories for those important financial commodities.",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解利率的決定因素及其重要性。",
      "describe_en": "To capture the factors that determine  interest rates and realize its pivotal role played in financial  investment behavior."
    },
    {
      "seq": 2,
      "describe_ch": "理解各種金融市場的運作。",
      "describe_en": "Understand how various financial markets run."
    },
    {
      "seq": 3,
      "describe_ch": "理解幾種常見金融商品的訂價理論。",
      "describe_en": "Understand the pricing theories of several important financial commodities."
    },
    {
      "seq": 4,
      "describe_ch": "知道如何蒐尋各種金融統計",
      "describe_en": "Know how to search various financial statistics."
    }
  ],
