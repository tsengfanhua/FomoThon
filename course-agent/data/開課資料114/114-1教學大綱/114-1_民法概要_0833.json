  "description": {
    "sub_id3": null,
    "sub_name": "民法概要",
    "sub_ename": "INTRODUCTION TO CIVIL LAW",
    "describe_ch": "提供非法律系學生熟知民法基礎理論並了解日常生活法律常識之課程。民法為規範人民私法行為之主要法律，內容廣泛，包括總則、債編、物權編、親屬編及繼承編，本課程將選擇合適主題介紹之。\r\n",
    "describe_eh": "This is a basic course designed to familiarize non-majors with Taiwan's Civil Code. Especially Civil Code influences citizens' life, and has extensive range in this law, including five parts General Principles, obligation, Rights In Rem, Family, and Guardianship. This course will choose the appropriate topics to introduce to students. We hope students have enough ability to deal with legal problem while they operate business in the future.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "民法與經營企業休戚相關，商學院學生自須具有民法重要基礎之學養。\r\n",
      "describe_en": "\r\nCivil law is closely connected to business activities. Student in business school should have the fundamental understanding about civil law."
    },
    {
      "seq": 2,
      "describe_ch": "避免將來不能處理實務問題，致權益受損，具有應用之核心價值。",
      "describe_en": "\r\nThis course wants students understand how to protect their legal right in order to avoid unnecessary damage.  \r\n"
    }
  ],
