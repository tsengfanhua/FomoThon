  "description": {
    "sub_id3": null,
    "sub_name": "合金設計",
    "sub_ename": "ALLOY DESIGN",
    "describe_ch": "本課程著重於工業上主要高價金屬材料之合金組成設計對顯微組織及機械性質的影響。所探討的合金包含不銹鋼、工具鋼、高強度低合金鋼、鎳基合金、鋁合金、及鎂合金。",
    "describe_eh": "This course focuses on the design of alloy composition versus microstructure and mechanical property in a wide range of high-value metallic materials that are typically involved in industry. The alloys discussed include: stainless steel, tool steel, high-strength low-alloy steel, nickel-base alloy, aluminum alloy, magnesium alloy, and titanium alloy.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "深入理解不銹鋼、工具鋼、高強度低合金鋼、鎳基合金、鋁合金、及鎂合金之合金設計原理。",
      "describe_en": "\tDeeply understand the principles of alloy design for stainless steels, tool steel, high-strength low-alloy steel, nickel-base alloy, aluminum alloy, and magnesium alloy."
    },
    {
      "seq": 2,
      "describe_ch": "辨別不銹鋼、工具鋼、高強度低合金鋼、鎳基合金、鋁合金、及鎂合金之合金設計對物理性能的影響。\t",
      "describe_en": "Discriminate the influence of alloy design on physical property for different types of stainless steels, tool steel, high-strength low-alloy steel, nickel-base alloy, aluminum alloy, and magnesium alloy."
    },
    {
      "seq": 3,
      "describe_ch": "表達不銹鋼、工具鋼、高強度低合金鋼、鎳基合金、鋁合金、及鎂合金在工業上的應用。",
      "describe_en": "Interpret the application in industry of stainless steels, tool steel, high-strength low-alloy steel, nickel-base alloy, aluminum alloy, and magnesium alloy."
    },
    {
      "seq": 4,
      "describe_ch": "能以書面及口頭方式於課堂上呈現其學習成果。\t",
      "describe_en": "Present their learning performance on oral and paper reports in class."
    }
  ],
