  "description": {
    "sub_id3": null,
    "sub_name": "消費稅理論與制度",
    "sub_ename": "THEORY AND SYSTEM OF CONSUMPTION TAX",
    "describe_ch": "介紹消費稅基本理論〈如消費稅的課徵原則、消費稅的歸宿、消費稅與所得稅的比較〉，以及我國現行消費稅制度與政策。探討營業稅、貨物稅、關稅、使用牌照稅、娛樂稅、印花稅及菸酒稅等課稅議題。",
    "describe_eh": "This course provides a framework of consumption tax theory such as the principles of consumption taxation, consumption tax incidence, and Consumption taxation vs. Income taxation and introduces our current consumption tax systems and policies. Discuss Business Tax, Commodity Tax, Customs Duties, Licence Tax, Amusement Tax, Stamp Tax, and Tobacco and Alcohol Tax.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
