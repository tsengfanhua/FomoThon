  "description": {
    "sub_id3": null,
    "sub_name": "統計學實習",
    "sub_ename": "RECITATION OF STATISTICS",
    "describe_ch": "本課程為輔助統計學課程之進行，讓同學可以更深入瞭解課程習題演練與相關統計軟體的操作。",
    "describe_eh": " This course is a statistics practice lesson. The purpose of this course is to assist students familiar with exercise and software operation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用基礎敘述性統計進行相關土地管理資料描述與說明。\r\n",
      "describe_en": "Be able to apply description statistics to describe relevant to land management database.\r\n"
    },
    {
      "seq": 2,
      "describe_ch": "能理解機率理論與統計推論的概念，並應用到土地管理相關資料處理與分析。\t",
      "describe_en": "Be able to realize probability theory and the referential statistic, and apply them to analyze relevant to land management database."
    },
    {
      "seq": 3,
      "describe_ch": "能應用相關統計軟體進行統計資料描述、處理與分析。\t",
      "describe_en": "Be able to apply statistic software to describe and analyze data."
    }
  ],
