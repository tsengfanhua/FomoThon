  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE03130",
    "sub_id": "82545",
    "scr_dup": "001",
    "sub_title": "形式構成的脈絡與批判",
    "sub_title_en": null,
    "sub_describe": "形式的構成可能具備一模糊性，一是奠基過往歷時或傳統而衍生的空間生成機制，一是奠基於傳統脈絡下的自我思辯與批判。然而，處於凡事講求資訊量化以及科技當道的年代，對比於身體感知經驗與藝術內化於建造中的「技藝」構成，是否這樣「科學理性」的世代，是對於「自我」創新的「凌駕與欺瞞」?\n本課程奠基於學院基礎課程中的圖學、構造、結構以及史論之下的實驗性探討，目的在於：(1)釐清形式構成的脈絡化，而非任所欲為的胡謅；(2)作為準設計人，試問對於形式與材料構成的「自我邏輯」何在，以及最重要的：成為具備「思考與辯證」的創新者。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "建築專題講座",
    "sub_ename": "SEMINAR─ARCHITECTURAL DESIGN",
    "describe_ch": "藉由建築環境講座課程，邀請國內建築、景觀、室內設計等學界與業界之菁英，開闢一個有關空間與環境相關課題之理論與實務的演講，經由討論達到傳承的目的。",
    "describe_eh": "Our seminars on architectural environment would invite recognized experts on architecture, scenic, and interior design to give lectures on theories and practices associated with space and environment issues. Open discussion would be held to pass on legacy of individual fields.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
