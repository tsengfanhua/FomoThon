    {
      "seq": 1,
      "describe_ch": "建構建築、室內與景觀三位一體的教學環境",
      "describe_en": "Construct a learning environment aimed at the trinity of architecture, interior, and scenic design."
    },
    {
      "seq": 2,
      "describe_ch": "提供建築、室內與景觀領域，專業理論知識之強化",
      "describe_en": "Enhance knowledge about professional theories in the arenas of architecture, interior, and scenic design."
    },
    {
      "seq": 3,
      "describe_ch": "提供建築、室內與景觀領域，專業實務知識之強化",
      "describe_en": "Enhance practical knowledge about professions in the arenas of architecture, interior, and scenic design."
    }
  ],
