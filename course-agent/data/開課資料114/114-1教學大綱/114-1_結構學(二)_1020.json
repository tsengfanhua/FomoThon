  "description": {
    "sub_id3": null,
    "sub_name": "結構學(二)",
    "sub_ename": "STRUCTURAL THEORY (2)",
    "describe_ch": "本課程為結構分析之基礎課程，其目的在使學生具備分析桁架、梁及構架等結構系統之能力。結構學(二)除了介紹求解靜定結構變位的幾何方法及能量法外，主要討論超靜定結構的分析方法，包含力法、傾角變位法及彎矩分配法。本課程亦將介紹超靜定結構的影響線。",
    "describe_eh": "This is an elementary course of structural analysis. The objective is to lead students to be capable of analyzing various structures such as trusses, beams, and frames. STRUCTURAL THEORY (2) focuses not only on introducing the geometrical methods and energy methods to solve problems involving slope and deflection, but also on discussing the techniques, such as force method, slope deflection method and moment distribution method, to analyze statically indeterminate structures. In addition, techniques to determine the influence lines of statically indeterminate structures are also included in this course.",
    "pre_subname": "CE1001應用力學、CE2078材料力學、CE2070結構學(一)",
    "pre_sub_id3": "CE1001",
    "pre_sub_ename": "CE1001 APPLIED MECHANICS、CE2078 MECHANICS OF MATERIALS、CE2070 STRUCTURAL THEORY(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "應用物理學及數學之知識於結構分析。",
      "describe_en": "To apply the knowledge of physics and mathematics in structural analysis."
    },
    {
      "seq": 2,
      "describe_ch": "運用結構分析方法求解工程結構問題。",
      "describe_en": "To employ the techniques of structural analysis to solve engineering structural problems."
    },
    {
      "seq": 3,
      "describe_ch": "藉由討論問題，增進溝通能力及團隊合作精神。",
      "describe_en": "To enhance the communication skill and team-work spirit through discussion on assigned problems."
    }
  ],
