  "description": {
    "sub_id3": null,
    "sub_name": "英文演講",
    "sub_ename": "PUBLIC SPEAKING FOR NONNATIVE SPEAKERS",
    "describe_ch": "This course is designed to develop public speaking skills . Public speaking is a vital soft skill - be it used in the classroom or for a presentation at work . Attention will also be given to individual communication activities designed to improve the ability to organize , reason tically , and to listen effectively . Each student will develop and deliver several speeches and participate in peer evaluations.",
    "describe_eh": "This course is designed to develop public speaking skills . Public speaking is a vital soft skill - be it used in the classroom or for a presentation at work . Attention will also be given to individual communication activities designed to improve the ability to organize , reason tically , and to listen effectively . Each student will develop and deliver several speeches and participate in peer evaluations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 37,
      "describe_ch": "Students can identify how communication theories guide the practical delivery of speeches and presentations.",
      "describe_en": "Students can identify how communication theories guide the practical delivery of speeches and presentations."
    },
    {
      "seq": 38,
      "describe_ch": "Students can effectively repeat the four basic steps that produce effective speeches and presentations—researching, organising, practising and delivering.",
      "describe_en": "Students can effectively repeat the four basic steps that produce effective speeches and presentations—researching, organising, practising and delivering."
    },
    {
      "seq": 39,
      "describe_ch": "Students can demonstrate verbal and non-verbal communication skills in various real-world speaking contexts.",
      "describe_en": "Students can demonstrate verbal and non-verbal communication skills in various real-world speaking contexts."
    },
    {
      "seq": 40,
      "describe_ch": "Students can employ active listening and critical evaluation to analyse speech delivery, content structure and audience engagement techniques.",
      "describe_en": "Students can employ active listening and critical evaluation to analyse speech delivery, content structure and audience engagement techniques."
    }
  ],
