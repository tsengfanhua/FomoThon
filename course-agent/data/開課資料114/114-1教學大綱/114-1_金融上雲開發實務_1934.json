  "description": {
    "sub_id3": null,
    "sub_name": "金融上雲開發實務",
    "sub_ename": "CLOUD DEVELOPMENT PRACTICES FOR FINANCIAL SERVICES",
    "describe_ch": "隨著金融科技的發展，銀行已經產生了全新的服務模式。透過蒐集和分析使用者的行為，銀行已經開始探索創新服務與使用者之間的關聯性。本課程旨在引導學生透過雲端技術設計並實作創新的服務。",
    "describe_eh": "With the development of financial technology, banks have generated a brand-new service model. By collecting and analyzing users' behavior, banks have begun to explore the correlation between innovative services and users. This course aims to guide students in designing and implementing innovative services through cloud technology.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能了解使用者行為。",
      "describe_en": "Understand the basic elements of user behaviors."
    },
    {
      "seq": 2,
      "describe_ch": "能應用雲端技術實作創新服務。",
      "describe_en": "Implement innovative services using cloud technology."
    },
    {
      "seq": 3,
      "describe_ch": "能分析不同的創新服務模式。",
      "describe_en": "Analyze the different models of innovative services."
    }
  ],
