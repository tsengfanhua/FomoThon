  "description": {
    "sub_id3": null,
    "sub_name": "超大型積體電路設計",
    "sub_ename": "VLSI DESIGN",
    "describe_ch": "本課程主要適用於研一.前八章主要對MOS電晶體及相關論題作嚴謹的闡述.同時也論及靜態與動態邏輯的操作原理,基本反相器之分析設計及組合或循序邏輯電路之架構與操作.第九章專論動態邏輯電路,第十章對半導體記憶電路有深入討論.第十一章則是BiCMOS 電路design.第十二章對晶片I/O設計與ESD保護電路有清楚之探討.",
    "describe_eh": "The first portion is devoted to a detailed treatment of the MOS transistors with all its relevant aspects; to the static and dynamic operation principles, analysis, and design of basic inverters; and to the structure and operation of combinational and sequential logic gates. It has been reserved for the treatment of dynamic logic circuits which are used in state-of-art VLSI chips. The design of memory circuitry, digital circuit design, I/O Design and ESD protection techniques will be addressed.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "對CMOS 製程技術與操作原理深入的了解，能分析VLSI 電路的功能與學習電路設計方法與技術。",
      "describe_en": "Basic and through understanding on CMOS technology and operation principles. To establish the capability on VLSI circuit analysis,and learn circuit design methods and techniques."
    },
    {
      "seq": 2,
      "describe_ch": "相關超大型積體電路的設計模式,包括組合與循序,靜態與動態之電路設計。",
      "describe_en": "Related VLSI design technique including combinational/sequential, and static (dynamic) circuit design."
    }
  ],
