  "description": {
    "sub_id3": null,
    "sub_name": "生活化的敏捷專案管理",
    "sub_ename": "LIFE AGILE PROJECT MANAGEMENT",
    "describe_ch": "本課程首先教授敏捷專案管理相關知識與方法論，接著透過敏捷分組團隊進行專案管理實務應用，最後輔導學生有效通過中華專案管理學會的敏捷助理專案管理師(APMA)專業認證考試。",
    "describe_eh": "This course first teaches the knowledge and methodology of agile project management, and then implements project management practice through agile group teams, and finally guides students to effectively pass agile project management assistant (APMA) professional certification exam of National Project Management Association.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
