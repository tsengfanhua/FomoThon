    {
      "seq": 2,
      "describe_ch": "瞭解敏捷專案管理基本知識",
      "describe_en": "Understand the basic knowledge of agile project management"
    },
    {
      "seq": 3,
      "describe_ch": "具備敏捷團隊專案管理應用能力",
      "describe_en": "With project management and application capabilities of an agile team"
    }
