  "description": {
    "sub_id3": null,
    "sub_name": "政府專案管理",
    "sub_ename": "GOVERNMENT PROJECT MANAGEMENT",
    "describe_ch": "專案管理為在限定範疇、品質、時間與成本條件下，運用組織與管理資源的專業知識以達成專案的特定目標。本課程乃著眼於營建產業，提供學生專案管理從發起、推展、執行至專案結束與維護之知識體系的核心認知與能力。",
    "describe_eh": "Project management is the discipline of organizing and managing resources (e.g. people) in such a way that the project is completed within defined scope, quality, time and cost constraints. This course aims at construction industry to provide students with the ability of understanding the body of knowledge of project management, from initiation, development, production/execution, to closing/maintenance of a project.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習政府專案管理實務經驗",
      "describe_en": "To learn the practice in government project management"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解政府專案落實與社會責任的關係",
      "describe_en": "To realize the relationship between government project implement and social responsibility"
    },
    {
      "seq": 3,
      "describe_ch": "認識政府專案管理問題",
      "describe_en": "To know the problem of government project management"
    }
  ],
