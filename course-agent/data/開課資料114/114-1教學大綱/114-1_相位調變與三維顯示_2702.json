  "description": {
    "sub_id3": null,
    "sub_name": "相位調變與三維顯示",
    "sub_ename": "PHASE MODULATION AND THREE-DIMENSIONAL DISPLAY",
    "describe_ch": "本課程涵蓋三個面向。首先我們將介紹光的波動特性以及傳播原理。接下來我們將討論取樣原理，以及光的數位調變原理。最後我們將介紹電腦產生全像以及其在三維顯示之應用。本課程內容亦將結合實作以及分組專題進行。",
    "describe_eh": "This course contains three topics. First the principle of light propagation as well as the optical wave properties is introduced. In the second part, the sampling principle and digital modulation of light are discussed. The third topic is computer-generated holography and its application in three-dimensional display. Experiments and a team project are also included in this course.",
    "pre_subname": "PHYS1002普通物理實驗(二)",
    "pre_sub_id3": "PHYS1002",
    "pre_sub_ename": "PHYS1002 GENERAL PHYSICS LAB.(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能設計電腦產生全像。",
      "describe_en": "Be able to design a computer-generated hologram."
    },
    {
      "seq": 2,
      "describe_ch": "能以空間光調制器進行全像三維顯示。",
      "describe_en": "Be able to apply a spatial light modulator for holographic 3D display."
    },
    {
      "seq": 3,
      "describe_ch": "能夠處理及分析實驗結果。",
      "describe_en": "Be able to organize and to analyze the experimental results."
    },
    {
      "seq": 4,
      "describe_ch": "能透過小組展現團隊合作能力。",
      "describe_en": "Demonstrate team spirit through teamwork."
    }
  ],
