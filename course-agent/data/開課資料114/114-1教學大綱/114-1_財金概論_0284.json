    {
      "seq": 1,
      "describe_ch": "能知道財金基本概念與財金相關行業",
      "describe_en": "Knowledge for basic concepts of finance and introduction of banks and other financial institutions"
    },
    {
      "seq": 2,
      "describe_ch": "能理解財金相關證照與投資模擬競賽",
      "describe_en": "Comprehension for financial related licenses and simulated investment competitions"
    }
