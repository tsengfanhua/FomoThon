  "description": {
    "sub_id3": null,
    "sub_name": "固定收益型有價證券",
    "sub_ename": "FIXED-INCOME SECURITIES",
    "describe_ch": "隨著固定收益有價證券的盛行，對其深入瞭解也愈益重要。此課程目標在於讓學生瞭解相關固定收益有價證券之投資、避險、及評價等知識，並以各種不同之有價證券建構出最適投資組合。",
    "describe_eh": "As fixed-income securities become more and more popular, it is very important to understand them.  The objective of the course is to teach students knowledge of investment, hedging, and valuation of fixed-income securities and the construction of the optimal portfolios with different securities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": " 瞭解固定收益證券的性質及應用",
      "describe_en": "To understand the property and application of fixed-income securities."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解固定收益證券的評價",
      "describe_en": "To understand the valuation of fixed-income securities."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解利率期限結構及利率風險",
      "describe_en": "To understand term structure of interest rate and interest rate risk."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解固定收益證券之投資組合之績效評估",
      "describe_en": "To understand the performance evaluation of portfolios with fixed-income securities."
    }
  ],
