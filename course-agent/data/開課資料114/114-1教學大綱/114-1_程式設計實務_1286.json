  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE06121",
    "sub_id": "48598",
    "scr_dup": "001",
    "sub_title": "介紹工業工程專業領域（如工程統計、製造程序、生產管理、品質管理與數據分析等）及人工智慧應用相關之 Python 程式庫與套件，讓學生熟悉使用 Python 工具，學習到如何進行工業工程實務資料（預）處理與資料視覺化。",
    "sub_title_en": null,
    "sub_describe": "(1)運用邏輯思維分析工業工程相關問題\n(2)瞭解python程式庫與套件工具之操作\n(3)培養以程式工具解決實務問題之能力",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "程式設計實務",
    "sub_ename": "PROGRAMMING PRACTICE",
    "describe_ch": "本課程將介紹與工業工程專業領域，如工程統計、製造程序、生產管理、品質管理與數據分析等，之相關程式設計實務。除了培養學生撰寫程式的技巧，也包括選用適當軟體工具解決問題的能力。",
    "describe_eh": "This course introduces students to aspects of professional programming practice related to Industrial Engineering, and helps students to develop hands-on skills in writing programs, including working with appropriate tools.",
