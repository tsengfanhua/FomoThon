  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB02149",
    "sub_id": "87007",
    "scr_dup": "001",
    "sub_title": null,
    "sub_title_en": "The valuable topics will be explored through lectures, Zuvio interaction, AI tool activities, and discussions. They extend the textbook content to connect with AI in the workplace, intercultural awareness, and future career skills.",
    "sub_describe": null,
    "sub_describe_en": "AI in the Workplace.\n *How tools like ChatGPT, Gemini, Grok, and Canva support professional tasks (emails, reports, presentations).\n *Responsible AI use: editing AI drafts, avoiding plagiarism, and personalizing content.\nCross-Cultural Communication.\n *Understanding business etiquette in Taiwan vs. other countries (students’ home cultures).\nPracticing polite communication styles for international workplaces.\nDigital Branding & Professional Identity.\nBuilding a personal brand on LinkedIn and other platforms.\nUsing Canva and Gamma to create a professional PPT presentation.\nWorkplace Communication Skills.\nWriting effective emails, memos, and business briefs."
  },
  "description": {
    "sub_id3": null,
    "sub_name": "職場英文",
    "sub_ename": "CAREER ENGLISH",
    "describe_ch": "有效率的英語溝通在任何成功的職涯中都是不可或缺的，因此本課程教導學生如何有效的在職場使用英文。本課程將著重於職場上的英文溝通技巧、文法及字彙，並增強台灣學生對不同文化的敏感度。",
    "describe_eh": "This course will teach students how to use the English they know already more effectively in a number of vocational environments. Effective communication is indispensable for success in any career. The focus will be on communication skills, with grammar and vocabulary work added as needed. A second focus will be on culture comparison because Taiwanese students usually lack sufficient exposure to non-Chinese cultural situations. Even with excellent English skills, communication can go terribly wrong because of unawareness of cultural differences. This course will be conducted in a workshop style requiring students to actively participate in role-play and other communicative exercises.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
