  "gradeRuleDescribe": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB02149",
    "sub_id": "87007",
    "scr_dup": "001",
    "tpa_score_new": null,
    "tpa_score_new_en": "<ul>\n\t<li>\n\t<div><strong>Attendance &amp; Participation (15%)</strong></div>\n\n\t<ul>\n\t\t<li>\n\t\t<div>Students are expected to attend class regularly and on time.</div>\n\t\t</li>\n\t\t<li>\n\t\t<div>Active participation in discussions, role-plays, Zuvio exercises, and AI-enhanced activities is required.</div>\n\t\t</li>\n\t</ul>\n\t</li>\n\t<li>\n\t<div><strong>Assignments (20%)</strong></div>\n\n\t<ul>\n\t\t<li>\n\t\t<div>Two written assignments are required (Unit 3 and Unit 5).</div>\n\t\t</li>\n\t\t<li>\n\t\t<div>Students may use AI tools for brainstorming, but final work must include <strong>personalized sentences</strong> and editing beyond AI.</div>\n\t\t</li>\n\t\t<li>\n\t\t<div>Late submission will result in a lower grade unless prior notice is given.</div>\n\t\t</li>\n\t</ul>\n\t</li>\n\t<li>\n\t<div><strong>Quizzes (15%)</strong></div>\n\n\t<ul>\n\t\t<li>\n\t\t<div>Two quizzes (Week 6 and Week 12) from the textbook units and AI exercises.</div>\n\t\t</li>\n\t\t<li>\n\t\t<div>Students must answer independently. Use of AI tools during quizzes is not allowed.</div>\n\t\t</li>\n\t</ul>\n\t</li>\n\t<li>\n\t<div><strong>Midterm Exam (25%)</strong></div>\n\n\t<ul>\n\t\t<li>\n\t\t<div>Conducted in <strong>Week 9</strong> as a group&nbsp;oral test.</div>\n\t\t</li>\n\t\t<li>\n\t\t<div>Students will answer questions based on Units 1&ndash;4 and demonstrate communication skills practiced in lectures.</div>\n\t\t</li>\n\t\t<li>\n\t\t<div>Evaluation includes fluency, accuracy, vocabulary use, and confidence.</div>\n\t\t</li>\n\t</ul>\n\t</li>\n\t<li>\n\t<div><strong>Final Presentation&nbsp;(25%)</strong></div>\n\n\t<ul>\n\t\t<li>\n\t\t<div>Group PPT presentations in <strong>Weeks 14&ndash;15</strong>.</div>\n\t\t</li>\n\t\t<li>\n\t\t<div>Each group presents on a textbook unit topic or AI workplace application.</div>\n\t\t</li>\n\t\t<li>\n\t\t<div>Evaluation includes content, language use, creativity, teamwork, presentation design (Canva/Gamma), and delivery.</div>\n\t\t</li>\n\t</ul>\n\t</li>\n</ul>\n",
    "course_pol": null,
    "course_pol_en": "Attendance and Participation\nRegular attendance and active participation are required. Students must engage in discussions, role-plays, and Zuvio activities. Contributions from classmates with different cultural and academic backgrounds are highly valued.\n\nUse of AI Tools\nCareer English exercises will integrate AI tools such as ChatGPT, Gemini, Grok, Gamma, Canva, Natural Reader, or Napkin. AI may be used for practice and idea generation, but final work must reflect personal effort and originality.\n\nAssignments and Quizzes\nAssignments must be submitted on time. Late submissions may lower grades. Quizzes must be completed independently, without the use of AI assistance.\n\nAcademic Integrity\nPlagiarism, cheating, or misuse of AI will not be tolerated and may result in penalties, including failing grades or disciplinary action.",
    "course_rem": null,
    "course_rem_en": "Be open to learning from classmates of different countries, departments, and majors. Respectful interaction and collaboration are expected.\n\nUse AI tools as a support, not as a substitute for your own learning. Edit and personalize all AI-generated content.\n\nParticipate actively in Zuvio exercises, group work, and presentations to strengthen your communication skills.\n\nStay consistent—attentive listening and active engagement will improve your English, AI literacy, and confidence in workplace communication.",
    "ais_meno": null,
    "ais_meno_en": "<div>Students must uphold academic honesty in all class activities, assignments, quizzes, and exams. AI tools may support learning, but final work must show personal effort and editing. Plagiarism, cheating, or unauthorized AI use will result in penalties, including failing the task or further disciplinary action. Respectful interaction and professionalism are also required.</div>\n",
    "ilearn_mk": "N"
  },
