  "description": {
    "sub_id3": null,
    "sub_name": "風險理財",
    "sub_ename": "RISK FINANCING",
    "describe_ch": "本課程介紹風險理財的概念過程與方法，包含保險概論、財產損失風險、責任損失風險的法定基礎、管理責任風險、個人損失風險、淨利損失風險、預防風險的方法以及現金流量分析。",
    "describe_eh": "The introduction of this course is to study financial risk management, and to establish a risk management program. Other issues, such as assessing property loss exposures, liability loss exposures, personnel loss exposures, net income loss exposures, understanding forecasting data on past losses, and applying cash flow analysis are mentioned.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能獲悉風險理財的基本概念",
      "describe_en": "To know the basic concepts of risk financing."
    },
    {
      "seq": 2,
      "describe_ch": "能應用專業知識來解決企業面臨重大損失風險的融資對策",
      "describe_en": "To apply the professional knowledge to solve the risk financing problems for a firm suffering from a big loss."
    }
  ],
