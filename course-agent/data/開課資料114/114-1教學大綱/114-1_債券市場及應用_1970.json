  "description": {
    "sub_id3": null,
    "sub_name": "債券市場及應用",
    "sub_ename": "BOND MARKETS AND THEIR APPLICATIONS",
    "describe_ch": "介紹債券市場與相關應用。課程內容含括: 債券評價、利率期間結構、利率風險衡量、信用風險衡量、利率衍生性商品、信用衍生性商品、可轉債、結構型商品、債券創新金融商品等議題。藉由財務統計軟體實際操作，加深對債券市場與相關應用的瞭解。",
    "describe_eh": "This course provides an introduction of bond markets and their related applications. The topics include the characteristics and applications of bonds, bond pricing, bond trading, term structure of interest rates, interest rate risk measurements, credit risk measurements, interest rate derivatives, credit derivatives, convertible bond, structured products, and innovation in bond markets. Software applications will also be introduced in this course.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解債券特性與應用、債券評價、債券投資之風險與報酬",
      "describe_en": "Gain an understanding of the characteristics and applications of bond markets, bond pricing, risk and returns for bond investment."
    },
    {
      "seq": 2,
      "describe_ch": "學習建構利率期限結構與衡量利率風險",
      "describe_en": "Learn to construct term structure of interest rates and measure interest rate risk."
    },
    {
      "seq": 3,
      "describe_ch": "學習應用軟體進行實例演練",
      "describe_en": "Develop a basic ability on software (Excel and VBA) applications"
    }
  ],
