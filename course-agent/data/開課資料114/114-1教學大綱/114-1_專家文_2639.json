  "description": {
    "sub_id3": null,
    "sub_name": "專家文",
    "sub_ename": "SPECIAL TOPICS ON CLASSICAL ESSAY",
    "describe_ch": "擇定現代文學中的散文作家及其文章為課程內容，以文史互證的方法，擇取一位，探討作品、作家與時代的關係，以及因為創作主體個性的差異、遭際的不同、地域環境的變遷所形成的時代特色。\r\n",
    "describe_eh": "Special Topics on Classical Essay, a 2-credit hour selective course, is offered by the Department of Chinese Literature in the Spring for senior students and has History of Chinese Literature and Selected Readings in Prose as prerequisites. 5 major writers selected from Yuan-ho era of Tang in this course are Han Yu, Liu Zong-Yuan, Bai Ju-Yi, Yuan Zhen, and Liu Yu-Hsi. Focusing on the literary characteristics of Yuan-ho era attested by literature and history, this course offers a critical study of the 5 selected writers' works, the relation between writers and time, and the time characteristics that change with writers' personalities and life experience in different regions.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能說出現代文學散文之代表作家的名字、能定義現代文學的年代。",
      "describe_en": " Define Yuan-ho era with knowing the 5 major writers and describes the genres in the era."
    },
    {
      "seq": 2,
      "describe_ch": "能理解並說明該作家的代表作品及其時代意義。",
      "describe_en": "Interpret 5 major writers' masterpieces of relegated literature in Yuan-ho era and the time meaning."
    }
  ],
