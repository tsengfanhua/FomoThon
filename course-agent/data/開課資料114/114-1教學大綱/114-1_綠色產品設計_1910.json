  "description": {
    "sub_id3": null,
    "sub_name": "綠色產品設計",
    "sub_ename": "GREEN PRODUCT DESIGN",
    "describe_ch": "在產品設計、製造時，必需考慮對環境衝擊的影響，滿足可持續發展(Substantial development)的要求。將從產品生命週期的觀念導入，滿足綠色產品設計目標，使產品為符合環保訴求之綠色產品。\r\n",
    "describe_eh": "Green product is considered to environment impact in product design 、manufacturing stage for substantial development needs。The product life cycle concept will be implemented in lesson to reduce environment damage for meeting green product requirement。\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1 瞭解綠色產品設計的發展方向，並能應用於新產品的開發。",
      "describe_en": "1 To understand the green product design mode of development in new product development。"
    },
    {
      "seq": 2,
      "describe_ch": "2具有綠色產品設計之思維。",
      "describe_en": "2 The concept for green product."
    },
    {
      "seq": 3,
      "describe_ch": "3 能夠選用適當之方法，進行設計符合綠色產品的設計。",
      "describe_en": "3 It will enable to apply the optimum method to meets the green product  design."
    }
  ],
