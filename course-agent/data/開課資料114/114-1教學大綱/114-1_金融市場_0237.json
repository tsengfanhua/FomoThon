  "description": {
    "sub_id3": null,
    "sub_name": "金融市場",
    "sub_ename": "FINANCIAL MARKETS",
    "describe_ch": "本課程介紹金融市場中的重要機構與工具，並協助學生理解金融市場與經濟變數間的關聯。主要議題包括：金融市場概論、金融市場與總體經濟變數間的關聯、貨幣市場、債券市場、股票市場、共同基金、資產證券化、外匯市場、衍生性金融市場、金融危機與改革、以及銀行經營策略。",
    "describe_eh": "The course introduces knowledge of important institutions and instruments in financial markets, and helps students comprehend effects resulted from financial markets on economic variables. Main topics include: introductions of financial markets, relationships between financial markets and economic variables, money markets, bond markets, stock markets, mutual funds, asset securitization, foreign exchange markets, derivative markets, financial crisis and revolution, and banking strategies.",
    "pre_subname": "ECON1001經濟學(一)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解各種金融市場之運作。",
      "describe_en": "To understand the mechanism of each financial market."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解金融機構之運作。",
      "describe_en": "To understand the mechanism of financial institution."
    }
  ],
