    "scr_dup": "001",
    "sub_title": "文史田野調查",
    "sub_title_en": null,
    "sub_describe": "文史田野調查的內涵，包含資料徵集以及田野訪問和田野觀察。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "地方文史田野調査",
    "sub_ename": "LOCAL LITERATURE AND HISTORY FIELDWORK",
    "describe_ch": "本課程旨在教授人文與歷史田野工作的基本觀念、技巧與方法。此外，鑒於傳統史料、圖像與實物之分析、考辨與應用，是田野調查的堅實基礎，兩者相互為用，不可偏廢，因而本課程也將著重於這方面基本能力之培養。一般而言，人文與歷史現象至少涵蓋了人與人、人與自然以及人與超自然三個面向，本課程將循此三面向設計專題，並考慮因應實際需要與限制，故擬以台中市（西屯）為案例之空間範圍，一方面提供通論性背景知識傳授，同時也將著重於實際田野踏勘之進行。",
    "describe_eh": "The course aims to teach basic concepts, techniques, and methods of humanities and historical fieldwork. In addition, since the analysis, identification and application of traditional historical materials, images and objects are the solid foundation of fieldwork, and the two are mutually reinforcing, this course also focuses on the cultivation of basic skills in this area. Generally speaking, humanities and historical phenomena cover at least three aspects: people and people, people and nature, and people and supernatural. The course designs topics based on these three aspects and takes into account the practical needs and limits of Taichung City (Xitun) as the spatial scope of the case. It provides general background knowledge and at the same time emphasizes on the actual fieldwork.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生了解田野調查作業相關流程，並能進行適度的操作。",
      "describe_en": "To understand the process related to fieldwork and perform appropriate operations"
    },
    {
      "seq": 2,
      "describe_ch": "使學生認識地方文史資源類型與功用。",
      "describe_en": "To recognize the types and functions of local literary and historical resources"
    }
  ],
