  "description": {
    "sub_id3": null,
    "sub_name": "財政學",
    "sub_ename": "PUBLIC FINANCE",
    "describe_ch": "綜觀公共經濟學的基礎內涵。探討市場失靈的原因以及政府在經濟活動中扮演的角色、公共財、外部性、公共選擇、公共支出計畫、租稅理論以及地方財政等課題。\r\n",
    "describe_eh": "The course aims to take a comprehensive look at the basic connotation of public economics. Discuss the causes of market failure and the role of government in economic activities, public finances, externalities, public choices, public expenditure plans, tax theory, and local finance.\r\n",
    "pre_subname": "ECON1001經濟學(一)、ECON1002經濟學(二)",
    "pre_sub_id3": "ECON1001",
    "pre_sub_ename": "ECON1001 ECONOMICS(1)、ECON1002 ECONOMICS(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解公共經濟學與福利經濟學的內涵",
      "describe_en": "To understand the contents of public economics and welfare economics"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解政府在增進市場效率上所扮演的角色",
      "describe_en": "To understand the economic role of government in resources allocations"
    },
    {
      "seq": 3,
      "describe_ch": "瞭解政府在增進社會公平上所扮演的角色",
      "describe_en": "To understand the economic role of government in income distributions"
    },
    {
      "seq": 4,
      "describe_ch": "瞭解租稅融通對效率和公平之影響",
      "describe_en": "To understand the incidence of government taxation"
    }
  ],
