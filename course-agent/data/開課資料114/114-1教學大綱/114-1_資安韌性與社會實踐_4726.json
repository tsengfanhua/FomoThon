      "describe_ch": "熟悉資訊倫理與風險管理的的政策與規範",
      "describe_en": "Policies and regulations on information-related ethics and risk management"
    },
    {
      "seq": 3,
      "describe_ch": "培養資訊安全實務能力",
      "describe_en": "Developing practical skills in information security"
    }
