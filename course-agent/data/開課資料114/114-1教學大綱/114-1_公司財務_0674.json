  "description": {
    "sub_id3": null,
    "sub_name": "公司財務",
    "sub_ename": "CORPORATE FINANCE",
    "describe_ch": "此為公司財務的進階研討課程，旨在熟悉財務資產評價、選擇權評價、風險與報酬分析、公司投資決策、資本結構決策、股利政策、衍生性金融商品與避險、財務績效評估、及國際財務管理等重要課題，強調課堂報告及課堂參與，學期中需作研究報告，以期將財務理論與實務予以融會貫通。",
    "describe_eh": "This is an advanced seminar course in the field of corporate finance.  It will discuss the major topics of financial asset valuation, option valuation, risk-return analysis, corporate investment decision, capital structure decision, dividend policy, and evaluation of financial performance, etc.  Research projects will be assigned to students.  The purpose is to familiarize graduate students with the theories and concepts learned from the class and apply them to the real financial world.",
    "pre_subname": "FINA2030財務管理(一)、FINA2031財務管理(二)",
    "pre_sub_id3": "FINA2030",
    "pre_sub_ename": "FINA2030 FINANCIAL MANAGEMENT(1)、FINA2031 FINANCIAL MANAGEMENT(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉並了解公司財務之內容。",
      "describe_en": "Understand the basic structure of financial statements.\n"
    },
    {
      "seq": 2,
      "describe_ch": "熟悉並了解財務報表，現值與未來值。",
      "describe_en": "Understand and explain the issues of present value and future value."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉並了解投資決策與財務決策內容與重要議題。",
      "describe_en": "Understand and explain the issues of investment policy and financial policy."
    },
    {
      "seq": 4,
      "describe_ch": "熟悉並了解資本預算內容與重要議題。",
      "describe_en": "Understand and explain the issues of capital budgeting."
    }
