  "description": {
    "sub_id3": null,
    "sub_name": "軟體品質與測試",
    "sub_ename": "SOFTWARE QUALITY ASSURANCE AND TESTING",
    "describe_ch": "本課程的目的是在使學生瞭解軟體工程的方法及其品質控制的觀念、理論與實務，特別是在軟體測試與檢驗方面。在理論方面包括軟體錯誤模式、測試涵蓋、 黑箱與白箱單元測試、整合測試、效能測試、系統測試、回歸測試、物件測試等主題。在實務方面強調工具及 DevOps 流程的使用。",
    "describe_eh": "The purpose of this course is to enable students to understand software engineering methods and the concepts, theories and practices of quality control, especially in software testing and inspection. Theoretical aspects include software error patterns, test coverage, black-box and white-box unit testing, integration testing, performance testing, system testing, regression testing, object testing and other topics. Practical aspects emphasize the use of tools and DevOps processes.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解瞭解軟體品質保證的重要性",
      "describe_en": "Understanding the importance of software quality assurance."
    },
    {
      "seq": 2,
      "describe_ch": "學習瞭解軟體測試理論",
      "describe_en": "Learning to understand software testing theory."
    },
    {
      "seq": 3,
      "describe_ch": "學習應用測試方法進行軟體測試",
      "describe_en": "Learning to apply testing methods for software testing."
    }
  ],
