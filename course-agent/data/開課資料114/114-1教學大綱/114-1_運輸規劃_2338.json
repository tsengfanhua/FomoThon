  "description": {
    "sub_id3": null,
    "sub_name": "運輸規劃",
    "sub_ename": "TRANSPORTATION PLANNING",
    "describe_ch": "介紹運輸規劃之基本理論與相關應用，使學生能了解運輸需求模式及運輸系統方案之方法與評估，並具有規劃與管理運輸系統之概念。",
    "describe_eh": "This course introduces the basic theories and applications of transportation planning. It could enhance the students to understand the transportation demand models and alternative evaluations for different transportation design. They should have the concepts of planning and management on transportation systems after this class.",
    "pre_subname": "TLOG1012經濟學、TLOG3013作業研究、TLOG2072地理資訊系統",
    "pre_sub_id3": "TLOG1012",
    "pre_sub_ename": "TLOG1012 ECONOMICS、TLOG3013 OPERATIONS RESEARCH、TLOG2072 GEOGRAPHIC INFORMATION SYSTEMS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 4.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "2.教授各運輸或物流系統之規劃、設計理論與實務概念",
      "describe_en": "2.Teaches the theoretical and practical concepts of planning and design for various transportation or logistics systems."
    },
    {
      "seq": 2,
      "describe_ch": "7.培養學生運用資訊科技或分析軟體處理實務問題之能力",
