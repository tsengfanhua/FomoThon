  "description": {
    "sub_id3": null,
    "sub_name": "流體力學試驗",
    "sub_ename": "FLUID MECHANICS LAB.",
    "describe_ch": "利用實驗操作來驗證與探討流體力學理論。內容包含流體黏滯性、 伯努力方程式、 靜水壓分佈、 紊流起始雷諾數、管路損失、管流量測、 堰流量測、渦流特性、動量撞擊實驗及流線可視化等十個項目。",
    "describe_eh": "Verify and learn fluid mechanics by doing experiments. Ten items including viscosity, Bernoulli equation, pressure distribution, Reynold's number, pipe loss, pipe discharge, weir discharge, vortex characteristics, momentum conservation, streamline visualization.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解實驗原理與重點",
      "describe_en": "1.\tUnderstand the physics principles and key arguments"
    },
    {
      "seq": 2,
      "describe_ch": "能執行實驗量測工作",
      "describe_en": "2.\tCan perform measurement task with accuracy"
    },
    {
      "seq": 3,
      "describe_ch": "對所量測的數據能加以繪圖,分析,並解釋",
      "describe_en": "3.\tData analysis, figure plotting, and translation of their physical meaning"
    },
    {
      "seq": 4,
      "describe_ch": "能小組分工,完成實驗報告",
      "describe_en": "4.\tFinishing experimental report with good team work"
    }
  ],
