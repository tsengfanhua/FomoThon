  "description": {
    "sub_id3": null,
    "sub_name": "通訊系統",
    "sub_ename": "COMMUNICATION SYSTEMS",
    "describe_ch": "本課程提供類比通訊系統的基本架構與原理，內容主要為使用線性非時變系統、傅利葉轉換、濾波器、隨機信號等基本工具來瞭解類比通訊中各式的調變與解調變方法、架構、應用與分析其表現，並以此為基礎能進一步的學習數位通訊原理。",
    "describe_eh": "The course provides the most fundamental structures and principles of analog communication systems. Contents include the use of LTI systems, Fourier transform, filters and random variables/processes to understand the methodologies, structures, applications and performance analyses of variable modulation/demodulation formula. And these knowledge can be used for the study of digital communications.",
    "pre_subname": "COME2023工程數學－機率論　　",
    "pre_sub_id3": "COME2023",
    "pre_sub_ename": "COME2023  ENGINEERING MATHEMATICS－PROBABILITY",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用自己的辭彙說明通訊的目的及應用，並瞭解通訊的系統架構與達成通訊的方法。",
      "describe_en": "Be able to illustrate the purposes and applications of communications in words, and understand the system structures and the methodology of achievement."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明通訊系統工程在社會及經濟層面的重要性及影響。",
      "describe_en": "Be able to illustrate the significance and effects of communication engineering in society and economics."
    }
  ],
