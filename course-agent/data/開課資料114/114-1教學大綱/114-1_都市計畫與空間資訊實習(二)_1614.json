  "description": {
    "sub_id3": null,
    "sub_name": "都市計畫與空間資訊實習(二)",
    "sub_ename": "URBAN PLANNING & SPATIAL INFORMATION STUDIO (2)",
    "describe_ch": "本課程旨在訓練學生進行鄉鎮等較小尺度的新訂都市計畫或都市計畫通盤檢討。學生分組團隊合作，內容包括工作計畫之擬定、資料的收集、整理與分析、未來發展之預測、替選方案之研擬與評估、報告之撰寫。",
    "describe_eh": "This course trains students to establish a new urban plan or review existing urban plan in a smaller size of urban settlements. Students work together and finish a project.  The major topics include the work plan formulation, data collection, field survey, future development forecast, alternative solution submitting and evaluation, and report writing.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 4,
      "describe_ch": "能理解都市計畫制訂的基本邏輯與都市計畫基本法令規章",
      "describe_en": "Comprehension for the basic logic of making urban plan and the basic undrstanding of urban planning laws and regulations .\r\n"
    },
    {
      "seq": 5,
      "describe_ch": "能理解永續環境的基本內涵",
      "describe_en": "Comprehension for the basic content of sustainable environment."
    },
    {
      "seq": 6,
      "describe_ch": "能應用溝通協調與團隊合作的成效解決問題",
      "describe_en": "Application of effects in communication, negotiation and team working to problem-solving.\r\n"
    }
  ],
