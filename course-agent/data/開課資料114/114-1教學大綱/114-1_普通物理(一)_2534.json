  "description": {
    "sub_id3": null,
    "sub_name": "普通物理(一)",
    "sub_ename": "GENERAL PHYSICS(1)",
    "describe_ch": "普通物理為奠定理工科系學生的基礎物理概念與知識，以利未來本系專業科目之修習。普通物理(一)的主題包含力學與熱力學。力學是規範物體運動的原則，熱力學則分別以微觀與巨觀探討氣體的物理特性。",
    "describe_eh": "General physics provides knowledge basis for all science and engineering students required for their advanced courses. General physics (1) includes the topics of mechanics and thermodynamics. Mechanics regulates fundamental principles of motion. Thermodynamics explains both of microscopic and macroscopic natures of gases and objects.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
