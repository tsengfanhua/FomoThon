  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟悉物理單位並會利用向量與微積分描述物體運動",
      "describe_en": "Be familiar with physical units and be able to use vector and calculus to describe object's motion."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解能量的意義並可應用於力學問題\t",
      "describe_en": "Understand the concept of energy and be able to solve mechanical problems in terms of energy."
    },
    {
      "seq": 3,
      "describe_ch": "熟悉基本之轉動、振動及波動相關物理\t",
      "describe_en": " Be familiar with the basic physics of rotation, oscillation, and waves."
    },
    {
      "seq": 4,
      "describe_ch": "瞭解並能應用基本熱力學定律\t",
      "describe_en": "Understand and be able to apply the  laws of thermodynamics."
    }
