  "description": {
    "sub_id3": null,
    "sub_name": "世界音樂賞析",
    "sub_ename": "WORLD MUSIC APPRECIATION",
    "describe_ch": "本課旨在瞭解音樂在人類文明史上所扮演的重要角色，並培養關懷人文環境與尊重多元文化的態度。以英文授課並閱讀原文書來幫助學生獲得更完善的跨國際知識。教師以問題導向引發學生的學習興趣，並培養主動解決問題的行動與能力。",
    "describe_eh": "This course aims at helping students understand the important role that music plays in human being's history, and developing the attitude of valuing humanitarianism as well as respecting the cultural diversity. This course will also help students obtain thorough cross-cultural knowledge by giving English lectures; students are required to read English textbooks as well. Students will be guided by strategies of problem-based learning, and encouraged to independently take actions to find solutions when facing learning problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過認識各國音樂，了解各地文化之多樣性",
      "describe_en": "Understand cultural diversity through learning music from around the world"
    },
    {
      "seq": 2,
      "describe_ch": "履行對多元文化尊重且開放學習的態度",
      "describe_en": "Implementing respect and appreciation toward other cultures with an open mind to learn from one another"
    }
  ],
