  "description": {
    "sub_id3": null,
    "sub_name": "設施規劃",
    "sub_ename": "FACILITY PLANNING",
    "describe_ch": "設施規劃是統整工業工程領域的專業知識，包括工作研究、物流、生管、人因等課程領域，可以應用於製造業或服務業的管理。",
    "describe_eh": "A facility planning is to integrate the domain of IE professional knowledge, which is included work study, material flow, operation management, human factor etc... The subject may apply to manufacture industry and service industry.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解設施規劃在產業狀況及其在經濟發展中扮演的重要性及影響。",
      "describe_en": "Understand and be able to explain the importance and effects of manufacture industry in economy developing."
    },
    {
      "seq": 2,
      "describe_ch": "整合工業工程的技能於設施規劃的製造或服務管理。",
      "describe_en": "Be able to integrate the I.E. methodological and computational skills with which to operate effectively within the manufacturing or service management."
    },
    {
      "seq": 3,
      "describe_ch": "具備職場有效溝通及團隊合作的能力。",
      "describe_en": "Be able to prepare to function effectively and provide leadership within an organization as an IE professional including an ability to form, facilitate, lead, coordinate, and participate in teams as well as understand organizational processes and behavior"
    },
    {
      "seq": 5,
      "describe_ch": "具備運用設施規劃原理發掘問題及利用科學方法解決問題能力。",
      "describe_en": "Be able to apply facilities planning principles to explore issues and ability to solve problems using the scientific method."
    }
  ],
