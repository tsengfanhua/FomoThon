  "description": {
    "sub_id3": null,
    "sub_name": "工程科技實務",
    "sub_ename": "ENGINEERING TECHNOLOGY PRACTICE AND APPLICATIONS",
    "describe_ch": "工程科技是工程的實際應用端，各領域工程技術人員與工程師或科學家合作，使人性化的設計從純理論領域變為現實，對現有流程進行改進或開發全新技術。在本課程中，旨在傳授並討論各領域工程技術相關的最新發展之科技研發，課程重心在透過網路媒體來探索最新各領域工程技術和實務上之應用。課程以IEEE國際電機電子工程師學會的主要領域來作分類，共分成航空、人工智慧、職場、生物醫學、計算、能源、消費電子、生活應用、綠色科技、機器人技術、半導體、傳感器、電信、運輸等單元。",
    "describe_eh": "Engineering technology is the practical application arm of engineering. Engineering technicians and technologists work in partnership with engineers or scientists to bring humanity-benefitting designs from the realm of pure theory into reality, developing improvements to existing processes or creating entirely new technologies. In this course, the up-to-date researches and developments related to engineering technology will be conveyed and discussed. Special emphasis will be on the latest product news on engineering technology and their applications. The course will be conducted into thirteen discipline topics on biomedical engineering, including: Aerospace, Artificial Intelligence, At Work, Biomedical, Computing, Energy, Gadgets, Geek Life, Green Tech, History, Robotics, Semiconductors, Sensors, Telecom, Transportation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解各工程科技主題的範圍與內涵，學習閱讀英文之生醫科技網路媒體、文章、報導與新聞的習慣與基本能力，了解生醫工程科技領域的研發動態與新近發展。",
      "describe_en": "To discover meaning and use of engineering technology related subjects and their contents; to develop basic skills in reading English version of engineering technology related web-media, reports, and news; and to recognize the recent researches and developments in engineering technology."
    },
    {
      "seq": 2,
      "describe_ch": "能擴展英文字彙與閱讀能力，並進一步去延伸閱讀各分類領域中的工程科技 。",
      "describe_en": "Enhance student’s vocabulary skill and analytical reading through the expanded reading subjects in engineering technology news."
    },
    {
      "seq": 3,
      "describe_ch": "對於課程中各單元所指定的工程科技主題，能進一步搜尋相關的英文文獻資料，進行深度分析，並探討其在工程實務之應用。",
      "describe_en": "Improve the analytical ability with the assigned topics in engineering technology through intensive reading and research of related references and explore future applications of the focused engineering technology in practical industrial and human life applications."
    },
    {
      "seq": 4,
      "describe_ch": "能以使用圖片暨多媒體工具，並以英文口頭方式將指定之程科技主題，在課堂上以進行導讀與分析報告。",
      "describe_en": "Present assigned engineering technology topics and guided studies in English oral form to classmates, teaching assistants, and the instructor.　"
    }
  ],
