  "description": {
    "sub_id3": null,
    "sub_name": "岩石力學",
    "sub_ename": "ROCK MECHANICS",
    "describe_ch": "本課程介紹岩石的材料特性、相關試驗、以及其工程應用。課程內容包括岩石基本物理性質、岩石強度、岩石變形、岩石滲透性、岩石現地應力、立體投影。本課程為大地技師必考的科目之一。",
    "describe_eh": " This course introduces the material characteristics of rocks, the corresponding test methods, and their engineering applications. The contents of the course are basic physical properties of rocks, rock strength, rock deformation, rock permeability, in-situ stress of rocks, and stereographic projection. This course is one of the required courses of the license examination for geotechnical engineer.",
    "pre_subname": "CE2071土壤力學、CE1001應用力學、CE2078材料力學",
    "pre_sub_id3": "CE2071",
    "pre_sub_ename": "CE2071 SOIL MECHANICS、CE1001 APPLIED MECHANICS、CE2078 MECHANICS OF MATERIALS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能認知並說明岩石力學在土木工程之工程應用及重要性。",
      "describe_en": "Be able to recognize and explain the applications and their importance of rock mechanics on civil engineering."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解各種強度、變形、滲透、現地應力試驗的特性與適用情形。",
      "describe_en": "Understand various testing techniques and their applicable situations for determining the rock strength, rock deformation, rock permeability, rock in-situ stress."
    },
    {
      "seq": 3,
      "describe_ch": "能以書面或口頭方式將所獲結果與同儕、助教及教師溝通。",
      "describe_en": "Be able to Communicate results in written or oral form to classmates, teaching assistant, and the instructor."
    },
    {
      "seq": 4,
      "describe_ch": "具有撰寫專業報告之初等能力",
      "describe_en": "Be able to write an elementary professional report."
    }
  ],
