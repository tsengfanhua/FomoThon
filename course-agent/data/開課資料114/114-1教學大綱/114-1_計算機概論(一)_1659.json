  "description": {
    "sub_id3": null,
    "sub_name": "計算機概論(一)",
    "sub_ename": "INTRODUCTION TO COMPUTER(1)",
    "describe_ch": "廣泛地認識電腦科學相關的主題，概述計算機中軟體與硬體相關的基本知識。課程主要為電腦原理的介紹，及使用計算機解決方法論與演譯法的問題。",
    "describe_eh": "The purpose of this course is to let the students know the related topics of Computer Science, and to state the knowledge of software/hardware in Computer Science. The course mainly focuses on the introduction of the Computer Science, and the use of computer to solve the problems of methodology and algorithm.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 7,
      "describe_ch": "介紹計算機相關軟硬體基本術語及觀念，使學生能以專業的詞彙做溝通。",
      "describe_en": "Knowledge for the basic technology terms of computer to help students to communicate with professional engineer."
    },
    {
      "seq": 8,
      "describe_ch": "使學生瞭解計算機運作原理以及各項影響計算機效能的關鍵技術。",
      "describe_en": "Comprehension for the computer hardware processing model and know the factors that will influence the performance of computer."
    },
    {
      "seq": 9,
      "describe_ch": "以C及C++語言的介紹為主軸，介紹現代高階語言的語法與程式設計的基本理念。",
      "describe_en": "Application for the features of modern high-level language by introducing the C and C++ language."
    }
  ],
