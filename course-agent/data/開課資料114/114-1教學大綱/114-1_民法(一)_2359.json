  "description": {
    "sub_id3": null,
    "sub_name": "民法(一)",
    "sub_ename": "CIVIL LAW(一)",
    "describe_ch": "本課程為提供非法律系學生熟知民法基礎理論並了解日常生活法律常識之課程。民法為規範人民私法行為之主要法律，內容廣泛，包括總則、債編、物權編、親屬編及繼承編，本課程將選擇合適主題介紹之。",
    "describe_eh": "This course want to let students have abilities to deal with any legal disputes in the life. Therefore, students should have knowledge about fundamental theories of civil law. The purpose of Civil Law is a specification for people’s private legal actions. It involves many dimensions in society. In order to handle many type of dispute which be happened in society, legislator made a lot of rules in Civil Law, including General Principle, Obligations, Right in Rem, Family and Succession. This course will pick suitable issues as course’s topics for students.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能認識生活中所發生之案例，何種案例會和民法發生關連。",
      "describe_en": " Be able to realize the cases occur in our life which are related to the Civil Law.　"
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解人與人之間會發生權利和義務的關係。",
      "describe_en": "Be able to understand that the relationship between right and obligation occurs among people.　"
    },
    {
      "seq": 3,
      "describe_ch": "能理解民法所規範之基本概念，並能分析民事案例的法律癥結點。\t",
      "describe_en": "Be able to understand the basic concepts regulated from the Civil Law, Be able to analyze the issues regarding the civil cases."
    },
    {
      "seq": 4,
      "describe_ch": "能找到民事案例所適用之民法條文，並能運用找到之民法條文至民事案例中，且知道解決民事案例如何依據民法。",
      "describe_en": "Be able to find out the codes of Civil Law which are suitable for the civil cases, Be able to apply the codes of Civil Law on the civil cases, and know how to solve the civil cases according to the Civi"
    }
  ],
