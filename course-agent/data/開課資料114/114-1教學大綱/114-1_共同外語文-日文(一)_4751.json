  "description": {
    "sub_id3": null,
    "sub_name": "共同外語文-日文(一)",
    "sub_ename": "COMMON FOREIGN LANGUAGE-JAPANESE (1)",
    "describe_ch": "本課程從日語的五十音教起，搭配選定教材讓學生循序漸進學習，熟習平假名、片假名及一般日常生活字彙、短語、常見句型與文法，例如日語形容詞的變化形式。透過聽説讀寫練習，培養學生的日語基礎溝通能力，並引導學生認識日本文化。\r\n",
    "describe_eh": "This course begins with the Japanese syllabary (hiragana and katakana) and, using selected materials, guides students to gradually acquire basic vocabulary, phrases, common sentence patterns, and grammar, such as adjective conjugations. Through listening, speaking, reading, and writing practice, students will develop fundamental Japanese communication skills while also gaining an introduction to Japanese culture.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "在課堂中或日常情境下，能夠理解簡單的日語句子，並能簡單的日語進行問答。",
      "describe_en": "Be able to understand simple Japanese sentences in class or in daily situations, and carry out basic question-and-answer exchanges in Japanese."
    },
    {
      "seq": 2,
      "describe_ch": "認識日本節慶、風俗習慣及日常應對禮儀等文化概念。",
      "describe_en": "Gain knowledge of Japanese cultural concepts, including festivals, customs, and everyday etiquette."
    }
  ],
