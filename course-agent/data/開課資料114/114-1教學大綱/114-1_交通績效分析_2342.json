  "description": {
    "sub_id3": null,
    "sub_name": "交通績效分析",
    "sub_ename": "TRAFFIC PERFORMANCE ANALYSIS",
    "describe_ch": "探討地區交控、高速公路交控以及兩者的整合區域交控，內容包括延滯估計、車流特性分析、服務水準定位、旅行時間估計以及號誌或儀控時制的設計與影響。",
    "describe_eh": "Discussing local street traffic control, freeway traffic control and coordination of both controls for specific corridors, by investigation on estimation of delay, analysis of traffic flows, definition of levels of service, calibration of travel time and timing design and the effect of signalization for local street and freeway ramp.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
