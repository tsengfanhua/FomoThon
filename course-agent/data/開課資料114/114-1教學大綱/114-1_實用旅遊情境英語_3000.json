  "description": {
    "sub_id3": null,
    "sub_name": "實用旅遊情境英語",
    "sub_ename": "TRAVEL ENGLISH",
    "describe_ch": "本課程目標在於提升學生未來在旅遊或從事旅遊相關行業的語言能力。課程設計著重於學習旅行中所需的語言句型。課程活動將有角色扮演和聽力練習，以確保學生熟悉課程內容。",
    "describe_eh": "The goal of this class is to prepare students either for travelling or working in the tourism industry. We will focus on learning language patterns in travel. There will be role play and listening practice to ensure familiarity with the material.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "1.透過運用旅遊相關單字及片語增進學生語言溝通能力，並成功運用在旅行或旅遊相關行業中。例如申請護照、機場及免稅店等等。",
      "describe_en": "1.Students use the vocabulary and phrases needed to be a successful traveler or worker in the tourism industry. i.e. passport, airport, duty-free, and so on."
    },
    {
      "seq": 2,
      "describe_ch": "2.透過進行小組簡報和活動來提升學生的合作學習技巧。例如: 角色扮演活動提供學生學習和旅遊相關的口語句型。",
      "describe_en": "2.Include group presentations and activities to carry out students’ cooperative skills. For instance, role play will be included as it gives students practice performing the oral language patterns that belong to the realm of travel."
    }
  ],
