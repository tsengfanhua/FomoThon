  "description": {
    "sub_id3": null,
    "sub_name": "環境與氣候變遷政策與法律",
    "sub_ename": "ENVIRONMENT AND CLIMATE CHANGE POLICIES AND LAW",
    "describe_ch": "本課程希望讓學生對於環境法理論及氣候變遷法的發展從政策到法律的發展有全面性的認識，讓學生從管制理論了解環境法的管制模式，並有能力與土地行政法的實務操作銜接，進一步與淨零國土的政策發展相吻合。",
    "describe_eh": "This course will teach students have comprehensive vision to know the development from policies to law on the areas of environmental law and climate change law. Through this course, students can understand the regulation models from regulation theories. Also, students have abilities to connect the practice of land administrative law. This course, further, will do the capacity-building on carbon negative, especially in the area of land use.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "訓練學生對環境及氣候變遷議題在法體系上有全面認識",
      "describe_en": "Train students have comprehensive vision on the issues of environment and climate change."
    },
    {
      "seq": 2,
      "describe_ch": "訓練學生熟悉環境與氣候變遷相關法規",
      "describe_en": "Train students know legal system in environmental law and climate change law."
    },
    {
      "seq": 3,
      "describe_ch": "訓練學生蒐集解決環境問題所需資訊的能力",
      "describe_en": "Train students have abilities to collect information for environment issues"
    }
  ],
