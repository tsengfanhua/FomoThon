  "description": {
    "sub_id3": null,
    "sub_name": "管理資訊系統",
    "sub_ename": "MANAGEMENT INFORMATION SYSTEMS",
    "describe_ch": "本課程著重在資訊科技與組織各層面的整合與應用，主要目標有四：(1)資訊科技的策略應用；(2)電子商務的衝擊；(3)資訊科技對個人、組織、與整個社會的影響；(4)流程管理與資訊科技。學生學習後應能整合各種不同教材(如個案、教科書、演講、以及報告等)，並應用於真實狀況。\r\n",
    "describe_eh": "This course focuses on the integration and application of information technology on the organization. The main goal is as follows: (1) strategic application of information technology; (2) Impact of e-commerce; (3) the impact of Information technology on individuals, organization, and society; (4) Process management and information technology. Students should be able to combine all kinds of teaching material after the study (such as case, textbook, lecture, and report,etc.), and apply to the true state.\r\n",
    "pre_subname": "BUS1111資訊網路",
    "pre_sub_id3": "BUS1111",
    "pre_sub_ename": "BUS1111 INTRODUCTION TO INTERNET",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解管理資訊系統之基本觀念及方法。",
      "describe_en": "Understand and be familiar with the basic elements and concepts of information system"
    },
    {
      "seq": 2,
      "describe_ch": "瞭解資訊系統的應用，例如：ERP、CRM、EC應用等。",
      "describe_en": "Understand the application of information system: ERP, CRM, and E-Commerce"
    },
    {
      "seq": 4,
      "describe_ch": "瞭解資訊系統管理與經營",
      "describe_en": "Understand the management of information system"
    }
  ],
