  "description": {
    "sub_id3": null,
    "sub_name": "工程數學(一)",
    "sub_ename": "ENGINEERING MATHEMATICS(1)",
    "describe_ch": "本課程旨在教導學生解決工程或應用科學中實際問題所需之相關微分方程式。課程內容涵蓋單元有一階常微分方程式、二階線性常微分方程式、齊次與非齊次微分方程式、偏微分方程式、微分方程組之觀念與求解。",
    "describe_eh": "This course introduces students to those areas of mathematics which are most important in connection with practical problems. Five topics are included in the course：(1)First-order ordinary differential equations; (2)Linear ordinary differential equations of second order; (3)Homogeneous and nonhomogeneous differential equations; (4)Basic concept of partial differential equations; (5) Systems of differential equations.",
    "pre_subname": "MATH1001微積分(一)、MATH1002微積分(二)、MATH1001P微積分(一)實習、MATH1002P微積分(二)實習",
    "pre_sub_id3": "MATH1001",
    "pre_sub_ename": "MATH1001 CALCULUS(1)、MATH1002 CALCULUS(2)、MATH1001P RECITATION OF CALCULUS (1)、MATH1002P RECITATION OF CALCULUS (2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習如何建立微分方程。",
      "describe_en": "To learn how to build up the ordinary differential equations."
    },
    {
      "seq": 2,
      "describe_ch": "學習各種微分方程之解法。",
      "describe_en": "To learn various methods to solve the ordinary differential equations."
    },
    {
      "seq": 3,
      "describe_ch": "學習矩陣與拉普拉斯轉換法。",
      "describe_en": "To learn the matrix and the Laplace transform method."
    }
  ],
