  "description": {
    "sub_id3": null,
    "sub_name": "高等伺服控制",
    "sub_ename": "ADVANCED SERVO CONTROL",
    "describe_ch": "了解什麼是與馬達(包括直流、同步、感應、步進和線性馬達)有關的伺服控制，說明在嵌入式的運動控制單元、驅動器或者PC電腦上如何實現與設計伺服控制",
    "describe_eh": "To understand what are motors(including DC、Synchronous、Inductive、Step and Linear motors) and the related servo controls which are embedded in motion controller or driver or PC computer",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解伺服控制的應用。",
      "describe_en": "Understand the application of the servo control."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明如何設計與實現伺服控制系統，包括古典控制、現代控制、數位控制以及MATLAB軟體。",
      "describe_en": "Understand and explain how to design and implement the servo control system, including the classical control, modern control, digital control and MATLAB software package."
    },
    {
      "seq": 3,
      "describe_ch": "能使用相關控制理論，完成控制系統之分析、設計、模擬與驗證。",
      "describe_en": "Be able to use the related control theorem to finish the analysis, design, simulation and validation."
    },
    {
      "seq": 4,
      "describe_ch": "學習如何使用MATLAB來完成控制系統之模擬與驗證。",
      "describe_en": "Learn how to use MATLAB to accomplish the simulation and validation of the control system."
    }
  ],
