  "description": {
    "sub_id3": null,
    "sub_name": "鋼筋混凝土",
    "sub_ename": "REINFORCED CONCRETE",
    "describe_ch": "本課程教導學生如何去分析設計鋼筋混凝土構材。課程內容包含 (1) 基本材料行為的認識，(2) 設計規範與設計方法的介紹，(3) 樑之撓曲與剪力的分析設計，(4) 版及柱的分析與設計。",
    "describe_eh": "This course introduces students how to analyze and design reinforced concrete members.The contents of the course are: (1) fundamental material behaviors of concrete\nand steel reinforcement; (2) introductions to the ultimate strength design method and the ACI Building Codes; (3) flexural and shear analysis/design of reinforced concrete\nbeam;(4) analysis/design of slab and column",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "獲得鋼筋與混凝土基本材料行為相關的知識。\r\n",
      "describe_en": "Obtain the knowledge of the fundamental material behaviors of concrete and reinforcing bars. \r\n"
    },
    {
      "seq": 2,
      "describe_ch": "能具備鋼筋混凝土樑初步分析與設計之能力。\r\n\r\n",
      "describe_en": "Be able to perform preliminary analysis and design of a reinforced concrete beam."
    },
    {
      "seq": 3,
      "describe_ch": "能理解鋼筋混凝土版及柱的分析與設計。\r\n\r\n",
      "describe_en": "Be able to understand the analysis and design of slab and column."
    }
  ],
