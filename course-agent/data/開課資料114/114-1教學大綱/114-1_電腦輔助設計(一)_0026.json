  "textBooks": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "AS03120",
    "sub_id": "56523",
    "scr_dup": "001",
    "tpb_seq": 1,
    "tpb_book": "<div>\n<div>AutoCAD 2022 電腦繪圖職訓寶典 李坤松 旗標</div>\n\n<div>SketchUp 2022 室內設計繪圖講座 李坤松 旗標</div>\n</div>\n\n<div>SketchUp Pro Certified原廠中文教材(適用2014－2018版本) Zeus轡鴻 深石數位科技<br />\nGoogle sketchup 8 設計實感與快速繪圖表現 陳麗娥 李盛明 碁峰資訊</div>\n",
    "tpb_book_en": null
  },
  "readings": {
