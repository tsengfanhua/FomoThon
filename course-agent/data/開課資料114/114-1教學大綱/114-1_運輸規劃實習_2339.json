  "description": {
    "sub_id3": null,
    "sub_name": "運輸規劃實習",
    "sub_ename": "TRANSPORTATION PLANNING PRACTICE",
    "describe_ch": "本運輸規劃實習課程著重於計畫導向式學習(PBL)，配合課程的理論介紹與規劃範疇設定，藉由運輸規劃軟體學習(Cube voyage)以及小範圍的參數調查與模式建構，讓學生充分了解運輸需求模式及運輸系統方案之評估，並強化理論與實務的學習。",
    "describe_eh": "This practice course focus on the project based learning. Following the introduction of theory on transportation planning and the definition of semester project, the students have to learn the software “cube voyage” and the skills of sample survey. It could enhance the students to understand the transportation demand models and alternative evaluations for different transportation design in order to reinforce the learning of theory and practice.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "各類交通運輸系統的特性以及運作概念",
      "describe_en": "Understand characteristics and operation concept of various transportation systems."
    },
    {
      "seq": 2,
      "describe_ch": "各種不同運輸工程之規劃、施工、營運等概念",
      "describe_en": "Understand plan, construction, operation and management of various transportation systems."
    },
    {
      "seq": 3,
      "describe_ch": "國內外之交通運輸時事及政策加以評析",
      "describe_en": "Be aware of and be able to comment on transportation current events and policies."
    }
  ],
