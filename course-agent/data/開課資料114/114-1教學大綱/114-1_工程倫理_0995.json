  "description": {
    "sub_id3": null,
    "sub_name": "工程倫理",
    "sub_ename": "ENGINEERING ETHICS",
    "describe_ch": "本課程旨在傳授工程倫理，藉以鼓勵學生於未來的工程師職業生涯中盡職負責，對雇主保守企業機密，對社會大眾之安全、健康及福祉負責，及在利益與道德衝突時所應具備的專業倫理議題。",
    "describe_eh": "The objective of Introduction to Civil Engineering (II) is to teach engineering ethics. Therefore, students will be encouraged to have professional responsibility and obligation, to protect trade secrets and confidentiality, to protect public safety, health and welfare, and to have professional ethic in the face of conflicts between interests and morals in their future career as an engineer.",
    "pre_subname": "CE1013土木工程概論",
    "pre_sub_id3": "CE1013",
    "pre_sub_ename": "CE1013 INTRODUCTION TO CIVIL ENGINEERING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生理解工程師對整體社會的責任。",
      "describe_en": "Comprehension of the responsibility of engineers on the whole society."
    },
    {
      "seq": 2,
      "describe_ch": "藉由專業思辨提昇學生面對工程倫理難題的能力。",
      "describe_en": "To promote students' capability in facing the related difficulties of engineering ethics through professional thinking and differentiating."
    },
    {
      "seq": 3,
      "describe_ch": "能撰寫及簡報一份工程倫理報告。",
      "describe_en": "To have the capability to write and briefly report a engineering ethics report."
    }
  ],
