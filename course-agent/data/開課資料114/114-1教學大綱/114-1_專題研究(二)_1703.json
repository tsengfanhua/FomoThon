  "description": {
    "sub_id3": null,
    "sub_name": "專題研究(二)",
    "sub_ename": "SPECIAL TOPICS STUDY (2)",
    "describe_ch": "為訓練學生運用所學電機專業知識，應用於學術研究。體驗專案計畫之規劃程序，並學習論文之寫作技巧與要領。",
    "describe_eh": "In order to train students to use the professional knowledge of the electrical engineering studied, apply to research of the thesis. Experience the planning procedure that the special project planned, and study the writing technique of the thesis and main point.",
    "pre_subname": "EEEN4926專題研究(一)",
    "pre_sub_id3": "EEEN4926",
    "pre_sub_ename": "EEEN4926 SPECIAL TOPICS STUDY (1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能用專業定理應用於學術研究中，執行與驗證各項專業定理，其中包括資料的蒐集、維護、管理與理論的測試。",
      "describe_en": " When can apply to study in research of the thesis the theorem, carry out and verify every theorem, including the collection, maintenance, test of management and theory of the materials."
    },
    {
      "seq": 2,
      "describe_ch": "能瞭解並說明各項學術研究之方法與進行程序。",
      "describe_en": " The research approach of the thesis and the carrying on the procedure of the thesis, can be understood and explained."
    },
    {
      "seq": 3,
      "describe_ch": "能針對一個特定有關學術研究，適切歸納出結論。",
      "describe_en": "Can sum up the conclusion properly to studying in a specific thesis."
    },
    {
      "seq": 4,
      "describe_ch": "能以書面及口頭方式將所研究結果發表。",
      "describe_en": "Communicate results in written or oral form to classmates, teaching assistants, and the instructor."
    }
  ],
