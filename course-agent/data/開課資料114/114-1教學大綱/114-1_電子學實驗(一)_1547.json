  "description": {
    "sub_id3": null,
    "sub_name": "電子學實驗(一)",
    "sub_ename": "ELECTRONICS LAB.(1)",
    "describe_ch": "電子學實驗課教育之目的在於培養學生對於儀器使用量測與電子元件的使用。在課程上以實作為主，軟體模擬分析為輔，兩者互相對照並與理論分析之結果比較。電子學實驗(一)的課程包括(1)二極體元件理論與應用電路(2)BJT電晶體元件理論與基本數位開關應用電路(3)BJT電晶體小信號放大器。",
    "describe_eh": "The intent of the electronic experiment is to educate the students to operate the equipment and electronic devices. In class, it is focus on practice, and simulator is aided. Collating them and comparing with the result of theory analysis. The content of the class includes (1) Theory of diode and its application circuit. (2) Theory of BJT and basic digital switch circuit. (3) BJT small signal amplifier.　",
    "pre_subname": "ELEN2002電子學(一)",
    "pre_sub_id3": "ELEN2002",
    "pre_sub_ename": "ELEN2002 ELECTRONICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "具有電子元件與其在電子電路實驗中的應用知識。　",
      "describe_en": "Have the basic knowledge of practical electronic devices, and its application in electronic circuit experiment."
    },
    {
      "seq": 2,
      "describe_ch": "具備實驗管理、團隊解決問題與有效溝通的能力。",
      "describe_en": "Be able to manage experimental project and cooperate with team members."
    },
    {
      "seq": 3,
      "describe_ch": "能使用模擬軟體模擬並且應用於實驗結果的對照。",
      "describe_en": "Be able to apply the circuit simulator to verify their measured results."
    },
    {
      "seq": 4,
      "describe_ch": "能具體整理資料撰寫實驗報告。",
      "describe_en": "Have the knowledge of writing a complete experimental report."
    }
  ],
