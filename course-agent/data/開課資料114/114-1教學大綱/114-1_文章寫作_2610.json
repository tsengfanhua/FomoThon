  "description": {
    "sub_id3": null,
    "sub_name": "文章寫作",
    "sub_ename": "LITERARY ARTICLE WRITING",
    "describe_ch": "透過作品研讀、文學理論，與實務創作，鍛鍊語言表述能力，強調藝術化的表現形式，並且藉由實務創作的檢討，深化學習效果。",
    "describe_eh": "This course aims to train students on the skills to express language through detail studies of literature, literary theories, and hands on experience of producing literary work. Throughout the course, the emphasis will be on artistic presentation of the literature and the evaluation of student’s own literary work in order for students to have deeper and concrete understanding of the lessons taught.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "鍛鍊採訪及報導的寫作",
      "describe_en": "To train writing for the mass media through conducting interviews and reporting."
    },
    {
      "seq": 2,
      "describe_ch": "鍛鍊文學藝術的創作及鑑賞",
      "describe_en": "To practice the production and appreciation of artistic literature."
    }
