  "description": {
    "sub_id3": null,
    "sub_name": "工廠加工實務(一)",
    "sub_ename": "WORKSHOP PRACTICE (1)",
    "describe_ch": "訓練工具機操作，瞭解工具機結構原理及應用，其中包含如何正確的使用工具機、如何正確的使用相關量測儀器及在機械工場或操作工具機時如何的避免意外發生等問題。",
    "describe_eh": "To give students a basic training in the operation of machine tools, and to help them understand the relating fundamentals and applications of machine tools. It covers the introduction that how to operate these machine tools properly, how to use these relating measurement instruments properly and how to avoid accidental happening in a machine shop or in the operation of machine tools.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識機械工場設備及安全管理，及基本機械加工機之功能與操作方法有基本的了解並去除學生對操作常用之機械加工機之恐慌，增加機械加工專業知識。",
      "describe_en": "To know both the equipments and safety management of machine shop, and have a basic understanding of both the function and operating method of common machine tools. To delete the students fear when they operate common machine tools, and to increase the sp"
    },
    {
      "seq": 2,
      "describe_ch": "對常用手工具及切削刀具有基本的了解。",
      "describe_en": "The students can know the use of both common hand tools and machine cutters.　"
    },
    {
      "seq": 3,
      "describe_ch": "對焊接作業法有基本的了解。",
      "describe_en": "The students can understand the basic welding work.　"
    },
    {
      "seq": 4,
      "describe_ch": "使學生瞭解CNC工具機及其基本操作，並書寫程式。能有效率的加工元件，並節省廢料",
      "describe_en": "To understand both the function and the basic operation of CNC tools. Then, the students can write the CNC program."
    },
    {
      "seq": 5,
      "describe_ch": "瞭解以CNC加工生產有益於人類之產品。",
      "describe_en": " "
    }
  ],
