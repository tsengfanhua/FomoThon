  "description": {
    "sub_id3": null,
    "sub_name": "數位信號處理實驗",
    "sub_ename": " DIGITAL SIGNAL PROCESSING LAB.",
    "describe_ch": "為配合數位信號處理一課程的理論有實際上的明瞭，本實驗課使用應用軟體來作各項觀念及技術的模擬。實驗的內容配合數位信號處理課程，其中包含有數位信號與系統的介紹、離散傅立葉轉換、取樣、z 轉換、數位濾波器、快速傅立葉轉換等。",
    "describe_eh": "To further understand the theoretical concepts and techniques about DSP, the Lab course uses an application software to implement and simulate these concepts and techniques. The contents of the lab follows the ones in DSP course, which includes discrete-time signals and systems, discrete-time Fourier Transform, sampling, z-transform, digital filters, Fast Fourier Transform, and so on.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能應用程式撰寫模擬離散信號及系統的各類數學模型。",
      "describe_en": "To apply software programming to simulate various mathematical models of discrete-time signals and systems."
    },
    {
      "seq": 2,
      "describe_ch": "能應用程式撰寫模擬z轉換並應用z轉換進行離散系統的分析。",
      "describe_en": "To apply software programming to simulate z-transform and to utilize z-transform to analyze discrete-time systems."
    },
    {
      "seq": 3,
      "describe_ch": "能應用程式撰寫模擬離散傅立葉轉換並進行離散系統的分析。",
      "describe_en": "To apply software programming to simulate Fourier transform and to utilize Fourier  transform to analyze discrete-time systems."
    },
    {
      "seq": 4,
      "describe_ch": "能以口頭及書面方式將實驗結果與教師溝通。",
      "describe_en": "To communicate experimental results with the instructor in oral and written forms."
    }
  ],
