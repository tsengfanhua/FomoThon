  "description": {
    "sub_id3": null,
    "sub_name": "高等財務會計",
    "sub_ename": "ADVANCED FINANCIAL ACCOUNTING",
    "describe_ch": "本課程目標在於幫助學生以投資人和經理人之觀點，來對於當前之財務會計及財務報導的環境有所了解；並以研讀目前財務會計界最新最具代表性之文獻，來幫助學生對此領域有更深的認識。課程內容主題包括有財務報導之決策有用性、效率市場理論、代理理論、盈餘管理、財務會計準則制定與證券市場規範等相關議題。",
    "describe_eh": "This course gives the student an understanding of the current financial accounting and reporting environment, taking into account the diverse interests of external users and management. The relevant empirical evidence on financial accounting, including agency theory and earnings management, will also be discussed.",
    "pre_subname": "ACCT2003中級會計學(一)、ACCT2004中級會計學(二)",
    "pre_sub_id3": "ACCT2003",
    "pre_sub_ename": "ACCT2003 INTERMEDIATE ACCOUNTING(1)、ACCT2004 INTERMEDIATE ACCOUNTING(2)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解並會應用公平價值觀念於財務資訊之報導。",
      "describe_en": "To understand and apply the concept of fair values in financial reporting."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解並會應用實證會計理論於研究工作。",
      "describe_en": "To understand and apply positive accounting theory in research."
    }
  ],
