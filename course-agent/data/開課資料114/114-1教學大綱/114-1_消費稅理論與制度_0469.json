  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB05132",
    "sub_id": "36830",
    "scr_dup": "001",
    "sub_title": "消費稅理論與制度",
    "sub_title_en": null,
    "sub_describe": "本課程目的是從法規面和實務面介紹消費稅，課程教授主題廣泛，包括消費稅的原理與沿革，現行消費稅制度的執行，及近年來消費稅面臨的課題，兼重消費稅理論與實際執行的探討。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "消費稅理論與制度",
    "sub_ename": "THEORY AND SYSTEM OF CONSUMPTION TAX",
    "describe_ch": "介紹消費稅基本理論〈如消費稅的課徵原則、消費稅的歸宿、消費稅與所得稅的比較〉，以及我國現行消費稅制度與政策。探討營業稅、貨物稅、關稅、使用牌照稅、娛樂稅、印花稅及菸酒稅等課稅議題。",
    "describe_eh": "This course provides a framework of consumption tax theory such as the principles of consumption taxation, consumption tax incidence, and Consumption taxation vs. Income taxation and introduces our current consumption tax systems and policies. Discuss Business Tax, Commodity Tax, Customs Duties, Licence Tax, Amusement Tax, Stamp Tax, and Tobacco and Alcohol Tax.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解我國現行消費稅制度及法規",
      "describe_en": "Able to understand the current consumption tax system and regulations"
    },
    {
      "seq": 2,
      "describe_ch": "能應用消費稅法從事租稅申報",
      "describe_en": "Proficient in applying the Consumption Tax Act for tax declaration purposes"
    }
  ],
