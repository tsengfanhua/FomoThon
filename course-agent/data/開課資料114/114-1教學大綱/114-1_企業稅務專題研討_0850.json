  "description": {
    "sub_id3": null,
    "sub_name": "企業稅務專題研討",
    "sub_ename": "SEMINAR ON ENTERPRISES TAXATION",
    "describe_ch": "本課程主要針對特定的企業稅務研究主題，全面詳細地介紹現行的企業租稅制度、法律、法規和實務，包括與企業稅務處理有關的最新租稅政策，並要求學生完成企業租稅專業報告，以因應企業經營的需要。",
    "describe_eh": "This course focuses on specific enterprises taxation research topics, and comprehensive detailed of currently implemented enterprises tax system, laws, regulations and practices, includes the latest taxation policies relating to handling of enterprises taxation, and requires students to complete professional report of enterprises tax to meet the needs of business operations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解企業稅務問題並提升稅務處理專業知識，具備清晰表達與溝通能力",
      "describe_en": "To understand enterprise taxation issues and enhance professional knowledge of tax handling, while developing the ability to clearly express and communicate tax-related information."
    },
    {
      "seq": 2,
      "describe_ch": "運用稅務專業知識分析並解決企業稅務問題，具備溝通與協作的能力",
      "describe_en": "To apply taxation professional knowledge to analyze and resolve enterprise taxation issues, while developing communication and collaboration skills."
    }
  ],
