  "description": {
    "sub_id3": null,
    "sub_name": "計量經濟學(一)",
    "sub_ename": "ECONOMETRICS(1)",
    "describe_ch": "這是一門中級計量經濟學課程，針對研一學生而開的，學生除可學習基本計量經濟學之概念外，還可學習如何操作計量電腦軟體，教導學生如何將計量經濟學應用在學術研究上。",
    "describe_eh": "This is an intermediate econometrics course for the first year graduate students.  For those students who attend in this class can learn the basic concepts of econometrics and how to the use computer package. Students can learn how to apply advanced econometrics techniques in their academic research.",
    "pre_subname": "STAT1001統計學(一)、STAT1002統計學(二)、ECON3008計量經濟學",
    "pre_sub_id3": "STAT1001",
    "pre_sub_ename": "STAT1001 STATISTICS(1)、STAT1002 STATISTICS(2)、ECON3008 ECONOMETRICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解迴歸模型的估計。",
      "describe_en": "Comprehension for the estimation of the linear regression model."
