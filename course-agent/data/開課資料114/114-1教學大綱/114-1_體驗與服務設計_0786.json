  "description": {
    "sub_id3": null,
    "sub_name": "體驗與服務設計",
    "sub_ename": "EXPERIENCE AND SERVICE DESIGN",
    "describe_ch": "本課程以設計思考方法為基礎，介紹服務設計的概念、基本工具與流程，重心置於使用者經驗研究與洞見探索。課程目的為(1)使用者體驗與服務流程整體脈絡分析，(2)加強定義問題與提供創意設計方案的能力，(3)練習視覺化溝通，(4)奠定發展創新服務的基礎。課程以實作為主，主題兼容商業服務、策展、公共部門與非營利組織。",
    "describe_eh": "User experience and service design is to plan and reorganize different components of a service to improve the interaction and communication between service provider and users. The course focuses on both design methods and processes. Students will learn several user experience and service design techniques and go through a complete development process, from identifying problems and opportunities, developing design concepts, to prototyping.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "培育學生開發體驗與服務流程的設計能力。",
      "describe_en": "Develop students' ability of developing experience and service design."
    },
    {
      "seq": 2,
      "describe_ch": "培育學生分析體驗與服務其中的細節脈絡及分流程之能力",
      "describe_en": "Develop students' ability of analyzing service components and detailed experience contexts."
    },
    {
      "seq": 3,
      "describe_ch": "培育學生分析客戶需求之能力",
      "describe_en": "Develop students' ability of identifying customers' needs."
    }
  ],
