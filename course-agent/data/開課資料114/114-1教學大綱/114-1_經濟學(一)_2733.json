  "description": {
    "sub_id3": null,
    "sub_name": "經濟學(一)",
    "sub_ename": "ECONOMICS(1)",
    "describe_ch": "讓學生從經濟學的課程中瞭解經濟體系中的消費者、生產者、及政府單位如何在有限制的條件下做選擇。將理論的邏輯推理運用在日常生活當中。",
    "describe_eh": "Economics explains how consumers, producers, and the government make their best decisions based on the different constraints. Students can apply the theory of Economics to deal with their problems in real life.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 37,
      "describe_ch": "理解基本的經濟問題，供需原理，價格機能的運作及相關實例之應用。",
      "describe_en": "Comprehending fundamental economic issues, the principles of supply and demand, the price mechanism and their applications."
    },
    {
      "seq": 38,
      "describe_ch": "理解市場失靈之原因及其對策。",
      "describe_en": "Comprehending the main causes of market failure and possible means of correction."
    },
    {
      "seq": 39,
      "describe_ch": "瞭解廠商的生產與成本理論。",
      "describe_en": "Comprehending firm's production function and cost theories."
    },
    {
      "seq": 40,
      "describe_ch": "理解不同的市場結構，及廠商的訂價行為。",
      "describe_en": "Comprehending different types of market structure, and the pricing behavior of firms."
    }
  ],
