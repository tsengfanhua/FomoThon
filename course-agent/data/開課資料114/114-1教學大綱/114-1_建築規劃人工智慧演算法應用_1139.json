  "description": {
    "sub_id3": null,
    "sub_name": "建築規劃人工智慧演算法應用",
    "sub_ename": "THE APPLICATION OF AI ALGORITHM IN ARCHITECTURE PLANNING",
    "describe_ch": "本課程核心目的是指導學生如何應用一些人工智慧演算法來處理一些建築規劃上的問題。因此，本課程分為兩種主要內容：(一)人工智慧演算法介紹及一些相關應用；(二)實際執行專案來應用人工智慧演算法。",
    "describe_eh": "The main purpose of this course is focused on teaching students how to apply several Artificial Intelligent (AI) Algorithm in Architecture planning problems. This course consists of two sections: the first part is the introduction of AI algorithms and some relevant applications; the second part is the practice of AI application with some real projects.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解人工智慧演算法的發展及一些重要AI演算法知識內涵",
      "describe_en": "Comprehension for the development of AI and the important knowledge of some crucial AI algorithm"
    },
    {
      "seq": 2,
      "describe_ch": "能應用人工智慧演算法技術解決建築規劃上的問題",
      "describe_en": "AI technique Application for some problems in the process of Architecture planning"
    },
    {
      "seq": 3,
      "describe_ch": "藉由人工智慧演算法技術分析建築規劃決策知識的內涵",
      "describe_en": "To analyze the decision-making process of Architecture planning by the logic meaning of AI algorithm"
    }
