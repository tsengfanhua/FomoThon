  "description": {
    "sub_id3": null,
    "sub_name": "代數學(一)",
    "sub_ename": "ALGEBRA(1)",
    "describe_ch": "課程內容主要是在介紹抽象代數中最基本的代數結構: 群、環、體與同態映射等的基本理論以及其些許相關應用。",
    "describe_eh": "The course content mainly introduces the basic algebraic structures in the field of abstract algebra: groups, rings, fields and homomorphic mappings. We will discuss their basic theories and some of their applications.",
    "pre_subname": "MATH1051數學導論",
    "pre_sub_id3": "MATH1051",
    "pre_sub_ename": "MATH1051 INTRODUCTION TO MATHEMATICS",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解各種代數結構之知識與計算.",
      "describe_en": " Comprehension of algebraic structures and related computations \n"
    },
    {
      "seq": 2,
      "describe_ch": "應用代數結構之觀念到工程,資訊科學,與通訊之領域.",
      "describe_en": " Application of the concepts of algebraic structures to the fields of engineering, information science, and communications."
    },
    {
      "seq": 3,
      "describe_ch": "定理證明與邏輯思考之訓練",
      "describe_en": "Proofs of the Theorems and the training on logical thinking.\r\n"
    }
