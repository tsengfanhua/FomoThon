  "description": {
    "sub_id3": null,
    "sub_name": "機械冶金學(一)",
    "sub_ename": "MECHANICAL METALLURGY(1)",
    "describe_ch": "機械冶金學（一）旨在教導學生以力學及冶金之基本原理，應用到各種材料試驗及金屬之塑性成型。涵蓋之單元有材料彈性行為之應力應變關係、塑性理論之基礎、單晶之塑性變形、差排理論及各種強化機構，學生將可利用差排理論來解釋金屬材料塑性變形之各種機械性質。",
    "describe_eh": "The mechanical and metallurgical fundamentals are introduced in this course. Based upon them, applications to materials testing and various plastic forming of metals are also lectured. Five topics are included in the cours : Stress and Strain Relationships for Elastic Behavior, Elements of the Theory of Plasticity, Plastic Deformation of Single Crystals, Dislocation Theory, and Strengthening Mechanisms. The mechanical properties of metals after plastic deformation can be explained using related dislocation theories.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習材料彈性行為之應力應變關係及塑性理論之基本原理， 以奠定良好之力學基礎。",
      "describe_en": "To learn the stress and strain relationships for elastic behavior and the elements of the theory of plasticity to establish the foundation of mechanics."
    },
    {
      "seq": 2,
      "describe_ch": "學習單晶之塑性變形、 差排理論及各種強化機構之原理， 以奠定良好之冶金基礎。",
      "describe_en": "To learn the plastic deformation of single crystals, dislocation theory and various strengthening mechanisms to establish the foundation of metallurgy."
    },
    {
      "seq": 3,
      "describe_ch": "能夠應用力學及冶金之基本原理， 分析材料之塑性變形與破裂之行為。",
      "describe_en": "Being able to analyze the plastic deformation and fracture behavior of materials based on the mechanical and metallurgical fundamentals."
    }
  ],
