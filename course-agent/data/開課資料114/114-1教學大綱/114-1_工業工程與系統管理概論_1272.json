  "description": {
    "sub_id3": null,
    "sub_name": "工業工程與系統管理概論",
    "sub_ename": "INTRODUCTION TO INDUSTRIAL ENGINEERING AND SYSTEMS MANAGEMEN",
    "describe_ch": "透過灌輸工業工程師之角色及所需本職學能之概念，除令學生對工業工程與系統管理有初步了解外，並能對後續修習相關專業課程先有進一步的認識。",
    "describe_eh": "This course is designed to guide the students into the general concept of Industrial Engineering. Students then should know what kinds of theory and skills are necessary to manage a system or process that creates goods or services. Certainly, students should know what and how useful of advanced courses related.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解工業工程的人力需求、定位及所應具備之本質學能。",
      "describe_en": "Understanding what industrial engineer is and should possess what kinds of concepts and skills."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解系統定義與要素、分析與設計訴求、程序、方法及考量。",
      "describe_en": "Understanding definition, criteria, process, methods, and considerations of system analysis and design."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解生產管理領域的功能、用途及考量。",
      "describe_en": "Understanding functions, usages, and considerations of production management field."
    },
    {
      "seq": 4,
      "describe_ch": "透過小組討論培養團隊合作能力。",
      "describe_en": "Training the ability of cooperative team work through group discussion."
    }
  ],
