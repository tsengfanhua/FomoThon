  "description": {
    "sub_id3": null,
    "sub_name": "民法概要",
    "sub_ename": "INTRODUCTION TO CIVIL LAW",
    "describe_ch": "提供非法律系學生熟知民法基礎理論並了解日常生活法律常識之課程。民法為規範人民私法行為之主要法律，內容廣泛，包括總則、債編、物權編、親屬編及繼承編，本課程將選擇合適主題介紹之。\r\n",
    "describe_eh": "This is a basic course designed to familiarize non-majors with Taiwan's Civil Code. Especially Civil Code influences citizens' life, and has extensive range in this law, including five parts General Principles, obligation, Rights In Rem, Family, and Guardianship. This course will choose the appropriate topics to introduce to students. We hope students have enough ability to deal with legal problem while they operate business in the future.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解商業行為屬於民事法律行為，並受相關的民商法律約束與規範。體認會計工作在民事法律層面的風險，及法律規範對會計工作所要求的高超職業道德、倫理標準以及所需擔負的法律（社會）責任。",
      "describe_en": "To understand the legal conjunction of business, as well as the social responsibility, professional ethic demand as an accounting specialist,  and to enhance their law-abiding conscience."
    },
    {
      "seq": 2,
      "describe_ch": "透過課堂上民事案例的研習，導引學生運用邏輯思考，歸納演繹的分析案例中權利義務、利害關係，進而能夠辨識所遭遇的問題，分析有關影響的層面，並找到解決問題的對策。而在課堂上參與討論過程中，訓練學生能夠精確地運用文字，經由口語完整而正確表達個人意見及改善與人溝通",
      "describe_en": "In discussion a faced case is not just to finde out the answer. What more important is to guide the students to logical thinking - analyse  and subsumption, and to improve their  ability by oral presentation."
    }
  ],
