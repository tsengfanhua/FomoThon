  "description": {
    "sub_id3": null,
    "sub_name": "近代物理",
    "sub_ename": "MODERN PHYSICS",
    "describe_ch": "本課程主要包含：愛因斯坦的相對論、粒子雙重性、原子結構、量子力學。以利電子、電機、材料、光電等熱門科系的學習基礎，更是其專業領域進階課程之必備知識。",
    "describe_eh": " This course introduces Einstein Theory, dualism of particles, atomic structure, quantum mechanics, which are the basis for the studies of electronics, electrical machinery, material, and photonics, as well as the necessary knowledge for advanced courses in the professional field.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道相對論與粒子雙重性的觀念知識。",
      "describe_en": "Be able to understand the concept and the theory of relativity and dualism of particles."
    },
    {
      "seq": 2,
      "describe_ch": "具備原子的構造與電子行為的知識與使用能力及了解量子力學的重要性與應用。",
      "describe_en": "To able to understand and apply atomic structure and electron behaviors, and understand the importance and application of quantum mechanics."
    }
  ],
