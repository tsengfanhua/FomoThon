  "description": {
    "sub_id3": null,
    "sub_name": "分析化學",
    "sub_ename": "ANALYTICAL CHEMISTRY",
    "describe_ch": "本課程探討定性與定量的化學分析理論與應用。內容包括實驗數據處理、資料統計分析、取樣及標定過程、水溶液中各種化學平衡之計算、結晶與沈澱之重量分析、體積分析、及滴定等。",
    "describe_eh": "This course provides students with the theory and applications of qualitative and quantitative analytical methods, including data organization, statistical analysis, sampling and calibration, calculation of chemical equilibriums, weight analysis, volume analysis, and titration.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "熟習傳統定量分析之藥品、儀器裝置與計算。",
      "describe_en": "Understand the quantitative analytical methods and operation of equipment."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解如何取樣、製作標準曲線與數據之統計分析。",
      "describe_en": "Understand the approaches of sampling, calibration, and data analysis."
    },
    {
      "seq": 3,
      "describe_ch": "理解並獲得酸鹼反應、沈澱反應等平衡計算之知識及能力。",
      "describe_en": "Acquire the knowledge and the skills of acid-base reaction, precipitation, and equilibrium"
    },
    {
      "seq": 4,
      "describe_ch": "滴定分析及應用。",
      "describe_en": "Understand the knowledge of titration and its applications."
    }
  ],
