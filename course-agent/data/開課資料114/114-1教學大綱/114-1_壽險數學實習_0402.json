  "description": {
    "sub_id3": null,
    "sub_name": "壽險數學實習",
    "sub_ename": "RECITATION OF MATHEMATICS FOR LIFE INSURANCE",
    "describe_ch": "壽險數學即精算(Actuarial Science)為必修的一門課程，它以機率、複利數學、徵積分等為基礎來估算人壽保險產品之成本。儘管日新月異產品推陳佈新，數理計算要求合理化、公平化、精確化，在一定計算因素精確算出確定年金、生存年金、人壽保險之純保費、總保費、準備金等。",
    "describe_eh": "Acturarial mathematics is a pre-requisite course for actuarial science. The fundamentals are probability, compound interest theory and calculus. Actuarial mathematics is used for the calcualtion of insurance costs. Although the new products are introduced into the market, the acturarial methodology to calculate net premium, gross premium and valuation needs to provide reasonableness, equality, and accuracy.",
    "pre_subname": "CEM1006微積分、INSU2001人壽保險",
    "pre_sub_id3": "CEM1006",
    "pre_sub_ename": "CEM1006 CALCULUS、INSU2001 LIFE INSURANCE",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 0.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解死亡率與年金概論",
      "describe_en": "Comprehension for the mortality rate and annuity"
    },
    {
      "seq": 2,
      "describe_ch": "理解壽險產品數理計算基礎",
      "describe_en": "Comprehension for the calculation fundamentals using for various life insurance products.　"
    },
    {
      "seq": 3,
      "describe_ch": "理解準備金提存之意義與計算",
      "describe_en": "Comprehension for the propose of reserve and learning how to calculate it"
    }
  ],
