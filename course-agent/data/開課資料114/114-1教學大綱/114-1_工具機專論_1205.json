  "description": {
    "sub_id3": null,
    "sub_name": "工具機專論",
    "sub_ename": "SPECIAL TOPICS ON MACHINE TOOLS",
    "describe_ch": "介紹工具機產業之技術特性，內容包括綜合加工機與複合加工機之設計與應用，工具機控制技術概論，工具機精度與性能檢測等實用課程。本課程為工具機設計、製造的基礎養成，並培養學生進入工具機業發展的興趣。",
    "describe_eh": "Introducing the technological characteristics of machine tool industrial. The contents of this course includes basic design and application of machine center and compound machine tools, a summary of control technique of machine tools, and measuring of precision and performance of machine tools. This is a fundamental course of machine tool design and manufacture, and the object is to train up students to join machine tool industrial.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "工具機產業概論",
      "describe_en": " Introducing of machine tool industrial."
    },
    {
      "seq": 2,
      "describe_ch": "綜合加工機與複合加工機之設計與應用",
      "describe_en": "Design and application of machine center and compound machine tools."
    },
    {
      "seq": 3,
      "describe_ch": "工具機控制技術暨精度與性能檢測",
      "describe_en": "Control technique and measurement of precision and performance of machine tools."
    },
    {
      "seq": 4,
      "describe_ch": "其他非傳統加工技術於工具機產業之應用",
      "describe_en": "Application of non-traditional process to machine tool industrial."
    }
  ],
