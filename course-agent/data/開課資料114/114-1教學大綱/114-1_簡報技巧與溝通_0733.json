    },
    {
      "yms_year": 114.0,
      "yms_smester": 1.0,
      "cls_id": "CB25120",
      "sub_id": "62945",
      "scr_dup": "001",
      "evalb_id": "L3",
      "score_rate": 30,
      "evalb_memo": null,
      "evalb_memo_en": "Class participation:\n\n1. Preparation: Review the case study thoroughly before class to understand the context, issues, and key points.\n\n2. Active Engagement: Participate actively in discussions, offering insights, analyses, and solutions.\n\n3. Critical Thinking: Apply critical thinking skills to analyze the case, identify problems, and propose solutions.\n\n4. Evidence-Based Arguments: Support your arguments with evidence from the case study, relevant theories, and external sources.\n\n5. Listening: Listen attentively to classmates' perspectives, asking clarifying questions and building on their contributions.\n\n6. Respectful Interaction: Respectfully challenge ideas and opinions, promote constructive dialogue and learning.\n\n7. Contribution Quality: Focus on quality rather than quantity of contributions, offering thoughtful and well-reasoned insights.\n\n8. Collaboration: Collaborate with classmates in group discussions, brainstorming ideas and collaborating on solutions.\n\n9. Reflection: Reflect on your own contributions and learning from the case study, identifying areas for improvement.\n\n10. Participation Balance: Strive for balanced participation, ensuring that all students have the opportunity to contribute and share their viewpoints.\n\n11. Frequency: Participate regularly throughout the semester, not just occasionally.",
      "evalb_name": "課堂討論參與",
      "evalb_name_en": "Participation",
      "seq": 2
    },
    {
      "yms_year": 114.0,
      "yms_smester": 1.0,
      "cls_id": "CB25120",
      "sub_id": "62945",
      "scr_dup": "001",
      "evalb_id": "D5",
      "score_rate": 20,
      "evalb_memo": null,
      "evalb_memo_en": "Presentation:\n\n1. Structure your presentation like a story\n(Storytelling that moves people: Craft the beginning, Develop the middle, Make the Ending powerful)\n\n2. Avoid reading from cellphone, instead, revel in the art of storytelling\n3. Develop stage presence\n\n4. Engage your audience\n\n5. Strategize multimedia planning with impactful visualization – Adopt a designer’s mindset\n\n6. Use minimum text\n\n7. Length your presentation\n\n8. Make it authentic – provide references\n\n9. Anticipate technological Glitches – arrive early and well prepared",
      "evalb_name": "期末專題",
      "evalb_name_en": "Final presentation",
      "seq": 3
    },
