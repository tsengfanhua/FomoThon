  "description": {
    "sub_id3": null,
    "sub_name": "創業財務",
    "sub_ename": "ENTREPRENEURIAL FINANCE",
    "describe_ch": "此課程探討新興企業的籌資挑戰，解決其在取得傳統籌資途徑上所面臨的挑戰。特別強調替代性籌資方法和專業投資者的獨特需求，尤其是風險投資上，提升籌資成功機會。涵蓋資金需求評估、籌資策略、風險管理，並透過成功案例引導學生。",
    "describe_eh": "This course focuses on funding strategies tailored for new ventures, addressing the challenges they face in accessing traditional financing avenues. Emphasis is placed on alternative funding methods and the distinct requirements of professional investors, particularly venture capital funds. By understanding the unique needs of these investors, participants will enhance their chances of securing funding for their ventures.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "理解新創企業資金挑戰的本質，以及解決這些挑戰的方式和方法",
      "describe_en": "Comprehension of the essence of funding challenges for new ventures and the ways to address these challenges."
    },
    {
      "seq": 2,
      "describe_ch": "應用所學知識，制定適合新創企業的籌資策略。",
      "describe_en": "Application of the acquired knowledge to formulate fundraising strategies tailored to their own enterprises."
    },
    {
      "seq": 3,
      "describe_ch": "分析新創企業的資金需求，以及不同籌資途徑和專業投資者的需求。",
      "describe_en": "Analysis of the funding needs of new ventures, as well as the requirements of various fundraising avenues and professional investors."
    }
  ],
