  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CE12121",
    "sub_id": "54460",
    "scr_dup": "001",
    "sub_title": "電子學實驗(一)",
    "sub_title_en": null,
    "sub_describe": "電子學基本原理與工程應用之實作驗證",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "電子學實驗(一)",
    "sub_ename": "ELECTRONICS LAB.(1)",
    "describe_ch": "電子學實驗(一)著力於探討電子電路實作與實務應用，內容含電子元件應用、電子電路特性分析和信號傳輸的訓練。培養學生具有學習電子電路分析與設計基礎，瞭解電路組成結構、元件選擇、成品製作、和系統評估。",
    "describe_eh": "Electronics Experiment (1) focuses on exploring the implementation and practical application of electronic circuits, and the content includes the application of electronic components, the analysis of electronic circuit characteristics and the training of signal transmission. Cultivate students to have the foundation of learning electronic circuit analysis and design, understand the circuit composition structure, component selection, finished product production, and system evaluation.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解各種電子實驗設備之基本功能與知識",
      "describe_en": "Understanding the basic function and knowledge of various electronic instruments."
    },
    {
      "seq": 2,
      "describe_ch": "理解各種電子實驗設備之工程原理",
      "describe_en": "Comprehension for the engineering principle of various electronic instruments."
    },
    {
      "seq": 3,
      "describe_ch": "應用各種電子實驗設備完成電子電路之測試與設計",
      "describe_en": "Application for the electronic instruments to circuit testing and design."
    },
    {
      "seq": 4,
      "describe_ch": "運用電子電路分析軟體完成電子電路之特性分析",
      "describe_en": "Apply the circuits simulation tool box to circuits characteristic analysis."
    }
  ],
