  "description": {
    "sub_id3": null,
    "sub_name": "科技管理",
    "sub_ename": "TECHNOLOGY MANAGEMENT",
    "describe_ch": "科技管理是一個結合各種知識，諸如科學、工程學、管理知識及食物等跨領域的學科。科技管理的目的在於研究如何管理科技的創造、取得以及開發技術的系統。",
    "describe_eh": "Management of technology is an interdisciplinary field that integrates science, engineering, and management knowledge and practice. Managing technology implies managing the systems that enable the creation, acquisition and exploitation of technology.",
    "pre_subname": "MGT1001管理學",
    "pre_sub_id3": "MGT1001",
    "pre_sub_ename": "MGT1001 MANAGEMENT",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "強調科技在創造價競爭優勢所扮演的重要角色",
      "describe_en": "To Stress technology's crucial role in creating wealth and achieving competitiveness"
    },
    {
      "seq": 2,
      "describe_ch": "提出技術及產品生命週期的概念",
      "describe_en": "To present the concepts of technology and product life cycles"
    },
    {
      "seq": 3,
      "describe_ch": "檢視產品商品化所面臨的挑戰",
      "describe_en": "To examine the challenges in managing the product life cycle from concept to market"
    }
  ],
