  "description": {
    "sub_id3": null,
    "sub_name": "佛教文學專題",
    "sub_ename": "TOPICS IN BUDDHIST LITERATURE",
    "describe_ch": "本課程透過佛教神話與傳說、傳記、詩偈、敘事、節慶與儀式，探討作者、創作、接受、影響等文學問題，引導學習者掌握佛教文學的內涵與特質，並展開與佛教文學相關的研究工作。授課內容包括：佛教文學的定義及範疇；佛教文學的研究方法與研究現況；佛教文學作品探析；中外佛教文學、文化之交涉等課題。",
    "describe_eh": "This course explores literary issues such as author, creation, reception, and influence through Buddhist myths and legends, biographies, verses, narratives, festivals, and rituals, guiding learners to grasp the connotation and characteristics of Buddhist literature, and to start research work related to Buddhist literature. The teaching contents include: the definition and scope of Buddhist literature; the research methods and current research status of Buddhist literature; the analysis of Buddhist literary works; the negotiation of Chinese and foreign Buddhist literature and culture, etc.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "指導學生撰寫佛教文學領域之研究報告。",
      "describe_en": "Guide students in writing research reports in the field of Buddhist literature."
    },
    {
      "seq": 2,
      "describe_ch": "透過佛教神話與傳說、傳記、詩偈、敘事、節慶與儀式，探討作者、創作、接受、影響等文學問題，引導學習者掌握佛教文學的內涵與特質。",
      "describe_en": "Through Buddhist myths and legends, biographies, verses, narratives, festivals and rituals, explore literary issues such as author, creation, reception and influence, and guide learners to grasp the connotation and characteristics of Buddhist literature."
    },
    {
      "seq": 3,
      "describe_ch": "透過佛教文學作品，探討其中蘊含的人文情懷、人生價值以及對於現代生活的啟發或影響。",
      "describe_en": "Through Buddhist literary works, explore the humanistic sentiments, life values contained in them, and their inspiration or impact on modern life."
    }
  ],
