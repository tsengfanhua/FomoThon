  "description": {
    "sub_id3": null,
    "sub_name": "獨立研究-跨域微學分課程(一)",
    "sub_ename": "INDEPENDENT STUDY – CROSS-DISCIPLINARY MICRO PROGRAM(1)",
    "describe_ch": "跨域微學分課程係透過課程、演講/活動、實驗/實習/參訪、遠距/網路教學、實作研習營、工\r\n作坊或相關活動等方法的應用，有效達到多樣性與自主性學習之目標；另外一方面藉由短期\r\n又快速的學習方式，提升跨領域學習成效，當學分達到規定範圍時可自行規劃整合性作\r\n業，再經專業指導老師協助，進行成果發表後將可順利以整數學分抵免，以達到多元跨領域\r\n學習之目的。",
    "describe_eh": "The course aims to achieve diversity and autonomous learning goals through lecture/activity,\r\nexperiment/intern/visit, distance/internet learning. It enhances effects in interdisciplinary learning by\r\nshort and rapid learning style. With professional instruction, students can schedule their own learning\r\nand waive credits after presentation, which is also the purpose of interdisciplinary learning.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "協助學生認識「多元化實作課程」的特性\r\n與內容，並學習如何實務應用與開發。",
      "describe_en": "To understand the characteristics and\r\ncontent of the diversified operations\r\ncourses ,and learn the application and"
    },
    {
      "seq": 2,
      "describe_ch": "創造一個跨領域整合學習的最佳模式",
      "describe_en": "To create the best model about a\r\ninterdisciplinary learning"
    }
  ],
