  "description": {
    "sub_id3": null,
    "sub_name": "中國書法鑑賞",
    "sub_ename": "APPRECIATION OF CHINESE CALLIGRAPHY",
    "describe_ch": "書法是中華文化的核心，透過毛筆書寫出運動節奏豐富的點畫線條，並賦予書法線條以生命；線條軌跡在漢字的規定、組合、構成下，又表現出書家的氣質性情、審美趣味、藝術觀念。本課程將透過歷代名家作品貫串書法史，讓學生打開對書法的全面理解，進而能夠欣賞、甄別書法優劣，提升對書法藝術的品味，讓這最具民族特色的藝術融入生活中。",
    "describe_eh": "Calligraphy is at the core of Chinese culture. Through brush strokes, it creates rich and dynamic lines that imbue life into each mark. These line trajectories, shaped by the structure, composition, and formation of Chinese characters, reflect the calligraphers’ temperament, aesthetic taste, and artistic philosophy. This course will guide students to appreciate and discern the quality of calligraphic works, through the history of calligraphy and by examining works from renowned masters across various eras. Students will gain a comprehensive understanding of calligraphy, enhance their taste in calligraphy art, and then integrate this uniquely traditional art form into their lives.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識五體書法的點畫、線條、結構、章法特點",
      "describe_en": "To understand the characteristics of dots, strokes, lines, structures, and composition in the five major script styles of calligraphy."
    },
    {
      "seq": 2,
      "describe_ch": "對書法史有基本的掌握",
      "describe_en": "To gain a fundamental knowledge of calligraphy history."
    },
    {
      "seq": 3,
      "describe_ch": "認識、感受各體書法名作之美與文化意涵",
      "describe_en": "To recognize and appreciate the beauty and cultural significance of renowned works in various calligraphy styles."
    },
    {
      "seq": 4,
      "describe_ch": "欣賞書法進而喜愛書法，將書法文化融入生活中",
      "describe_en": "To appreciate and develop the love for calligraphy, integrating calligraphy culture into daily life."
    }
  ],
