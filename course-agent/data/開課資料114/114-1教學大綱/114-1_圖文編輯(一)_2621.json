  "description": {
    "sub_id3": null,
    "sub_name": "圖文編輯(一)",
    "sub_ename": "ARTICLES AND GRAPHIC EDITING (I)",
    "describe_ch": "本課程為中文系數位編輯之實務訓練，兼具強化文案撰寫能力。理論上講授排版學、編輯基礎，並依格式正確編輯論文及報告，考取MOS Master國際證照；實務上則需搭配本系CDIO課程編輯刊物並進行成果策展。",
    "describe_eh": "This course focuses on document editing abilities of the Chinese Literature Dept.’s students, covering theoretical topics such as layout design and editing fundamentals. It also teaches correct formatting for academic papers and reports and prepares students to obtain the MOS Master international certification. In practice, students will work on editing publications as part of the CDIO curriculum, and to exhibit their results.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生能掌握文字編輯的重要基礎",
      "describe_en": "Students can master the important foundation of articles editing."
    },
    {
      "seq": 2,
      "describe_ch": "學生能使用樣式表進行圖文版面之編輯",
      "describe_en": "Students can use the “style” function to edit the layout of graphic and articles."
    }
