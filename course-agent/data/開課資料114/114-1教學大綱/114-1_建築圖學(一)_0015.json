  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "AS01119",
    "sub_id": "23266",
    "scr_dup": "001",
    "sub_title": null,
    "sub_title_en": null,
    "sub_describe": "建築圖學，旨在透過線條之「權重與形式」，繪製具備「溝通及思考」之設計與工程圖示系統。運用於設計過程中草圖、觀察紀錄、建築圖以及細部大樣(尺規)…等，奠基於「真實性」下的線條構成。本課程分為二學期，內容涵蓋：運用於觀察&紀錄的線條「再現」、三視圖原理下的點線面–形體構成概念下的建築與室內設計基本圖面繪製(正投影法、軸測投影法、透視投影法、CNS繪圖準則…等，兼具徒手與尺規製圖之視圖系統訓練。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "建築圖學(一)",
    "sub_ename": "ARCHITECTURAL GRAPHICS(1)",
    "describe_ch": "本課程介紹投影幾何基本概念，並學習建築繪圖技巧描述二度與三度空間中建築元素。課程內容安排如下：投影幾何，正投影(三視圖與平行投影圖)，斜投影(平面，光面等斜圖)透視投影(一、二、三消點透視圖)與陰影(平面圖與立體圖))",
    "describe_eh": "This course introduces the fundamental concepts about projective Geometry.  It also teaches basic Architectural drawing techniques, which describe Architectural elements in space.  Topics covered include Projective Geometry, Orthographic projection (Multi-view drawing, parallel line drawing) oblique projection (plan and Elevation oblique), 1,2,3,-point perspective Drawings (Common method and Measuring point method) and shadow for 2D and 3D drawing.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "說明投影幾何基本概念",
      "describe_en": "Introduction of fundamental theory about projective geometry."
    },
    {
      "seq": 2,
      "describe_ch": "學習建築繪圖觀念與技巧,並應用於描述二度與三度空間中建築元素",
      "describe_en": "Learning the basic Concepts and techniques of Architectural drawing which describe Architectural elements in space."
    },
    {
      "seq": 3,
      "describe_ch": "應用繪圖工具提升溝通與設計技能",
      "describe_en": "Application of drawing tools to advance Communication and design skill."
    }
  ],
