  "description": {
    "sub_id3": null,
    "sub_name": "跨領域畢業專題(二)",
    "sub_ename": "INTERDISCIPLINARY GRADUATION PROJECT(2)",
    "describe_ch": "本課程透過跨領域合作能力，打破以往同一學系學生製作專題之框架，將專題內容融入i（information/intelligence），課程涵蓋金融科技、數量建模方法、資料分析、競賽成功案例研究和相關理論，為學生未來就業做準備，以呼應聯合國永續發展之目標。",
    "describe_eh": "Through cross-disciplinary collaboration, this course breaks the framework of the student  projects from the same department, and integrates the possible financial topics into i (information / intelligence). It includes financial technology, quantitative modeling, data analysis, successful cases research and other related theories to help students prepare future works in response to the goals of sustainable development of the United Nations.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生能透過資料分析和數量建模解決金融問題。",
      "describe_en": "Students are able to solve financial problems by data analysis and quantitative modeling."
    },
    {
      "seq": 2,
      "describe_ch": "學生能將金融結合並應用資訊科技。",
      "describe_en": "Students are able to combine and apply finance with information technology."
    }
  ],
