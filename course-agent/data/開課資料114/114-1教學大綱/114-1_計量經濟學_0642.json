  "description": {
    "sub_id3": null,
    "sub_name": "計量經濟學",
    "sub_ename": "ECONOMETRICS",
    "describe_ch": "計量經濟學是一門結合經濟理論與統計方法等領域的數理學科。其目的在於使用線性與非線性迴歸或其他計量方法來找出合理、可信的經濟模型中的參數。在使用各種計量方法時需先了解模型的假設條件及其估計、檢定方法。若假設條件不符，資料需先作修正。除理論知識外，學生需學習如何使用電腦計量軟體。",
    "describe_eh": " Econometrics is a course which combines the knowledge of the Economic theories and Statistics. The purpose of it is to find the reasonable and reliable parameters in an economic model by using the proper Econometrics methods. Before applying any econometrics method, students should have the knowledge about the assumptions, estimating methods, inferences of each method. The data should be revised if it does not meet the assumptions. Students should also be able to use at least one kind of Econometrics software.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能理解計量經濟學的目的、內涵、重要性及其限制。",
      "describe_en": "Comprehension for the purpose, contents, importance and limitations of Econometrics."
    },
    {
      "seq": 2,
      "describe_ch": "能理解並應用傳統OLS迴歸模型及其他計量方法。",
      "describe_en": "Comprehension for and application for the conventional OLS regression model and other Econometrics methods."
    },
    {
      "seq": 3,
      "describe_ch": "應用計量軟體輔助運算。",
      "describe_en": "Apply an econometrics software package for speedy computing."
    }
  ],
