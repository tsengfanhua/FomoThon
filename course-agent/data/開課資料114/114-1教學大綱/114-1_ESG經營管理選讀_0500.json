  "description": {
    "sub_id3": null,
    "sub_name": "ESG經營管理選讀",
    "sub_ename": "ESG MANAGEMENT AND GOVERNANCE READING COURSE",
    "describe_ch": "本課程旨在介紹學生ESG基本概念、原則和實踐，強調經濟、社會和環境之間的平衡。同時，課程設計方向著重培養商學院學生在職場所需之口語及書寫溝通技巧，能撰寫與職場相關之英文文件，並使用英文進行有效且適當的溝通。",
    "describe_eh": "This course introduces students to ESG fundamentals, highlighting the balance between economy, society, and environment. It also emphasizes developing oral and written communication skills needed in the workplace, enabling students to write relevant English documents and communicate effectively in English.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生知悉E（環境）S（社會）G（治理）之因素與對企業決策的影響。",
      "describe_en": "Students will gain an understanding of the factors of economic, social, and environmental dimensions, and their impacts on enterprises’ decision making."
    },
    {
      "seq": 2,
      "describe_ch": "學生將具備在職場所需之口語及書寫溝通技巧。",
      "describe_en": "Students will acquire oral and written communication skills required in the workplace."
    }
  ],
