  "description": {
    "sub_id3": null,
    "sub_name": "環境規劃與管理",
    "sub_ename": "ENVIRONMENTAL PLANNING AND MANAGEMENT",
    "describe_ch": "本課程之目的乃是協助學生瞭解環境規劃與管理的基本原則與理念。其課程安排，包括環境規劃與管理的相關理論、環境規劃與管理的個案研究等。本課程並以聯合國永續發展目標(SDGs)為基礎，探討社會發展架構，妥善利用現代先進科技，建設具防災能力與永續發展的社會環境。",
    "describe_eh": "This course is designed to assist students in understanding of some of the basic principles and concepts of environmental planning and management. Topics include an approach to environmental planning and management and case study of environmental planning and management. Based on the UN's Sustainable Development Goals (SDGs), this course also explores the framework for social development to build resilient infrastructure and promote inclusive and sustainable industrialization based on the modern advanced technology.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解探討環境科學的方法。",
      "describe_en": "Be able to understand the ways in which we have an approach to environmental science."
    },
    {
      "seq": 2,
      "describe_ch": "具備永續發展目標(SDGs)的知識性，理解各目標的意涵，並針對遙感探測技術應用於地球資源監控技術與資訊剖析的技術。",
      "describe_en": "Knowledge of the Sustainable Development Goals (SDGs), understanding of the meaning of each goal, and the application of remote sensing detection technology to earth resources monitoring technology and information analysis technology."
    },
    {
      "seq": 3,
      "describe_ch": "能使用環境規劃與管理的理論與知識，分析有關人與環境間的議題，並提出專業基礎以上的想法。",
      "describe_en": "Be able to use theories and knowledge of environmental planning and management specific issues and problems and to propose the basic and up-level arguments."
    }
  ],
