  "description": {
    "sub_id3": null,
    "sub_name": "現代散文及習作",
    "sub_ename": "MODERN PROSE",
    "describe_ch": "台灣當代（1949-）散文的研討，並經由多次讀書會、寫作實習與小組報告，同時加強學生口說與手寫兩方面的表達能力。課程內容包括：（一）現代散文的名義、源流、與範圍（二）台灣當代散文的演變與類別（三）散文重要作家/作品賞析（四）台灣當代散文研究趨勢與最新出版資。",
    "describe_eh": "This course is focusing the discussion and research on the contemporary prose in Taiwan (since 1949).\tIt will strength the participants' verbal and handwriting capability for communication by the way of repetitive reading seminar, writing practice and group discussion. It includes (1) the terminology, resources and extension of the contemporary prose, (2) evolution and classification of the contemporary prose in Taiwan, (3) the representative writers/ enjoinment and analyzing for their masterpiece, and (4) the research trend and publish information of the contemporary prose in Taiwan.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "對散文發展有基礎認知。",
      "describe_en": "For basically recognizing the modern prose evolution."
    },
    {
      "seq": 2,
      "describe_ch": "能寫出流暢達意的文章。",
      "describe_en": "For being capable to write a fluent and quite understandable essay."
    }
  ],
