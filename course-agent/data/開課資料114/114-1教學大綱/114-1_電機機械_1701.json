  "description": {
    "sub_id3": null,
    "sub_name": "電機機械",
    "sub_ename": "ELECTRIC MACHINES",
    "describe_ch": "本課程除專注於建構電機機械課程需要之基礎外，還括一系列之各型變壓器與旋轉電機之工作原理與特性分析。本課程內含相關論文教學以加強學習成效。",
    "describe_eh": "This course is devoted to not only an exposition of topics that can be considered to constitute the basic foundation of electric machinery, but also operation principle and performance introduction of a series of transformer and rotating electric machines. Governing papers are also included in the course to aid comprehension for both parts.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "知道於何處可找到各型變壓器與旋轉電機的相關資訊、研究結果及標準，並可評估所獲資訊的適用性。",
      "describe_en": "Know where to locate and access related transformers and rotating electric machines information, research, as well as standards, and be able to evaluate the appropriateness of the obtained information."
    },
    {
      "seq": 2,
      "describe_ch": "能理解並說明各型變壓器與各型旋轉電機的穩態模式運作原理。",
      "describe_en": "Comprehend and be able to explain the steady-state operation of transformers and rotating electric machines."
    },
    {
      "seq": 3,
      "describe_ch": "能分析相關電路學觀念，完成一個計算程序各型變壓器與與旋轉電機等效電路數學式，並由計算中歸納出適當的結論 與應用。",
      "describe_en": "Be able to analyze the governing concepts of electric circuits to establish the mathematic statements on the transformer and rotating electric machines, and draw appropriate conclusions and applications from solution results."
    }
  ],
