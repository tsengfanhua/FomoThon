  "description": {
    "sub_id3": null,
    "sub_name": "數據分析與應用",
    "sub_ename": "INTRODUCTION TO DATA ANALYSIS AND APPLICATIONS",
    "describe_ch": "本課程介紹數據分析的基礎以及相關應用主題，包含數據清理、模型分析與評估、視覺化呈現等，修課同學需具備數學、統計與程式撰寫等基礎知識及能力以進行跨領域整合學習。課程目標為建立同學在數據分析必要之根基，以便於進行各自專業領域的研究。",
    "describe_eh": "This course introduces a series of related topics to the data analysis and its applications, including data clean, model analysis and evaluation, visualization, etc. Students should have fundamental knowledge of mathematics, statistics and programming for interdisciplinary studies. The course target is to construct required skills of data analysis, and subsequently students can conduct individual studies in professional fields.",
    "pre_subname": "MATH2012統計學、MATH2011機率論、MATH1053計算機程式",
    "pre_sub_id3": "MATH2012",
    "pre_sub_ename": "MATH2012 STATISTICS、MATH2011 PROBABILITY、MATH1053 COMPUTER PROGRAMMING",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能說明課程介紹的主題，並了解相關應用",
      "describe_en": "One can explain the topic introduced in the semester and know related applications."
    },
    {
      "seq": 2,
      "describe_ch": "能整合數學、機率統計及資訊技術進行數據分析與詮釋結果",
      "describe_en": "One can integrate Mathematics, Probability and Statistics as well as Information Technology to analyze data and explain the result."
    },
    {
      "seq": 3,
      "describe_ch": "能透過團隊合作，應用跨領域學習與知識，合作處理實際問題",
      "describe_en": "By the teamwork, one can cooperatively solve practical problems with interdisciplinary learning and knowledge."
    }
  ],
