  "description": {
    "sub_id3": null,
    "sub_name": "材料基礎實驗(一)",
    "sub_ename": "BASIC MATERIALS EXPERIMENT(1)",
    "describe_ch": "本實驗課程目的在於訓練學生具備基礎材料特性分析之能力，其內容單元包括：金相試片製備與顯微組織觀察及材料機械性質量測，期望學生能藉此強化學生相關實作之能力。",
    "describe_eh": "This experimental course aims to train students to have the ability to analyze the characteristics of basic materials. The content units include metallographic test piece preparation and microstructure observation, and material mechanical quality measurement. It is expected that students can use this to strengthen their relevant practical abilities.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "(a)介紹金相顯微鏡的功能、操作，並詳述製作金相試片的步驟，(b)說明相圖的意義，(c)結合金相組織的觀察與相圖分析，瞭解熱機處理、顯微組織與材料性質三者之關係。",
      "describe_en": "(a) introduce the function and operative method of OM, and steps of prepared  metallographic sample, (b) explain the meaning of phase diagrams, (c) explain the relation between heat treatment, metallographic and property by observing microstructure and an"
    },
    {
      "seq": 2,
      "describe_ch": "(a)介紹拉伸實驗，並測試材料之拉伸性質，(b)解析應力-應變曲線。分析陶瓷材料受到外加應力（力矩）時，材料抵抗彎曲變形的能力。",
      "describe_en": "(a)introduce the tensile rest and measure the tensile property of materials, (b) explain physical meaning of the stress-strain curve. Analyze the resistance of bending deformation for ceramic materials, when the external stress applied on the specimen."
    },
    {
      "seq": 3,
      "describe_ch": "(a)應用衝擊實驗檢測材料之韌性，並由其破裂面判斷破裂模式，(b)分析衝擊值與破斷面形貌之相關性，(c)探討材料韌性與溫度的關係。",
      "describe_en": "(a) measure the toughness of the materials by impact test and differentiated fracture mode by observing the fracture surface, (b) analyze the relation between impact value and morphology of fracture surface, (c) explain the relation between  the toughness"
    },
    {
      "seq": 4,
      "describe_ch": "介紹硬度之定義與各種硬度試驗機之操作。並詳述各種硬度評量單位間的轉換關係。配製錫-鋅合金，並利用熱分析法求出此合金之平衡相圖。",
      "describe_en": "Introduce the definition of hardness and operate method for all kinds of the test machine。Moreover, explain the transferable relation between every hardness dimension. Prepare Sn-Zn alloys, and draw its equilibrium phase diagram."
    }
  ],
