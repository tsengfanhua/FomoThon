  "description": {
    "sub_id3": null,
    "sub_name": "電腦輔助繪圖",
    "sub_ename": "COMPUTER-AIDED DRAWING",
    "describe_ch": "本課程為 「建設產業數位原型實作」AutoCAD 基礎課程 的進階延伸，專為 土地管理專業 學生設計。課程涵蓋 進階 2D 繪圖技巧、動態塊（Dynamic Blocks）、LISP 自動化應用、3D 建模與圖面配置，並透過 專題實作、期中與期末上機考試，強化學生在 地籍圖繪製、土地利用規劃與空間資料管理 方面的應用能力。本課程將幫助學生掌握 精確繪圖與數位建模技術，提升土地管理與測繪工作的效率與專業度。",
    "describe_eh": "This course is an advanced extension of the “Digital Prototyping for the Construction Industry” AutoCAD Basics Course, specifically designed for students in the Land Management discipline. The curriculum covers advanced 2D drafting techniques, Dynamic Blocks, LISP automation, 3D modeling, and layout configuration. Through practical projects, midterm, and final hands-on exams, students will enhance their ability to apply AutoCAD in cadastral mapping, land use planning, and spatial data management. This course equips students with precision drafting and digital modeling skills, improving efficiency and expertise in land management and surveying applications.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "強化進階 2D 繪圖與編輯技術，提高繪圖精準度與效率。",
      "describe_en": "Enhance advanced 2D drafting and editing skills to improve drawing accuracy and efficiency."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解圖面相關資訊與圖資蒐集方法，提升資料應用能力。",
      "describe_en": "Understand drawing-related information and data collection methods to enhance data utilization."
    },
    {
      "seq": 3,
      "describe_ch": "掌握 3D 建模與圖面配置，提升數位製圖與空間規劃應用能力。",
      "describe_en": "Master 3D modeling and layout configuration to improve digital drafting and spatial planning applications."
    }
  ],
