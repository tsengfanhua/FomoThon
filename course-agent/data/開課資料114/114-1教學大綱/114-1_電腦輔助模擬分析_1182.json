  "subTitleDesc": null,
  "description": {
    "sub_id3": null,
    "sub_name": "電腦輔助模擬分析",
    "sub_ename": "COMPUTER-AIDED SIMULATION ANALYSIS",
    "describe_ch": "本課程講授學生使用電腦輔助設計軟體結合有限元素分析軟體，強化學生在工程設計上能與專業模擬軟體結合，以力學理論為主，運用有限元素法概念，使用有限元素分析軟體模擬分析，增進學生工程分析能力，並能加以應用於真實工程問題 。",
    "describe_eh": "The course covers the solid modeling techniques for product design and engineering using computer-aided design software, e.g. Solidworks; combining the course of computer-aided engineering software, e.g. Ansys, in the purpose of strengthening students’ analytical ability. With the fundamental knowledge of finite element methods (FEM), the students will be able to implement and face real engineering problems.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解有限元素法概念",
      "describe_en": "To learn the concepts in Finite Element Methods"
    },
    {
      "seq": 2,
      "describe_ch": "能熟悉電腦輔助設計軟體操作",
      "describe_en": "To be familiar with computer-aided design software and practice"
    },
    {
      "seq": 3,
      "describe_ch": "能熟悉有限元素分析軟體操作與應用",
      "describe_en": "To be familiar with FEA analytical software and its applications"
    },
    {
      "seq": 4,
      "describe_ch": "具團隊合作精神以進行工程專案設計及分析之能力",
      "describe_en": "To learn to work as a team member for design and provide analytical advices in an engineering project"
    }
  ],
