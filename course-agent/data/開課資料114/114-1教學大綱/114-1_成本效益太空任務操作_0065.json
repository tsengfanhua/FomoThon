  "description": {
    "sub_id3": null,
    "sub_name": "成本效益太空任務操作",
    "sub_ename": "COST-EFFECTIVE SPACE MISSION OPERATIONS",
    "describe_ch": "本課程旨在教授學生如何在太空任務操作中實現成本效益。學生將學習制定和執行太空任務操作計劃的關鍵原則和策略，以降低成本並確保任務成功。課程內容涵蓋成本管理、資源優化、風險評估和決策分析等方面，並結合實際案例和模擬練習，培養學生的操作能力和問題解決技巧。透過本課程，學生將獲得在太空任務操作領域中實現成本效益的關鍵知識和技能，為未來的職業發展打下堅實基礎。",
    "describe_eh": "This course aims to teach students how to achieve cost-effectiveness in space mission operations. Students will learn key principles and strategies for developing and executing operational plans for space missions to reduce costs and ensure mission success. The course covers topics such as cost management, resource optimization, risk assessment, and decision analysis, combining real-world cases and simulation exercises to cultivate students' operational capabilities and problem-solving skills. Through this course, students will gain critical knowledge and skills to achieve cost-effectiveness in the field of space mission operations, laying a solid foundation for their future career development.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "使學生瞭解太空任務操作的成本管理原則和策略。",
      "describe_en": "Enable students to understand the principles and strategies of cost management in space mission operations."
    },
    {
      "seq": 2,
      "describe_ch": "培養學生優化資源分配，提高太空任務的成本效益的能力。",
      "describe_en": "Develop students' ability to optimize resource allocation to improve cost-effectiveness of space missions."
    },
    {
      "seq": 3,
      "describe_ch": "培養學生風險評估和管理的能力，以確保太空任務的安全和成功。",
      "describe_en": "Cultivate students' skills in risk assessment and management to ensure the safety and success of space missions."
    },
    {
      "seq": 4,
      "describe_ch": "培養學生運用決策分析方法，做出有效的操作決策的能力。",
      "describe_en": "Equip students with decision analysis techniques to make effective operational decisions."
    },
    {
      "seq": 5,
      "describe_ch": "訓練學生設計和執行太空任務操作計劃，解決實際操作中的挑戰。",
      "describe_en": "Train students to design and execute operational plans for space missions, addressing challenges in real-world operations."
    },
    {
      "seq": 6,
      "describe_ch": "培養學生的團隊合作和溝通能力，以有效協同作業，實現成本效益的太空任務操作。",
      "describe_en": "Foster students' teamwork and communication skills for efficient collaboration in achieving cost-effective space mission operations."
    }
  ],
