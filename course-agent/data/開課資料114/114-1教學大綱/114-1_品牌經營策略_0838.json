  "description": {
    "sub_id3": null,
    "sub_name": "品牌經營策略",
    "sub_ename": "BRANDING STRATEGY",
    "describe_ch": "本課程將藉由品牌經營策略的個案分析及實務，訓練學生運用所學理論知識制定品牌經營策略，包含產業、競爭者、顧客等分析，探討其市場區隔、行銷策略、品牌定位等，提升學生品牌管理的能力。",
    "describe_eh": "This course aims to cultivate students’ capability in brand management and branding strategy via the discussion of case studies and practices in branding strategies. Students will learn to enact branding strategies by making analysis at industrial level, competitive level, and customer level. This course intends to foster students’ capability of brand management by having them learn to analyze market segmentation, marketing strategy, and brand positioning.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解品牌經營策略相關知識",
      "describe_en": "Understand brand management strategy"
    },
    {
      "seq": 2,
      "describe_ch": "培養品牌建立、運作與品牌工程能力",
      "describe_en": "Cultivate brand establishment, operation and brand engineering capabilities"
    },
    {
      "seq": 3,
      "describe_ch": "培養規劃品牌行銷企劃活動技巧",
      "describe_en": "Develop skills in planning brand marketing activities"
    },
    {
      "seq": 4,
      "describe_ch": "強化品牌溝通能力與團隊合作",
      "describe_en": "Strengthen brand communication capabilities and teamwork"
    },
    {
      "seq": 5,
      "describe_ch": "培養品牌簡報製作與提案技巧",
      "describe_en": "Develop brand briefing and proposal skills"
    }
  ],
