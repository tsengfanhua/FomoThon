  "description": {
    "sub_id3": null,
    "sub_name": "劇場與表演",
    "sub_ename": "THEATER & PERFORMACE",
    "describe_ch": "透過現代劇場的「美學」理念與「創作」原理，了解舞台劇的製作過程，經由閱讀與寫作，掌握戲劇語言的精隨，肢體語言的表達；結合生活周遭各項議題，整合現代藝術的發展理念，不僅深入問題核心，以戲劇形式挖掘重新搬上舞台，增進問題的分析理，並解提昇個人戲劇鑑賞的能力。",
    "describe_eh": "Through the aesthetics concept and creation principle of the modern theater, students are expected to understand the production process of the stage drama. After reading and writing, students will master the essence of drama language and the expression of body language and then combine various issues about life, and integrate the modern art development concepts. Not only will students thoroughly dig into the core of issues by drama form onto stage to improve the analysis, but also advancepersonal appreciation of drama.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學習綜合多元美學的戲劇，增進個人表達力與溝通力",
      "describe_en": "Learn comprehensively multi -aesthetic drama and enhance personal expression and communication"
    },
    {
      "seq": 2,
      "describe_ch": "打開國際視野，維護身心平衡，增加生活品味",
      "describe_en": " Open the international perspective, maintain physical and mental balance, and increase the taste of life"
    }
  ],
