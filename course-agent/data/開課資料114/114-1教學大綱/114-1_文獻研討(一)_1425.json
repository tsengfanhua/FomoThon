  "description": {
    "sub_id3": null,
    "sub_name": "文獻研討(一)",
    "sub_ename": "LITERATURE SURVEY(1)",
    "describe_ch": "本課程旨在利用相關研究領域論文之搜尋、閱讀、研討、口頭與心得報告，訓練學生如何發掘問題、收集相關論文、評估與比較不同的研究方法及結果。並藉由口頭報告與課堂討論，培養學生表達能力與溝通技巧，以及學習不同領域的新知識。",
    "describe_eh": "Train students to do literature search, reading, discussion, oral presentation and written reports on their research topics such that they learn ways to find research problems, collect related papers, evaluate and compare various research methods and results. In addition, oral presentation and Q&A sessions can cultivate students' presentation and communication skills, and allow them to learn more new knowledge from different domains.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 1.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "訓練學生收集及閱讀相關論文與資料，並比較評析論文之優缺點。",
      "describe_en": "Train students to collect reading research papers and how to evaluate and compare the proposed research methods"
    },
    {
      "seq": 2,
      "describe_ch": "訓練學生歸納所閱讀的論文資料撰寫閱讀心得報告，並以口語清晰表達論文研討的結果。",
      "describe_en": "Train students to conclude the materials and clearly express the result of literature survey both in writing and in the oral presentation."
    },
    {
      "seq": 3,
      "describe_ch": "讓學生藉由課堂上的報告與討論獲得新知與互相啟發，來提出新的想法。",
      "describe_en": "Students can learn new knowledge and propose innovated ideas through classroom presentation and discussion."
    }
  ],
