      "seq": 2,
      "describe_ch": "能以Python程式語言處理數據運算",
      "describe_en": "To process data with Python"
    },
    {
      "seq": 3,
      "describe_ch": "能以Python程式語言解決金融問題",
      "describe_en": "To solve problem with Python"
    }
