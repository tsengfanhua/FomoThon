  "description": {
    "sub_id3": null,
    "sub_name": "材料與生活",
    "sub_ename": "MATERIALS AND LIFE",
    "describe_ch": "材料科技在現代生活中扮演了重要的角色，當代科技的發展都與材料息息相關。本課程涵蓋目前熱門的奈米材料、綠色能源材料、生醫材料、電子材料等領域，使同學了解生活中的各項科技知識，並了解材料科技對生活帶來的影響。",
    "describe_eh": "Materials technologies play an important role in modern life and involve in the development of recent technology. This class includes popular topics: nano materials, green energy materials, biomedical materials, and electronically materials. It improves the understanding of variously materials technologies in life and the impact of materials technologies on life.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": " 理解生活中的各項材料科學常識",
      "describe_en": "Understand the common sense of material science in life"
    },
    {
      "seq": 2,
      "describe_ch": "用材料科學角度觀察日常生活環境",
      "describe_en": "Observe the daily life environment from the perspective of materials science"
    }
