  "description": {
    "sub_id3": null,
    "sub_name": "電腦輔助繪圖",
    "sub_ename": "COMPUTER-AIDED DRAWING",
    "describe_ch": "藉由訓練三度空間電腦模型的製作技巧與影像編輯軟體處理，使學生在建築室內設計的流程上更能清晰且靈活的傳達出作品創意與完整度",
    "describe_eh": "Students will be required to practice both 3D computer-modeling skills and image edits onto their design progress as well. By applying the digital tools to help students to clarify their design thinking as well as to increase the dynamic presentation of the design project.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 2.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能夠定義「電腦輔助設計」的意涵，瞭解國際間有關的「數位傳達」議題及其重要性",
      "describe_en": "Define the meaning of \"computer-aided design\" and know international issues about \"communications of digital media.\""
    },
    {
      "seq": 2,
      "describe_ch": "能表達目前國內數位設計體系的內容與評估要項",
      "describe_en": "Express the policy and contents of the \"Digital Architecture\" and the \" Digital Media Evaluation System\" in Taiwan."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解電腦輔助設計就「觀念」、「設計」、「製作」與「表現」四個面向可應用於室內景觀設計的實質內容。",
      "describe_en": "Comprehend computer  techniques which include four aspects: concept, design, production and application. Know the contents of these techniques."
    },
    {
      "seq": 4,
      "describe_ch": "能應用習得之電腦技術於室內景觀設計之中，培養數位設計之積極態度。",
      "describe_en": "Know how to apply digital techniques in indoor environment and landscape. Develop active attitude toward digital design."
    }
  ],
