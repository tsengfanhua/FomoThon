  "description": {
    "sub_id3": null,
    "sub_name": "空間資訊實務專論",
    "sub_ename": "SEMINAR ON GEO-INFORMATION PRACTICE",
    "describe_ch": "本課程著重在空間資訊分析模式與應用發展趨勢介紹與評析，包括空間資訊基礎與應用發展趨勢概述，並培養學生具有整合、實作與應用的分析能力。",
    "describe_eh": "This class focus on monographic of up-to-date geospatial  application trends which include geospatial analysis and the latest geospatial development. Students can build up the ability or skill to integrate and implement for the further analysis.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "透過主題式教學了解空間應用領域",
      "describe_en": "Learners can apply geospatial applications by theme-based instruction."
    },
    {
      "seq": 2,
      "describe_ch": "能夠案例的說明可掌握時代發展趨勢與現況",
      "describe_en": "Learners can depict the tendency and condition of geospatial via various case studies."
    },
    {
      "seq": 3,
      "describe_ch": "能夠進行特定研究主題的實作",
      "describe_en": "Learner can perform geospatial application by oral presentation."
    }
  ],
