  "subTitleDesc": {
    "yms_year": 114.0,
    "yms_smester": 1.0,
    "cls_id": "CB02133",
    "sub_id": "82406",
    "scr_dup": "001",
    "sub_title": "網路貿易與跨境電商",
    "sub_title_en": null,
    "sub_describe": "本課程主要是以國際貿易之角度，以《跨境電子商務理論與實務》專書來探討多平台跨境電商的營運狀況，並以國際貿易專業知識為基礎，從商流、金流、物流等方面，引導學生逐步了解跨境電商理論架構,期能使學生能更深一層的認識與了解「互聯網」時代下之國際貿易的實務運作及流程。",
    "sub_describe_en": null
  },
  "description": {
    "sub_id3": null,
    "sub_name": "網路貿易與跨境電商",
    "sub_ename": "ONLINE TRADE AND CROSS-BORDER E-COMMERCE",
    "describe_ch": "探討網路貿易與多平台跨境電商的營運狀況，並以國際貿易專業知識為基礎，從商流、金流、物流等方面，引導學生逐步了解跨境電商理論架構,期使學生更深一層了解「互聯網」時代下國際貿易的實務運作及流程。",
    "describe_eh": "This course is mainly to explore the operation status of online trade and multi-platform cross-border e-commerce. Based on international trade expertise, to guide students to gradually understand the theoretical framework of cross-border e-commerce from the aspects of business flow, cash flow, and logistics flow, etc. A deeper understanding of the practical operation and process of international trade under the \"Internet\" era.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "學生具備網路貿易與跨境電商專業知識",
      "describe_en": "Students will demonstrate an understanding of basic knowledge of online trade and cross-border e-commerce."
    },
    {
      "seq": 2,
      "describe_ch": "學生具備網路貿易與跨境電商之分析與解決問題能力",
      "describe_en": "Students possess problem solving skills and appropriate analytical techniques of online trade and cross-border e-commerce."
    }
  ],
