    {
      "seq": 4,
      "describe_ch": "能理解實質環境設計與都市設計的專業技能",
      "describe_en": "Comprehension for the techniques of physically environmental design and urban design."
    },
    {
      "seq": 5,
      "describe_ch": "能理解城市模擬於都市設計或景觀規劃的內涵",
      "describe_en": "Comprehension for the content of urban simulation in urban design or landscape planning."
    },
    {
      "seq": 6,
      "describe_ch": "能應用專業倫理與社會服務於專業實務",
      "describe_en": "Application of professional ethics and social responsibility to professional practice.\r\n"
    }
