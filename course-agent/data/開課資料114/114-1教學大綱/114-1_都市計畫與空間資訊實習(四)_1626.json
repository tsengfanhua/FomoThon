  "description": {
    "sub_id3": null,
    "sub_name": "都市計畫與空間資訊實習(四)",
    "sub_ename": "PRACTICE OF URBAN PLANNING AND SPATIAL INFORMATION(4)",
    "describe_ch": "本課程旨在訓練學生分組團隊合作，以地區整體性的空間發展考量為基礎，進行較小尺度的都市設計或景觀風貌等實質環境設計工作，並強調城市模擬的訓練與社會服務工作。",
    "describe_eh": "This course trains students to work together and conduct the physically environmental design, such as urban design or landscape design, in smaller urban settings, based on the comprehensive consideration of local spatial development.  The training also emphasizes the urban simulation and social services.\r\n",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
