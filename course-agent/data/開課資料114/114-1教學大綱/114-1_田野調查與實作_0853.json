  "description": {
    "sub_id3": null,
    "sub_name": "田野調查與實作",
    "sub_ename": "MANAGEMENT FIELD STUDY AND PRACTICE",
    "describe_ch": "本課程提供學生透過企業參與及觀察的模式，培養學生教育學習觀察心得，並且 應用到觀察整體社會經濟活動與脈絡，依照此方式，有效地結合宏觀經濟趨勢與 微觀企業經營，藉此有效提昇學生的競爭力與創新力。",
    "describe_eh": "The purpose of this course is to provide a participant observation study, which can give the students a chance to integrate their learning and working experiences into business practice. By doing so, the students can learn how to operate effectively and efficiency in the business modes and analyze globalized economy trend.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解在全球化的環境與文化衝擊下，企業如何有效率的營運，並通過實地訪查，將知識和實務進行整合。",
      "describe_en": "To understand how companies can operate effectively under the global environment and cultural impact, and to integrate knowledge and practice by field study."
    },
    {
      "seq": 2,
      "describe_ch": "能夠透過全球經營的分析，在知識、實務經驗的綜合中，提升學生應對全球市場競爭挑戰的能力。",
      "describe_en": "To enhance the ability of students to cope with the competitive challenges in global market."
    }
  ],
