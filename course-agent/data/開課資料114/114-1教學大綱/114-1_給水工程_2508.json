  "description": {
    "sub_id3": null,
    "sub_name": "給水工程",
    "sub_ename": "WATER SUPPLY ENGINEERING",
    "describe_ch": "從認識水源特性開始，學習集水、輸水、抽水、淨水及配水工程等單元要項，認知水質標準與管理策略，並瞭解各淨水單元之操作原理、控制參數、水質變化及工程設計，以加強實務觀念與應用。(修習此課程者需參加分組研討與上台報告)",
    "describe_eh": "Lectures of the collection, conveyance, pumping, purification and distribution of public water system are managed. Water quality standard and other legal policies are discussed. Basic theory of handling water quantity and quality, together with the engineering design on each of the treatment unit are emphasized. Field trip to the water treatment plant is included at the end of the class to offer a practical point of view. (Join a reading group and give presentation are needed. Extra paid for sharing the traffic and assurance fee for the field trip is required.)",
    "pre_subname": "EES2027水文學、EES2000水質分析、EES2003流體力學(一)",
    "pre_sub_id3": "EES2027",
    "pre_sub_ename": "EES2027 HYDROLOGY、EES2000 WATER QUALITY ANALYSIS、EES2003 FLUID MECHANICS(1)",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "認識給水工程的基本概念\t",
      "describe_en": "To learn the basic concepts of water supply engineering"
    },
    {
      "seq": 2,
      "describe_ch": "認知並具備分析與詮釋水質數據作為淨水處理成效判斷的能力。\t",
      "describe_en": " To learn and possess the ability to evaluate water quality and efficiency in water treatment process"
    },
    {
      "seq": 3,
      "describe_ch": "應用知能可進行給水系統之規劃設計\t",
      "describe_en": "To learn the knowledge of planning and design in water supply engineering."
    },
    {
      "seq": 4,
      "describe_ch": "期末分組報告專業議題並有效加強溝通協調與學術發表能力\t",
      "describe_en": "To learn effective communication and persuasion through team works in final term presentation and discussion ."
    }
  ],
