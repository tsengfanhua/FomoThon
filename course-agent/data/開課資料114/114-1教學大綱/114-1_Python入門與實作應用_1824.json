  "description": {
    "sub_id3": null,
    "sub_name": "Python入門與實作應用",
    "sub_ename": "INTRODUCTION TO PYTHON AND ITS APPLICATIONS",
    "describe_ch": "Python語言為現在與未來應用相關廣泛之程式語言，且包含了許多完整的資料庫與相關開發套件。本課程主要內容包含程式基本語法、邏輯概念以及相關實際之應用包含在AI與影像辨識等領域。",
    "describe_eh": "Python is an widely used programming language due to its integrity of tool kit and database. The course provides the students with a general understanding of Python language, including basic programming syntax, logic, and its applications in AI and vision.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "能瞭解Python開發環境、相關語法、程式邏輯等基本觀念",
      "describe_en": "Become familiar with Python’s IDE, syntax, and logic."
    },
    {
      "seq": 2,
      "describe_ch": "能學習Python程式開發流程並具備除錯能力",
      "describe_en": "To understand the programming procedure and debugging techniques."
    },
    {
      "seq": 3,
      "describe_ch": "能應用Python語言開發AI/影像等相關應用程式",
      "describe_en": "To apply Python for the application of artificial intelligence and vision recognition"
    }
  ],
