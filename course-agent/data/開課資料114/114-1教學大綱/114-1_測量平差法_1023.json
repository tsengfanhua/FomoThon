  "description": {
    "sub_id3": null,
    "sub_name": "測量平差法",
    "sub_ename": "ADJUSTMENT COMPUTATIONS",
    "describe_ch": "測量平差法為測量學之基礎科學。本課程旨在使學生瞭解關於測量觀測量平差的原理與技術；以及對平差結果的統計分析之理論與實務。",
    "describe_eh": "Adjustment of survey measurements is the basic science of surveying. The objective of this course is to understand the principle and techniques about the adjustment of survey measurements; as well as, the theory and practice of the statistical analysis for the result of adjustment.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
