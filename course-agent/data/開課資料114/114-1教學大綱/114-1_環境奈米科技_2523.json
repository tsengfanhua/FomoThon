  "description": {
    "sub_id3": null,
    "sub_name": "環境奈米科技",
    "sub_ename": "ENVIRONMENTAL NANOTECHNOLOGY",
    "describe_ch": "本課程介紹環境奈米科技基礎知識、促進同學了解奈米物質在空氣、水及土壤(與地下水)環境中之宿命、對生態之影響、危害與對人體健康(如奈米顆粒)之暴露風險。另將實例介紹奈米科技在水處理、受污土壤環境復育、光觸媒降解污染物等相關環境應用。",
    "describe_eh": "This course introduces fundamental knowledge about nanotechnology and nanoscale materials. Aiming enhanced public awareness and students to understand the fates, hazardous, impacts of nanomaterials to environments, ecology and human health. In addition, state-of-the-art nanotechnology applied to contaminated soil environment (including groundwater) remediation, pollutant degradation and water treatment will be introduced with practical examples.",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "了解奈米材料及奈米科技基礎知識\t",
      "describe_en": "To understand the fundamental knowledge about nanotechnology and nanoscale materials"
    },
    {
      "seq": 2,
      "describe_ch": "了解奈米材料在水環境中之宿命及奈米氣膠之危害與暴露風險\t",
      "describe_en": "To learn fate of nanomaterials in aquatic environments and impacts and risks of nanoscale aerosols."
    },
    {
      "seq": 3,
      "describe_ch": "學習應用最新奈米科技在水處理、環境復育、光觸媒等相關環境應用\t",
      "describe_en": "To apply the state-of-the-art nanotechnologies in environmental remediation, water treatment, photocatalysis etc."
    }
  ],
