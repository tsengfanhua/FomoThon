  "description": {
    "sub_id3": null,
    "sub_name": "品質計劃與管制",
    "sub_ename": "QUALITY PLANNING AND CONTROL",
    "describe_ch": "本課程旨為培育學生瞭解產品規劃及製造等生產階段中與品質相關的活動，熟悉統計製程管制手法與工具，應用課程所介紹之手法解決實務問題，並搭配論文研討與個案介紹，培養學生熟悉品質觀念並強化實務問題解決之能力。",
    "describe_eh": "本課程旨為培育學生瞭解產品規劃及製造等生產階段中與品質相關的活動，熟悉統計製程管制手法與工具，應用課程所介紹之手法解決實務問題，並搭配論文研討與個案介紹，培養學生熟悉品質觀念並強化實務問題解決之能力。",
    "pre_subname": "",
    "pre_sub_id3": null,
    "pre_sub_ename": "",
    "pre_describe": null,
    "pre_describe_en": null,
    "scr_credit": 3.0
  },
  "targets": [
    {
      "seq": 1,
      "describe_ch": "瞭解品質規劃與管制架構、問題解決流程與品質管制七大工具",
      "describe_en": "Understand basic quality management principles, and structure of quality planning and quality control, problem solving process and QC tools."
    },
    {
      "seq": 2,
      "describe_ch": "瞭解統計製程管制圖之原理和管制方法與製程能力評估",
      "describe_en": "Understand control charts for attributes and variables and process capability assessment."
    },
    {
      "seq": 3,
      "describe_ch": "瞭解抽樣計畫之原理並設計抽樣計畫B4\r\n",
      "describe_en": "Understand the practical application of acceptance sampling plan.\r\n"
    },
    {
      "seq": 4,
